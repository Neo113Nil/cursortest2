<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.squareup.cash.mooncake.components.MooncakeToolbar
            android:id="@+id/toolbar"
            android:background="@color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationContentDescription="@string/action_bar_close"
            app:navigationIcon="?attr/actionBarCloseIcon"/>
        <com.squareup.scannerview.ScannerView
            android:id="@+id/scanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:sv_previewButtonsLayout="@layout/scanner_preview_buttons_layout"
            app:sv_textLayout="@layout/scanner_title_view"/>
        <com.squareup.cash.ui.widget.text.FigmaTextView
            android:gravity="center"
            android:id="@+id/footer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:drawablePadding="4dp"
            app:layout_constraintBottom_toTopOf="@+id/barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="buttons,review_buttons"/>
        <com.squareup.cash.mooncake.components.SplitButtons
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/blockers_padding"
            android:layout_marginStart="@dimen/blockers_padding"
            android:layout_marginEnd="@dimen/blockers_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.squareup.cash.mooncake.components.SplitButtons
            android:id="@+id/review_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/blockers_padding"
            android:layout_marginStart="@dimen/blockers_padding"
            android:layout_marginEnd="@dimen/blockers_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
