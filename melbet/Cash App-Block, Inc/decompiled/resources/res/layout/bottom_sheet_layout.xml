<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/img_close"
            android:paddingTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/dialog_close_icon"
            android:scaleType="fitCenter"
            android:paddingHorizontal="20dp"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardview_logo"
            android:visibility="gone"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/merchant_logo"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="24sp"
            android:textColor="#171717"
            android:gravity="center"
            android:id="@+id/txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/exit_confirmation_title"
            android:lineSpacingExtra="0sp"
            android:fontFamily="@font/geist_semibold"
            android:textAlignment="center"
            android:layout_marginHorizontal="20dp"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#525252"
            android:gravity="center"
            android:id="@+id/txt_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/exit_confirmation_message"
            android:lineSpacingExtra="4sp"
            android:fontFamily="@font/geist"
            android:textAlignment="center"
            android:layout_marginHorizontal="20dp"
            android:lineHeight="24sp"
            android:textFontWeight="400"/>
        <LinearLayout
            android:id="@+id/btn_primaryButton"
            android:background="@drawable/rounded_corner_button_grey"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#171717"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/txt_primaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4sp"
                android:fontFamily="@font/geist"
                android:textAlignment="center"
                android:lineHeight="24sp"
                android:textFontWeight="600"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/editText"
            android:background="@drawable/rounded_corner_button_grey"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp">
            <EditText
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="#171717"
                android:textColorHint="#a3a3a3"
                android:ellipsize="end"
                android:id="@+id/editText_link"
                android:background="@null"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:minHeight="40dp"
                android:maxLines="4"
                android:lineSpacingExtra="4sp"
                android:fontFamily="@font/geist"
                android:lineHeight="24sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_secondButton"
            android:background="@drawable/rounded_corner_button_transparent"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="20dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/txt_secondButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4sp"
                android:fontFamily="@font/geist"
                android:textAlignment="center"
                android:lineHeight="24sp"
                android:textFontWeight="600"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
