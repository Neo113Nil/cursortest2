<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:paddingTop="@dimen/misnapWorkflowLayoutVerticalMargin"
    android:paddingBottom="@dimen/misnapWorkflowLayoutVerticalMargin"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/misnapWorkflowLayoutHorizontalMargin"
    android:paddingEnd="@dimen/misnapWorkflowLayoutHorizontalMargin">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/idCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowNfcSelectionFragmentButtonIdLabel"
        style="@style/MiSnapTheme.Button"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/driversLicense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowNfcSelectionFragmentButtonDlLabel"
        style="@style/MiSnapTheme.Button"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/passport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowNfcSelectionFragmentButtonPassportLabel"
        style="@style/MiSnapTheme.Button"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/skipButton"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMarginDouble"
        android:text="@string/misnapWorkflowNfcSelectionFragmentButtonSkipLabel"
        style="@style/MiSnapTheme.Button.Outlined"/>
</LinearLayout>
