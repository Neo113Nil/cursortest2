<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="10dp">
    <net.oneformapp.view.TextViewPlus
        android:textSize="14sp"
        android:textColor="@color/f_txt_info_page_title"
        android:id="@+id/f_info_pages_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fontVariant="roboto_regular"/>
    <net.oneformapp.view.TextViewPlus
        android:textSize="14sp"
        android:textStyle="normal"
        android:id="@+id/f_info_pages_subtext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        app:fontVariant="roboto_regular"/>
    <net.oneformapp.view.TextViewPlus
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/f_teal_text_color"
        android:autoLink="all"
        android:id="@+id/f_info_pages_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        app:fontVariant="roboto_regular"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>
</LinearLayout>
