<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/padding_m"
    android:paddingBottom="@dimen/padding_m"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fill_view_height">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/profile_view_row_section1"
        android:background="@drawable/com_fillr_list_bg_selector"
        android:paddingLeft="@dimen/padding_l"
        android:paddingRight="@dimen/padding_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="81dp"
        android:layout_toLeftOf="@+id/com_fillr_ic_edit"
        android:paddingStart="@dimen/padding_l"
        android:layout_toStartOf="@+id/com_fillr_ic_edit">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtField"
            android:layout_toLeftOf="@+id/txtAddMore"
            android:textAllCaps="true"
            android:layout_toStartOf="@+id/txtAddMore"
            style="@style/lblFieldProfile"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="17sp"
            android:textColor="@color/text_secondary_action"
            android:id="@+id/txtAddMore"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_more"
            android:drawableRight="@drawable/com_fillr_chevron"
            android:drawablePadding="@dimen/padding_m"
            android:layout_alignParentRight="true"
            android:drawableEnd="@drawable/com_fillr_chevron"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/img_logo"
            android:layout_toLeftOf="@+id/txtvalue"
            android:layout_alignBottom="@+id/txtvalue"
            android:layout_alignParentLeft="true"
            android:layout_toStartOf="@+id/txtvalue"
            android:layout_alignParentStart="true"
            style="@style/f_core_image_logo"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtvalue"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text=""
            android:layout_below="@+id/txtField"
            style="@style/lblFieldValueProfile"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/groupView"
            android:paddingTop="@dimen/padding_s"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtField"/>
    </RelativeLayout>
    <ImageButton
        android:id="@+id/com_fillr_ic_edit"
        android:background="?attr/selectableItemBackground"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_edit_pencil"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/divider"
        android:background="@drawable/fillview_row_seperator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/profile_view_row_section1"/>
</RelativeLayout>
