<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorSurface"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:padding="@dimen/misnapWorkflowLayoutVerticalMargin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/buttonsGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentVerifyTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/needHelpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentButtonHelpLabel"
            app:icon="@drawable/misnap_button_help_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/MiSnapTheme.Button.Borderless"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mrzFieldsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/needHelpButton">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/documentNumberLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="clear_text"
                app:errorEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/documentNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/misnapWorkflowNfcMrzDataManualEntryFragmentDocumentNumberLabel"
                    android:maxLines="1"
                    android:maxLength="12"
                    android:digits="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                    android:inputType="textNoSuggestions"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/dateOfBirthLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMarginHalf"
                app:errorEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dateOfBirth"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/misnapWorkflowNfcMrzDataManualEntryFragmentDobLabel"
                    android:maxLines="1"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/expirationDateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMarginHalf"
                app:errorEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/expirationDate"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/misnapWorkflowNfcMrzDataManualEntryFragmentDoeLabel"
                    android:maxLines="1"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/issuingCountryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMarginHalf"
                app:endIconMode="clear_text"
                app:errorEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/issuingCountry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/misnapWorkflowNfcMrzDataManualEntryFragmentIssuingCountryLabel"
                    android:maxLines="1"
                    android:maxLength="3"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                    android:inputType="textCapCharacters"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/documentCodeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMarginHalf"
                app:endIconMode="clear_text"
                app:errorEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/documentCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/misnapWorkflowNfcMrzDataManualEntryFragmentDocumentCodeLabel"
                    android:maxLines="1"
                    android:maxLength="2"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                    android:inputType="textCapCharacters"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/skipButton"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/misnapWorkflowLayoutHorizontalMarginHalf"
            android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentButtonSkipLabel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/buttonsGuideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mrzFieldsContainer"
            app:layout_constraintVertical_bias="1"
            style="@style/MiSnapTheme.Button.Outlined"/>
        <com.google.android.material.button.MaterialButton
            android:theme="@style/MiSnapTheme.Button"
            android:id="@+id/submitButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/misnapWorkflowLayoutHorizontalMarginHalf"
            android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentButtonSubmitLabel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/buttonsGuideline"
            app:layout_constraintTop_toBottomOf="@+id/mrzFieldsContainer"
            app:layout_constraintVertical_bias="1"
            style="@style/MiSnapTheme.Button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
