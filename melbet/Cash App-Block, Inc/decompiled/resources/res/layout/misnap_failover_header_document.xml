<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/misnapWorkflowsFailoverHeaderDocumentId"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/misnapWorkflowFailoverFragmentDocumentAccessibilityMessage"
    android:importantForAccessibility="yes">
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:id="@+id/timerMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowFailoverFragmentDocumentTimeoutMessage"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/failoverReasonsMessage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:id="@+id/failoverReasonsMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowFailoverFragmentDocumentFailureTipsMessage"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timerMessage"
        style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
