<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorSurface"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/failoverHeader"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/failuresListContainer"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTopContent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineHeaderBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.25"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/failuresListContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineFooterTop"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineHeaderBottom"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineButtonsDivider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineFooterTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.75"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:id="@+id/failoverMessageRetry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowFailoverFragmentRetryMessage"
        android:contentDescription="@string/misnapWorkflowFailoverFragmentRetryMessage"
        app:layout_constraintBottom_toTopOf="@+id/autoButton"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineFooterTop"
        style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/autoButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowFailoverFragmentButtonRetryAutoLabel"
        android:contentDescription="@string/misnapWorkflowFailoverFragmentButtonRetryAutoAccessibility"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomContent"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineButtonsDivider"
        app:layout_constraintTop_toBottomOf="@+id/failoverMessageRetry"
        style="@style/MiSnapTheme.Button"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/manualButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowFailoverFragmentButtonRetryManualLabel"
        android:contentDescription="@string/misnapWorkflowFailoverFragmentButtonRetryManualAccessibility"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/autoButton"
        app:layout_constraintEnd_toStartOf="@+id/guidelineButtonsDivider"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toTopOf="@+id/autoButton"
        style="@style/MiSnapTheme.Button.Outlined"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStartContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutVerticalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineEndContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutVerticalMargin"/>
</androidx.constraintlayout.widget.ConstraintLayout>
