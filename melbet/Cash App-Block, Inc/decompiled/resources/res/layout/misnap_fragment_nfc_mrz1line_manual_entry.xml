<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:padding="@dimen/misnapWorkflowLayoutVerticalMargin"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/buttonsGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowNfcMrz1LineManualEntryFragmentVerifyTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/needHelpButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowNfcMrz1LineManualEntryFragmentButtonHelpLabel"
        app:icon="@drawable/misnap_button_help_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/MiSnapTheme.Button.Borderless"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/mrzStringLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMarginHalf"
        app:endIconMode="clear_text"
        app:errorEnabled="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/needHelpButton">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/mrzString"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/misnapWorkflowNfcMrz1LineManualEntryFragmentMrzStringLabel"
            android:maxLines="1"
            android:maxLength="30"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/skipButton"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/misnapWorkflowLayoutHorizontalMarginHalf"
        android:text="@string/misnapWorkflowNfcMrz1LineManualEntryFragmentButtonSkipLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonsGuideline"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/MiSnapTheme.Button.Outlined"/>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/MiSnapTheme.Button"
        android:id="@+id/submitButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/misnapWorkflowLayoutHorizontalMarginHalf"
        android:text="@string/misnapWorkflowNfcMrz1LineManualEntryFragmentButtonSubmitLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/buttonsGuideline"
        style="@style/MiSnapTheme.Button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
