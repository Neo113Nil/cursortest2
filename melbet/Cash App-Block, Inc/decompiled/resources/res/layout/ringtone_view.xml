<?xml version="1.0" encoding="utf-8"?>
<com.squareup.cash.profile.views.RingtoneView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="@dimen/dialog_max_width">
    <com.squareup.cash.ui.widget.text.LineSpacingTextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ringtone_picker_title"
        style="@style/Widget.Cash.Dialog.Title"/>
    <ListView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?android:attr/buttonBarStyle">
        <com.squareup.cash.ui.widget.text.LineSpacingButton
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ringtone_picker_negative"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"/>
        <com.squareup.cash.ui.widget.text.LineSpacingButton
            android:id="@+id/ok"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ringtone_picker_positive"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>
</com.squareup.cash.profile.views.RingtoneView>
