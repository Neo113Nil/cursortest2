<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_layout"
        android:paddingTop="@dimen/content_spacing_small"
        android:paddingBottom="@dimen/content_spacing_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/gutter_medium"
        android:paddingEnd="@dimen/gutter_medium">
        <com.squareup.cash.ui.widget.text.BalancedLineTextView
            android:textAppearance="@style/TextAppearance.Cash.Instructions"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.squareup.cash.ui.widget.text.BalancedLineTextView
            android:textAppearance="@style/TextAppearance.Cash.Subtext"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/actions_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:showDividers="middle">
        <com.squareup.cash.ui.widget.text.LineSpacingButton
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.squareup.cash.ui.widget.text.LineSpacingButton
            android:id="@+id/action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</merge>
