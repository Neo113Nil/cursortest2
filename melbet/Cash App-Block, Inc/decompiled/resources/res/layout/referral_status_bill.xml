<?xml version="1.0" encoding="utf-8"?>
<view xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    class="com.squareup.cash.payments.views.BillView">
    <view
        android:layout_gravity="center"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="90dp"
        app:aspectRatio="0.67"
        class="com.squareup.cash.payments.views.BillConstraintLayout">
        <com.squareup.cash.ui.widget.text.LineSpacingTextView
            android:textSize="28sp"
            android:textColor="@color/bright_green_normal"
            android:gravity="center"
            android:id="@+id/available"
            android:background="@drawable/reward_status_bill_available_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/cashsans_medium"/>
        <ImageView
            android:id="@+id/complete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/reward_status_bill_complete"
            android:contentDescription="@string/reward_status_bill_complete_description"/>
    </view>
</view>
