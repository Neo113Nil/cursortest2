<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:background="@color/crop_background"
        android:layout_width="@dimen/profile_crop_view_size"
        android:layout_height="@dimen/profile_crop_view_size">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/crop_placeholder"
            android:importantForAccessibility="no"/>
        <com.squareup.cropview.CropView
            android:layout_gravity="center"
            android:id="@+id/crop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:crop_aspectRatioX="1"
            app:crop_aspectRatioY="1"
            app:crop_minCropHeightPx="200"
            app:crop_minCropWidthPx="200"
            app:crop_shape="oval"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?android:attr/buttonBarStyle">
        <com.squareup.cash.ui.widget.text.LineSpacingButton
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/profile_crop_negative"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"/>
        <com.squareup.cash.ui.widget.text.LineSpacingButton
            android:enabled="false"
            android:id="@+id/ok"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/profile_crop_positive"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>
</merge>
