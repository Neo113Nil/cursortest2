<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorSurface"
    android:paddingTop="@dimen/misnapWorkflowLayoutVerticalMargin"
    android:paddingBottom="@dimen/misnapWorkflowLayoutVerticalMargin"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/misnapWorkflowLayoutHorizontalMargin"
    android:paddingEnd="@dimen/misnapWorkflowLayoutHorizontalMargin">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMargin"
        android:layout_marginBottom="@dimen/misnapWorkflowLayoutVerticalMargin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/scanAnimation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"/>
        <com.google.android.material.textview.MaterialTextView
            android:gravity="center"
            android:id="@+id/scanInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:paddingStart="@dimen/misnapWorkflowLayoutHorizontalMargin"
            android:paddingEnd="@dimen/misnapWorkflowLayoutHorizontalMargin"
            style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
        <com.google.android.material.textview.MaterialTextView
            android:gravity="center"
            android:id="@+id/readingStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:paddingStart="@dimen/misnapWorkflowLayoutHorizontalMargin"
            android:paddingEnd="@dimen/misnapWorkflowLayoutHorizontalMargin"
            style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/readProgress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMargin"
            android:max="4"
            android:indeterminate="true"
            android:layout_marginStart="@dimen/misnapWorkflowLayoutHorizontalMarginDouble"
            android:layout_marginEnd="@dimen/misnapWorkflowLayoutHorizontalMarginDouble"
            style="@style/Widget.MaterialComponents.LinearProgressIndicator"/>
        <com.google.android.material.button.MaterialButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/needHelp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMargin"
            android:text="@string/misnapWorkflowNfcReaderFragmentButtonHelpLabel"
            android:layout_marginStart="@dimen/misnapWorkflowLayoutHorizontalMargin"
            android:layout_marginEnd="@dimen/misnapWorkflowLayoutHorizontalMargin"
            app:icon="@drawable/misnap_button_help_icon"
            style="@style/MiSnapTheme.Button.Outlined"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMargin">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/skip"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/misnapWorkflowNfcReaderFragmentButtonSkipLabel"
                app:icon="@drawable/misnap_button_cancel_icon"
                style="@style/MiSnapTheme.Button.Outlined"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tryAgain"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/misnapWorkflowNfcReaderFragmentButtonRetryLabel"
                android:layout_marginStart="@dimen/misnapWorkflowLayoutHorizontalMargin"
                app:icon="@drawable/misnap_retry_icon"
                style="@style/MiSnapTheme.Button"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
