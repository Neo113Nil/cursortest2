<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_entry_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/card_entry_top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/sqip_top_bar_layout"/>
    <sqip.internal.GiftCardEditor
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/card_editor"
        android:addStatesFromChildren="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/sqip_card_editor_start_end_padding"
        android:paddingEnd="@dimen/sqip_card_editor_start_end_padding"
        android:layout_marginStart="@dimen/sqip_small_card_editor_margin"
        android:layout_marginEnd="@dimen/sqip_small_card_editor_margin"
        app:layout_constraintBottom_toTopOf="@+id/helper_text_switcher"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_entry_top_bar"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="@dimen/sqip_card_editor_max_width"
        style="?attr/editTextStyle"/>
    <sqip.internal.CardImage
        android:id="@+id/card_image"
        android:layout_width="@dimen/sqip_small_card_width"
        android:layout_height="@dimen/sqip_small_card_height"
        android:scaleType="fitXY"
        android:contentDescription="@string/sqip_credit_card_image_description"
        app:layout_constraintBottom_toBottomOf="@+id/card_editor"
        app:layout_constraintStart_toStartOf="@+id/card_editor"
        app:layout_constraintTop_toTopOf="@+id/card_editor"
        app:srcCompat="@drawable/sqip_small_gift_card"/>
    <sqip.internal.HelperTextSwitcher
        android:id="@+id/helper_text_switcher"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sqip_helper_text_small_card_margin_top"
        android:text="@string/sqip_helper_text_card"
        app:layout_constraintBottom_toTopOf="@+id/save_button"
        app:layout_constraintEnd_toEndOf="@+id/card_editor"
        app:layout_constraintStart_toStartOf="@+id/card_editor"
        app:layout_constraintTop_toBottomOf="@+id/card_editor"/>
    <Button
        android:id="@+id/save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/sqip_touch_target_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_spinner"
        app:layout_constraintVertical_bias="1"/>
    <ProgressBar
        android:id="@+id/progress_spinner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sqip_helper_text_margin_top"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="@+id/card_editor"
        app:layout_constraintEnd_toEndOf="@+id/card_editor"
        app:layout_constraintStart_toStartOf="@+id/card_editor"
        app:layout_constraintTop_toTopOf="@+id/card_editor"
        style="@style/sqip_Loading.Spinner"/>
</androidx.constraintlayout.widget.ConstraintLayout>
