<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.squareup.cash.ui.widget.text.LineSpacingButton
        android:textColor="#ffffffff"
        android:id="@+id/sv_preview_retake_button_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sv_preview_retake"
        android:layout_weight="1"/>
    <com.squareup.cash.ui.widget.text.LineSpacingButton
        android:textColor="#ffffffff"
        android:id="@+id/sv_preview_use_photo_button_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sv_preview_use_photo"
        android:layout_weight="1"/>
</LinearLayout>
