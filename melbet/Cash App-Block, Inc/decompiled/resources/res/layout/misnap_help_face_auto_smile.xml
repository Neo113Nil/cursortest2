<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/misnapHelpFaceAutoSmile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/misnapWorkflowHelpFragmentFaceAccessibilityAutoSmileMessage"
    android:importantForAccessibility="yes">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineFirstColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.2"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineSecondColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.8"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineTextStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.05"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineTextEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageStep2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/helpListContainer"
        app:layout_constraintEnd_toEndOf="@+id/guidelineSecondColumn"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guidelineFirstColumn"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/misnap_help_face_oval"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/helpListContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/guidelineTextEnd"
        app:layout_constraintStart_toStartOf="@+id/guidelineTextStart"
        app:layout_constraintTop_toBottomOf="@+id/imageStep2">
        <com.google.android.material.textview.MaterialTextView
            android:background="@drawable/misnap_list_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/misnapWorkflowHelpFragmentFaceCenterFaceMessage"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/MiSnapTheme.TextAppearance.HelpMessage"/>
        <com.google.android.material.textview.MaterialTextView
            android:background="@drawable/misnap_list_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/misnapWorkflowHelpFragmentFaceNoAccessoriesMessage"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/MiSnapTheme.TextAppearance.HelpMessage"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
