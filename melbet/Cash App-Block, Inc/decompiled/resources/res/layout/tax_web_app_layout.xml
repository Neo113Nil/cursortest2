<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <WebView
        android:id="@+id/tax_web_app_webview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tax_web_app_toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tax_web_app_loading_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tax_web_app_toolbar">
        <com.squareup.cash.mooncake.components.MooncakeProgress
            android:id="@+id/tax_web_app_loading_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.squareup.cash.mooncake.components.MooncakeMediumText
            android:textStyle="bold"
            android:id="@+id/tax_web_app_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.squareup.cash.mooncake.components.MooncakeToolbar
        android:id="@+id/tax_web_app_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tax_web_app_webview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:gravity="start"
            android:layout_gravity="start"
            android:id="@+id/tax_web_app_toolbar_back_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/mooncake_chevron_back"
            android:scaleType="center"
            android:contentDescription="@string/blockers_back"
            android:layout_marginEnd="@dimen/toolbar_end_padding"/>
        <com.squareup.cash.mooncake.components.MooncakeMediumText
            android:gravity="start"
            android:layout_gravity="start"
            android:id="@+id/tax_web_app_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/tax_desktop_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/tax_view_desktop_toolbar_icon"
            android:scaleType="center"
            android:contentDescription="@string/tax_view_toolbar_desktop"/>
    </com.squareup.cash.mooncake.components.MooncakeToolbar>
</merge>
