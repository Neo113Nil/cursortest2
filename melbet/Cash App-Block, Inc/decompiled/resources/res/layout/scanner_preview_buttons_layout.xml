<?xml version="1.0" encoding="utf-8"?>
<com.squareup.cash.ui.widget.JustifiedButtonContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/blockersButtonBarStyle">
    <com.squareup.cash.ui.widget.text.LineSpacingButton
        android:textColor="@color/standard_white_normal"
        android:id="@+id/sv_preview_retake_button_id"
        android:background="@drawable/button_background_black"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sv_preview_retake"
        android:layout_weight="1"
        style="?attr/blockersButtonBarButtonStyle"/>
    <com.squareup.cash.ui.widget.text.LineSpacingButton
        android:textColor="@color/standard_white_normal"
        android:id="@+id/sv_preview_use_photo_button_id"
        android:background="@drawable/button_background_black"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sv_preview_use_photo"
        android:layout_weight="1"
        style="?attr/blockersButtonBarButtonStyle"/>
</com.squareup.cash.ui.widget.JustifiedButtonContainer>
