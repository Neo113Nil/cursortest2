<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main_container"
    android:background="@drawable/com_fillr_feedback_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="22dp"
        android:src="@drawable/fillr_feedback_dialog_smiley"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/f_feedback_text"
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="21dp"
        android:layout_marginRight="22dp"
        android:text="@string/fillr_feedback_dialog_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/f_feedback_text_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="21dp"
        android:layout_marginRight="22dp"
        android:text="@string/fillr_feedback_dialog_msg"/>
    <View
        android:background="#e6e6e6"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="40dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="14sp"
            android:textColor="@color/f_feedback_btn"
            android:id="@+id/btn_feedback_skip"
            android:background="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:text="@string/fillr_feedback_dialog_btn1"
            android:layout_weight="1"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/f_feedback_btn"
            android:id="@+id/btn_feedback_rateus"
            android:background="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:text="@string/fillr_feedback_dialog_btn2"
            android:layout_weight="1"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/f_feedback_btn"
            android:id="@+id/btn_feedback_share"
            android:background="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:text="@string/fillr_feedback_dialog_btn3"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
