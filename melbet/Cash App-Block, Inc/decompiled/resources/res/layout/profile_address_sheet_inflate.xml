<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.squareup.cash.ui.widget.text.LineSpacingTextView
        android:gravity="center"
        android:id="@+id/header"
        android:paddingTop="@dimen/profile_address_sheet_vertical_padding"
        android:paddingBottom="@dimen/profile_address_sheet_vertical_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.squareup.cash.ui.widget.text.LineSpacingButton
        android:id="@+id/replace_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/profile_replace_address"/>
    <com.squareup.cash.ui.widget.text.LineSpacingButton
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"/>
</merge>
