<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="150dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_feedback_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="22dp"
            android:src="@drawable/fillr_feedback_star"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#404040"
            android:id="@+id/txt_howstheapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="37dp"
            android:layout_marginTop="22dp"
            android:text="@string/fillr_feedback_dialog_howstheapp"
            android:layout_toRightOf="@+id/img_feedback_star"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#9a9a9a"
            android:id="@+id/txt_experience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="37dp"
            android:layout_marginTop="15dp"
            android:text="@string/fillr_feedback_dialog_yourexperience"
            android:layout_toRightOf="@+id/img_feedback_star"
            android:layout_below="@+id/txt_howstheapp"/>
    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:background="#e0e0e0"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <Button
            android:textSize="14sp"
            android:textColor="@color/f_feedback_btn2"
            android:id="@+id/btnOne"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="5dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/fillr_feedback_btn_not_great"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/f_feedback_btn2"
            android:id="@+id/btnTwo"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/fillr_feedback_btn_great"/>
    </LinearLayout>
</LinearLayout>
