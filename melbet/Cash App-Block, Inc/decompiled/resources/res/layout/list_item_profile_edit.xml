<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="@dimen/table_cell_padding"
    android:paddingRight="@dimen/table_cell_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/table_cell_height"
    android:minHeight="@dimen/table_cell_height">
    <ImageView
        android:id="@+id/item_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/padding_s"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/padding_s"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@+id/list_item_name"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/isSelected"
        android:layout_toRightOf="@+id/item_image"
        android:layout_toStartOf="@+id/isSelected"
        android:layout_toEndOf="@+id/item_image"/>
    <ImageView
        android:id="@+id/isSelected"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/com_fillr_checkbox_tick"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
