<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/MiSnapTheme.Dialog.CustomViewContent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/misnapWorkflowNfcReaderFragmentHelpBulletsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/materialAlertDialogBodyTextStyle"
            android:background="@drawable/misnap_list_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/misnapWorkflowNfcReaderFragmentHelpBulletOnePopupMessage"
            android:paddingStart="8dp"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/materialAlertDialogBodyTextStyle"
            android:background="@drawable/misnap_list_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/misnapWorkflowNfcReaderFragmentHelpBulletTwoPopupMessage"
            android:paddingStart="8dp"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/materialAlertDialogBodyTextStyle"
            android:background="@drawable/misnap_list_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/misnapWorkflowNfcReaderFragmentHelpBulletThreePopupMessage"
            android:paddingStart="8dp"/>
    </LinearLayout>
</ScrollView>
