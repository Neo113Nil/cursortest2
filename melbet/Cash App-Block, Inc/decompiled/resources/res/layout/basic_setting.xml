<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/basic_setting_container"
    android:background="?android:attr/selectableItemBackground"
    android:paddingTop="@dimen/profile_item_padding_vertical"
    android:paddingBottom="@dimen/profile_item_padding_vertical"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/profile_item_padding_side"
    android:paddingEnd="@dimen/profile_item_padding_side">
    <com.squareup.cash.ui.widget.text.LineSpacingTextView
        android:textAppearance="@style/TextAppearance.Cash.Cell"
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cashsans_medium"/>
    <com.squareup.cash.ui.widget.text.LineSpacingTextView
        android:textAppearance="@style/TextAppearance.Cash.Subtext"
        android:textColor="?android:attr/textColorSecondary"
        android:id="@+id/description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/profile_item_description_gap"/>
</LinearLayout>
