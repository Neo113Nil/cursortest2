<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="81dp"
    android:foreground="?android:attr/selectableItemBackground">
    <ImageView
        android:id="@+id/f_img_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/padding_l"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/padding_l"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/com_fillr_profile_text_color"
        android:id="@+id/txtField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/padding_xl"
        android:layout_marginRight="@dimen/padding_xl"
        android:text="PERSONAL DETAILS"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/f_img_icon"
        android:layout_centerVertical="true"
        android:lineSpacingMultiplier="1.2"
        android:textAllCaps="true"
        android:fontFamily="Roboto"
        android:layout_marginStart="@dimen/padding_xl"
        android:layout_toStartOf="@+id/f_img_icon"/>
    <View
        android:background="#e6e6e6"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/padding_m"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/padding_m"/>
</RelativeLayout>
