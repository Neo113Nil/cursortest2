<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/misnapHelpAutoGeneric"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/misnapWorkflowHelpFragmentGenericAccessibilityAutoMessage"
    android:importantForAccessibility="yes">
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/messageOne"
        android:background="@drawable/misnap_list_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/misnapWorkflowHelpFragmentGenericAutoMessage1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/messageTwo"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineMessageTop"
        style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/messageTwo"
        android:background="@drawable/misnap_list_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowHelpFragmentGenericAutoMessage2"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineMessageBottom"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/messageOne"
        style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineMessageTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.3"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineMessageBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.7"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStartContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutVerticalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineEndContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutVerticalMargin"/>
</androidx.constraintlayout.widget.ConstraintLayout>
