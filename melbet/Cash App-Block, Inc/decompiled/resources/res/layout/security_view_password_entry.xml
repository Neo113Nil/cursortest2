<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.squareup.cash.mooncake.components.MooncakeToolbar
        android:id="@+id/security_view_password_app_toolbar"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/security_view_password_entry_scroll_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/security_view_help_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/nav_help"
            android:contentDescription="@string/blockers_help"
            android:layout_marginEnd="@dimen/toolbar_end_padding"/>
    </com.squareup.cash.mooncake.components.MooncakeToolbar>
    <ScrollView
        android:id="@+id/security_view_password_entry_scroll_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/security_view_password_action_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/security_view_password_app_toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/security_view_password_entry_internal_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.squareup.cash.mooncake.components.MooncakeLargeText
                android:id="@+id/security_view_password_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="@dimen/blockers_padding"
                android:layout_marginEnd="@dimen/blockers_padding"
                app:layout_constraintBottom_toTopOf="@+id/security_view_password_detail_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.squareup.cash.mooncake.components.MooncakeMediumText
                android:id="@+id/security_view_password_detail_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="@dimen/blockers_padding"
                android:layout_marginEnd="@dimen/blockers_padding"
                app:layout_constraintBottom_toTopOf="@+id/security_view_forgot_password_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/security_view_password_header"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:id="@+id/security_view_forgot_password_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/security_view_forgot_password_button_text"
                android:drawablePadding="8dp"
                android:layout_marginStart="@dimen/blockers_padding"
                android:layout_marginEnd="@dimen/blockers_padding"
                app:layout_constraintBottom_toTopOf="@+id/security_view_password_container_edit_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/security_view_password_detail_text"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/security_view_password_container_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="@dimen/blockers_padding"
                android:layout_marginEnd="@dimen/blockers_padding"
                app:layout_constraintBottom_toTopOf="@+id/security_view_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/security_view_forgot_password_text">
                <com.squareup.cash.mooncake.components.MooncakeEditText
                    android:layout_gravity="center"
                    android:id="@+id/security_view_password_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/security_view_edit_text_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:buttonCompat="@drawable/security_views_password_visibility_checkbox"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:id="@+id/security_view_divider"
                android:background="@color/hairline_gray_normal"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:paddingStart="@dimen/blockers_padding"
                android:paddingEnd="@dimen/blockers_padding"
                android:layout_marginStart="@dimen/blockers_padding"
                android:layout_marginEnd="@dimen/blockers_padding"
                app:layout_constraintBottom_toTopOf="@+id/security_view_biometrics_checkbox"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/security_view_password_container_edit_text"/>
            <com.squareup.cash.mooncake.components.MooncakeCheckbox
                android:id="@+id/security_view_biometrics_checkbox"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="@dimen/blockers_padding"
                android:layout_marginEnd="@dimen/blockers_padding"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/security_view_divider"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.squareup.cash.mooncake.components.MooncakePillButton
        android:enabled="false"
        android:id="@+id/security_view_password_action_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/blockers_button_margins"
        android:layout_marginBottom="@dimen/blockers_button_margins"
        android:layout_marginStart="@dimen/blockers_button_margins"
        android:layout_marginEnd="@dimen/blockers_button_margins"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:mooncake_size="large"
        app:mooncake_style="primary"/>
</merge>
