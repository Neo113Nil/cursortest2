<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/nfc_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/tap_to_pay"
        android:scaleType="center"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.125"
        app:layout_constraintWidth_percent="0.5"/>
    <com.squareup.cash.card.onboarding.PerspectiveView
        android:id="@+id/perspective_view"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2023:1276"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/card_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/bottom_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationX="1.25dp"
                android:translationY="1.25dp"/>
            <com.squareup.cash.card.onboarding.StyledCardView
                android:id="@+id/styled_card_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </com.squareup.cash.card.onboarding.PerspectiveView>
</merge>
