<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:interpolator="@android:anim/linear_interpolator"
        android:duration="@integer/misnapWorkflowNfcAnimationDurationReadingDeviceFieldsAlpha"
        android:startOffset="@integer/misnapWorkflowNfcAnimationOffsetReadingDeviceFieldsAlpha"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:valueFrom="@integer/misnapWorkflowNfcAnimationReadingDeviceProgressAlphaFrom"
        android:valueTo="@integer/misnapWorkflowNfcAnimationReadingDeviceProgressAlphaTo"
        android:valueType="floatType"
        android:propertyName="fillAlpha"/>
</set>
