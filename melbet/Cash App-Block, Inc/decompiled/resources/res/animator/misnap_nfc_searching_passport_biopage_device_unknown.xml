<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:interpolator="@android:anim/linear_interpolator"
        android:duration="@integer/misnapWorkflowNfcAnimationDurationSearchingDeviceUnknownTranslationInitial"
        android:valueFrom="120"
        android:valueTo="50"
        android:valueType="floatType"
        android:propertyName="translateY"/>
    <objectAnimator
        android:interpolator="@android:anim/linear_interpolator"
        android:duration="@integer/misnapWorkflowNfcAnimationDurationSearchingDeviceUnknownTranslationInitial"
        android:valueFrom="270"
        android:valueTo="165"
        android:valueType="floatType"
        android:propertyName="translateX"/>
    <objectAnimator
        android:interpolator="@android:anim/linear_interpolator"
        android:duration="@integer/misnapWorkflowNfcAnimationDurationSearchingDeviceUnknownTranslationRepeated"
        android:startOffset="@integer/misnapWorkflowNfcAnimationOffsetSearchingDeviceUnknownTranslationRepeated"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:valueFrom="50"
        android:valueTo="-30"
        android:valueType="floatType"
        android:propertyName="translateY"/>
    <objectAnimator
        android:interpolator="@android:anim/linear_interpolator"
        android:duration="@integer/misnapWorkflowNfcAnimationDurationSearchingDeviceUnknownTranslationRepeated"
        android:startOffset="@integer/misnapWorkflowNfcAnimationOffsetSearchingDeviceUnknownTranslationRepeated"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:valueFrom="165"
        android:valueTo="45"
        android:valueType="floatType"
        android:propertyName="translateX"/>
</set>
