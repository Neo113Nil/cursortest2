<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/standard_black_pressed">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="6dp"/>
            <solid android:color="#000"/>
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="1px"
                android:color="@color/hairline_light_gray"/>
            <corners android:radius="6dp"/>
            <padding
                android:left="12dp"
                android:top="6dp"
                android:right="12dp"
                android:bottom="6dp"/>
        </shape>
    </item>
</ripple>
