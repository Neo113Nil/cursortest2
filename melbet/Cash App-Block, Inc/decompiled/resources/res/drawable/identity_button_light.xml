<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/standard_black_pressed">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="6dp"/>
            <solid android:color="@android:color/white"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="6dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/hairline_gray_normal"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
</ripple>
