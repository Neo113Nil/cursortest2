<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#808080">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#fff"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#808080"/>
                    <corners android:radius="100dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#a0a0a0"/>
                </shape>
            </item>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="#000"/>
                    <corners android:radius="100dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#fff"/>
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#000"/>
                    <corners android:radius="100dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#a0a0a0"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
