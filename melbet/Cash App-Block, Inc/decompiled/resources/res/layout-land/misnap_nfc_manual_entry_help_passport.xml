<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mrzHelpLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/mrzHelpPassportBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpDescriptionPassports"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/misnap_nfc_passport_manual_entry_help_land"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStartHints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.655"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopDobHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.04"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomDobHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.19"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopDocNumberHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.23"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomDocNumberHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.38"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopDoeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.42"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomDoeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.57"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopCountryHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.62"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomCountryHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.76"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopDocTypeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.81"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomDocTypeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.96"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpDocumentType"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottomDocTypeHint"
        app:layout_constraintEnd_toEndOf="@+id/mrzHelpPassportBackground"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartHints"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopDocTypeHint"
        style="@style/MiSnapTheme.TextAppearance.NfcHelp"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpIssuingCountry"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottomCountryHint"
        app:layout_constraintEnd_toEndOf="@+id/mrzHelpPassportBackground"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartHints"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopCountryHint"
        style="@style/MiSnapTheme.TextAppearance.NfcHelp"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpDoe"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottomDoeHint"
        app:layout_constraintEnd_toEndOf="@+id/mrzHelpPassportBackground"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartHints"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopDoeHint"
        style="@style/MiSnapTheme.TextAppearance.NfcHelp"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpDob"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottomDobHint"
        app:layout_constraintEnd_toEndOf="@+id/mrzHelpPassportBackground"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartHints"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopDobHint"
        style="@style/MiSnapTheme.TextAppearance.NfcHelp"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpDocumentNumber"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottomDocNumberHint"
        app:layout_constraintEnd_toEndOf="@+id/mrzHelpPassportBackground"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartHints"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopDocNumberHint"
        style="@style/MiSnapTheme.TextAppearance.NfcHelp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
