<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorSurface"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomContent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineButtonsDivider"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTopContent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineButtonsDivider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.66"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/skipCheckBoxContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/primaryActionButton"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineButtonsDivider"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTopButton"
        app:layout_constraintVertical_chainStyle="packed">
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/skipCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapWorkflowHelpFragmentCheckboxDontShowAgainLabel"
            style="@style/MiSnapTheme.CheckBox"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/primaryActionButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowHelpFragmentButtonContinueLabel"
        android:contentDescription="@string/misnapWorkflowHelpFragmentButtonContinueLabel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/secondaryActionButton"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineButtonsDivider"
        app:layout_constraintTop_toBottomOf="@+id/skipCheckBoxContainer"
        style="@style/MiSnapTheme.Button"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/secondaryActionButton"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowHelpFragmentAccessibilityTutorialButtonStartSessionLabel"
        android:contentDescription="@string/misnapWorkflowHelpFragmentAccessibilityTutorialButtonStartSessionLabel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottomContent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineButtonsDivider"
        app:layout_constraintTop_toBottomOf="@+id/primaryActionButton"
        style="@style/MiSnapTheme.Button.Outlined"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStartContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutVerticalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineEndContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutVerticalMargin"/>
</androidx.constraintlayout.widget.ConstraintLayout>
