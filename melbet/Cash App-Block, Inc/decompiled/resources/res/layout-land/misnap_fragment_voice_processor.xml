<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/captureLayout"
    android:background="@color/colorSurface"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/captureGroup"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="messageAboutPhraseTextView,phraseForPronouncingTextView,         visualizer, helpButton"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/failoverGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="failoverTextView,failoverLayout"/>
    <com.miteksystems.misnap.workflow.view.ProgressTrackerView
        android:id="@+id/progressTrackerView"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progressTrackerViewLowerBound"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTopContent"/>
    <TextView
        android:textAppearance="@style/MiSnapTheme.TextAppearance.HelpMessage"
        android:gravity="center_horizontal"
        android:id="@+id/messageAboutPhraseTextView"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowVoiceProcessorFragmentInstructionLabel"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/textUpperBound"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"/>
    <TextView
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/phraseForPronouncingTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/centerContentUpperBound"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/messageAboutPhraseTextView"
        style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
    <com.miteksystems.misnap.workflow.view.VisualizerView
        android:id="@+id/visualizer"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomContent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toTopOf="@+id/centerContentUpperBound"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/helpButton"
        android:layout_width="@dimen/misnapWorkflowHelpButtonIconSize"
        android:layout_height="@dimen/misnapWorkflowHelpButtonIconSize"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomContent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:id="@+id/failoverTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/centerContentUpperBound"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/progressTrackerViewLowerBound"
        style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/failoverLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomContent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/centerContentUpperBound">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/needHelpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapWorkflowVoiceProcessorFragmentFailoverPopupButtonHelpLabel"
            android:layout_marginEnd="@dimen/misnapWorkflowLayoutHorizontalMargin"
            app:icon="@drawable/misnap_button_help_icon"
            style="@style/MiSnapTheme.Button.Outlined"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/skipButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapWorkflowVoiceProcessorFragmentFailoverPopupButtonSkipLabel"
            app:icon="@drawable/misnap_button_cancel_icon"
            style="@style/MiSnapTheme.Button.Outlined"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tryAgainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapWorkflowVoiceProcessorFragmentFailoverPopupButtonRetryLabel"
            android:layout_marginStart="@dimen/misnapWorkflowLayoutHorizontalMargin"
            app:icon="@drawable/misnap_retry_icon"
            style="@style/MiSnapTheme.Button"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/progressTrackerViewUpperBound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.1"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/progressTrackerViewLowerBound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.25"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/textUpperBound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.4"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/centerContentUpperBound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.65"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStartContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutVerticalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineEndContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutVerticalMargin"/>
</androidx.constraintlayout.widget.ConstraintLayout>
