<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mrzHelpLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/mrzHelpIdBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpDescriptionIds"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/misnap_nfc_id_manual_entry_help_land"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStartFirstColumnHints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.63"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineEndFirstColumnHints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.8"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStartSecondColumnHints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.83"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomDocNumberHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.28"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopDobHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.18"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomDobHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.46"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopDoeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.36"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomDoeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.64"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopCountryHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.54"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomCountryHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.82"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopDocTypeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.72"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpDocumentType"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEndFirstColumnHints"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartFirstColumnHints"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopDocTypeHint"
        style="@style/MiSnapTheme.TextAppearance.NfcHelp"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpIssuingCountry"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottomCountryHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartSecondColumnHints"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopCountryHint"
        style="@style/MiSnapTheme.TextAppearance.NfcHelp"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpDoe"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottomDoeHint"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEndFirstColumnHints"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartFirstColumnHints"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopDoeHint"
        style="@style/MiSnapTheme.TextAppearance.NfcHelp"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpDob"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottomDobHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartSecondColumnHints"
        app:layout_constraintTop_toTopOf="@+id/guidelineTopDobHint"
        style="@style/MiSnapTheme.TextAppearance.NfcHelp"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/misnapWorkflowNfcMrzDataManualEntryFragmentHelpDocumentNumber"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineBottomDocNumberHint"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEndFirstColumnHints"
        app:layout_constraintStart_toStartOf="@+id/guidelineStartFirstColumnHints"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/MiSnapTheme.TextAppearance.NfcHelp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
