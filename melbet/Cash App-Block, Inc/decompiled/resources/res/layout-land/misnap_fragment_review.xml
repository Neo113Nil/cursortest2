<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorSurface"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imagePreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomContent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineDivider"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTopContent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineDivider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.66"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineFooterTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.85"/>
    <com.google.android.material.textview.MaterialTextView
        android:gravity="center"
        android:id="@+id/reviewText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowReviewFragmentImageReviewMessage"
        app:layout_constraintBottom_toTopOf="@+id/satisfiedButton"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineDivider"
        style="@style/MiSnapTheme.TextAppearance.Headline.Medium"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/retakeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowReviewFragmentButtonRetakeLabel"
        android:contentDescription="@string/misnapWorkflowReviewFragmentButtonRetakeLabel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineFooterTop"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineDivider"
        app:layout_constraintTop_toBottomOf="@+id/satisfiedButton"
        style="@style/MiSnapTheme.Button.Outlined"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/satisfiedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/misnapWorkflowReviewFragmentButtonConfirmLabel"
        android:contentDescription="@string/misnapWorkflowReviewFragmentButtonConfirmLabel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineDivider"
        app:layout_constraintTop_toBottomOf="@+id/reviewText"
        style="@style/MiSnapTheme.Button"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStartContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutVerticalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineEndContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutVerticalMargin"/>
</androidx.constraintlayout.widget.ConstraintLayout>
