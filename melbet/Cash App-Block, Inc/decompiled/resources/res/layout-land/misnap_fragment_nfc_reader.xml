<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorSurface"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineButtonsDivider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStartContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTopContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/misnapWorkflowLayoutVerticalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineEndContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutHorizontalMargin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottomContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/misnapWorkflowLayoutVerticalMargin"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/scanAnimation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomContent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineButtonsDivider"
        app:layout_constraintStart_toEndOf="@+id/guidelineStartContent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTopContent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/guidelineTopButton"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineButtonsDivider"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTopContent">
        <com.google.android.material.textview.MaterialTextView
            android:gravity="center"
            android:id="@+id/scanInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            style="@style/MiSnapTheme.TextAppearance.Headline.Small"/>
        <com.google.android.material.textview.MaterialTextView
            android:gravity="center"
            android:id="@+id/readingStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            style="@style/MiSnapTheme.TextAppearance.Headline.Small"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/readProgress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/misnapWorkflowLayoutVerticalMargin"
            android:max="4"
            android:indeterminate="true"
            android:layout_marginStart="@dimen/misnapWorkflowLayoutHorizontalMarginDouble"
            android:layout_marginEnd="@dimen/misnapWorkflowLayoutHorizontalMarginDouble"
            style="@style/Widget.MaterialComponents.LinearProgressIndicator"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomContent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEndContent"
        app:layout_constraintStart_toEndOf="@+id/guidelineButtonsDivider"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTopButton">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/needHelp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapWorkflowNfcReaderFragmentButtonHelpLabel"
            app:icon="@drawable/misnap_button_help_icon"
            style="@style/MiSnapTheme.Button.Outlined"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/skip"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/misnapWorkflowNfcReaderFragmentButtonSkipLabel"
                app:icon="@drawable/misnap_button_cancel_icon"
                style="@style/MiSnapTheme.Button.Outlined"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tryAgain"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/misnapWorkflowNfcReaderFragmentButtonRetryLabel"
                android:layout_marginStart="@dimen/misnapWorkflowLayoutHorizontalMargin"
                app:icon="@drawable/misnap_retry_icon"
                style="@style/MiSnapTheme.Button"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
