<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voiceSessionFlow"
    app:startDestination="@+id/voicePhraseSelectionFragment">
    <fragment
        android:label="@string/misnapWorkflowVoiceProcessorFlowVoicePhraseSelectionFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.VoicePhraseSelectionFragment"
        android:id="@+id/voicePhraseSelectionFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateContinue"
            app:destination="@+id/helpFragment"
            app:popUpTo="@+id/voicePhraseSelectionFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="@string/misnapWorkflowVoiceProcessorFlowHelpFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.HelpFragment"
        android:id="@+id/helpFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="showSkipCheckbox"
            android:defaultValue="true"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateContinue"
            app:destination="@+id/voiceProcessorFragment"
            app:popUpTo="@+id/helpFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="@string/misnapWorkflowVoiceProcessorFlowVoiceProcessorFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.VoiceProcessorFragment"
        android:id="@+id/voiceProcessorFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateHelp"
            app:destination="@+id/helpFragment"
            app:popUpTo="@+id/voiceProcessorFragment"
            app:popUpToInclusive="true">
            <argument
                android:name="showSkipCheckbox"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
        <action
            android:id="@+id/navigateContinue"
            app:popUpTo="@+id/voiceProcessorFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateSkip"
            app:popUpTo="@+id/voiceProcessorFragment"
            app:popUpToInclusive="true"/>
    </fragment>
</navigation>
