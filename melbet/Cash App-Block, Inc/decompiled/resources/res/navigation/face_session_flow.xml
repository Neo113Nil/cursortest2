<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/faceSessionFlow"
    app:startDestination="@+id/helpFragment">
    <fragment
        android:label="@string/misnapWorkflowFaceAnalysisFlowHelpFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.HelpFragment"
        android:id="@+id/helpFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="showSkipCheckbox"
            android:defaultValue="true"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateContinue"
            app:destination="@+id/faceAnalysisFragment"
            app:popUpTo="@+id/helpFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="@string/misnapWorkflowFaceAnalysisFlowFaceAnalysisFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.FaceAnalysisFragment"
        android:id="@+id/faceAnalysisFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateFailover"
            app:destination="@+id/failoverFragment"
            app:popUpTo="@+id/faceAnalysisFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateReview"
            app:destination="@+id/reviewFragment"
            app:popUpTo="@+id/faceAnalysisFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateHelp"
            app:destination="@+id/helpFragment"
            app:popUpTo="@+id/faceAnalysisFragment"
            app:popUpToInclusive="true">
            <argument
                android:name="showSkipCheckbox"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
    </fragment>
    <fragment
        android:label="@string/misnapWorkflowFaceAnalysisFlowFailoverFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.FailoverFragment"
        android:id="@+id/failoverFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateManualSession"
            app:destination="@+id/faceAnalysisFragment"
            app:popUpTo="@+id/failoverFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateAutoSession"
            app:destination="@+id/faceAnalysisFragment"
            app:popUpTo="@+id/failoverFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="@string/misnapWorkflowFaceAnalysisFlowReviewFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.ReviewFragment"
        android:id="@+id/reviewFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateSatisfied"
            app:popUpTo="@+id/reviewFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateRetake"
            app:destination="@+id/faceAnalysisFragment"
            app:popUpTo="@+id/reviewFragment"
            app:popUpToInclusive="true"/>
    </fragment>
</navigation>
