<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nfcReaderFlow"
    app:startDestination="@+id/nfcSelectionFragment">
    <fragment
        android:label="@string/misnapWorkflowNfcReaderFlowNfcSelectionFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.NfcSelectionFragment"
        android:id="@+id/nfcSelectionFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateNfc"
            app:destination="@+id/nfcReaderFragment"
            app:popUpTo="@+id/nfcSelectionFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateMrz1LineManualEntry"
            app:destination="@+id/nfcMrz1LineManualEntryFragment"
            app:popUpTo="@+id/nfcSelectionFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateMrzDataManualEntry"
            app:destination="@+id/nfcMrzDataManualEntryFragment"
            app:popUpTo="@+id/nfcSelectionFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateSkip"
            app:popUpTo="@+id/nfcSelectionFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="@string/misnapWorkflowNfcReaderFlowNfcMrzDataManualEntryFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.NfcMrzDataManualEntryFragment"
        android:id="@+id/nfcMrzDataManualEntryFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateContinue"
            app:destination="@+id/nfcReaderFragment"
            app:popUpTo="@+id/nfcMrzDataManualEntryFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateSkip"
            app:popUpTo="@+id/nfcMrzDataManualEntryFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="@string/misnapWorkflowNfcReaderFlowNfcMrz1LineManualEntryFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.NfcMrz1LineManualEntryFragment"
        android:id="@+id/nfcMrz1LineManualEntryFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateContinue"
            app:destination="@+id/nfcReaderFragment"
            app:popUpTo="@+id/nfcMrz1LineManualEntryFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateSkip"
            app:popUpTo="@+id/nfcMrz1LineManualEntryFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="@string/misnapWorkflowNfcReaderFlowNfcReaderFragmentLabel"
        android:name="com.miteksystems.misnap.workflow.fragment.NfcReaderFragment"
        android:id="@+id/nfcReaderFragment">
        <argument
            android:name="handleOrientation"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/navigateContinue"
            app:popUpTo="@+id/nfcReaderFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/navigateSkip"
            app:popUpTo="@+id/nfcReaderFragment"
            app:popUpToInclusive="true"/>
    </fragment>
</navigation>
