{{PACKAGE}}

import androidx.compose.runtime.Composable
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.runtime.LaunchedEffect
import androidx.compose.runtime.key
import androidx.compose.ui.Modifier
import xyz.block.genie.GenieLogLevel
import xyz.block.genie.expressions.ExpressionEvaluator
import xyz.block.genie.state.GenieCollectionItem
import xyz.block.genie.state.GenieScopedViewState
import xyz.block.genie.state.GenieStateValue
import xyz.block.genie.state.GenieViewState
import xyz.block.genie.state.LocalGenieExpressionEvaluator
import xyz.block.genie.state.LocalGenieLogger
import xyz.block.genie.state.LocalGenieViewState
import {{NODE_PACKAGE}}.ForEach

/**
 * Renders a ForEach proto by stamping its template once per collection item.
 *
 * The view emits no layout of its own — children flow into the surrounding container (e.g. a Column or Row). [modifier]
 * is accepted for API symmetry with other binding views but is discarded; a non-default modifier is logged so the
 * misuse surfaces during development (e.g. `GenieNodeView(node, Modifier.padding(...))` on a node whose root is a
 * ForEach).
 */
@Composable
public fun GenieForEachView(for_each: ForEach, modifier: Modifier = Modifier) {
  val viewState = LocalGenieViewState.current
  val evaluator = LocalGenieExpressionEvaluator.current
  val logger = LocalGenieLogger.current

  // The default `Modifier` companion is a singleton, so referential inequality
  // reliably detects a caller-supplied modifier without false positives.
  val droppedModifier = modifier !== Modifier
  LaunchedEffect(droppedModifier) {
    if (droppedModifier) {
      logger?.log(
        GenieLogLevel.WARNING,
        "Modifier passed to GenieForEachView was discarded. ForEach emits siblings, not a single layout, " +
          "so external modifiers cannot be applied. Wrap the ForEach in a Row/Column/Box if you need to position it.",
      )
    }
  }

  val items = resolveItems(for_each, viewState, evaluator)
  val variable = for_each.item_variable
  val writeTarget = resolveSourceCollectionPath(for_each)

  items.forEach { item ->
    key(item.identityValue) {
      val scoped =
        GenieScopedViewState(
          parent = viewState,
          itemVariable = variable,
          item = item,
          sourceCollectionPath = writeTarget,
        )
      CompositionLocalProvider(LocalGenieViewState provides scoped) { GenieNodeView(for_each.template, Modifier) }
    }
  }
}

private fun resolveItems(
  for_each: ForEach,
  state: GenieViewState,
  evaluator: ExpressionEvaluator,
): List<GenieCollectionItem> {
  val result = runCatching { evaluator.evaluate(for_each.collection, state) }.getOrNull()
  return (result as? GenieStateValue.CollectionValue)?.items ?: emptyList()
}

/**
 * Resolves the source collection path for write-back. Returns the explicit `source` if set, otherwise infers from
 * `collection` when it's a simple `key_path_ref` (source collection). Returns null for derived collections without an
 * explicit `source`.
 */
private fun resolveSourceCollectionPath(for_each: ForEach): List<String>? {
  for_each.source?.let {
    return it.segments
  }
  for_each.collection.key_path_ref?.let {
    return it.segments
  }
  return null
}
