{{PACKAGE}}

import androidx.compose.material3.LocalContentColor
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import xyz.block.genie.expressions.evalString
import xyz.block.genie.state.LocalGenieExpressionEvaluator
import xyz.block.genie.state.LocalGenieViewState
import {{NODE_PACKAGE}}.ComposePlatform

@Composable
internal fun TextView(text: ComposePlatform.Text, style: ResolvedStyle, modifier: Modifier) {
  val evaluator = LocalGenieExpressionEvaluator.current
  val state = LocalGenieViewState.current
  val rendered = evaluator.evalString(text.text, state, default = "")
  val textStyle = style.textStyle ?: MaterialTheme.typography.bodyMedium
  val color = style.contentColor ?: Color.Unspecified
  // Wrap in CompositionLocalProvider so descendant Text/Icon nodes inherit the resolved
  // foreground tint (matches MaterialTheme's content-color propagation pattern).
  CompositionLocalProvider(LocalContentColor provides (style.contentColor ?: LocalContentColor.current)) {
    Text(text = rendered, modifier = modifier, color = color, style = textStyle)
  }
}
