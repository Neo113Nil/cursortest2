{{PACKAGE}}

import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.material3.MaterialTheme
import androidx.compose.runtime.Composable
import androidx.compose.runtime.ReadOnlyComposable
import androidx.compose.ui.graphics.Color
import xyz.block.genie.expressions.ExpressionEvaluator
import xyz.block.genie.expressions.evalEnum
import xyz.block.genie.expressions.evalString
import xyz.block.genie.state.GenieViewState
import {{NODE_PACKAGE}}.ComposePlatform.Color as ColorProto

/**
 * Resolves a `ComposePlatform.Color` proto to a Compose [Color].
 *
 * Mirrors iOS's `ColorResolver.swift` — light/dark variant, hex literal, named-color enum resolution. Material 3
 * `NamedColor` values are read off the ambient [MaterialTheme] so a consumer's theming flows through naturally;
 * primitive colors (RED/GREEN/etc.) map to the literal Compose constants.
 */
@Composable
@ReadOnlyComposable
internal fun resolveColor(color: ColorProto?, evaluator: ExpressionEvaluator, state: GenieViewState): Color? {
  color ?: return null
  val variant = if (isSystemInDarkTheme() && color.dark != null) color.dark else color.light
  variant ?: return null
  return resolveColorValue(variant, evaluator, state)
}

@Composable
@ReadOnlyComposable
private fun resolveColorValue(
  value: ColorProto.ColorValue,
  evaluator: ExpressionEvaluator,
  state: GenieViewState,
): Color? {
  // The oneof exposes `hex` and `named` as nullable properties; only one is set per value.
  value.hex?.let { hexExpr ->
    val hex = evaluator.evalString(hexExpr, state) ?: return null
    return parseHex(hex)
  }
  value.named?.let { namedExpr ->
    val named = evaluator.evalEnum<ColorProto.NamedColor>(namedExpr, state) ?: return null
    return materialColor(named)
  }
  return null
}

@Composable
@ReadOnlyComposable
private fun materialColor(named: ColorProto.NamedColor): Color {
  val s = MaterialTheme.colorScheme
  return when (named) {
    ColorProto.NamedColor.NAMED_COLOR_PRIMARY -> s.primary
    ColorProto.NamedColor.NAMED_COLOR_ON_PRIMARY -> s.onPrimary
    ColorProto.NamedColor.NAMED_COLOR_PRIMARY_CONTAINER -> s.primaryContainer
    ColorProto.NamedColor.NAMED_COLOR_ON_PRIMARY_CONTAINER -> s.onPrimaryContainer
    ColorProto.NamedColor.NAMED_COLOR_SECONDARY -> s.secondary
    ColorProto.NamedColor.NAMED_COLOR_ON_SECONDARY -> s.onSecondary
    ColorProto.NamedColor.NAMED_COLOR_SECONDARY_CONTAINER -> s.secondaryContainer
    ColorProto.NamedColor.NAMED_COLOR_ON_SECONDARY_CONTAINER -> s.onSecondaryContainer
    ColorProto.NamedColor.NAMED_COLOR_TERTIARY -> s.tertiary
    ColorProto.NamedColor.NAMED_COLOR_ON_TERTIARY -> s.onTertiary
    ColorProto.NamedColor.NAMED_COLOR_BACKGROUND -> s.background
    ColorProto.NamedColor.NAMED_COLOR_ON_BACKGROUND -> s.onBackground
    ColorProto.NamedColor.NAMED_COLOR_SURFACE -> s.surface
    ColorProto.NamedColor.NAMED_COLOR_ON_SURFACE -> s.onSurface
    ColorProto.NamedColor.NAMED_COLOR_SURFACE_VARIANT -> s.surfaceVariant
    ColorProto.NamedColor.NAMED_COLOR_ON_SURFACE_VARIANT -> s.onSurfaceVariant
    ColorProto.NamedColor.NAMED_COLOR_ERROR -> s.error
    ColorProto.NamedColor.NAMED_COLOR_ON_ERROR -> s.onError
    ColorProto.NamedColor.NAMED_COLOR_OUTLINE -> s.outline
    ColorProto.NamedColor.NAMED_COLOR_RED -> Color.Red
    ColorProto.NamedColor.NAMED_COLOR_GREEN -> Color.Green
    ColorProto.NamedColor.NAMED_COLOR_BLUE -> Color.Blue
    ColorProto.NamedColor.NAMED_COLOR_BLACK -> Color.Black
    ColorProto.NamedColor.NAMED_COLOR_WHITE -> Color.White
    ColorProto.NamedColor.NAMED_COLOR_GRAY -> Color.Gray
    ColorProto.NamedColor.NAMED_COLOR_TRANSPARENT -> Color.Transparent
    ColorProto.NamedColor.NAMED_COLOR_UNSPECIFIED -> Color.Unspecified
  }
}

private fun parseHex(input: String): Color? {
  val trimmed = input.trim().removePrefix("#")
  return when (trimmed.length) {
    6 -> {
      val rgb = trimmed.toLongOrNull(16) ?: return null
      Color(((rgb or 0xFF000000L) and 0xFFFFFFFFL).toInt())
    }
    8 -> {
      // ARGB shorthand: AARRGGBB
      val argb = trimmed.toLongOrNull(16) ?: return null
      Color((argb and 0xFFFFFFFFL).toInt())
    }
    else -> null
  }
}
