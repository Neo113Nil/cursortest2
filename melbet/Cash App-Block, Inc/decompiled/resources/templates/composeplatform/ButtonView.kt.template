{{PACKAGE}}

import androidx.compose.material3.Button
import androidx.compose.material3.ButtonDefaults
import androidx.compose.material3.ElevatedButton
import androidx.compose.material3.FilledTonalButton
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.OutlinedButton
import androidx.compose.material3.ProvideTextStyle
import androidx.compose.material3.Text
import androidx.compose.material3.TextButton
import androidx.compose.runtime.Composable
import androidx.compose.runtime.rememberCoroutineScope
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import kotlinx.coroutines.launch
import xyz.block.genie.GenieLogLevel
import xyz.block.genie.expressions.evalEnum
import xyz.block.genie.expressions.evalString
import xyz.block.genie.state.LocalGenieActionExecutor
import xyz.block.genie.state.LocalGenieExpressionEvaluator
import xyz.block.genie.state.LocalGenieLogger
import xyz.block.genie.state.LocalGenieViewState
import {{NODE_PACKAGE}}.ComposePlatform
import {{NODE_PACKAGE}}.ComposePlatform.ButtonStyle as ButtonStyleEnum

@Composable
internal fun ButtonView(button: ComposePlatform.Button, style: ResolvedStyle, modifier: Modifier) {
  val evaluator = LocalGenieExpressionEvaluator.current
  val state = LocalGenieViewState.current
  val executor = LocalGenieActionExecutor.current
  val logger = LocalGenieLogger.current
  val scope = rememberCoroutineScope()

  val onClick: () -> Unit = onClick@{
    val action = button.action ?: return@onClick
    val ex = executor ?: return@onClick
    scope.launch {
      try {
        ex.execute(action, state)
      } catch (t: Throwable) {
        logger?.log(GenieLogLevel.ERROR, "Button action failed: ${t.message}")
      }
    }
  }

  val buttonStyle = evaluator.evalEnum<ButtonStyleEnum>(button.style, state) ?: ButtonStyleEnum.BUTTON_STYLE_FILLED
  val resolvedTextStyle = style.textStyle ?: MaterialTheme.typography.labelLarge
  val content: @Composable () -> Unit = {
    val title = button.title
    if (title != null) {
      Text(text = evaluator.evalString(title, state, default = ""), style = resolvedTextStyle)
    } else {
      // ProvideTextStyle threads the button's resolved text style through LocalTextStyle so
      // any Text inside the label subtree picks it up — same typography resolution as the
      // title branch above. ResolvedStyle.textStyle is intentionally not a Modifier (see
      // ModifierApplicator.kt's note on why typography is threaded via composition).
      button.label?.let { label -> ProvideTextStyle(value = resolvedTextStyle) { GenieNodeView(label, Modifier) } }
    }
  }

  // Color.Unspecified is Material 3's "no override" sentinel; ButtonDefaults falls back to the
  // theme defaults for any slot left unspecified.
  val contentColor = style.contentColor ?: Color.Unspecified
  when (buttonStyle) {
    ButtonStyleEnum.BUTTON_STYLE_FILLED,
    ButtonStyleEnum.BUTTON_STYLE_UNSPECIFIED ->
      Button(
        onClick = onClick,
        modifier = modifier,
        colors = ButtonDefaults.buttonColors(contentColor = contentColor),
      ) {
        content()
      }
    ButtonStyleEnum.BUTTON_STYLE_FILLED_TONAL ->
      FilledTonalButton(
        onClick = onClick,
        modifier = modifier,
        colors = ButtonDefaults.filledTonalButtonColors(contentColor = contentColor),
      ) {
        content()
      }
    ButtonStyleEnum.BUTTON_STYLE_ELEVATED ->
      ElevatedButton(
        onClick = onClick,
        modifier = modifier,
        colors = ButtonDefaults.elevatedButtonColors(contentColor = contentColor),
      ) {
        content()
      }
    ButtonStyleEnum.BUTTON_STYLE_OUTLINED ->
      OutlinedButton(
        onClick = onClick,
        modifier = modifier,
        colors = ButtonDefaults.outlinedButtonColors(contentColor = contentColor),
      ) {
        content()
      }
    ButtonStyleEnum.BUTTON_STYLE_TEXT ->
      TextButton(
        onClick = onClick,
        modifier = modifier,
        colors = ButtonDefaults.textButtonColors(contentColor = contentColor),
      ) {
        content()
      }
  }
}
