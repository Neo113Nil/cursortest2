{{PACKAGE}}

import androidx.compose.foundation.layout.Arrangement
import androidx.compose.ui.Alignment
import androidx.compose.ui.unit.Dp
import androidx.compose.ui.unit.dp
import xyz.block.genie.expressions.ExpressionEvaluator
import xyz.block.genie.state.GenieViewState
import {{NODE_PACKAGE}}.ComposePlatform
import xyz.block.protos.genie.Expression

/**
 * Resolves a `ComposePlatform.HorizontalAlignment` expression to the native Compose `Alignment.Horizontal`. Returns
 * `default` if the expression is missing or fails to resolve.
 */
internal fun resolveHorizontalAlignment(
  expression: Expression?,
  evaluator: ExpressionEvaluator,
  viewState: GenieViewState,
  default: Alignment.Horizontal = Alignment.Start,
): Alignment.Horizontal =
  when (resolveProtoEnum(expression, evaluator, viewState, ComposePlatform.HorizontalAlignment::fromValue)) {
    ComposePlatform.HorizontalAlignment.HORIZONTAL_ALIGNMENT_CENTER_HORIZONTALLY -> Alignment.CenterHorizontally
    ComposePlatform.HorizontalAlignment.HORIZONTAL_ALIGNMENT_END -> Alignment.End
    else -> default
  }

/**
 * Resolves a `ComposePlatform.VerticalAlignment` expression to the native Compose `Alignment.Vertical`. Returns
 * `default` if the expression is missing or fails to resolve.
 */
internal fun resolveVerticalAlignment(
  expression: Expression?,
  evaluator: ExpressionEvaluator,
  viewState: GenieViewState,
  default: Alignment.Vertical = Alignment.Top,
): Alignment.Vertical =
  when (resolveProtoEnum(expression, evaluator, viewState, ComposePlatform.VerticalAlignment::fromValue)) {
    ComposePlatform.VerticalAlignment.VERTICAL_ALIGNMENT_CENTER_VERTICALLY -> Alignment.CenterVertically
    ComposePlatform.VerticalAlignment.VERTICAL_ALIGNMENT_BOTTOM -> Alignment.Bottom
    else -> default
  }

/**
 * Resolves a `ComposePlatform.Alignment` expression to the native Compose `Alignment` (used by `Box.contentAlignment`).
 * Returns `default` if the expression is missing or fails to resolve.
 */
internal fun resolveAlignment(
  expression: Expression?,
  evaluator: ExpressionEvaluator,
  viewState: GenieViewState,
  default: Alignment = Alignment.TopStart,
): Alignment =
  when (resolveProtoEnum(expression, evaluator, viewState, ComposePlatform.Alignment::fromValue)) {
    ComposePlatform.Alignment.ALIGNMENT_CENTER -> Alignment.Center
    ComposePlatform.Alignment.ALIGNMENT_TOP_START -> Alignment.TopStart
    ComposePlatform.Alignment.ALIGNMENT_TOP_END -> Alignment.TopEnd
    ComposePlatform.Alignment.ALIGNMENT_BOTTOM_START -> Alignment.BottomStart
    ComposePlatform.Alignment.ALIGNMENT_BOTTOM_END -> Alignment.BottomEnd
    ComposePlatform.Alignment.ALIGNMENT_TOP,
    ComposePlatform.Alignment.ALIGNMENT_TOP_CENTER -> Alignment.TopCenter
    ComposePlatform.Alignment.ALIGNMENT_BOTTOM,
    ComposePlatform.Alignment.ALIGNMENT_BOTTOM_CENTER -> Alignment.BottomCenter
    ComposePlatform.Alignment.ALIGNMENT_START,
    ComposePlatform.Alignment.ALIGNMENT_CENTER_START -> Alignment.CenterStart
    ComposePlatform.Alignment.ALIGNMENT_END,
    ComposePlatform.Alignment.ALIGNMENT_CENTER_END -> Alignment.CenterEnd
    else -> default
  }

/**
 * Resolves a `ComposePlatform.VerticalArrangement` expression to the native Compose `Arrangement.Vertical`. `spacing`
 * is consumed only when the expression resolves to `VERTICAL_ARRANGEMENT_SPACED_BY`.
 */
internal fun resolveVerticalArrangement(
  expression: Expression?,
  evaluator: ExpressionEvaluator,
  viewState: GenieViewState,
  spacing: Dp?,
  default: Arrangement.Vertical = Arrangement.Top,
): Arrangement.Vertical =
  when (resolveProtoEnum(expression, evaluator, viewState, ComposePlatform.VerticalArrangement::fromValue)) {
    ComposePlatform.VerticalArrangement.VERTICAL_ARRANGEMENT_CENTER -> Arrangement.Center
    ComposePlatform.VerticalArrangement.VERTICAL_ARRANGEMENT_BOTTOM -> Arrangement.Bottom
    ComposePlatform.VerticalArrangement.VERTICAL_ARRANGEMENT_SPACE_BETWEEN -> Arrangement.SpaceBetween
    ComposePlatform.VerticalArrangement.VERTICAL_ARRANGEMENT_SPACE_AROUND -> Arrangement.SpaceAround
    ComposePlatform.VerticalArrangement.VERTICAL_ARRANGEMENT_SPACE_EVENLY -> Arrangement.SpaceEvenly
    ComposePlatform.VerticalArrangement.VERTICAL_ARRANGEMENT_SPACED_BY -> Arrangement.spacedBy(spacing ?: 0.dp)
    else -> default
  }

/**
 * Resolves a `ComposePlatform.HorizontalArrangement` expression to the native Compose `Arrangement.Horizontal`.
 * `spacing` is consumed only when the expression resolves to `HORIZONTAL_ARRANGEMENT_SPACED_BY`.
 */
internal fun resolveHorizontalArrangement(
  expression: Expression?,
  evaluator: ExpressionEvaluator,
  viewState: GenieViewState,
  spacing: Dp?,
  default: Arrangement.Horizontal = Arrangement.Start,
): Arrangement.Horizontal =
  when (resolveProtoEnum(expression, evaluator, viewState, ComposePlatform.HorizontalArrangement::fromValue)) {
    ComposePlatform.HorizontalArrangement.HORIZONTAL_ARRANGEMENT_CENTER -> Arrangement.Center
    ComposePlatform.HorizontalArrangement.HORIZONTAL_ARRANGEMENT_END -> Arrangement.End
    ComposePlatform.HorizontalArrangement.HORIZONTAL_ARRANGEMENT_SPACE_BETWEEN -> Arrangement.SpaceBetween
    ComposePlatform.HorizontalArrangement.HORIZONTAL_ARRANGEMENT_SPACE_AROUND -> Arrangement.SpaceAround
    ComposePlatform.HorizontalArrangement.HORIZONTAL_ARRANGEMENT_SPACE_EVENLY -> Arrangement.SpaceEvenly
    ComposePlatform.HorizontalArrangement.HORIZONTAL_ARRANGEMENT_SPACED_BY -> Arrangement.spacedBy(spacing ?: 0.dp)
    else -> default
  }

/**
 * Resolves an `Expression?` to a numeric value and converts it to a Wire-generated proto enum. Returns null if the
 * expression is missing, evaluation throws, or `fromValue` doesn't recognize the raw int.
 */
private fun <E> resolveProtoEnum(
  expression: Expression?,
  evaluator: ExpressionEvaluator,
  viewState: GenieViewState,
  fromValue: (Int) -> E?,
): E? = expression?.let { expr ->
  runCatching { evaluator.evaluate(expr, viewState).numericValue().toInt() }.getOrNull()?.let(fromValue)
}

/**
 * Resolves a numeric `Expression?` to a `Dp` value, returning null if the expression is missing or fails to resolve.
 */
internal fun resolveDp(expression: Expression?, evaluator: ExpressionEvaluator, viewState: GenieViewState): Dp? =
  expression
    ?.let { expr -> runCatching { evaluator.evaluate(expr, viewState).numericValue().toDouble() }.getOrNull() }
    ?.dp
