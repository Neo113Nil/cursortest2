{{PACKAGE}}

import androidx.compose.foundation.Image
import androidx.compose.foundation.background
import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.foundation.layout.Box
import androidx.compose.material3.MaterialTheme
import androidx.compose.runtime.Composable
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.ColorFilter
import xyz.block.genie.expressions.ExpressionEvaluator
import xyz.block.genie.expressions.evalString
import xyz.block.genie.state.GenieImageSource
import xyz.block.genie.state.GenieViewState
import xyz.block.genie.state.LocalGenieExpressionEvaluator
import xyz.block.genie.state.LocalGenieImageLoader
import xyz.block.genie.state.LocalGenieViewState
import {{NODE_PACKAGE}}.ComposePlatform

/**
 * Renders a `ComposePlatform.Image`.
 *
 * The proto carries two source modes — `resource_name` (consumer-supplied drawable identifier) and `url` (network
 * source with an optional dark-mode variant). Resolving either to a Compose `Painter` requires platform-specific
 * machinery — `Context.resources.getIdentifier()` for resources, an image-loading library (Coil/Glide/...) for URLs —
 * so the SDK delegates that to a host-supplied `GenieImageLoader` installed via `LocalGenieImageLoader`.
 *
 * When no loader is installed, or the loader returns `null`, the view falls back to a flat tinted placeholder Box sized
 * by the incoming `modifier` (consumers control size via the proto modifier chain).
 */
@Composable
internal fun ImageView(image: ComposePlatform.Image, style: ResolvedStyle, modifier: Modifier) {
  val evaluator = LocalGenieExpressionEvaluator.current
  val state = LocalGenieViewState.current
  val loader = LocalGenieImageLoader.current
  val source = resolveImageSource(image, evaluator, state, isSystemInDarkTheme())
  val painter = source?.let { loader?.painter(it) }

  if (painter != null) {
    Image(
      painter = painter,
      contentDescription = null,
      modifier = modifier,
      colorFilter = style.tint?.let { ColorFilter.tint(it) },
    )
  } else {
    val placeholderColor = style.tint ?: style.contentColor ?: MaterialTheme.colorScheme.surfaceVariant
    Box(modifier = modifier.background(placeholderColor))
  }
}

private fun resolveImageSource(
  image: ComposePlatform.Image,
  evaluator: ExpressionEvaluator,
  state: GenieViewState,
  isDark: Boolean,
): GenieImageSource? {
  evaluator
    .evalString(image.resource_name, state)
    ?.takeIf { it.isNotEmpty() }
    ?.let {
      return GenieImageSource.Resource(it)
    }
  val url = image.url ?: return null
  val resolved =
    if (isDark) evaluator.evalString(url.dark, state) ?: evaluator.evalString(url.light, state)
    else evaluator.evalString(url.light, state)
  return resolved?.takeIf { it.isNotEmpty() }?.let { GenieImageSource.Url(it) }
}
