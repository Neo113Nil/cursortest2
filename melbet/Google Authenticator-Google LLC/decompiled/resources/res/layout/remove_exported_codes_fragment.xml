<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="25dp"
        android:fillViewport="true"
        android:layout_above="@+id/done_button">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:contentDescription="@string/remove_exported_codes_title"
                android:layout_marginStart="@dimen/text_views_start_end_margin"
                android:layout_marginEnd="@dimen/text_views_start_end_margin"
                android:layout_alignParentStart="true"
                app:srcCompat="@drawable/trash"/>
            <TextView
                android:id="@+id/title"
                android:text="@string/remove_exported_codes_title"
                android:layout_below="@+id/icon"
                style="@style/ExportTitleStyle"/>
            <TextView
                android:id="@+id/text"
                android:text="@string/remove_exported_codes_text"
                android:layout_below="@+id/title"
                style="@style/ExportSubtitleStyle"/>
            <RadioGroup
                android:id="@+id/radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/text"
                android:layout_marginStart="@dimen/radio_button_horizontal_margin"
                android:layout_marginEnd="@dimen/radio_button_horizontal_margin">
                <RadioButton
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:id="@+id/rb_1"
                    android:background="@drawable/top_radio_button_shape"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/radio_button_height"
                    android:layout_marginBottom="10dp"
                    android:checked="true"
                    android:text="@string/keep_exported_codes_button_text"
                    android:paddingStart="@dimen/radio_button_padding"
                    android:paddingEnd="@dimen/radio_button_padding"/>
                <RadioButton
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:id="@+id/rb_2"
                    android:background="@drawable/bottom_radio_button_shape"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/radio_button_height"
                    android:text="@string/remove_exported_codes_button_text"
                    android:paddingStart="@dimen/radio_button_padding"
                    android:paddingEnd="@dimen/radio_button_padding"/>
            </RadioGroup>
        </RelativeLayout>
    </ScrollView>
    <Button
        android:id="@+id/done_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/button_bottom_margin"
        android:text="@string/done"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/qr_code_buttons_horizontal_margin"
        android:layout_marginEnd="@dimen/qr_code_buttons_horizontal_margin"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
