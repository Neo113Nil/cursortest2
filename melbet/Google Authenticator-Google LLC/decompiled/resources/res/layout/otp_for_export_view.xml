<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.authenticator2.migration.exports.OtpForExportView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/export_codes_recycler_view_item_vertical_margin"
    android:layout_marginBottom="@dimen/export_codes_recycler_view_item_vertical_margin">
    <CheckBox
        android:id="@+id/checkbox"
        android:saveEnabled="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"/>
    <TextView
        android:textSize="@dimen/export_codes_recycler_view_item_font_size"
        android:id="@+id/otp_name"
        android:paddingBottom="@dimen/export_codes_recycler_view_text_view_bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.google.android.apps.authenticator2.migration.exports.OtpForExportView>
