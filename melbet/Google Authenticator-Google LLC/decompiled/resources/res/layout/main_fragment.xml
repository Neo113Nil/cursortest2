<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/main_relative_view"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.libraries.material.opensearchbar.OpenSearchBar
                android:id="@+id/open_search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/abc_search_hint"
                app:navigationIcon="@drawable/quantum_gm_ic_menu_vd_theme_24">
                <com.google.android.libraries.material.productlockup.AnimatableProductLockupView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name_long"/>
            </com.google.android.libraries.material.opensearchbar.OpenSearchBar>
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/open_search_bar">
                <android.support.v7.widget.RecyclerView
                    android:id="@+id/otp_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            <include layout="@layout/no_otps_view"/>
            <com.google.android.libraries.material.speeddial.ScrimView
                android:id="@+id/scrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.google.android.libraries.material.speeddial.expandable.ExpandableFloatingActionButton
                android:id="@+id/expandable_fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:contentDescription="@string/add_a_code"
                android:importantForAccessibility="yes"
                android:layout_alignParentEnd="true"
                app:backgroundTint="?attr/colorContainer"
                app:collapsedDrawable="0x7f0800b1"
                app:expandedDrawable="@drawable/expanded_fab_icon"
                style="?attr/floatingActionButtonBrandedStyle"/>
            <com.google.android.libraries.material.speeddial.FloatingSpeedDialView
                android:id="@+id/floating_speed_dial_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/expandable_fab"
                android:layout_marginEnd="@dimen/fabs_end_margin"
                android:layout_alignEnd="@+id/expandable_fab"/>
        </RelativeLayout>
        <com.google.android.libraries.material.opensearchbar.OpenSearchView
            android:id="@+id/open_search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:animateMenuItems="false"
            app:layout_anchor="@+id/open_search_bar">
            <android.support.v7.widget.RecyclerView
                android:id="@+id/filtered_otp_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.google.android.libraries.material.opensearchbar.OpenSearchView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.google.android.material.navigation.NavigationView
        android:layout_gravity="start"
        android:id="@+id/nav_view"
        android:paddingTop="@dimen/navigation_view_header_top_padding"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:headerLayout="@layout/navigation_view_header"
        app:itemIconPadding="@dimen/navigation_menu_horizontal_padding"
        app:itemIconSize="@dimen/navigation_menu_icon_size"
        app:itemTextAppearance="@style/NavigationMenuItemsTextStyle"
        app:itemVerticalPadding="@dimen/navigation_menu_vertical_padding"
        app:menu="@menu/navigation_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>
