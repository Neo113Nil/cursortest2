<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.authenticator2.main.OtpView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">
    <TextView
        android:id="@+id/otp_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/otp_name_top_margin"
        android:layout_marginStart="@dimen/recycler_view_start_end_padding"
        android:layout_marginEnd="@dimen/recycler_view_start_end_padding"
        android:layout_alignParentStart="true"
        style="@style/otpName"/>
    <TextView
        android:id="@+id/otp_code"
        android:layout_marginBottom="@dimen/otp_code_bottom_margin"
        android:layout_below="@+id/otp_name"
        android:layout_marginStart="@dimen/recycler_view_start_end_padding"
        style="@style/otpCode"/>
    <ImageView
        android:id="@+id/hotp_refresh_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/hotp_refresh_button_size"
        android:layout_height="@dimen/hotp_refresh_button_size"
        android:tint="?attr/colorPrimary"
        android:layout_centerVertical="true"
        android:contentDescription="@string/counter_pin"
        android:layout_marginEnd="@dimen/recycler_view_start_end_padding"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/gs_refresh_vd_theme_48"/>
    <com.google.android.apps.authenticator2.main.CountdownIndicatorView
        android:id="@+id/countdown_icon"
        android:layout_width="@dimen/countdown_indicator_size"
        android:layout_height="@dimen/countdown_indicator_size"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/recycler_view_start_end_padding"
        android:layout_alignParentEnd="true"/>
</com.google.android.apps.authenticator2.main.OtpView>
