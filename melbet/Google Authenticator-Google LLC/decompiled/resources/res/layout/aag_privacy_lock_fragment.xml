<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/aag_privacy_lock_app_icon"
        android:layout_width="@dimen/aag_privacy_lock_app_icon_size"
        android:layout_height="@dimen/aag_privacy_lock_app_icon_size"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/aag_privacy_lock_auth_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.7612"/>
    <Button
        android:id="@+id/aag_privacy_lock_auth_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6571"/>
    <ImageView
        android:id="@+id/aag_privacy_lock_logo"
        android:layout_width="@dimen/aag_privacy_lock_logo_width"
        android:layout_height="@dimen/aag_privacy_lock_logo_height"
        android:src="0x7f08004a"
        android:contentDescription="@string/aag_privacy_lock_logo_description"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aag_privacy_lock_auth_button"
        app:layout_constraintVertical_bias="0.6278"/>
</androidx.constraintlayout.widget.ConstraintLayout>
