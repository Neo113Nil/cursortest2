<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/og_bento_container_with_toolbar"
    android:background="?attr/colorSurfaceContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:filterTouchesWhenObscured="true">
    <FrameLayout
        android:id="@+id/og_bento_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/og_bento_scroll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/OneGoogleBentoScrollableContainer">
            <com.google.android.libraries.onegoogle.common.MaxWidthLinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/og_bento_main_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:max_width="@dimen/og_bento_menu_single_pane_compact_header_max_width">
                <FrameLayout
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/og_bento_selected_account_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="2dp"/>
                    <FrameLayout
                        android:id="@+id/og_bento_selected_account_title_button_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/og_bento_accounts_state_layout_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="@dimen/og_bento_element_vertical_margin"/>
                <View
                    android:id="@+id/og_bento_without_accounts_divider"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/og_bento_element_vertical_margin"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/og_bento_accounts_cards_footer_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp">
                    <include layout="@layout/og_bento_accounts_and_cards"/>
                    <include layout="@layout/og_bento_footer_spacer_and_container"/>
                </LinearLayout>
            </com.google.android.libraries.onegoogle.common.MaxWidthLinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    <View
        android:id="@+id/og_bento_disable_content_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/og_bento_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/toolbar_horizontal_padding_single_pane"/>
</FrameLayout>
