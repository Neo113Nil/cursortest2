<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.google.android.libraries.onegoogle.accountmenu.bento.common.BentoRecyclerView
        android:id="@+id/og_bento_cards_above_account_switcher_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/og_bento_account_management_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <HorizontalScrollView
        android:id="@+id/og_bento_selected_account_actions_container"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"/>
    <com.google.android.libraries.onegoogle.accountmenu.bento.common.BentoRecyclerView
        android:id="@+id/og_bento_cards_below_account_switcher_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/og_bento_product_space_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
