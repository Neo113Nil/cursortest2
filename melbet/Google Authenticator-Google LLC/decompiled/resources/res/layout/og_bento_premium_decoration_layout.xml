<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/bento_premium_decoration_container"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/bento_premium_decoration_height"
    android:filterTouchesWhenObscured="true"
    android:paddingHorizontal="@dimen/premium_decoration_padding_horizontal"
    android:paddingVertical="@dimen/premium_decoration_padding_vertical">
    <TextView
        android:textAppearance="@style/TextAppearance.GoogleMaterial3.LabelMedium"
        android:id="@+id/bento_premium_decoration_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:filterTouchesWhenObscured="true"/>
</LinearLayout>
