<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.authenticator2.editotp.AccountView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/account_view_vertical_margin">
    <RadioButton
        android:id="@+id/radio_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/account_avatar_image_view"
        android:layout_width="@dimen/image_view_dimensions"
        android:layout_height="@dimen/image_view_dimensions"
        android:contentDescription="@string/avatar_description"
        android:layout_marginStart="@dimen/image_view_horizontal_margin"
        android:layout_marginEnd="@dimen/image_view_horizontal_margin"/>
    <TextView
        android:id="@+id/account_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.google.android.apps.authenticator2.editotp.AccountView>
