<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/add_first_otp_title"
            android:layout_marginStart="@dimen/first_otp_start_margin"
            app:srcCompat="@drawable/person"/>
        <TextView
            android:id="@+id/title"
            android:layout_marginBottom="20dp"
            android:text="@string/add_first_otp_title"
            style="@style/AddFirstOtpTitleStyle"/>
        <TextView
            android:id="@+id/text"
            android:layout_marginBottom="20dp"
            android:text="@string/add_first_otp_text"
            style="@style/AddFirstOtpSubtitleStyle"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <Button
            android:id="@+id/scan_a_code_button"
            android:layout_marginBottom="0dp"
            android:text="@string/scan_a_qr_code"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:icon="@drawable/gs_photo_camera_vd_theme_24"
            app:iconPadding="16dp"
            app:iconSize="28dp"
            app:iconTint="?attr/colorOnPrimaryContainer"
            app:shapeAppearance="@style/TopButtonShapeAppearance"
            style="@style/CommonButtonsStyle"/>
        <Button
            android:id="@+id/enter_key_button"
            android:text="@string/enter_a_setup_key"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:icon="@drawable/gs_keyboard_alt_vd_theme_24"
            app:iconPadding="16dp"
            app:iconSize="28dp"
            app:iconTint="?attr/colorOnPrimaryContainer"
            app:shapeAppearance="@style/BottomButtonShapeAppearance"
            style="@style/CommonButtonsStyle"/>
    </LinearLayout>
</LinearLayout>
