<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/otp_name_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/enter_key_text_fields_top_bottom_margins_land"
            android:hint="@string/enter_account_label"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/enter_key_text_fields_start_end_margins_land"
            android:layout_marginEnd="@dimen/enter_key_text_fields_start_end_margins_land"
            android:labelFor="@+id/otp_name">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otp_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/otp_secret_key_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/enter_key_text_fields_top_bottom_margins_land"
            android:hint="@string/enter_key_label"
            android:layout_below="@+id/otp_name_input_layout"
            android:layout_marginStart="@dimen/enter_key_text_fields_start_end_margins_land"
            android:layout_marginEnd="@dimen/enter_key_text_fields_start_end_margins_land"
            android:labelFor="@+id/otp_secret_key">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otp_secret_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/enter_key_text_fields_top_bottom_margins_land"
            android:layout_below="@+id/otp_secret_key_input_layout"
            android:layout_marginStart="@dimen/enter_key_text_fields_start_end_margins_land"
            android:layout_marginEnd="@dimen/enter_key_text_fields_start_end_margins_land">
            <View
                android:id="@+id/centerLine"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/dropdown_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/type_of_key"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/enter_key_dropdown_and_button_margins_from_middle"
                android:layout_toStartOf="@+id/centerLine"
                android:layout_alignParentStart="true"
                android:labelFor="@+id/dropdown_menu_text_view"
                style="@style/Widget.GoogleMaterial3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <AutoCompleteTextView
                    android:id="@+id/dropdown_menu_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_key_page_add_button_time_based"
                    android:inputType="none"
                    android:labelFor="@+id/dropdown_menu"/>
            </com.google.android.material.textfield.TextInputLayout>
            <Button
                android:id="@+id/enter_key_add_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enter_key_page_add_button"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/enter_key_dropdown_and_button_margins_from_middle"
                android:layout_toEndOf="@+id/centerLine"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>
