<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/no_otps_view"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/vertical_divisor"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:contentDescription="@string/no_codes_yet"
        android:layout_toStartOf="@+id/vertical_divisor"
        app:srcCompat="@drawable/no_codes_image"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/vertical_divisor">
        <TextView
            android:id="@+id/text_view_no_codes"
            android:text="@string/no_codes_yet"
            android:layout_above="@+id/add_a_code_button"
            style="@style/noCodesYetTextBoxStyle"/>
        <Button
            android:id="@+id/add_a_code_button"
            android:text="@string/add_a_code"
            style="@style/addACodeButtonStyle"/>
        <Button
            android:id="@+id/sign_in_button"
            android:text="@string/sign_in"
            android:layout_below="@+id/add_a_code_button"
            style="@style/signInButtonStyle"/>
    </RelativeLayout>
</RelativeLayout>
