<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v4.widget.NestedScrollView
        android:scrollbarSize="2dp"
        android:scrollbarThumbVertical="@drawable/cmplay_gdpr_dialog_scrollbar"
        android:scrollbarStyle="insideOverlay"
        android:layout_gravity="center_horizontal"
        android:id="@+id/pager_scrollview"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/pager_image"
                android:layout_width="152dp"
                android:layout_height="90dp"
                android:src="@drawable/cmplay__gdpr_pic_game"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#de333333"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/pager_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="We protect your privacy"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#8a000000"
                android:id="@+id/pager_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="12dp"/>
        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>
</FrameLayout>
