<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:background="@drawable/popup_corners"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Button
            android:id="@+id/iv_close"
            android:background="@drawable/vast_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="10dp"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/iv_ad_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="fitStart"
            android:layout_below="@+id/iv_close"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/iv_ad_image">
            <ImageView
                android:id="@+id/iv_ad_icon"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:scaleType="fitCenter"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ff252525"
                android:layout_gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="20dp"
                android:text="app name"
                android:maxLines="2"
                android:layout_below="@+id/iv_ad_icon"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/vast_pic_star"
                android:layout_width="100dp"
                android:layout_height="20dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/vast_pic_star"
                android:layout_below="@+id/tv_title"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ff888888"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/tv_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:maxLines="2"
                android:layout_below="@+id/vast_pic_star"
                android:layout_centerHorizontal="true"/>
            <RelativeLayout
                android:id="@+id/loading_bar"
                android:background="#88000000"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_below="@+id/vast_pic_star"
                android:layout_centerHorizontal="true">
                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/dialog_loading"
                    android:indeterminateBehavior="repeat"
                    android:layout_centerInParent="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <Button
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:id="@+id/btn_calltoaction"
            android:background="@drawable/btn_calltoaction_bg_blue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="25dp"
            android:text="Install"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
