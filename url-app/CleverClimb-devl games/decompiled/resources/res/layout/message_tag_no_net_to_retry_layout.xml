<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/no_net_layout"
    android:background="#ffededed"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffadadad"
            android:gravity="center_horizontal"
            android:id="@+id/tv_no_net"
            android:paddingTop="11dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_tag_webview_no_net_content"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/no_net_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/message_tag_no_net"
            android:layout_above="@+id/tv_no_net"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textSize="14sp"
            android:textColor="#ff4e8cf8"
            android:gravity="center"
            android:id="@+id/btn_retry"
            android:background="@drawable/message_tag_lc_button_w_selector"
            android:paddingLeft="33dp"
            android:paddingRight="33dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/message_tag_webview_no_net_try_again"
            android:layout_below="@+id/tv_no_net"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
