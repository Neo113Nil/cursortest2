<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:FixAspectImageView="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:background="#ffffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <ImageView
            android:layout_width="105dp"
            android:layout_height="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/cmad_video_cm_tag"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_replay"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/cm_vast_ico_renew"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/cm_vast_close"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
    </RelativeLayout>
    <com.cmplay.internalpush.video.DynamicImageView
        android:id="@+id/iv_cover_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        FixAspectImageView:height_aspect="350"
        FixAspectImageView:width_aspect="300"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginLeft="18dp"
            android:scaleType="centerCrop"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <Button
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:id="@+id/btn_calltoaction"
            android:background="@drawable/download_arrow"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginRight="18dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/btn_calltoaction"
            android:layout_toRightOf="@+id/iv_icon"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="23sp"
                android:textColor="#ff252525"
                android:layout_gravity="center"
                android:id="@+id/tv_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:text="@string/vast_model_title"
                android:singleLine="true"/>
            <ImageView
                android:id="@+id/vast_pic_star"
                android:layout_width="100dp"
                android:layout_height="20dp"
                android:src="@drawable/cm_vast_pic_star"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ffcccccc"
                android:id="@+id/tv_download_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="(3,958,035)"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:src="@drawable/google_play"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
