<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/message_tag_tips_bg"
    android:paddingLeft="30dp"
    android:paddingTop="15dp"
    android:paddingRight="30dp"
    android:paddingBottom="15dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/tips_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/msg_toast_image"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_marginRight="15dp"
            android:src="@drawable/com_cmplay_message_tag_success"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#ff333333"
            android:layout_gravity="center_vertical"
            android:id="@+id/msg_toast_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_tag_failed"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/loading_layout"
        android:layout_width="250dp"
        android:layout_height="150dp">
        <ImageView
            android:id="@+id/loading_cicle"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_marginBottom="30dp"
            android:src="@drawable/com_cmplay_message_tag_bule_loading"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#ffda6b2e"
            android:gravity="center"
            android:id="@+id/loading_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_tag_loading"
            android:layout_below="@+id/loading_cicle"/>
    </LinearLayout>
</FrameLayout>
