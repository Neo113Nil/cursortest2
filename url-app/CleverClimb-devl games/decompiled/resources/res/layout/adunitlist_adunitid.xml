<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/card_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/recycler_header"
        style="@style/CardView.Padding">
        <android.support.constraint.ConstraintLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:id="@+id/tv_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ad Unit ID Ad Unit ID Ad Unit ID Ad Unit ID"
                android:maxLines="2"
                app:layout_constraintBottom_toTopOf="@+id/tv_mediation_group"
                app:layout_constraintEnd_toStartOf="@+id/tv_format"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextMarginsStandard"/>
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textStyle="italic"
                android:id="@+id/tv_format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(format)"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_id"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_id"
                style="@style/TextMarginsStandard"/>
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:id="@+id/tv_mediation_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mediation Group"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_id"
                style="@style/TextMarginsStandard"/>
        </android.support.constraint.ConstraintLayout>
    </android.support.v7.widget.CardView>
</LinearLayout>
