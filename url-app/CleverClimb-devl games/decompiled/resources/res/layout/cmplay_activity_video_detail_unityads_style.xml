<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:FixAspectImageView="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:background="#ffffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.cmplay.internalpush.video.DynamicImageView
            android:id="@+id/iv_cover_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            FixAspectImageView:height_aspect="300"
            FixAspectImageView:width_aspect="300"/>
        <ImageView
            android:id="@+id/iv_replay"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/cm_vast_ico_renew"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/cm_vast_close"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_icon"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_marginLeft="20dp"
            android:scaleType="centerCrop"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="14dp"
            android:weightSum="2"
            android:layout_toRightOf="@+id/iv_icon"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="23sp"
                android:textColor="#ff252525"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vast_model_title"
                android:maxLines="2"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="8dp">
                <ImageView
                    android:id="@+id/vast_pic_star"
                    android:layout_width="100dp"
                    android:layout_height="20dp"
                    android:src="@drawable/cm_vast_pic_star"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffcccccc"
                    android:id="@+id/tv_download_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="(3,958,035)"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <Button
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:layout_gravity="center"
        android:id="@+id/btn_calltoaction"
        android:background="@drawable/cmad_btn_calltoaction_bg_blue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:text="@string/learn_more_text"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="105dp"
        android:layout_height="16dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/cmad_video_cm_tag"
        android:layout_alignParentBottom="true"/>
</LinearLayout>
