<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="@dimen/card_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/CardView.Padding">
        <android.support.constraint.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:id="@+id/tv_slot_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Ad Unit"
                android:maxLines="2"
                app:layout_constraintBottom_toTopOf="@+id/tv_sdk"
                app:layout_constraintEnd_toStartOf="@+id/tv_format"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextMarginsStandard"/>
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textStyle="italic"
                android:id="@+id/tv_format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="format"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_slot_id"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_slot_id"
                style="@style/TextMarginsStandard"/>
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:id="@+id/tv_sdk"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SDK"
                android:paddingEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_slot_id"
                style="@style/TextMarginsStandard"/>
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:id="@+id/tv_adapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adapter"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_sdk"
                app:layout_constraintStart_toEndOf="@+id/tv_sdk"
                style="@style/TextPaddingSmall"/>
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:id="@+id/tv_manifest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manifest"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_sdk"
                app:layout_constraintStart_toEndOf="@+id/tv_adapter"
                style="@style/TextPaddingSmall"/>
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:id="@+id/tv_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Test Result"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_sdk"
                app:layout_constraintStart_toEndOf="@+id/tv_manifest"
                style="@style/TextPaddingSmall"/>
        </android.support.constraint.ConstraintLayout>
    </android.support.v7.widget.CardView>
</LinearLayout>
