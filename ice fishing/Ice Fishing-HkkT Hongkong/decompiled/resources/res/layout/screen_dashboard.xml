<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/relativeToolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_60sdp">
        <TextView
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:text="@string/app_name"/>
        <TextView
            android:textSize="@dimen/_11sdp"
            android:textColor="@color/tooltxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:text="Choose a topic to get started"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/relativeToolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_15sdp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp">
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_container_native"
                    android:background="@drawable/background_ad_card"
                    android:layout_width="match_parent"
                    android:layout_height="270dp">
                    <include
                        android:id="@+id/layoutShimmer"
                        layout="@layout/view_ad_native_compact"/>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/ry_native"
                    android:background="@color/ads_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="270dp"/>
                <include
                    android:visibility="visible"
                    layout="@layout/view_qureka_native_large"/>
            </RelativeLayout>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVideoGuide"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:cardBackgroundColor="@color/primarymain_light"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="@dimen/_6sdp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_15sdp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="@dimen/_35sdp"
                        android:layout_height="@dimen/_35sdp"
                        android:src="@drawable/icon_heart"/>
                    <TextView
                        android:textSize="@dimen/_16sdp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_15sdp"
                        android:text="All About Ice Fishing"
                        android:layout_weight="1"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
