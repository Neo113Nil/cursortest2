<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/relativeToolbar"
        android:background="@color/white"
        android:paddingLeft="@dimen/_15sdp"
        android:paddingRight="@dimen/_15sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_60sdp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/black"/>
        <TextView
            android:textSize="@dimen/_16sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:text="@string/app_name"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/relativeToolbar">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/_15sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textColor="@color/black"
                android:id="@+id/tvContentPart1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Content part 1"
                android:lineSpacingExtra="@dimen/_4sdp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_15sdp">
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_container_native"
                    android:background="@drawable/background_ad_card"
                    android:layout_width="match_parent"
                    android:layout_height="270dp">
                    <include
                        android:id="@+id/layoutShimmer"
                        layout="@layout/view_ad_native_compact"/>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/ry_native"
                    android:background="@color/ads_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="270dp"/>
                <include
                    android:id="@+id/QurekaAds_native"
                    android:visibility="visible"
                    layout="@layout/view_qureka_native_large"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textColor="@color/black"
                android:id="@+id/tvContentPart2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Content part 2"
                android:lineSpacingExtra="@dimen/_4sdp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
