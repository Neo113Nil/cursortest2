<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/relativeToolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_65sdp">
        <TextView
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:text="Select Country"/>
        <TextView
            android:textSize="@dimen/_11sdp"
            android:textColor="@color/tooltxt"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:text="Select your Country and enjoy an immersive experience with our app"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/linerBottom"
        android:layout_below="@+id/relativeToolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_15sdp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp">
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_container_native"
                    android:background="@drawable/background_ad_card"
                    android:layout_width="match_parent"
                    android:layout_height="270dp">
                    <include
                        android:id="@+id/layoutShimmer"
                        layout="@layout/view_ad_native_compact"/>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/ry_native"
                    android:background="@color/ads_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="270dp"/>
                <include
                    android:visibility="visible"
                    layout="@layout/view_qureka_native_large"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCountry1"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primarymain_light"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:cardElevation="@dimen/_4sdp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <View
                            android:id="@+id/vSelect1"
                            android:background="@color/black"
                            android:visibility="gone"
                            android:layout_width="6dp"
                            android:layout_height="match_parent"/>
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/flag_option_one"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_10sdp"/>
                        <TextView
                            android:textSize="@dimen/_10sdp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_50sdp"
                            android:text="US"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:id="@+id/imgSelect1"
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:src="@drawable/indicator_unselected"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_15sdp"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCountry2"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primarymain_light"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:cardElevation="@dimen/_4sdp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <View
                            android:id="@+id/vSelect2"
                            android:background="@color/black"
                            android:visibility="gone"
                            android:layout_width="6dp"
                            android:layout_height="match_parent"/>
                        <ImageView
