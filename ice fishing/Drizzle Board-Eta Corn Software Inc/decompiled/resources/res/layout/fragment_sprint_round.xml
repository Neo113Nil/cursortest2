<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/header"
        android:background="@color/bg_surface"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/back_button"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cd_back"/>
        <TextView
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nav_sprint_round"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:id="@+id/round_timer"
            android:background="@drawable/bg_pill_accent"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/round_timer"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/actions_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/round_trait_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sprint_trait_title"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:id="@+id/round_trait_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/round_hint"
                android:background="@drawable/bg_stat_rounded"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/round_order_hint"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/round_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/actions_row"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/round_skip"
            android:background="@drawable/bg_button_outline"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="@string/action_new_set"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:id="@+id/round_submit"
            android:background="@drawable/bg_button_accent"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="@string/action_submit"
            android:layout_weight="2"
            android:textAllCaps="false"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
