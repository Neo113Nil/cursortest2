<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/header"
        android:background="@color/bg_surface"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_taste_ledger"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/header_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ledger_tagline"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/badges_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ledger_badges_title"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/badges_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ledger_badges_subtitle"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/badges_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/coverage_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/ledger_coverage_title"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/coverage_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ledger_coverage_subtitle"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/coverage_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_rounded"
                    android:padding="14dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ledger_coverage_bases"/>
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:id="@+id/coverage_bases_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_rounded"
                    android:padding="14dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ledger_coverage_cuisines"/>
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:id="@+id/coverage_cuisines_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/averages_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/ledger_averages_title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/averages_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_hint"
                android:id="@+id/averages_empty"
                android:background="@drawable/bg_stat_rounded"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ledger_averages_empty"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/ratings_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/ledger_ratings_title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ratings_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_hint"
                android:id="@+id/ratings_empty"
                android:background="@drawable/bg_stat_rounded"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ledger_ratings_empty"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
