<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="22dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="40sp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_mood_title"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:gravity="center"
        android:id="@+id/dialog_mood_name"
        android:background="@drawable/bg_pill_soft"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:id="@+id/dialog_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_mood_body"
        android:lineSpacingExtra="3dp"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_on_accent"
        android:id="@+id/dialog_explore"
        android:background="@drawable/bg_button_accent"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="@string/dialog_mood_explore"
        android:textAllCaps="false"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:id="@+id/dialog_close"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/action_close"
        android:textAllCaps="false"/>
</LinearLayout>
