<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/header"
        android:background="@drawable/bg_header_deep"
        android:paddingTop="20dp"
        android:paddingBottom="22dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_sauce_bench"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/accent_light"
            android:id="@+id/header_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/bench_tagline"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ring_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/ring_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:progress="0"
                            app:indicatorColor="@color/accent"
                            app:indicatorSize="86dp"
                            app:trackColor="@color/stat_bg"
                            app:trackCornerRadius="6dp"
                            app:trackThickness="10dp"/>
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_gravity="center"
                            android:id="@+id/ring_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bench_ring_progress"/>
                    </FrameLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:id="@+id/ring_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bench_ring_title"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:id="@+id/ring_counter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/bench_ring_counter"/>
                        <TextView
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent"
                            android:id="@+id/ring_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/bench_ring_hint"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/bench_status_title"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/status_bar"
                android:background="@drawable/bg_split_track"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="12dp">
                <View
                    android:id="@+id/status_segment_rated"
                    android:background="@drawable/bg_split_rated"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <View
                    android:id="@+id/status_segment_opened"
                    android:background="@drawable/bg_split_opened"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <View
                    android:id="@+id/status_segment_untouched"
                    android:background="@drawable/bg_split_untouched"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <View
                        android:background="@drawable/bg_legend_dot_rated"
                        android:layout_width="10dp"
                        android:layout_height="10dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:id="@+id/status_rated_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/bench_status_rated"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <View
                        android:background="@drawable/bg_legend_dot_opened"
                        android:layout_width="10dp"
                        android:layout_height="10dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:id="@+id/status_opened_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/bench_status_opened"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <View
                        android:background="@drawable/bg_legend_dot_untouched"
                        android:layout_width="10dp"
                        android:layout_height="10dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:id="@+id/status_untouched_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/bench_status_untouched"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/mood_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/bench_mood_title"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/mood_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bench_mood_subtitle"/>
            <HorizontalScrollView
                android:id="@+id/mood_scroll"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/mood_calm"
                        android:background="@drawable/bg_mood_default"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="24sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/emoji_mood_calm"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/mood_calm"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/mood_bold"
                        android:background="@drawable/bg_mood_default"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:textSize="24sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/emoji_mood_bold"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/mood_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/mood_fresh"
                        android:background="@drawable/bg_mood_default"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:textSize="24sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/emoji_mood_fresh"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/mood_fresh"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/mood_cozy"
                        android:background="@drawable/bg_mood_default"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:textSize="24sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/emoji_mood_cozy"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/mood_cozy"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/mood_intense"
                        android:background="@drawable/bg_mood_default"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:textSize="24sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/emoji_mood_intense"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/mood_intense"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rating_block"
                android:background="@drawable/bg_surface_rounded"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:id="@+id/rating_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bench_rating_title"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/rating_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/bench_rating_subtitle"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:id="@+id/rating_pair_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/rating_love"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="22sp"
                            android:gravity="center"
                            android:background="@drawable/bg_rating_face"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:text="@string/emoji_rating_love"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/rating_love"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/rating_good"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="22sp"
                            android:gravity="center"
                            android:background="@drawable/bg_rating_face"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:text="@string/emoji_rating_good"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/rating_good"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/rating_ok"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="22sp"
                            android:gravity="center"
                            android:background="@drawable/bg_rating_face"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:text="@string/emoji_rating_ok"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/rating_ok"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/rating_meh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="22sp"
                            android:gravity="center"
                            android:background="@drawable/bg_rating_face"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:text="@string/emoji_rating_meh"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/rating_meh"/>
                    </LinearLayout>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/rating_skip"
                    android:background="@drawable/bg_button_outline"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/action_skip"
                    android:textAllCaps="false"/>
            </LinearLayout>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/related_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/bench_related_title"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/related_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bench_related_subtitle"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/related_list"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_hint"
                android:id="@+id/related_empty"
                android:background="@drawable/bg_stat_rounded"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/bench_related_empty"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/sprints_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/bench_sprints_title"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/sprints_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bench_sprints_subtitle"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sprints_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_hint"
                android:id="@+id/sprints_empty"
                android:background="@drawable/bg_stat_rounded"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/bench_sprints_empty"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
