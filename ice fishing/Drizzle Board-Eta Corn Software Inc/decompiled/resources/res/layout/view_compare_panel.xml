<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_compare_panel"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="30sp"
        android:id="@+id/panel_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/panel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:gravity="center"
        android:id="@+id/panel_base_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/preview_sauce_base"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/panel_base_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:gravity="center"
        android:id="@+id/panel_intensity_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/preview_intensity"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/panel_intensity_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:gravity="center"
        android:id="@+id/panel_prep_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/preview_prep_time"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/panel_prep_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:gravity="center"
        android:id="@+id/panel_cuisine_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/preview_cuisine"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/panel_cuisine_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
</LinearLayout>
