<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_surface_rounded"
    android:padding="14dp"
    android:layout_width="200dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="12dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="22sp"
            android:id="@+id/compared_left_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_compare"
            android:contentDescription="@string/card_compare_title"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="22sp"
            android:id="@+id/compared_right_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/compared_left_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/compared_right_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"/>
</LinearLayout>
