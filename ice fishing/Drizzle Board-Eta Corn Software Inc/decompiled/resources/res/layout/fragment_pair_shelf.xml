<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/header"
        android:background="@color/bg_surface"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_pair_shelf"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/header_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/shelf_tagline"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/search_container"
            android:background="@drawable/bg_surface_rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">
            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/cd_search"/>
            <EditText
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:id="@+id/search_input"
                android:background="@android:color/transparent"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:hint="@string/shelf_search_hint"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:layout_marginStart="10dp"
                android:importantForAutofill="no"/>
            <ImageView
                android:id="@+id/search_clear"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/cd_clear_search"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/tags_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shelf_tags_title"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/tags_list"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/scope_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/shelf_scope_title"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <HorizontalScrollView
                android:id="@+id/scope_scroll"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_scope_wide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scope_wide"
                        android:checkable="true"
                        style="@style/ScopeChip"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_scope_focused"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scope_focused"
                        android:checkable="true"
                        android:layout_marginStart="8dp"
                        style="@style/ScopeChip"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_scope_specialized"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scope_specialized"
                        android:checkable="true"
                        android:layout_marginStart="8dp"
                        style="@style/ScopeChip"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_scope_universal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scope_universal"
                        android:checkable="true"
                        android:layout_marginStart="8dp"
                        style="@style/ScopeChip"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_scope_narrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scope_narrow"
                        android:checkable="true"
                        android:layout_marginStart="8dp"
                        style="@style/ScopeChip"/>
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/prefilter_row"
                android:background="@drawable/bg_stat_rounded"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:id="@+id/prefilter_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/shelf_prefilter_label"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="13sp"
                    android:textColor="@color/accent"
                    android:id="@+id/prefilter_clear"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_clear"
                    android:textAllCaps="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:id="@+id/sort_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shelf_sort_title"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/text_on_accent"
                        android:gravity="center"
                        android:id="@+id/sort_name"
                        android:background="@drawable/bg_pill_accent"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_name"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:id="@+id/sort_novelty"
                        android:background="@drawable/bg_pill_soft"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_novelty"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:id="@+id/sort_popularity"
                        android:background="@drawable/bg_pill_soft"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_popularity"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:id="@+id/density_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/shelf_density_title"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:id="@+id/density_compact"
                        android:background="@drawable/bg_pill_soft"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/density_compact"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/text_on_accent"
                        android:gravity="center"
                        android:id="@+id/density_standard"
                        android:background="@drawable/bg_pill_accent"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/density_standard"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:id="@+id/density_large"
                        android:background="@drawable/bg_pill_soft"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/density_large"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:id="@+id/compared_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/shelf_compared_title"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/compared_list"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_hint"
                android:id="@+id/compared_empty"
                android:background="@drawable/bg_stat_rounded"
                android:padding="14dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/shelf_compared_empty"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <View
                android:background="@color/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:id="@+id/results_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/shelf_results"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pairs_list"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/pairs_empty"
                android:background="@drawable/bg_surface_rounded"
                android:padding="24dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_empty_plate"
                    android:contentDescription="@string/shelf_empty"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/shelf_empty"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_hint"
                android:gravity="center"
                android:id="@+id/long_press_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/shelf_long_press_hint"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/letter_index"
        android:background="@drawable/bg_letter_index"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:alpha="0"
        android:layout_marginEnd="6dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/content_scroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/content_scroll"/>
    <FrameLayout
        android:id="@+id/compare_panels_overlay"
        android:background="@drawable/bg_scrim"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_dialog"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:id="@+id/panels_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/card_compare_title"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/panels_close"
                    android:padding="8dp"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/cd_close"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <include
                    android:id="@+id/panel_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/view_compare_panel"/>
                <include
                    android:id="@+id/panel_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    layout="@layout/view_compare_panel"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
