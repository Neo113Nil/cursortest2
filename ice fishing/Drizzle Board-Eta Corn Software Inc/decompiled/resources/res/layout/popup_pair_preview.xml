<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_preview"
    android:padding="16dp"
    android:layout_width="260dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="26sp"
            android:id="@+id/preview_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:id="@+id/preview_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <View
        android:background="@color/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/preview_sauce_base"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:gravity="end"
            android:id="@+id/preview_base_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/preview_intensity"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:gravity="end"
            android:id="@+id/preview_intensity_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/preview_prep_time"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:gravity="end"
            android:id="@+id/preview_prep_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/preview_cuisine"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:gravity="end"
            android:id="@+id/preview_cuisine_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
