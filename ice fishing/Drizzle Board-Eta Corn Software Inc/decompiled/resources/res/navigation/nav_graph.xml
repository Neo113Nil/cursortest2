<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_main"
    app:startDestination="@+id/fragment_sauce_bench">
    <fragment
        android:label="@string/nav_sauce_bench"
        android:name="com.kolosta.rejin.jilosa.presentation.ui.SauceBenchFragment"
        android:id="@+id/fragment_sauce_bench">
        <action
            android:id="@+id/action_sauce_bench_to_pairing_card"
            app:destination="@+id/fragment_pairing_card"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_sauce_bench_to_sprint_recap"
            app:destination="@+id/fragment_sprint_recap"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="@string/nav_pair_shelf"
        android:name="com.kolosta.rejin.jilosa.presentation.ui.PairShelfFragment"
        android:id="@+id/fragment_pair_shelf">
        <action
            android:id="@+id/action_pair_shelf_to_pairing_card"
            app:destination="@+id/fragment_pairing_card"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="@string/nav_sort_sprint"
        android:name="com.kolosta.rejin.jilosa.presentation.ui.SortSprintFragment"
        android:id="@+id/fragment_sort_sprint">
        <action
            android:id="@+id/action_sort_sprint_to_sprint_round"
            app:destination="@+id/fragment_sprint_round"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="@string/nav_taste_ledger"
        android:name="com.kolosta.rejin.jilosa.presentation.ui.TasteLedgerFragment"
        android:id="@+id/fragment_taste_ledger">
        <action
            android:id="@+id/action_taste_ledger_to_pairing_card"
            app:destination="@+id/fragment_pairing_card"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_taste_ledger_to_sprint_recap"
            app:destination="@+id/fragment_sprint_recap"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="@string/nav_pairing_card"
        android:name="com.kolosta.rejin.jilosa.presentation.ui.PairingCardFragment"
        android:id="@+id/fragment_pairing_card">
        <argument
            android:name="pairId"
            app:argType="long"/>
    </fragment>
    <fragment
        android:label="@string/nav_sprint_round"
        android:name="com.kolosta.rejin.jilosa.presentation.ui.SprintRoundFragment"
        android:id="@+id/fragment_sprint_round">
        <argument
            android:name="traitKey"
            app:argType="string"/>
        <action
            android:id="@+id/action_sprint_round_to_sprint_recap"
            app:destination="@+id/fragment_sprint_recap"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/fragment_sort_sprint"/>
    </fragment>
    <fragment
        android:label="@string/nav_sprint_recap"
        android:name="com.kolosta.rejin.jilosa.presentation.ui.SprintRecapFragment"
        android:id="@+id/fragment_sprint_recap">
        <argument
            android:name="roundId"
            android:defaultValue="-1L"
            app:argType="long"/>
        <action
            android:id="@+id/action_sprint_recap_to_sprint_round"
            app:destination="@+id/fragment_sprint_round"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/fragment_sort_sprint"/>
    </fragment>
</navigation>
