    <string name="move_barre_work_kit">A barre or a steady chair back</string>
    <string name="move_barre_work_mover">Quads, glutes and ankles</string>
    <string name="move_barre_work_name">Ballet barre work</string>
    <string name="move_barre_work_pace">Small ranges held under tension with the legs turned out, which costs far more than the size of the movement suggests.</string>
    <string name="move_chopping_firewood_kit">An axe, a block and dry logs</string>
    <string name="move_chopping_firewood_mover">Back, shoulders and core</string>
    <string name="move_chopping_firewood_name">Chopping firewood</string>
    <string name="move_chopping_firewood_pace">Full-body swings with a heavy head at the end of them, paid in short sets because nothing about the grip lets you go longer.</string>
    <string name="move_cooking_dinner_kit">A hob, a board and an hour</string>
    <string name="move_cooking_dinner_mover">Calves and forearms</string>
    <string name="move_cooking_dinner_name">Cooking a full dinner</string>
    <string name="move_cooking_dinner_pace">An hour on your feet, turning between board and hob, spending far more in standing and reaching than in any one task.</string>
    <string name="move_corner_shop_stroll_kit">Shoes and somewhere to be</string>
    <string name="move_corner_shop_stroll_mover">Calves and hip flexors</string>
    <string name="move_corner_shop_stroll_name">Strolling to the corner shop</string>
    <string name="move_corner_shop_stroll_pace">An unhurried pace with stops at kerbs — pleasant, useful, and only just above sitting still.</string>
    <string name="move_cycle_commute_kit">A bike, lights and a lock</string>
    <string name="move_cycle_commute_mover">Quads and glutes</string>
    <string name="move_cycle_commute_name">Cycling to work</string>
    <string name="move_cycle_commute_pace">Hard on the pedals between lights and free on the descents, which is why an honest average sits under a jog rather than over it.</string>
    <string name="move_dog_walk_brisk_kit">A lead and a dog with opinions</string>
    <string name="move_dog_walk_brisk_mover">Glutes, calves and shoulders</string>
    <string name="move_dog_walk_brisk_name">Brisk walk with the dog</string>
    <string name="move_dog_walk_brisk_pace">Faster than a stroll and rarely steady: the stops are short and the pulls are what put the shoulders into it.</string>
    <string name="move_folding_laundry_kit">A full basket and a flat surface</string>
    <string name="move_folding_laundry_mover">Shoulders and forearms</string>
    <string name="move_folding_laundry_name">Folding laundry</string>
    <string name="move_folding_laundry_pace">The lowest simmer in the index: you are standing still, the arms do small repeated work, and the only thing that rises is the pile.</string>
    <string name="move_free_weights_kit">Dumbbells and a rack</string>
    <string name="move_free_weights_mover">Whole body, by turns</string>
    <string name="move_free_weights_name">Lifting free weights</string>
    <string name="move_free_weights_pace">Bursts of real load separated by rests, which is why an hour of it averages the same as pushing a mower.</string>
    <string name="move_front_crawl_laps_kit">A pool and a lane to yourself</string>
    <string name="move_front_crawl_laps_mover">Lats, shoulders and core</string>
    <string name="move_front_crawl_laps_name">Front crawl laps</string>
    <string name="move_front_crawl_laps_pace">Level with the hardest thing in the index, and the only one where the whole body is loaded at once with nothing to lean on.</string>
    <string name="move_groceries_upstairs_kit">Two heavy bags and a stairwell</string>
    <string name="move_groceries_upstairs_mover">Quads, glutes and grip</string>
    <string name="move_groceries_upstairs_name">Carrying groceries upstairs</string>
    <string name="move_groceries_upstairs_pace">Loaded stairs are the cheapest hard work there is — the weight is already bought and the climb is already on your way home.</string>
    <string name="move_kayak_paddle_kit">A kayak, a paddle and a river</string>
    <string name="move_kayak_paddle_mover">Shoulders, obliques and back</string>
    <string name="move_kayak_paddle_name">Paddling a kayak</string>
    <string name="move_kayak_paddle_pace">A rotation more than a pull: the obliques turn the torso and the arms only carry the paddle through the water.</string>
    <string name="move_lake_rowing_kit">A boat, oars and flat water</string>
    <string name="move_lake_rowing_mover">Lats, legs and grip</string>
    <string name="move_lake_rowing_name">Rowing on the lake</string>
    <string name="move_lake_rowing_pace">Legs first, then back, then arms, once per stroke — the most whole-body sequence here, paid for in grip long before lungs.</string>
    <string name="move_mat_tumbling_kit">A sprung mat and a spotter</string>
    <string name="move_mat_tumbling_mover">Core, shoulders and wrists</string>
    <string name="move_mat_tumbling_name">Tumbling on the mat</string>
    <string name="move_mat_tumbling_pace">Explosive and brief, over and over, with the wrists taking the landing the legs would normally handle.</string>
    <string name="move_ping_pong_rally_kit">A table, a bat and an opponent</string>
    <string name="move_ping_pong_rally_mover">Forearms, calves and eyes</string>
    <string name="move_ping_pong_rally_name">Ping-pong rally</string>
    <string name="move_ping_pong_rally_pace">Tiny movements at high speed inside two metres — the burn is all in the constant readiness rather than in any one shot.</string>
    <string name="move_push_mowing_kit">A push mower and a long lawn</string>
    <string name="move_push_mowing_mover">Shoulders, quads and grip</string>
    <string name="move_push_mowing_name">Mowing with a push mower</string>
    <string name="move_push_mowing_pace">A steady shove into resistance, turned at every end of the lawn — the closest thing in the yard to a loaded walk.</string>
    <string name="move_raking_leaves_kit">A rake and an autumn lawn</string>
    <string name="move_raking_leaves_mover">Shoulders, back and grip</string>
    <string name="move_raking_leaves_name">Raking leaves</string>
    <string name="move_raking_leaves_pace">A pulling rhythm with a twist in it, and a lawn that never looks finished until the light goes.</string>
    <string name="move_rough_trail_hike_kit">Boots, water and a rising path</string>
    <string name="move_rough_trail_hike_mover">Quads, glutes and stabilisers</string>
    <string name="move_rough_trail_hike_name">Hiking a rough trail</string>
    <string name="move_rough_trail_hike_pace">Slow going that burns like fast going: the gradient and the uneven ground do the work that speed does on a flat road.</string>
    <string name="move_scrubbing_bathtub_kit">A brush and something to kneel on</string>
    <string name="move_scrubbing_bathtub_mover">Triceps, shoulders and knees</string>
    <string name="move_scrubbing_bathtub_name">Scrubbing the bathtub</string>
    <string name="move_scrubbing_bathtub_pace">Short, hard, awkward work at arm\'s length over a rim, held in a position no one would choose to hold.</string>
    <string name="move_shadow_boxing_kit">Three metres of clear floor</string>
    <string name="move_shadow_boxing_mover">Shoulders, core and calves</string>
    <string name="move_shadow_boxing_name">Shadow boxing</string>
    <string name="move_shadow_boxing_pace">Nothing to hit and nowhere to go, and still near the top of the scale — the feet never stop and the hands never rest.</string>
    <string name="move_shovelling_snow_kit">A shovel and a path to clear</string>
    <string name="move_shovelling_snow_mover">Lower back, shoulders and legs</string>
    <string name="move_shovelling_snow_name">Shovelling snow</string>
    <string name="move_shovelling_snow_pace">Lifting a loaded blade and throwing it sideways, in cold air, which is exactly the combination that surprises people.</string>
    <string name="move_skateboard_flat_kit">A board and smooth tarmac</string>
    <string name="move_skateboard_flat_mover">Ankles, calves and core</string>
    <string name="move_skateboard_flat_name">Skateboarding the flat</string>
    <string name="move_skateboard_flat_pace">One leg pushes, the other balances, and the constant small corrections of the ankles cost more than the pushing does.</string>
    <string name="move_small_wave_surf_kit">A board and a forgiving break</string>
    <string name="move_small_wave_surf_mover">Shoulders, back and legs</string>
    <string name="move_small_wave_surf_name">Surfing small waves</string>
    <string name="move_small_wave_surf_pace">Averages low because most of it is waiting — the paddling is fierce and the sitting between sets is not.</string>
    <string name="move_stairwell_climb_kit">Any building with six floors</string>
    <string name="move_stairwell_climb_mover">Quads, glutes and calves</string>
    <string name="move_stairwell_climb_name">Climbing the stairwell</string>
    <string name="move_stairwell_climb_pace">Near the top of the whole index and it needs no kit at all — every step lifts your own weight the height of a riser, without pause.</string>
    <string name="move_steady_jog_kit">Running shoes and a known route</string>
    <string name="move_steady_jog_mover">Calves, hamstrings and heart</string>
    <string name="move_steady_jog_name">Jogging a steady loop</string>
    <string name="move_steady_jog_pace">The reference burn of the index — an even pace you can hold a broken conversation through, sustained for as long as the loop takes.</string>
    <string name="move_treading_water_kit">Deep water and patience</string>
    <string name="move_treading_water_mover">Shoulders, hip flexors and core</string>
    <string name="move_treading_water_name">Treading water</string>
    <string name="move_treading_water_pace">Going nowhere at all, gently, forever — the effort of simply not sinking, which is modest until the minutes add up.</string>
    <string name="move_vacuuming_hallway_kit">A vacuum and a cluttered floor</string>
    <string name="move_vacuuming_hallway_mover">Shoulders, core and calves</string>
    <string name="move_vacuuming_hallway_name">Vacuuming the hallway</string>
    <string name="move_vacuuming_hallway_pace">Push, pull, step, repeat. The resistance of the head against carpet is what lifts this clear of tidying up.</string>
    <string name="move_washing_dishes_kit">A full sink and twenty minutes</string>
    <string name="move_washing_dishes_mover">Forearms and lower back</string>
    <string name="move_washing_dishes_name">Washing dishes by hand</string>
    <string name="move_washing_dishes_pace">Warm water, a fixed stance and a slow lean forward — the back does more of this than anyone expects by the end of a big sink.</string>
    <string name="move_yoga_flow_kit">A mat and floor space</string>
    <string name="move_yoga_flow_mover">Core, shoulders and hips</string>
    <string name="move_yoga_flow_name">Holding a yoga flow</string>
    <string name="move_yoga_flow_pace">Held positions rather than repetitions, so the number stays low while the shoulders argue otherwise.</string>
