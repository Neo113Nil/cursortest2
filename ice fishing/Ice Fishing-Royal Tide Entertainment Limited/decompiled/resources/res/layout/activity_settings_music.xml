<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageView2"
        android:background="@drawable/main_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="#a4000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="40sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/difText"
        android:layout_width="174dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Difficulty"
        android:fontFamily="@font/ringofont"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/medium"
        android:background="@drawable/bg_for_text"
        android:layout_width="174dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:text="Medium Mode"
        android:fontFamily="@font/ringofont"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/difText"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/hard"
        android:background="@drawable/bg_for_text"
        android:layout_width="174dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:text="Hard Mode"
        android:fontFamily="@font/ringofont"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/medium"/>
    <TextView
        android:textSize="30dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/otherText"
        android:layout_width="174dp"
        android:layout_height="wrap_content"
        android:text="Other Settings"
        android:fontFamily="@font/ringofont"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hard"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/clear"
        android:background="@drawable/bg_for_text"
        android:layout_width="174dp"
        android:layout_height="40dp"
        android:text="Clear cache"
        android:fontFamily="@font/ringofont"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/otherText"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/share"
        android:background="@drawable/bg_for_text"
        android:layout_width="174dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:text="Share Us"
        android:fontFamily="@font/ringofont"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clear"/>
    <Switch
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/musicSwitch"
        android:background="@drawable/bg_for_text"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_marginTop="472dp"
        android:text="Music"
        android:fontFamily="@font/ringofont"
        android:paddingEnd="30dp"
        android:thumbTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/musicIcon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/load2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/musicSwitch"/>
</androidx.constraintlayout.widget.ConstraintLayout>
