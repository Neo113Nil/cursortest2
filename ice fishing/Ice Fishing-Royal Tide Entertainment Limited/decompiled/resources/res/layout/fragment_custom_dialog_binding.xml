<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/dialogTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="By selecting &apos;Agree&apos;, you confirm that you have reviewed, comprehended, and consent to comply with the Privacy Policy"
        android:fontFamily="@font/ringofont"
        android:textAlignment="center"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/agreeButton"
        android:background="@drawable/bg_for_text"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="Agree"
        android:fontFamily="@font/ringofont"/>
</LinearLayout>
