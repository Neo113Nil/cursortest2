<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/homeFragment">
    <fragment
        android:label="@string/nav_home"
        android:name="com.lumenpath.harispro.hrnavigator.ui.home.HomeFragment"
        android:id="@+id/homeFragment"/>
    <fragment
        android:label="@string/nav_knowledge"
        android:name="com.lumenpath.harispro.hrnavigator.ui.knowledge.KnowledgeFragment"
        android:id="@+id/knowledgeFragment">
        <action
            android:id="@+id/action_knowledge_to_article"
            app:destination="@+id/articleFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Article"
        android:name="com.lumenpath.harispro.hrnavigator.ui.knowledge.ArticleFragment"
        android:id="@+id/articleFragment">
        <argument
            android:name="articleId"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="@string/nav_tools"
        android:name="com.lumenpath.harispro.hrnavigator.ui.tools.ToolsFragment"
        android:id="@+id/toolsFragment"/>
    <fragment
        android:label="@string/nav_services"
        android:name="com.lumenpath.harispro.hrnavigator.ui.services.ServicesFragment"
        android:id="@+id/servicesFragment"/>
    <fragment
        android:label="@string/nav_company"
        android:name="com.lumenpath.harispro.hrnavigator.ui.company.CompanyFragment"
        android:id="@+id/companyFragment"/>
    <fragment
        android:label="HR Check-Up"
        android:name="com.lumenpath.harispro.hrnavigator.ui.diagnostics.DiagnosticFragment"
        android:id="@+id/diagnosticFragment"/>
    <fragment
        android:label="Result"
        android:name="com.lumenpath.harispro.hrnavigator.ui.diagnostics.DiagnosticResultFragment"
        android:id="@+id/diagnosticResultFragment">
        <argument
            android:name="diagnosticScore"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="Checklists"
        android:name="com.lumenpath.harispro.hrnavigator.ui.checklist.ChecklistListFragment"
        android:id="@+id/checklistListFragment">
        <action
            android:id="@+id/action_checklist_list_to_detail"
            app:destination="@+id/checklistDetailFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Checklist"
        android:name="com.lumenpath.harispro.hrnavigator.ui.checklist.ChecklistDetailFragment"
        android:id="@+id/checklistDetailFragment">
        <argument
            android:name="checklistId"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="HR Builder"
        android:name="com.lumenpath.harispro.hrnavigator.ui.builder.BuilderFragment"
        android:id="@+id/builderFragment"/>
    <fragment
        android:label="HR Dictionary"
        android:name="com.lumenpath.harispro.hrnavigator.ui.dictionary.DictionaryFragment"
        android:id="@+id/dictionaryFragment">
        <action
            android:id="@+id/action_dictionary_to_term"
            app:destination="@+id/termFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Term"
        android:name="com.lumenpath.harispro.hrnavigator.ui.dictionary.TermFragment"
        android:id="@+id/termFragment">
        <argument
            android:name="termId"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="Org Structures"
        android:name="com.lumenpath.harispro.hrnavigator.ui.structures.StructureListFragment"
        android:id="@+id/structureListFragment">
        <action
            android:id="@+id/action_structure_list_to_detail"
            app:destination="@+id/structureDetailFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Structure"
        android:name="com.lumenpath.harispro.hrnavigator.ui.structures.StructureDetailFragment"
        android:id="@+id/structureDetailFragment">
        <argument
            android:name="structureId"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="Calculators"
        android:name="com.lumenpath.harispro.hrnavigator.ui.calculators.CalculatorListFragment"
        android:id="@+id/calculatorListFragment">
        <action
            android:id="@+id/action_calculator_list_to_detail"
            app:destination="@+id/calculatorFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Calculator"
        android:name="com.lumenpath.harispro.hrnavigator.ui.calculators.CalculatorFragment"
        android:id="@+id/calculatorFragment">
        <argument
            android:name="calculatorId"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="Common Mistakes"
        android:name="com.lumenpath.harispro.hrnavigator.ui.mistakes.MistakeListFragment"
        android:id="@+id/mistakeListFragment">
        <action
            android:id="@+id/action_mistake_list_to_detail"
            app:destination="@+id/mistakeDetailFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Mistake"
        android:name="com.lumenpath.harispro.hrnavigator.ui.mistakes.MistakeDetailFragment"
        android:id="@+id/mistakeDetailFragment">
        <argument
            android:name="mistakeId"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="Implementation Plan"
        android:name="com.lumenpath.harispro.hrnavigator.ui.roadmap.RoadmapListFragment"
        android:id="@+id/roadmapListFragment">
        <action
            android:id="@+id/action_roadmap_list_to_detail"
            app:destination="@+id/roadmapDetailFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Plan"
        android:name="com.lumenpath.harispro.hrnavigator.ui.roadmap.RoadmapDetailFragment"
        android:id="@+id/roadmapDetailFragment">
        <argument
            android:name="roadmapId"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="Mini Tests"
        android:name="com.lumenpath.harispro.hrnavigator.ui.quiz.QuizListFragment"
        android:id="@+id/quizListFragment">
        <action
            android:id="@+id/action_quiz_list_to_quiz"
            app:destination="@+id/quizFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Test"
        android:name="com.lumenpath.harispro.hrnavigator.ui.quiz.QuizFragment"
        android:id="@+id/quizFragment">
        <argument
            android:name="quizId"
            app:argType="integer"/>
        <action
            android:id="@+id/action_quiz_to_result"
            app:destination="@+id/quizResultFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Result"
        android:name="com.lumenpath.harispro.hrnavigator.ui.quiz.QuizResultFragment"
        android:id="@+id/quizResultFragment">
        <argument
            android:name="quizScore"
            app:argType="integer"/>
        <argument
            android:name="quizTotal"
            app:argType="integer"/>
        <argument
            android:name="quizTitle"
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="HR Metrics"
        android:name="com.lumenpath.harispro.hrnavigator.ui.metrics.MetricsListFragment"
        android:id="@+id/metricsListFragment">
        <action
            android:id="@+id/action_metrics_to_detail"
            app:destination="@+id/metricDetailFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Metric"
        android:name="com.lumenpath.harispro.hrnavigator.ui.metrics.MetricDetailFragment"
        android:id="@+id/metricDetailFragment">
        <argument
            android:name="metricId"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="HR Templates"
        android:name="com.lumenpath.harispro.hrnavigator.ui.templates.TemplatesListFragment"
        android:id="@+id/templatesListFragment">
        <action
            android:id="@+id/action_templates_to_detail"
            app:destination="@+id/templateDetailFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:label="Template"
        android:name="com.lumenpath.harispro.hrnavigator.ui.templates.TemplateDetailFragment"
        android:id="@+id/templateDetailFragment">
        <argument
            android:name="templateId"
            app:argType="integer"/>
    </fragment>
    <action
        android:id="@+id/action_global_diagnostic"
        app:destination="@+id/diagnosticFragment"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@android:anim/fade_out"/>
    <action
        android:id="@+id/action_global_home"
        app:destination="@+id/homeFragment"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@android:anim/fade_out"
        app:launchSingleTop="true"
        app:popUpTo="@+id/homeFragment"
        app:popUpToInclusive="false"/>
    <action
        android:id="@+id/action_global_services"
        app:destination="@+id/servicesFragment"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@android:anim/fade_out"/>
    <action
        android:id="@+id/action_global_knowledge"
        app:destination="@+id/knowledgeFragment"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@android:anim/fade_out"/>
    <action
        android:id="@+id/action_global_builder"
        app:destination="@+id/builderFragment"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@android:anim/fade_out"/>
    <action
        android:id="@+id/action_global_checklists"
        app:destination="@+id/checklistListFragment"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@android:anim/fade_out"/>
    <action
        android:id="@+id/action_diagnostic_to_result"
        app:destination="@+id/diagnosticResultFragment"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@android:anim/fade_out"/>
</navigation>
