<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/haris_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/haris_primary"
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/haris_accent"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="@dimen/spacing_sm"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            style="@style/CardStyle">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What is it"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Body"
                    android:textColor="@color/haris_on_surface"
                    android:id="@+id/whatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            style="@style/CardStyle">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Why it matters"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Body"
                    android:textColor="@color/haris_on_surface"
                    android:id="@+id/whyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            style="@style/CardStyle">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Common mistakes"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Body"
                    android:textColor="@color/haris_on_surface"
                    android:id="@+id/mistakesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            style="@style/CardStyle.Accent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HARIS PRO recommendations"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Body"
                    android:textColor="@color/haris_on_surface"
                    android:id="@+id/recommendationsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            style="@style/CardStyle">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Summary"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Body"
                    android:textStyle="italic"
                    android:textColor="@color/haris_on_surface"
                    android:id="@+id/summaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/back"
            style="@style/Widget.HarisPro.Button.Outlined"/>
    </LinearLayout>
</ScrollView>
