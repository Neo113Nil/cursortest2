<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/haris_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/haris_primary"
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/haris_accent"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="@dimen/spacing_sm"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            style="@style/CardStyle">
            <TextView
                android:textAppearance="@style/TextAppearance.HarisPro.Body"
                android:textColor="@color/haris_on_surface"
                android:id="@+id/contentText"
                android:padding="@dimen/spacing_lg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardBackgroundColor="@color/haris_secondary_container"
            style="@style/CardStyle.Flat">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Example"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Body"
                    android:textColor="@color/haris_on_surface"
                    android:id="@+id/exampleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            style="@style/CardStyle.Accent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HARIS PRO tips"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Body"
                    android:textColor="@color/haris_on_surface"
                    android:id="@+id/tipsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
