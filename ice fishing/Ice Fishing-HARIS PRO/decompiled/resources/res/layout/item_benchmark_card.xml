<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/haris_primary_container"
    style="@style/CardStyle.Flat">
    <LinearLayout
        android:gravity="top"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/haris_primary"
            android:ellipsize="end"
            android:id="@+id/valueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/haris_on_surface"
            android:ellipsize="end"
            android:id="@+id/labelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:maxLines="2"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/haris_on_surface_variant"
            android:ellipsize="end"
            android:id="@+id/contextText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
