<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_sm"
    android:paddingVertical="@dimen/spacing_xs">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/CardStyle">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/spacing_md"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@color/haris_secondary"
                    android:layout_width="4dp"
                    android:layout_height="32dp"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.CardTitle"
                    android:id="@+id/titleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/haris_secondary"
                    android:gravity="center"
                    android:id="@+id/expandIcon"
                    android:background="@drawable/bg_chevron_circle"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="▼"/>
            </LinearLayout>
            <View
                android:id="@+id/divider"
                android:background="@color/haris_divider"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_md"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/expandedContent"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md">
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Body"
                    android:id="@+id/descriptionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="Stages"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Body"
                    android:id="@+id/stagesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"/>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/haris_primary_container"
                    style="@style/CardStyle.Flat">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textAppearance="@style/TextAppearance.HarisPro.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Expected Result"/>
                        <TextView
                            android:textAppearance="@style/TextAppearance.HarisPro.Body"
                            android:textStyle="bold"
                            android:textColor="@color/haris_primary"
                            android:id="@+id/resultText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
