<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/haris_background"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/toolbar_home"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/haris_card_stroke"
            app:strokeWidth="1dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:src="@drawable/hero"
                android:scaleType="centerCrop"
                android:contentDescription="Hero"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            style="@style/CardStyle">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/haris_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_title"/>
                <View
                    android:background="@color/haris_accent"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="@dimen/spacing_sm"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.HarisPro.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="HARIS PRO helps businesses optimize HR processes, build effective teams, and create sustainable people management practices."
                    android:lineSpacingExtra="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <include
            android:id="@+id/benchmarksHeader"
            layout="@layout/view_section_header"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/benchmarksRecycler"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_benchmark_height"
            android:overScrollMode="never"
            android:paddingStart="@dimen/spacing_sm"
            android:nestedScrollingEnabled="false"/>
        <include
            android:id="@+id/directionsHeader"
            layout="@layout/view_section_header"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/directionsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"/>
        <include
            android:id="@+id/actionsHeader"
            layout="@layout/view_section_header"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/actionsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"/>
        <include
            android:id="@+id/tipHeader"
            layout="@layout/view_section_header"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/haris_accent"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_tip_card"
                android:padding="@dimen/spacing_lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="32sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="��"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/haris_on_surface"
                    android:id="@+id/tipText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:lineSpacingExtra="6dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextTipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/next_tip"
                    style="@style/Widget.HarisPro.Button.Tonal"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
