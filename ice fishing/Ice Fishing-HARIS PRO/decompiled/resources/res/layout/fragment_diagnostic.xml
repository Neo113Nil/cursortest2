<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/haris_background"
    android:padding="@dimen/screen_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:max="20"
        android:progressDrawable="@drawable/progress_bar_haris"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textAppearance="@style/TextAppearance.HarisPro.Body"
        android:textStyle="bold"
        android:id="@+id/progressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        style="@style/CardStyle">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/haris_on_surface"
            android:id="@+id/questionText"
            android:padding="@dimen/spacing_lg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"/>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/yesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/yes"
        style="@style/Widget.HarisPro.Button.Tonal"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/noButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/no"
        style="@style/Widget.HarisPro.Button.Tonal"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/sometimesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/sometimes"
        style="@style/Widget.HarisPro.Button.Tonal"/>
    <com.google.android.material.button.MaterialButton
        android:enabled="false"
        android:id="@+id/nextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/next"
        style="@style/Widget.HarisPro.Button.Primary"/>
</LinearLayout>
