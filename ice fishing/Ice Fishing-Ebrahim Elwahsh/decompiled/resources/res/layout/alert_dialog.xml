<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:wheel="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/loading"
    android:background="?attr/alertDialogDark"
    android:layout_width="@dimen/alert_width"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/alert_background"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/custom_image"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/error_frame"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp">
            <View
                android:background="@drawable/error_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/error_x"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/error_center_x"
                android:scaleType="center"
                android:contentDescription="@string/app_name"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/success_frame"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp">
            <View
                android:background="@drawable/success_bow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:background="@drawable/success_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/success_x"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="0x7f0801d9"
                android:scaleType="center"
                android:contentDescription="@string/app_name"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/warning_frame"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp">
            <View
                android:background="@drawable/warning_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/warning_sigh"
                android:scaleType="center"
                android:contentDescription="@string/app_name"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/progress_dialog"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp">
            <com.github.ybq.android.spinkit.SpinKitView
                android:layout_gravity="center"
                android:id="@+id/spin_kit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/SpinKitView.Large.Circle"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/alertDialogTextColor"
            android:id="@+id/title_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#999999"
            android:id="@+id/content_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"/>
    </LinearLayout>
    <FrameLayout
        android:gravity="center"
        android:id="@+id/custom_view_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <EditText
            android:id="@+id/edit_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">
        <Button
            android:id="@+id/cancel_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="Cancel"
            android:layout_weight="1"
            style="?attr/materialButtonOutlinedStyle"/>
        <Button
            android:textColor="@color/text_color"
            android:id="@+id/custom_confirm_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="Ok"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
