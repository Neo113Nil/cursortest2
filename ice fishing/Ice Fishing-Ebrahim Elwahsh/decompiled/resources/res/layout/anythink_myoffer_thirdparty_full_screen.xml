<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/anythink_myoffer_rl_root"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.anythink.basead.ui.MuteImageView
        android:id="@+id/anythink_myoffer_btn_mute_id"
        android:background="@drawable/anythink_myoffer_video_mute_icon"
        android:layout_width="@dimen/anythink_myoffer_half_screen_button_size"
        android:layout_height="@dimen/anythink_myoffer_half_screen_button_size"
        android:layout_marginLeft="5dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <com.anythink.basead.ui.PanelView
        android:id="@+id/anythink_myoffer_banner_view_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/anythink_myoffer_include_4_element"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true">
        <com.anythink.basead.ui.CountDownView
            android:id="@+id/anythink_myoffer_count_down_view_id"
            android:layout_width="@dimen/anythink_myoffer_half_screen_button_size"
            android:layout_height="@dimen/anythink_myoffer_half_screen_button_size"/>
        <com.anythink.basead.ui.CloseImageView
            android:id="@+id/anythink_myoffer_btn_close_id"
            android:background="@drawable/anythink_myoffer_base_close_icon"
            android:layout_width="@dimen/anythink_myoffer_half_screen_button_size"
            android:layout_height="@dimen/anythink_myoffer_half_screen_button_size"
            android:layout_marginLeft="12dp"/>
    </LinearLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/anythink_myoffer_ad_lable"
        android:background="@drawable/anythink_myoffer_splash_ad_label_bg"
        android:paddingLeft="5dp"
        android:paddingTop="2dp"
        android:paddingRight="5dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="2dp"
        android:text="@string/anythink_basead_ad_text"
        android:layout_toRightOf="@+id/anythink_myoffer_btn_mute_id"
        android:layout_alignParentTop="true"/>
</RelativeLayout>
