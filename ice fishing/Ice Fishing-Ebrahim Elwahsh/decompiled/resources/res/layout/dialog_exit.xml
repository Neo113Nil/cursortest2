<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:paddingTop="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-60dp"
                android:layout_below="@+id/imgAppIcon">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:src="@drawable/thanku"
                    android:tint="@color/colorPrimary"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Do You Want To Exit?"
                    android:fontFamily="@font/sofiasans_medium"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/native_ad_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:weightSum="1">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/txtExitNo"
                        android:background="@color/maincolor1"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:text="Cancel"
                        android:includeFontPadding="false"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/sofiasans_medium"/>
                    <TextView
                        android:textSize="15dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/txtExitYes"
                        android:background="@color/colorPrimary"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:text="Exit App"
                        android:includeFontPadding="false"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/sofiasans_medium"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imgAppIcon"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@drawable/eraser_image"
                android:adjustViewBounds="true"
                android:layout_alignParentTop="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
