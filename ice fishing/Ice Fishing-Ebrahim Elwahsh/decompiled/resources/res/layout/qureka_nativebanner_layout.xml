<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/rlBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="#fff"
    app:cardCornerRadius="5dp"
    app:cardElevation="5dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="10dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/native_self_adlogo"
            android:background="@color/colorPrimary"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="Ad"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bannerclick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:gravity="center"
                    android:padding="5dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <pl.droidsonroids.gif.GifImageView
                        android:id="@+id/iv_round_gif"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ads_round1"
                        android:adjustViewBounds="true"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp">
                    <TextView
                        android:textSize="15dp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tv_text_ad_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Play &amp; Win Coins"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tv_text_ad_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Win 5,00,000 Coins &amp; More"
                        android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:id="@+id/playNowLL"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                app:cardBackgroundColor="@color/colorPrimary"
                app:cardCornerRadius="5dp"
                app:cardElevation="5dp">
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/native_ad_install_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:text="PLAY NOW"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
