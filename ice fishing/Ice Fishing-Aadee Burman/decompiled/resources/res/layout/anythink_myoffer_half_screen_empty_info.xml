<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/anythink_dailog_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.anythink.basead.ui.RoundCornerRelativeLayout
        android:id="@+id/anythink_myoffer_rl_root"
        android:layout_width="match_parent"
        android:layout_height="560dp"
        android:layout_marginLeft="26dp"
        android:layout_marginRight="26dp"
        android:layout_centerVertical="true">
        <com.anythink.basead.ui.PlayerView
            android:id="@+id/anythink_myoffer_player_view_id"
            android:layout_width="match_parent"
            android:layout_height="400dp"/>
        <com.anythink.core.basead.ui.web.WebProgressBarView
            android:id="@+id/anythink_myoffer_player_view_progress_bar_id"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_alignBottom="@+id/anythink_myoffer_player_view_id"/>
        <include layout="@layout/anythink_myoffer_include_guide2click_mask"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/anythink_myoffer_button_group"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <com.anythink.basead.ui.CountDownView
                android:id="@+id/anythink_myoffer_count_down_view_id"
                android:layout_width="@dimen/anythink_myoffer_half_screen_button_size"
                android:layout_height="@dimen/anythink_myoffer_half_screen_button_size"
                android:layout_marginLeft="12dp"/>
            <com.anythink.basead.ui.CloseImageView
                android:id="@+id/anythink_myoffer_btn_close_id"
                android:background="@drawable/anythink_myoffer_base_close_icon"
                android:layout_width="@dimen/anythink_myoffer_half_screen_button_size"
                android:layout_height="@dimen/anythink_myoffer_half_screen_button_size"
                android:layout_marginLeft="12dp"/>
        </LinearLayout>
        <com.anythink.basead.ui.PanelView
            android:id="@+id/anythink_myoffer_banner_view_id"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_alignParentBottom="true"/>
        <include layout="@layout/anythink_myoffer_include_guide2click_container"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/anythink_myoffer_ll_ad_mute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true">
            <TextView
                android:textSize="11dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/anythink_myoffer_ad_lable"
                android:background="@drawable/anythink_myoffer_splash_ad_label_bg"
                android:paddingLeft="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/anythink_basead_ad_text"/>
            <com.anythink.basead.ui.MuteImageView
                android:id="@+id/anythink_myoffer_btn_mute_id"
                android:background="@drawable/anythink_myoffer_video_mute_icon"
                android:layout_width="@dimen/anythink_myoffer_half_screen_button_size"
                android:layout_height="@dimen/anythink_myoffer_half_screen_button_size"
                android:layout_marginLeft="12dp"/>
        </LinearLayout>
        <include
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_toRightOf="@+id/anythink_myoffer_ll_ad_mute"
            layout="@layout/anythink_myoffer_feedback_button"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_alignParentBottom="true"
            layout="@layout/anythink_myoffer_include_4_element"/>
    </com.anythink.basead.ui.RoundCornerRelativeLayout>
    <include
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="26dp"
        android:layout_marginRight="26dp"
        android:layout_below="@+id/anythink_myoffer_rl_root"
        layout="@layout/anythink_myoffer_include_invalid_button"/>
</RelativeLayout>
