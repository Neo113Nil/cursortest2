<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    style="@style/Theme.BacDZ">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:layout_gravity="center"
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مادة ؟"
            android:layout_centerInParent="true"
            android:fontFamily="@font/tajawalbold"
            style="@style/Theme.BacDZ"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="10dp"
                android:layout_above="@+id/btnEditSave">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/imageViewShowEditMark"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="0dp"
                        android:src="@drawable/ic_showeditmarks"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="المادة ( غير قابل لتعديل )"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <EditText
                        android:enabled="false"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/editTextArticle"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:hint="غير قابل لتعديل"
                        android:ems="10"
                        android:inputType="text"
                        android:fontFamily="@font/tajawalbold"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"
                        style="@style/Theme.BacDZ"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="المعامل ( غير قابل لتعديل )"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <EditText
                        android:enabled="false"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/editTextFactor"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:hint="غير قابل لتعديل"
                        android:ems="10"
                        android:inputType="number"
                        android:fontFamily="@font/tajawalbold"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"
                        style="@style/Theme.BacDZ"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="التقويم 20/#"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <EditText
                        android:enabled="false"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/editTextBehavior"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:hint="إجباري"
                        android:ems="10"
                        android:maxLength="5"
                        android:inputType="numberDecimal"
                        android:fontFamily="@font/tajawalbold"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"
                        style="@style/Theme.BacDZ"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الفرض الأول + الفرض الثاني 20/#"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <EditText
                        android:enabled="false"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/editTextAssumption"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:hint="إجباري"
                        android:ems="10"
                        android:maxLength="5"
                        android:inputType="numberDecimal"
                        android:fontFamily="@font/tajawalbold"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"
                        style="@style/Theme.BacDZ"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الإختبار 20/#"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <EditText
                        android:enabled="false"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/editTextTest"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="15dp"
                        android:hint="إجباري"
                        android:ems="10"
                        android:maxLength="5"
                        android:inputType="numberDecimal"
                        android:fontFamily="@font/tajawalbold"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"
                        style="@style/Theme.BacDZ"/>
                </LinearLayout>
            </ScrollView>
            <Button
                android:textSize="22sp"
                android:textColor="@color/white"
                android:id="@+id/btnEditSave"
                android:background="@drawable/background_button"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginLeft="80dp"
                android:layout_marginRight="80dp"
                android:layout_marginBottom="10dp"
                android:scaleType="fitCenter"
                android:text="تعديل"
                android:layout_alignParentBottom="true"
                android:fontFamily="@font/tajawalregular"
                android:layout_marginStart="80dp"
                android:layout_marginEnd="80dp"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
