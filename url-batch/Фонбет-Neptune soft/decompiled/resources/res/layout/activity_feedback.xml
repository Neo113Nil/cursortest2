<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    style="@style/Theme.BacDZ">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feedback"
            android:layout_centerInParent="true"
            android:fontFamily="@font/tajawalbold"
            style="@style/Theme.BacDZ"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:id="@+id/scv"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/imageViewfeedback"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="0dp"
                        android:src="@drawable/ic_feedback"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الإسم الكامل"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <EditText
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/editText_name"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:hint="إجباري"
                        android:ems="10"
                        android:inputType="textPersonName"
                        android:fontFamily="@font/tajawalbold"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"
                        style="@style/Theme.BacDZ"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="البريد الإلكتروني"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <EditText
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/editText_email"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:hint="إجباري"
                        android:ems="10"
                        android:inputType="textEmailAddress"
                        android:fontFamily="@font/tajawalbold"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"
                        style="@style/Theme.BacDZ"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="رقم الهاتف"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <EditText
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/editText_phone"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:hint="إختياري"
                        android:ems="10"
                        android:inputType="phone"
                        android:fontFamily="@font/tajawalbold"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"
                        style="@style/Theme.BacDZ"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="نوع الـ feedback"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <RadioGroup
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:baselineAligned="false">
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:paddingStart="15dp">
                                    <RadioButton
                                        android:textSize="15sp"
                                        android:gravity="center_vertical"
                                        android:id="@+id/radio_complaint"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="شكوى"
                                        android:fontFamily="@font/tajawalbold"
                                        android:layoutDirection="rtl"
                                        android:layout_alignParentEnd="true"
                                        android:buttonTint="@color/blue"
                                        style="@style/Theme.BacDZ"/>
                                </RelativeLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:paddingEnd="15dp">
                                    <RadioButton
                                        android:textSize="15sp"
                                        android:gravity="center_vertical"
                                        android:id="@+id/radio_opinion"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="رأي"
                                        android:fontFamily="@font/tajawalbold"
                                        android:layoutDirection="rtl"
                                        android:layout_alignParentEnd="true"
                                        android:buttonTint="@color/blue"
                                        style="@style/Theme.BacDZ"/>
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </RadioGroup>
                    <TextView
                        android:textSize="15sp"
                        android:gravity="right"
                        android:paddingRight="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="feedback الـ"
                        android:fontFamily="@font/tajawalregular"
                        style="@style/Theme.BacDZ"/>
                    <EditText
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/editText_feedback"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:hint="إجباري"
                        android:ems="10"
                        android:inputType="textMultiLine"
                        android:fontFamily="@font/tajawalbold"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"
                        style="@style/Theme.BacDZ"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/orange"
                        android:gravity="center"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="5dp"
                        android:text="إبعث رسالة بناءة"
                        android:fontFamily="@font/tajawalbold"/>
                    <Button
                        android:textSize="22sp"
                        android:textColor="@color/white"
                        android:id="@+id/btn_send_feedback"
                        android:background="@drawable/background_button"
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:layout_marginLeft="80dp"
                        android:layout_marginRight="80dp"
                        android:layout_marginBottom="10dp"
                        android:scaleType="fitCenter"
                        android:text="إرسال"
                        android:fontFamily="@font/tajawalregular"
                        android:layout_marginStart="80dp"
                        android:layout_marginEnd="80dp"/>
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
