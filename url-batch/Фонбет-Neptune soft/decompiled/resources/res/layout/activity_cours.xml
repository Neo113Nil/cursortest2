<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    style="@style/Theme.BacDZ">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="دروس"
            android:layout_centerInParent="true"
            android:fontFamily="@font/tajawalbold"
            style="@style/Theme.BacDZ"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true">
            <ScrollView
                android:id="@+id/scv"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_economics"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="15dp"
                                app:elevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_economics"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgEconomics"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_economics"
                                        android:foregroundGravity="center"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:gravity="center_horizontal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12sp"
                                        android:text="الإقتصاد و المناجمنت"
                                        android:fontFamily="@font/tajawalbold"
                                        android:textAlignment="center"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_accounting"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_accounting"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgAccounting"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_accounting"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="ت المحاسبي و المالي"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_his_geo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="15dp"
                                app:elevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_his_geo"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgHisGeo"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_history"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="إجتماعيات"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_math"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_math"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgMaths"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_maths"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="رياضيات"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_law"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="15dp"
                                app:elevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_law"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgLaw"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_law"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="القانون"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_arabic"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_arabic"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgArabic"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_world_ar"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="عربية"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_philo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="15dp"
                                app:elevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_philo"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgPhilo"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_question_book"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="فلسفة"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_islamique"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_islamique"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgIslamique"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_bismillah"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="إسلامية"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_fr"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="15dp"
                                app:elevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_fr"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgFr"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_world_fr"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="Français"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_en"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_en"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgEn"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_world_en"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="English"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
