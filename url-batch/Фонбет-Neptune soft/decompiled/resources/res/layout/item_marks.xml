<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="right"
    android:orientation="horizontal"
    android:id="@+id/lytItemAvg"
    android:background="@drawable/ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="66dp"
        android:layout_marginEnd="10dp">
        <LinearLayout
            android:gravity="right"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="5dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="right"
                android:layout_gravity="right"
                android:id="@+id/txtModuleAvg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="التسيير المحاسبي و المالي | المعامل 6 | معدل المادة : 10.00"
                android:fontFamily="@font/tajawalbold"
                style="@style/Theme.BacDZ"/>
            <TextView
                android:textSize="12sp"
                android:gravity="right"
                android:layout_gravity="right"
                android:id="@+id/txtMarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="التقويم : 10.00 | الفروض : 10.00 | الإختبار : 10.00"
                android:fontFamily="@font/tajawalregular"
                style="@style/Theme.BacDZ"/>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/imgItemMarks"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:src="@drawable/ic_module_accounting"
        android:layout_marginEnd="10dp"/>
</LinearLayout>
