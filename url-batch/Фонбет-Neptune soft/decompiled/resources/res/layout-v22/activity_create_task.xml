<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <ScrollView
        android:id="@+id/layoutcreateNote"
        android:paddingBottom="@dimen/_10sdp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_40sdp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">
            <ImageView
                android:id="@+id/imgback"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:src="@drawable/ic_back"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imgsave"
                android:background="@drawable/background_done_button"
                android:padding="@dimen/_4sdp"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/ic_done"
                android:layout_marginEnd="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="@+id/imgback"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/imgback"/>
            <EditText
                android:textSize="@dimen/_16ssp"
                android:id="@+id/edittextTask"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_15sdp"
                android:hint="لا توجد مهمة"
                android:includeFontPadding="false"
                android:inputType="textMultiLine"
                android:fontFamily="@font/ubuntubold"
                android:layout_marginStart="@dimen/_12sdp"
                android:importantForAutofill="no"
                app:layout_constraintEnd_toStartOf="@+id/imgsave"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgback"
                style="@style/Theme.BacDZ"/>
            <CheckBox
                android:gravity="center"
                android:id="@+id/checkbox"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/edittextTask"
                app:layout_constraintEnd_toEndOf="@+id/imgsave"
                app:layout_constraintStart_toStartOf="@+id/imgsave"
                app:layout_constraintTop_toTopOf="@+id/edittextTask"
                style="@style/Theme.BacDZ"/>
            <TextView
                android:textSize="@dimen/_10ssp"
                android:id="@+id/textvdatetime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="1995-11-04"
                android:includeFontPadding="false"
                android:fontFamily="@font/ubunturegular"
                app:layout_constraintEnd_toEndOf="@+id/imgsave"
                app:layout_constraintStart_toStartOf="@+id/imgback"
                app:layout_constraintTop_toBottomOf="@+id/edittextTask"
                style="@style/Theme.BacDZ"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/lytReminder"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:layoutDirection="ltr"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                app:layout_constraintStart_toStartOf="@+id/imgback"
                app:layout_constraintTop_toBottomOf="@+id/textvdatetime">
                <ImageView
                    android:id="@+id/imgReminder"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_task_reminder"/>
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/gris1"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/textDateTimeReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:includeFontPadding="false"
                    android:fontFamily="@font/ubunturegular"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_8sdp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <include layout="@layout/layout_miscellaneous_task"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
