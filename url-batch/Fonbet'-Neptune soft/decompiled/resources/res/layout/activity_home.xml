<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    style="@style/Theme.BacDZ">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الصفحة الرئيسية"
            android:layout_centerInParent="true"
            android:fontFamily="@font/tajawalbold"
            style="@style/Theme.BacDZ"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_alignParentBottom="true"
        android:layoutDirection="ltr">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lyt_tips_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="28sp"
                android:textColor="@color/blue"
                android:gravity="right"
                android:paddingTop="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مرحبا بك !"
                android:fontFamily="@font/tajawalbold"/>
            <TextView
                android:textSize="18sp"
                android:gravity="right"
                android:id="@+id/txtv_tips_home"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تصرف كما لو أنه من المستحيل أن تفشل."
                android:lineSpacingExtra="5dp"
                android:fontFamily="@font/tajawalregular"
                style="@style/Theme.BacDZ"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/lyt_tips_home"
            android:layout_alignParentBottom="true">
            <ScrollView
                android:id="@+id/scv"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_tips"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="8dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="15dp"
                                app:elevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_tips"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgv_tips"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_lamp"
                                        android:foregroundGravity="center"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:gravity="center_horizontal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="نصائح"
                                        android:fontFamily="@font/tajawalbold"
                                        android:textAlignment="center"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_avg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="8dp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_avg"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgv_avg"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_calculator"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="حساب المعدل"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_challenge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="8dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="15dp"
                                app:elevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_quiz"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgv_challenge"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_question"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="إختبر نفسك"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="8dp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_time"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgv_time"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_timer"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="الوقت المتبقي"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_ressource"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="8dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="15dp"
                                app:elevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_ressource"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgv_ressource"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_archive"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="مراجع"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_note"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="8dp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_note"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgv_note"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_pencil"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="ملاحظات"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_subject"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="10dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="15dp"
                                app:elevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_subject"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgv_subject"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_documents"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="مواضيع و حلول"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_cours"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="10dp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="5dp"
                                style="@style/Theme.BacDZ">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_cours"
                                    android:background="@drawable/ripple"
                                    android:padding="16dp"
                                    android:focusable="true"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imgv_cours"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:src="@drawable/ic_study"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="دروس"
                                        android:fontFamily="@font/tajawalbold"
                                        style="@style/Theme.BacDZ"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
