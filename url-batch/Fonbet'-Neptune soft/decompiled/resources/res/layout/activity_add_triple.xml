<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    style="@style/Theme.BacDZ">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إضافة ثلاثي"
            android:layout_centerInParent="true"
            android:fontFamily="@font/tajawalbold"
            style="@style/Theme.BacDZ"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="10dp"
                android:layout_above="@+id/txtWarning">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/imageViewAddTriple"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="0dp"
                        android:src="@drawable/ic_add_triple"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الإسم الكامل"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <EditText
                        android:textSize="15sp"
                        android:gravity="center"
                        android:id="@+id/editTextFullName"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:hint="إجباري"
                        android:ems="10"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNone"
                        android:fontFamily="@font/tajawalbold"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"
                        style="@style/Theme.BacDZ"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الثلاثي"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <Spinner
                        android:theme="@style/Theme.BacDZ"
                        android:textSize="18sp"
                        android:id="@+id/spinnerTriple"
                        android:background="@drawable/background_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:prompt="@string/app_name"
                        android:spinnerMode="dropdown"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="10dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="هل أنت معني بـ ؟"
                        android:fontFamily="@font/tajawalregular"
                        android:paddingEnd="15dp"
                        style="@style/Theme.BacDZ"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingStart="15dp">
                                <CheckBox
                                    android:textSize="15sp"
                                    android:gravity="center_vertical"
                                    android:id="@+id/checkboxAmazight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="اللغة الأمازيغية"
                                    android:fontFamily="@font/tajawalbold"
                                    android:layoutDirection="rtl"
                                    android:layout_alignParentEnd="true"
                                    android:buttonTint="@color/blue"
                                    style="@style/Theme.BacDZ"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingEnd="15dp">
                                <CheckBox
                                    android:textSize="15sp"
                                    android:gravity="center_vertical"
                                    android:id="@+id/checkboxSport"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:text="التربية البدنية"
                                    android:fontFamily="@font/tajawalbold"
                                    android:layoutDirection="rtl"
                                    android:layout_alignParentEnd="true"
                                    android:buttonTint="@color/blue"
                                    style="@style/Theme.BacDZ"/>
                            </RelativeLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/orange"
                android:gravity="center"
                android:id="@+id/txtWarning"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="لا يمكنك التعديل على هذه المعلومات بعد عملية الحفظ"
                android:layout_above="@+id/btnSave"
                android:fontFamily="@font/tajawalbold"/>
            <Button
                android:textSize="22sp"
                android:textColor="@color/white"
                android:id="@+id/btnSave"
                android:background="@drawable/background_button"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginLeft="80dp"
                android:layout_marginRight="80dp"
                android:layout_marginBottom="10dp"
                android:scaleType="fitCenter"
                android:text="حفظ"
                android:layout_alignParentBottom="true"
                android:fontFamily="@font/tajawalregular"
                android:layout_marginStart="80dp"
                android:layout_marginEnd="80dp"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
