<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:layoutDirection="ltr"
    style="@style/Theme.BacDZ">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:layout_gravity="center"
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تواريخ"
            android:layout_centerInParent="true"
            android:fontFamily="@font/tajawalbold"
            style="@style/Theme.BacDZ"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:id="@+id/lytInformation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar">
        <TextView
            android:id="@+id/txtScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="مجموع النقاط : 0"
            android:freezesText="true"
            android:fontFamily="@font/tajawalbold"
            android:layout_alignParentEnd="true"
            style="@style/Theme.BacDZ"/>
        <TextView
            android:id="@+id/txtIndexQst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:text="السؤال 1 من 10"
            android:freezesText="true"
            android:layout_below="@+id/txtScore"
            android:fontFamily="@font/tajawalbold"
            android:layout_alignParentEnd="true"
            style="@style/Theme.BacDZ"/>
        <TextView
            android:textSize="38sp"
            android:textColor="@color/caribbeangreen"
            android:id="@+id/txtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="00:30"
            android:freezesText="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/tajawalregular"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/nextQuiz"
        android:layout_below="@+id/lytInformation">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Theme.BacDZ">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="20sp"
                        android:gravity="center"
                        android:id="@+id/txtQst"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:text="انخرط وعمره 17 عاما في حزب الشعب الجزائري وأصبح سنة 1938 المسئول الأول للحزب بسمندو. ثم أصبح عضو في المنظمةالخاصة سنة 1950 تلقي الشرطة القبض عليه سنة 1740 بتهمةالانتماء إلى المنظمةالخاصة في 1954 فر من سجن عنابة و التحق باللجنة الثورية للوحدةو العمل و الثورة بالشمال القسنطيني بعد استشهاد ديدوش مراد تولى خلافته و قام بتنظيم هجوم 20 أوت 1955 ثم عُين عضوا بالمجلس الوطني للثورة الجزائرية و عقيد في جيش التحرر 1740 سقط شهيدا في يوم 25 سبتمبر 1956"
                        android:freezesText="true"
                        android:layout_centerHorizontal="true"
                        android:lineSpacingExtra="5dp"
                        android:fontFamily="@font/tajawalbold"/>
                    <RadioGroup
                        android:id="@+id/radioGroupAnsewer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txtQst">
                        <LinearLayout
                            android:gravity="right"
                            android:id="@+id/lytOption1"
                            android:background="@drawable/ripple"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="10dp"
                            android:layoutDirection="rtl">
                            <RadioButton
                                android:textSize="15sp"
                                android:layout_gravity="right"
                                android:id="@+id/radioOption1"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="15dp"
                                android:button="@null"
                                android:text="الجواب 1"
                                android:freezesText="true"
                                android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                                android:fontFamily="@font/tajawalbold"
                                android:layoutDirection="ltr"
                                style="@style/Theme.BacDZ"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="right"
                            android:id="@+id/lytOption2"
                            android:background="@drawable/ripple"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layoutDirection="rtl">
                            <RadioButton
                                android:textSize="15sp"
                                android:layout_gravity="right"
                                android:id="@+id/radioOption2"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="15dp"
                                android:button="@null"
                                android:text="الجواب 2"
                                android:freezesText="true"
                                android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                                android:fontFamily="@font/tajawalbold"
                                android:layoutDirection="ltr"
                                style="@style/Theme.BacDZ"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="right"
                            android:id="@+id/lytOption3"
                            android:background="@drawable/ripple"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layoutDirection="rtl">
                            <RadioButton
                                android:textSize="15sp"
                                android:layout_gravity="right"
                                android:id="@+id/radioOption3"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="15dp"
                                android:button="@null"
                                android:text="الجواب 3"
                                android:freezesText="true"
                                android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                                android:fontFamily="@font/tajawalbold"
                                android:layoutDirection="ltr"
                                style="@style/Theme.BacDZ"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="right"
                            android:id="@+id/lytOption4"
                            android:background="@drawable/ripple"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layoutDirection="rtl">
                            <RadioButton
                                android:textSize="15sp"
                                android:layout_gravity="right"
                                android:id="@+id/radioOption4"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="15dp"
                                android:button="@null"
                                android:text="الجواب 4"
                                android:freezesText="true"
                                android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                                android:fontFamily="@font/tajawalbold"
                                android:layoutDirection="ltr"
                                style="@style/Theme.BacDZ"/>
                        </LinearLayout>
                    </RadioGroup>
                </RelativeLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <Button
        android:textSize="22sp"
        android:textColor="@color/white"
        android:id="@+id/nextQuiz"
        android:background="@drawable/background_button"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginLeft="80dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="80dp"
        android:layout_marginBottom="10dp"
        android:scaleType="fitCenter"
        android:text="التالي"
        android:freezesText="true"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/tajawalregular"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
