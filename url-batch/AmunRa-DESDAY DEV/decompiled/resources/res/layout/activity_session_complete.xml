<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_screen_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:background="@drawable/bg_overlay_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/neon_green"
                    android:gravity="center"
                    android:id="@+id/completeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/session_complete_title"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/hud_text"
                    android:gravity="center"
                    android:id="@+id/sessionDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/neon_cyan"
                    android:gravity="center"
                    android:id="@+id/sessionExercises"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:id="@+id/sessionMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/session_message"/>
            </LinearLayout>
        </FrameLayout>
        <Button
            android:textColor="@color/neon_cyan"
            android:id="@+id/startAnotherButton"
            android:background="@drawable/bg_neon_button"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="48dp"
            android:text="@string/start_another"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
        <Button
            android:textColor="@color/neon_magenta"
            android:id="@+id/homeButton"
            android:background="@drawable/bg_neon_button_magenta"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/home"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
    </LinearLayout>
</FrameLayout>
