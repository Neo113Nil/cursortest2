<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_screen_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_eye"
            android:contentDescription="@string/home_title"/>
        <FrameLayout
            android:background="@drawable/bg_overlay_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/hud_text"
                    android:gravity="center"
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_title"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:id="@+id/subtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_subtitle"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/neon_cyan"
                    android:gravity="center"
                    android:id="@+id/sessionsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/neon_magenta"
                    android:gravity="center"
                    android:id="@+id/minutesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>
        <Button
            android:textSize="16sp"
            android:textColor="@color/neon_cyan"
            android:id="@+id/startBreakButton"
            android:background="@drawable/bg_neon_button"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="48dp"
            android:text="@string/start_break"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/neon_cyan"
            android:id="@+id/routinesButton"
            android:background="@drawable/bg_neon_button"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/choose_routine"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/neon_magenta"
            android:id="@+id/guideButton"
            android:background="@drawable/bg_neon_button_magenta"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/guide"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
    </LinearLayout>
</FrameLayout>
