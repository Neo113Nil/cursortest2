<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.visualfortune.eyerest.EyeBreakCanvasView
        android:id="@+id/sessionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:background="@drawable/bg_overlay_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/neon_cyan"
                android:gravity="center"
                android:id="@+id/routineText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/hud_text"
                    android:id="@+id/exerciseText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/neon_green"
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/bg_overlay_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/hud_text"
                android:gravity="center"
                android:id="@+id/instructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/instruction_default"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <Button
                android:textColor="@color/neon_cyan"
                android:id="@+id/skipButton"
                android:background="@drawable/bg_neon_button"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/skip_exercise"
                android:textAllCaps="false"
                app:backgroundTint="@null"/>
            <Button
                android:textColor="@color/neon_magenta"
                android:id="@+id/endBreakButton"
                android:background="@drawable/bg_neon_button_magenta"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/end_break"
                android:textAllCaps="false"
                android:layout_marginStart="12dp"
                app:backgroundTint="@null"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
