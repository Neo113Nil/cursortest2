<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ad_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/ad__color"
        app:cardCornerRadius="@dimen/_5sdp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_132sdp"
                app:cardBackgroundColor="@color/ad__color"
                app:cardCornerRadius="@dimen/_4sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#d848497b"
                app:strokeWidth="1dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.gms.ads.nativead.MediaView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/ad_media"
                        android:layout_width="150dp"
                        android:layout_height="140dp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:layout_marginStart="@dimen/_8sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/ad"
                        android:layout_width="26dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginStart="@dimen/_8sdp"
                        app:cardBackgroundColor="@color/ad__color"
                        app:cardCornerRadius="@dimen/_6sdp"
                        app:layout_constraintStart_toEndOf="@+id/ad_media"
                        app:layout_constraintTop_toTopOf="@+id/ad_media"
                        app:strokeColor="@color/black"
                        app:strokeWidth="1dp">
                        <TextView
                            android:textSize="@dimen/_6sdp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AD"
                            android:textAllCaps="true"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/linearL"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/_4sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ad"
                        app:layout_constraintTop_toTopOf="@+id/ad_media">
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:id="@+id/ad_headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:ellipsize="end"
                            android:gravity="bottom"
                            android:id="@+id/ad_advertiser"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"/>
                        <RatingBar
                            android:id="@+id/ad_stars"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:stepSize="0.5"
                            android:isIndicator="true"
                            style="?android:attr/ratingBarStyleSmall"/>
                        <TextView
                            android:textSize="@dimen/_8ssp"
                            android:textColor="@color/grey_text_color"
                            android:ellipsize="end"
                            android:id="@+id/ad_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:maxLines="2"
                            android:layout_marginEnd="@dimen/_4sdp"/>
                        <TextView
                            android:textSize="12sp"
                            android:id="@+id/ad_price"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"/>
                        <TextView
                            android:textSize="12sp"
                            android:id="@+id/ad_store"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/ad__color"
                        android:gravity="center"
                        android:id="@+id/ad_call_to_action"
                        android:background="@drawable/_btu_bg"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginTop="12dp"
                        android:text="@string/install"
                        android:layout_marginStart="@dimen/_22sdp"
                        android:layout_marginEnd="@dimen/_18sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintStart_toEndOf="@+id/ad_media"
                        app:layout_constraintTop_toBottomOf="@+id/linearL"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</com.google.android.gms.ads.nativead.NativeAdView>
