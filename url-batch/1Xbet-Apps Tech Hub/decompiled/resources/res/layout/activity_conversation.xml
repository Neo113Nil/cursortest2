<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/backgroundColor">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/top_bar"
        android:paddingLeft="@dimen/_20sdp"
        android:paddingRight="@dimen/_20sdp"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_size"
        android:paddingHorizontal="@dimen/_20sdp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/toolbarColor1">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/back_btn"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="match_parent"
            android:src="@drawable/back_arrow"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/_14sdp"
            style="@style/iconColor"/>
        <TextView
            android:textSize="@dimen/activity_heading_text_size"
            android:textStyle="bold"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conversation"
            android:layout_marginStart="@dimen/_55sdp"
            style="@style/textColor"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/delete_icon"
            android:padding="@dimen/_6sdp"
            android:visibility="gone"
            android:layout_width="@dimen/card_icon"
            android:layout_height="@dimen/card_icon"
            android:src="@drawable/delete"
            android:layout_marginEnd="@dimen/_14sdp"
            style="@style/iconColor"/>
        <LinearLayout
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/select_all_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:layout_gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_all"
                android:layout_marginEnd="@dimen/_10sdp"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/select_all_checkbox"
                android:padding="@dimen/_6sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:src="@drawable/unselected"
                android:layout_marginEnd="@dimen/_14sdp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <ImageView
        android:id="@+id/emptyDataImg"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        android:layout_marginBottom="@dimen/_222sdp"
        android:src="@drawable/conv_empty_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="normal"
        android:gravity="center"
        android:id="@+id/tapToSpeakText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="@string/tap_on_mic_to_start_your_conversation"
        android:fontFamily="@font/poppin_m"
        android:layout_marginStart="@dimen/_32sdp"
        android:layout_marginEnd="@dimen/_32sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emptyDataImg"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/conversation"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_180sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/conversation_pic"
            android:visibility="gone"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/conversation_illustration"/>
        <TextView
            android:textColor="@color/light_grey"
            android:id="@+id/conversation_text"
            android:visibility="gone"
            android:layout_width="@dimen/_150sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/tap_on_mic_to_start_your_conversation"
            android:textAlignment="center"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/scrollableConversation"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_card_view"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/adLayout">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/conversation_card_view"
                android:background="@drawable/rectangle_conversation"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/input_lang_layout"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/_15ssp"
                        android:textStyle="bold"
                        android:id="@+id/input_lang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:text="@string/english"
                        android:layout_marginStart="@dimen/_12sdp"
                        style="@style/textColorTranslator"/>
                    <View
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/cross_icon"
                        android:padding="@dimen/_8sdp"
                        android:visibility="invisible"
                        android:layout_width="@dimen/card_icon"
                        android:layout_height="@dimen/card_icon"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:src="@drawable/cross_icon"
                        android:layout_marginEnd="@dimen/_6sdp"
                        style="@style/iconColor"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/_14ssp"
                    android:ellipsize="end"
                    android:id="@+id/inputText"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_60sdp"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:maxLines="3"
                    android:paddingStart="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/input_lang_layout"
                    style="@style/textColor"/>
                <TextView
                    android:id="@+id/view1"
                    android:background="@color/input_color"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_2sdp"
                    android:layout_marginLeft="@dimen/_82sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginRight="@dimen/_82sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:layout_marginHorizontal="@dimen/_82sdp"
                    android:layout_marginVertical="@dimen/_8sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/inputText"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/output_lang_layout"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view1">
                    <TextView
                        android:textSize="@dimen/_15ssp"
                        android:textStyle="bold"
                        android:id="@+id/output_lang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:text="@string/spanish"
                        android:layout_marginStart="@dimen/_12sdp"
                        style="@style/textColorTranslator"/>
                    <View
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/_14ssp"
                    android:textColor="@color/blue_text_color"
                    android:ellipsize="end"
                    android:id="@+id/outputText"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:maxLines="3"
                    android:paddingStart="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/speak_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/output_lang_layout"/>
                <ImageView
                    android:id="@+id/speak_icon"
                    android:padding="@dimen/_3sdp"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:src="@drawable/sp_icon"
                    android:layout_marginEnd="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    style="@style/iconColor"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:paddingTop="@dimen/_20sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_28sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textColor="@color/white"
        android:id="@+id/delete_btn"
        android:background="@drawable/round_button"
        android:paddingLeft="@dimen/_10sdp"
        android:paddingRight="@dimen/_10sdp"
        android:visibility="gone"
        android:layout_width="@dimen/_95sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:text="@string/delete"
        android:drawablePadding="@dimen/_1sdp"
        android:drawableStart="@drawable/delete_2"
        android:backgroundTint="#d34e46"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="@+id/recyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/adLayout">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/inputLanguageLayout"
            android:layout_width="@dimen/_115sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_22sdp"
            app:cardBackgroundColor="@color/input_color"
            app:cardCornerRadius="@dimen/_6sdp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/input_lang_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/english"
                        android:fontFamily="@font/poppin_reqular"
                        android:layout_marginStart="@dimen/_8sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:padding="@dimen/_6sdp"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:src="@drawable/errow_down"
                        android:layout_marginStart="@dimen/_12sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/input_lang_tv"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <ImageView
            android:id="@+id/swap_lang_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/language_swap_icon"
            app:layout_constraintBottom_toBottomOf="@+id/outputLanguageLayout"
            app:layout_constraintEnd_toEndOf="@+id/outputLanguageLayout"
            app:layout_constraintStart_toStartOf="@+id/inputLanguageLayout"
            app:layout_constraintTop_toTopOf="@+id/inputLanguageLayout"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/outputLanguageLayout"
            android:layout_width="@dimen/_115sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginEnd="@dimen/_22sdp"
            app:cardBackgroundColor="@color/input_color"
            app:cardCornerRadius="@dimen/_6sdp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/output_lang_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/english"
                        android:fontFamily="@font/poppin_reqular"
                        android:layout_marginStart="@dimen/_8sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:padding="@dimen/_6sdp"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:src="@drawable/errow_down"
                        android:layout_marginStart="@dimen/_12sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/output_lang_tv"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.skyfishjy.library.RippleBackground
            android:id="@+id/rippleInputMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/inputLanguageLayout"
            app:layout_constraintStart_toStartOf="@+id/inputLanguageLayout"
            app:layout_constraintTop_toBottomOf="@+id/inputLanguageLayout"
            app:rb_color="@color/blue_text_color"
            app:rb_duration="3000"
            app:rb_radius="14dp"
            app:rb_rippleAmount="3"
            app:rb_scale="3"
            app:rb_strokeWidth="14dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/input_mic_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_20sdp"
                    android:backgroundTint="@color/blue_text_color"
                    app:fabSize="normal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearance="@null"
                    app:shapeAppearanceOverlay="@null"
                    app:srcCompat="@drawable/mic_icc"
                    app:tint="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.skyfishjy.library.RippleBackground>
        <com.skyfishjy.library.RippleBackground
            android:id="@+id/rippleOutputMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/outputLanguageLayout"
            app:layout_constraintStart_toStartOf="@+id/outputLanguageLayout"
            app:layout_constraintTop_toBottomOf="@+id/outputLanguageLayout"
            app:rb_color="@color/blue_text_color"
            app:rb_duration="3000"
            app:rb_radius="14dp"
            app:rb_rippleAmount="3"
            app:rb_scale="3"
            app:rb_strokeWidth="14dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/output_mic_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_20sdp"
                    android:backgroundTint="@color/blue_text_color1"
                    app:fabSize="normal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearance="@null"
                    app:shapeAppearanceOverlay="@null"
                    app:srcCompat="@drawable/mic_icc"
                    app:tint="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.skyfishjy.library.RippleBackground>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/adLayout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_4sdp"
        app:cardBackgroundColor="@color/whiteBg"
        app:cardCornerRadius="@dimen/_2sdp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/loadingText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_ad"/>
        <FrameLayout
            android:id="@+id/adFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/shimmer_view_container1"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/medium_native_layout"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
