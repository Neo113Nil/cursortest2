<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/backgroundColor">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/widgetLayout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/top_bar"
            android:paddingLeft="@dimen/_20sdp"
            android:paddingRight="@dimen/_20sdp"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_size"
            android:paddingHorizontal="@dimen/_20sdp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/toolbarColor1">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/back_btn"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="match_parent"
                android:src="@drawable/back_arrow"
                android:scaleType="centerInside"
                android:layout_marginStart="@dimen/icon_margin_start"
                style="@style/iconColor"/>
            <TextView
                android:textSize="@dimen/activity_heading_text_size"
                android:textStyle="bold"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget"
                android:layout_marginStart="@dimen/heading_margin2"
                style="@style/textColor"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/tutorial"
                android:padding="@dimen/_4sdp"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:src="@drawable/question_mark"
                android:layout_marginEnd="@dimen/_14sdp"
                app:tint="@color/dark_grey"
                style="@style/iconColor"/>
            <LinearLayout
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/select_all_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_all"
                    android:layout_marginEnd="@dimen/_10sdp"
                    style="@style/textColor"/>
                <ImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/checkbox"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:src="@drawable/unselected"
                    android:layout_marginEnd="@dimen/_14sdp"
                    style="@style/iconColor"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/imgLayout"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_120sdp"
            android:layout_marginBottom="62dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/offStateWidget"
                android:visibility="invisible"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:src="@drawable/on_state_w"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/onStateWidget"
                android:visibility="visible"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:src="@drawable/off_state_w"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold"
            android:id="@+id/textView8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_translating"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgLayout"
            style="@style/textColor"/>
        <TextView
            android:textSize="@dimen/_12ssp"
            android:gravity="center"
            android:id="@+id/textView7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_50sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_50sdp"
            android:text="@string/widget_des"
            android:lineSpacingExtra="@dimen/_6sdp"
            android:layout_marginHorizontal="@dimen/_50sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView8"
            style="@style/lightTextColor1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tutorialsLayout"
        android:background="#80000000"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tutorial1"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_280sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/widgetICon"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:src="@drawable/off_state_w"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/link1Tut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:src="@drawable/link_tut"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintStart_toStartOf="@+id/widgetICon"
                app:layout_constraintTop_toBottomOf="@+id/widgetICon"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_150sdp"
                app:cardCornerRadius="@dimen/_8sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/link1Tut">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_200"
                        android:id="@+id/activeTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/activate_widget"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/text_color"
                        android:id="@+id/detailActiveTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/activeTxt"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/activeTxt"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp"
                        app:layout_constraintTop_toBottomOf="@+id/detailActiveTxt">
                        <TextView
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/skip"
                            android:background="@drawable/back_bg"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="34sp"
                            android:text="@string/skip"
                            android:layout_marginEnd="@dimen/_16sdp"/>
                        <TextView
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/next1"
                            android:background="@drawable/next_bg"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="34sp"
                            android:text="@string/next"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tutorial2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_280sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/permissionICon"
                android:background="@drawable/rectangle_tut2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginStart="@dimen/_32sdp"
                android:layout_marginEnd="@dimen/_32sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/appIcon"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:src="@drawable/app_icon"
                    android:layout_marginStart="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language_translator"
                    android:layout_marginStart="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/appIcon"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/toggleIcon"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:src="@drawable/toogle_wd"
                    android:layout_marginEnd="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/toggleHandIcon"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:src="@drawable/hand_selection"
                android:layout_marginEnd="@dimen/_38sdp"
                app:layout_constraintBottom_toBottomOf="@+id/permissionICon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/permissionICon"/>
            <ImageView
                android:id="@+id/link2Tut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:src="@drawable/link_tut"
                android:layout_marginStart="@dimen/_42sdp"
                app:layout_constraintStart_toStartOf="@+id/permissionICon"
                app:layout_constraintTop_toBottomOf="@+id/permissionICon"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_150sdp"
                app:cardCornerRadius="@dimen/_8sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/link2Tut">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_200"
                        android:id="@+id/permissionTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/apper_on_top_permission"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/text_color"
                        android:id="@+id/detailPermissionTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/permissionDetailTxt"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/permissionTxt"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp"
                        app:layout_constraintTop_toBottomOf="@+id/detailPermissionTxt">
                        <TextView
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/back2"
                            android:background="@drawable/back_bg"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="34sp"
                            android:text="@string/back"
                            android:layout_marginEnd="@dimen/_16sdp"/>
                        <TextView
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/next2"
                            android:background="@drawable/next_bg"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="34sp"
                            android:text="@string/next"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tutorial3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/LangSelectionICon"
                android:background="@drawable/rectangle_tut2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginStart="@dimen/_32sdp"
                android:layout_marginEnd="@dimen/_32sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textColor="@color/blue_text_color"
                    android:id="@+id/input_lang_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/english"
                    android:drawablePadding="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_30sdp"
                    android:layout_marginEnd="@dimen/_20sdp"
                    app:autoSizeMaxTextSize="@dimen/_12ssp"
                    app:autoSizeMinTextSize="@dimen/_11ssp"
                    app:autoSizeTextType="uniform"
                    app:drawableEndCompat="@drawable/dropdown"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/swap_card_view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/drawableTintColor"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/swap_card_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_14sdp"
                    app:cardElevation="@dimen/_4sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/swap_lang_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/language_swap_back"/>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:textColor="@color/blue_text_color"
                    android:id="@+id/output_lang_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/output_lang"
                    android:drawablePadding="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_20sdp"
                    android:layout_marginEnd="@dimen/_30sdp"
                    app:autoSizeMaxTextSize="@dimen/_12ssp"
                    app:autoSizeMinTextSize="@dimen/_11ssp"
                    app:autoSizeTextType="uniform"
                    app:drawableEndCompat="@drawable/dropdown"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/swap_card_view"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/drawableTintColor"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/link3Tut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:src="@drawable/link_tut"
                android:layout_marginStart="@dimen/_32sdp"
                app:layout_constraintStart_toStartOf="@+id/LangSelectionICon"
                app:layout_constraintTop_toBottomOf="@+id/LangSelectionICon"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_150sdp"
                app:cardCornerRadius="@dimen/_8sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/link3Tut">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_200"
                        android:id="@+id/langTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/select_input_output_language"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/text_color"
                        android:id="@+id/langActiveTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/detailLang"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/langTxt"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp"
                        app:layout_constraintTop_toBottomOf="@+id/langActiveTxt">
                        <TextView
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/back3"
                            android:background="@drawable/back_bg"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="34sp"
                            android:text="@string/back"
                            android:layout_marginEnd="@dimen/_16sdp"/>
                        <TextView
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/next3"
                            android:background="@drawable/next_bg"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="34sp"
                            android:text="@string/next"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tutorial4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/translatorICon"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_32sdp"
                android:layout_marginEnd="@dimen/_32sdp"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textColor="@color/blue_text_color"
                    android:id="@+id/txt1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="@string/english"
                    android:drawablePadding="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_30sdp"
                    android:layout_marginEnd="@dimen/_20sdp"
                    app:autoSizeMaxTextSize="@dimen/_12ssp"
                    app:autoSizeMinTextSize="@dimen/_11ssp"
                    app:autoSizeTextType="uniform"
                    app:drawableEndCompat="@drawable/dropdown"
                    app:layout_constraintEnd_toStartOf="@+id/card1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/drawableTintColor"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    app:cardCornerRadius="@dimen/_14sdp"
                    app:cardElevation="@dimen/_4sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/swap1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/language_swap_back"/>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:textColor="@color/blue_text_color"
                    android:id="@+id/out1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="@string/output_lang"
                    android:drawablePadding="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_20sdp"
                    android:layout_marginEnd="@dimen/_30sdp"
                    app:autoSizeMaxTextSize="@dimen/_12ssp"
                    app:autoSizeMinTextSize="@dimen/_11ssp"
                    app:autoSizeTextType="uniform"
                    app:drawableEndCompat="@drawable/dropdown"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/card1"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/drawableTintColor"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/input_card_view"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_110sdp"
                    android:layout_marginLeft="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginRight="@dimen/_12sdp"
                    android:translationZ="1dp"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:cardUseCompatPadding="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/card1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/linear_layout"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/_13ssp"
                                android:id="@+id/input_lang_card_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:text="@string/english"
                                android:layout_marginStart="@dimen/_12sdp"
                                style="@style/textColorTranslator"/>
                            <ImageView
                                android:layout_gravity="bottom"
                                android:id="@+id/speak_icon"
                                android:paddingLeft="@dimen/_7sdp"
                                android:paddingTop="@dimen/_7sdp"
                                android:paddingRight="@dimen/_7sdp"
                                android:layout_width="@dimen/card_icon"
                                android:layout_height="@dimen/card_icon"
                                android:src="@drawable/speaker"
                                android:paddingHorizontal="@dimen/_7sdp"
                                style="@style/iconColorTranslator"/>
                            <View
                                android:layout_gravity="end|center_vertical"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_gravity="end|center_vertical"
                                android:id="@+id/cross_icon"
                                android:padding="@dimen/_8sdp"
                                android:visibility="invisible"
                                android:layout_width="@dimen/card_icon"
                                android:layout_height="@dimen/card_icon"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:src="@drawable/cross_icon"
                                android:layout_marginEnd="@dimen/_6sdp"
                                style="@style/iconColor"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/_10ssp"
                            android:gravity="start"
                            android:id="@+id/editText"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginLeft="@dimen/_12sdp"
                            android:layout_marginRight="@dimen/_12sdp"
                            android:hint="@string/tap_to_enter_text"
                            android:backgroundTint="@android:color/transparent"
                            android:layout_marginHorizontal="@dimen/_12sdp"
                            app:layout_constraintBottom_toTopOf="@+id/translate_btn"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/linear_layout"
                            style="@style/editTextColor"/>
                        <TextView
                            android:textSize="@dimen/_8ssp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="end|bottom"
                            android:id="@+id/translate_btn"
                            android:background="@drawable/translate__widget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_12sdp"
                            android:text="@string/translate"
                            android:textAllCaps="false"
                            android:layout_marginEnd="@dimen/_8sdp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>
                        <ImageView
                            android:layout_gravity="bottom"
                            android:id="@+id/paste_icon"
                            android:padding="@dimen/_4sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_8sdp"
                            android:src="@drawable/paste__widget"
                            android:layout_marginStart="@dimen/_10sdp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <androidx.core.widget.ContentLoadingProgressBar
                    android:id="@+id/progressLoadingData"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:indeterminateTint="@color/purple_700"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/input_card_view"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/ouput_card_view"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_110sdp"
                    android:layout_marginLeft="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginRight="@dimen/_12sdp"
                    android:translationZ="1dp"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    app:cardBackgroundColor="@color/purple_700"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:cardUseCompatPadding="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/input_card_view">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="@dimen/_10ssp"
                            android:textColor="@color/white"
                            android:id="@+id/output_lang_card_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:text="@string/english"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/_10ssp"
                            android:textColor="@color/white"
                            android:id="@+id/outputTxt"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:text="@string/result"
                            android:maxLines="4"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_marginEnd="@dimen/_12sdp"
                            app:layout_constraintBottom_toTopOf="@+id/itemLayout"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/output_lang_card_tv"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/itemLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_12sdp"
                            android:layout_marginEnd="@dimen/_8sdp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <ImageView
                                android:id="@+id/speakTextIcon"
                                android:padding="@dimen/_6sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/out_speaker"/>
                            <ImageView
                                android:id="@+id/shareTextIcon"
                                android:padding="@dimen/_6sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/output_share"/>
                            <ImageView
                                android:id="@+id/copyTextIcon"
                                android:padding="@dimen/_6sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/copy"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <View
                    android:id="@+id/lastView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_20sdp"
                    app:layout_constraintTop_toBottomOf="@+id/ouput_card_view"/>
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/timerColor"
                    android:id="@+id/timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/lastView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/lastView"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/appIco"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:src="@drawable/app_icon"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/translatorICon"/>
            <ImageView
                android:id="@+id/link4Tut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:src="@drawable/link_tut"
                android:layout_marginStart="@dimen/_56sdp"
                app:layout_constraintStart_toStartOf="@+id/translatorICon"
                app:layout_constraintTop_toBottomOf="@+id/translatorICon"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_150sdp"
                app:cardCornerRadius="@dimen/_8sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/link4Tut">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_200"
                        android:id="@+id/transTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/translatorWidget"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/text_color"
                        android:id="@+id/transActiveTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/translate_text_using_widget"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/transTxt"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp"
                        app:layout_constraintTop_toBottomOf="@+id/transActiveTxt">
                        <TextView
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/back4"
                            android:background="@drawable/back_bg"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="34sp"
                            android:text="@string/back"
                            android:layout_marginEnd="@dimen/_16sdp"/>
                        <TextView
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/finishTut"
                            android:background="@drawable/next_bg"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="34sp"
                            android:text="@string/finish"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
