<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/backgroundColor">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/top_bar"
        android:paddingLeft="@dimen/_20sdp"
        android:paddingRight="@dimen/_20sdp"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_size"
        android:paddingHorizontal="@dimen/_20sdp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/toolbarColor1">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/back_from_dictionary_btn"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="match_parent"
            android:src="@drawable/back_arrow"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/_10sdp"
            style="@style/iconColor"/>
        <TextView
            android:textSize="@dimen/activity_heading_text_size"
            android:textStyle="bold"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dictionary"
            android:layout_marginStart="@dimen/_55sdp"
            style="@style/textColor"/>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_dictionary_cardView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginLeft="@dimen/_18sdp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="@dimen/_18sdp"
        android:layout_marginHorizontal="@dimen/_18sdp"
        app:cardCornerRadius="@dimen/_20sdp"
        app:cardElevation="@dimen/_4sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        style="@style/cardBgColor">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <EditText
                android:textSize="@dimen/_10sdp"
                android:gravity="center_vertical"
                android:id="@+id/edit_Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/_15sdp"
                android:drawableStart="@drawable/search_blue"
                android:textDirection="locale"
                android:textAlignment="gravity"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_2sdp"
                android:backgroundTint="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/Search_btn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Search_btn"
                android:background="@drawable/search_btn_design"
                android:visibility="visible"
                android:layout_width="@dimen/_70sdp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/blue_text_color"
                app:cardCornerRadius="@dimen/_1sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/Search_btn2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search"
                    android:textAlignment="gravity"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_gravity="end"
                android:id="@+id/delete"
                android:background="@drawable/search_btn_design"
                android:visibility="gone"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/blue_text_color"
                app:cardCornerRadius="@dimen/_1sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/delete_search_btn"
                    android:padding="@dimen/_8sdp"
                    android:layout_width="@dimen/card_icon"
                    android:layout_height="@dimen/card_icon"
                    android:src="@drawable/cross_icon_white"
                    android:text="@string/search"/>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_80sdp"
        android:src="@drawable/dictionary_illustration"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_dictionary_cardView"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/result_card_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/_280sdp"
        android:layout_marginLeft="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginRight="@dimen/_18sdp"
        android:layout_marginHorizontal="@dimen/_18sdp"
        app:cardCornerRadius="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_dictionary_cardView"
        style="@style/cardBgColor">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/exclaim_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_12sdp"
                android:text="@string/exclamation"
                android:layout_marginHorizontal="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.43"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/textColor"/>
            <TextView
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:id="@+id/def_heading_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18sdp"
                android:text="@string/definition"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/exclaim_tv"
                style="@style/textColor"/>
            <TextView
                android:id="@+id/def_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="@string/definition"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/exclaim_tv"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/def_heading_tv"
                style="@style/textColor"/>
            <TextView
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:id="@+id/syn_heading_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/synonyms"
                app:layout_constraintStart_toStartOf="@+id/def_tv"
                app:layout_constraintTop_toBottomOf="@+id/def_tv"
                style="@style/textColor"/>
            <TextView
                android:id="@+id/syn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="@string/definition"
                app:layout_constraintEnd_toEndOf="@+id/def_tv"
                app:layout_constraintStart_toStartOf="@+id/syn_heading_tv"
                app:layout_constraintTop_toBottomOf="@+id/syn_heading_tv"
                style="@style/textColor"/>
            <TextView
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:id="@+id/exp_heading_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/example"
                app:layout_constraintStart_toStartOf="@+id/syn_tv"
                app:layout_constraintTop_toBottomOf="@+id/syn_tv"
                style="@style/textColor"/>
            <TextView
                android:id="@+id/exp_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                app:layout_constraintEnd_toEndOf="@+id/syn_tv"
                app:layout_constraintStart_toStartOf="@+id/exp_heading_tv"
                app:layout_constraintTop_toBottomOf="@+id/exp_heading_tv"
                style="@style/textColor"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/speak_icon"
                android:padding="@dimen/_6sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:src="@drawable/speaker"
                android:layout_marginEnd="@dimen/_6sdp"
                app:layout_constraintBottom_toBottomOf="@+id/copy_icon"
                app:layout_constraintEnd_toStartOf="@+id/copy_icon"
                app:layout_constraintTop_toTopOf="@+id/copy_icon"
                style="@style/iconColor"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/copy_icon"
                android:padding="@dimen/_6sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:src="@drawable/copy_grey_icon"
                android:layout_marginEnd="@dimen/_6sdp"
                app:layout_constraintBottom_toBottomOf="@+id/share_icon"
                app:layout_constraintEnd_toStartOf="@+id/share_icon"
                app:layout_constraintTop_toTopOf="@+id/share_icon"
                style="@style/iconColor"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/share_icon"
                android:padding="@dimen/_6sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:layout_marginBottom="@dimen/_14sdp"
                android:src="@drawable/share_grey_icon"
                android:layout_marginEnd="@dimen/_14sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/iconColor"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fb_banner_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/small_fb_banner_layout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                layout="@layout/fb_banner_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/admob_banner_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/small_banner_layout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                layout="@layout/banner_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
