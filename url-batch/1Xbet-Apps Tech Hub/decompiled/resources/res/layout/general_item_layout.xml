<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/_5sdp"
    android:paddingRight="@dimen/_5sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_8sdp"
    android:paddingHorizontal="@dimen/_5sdp"
    style="@style/backgroundColor">
    <TextView
        android:textSize="@dimen/_11ssp"
        android:id="@+id/phrase_tv"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32sdp"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintEnd_toStartOf="@+id/arrow_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/textColor"/>
    <ImageView
        android:id="@+id/arrow_icon"
        android:padding="@dimen/_8sdp"
        android:layout_width="@dimen/card_icon"
        android:layout_height="@dimen/card_icon"
        android:src="@drawable/dropdown"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/blue_text_color"/>
    <View
        android:id="@+id/view"
        android:layout_width="0dp"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintBottom_toTopOf="@+id/dropdown_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phrase_tv"
        style="@style/viewColorBg"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/dropdown_card"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/_100sdp"
        android:backgroundTint="@color/blue_text_color"
        app:cardCornerRadius="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/output_linear_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/white"
                    android:id="@+id/output_lang_card_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/spanish"
                    android:layout_marginStart="@dimen/_12sdp"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/out_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:text="@string/hola"
                android:maxLines="2"
                android:backgroundTint="@android:color/transparent"
                android:layout_marginHorizontal="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/output_linear_layout"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/share_out_icon"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/output_share"
                android:layout_marginEnd="@dimen/_14sdp"
                app:layout_constraintBottom_toBottomOf="@+id/out_clipboard_icon"
                app:layout_constraintEnd_toStartOf="@+id/out_clipboard_icon"
                app:layout_constraintTop_toTopOf="@+id/out_clipboard_icon"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/out_clipboard_icon"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:src="@drawable/clipboard_icon"
                android:layout_marginEnd="@dimen/_14sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/output_linear_layout"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/out_speaker_icon"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/out_speaker"
                android:layout_marginEnd="@dimen/_14sdp"
                app:layout_constraintBottom_toBottomOf="@+id/share_out_icon"
                app:layout_constraintEnd_toStartOf="@+id/share_out_icon"
                app:layout_constraintTop_toTopOf="@+id/share_out_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
