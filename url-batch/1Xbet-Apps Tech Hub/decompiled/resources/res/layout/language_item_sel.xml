<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemLayout"
    android:paddingLeft="@dimen/_20sdp"
    android:paddingRight="@dimen/_20sdp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_50sdp"
    android:paddingHorizontal="@dimen/_20sdp"
    style="@style/backgroundColor">
    <ImageView
        android:id="@+id/lang_flag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/indonesia"
        android:contentDescription="@string/language_flag_des"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/activity_heading_text_size"
        android:id="@+id/ph_category_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/english"
        android:layout_marginStart="@dimen/_20sdp"
        app:layout_constraintBottom_toBottomOf="@+id/lang_flag"
        app:layout_constraintStart_toEndOf="@+id/lang_flag"
        app:layout_constraintTop_toTopOf="@+id/lang_flag"
        style="@style/textColor"/>
    <TextView
        android:textSize="@dimen/_10sdp"
        android:id="@+id/code_category_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/english"
        android:layout_marginStart="@dimen/_20sdp"
        app:layout_constraintBottom_toBottomOf="@+id/ph_category_tv"
        app:layout_constraintStart_toEndOf="@+id/ph_category_tv"
        app:layout_constraintTop_toTopOf="@+id/ph_category_tv"
        style="@style/textColor"/>
    <ImageView
        android:id="@+id/lang_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/selected_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/_1sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/viewColorBg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
