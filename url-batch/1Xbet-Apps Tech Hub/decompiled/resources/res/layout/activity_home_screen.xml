<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/backgroundColor">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homeLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_6sdp"
        app:layout_constraintBottom_toTopOf="@+id/banner_container"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/top_bar"
            android:paddingLeft="@dimen/_20sdp"
            android:paddingRight="@dimen/_20sdp"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_size"
            android:paddingHorizontal="@dimen/_20sdp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/toolbarColor1">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/open_setting"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="match_parent"
                android:src="@drawable/settingmenu"
                android:scaleType="centerInside"
                android:layout_marginStart="@dimen/_10sdp"
                style="@style/iconColor"/>
            <TextView
                android:textSize="@dimen/activity_heading_text_size"
                android:textStyle="bold"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/translate"
                android:layout_marginStart="@dimen/_55sdp"
                style="@style/textColor"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/premium_icon"
                android:padding="@dimen/_2sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:src="@drawable/crown__1_"
                android:layout_marginEnd="@dimen/_14sdp"/>
        </com.google.android.material.card.MaterialCardView>
        <ScrollView
            android:id="@+id/scrollView2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bg_layout"
                    android:background="@drawable/rectangle_corner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_180sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/inputLanguageLayout"
                        android:layout_width="@dimen/_115sdp"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginStart="@dimen/_22sdp"
                        app:cardBackgroundColor="@color/input_color"
                        app:cardCornerRadius="@dimen/_6sdp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="@dimen/_100sdp"
                                android:layout_height="wrap_content"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <TextView
                                    android:textSize="@dimen/_10ssp"
                                    android:textStyle="bold"
                                    android:textColor="@color/black"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/input_lang_tv"
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/english"
                                    android:singleLine="true"
                                    android:maxLength="11"
                                    android:fontFamily="@font/poppin_reqular"
                                    android:layout_marginStart="@dimen/_8sdp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <ImageView
                                    android:padding="@dimen/_6sdp"
                                    android:layout_width="@dimen/_24sdp"
                                    android:layout_height="@dimen/_24sdp"
                                    android:src="@drawable/errow_down"
                                    android:layout_marginStart="@dimen/_12sdp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/input_lang_tv"
                                    app:layout_constraintTop_toTopOf="parent"/>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <ImageView
                        android:id="@+id/swap_lang_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/language_swap_icon"
                        app:layout_constraintBottom_toBottomOf="@+id/outputLanguageLayout"
                        app:layout_constraintEnd_toEndOf="@+id/outputLanguageLayout"
                        app:layout_constraintStart_toStartOf="@+id/inputLanguageLayout"
                        app:layout_constraintTop_toTopOf="@+id/inputLanguageLayout"/>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/outputLanguageLayout"
                        android:layout_width="@dimen/_115sdp"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginEnd="@dimen/_22sdp"
                        app:cardBackgroundColor="@color/input_color"
                        app:cardCornerRadius="@dimen/_6sdp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="@dimen/_100sdp"
                                android:layout_height="wrap_content"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <TextView
                                    android:textSize="@dimen/_10ssp"
                                    android:textStyle="bold"
                                    android:textColor="@color/black"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/output_lang_tv"
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/english"
                                    android:singleLine="true"
                                    android:maxLength="11"
                                    android:fontFamily="@font/poppin_reqular"
                                    android:layout_marginStart="@dimen/_8sdp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <ImageView
                                    android:padding="@dimen/_6sdp"
                                    android:layout_width="@dimen/_24sdp"
                                    android:layout_height="@dimen/_24sdp"
                                    android:src="@drawable/errow_down"
                                    android:layout_marginStart="@dimen/_12sdp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/output_lang_tv"
                                    app:layout_constraintTop_toTopOf="parent"/>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/linear_layout"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/inputLanguageLayout">
                        <TextView
                            android:textSize="@dimen/_13ssp"
                            android:id="@+id/input_lang_card_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_14sdp"
                            android:text="@string/english"
                            android:layout_marginStart="@dimen/_12sdp"
                            style="@style/textColorTranslator"/>
                        <ImageView
                            android:layout_gravity="bottom"
                            android:id="@+id/speak_icon"
                            android:paddingLeft="@dimen/_7sdp"
                            android:paddingTop="@dimen/_7sdp"
                            android:paddingRight="@dimen/_7sdp"
                            android:layout_width="@dimen/card_icon"
                            android:layout_height="@dimen/card_icon"
                            android:src="@drawable/speaker"
                            android:paddingHorizontal="@dimen/_7sdp"
                            style="@style/iconColorTranslator"/>
                        <View
                            android:layout_gravity="end|center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/cross_icon"
                            android:padding="@dimen/_8sdp"
                            android:visibility="invisible"
                            android:layout_width="@dimen/card_icon"
                            android:layout_height="@dimen/card_icon"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:src="@drawable/cross_icon"
                            android:layout_marginEnd="@dimen/_6sdp"
                            style="@style/iconColor"/>
                    </LinearLayout>
                    <EditText
                        android:textSize="@dimen/_18ssp"
                        android:gravity="start"
                        android:id="@+id/editText"
                        android:paddingTop="@dimen/_16sdp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_22sdp"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:layout_marginRight="@dimen/_22sdp"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:hint="@string/tap_to_enter_text"
                        android:backgroundTint="@android:color/transparent"
                        android:layout_marginHorizontal="@dimen/_22sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/linear_layout"
                        style="@style/editTextColor"/>
                    <Button
                        android:textColor="@color/white"
                        android:layout_gravity="end|bottom"
                        android:id="@+id/translate_btn"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_6sdp"
                        android:text="@string/translate"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/blue_text_color"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <ImageView
                        android:id="@+id/mic_icon"
                        android:background="@drawable/bg_mic"
                        android:padding="@dimen/_9sdp"
                        android:visibility="visible"
                        android:layout_width="@dimen/_38sdp"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginTop="@dimen/_28sdp"
                        android:layout_marginBottom="@dimen/_16sdp"
                        android:src="@drawable/mic_inside"
                        android:layout_marginEnd="@dimen/_22sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/paste_icon"
                        android:layout_width="@dimen/_78sdp"
                        android:layout_height="@dimen/_27sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_16sdp"
                        android:layout_marginStart="@dimen/_22sdp"
                        app:cardBackgroundColor="@color/bg_color_paste"
                        app:cardCornerRadius="@dimen/_34sdp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/editText"
                        app:strokeWidth="0dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:id="@+id/pasteIcon"
                                android:padding="@dimen/_4sdp"
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:src="@drawable/vector_past"
                                android:layout_marginStart="@dimen/_8sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold"
                                android:textColor="@color/paste_text_color"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/paste_icon1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/paste"
                                android:fontFamily="@font/poppin_reqular"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:layout_marginEnd="@dimen/_8sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/pasteIcon"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <ImageView
                        android:layout_gravity="bottom"
                        android:id="@+id/expandTextView"
                        android:padding="@dimen/_4sdp"
                        android:visibility="gone"
                        android:layout_width="@dimen/card_icon"
                        android:layout_height="@dimen/card_icon"
                        android:src="@drawable/expand"
                        android:layout_marginStart="@dimen/_10sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/paste_icon"
                        app:layout_constraintStart_toEndOf="@+id/paste_icon"
                        app:tint="@color/blue_text_color"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.cardview.widget.CardView
                    android:id="@+id/output_card_view"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_180sdp"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:backgroundTint="@color/blue_text_color"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bg_layout">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/output_linear_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/_13ssp"
                                android:textColor="@color/white"
                                android:id="@+id/output_lang_card_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_14sdp"
                                android:text="@string/spanish"
                                android:layout_marginStart="@dimen/_12sdp"/>
                            <ImageView
                                android:layout_gravity="bottom"
                                android:id="@+id/out_speaker_icon"
                                android:paddingLeft="@dimen/_7sdp"
                                android:paddingTop="@dimen/_7sdp"
                                android:paddingRight="@dimen/_7sdp"
                                android:layout_width="@dimen/card_icon"
                                android:layout_height="@dimen/card_icon"
                                android:src="@drawable/out_speaker"
                                android:paddingHorizontal="@dimen/_7sdp"/>
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/expand_icon"
                            android:padding="@dimen/_5sdp"
                            android:layout_width="@dimen/card_icon"
                            android:layout_height="@dimen/card_icon"
                            android:layout_margin="@dimen/_6sdp"
                            android:src="@drawable/expand"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/_14ssp"
                            android:textColor="@color/white"
                            android:id="@+id/output_text"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginLeft="@dimen/_12sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:layout_marginRight="@dimen/_12sdp"
                            android:backgroundTint="@android:color/transparent"
                            android:layout_marginHorizontal="@dimen/_12sdp"
                            app:layout_constraintBottom_toTopOf="@+id/share_out_icon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/output_linear_layout"/>
                        <ImageView
                            android:layout_gravity="end|bottom"
                            android:id="@+id/share_out_icon"
                            android:padding="@dimen/_4sdp"
                            android:layout_width="@dimen/card_icon"
                            android:layout_height="@dimen/card_icon"
                            android:src="@drawable/output_share"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintBottom_toBottomOf="@+id/out_clipboard_icon"
                            app:layout_constraintEnd_toStartOf="@+id/out_clipboard_icon"
                            app:layout_constraintTop_toTopOf="@+id/out_clipboard_icon"/>
                        <ImageView
                            android:layout_gravity="end|bottom"
                            android:id="@+id/out_clipboard_icon"
                            android:padding="@dimen/_4sdp"
                            android:layout_width="@dimen/card_icon"
                            android:layout_height="@dimen/card_icon"
                            android:layout_margin="@dimen/_12sdp"
                            android:src="@drawable/copy"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/output_linear_layout"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:textStyle="bold"
                    android:id="@+id/history_tv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:text="@string/history"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/output_card_view"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/blue_text_color"
                    android:id="@+id/see_more_btn"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:text="@string/see_more"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/history_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/history_tv"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/history_recy"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/history_tv"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sdp"
            android:paddingStart="@dimen/_8sdp"
            app:itemIconSize="@dimen/_18sdp"
            app:itemRippleColor="@color/white"
            app:itemTextAppearanceActive="@style/menu_text_style"
            app:itemTextAppearanceInactive="@style/menu_text_style"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/bottom_nav_menu"
            style="@style/menuBottom"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fb_banner_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/small_fb_banner_layout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                layout="@layout/fb_banner_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/admob_banner_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/small_banner_layout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                layout="@layout/banner_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
