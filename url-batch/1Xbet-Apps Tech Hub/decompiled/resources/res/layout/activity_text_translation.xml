<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/backgroundColor">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homeLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_4sdp"
        app:layout_constraintBottom_toTopOf="@+id/banner_container"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/top_bar"
            android:paddingLeft="@dimen/_20sdp"
            android:paddingRight="@dimen/_20sdp"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_size"
            android:paddingHorizontal="@dimen/_20sdp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/toolbarColor1">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/open_setting"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="match_parent"
                android:src="@drawable/back_arrow"
                android:scaleType="centerInside"
                android:layout_marginStart="@dimen/_10sdp"
                style="@style/iconColor"/>
            <TextView
                android:textSize="@dimen/activity_heading_text_size"
                android:textStyle="bold"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/translate"
                android:layout_marginStart="@dimen/_55sdp"
                style="@style/textColor"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/premium_icon"
                android:padding="@dimen/_2sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:src="@drawable/crown__1_"
                android:layout_marginEnd="@dimen/_14sdp"/>
        </com.google.android.material.card.MaterialCardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bg_layout"
                android:background="@drawable/rectangle_expan_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_40sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/inputLanguageLayout"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginStart="@dimen/_22sdp"
                    app:cardBackgroundColor="@color/input_color"
                    app:cardCornerRadius="@dimen/_6sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="@dimen/_100sdp"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/input_lang_tv"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:text="@string/english"
                                android:singleLine="true"
                                android:maxLength="11"
                                android:layout_marginStart="@dimen/_8sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <ImageView
                                android:padding="@dimen/_6sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/errow_down"
                                android:layout_marginStart="@dimen/_12sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/input_lang_tv"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
                <ImageView
                    android:id="@+id/swap_lang_icon"
                    android:padding="@dimen/_4sdp"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:src="@drawable/language_swap_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/outputLanguageLayout"
                    app:layout_constraintEnd_toEndOf="@+id/outputLanguageLayout"
                    app:layout_constraintStart_toStartOf="@+id/inputLanguageLayout"
                    app:layout_constraintTop_toTopOf="@+id/inputLanguageLayout"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/outputLanguageLayout"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginEnd="@dimen/_22sdp"
                    app:cardBackgroundColor="@color/input_color"
                    app:cardCornerRadius="@dimen/_6sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="@dimen/_100sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/output_lang_tv"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:text="@string/english"
                                android:singleLine="true"
                                android:maxLength="11"
                                android:layout_marginStart="@dimen/_8sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <ImageView
                                android:padding="@dimen/_6sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/errow_down"
                                android:layout_marginStart="@dimen/_12sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/output_lang_tv"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/scrollable"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:fillViewport="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/inputLanguageLayout">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/_12sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/inputLanguageLayout">
                        <ImageView
                            android:id="@+id/clearIconBtn"
                            android:padding="@dimen/_6sdp"
                            android:visibility="gone"
                            android:layout_width="@dimen/_26sdp"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:src="@drawable/cross_premium"
                            android:layout_marginEnd="@dimen/_12sdp"
                            app:layout_constraintBottom_toTopOf="@+id/editText"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:tint="#727272"/>
                        <EditText
                            android:textSize="@dimen/_18ssp"
                            android:gravity="start"
                            android:id="@+id/editText"
                            android:paddingTop="@dimen/_3sdp"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_22sdp"
                            android:layout_marginTop="@dimen/_22sdp"
                            android:layout_marginRight="@dimen/_22sdp"
                            android:layout_marginBottom="@dimen/_6sdp"
                            android:hint="@string/tap_to_enter_text"
                            android:backgroundTint="@android:color/transparent"
                            android:layout_marginHorizontal="@dimen/_22sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/editTextColor"/>
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/paste_icon"
                            android:visibility="invisible"
                            android:layout_width="@dimen/_78sdp"
                            android:layout_height="@dimen/_27sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:layout_marginBottom="@dimen/_16sdp"
                            android:layout_marginStart="@dimen/_22sdp"
                            app:cardBackgroundColor="@color/bg_color_paste"
                            app:cardCornerRadius="@dimen/_34sdp"
                            app:cardElevation="0dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/editText"
                            app:strokeWidth="0dp">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <ImageView
                                    android:id="@+id/pasteIcon11"
                                    android:padding="@dimen/_4sdp"
                                    android:layout_width="@dimen/_18sdp"
                                    android:layout_height="@dimen/_20sdp"
                                    android:src="@drawable/vector_past"
                                    android:layout_marginStart="@dimen/_8sdp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <TextView
                                    android:textSize="@dimen/_10ssp"
                                    android:textStyle="bold"
                                    android:textColor="@color/paste_text_color"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/paste_icon1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/paste"
                                    android:fontFamily="@font/poppin_reqular"
                                    android:layout_marginStart="@dimen/_4sdp"
                                    android:layout_marginEnd="@dimen/_8sdp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/pasteIcon11"
                                    app:layout_constraintTop_toTopOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <View
                            android:id="@+id/viewColorLine"
                            android:background="@color/bg_color_paste"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginTop="@dimen/_72sdp"
                            android:layout_marginStart="@dimen/_76sdp"
                            android:layout_marginEnd="@dimen/_76sdp"
                            app:layout_constraintTop_toBottomOf="@+id/paste_icon"/>
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/blue_text_color"
                            android:id="@+id/outputText"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_22sdp"
                            android:layout_marginStart="@dimen/_22sdp"
                            android:layout_marginEnd="@dimen/_22sdp"
                            app:layout_constraintTop_toBottomOf="@+id/viewColorLine"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/linearIconLayout"
                            android:paddingBottom="@dimen/_8sdp"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_32sdp"
                            android:layout_marginEnd="@dimen/_22sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/outputText">
                            <ImageView
                                android:id="@+id/landScapeView"
                                android:padding="@dimen/_4sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/land_icon"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:layout_marginEnd="@dimen/_4sdp"/>
                            <ImageView
                                android:id="@+id/share"
                                android:padding="@dimen/_4sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/share_icc"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:layout_marginEnd="@dimen/_4sdp"/>
                            <ImageView
                                android:id="@+id/copy"
                                android:padding="@dimen/_4sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/copy__icc"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:layout_marginEnd="@dimen/_4sdp"/>
                            <ImageView
                                android:id="@+id/speaker"
                                android:padding="@dimen/_4sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/sp_icon"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:layout_marginEnd="@dimen/_4sdp"/>
                        </LinearLayout>
                        <Button
                            android:textSize="@dimen/_10ssp"
                            android:textColor="@color/white"
                            android:layout_gravity="end|bottom"
                            android:id="@+id/translate_btn"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_38sdp"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:text="@string/translate"
                            android:textAllCaps="false"
                            android:layout_marginEnd="@dimen/_22sdp"
                            android:backgroundTint="#743d06"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/editText"/>
                        <ImageView
                            android:id="@+id/mic_icon"
                            android:background="@drawable/bg_mic"
                            android:padding="@dimen/_9sdp"
                            android:visibility="invisible"
                            android:layout_width="@dimen/_38sdp"
                            android:layout_height="@dimen/_38sdp"
                            android:layout_marginTop="@dimen/_42sdp"
                            android:layout_marginBottom="@dimen/_16sdp"
                            android:src="@drawable/mic_inside"
                            android:layout_marginEnd="@dimen/_22sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/editText"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/linearIconLayoutInput"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_32sdp"
                            android:layout_marginEnd="@dimen/_22sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/editText">
                            <ImageView
                                android:id="@+id/favInput"
                                android:padding="@dimen/_4sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/fav"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:layout_marginEnd="@dimen/_4sdp"/>
                            <ImageView
                                android:id="@+id/copyInput"
                                android:padding="@dimen/_4sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/copy__icc"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:layout_marginEnd="@dimen/_4sdp"/>
                            <ImageView
                                android:id="@+id/speakerInput"
                                android:padding="@dimen/_4sdp"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/sp_icon"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:layout_marginEnd="@dimen/_4sdp"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.core.widget.NestedScrollView>
                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:textColor="@android:color/white"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/extFloatingActionButton"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:text="@string/new_text"
                    android:layout_marginStart="@dimen/_22sdp"
                    android:backgroundTint="@color/blue_text_color"
                    app:icon="@drawable/baseline_add_24"
                    app:iconTint="@android:color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fb_banner_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/small_fb_banner_layout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                layout="@layout/fb_banner_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/admob_banner_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/small_banner_layout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                layout="@layout/banner_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
