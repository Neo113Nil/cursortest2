<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/_20sdp"
    android:paddingRight="@dimen/_20sdp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_50sdp"
    android:paddingHorizontal="@dimen/_20sdp"
    style="@style/toolbarColor">
    <ImageView
        android:id="@+id/ph_category_icon"
        android:layout_width="18dp"
        android:layout_height="17dp"
        android:src="@drawable/essential_icon"
        android:contentDescription="@string/language_flag_des"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/_12sdp"
        android:id="@+id/ph_category_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/essentials"
        android:fontFamily="@font/poppin_m"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="@+id/ph_category_icon"
        app:layout_constraintEnd_toStartOf="@+id/down_icon"
        app:layout_constraintStart_toEndOf="@+id/ph_category_icon"
        app:layout_constraintTop_toTopOf="@+id/ph_category_icon"
        style="@style/textColor1"/>
    <ImageView
        android:id="@+id/down_icon"
        android:layout_width="@dimen/_10sdp"
        android:layout_height="@dimen/_10sdp"
        android:src="@drawable/next_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/nextIconColor"/>
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/_1sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/viewColorBg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
