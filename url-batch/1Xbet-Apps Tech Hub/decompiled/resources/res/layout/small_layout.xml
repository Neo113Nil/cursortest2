<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="@dimen/_300sdp"
    android:layout_height="wrap_content"
    android:translationZ="1dp"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Spinner
            android:id="@+id/input_lang_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/swap_card_view"
            app:layout_constraintEnd_toStartOf="@+id/swap_card_view"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/swap_card_view"
            app:layout_constraintVertical_bias="0.533"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/swap_card_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:translationZ="1dp"
            app:cardCornerRadius="@dimen/_14sdp"
            app:cardElevation="@dimen/_4sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/swap_lang_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/language_swap_back"/>
        </androidx.cardview.widget.CardView>
        <Spinner
            android:textColor="@color/blue_text_color"
            android:id="@+id/ouputLangSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/output_lang"
            android:drawablePadding="@dimen/_8sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            app:autoSizeMaxTextSize="@dimen/_12ssp"
            app:autoSizeMinTextSize="@dimen/_11ssp"
            app:autoSizeTextType="uniform"
            app:drawableEndCompat="@drawable/dropdown"
            app:layout_constraintBottom_toBottomOf="@+id/swap_card_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/swap_card_view"
            app:layout_constraintTop_toTopOf="@+id/swap_card_view"
            style="@style/drawableTintColor"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/input_card_view"
            android:layout_width="0dp"
            android:layout_height="@dimen/_110sdp"
            android:layout_marginLeft="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_12sdp"
            android:translationZ="1dp"
            android:layout_marginHorizontal="@dimen/_12sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/swap_card_view">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/linear_layout"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/_13ssp"
                        android:textColor="@color/black_text_color"
                        android:id="@+id/input_lang_card_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="@string/english"
                        android:layout_marginStart="@dimen/_12sdp"/>
                    <ImageView
                        android:layout_gravity="bottom"
                        android:id="@+id/speak_icon"
                        android:paddingLeft="@dimen/_7sdp"
                        android:paddingTop="@dimen/_7sdp"
                        android:paddingRight="@dimen/_7sdp"
                        android:visibility="gone"
                        android:layout_width="@dimen/card_icon"
                        android:layout_height="@dimen/card_icon"
                        android:src="@drawable/speaker"
                        android:paddingHorizontal="@dimen/_7sdp"
                        style="@style/iconColorTranslator"/>
                    <View
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/cross_icon"
                        android:padding="@dimen/_8sdp"
                        android:visibility="invisible"
                        android:layout_width="@dimen/card_icon"
                        android:layout_height="@dimen/card_icon"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:src="@drawable/cross_icon"
                        android:layout_marginEnd="@dimen/_6sdp"
                        style="@style/iconColor"/>
                </LinearLayout>
                <EditText
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/black_text_color"
                    android:gravity="start"
                    android:id="@+id/editText"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="@dimen/_12sdp"
                    android:layout_marginRight="@dimen/_12sdp"
                    android:hint="@string/tap_to_enter_text"
                    android:backgroundTint="@android:color/transparent"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    app:layout_constraintBottom_toTopOf="@+id/translate_btn"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/linear_layout"/>
                <TextView
                    android:textSize="@dimen/_8ssp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/translate_btn"
                    android:background="@drawable/translate__widget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:text="@string/translate"
                    android:textAllCaps="false"
                    android:layout_marginEnd="@dimen/_8sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <TextView
                    android:textSize="@dimen/_8ssp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:id="@+id/paste_icon"
                    android:background="@drawable/paste__widget"
                    android:paddingLeft="@dimen/_8sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:text="@string/paste"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.core.widget.ContentLoadingProgressBar
            android:id="@+id/progressLoadingData"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:indeterminateTint="@color/purple_700"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_card_view"
            style="?android:attr/progressBarStyleHorizontal"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/ouput_card_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/_110sdp"
            android:layout_marginLeft="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginRight="@dimen/_12sdp"
            android:translationZ="1dp"
            android:layout_marginHorizontal="@dimen/_12sdp"
            app:cardBackgroundColor="@color/purple_700"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_card_view">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/white"
                    android:id="@+id/output_lang_card_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="@string/english"
                    android:layout_marginStart="@dimen/_12sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/white"
                    android:id="@+id/outputTxt"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="@string/result"
                    android:maxLines="4"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    app:layout_constraintBottom_toTopOf="@+id/itemLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/output_lang_card_tv"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/itemLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <ImageView
                        android:id="@+id/speakTextIcon"
                        android:padding="@dimen/_6sdp"
                        android:visibility="gone"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:src="@drawable/out_speaker"/>
                    <ImageView
                        android:id="@+id/shareTextIcon"
                        android:padding="@dimen/_6sdp"
                        android:visibility="gone"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:src="@drawable/output_share"/>
                    <ImageView
                        android:id="@+id/copyTextIcon"
                        android:padding="@dimen/_6sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/copy__2__wdgt"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:id="@+id/lastView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_20sdp"
            app:layout_constraintTop_toBottomOf="@+id/ouput_card_view"/>
        <TextView
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/timerColor"
            android:id="@+id/timer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="@+id/lastView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/lastView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
