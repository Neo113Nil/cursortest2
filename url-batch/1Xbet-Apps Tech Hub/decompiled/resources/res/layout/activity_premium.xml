<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/premium_back"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30sdp"
                app:layout_constraintBottom_toTopOf="@+id/premium_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/crown_premium"/>
            <ImageView
                android:id="@+id/cross_premium"
                android:padding="@dimen/_3sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:layout_marginTop="@dimen/_16sdp"
                android:src="@drawable/cross_premium"
                android:layout_marginEnd="@dimen/_14sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/_26ssp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/premium_tv"
                android:background="@drawable/premium_access_bg_color"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/premium_access"
                app:layout_constraintBottom_toTopOf="@+id/textview_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView3"/>
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/white"
                android:id="@+id/textview_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/enjoy_the_100_ads_free_version"
                android:drawablePadding="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_24sdp"
                app:drawableStartCompat="@drawable/selected_icon_premium"
                app:layout_constraintBottom_toTopOf="@+id/textView2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/premium_tv"/>
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/white"
                android:id="@+id/textView2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/use_widget_feature"
                android:drawablePadding="@dimen/_12sdp"
                app:drawableStartCompat="@drawable/selected_icon_premium"
                app:layout_constraintEnd_toEndOf="@+id/textview_1"
                app:layout_constraintStart_toStartOf="@+id/textview_1"
                app:layout_constraintTop_toBottomOf="@+id/textview_1"/>
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/white"
                android:id="@+id/textView3"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/textTranslation"
                android:drawablePadding="@dimen/_12sdp"
                app:drawableStartCompat="@drawable/selected_icon_premium"
                app:layout_constraintEnd_toEndOf="@+id/textView2"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/textView2"
                app:layout_constraintTop_toBottomOf="@+id/textView2"/>
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/white"
                android:id="@+id/textView4"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/voiceCon"
                android:drawablePadding="@dimen/_12sdp"
                app:drawableStartCompat="@drawable/selected_icon_premium"
                app:layout_constraintEnd_toEndOf="@+id/textView3"
                app:layout_constraintStart_toStartOf="@+id/textView3"
                app:layout_constraintTop_toBottomOf="@+id/textView3"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/weekly_layout"
                android:background="@drawable/premium_package_design"
                android:layout_width="0dp"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginTop="@dimen/_32sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_24sdp"
                app:layout_constraintBottom_toTopOf="@+id/monthly_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView4">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/weekly_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/weekly"
                    android:layout_marginStart="@dimen/_20sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/weekly_price_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:text="@string/weekly_price"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/weekly_tv"
                    app:layout_constraintTop_toBottomOf="@+id/weekly_tv"/>
                <ImageView
                    android:id="@+id/select_weekly"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:src="@drawable/unselected"
                    android:layout_marginEnd="@dimen/_10sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:id="@+id/free_trial_tv"
                android:background="@drawable/round_button"
                android:paddingLeft="@dimen/_10sdp"
                android:paddingTop="@dimen/_2sdp"
                android:paddingRight="@dimen/_10sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_3_days_free_trial"
                android:layout_marginEnd="@dimen/_30sdp"
                android:elevation="@dimen/_2sdp"
                android:backgroundTint="@color/yellow"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_2sdp"
                app:layout_constraintBottom_toTopOf="@+id/monthly_layout"
                app:layout_constraintEnd_toEndOf="@+id/monthly_layout"
                app:layout_constraintTop_toTopOf="@+id/monthly_layout"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/monthly_layout"
                android:background="@drawable/premium_package_design"
                android:layout_width="0dp"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/white"
                app:layout_constraintBottom_toTopOf="@+id/quarterly_layout"
                app:layout_constraintEnd_toEndOf="@+id/weekly_layout"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/weekly_layout"
                app:layout_constraintTop_toBottomOf="@+id/weekly_layout">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/light_black"
                    android:id="@+id/monthly_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/monthly"
                    android:layout_marginStart="@dimen/_20sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/light_black"
                    android:id="@+id/monthly_price_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:text="@string/weekly_price"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/monthly_tv"
                    app:layout_constraintTop_toBottomOf="@+id/monthly_tv"/>
                <ImageView
                    android:id="@+id/select_monthly"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:src="@drawable/selected_icon"
                    android:layout_marginEnd="@dimen/_10sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/quarterly_layout"
                android:background="@drawable/premium_package_design"
                android:layout_width="0dp"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                app:layout_constraintBottom_toTopOf="@+id/sub_btn"
                app:layout_constraintEnd_toEndOf="@+id/monthly_layout"
                app:layout_constraintStart_toStartOf="@+id/monthly_layout"
                app:layout_constraintTop_toBottomOf="@+id/monthly_layout">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/quarterly_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/quarterly"
                    android:layout_marginStart="@dimen/_20sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/quarterly_price_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:text="@string/weekly_price"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/quarterly_tv"
                    app:layout_constraintTop_toBottomOf="@+id/quarterly_tv"/>
                <ImageView
                    android:id="@+id/select_quarterly"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:src="@drawable/unselected"
                    android:layout_marginEnd="@dimen/_10sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="@dimen/_18ssp"
                android:textColor="#3f3f3f"
                android:id="@+id/sub_btn"
                android:background="@drawable/round_button"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginLeft="@dimen/_30sdp"
                android:layout_marginRight="@dimen/_30sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:text="@string/subscribe"
                android:textAllCaps="false"
                android:backgroundTint="@color/yellow"
                android:layout_marginHorizontal="@dimen/_30sdp"
                app:layout_constraintBottom_toTopOf="@+id/cancel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/quarterly_layout"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/white"
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/cancelAnytime"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sub_btn"/>
            <TextView
                android:textSize="@dimen/_8ssp"
                android:textColor="@color/white"
                android:id="@+id/textView12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:justificationMode="inter_word"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cancel"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
