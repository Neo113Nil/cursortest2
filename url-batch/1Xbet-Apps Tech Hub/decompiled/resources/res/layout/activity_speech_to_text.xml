<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/backgroundColor">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/top_bar"
        android:paddingLeft="@dimen/_20sdp"
        android:paddingRight="@dimen/_20sdp"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_size"
        android:paddingHorizontal="@dimen/_20sdp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/toolbarColor1">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/backBtn"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="match_parent"
            android:src="@drawable/back_arrow"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/_10sdp"
            style="@style/iconColor"/>
        <TextView
            android:textSize="@dimen/activity_heading_text_size"
            android:textStyle="bold"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speech_to_text"
            android:layout_marginStart="@dimen/heading_margin2"
            style="@style/textColor"/>
    </com.google.android.material.card.MaterialCardView>
    <Button
        android:layout_gravity="end|bottom"
        android:id="@+id/speech_lang_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="@string/spanish"
        android:textAllCaps="false"
        android:drawableEnd="@drawable/dropdown_white"
        android:backgroundTint="@color/blue_text_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/input_card_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/_160sdp"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:cardCornerRadius="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/speech_lang_btn"
        style="@style/cardBgColor">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/_15ssp"
                android:id="@+id/input_lang_card_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/spanish"
                android:layout_marginStart="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/lightTextColor"/>
            <TextView
                android:textSize="@dimen/_13ssp"
                android:gravity="start"
                android:id="@+id/editText"
                android:paddingTop="@dimen/_8sdp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/_12sdp"
                android:layout_marginRight="@dimen/_12sdp"
                android:hint="@string/tap_mic_to_write"
                android:backgroundTint="@android:color/transparent"
                android:layout_marginHorizontal="@dimen/_12sdp"
                app:layout_constraintBottom_toTopOf="@+id/text_share_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.58"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/input_lang_card_tv"
                app:layout_constraintVertical_bias="0"
                style="@style/lightTextColor"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/speak_icon"
                android:padding="@dimen/_6sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:src="@drawable/speaker"
                app:layout_constraintBottom_toBottomOf="@+id/copy_icon"
                app:layout_constraintEnd_toStartOf="@+id/copy_icon"
                app:layout_constraintTop_toTopOf="@+id/copy_icon"
                style="@style/nextIconColor"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/copy_icon"
                android:padding="@dimen/_6sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:src="@drawable/copy_grey_icon"
                app:layout_constraintBottom_toBottomOf="@+id/delete_icon"
                app:layout_constraintEnd_toStartOf="@+id/delete_icon"
                app:layout_constraintTop_toTopOf="@+id/delete_icon"
                style="@style/nextIconColor"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/delete_icon"
                android:padding="@dimen/_6sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:src="@drawable/delete"
                app:layout_constraintBottom_toBottomOf="@+id/text_share_icon"
                app:layout_constraintEnd_toStartOf="@+id/text_share_icon"
                app:layout_constraintTop_toTopOf="@+id/text_share_icon"
                style="@style/nextIconColor"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/text_share_icon"
                android:padding="@dimen/_6sdp"
                android:layout_width="@dimen/card_icon"
                android:layout_height="@dimen/card_icon"
                android:layout_marginBottom="@dimen/_10sdp"
                android:src="@drawable/share_grey_icon"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/nextIconColor"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/mic_icon"
        android:layout_width="@dimen/_60sdp"
        android:layout_height="@dimen/_60sdp"
        android:layout_marginTop="@dimen/_34sdp"
        app:cardCornerRadius="160dp"
        app:cardElevation="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_card_view"
        style="@style/cardBgColor">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/mike"
            android:scaleType="fitCenter"/>
    </androidx.cardview.widget.CardView>
    <FrameLayout
        android:id="@+id/collapsableBannerAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
