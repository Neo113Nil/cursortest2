<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/txtvtitle_feedback"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/toolbar_feedback"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/txtvtitle_feedback"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:id="@+id/scv"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="wrap_content"
                        android:layout_height="150dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="0dp"
                        android:src="@drawable/background_layout_feedback"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/raisin_black"
                        android:id="@+id/txtv_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Full name"
                        android:paddingStart="15dp"/>
                    <EditText
                        android:textSize="15sp"
                        android:textColor="@color/firebrick"
                        android:gravity="center"
                        android:id="@+id/editText_name"
                        android:background="@drawable/bg_edit_text_rounded"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:ems="10"
                        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ غظضذخثتشرقصفعسنملكيطحزوهدباءؤىةأإآئج"
                        android:inputType="textPersonName"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/raisin_black"
                        android:id="@+id/txtv_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="E-mail"
                        android:paddingStart="15dp"/>
                    <EditText
                        android:textSize="15sp"
                        android:textColor="@color/firebrick"
                        android:gravity="center"
                        android:id="@+id/editText_email"
                        android:background="@drawable/bg_edit_text_rounded"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:ems="10"
                        android:inputType="textEmailAddress"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:autofillHints=""/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/raisin_black"
                        android:id="@+id/txtv_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phone number"
                        android:paddingStart="15dp"/>
                    <EditText
                        android:textSize="15sp"
                        android:textColor="@color/firebrick"
                        android:gravity="center"
                        android:id="@+id/editText_phone"
                        android:background="@drawable/bg_edit_text_rounded"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="5dp"
                        android:ems="10"
                        android:inputType="phone"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:autofillHints=""/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/raisin_black"
                        android:id="@+id/txtv_feedback_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="Type of feedback"
                        android:paddingStart="15dp"/>
                    <RadioGroup
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:baselineAligned="false">
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:paddingStart="15dp">
                                    <RadioButton
                                        android:textSize="15sp"
                                        android:textColor="@color/raisin_black"
                                        android:gravity="center_vertical"
                                        android:id="@+id/radio_opinion"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Opinion"
                                        android:layoutDirection="rtl"
                                        android:layout_alignParentStart="true"
                                        android:buttonTint="@color/firebrick"/>
                                </RelativeLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:paddingEnd="15dp">
                                    <RadioButton
                                        android:textSize="15sp"
                                        android:textColor="@color/raisin_black"
                                        android:gravity="center_vertical"
                                        android:id="@+id/radio_complaint"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Complaint"
                                        android:layoutDirection="rtl"
                                        android:layout_alignParentStart="true"
                                        android:buttonTint="@color/firebrick"/>
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </RadioGroup>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/raisin_black"
                        android:gravity="left"
                        android:id="@+id/txtv_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Feedback"
                        android:paddingStart="15dp"/>
                    <EditText
                        android:textSize="15sp"
                        android:textColor="@color/firebrick"
                        android:textColorHint="@color/firebrick"
                        android:gravity="center"
                        android:id="@+id/editText_feedback"
                        android:background="@drawable/bg_edit_text_rounded"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="15dp"
                        android:hint="feedback"
                        android:ems="10"
                        android:inputType="textMultiLine"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:autofillHints=""/>
                    <Button
                        android:textSize="22sp"
                        android:textColor="@color/snow"
                        android:id="@+id/btn_send_feedback"
                        android:background="@drawable/bg_btn_abt"
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:layout_marginLeft="80dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="80dp"
                        android:layout_marginBottom="10dp"
                        android:scaleType="fitCenter"
                        android:text="Send"
                        android:layout_marginStart="80dp"
                        android:layout_marginEnd="80dp"/>
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
