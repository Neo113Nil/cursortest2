<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.fortunequest.neontrack.ui.StarrySkyView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp">
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/neon_orange"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/streak_lost_title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/hud_text"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/streak_lost_message"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDefeatFresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/play_again"
            style="@style/NeonButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDefeatHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/back_home"
            style="@style/NeonButton.Orange"/>
    </LinearLayout>
</FrameLayout>
