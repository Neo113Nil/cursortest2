<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.fortunequest.neontrack.ui.StarrySkyView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp">
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/neon_orange"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_done_title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/hud_text"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_done_message"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:id="@+id/victoryStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/neon_orange"
            android:id="@+id/victoryMultiplier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/neon_cyan"
            android:id="@+id/victoryLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVictoryContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/continue_home"
            style="@style/NeonButton"/>
    </LinearLayout>
</FrameLayout>
