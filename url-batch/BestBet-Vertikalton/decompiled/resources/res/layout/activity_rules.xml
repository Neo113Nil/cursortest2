<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.fortunequest.neontrack.ui.StarrySkyView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/neon_cyan"
                android:paddingBottom="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rules_title"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/hud_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rules_body"
                android:lineSpacingExtra="6dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRulesBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/back_home"
                style="@style/NeonButton.Orange"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
