<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.fortunequest.neontrack.ui.StarrySkyView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/hudBar"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/neon_orange"
                android:id="@+id/streakHud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/neon_cyan"
                android:gravity="center"
                android:id="@+id/multiplierHud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/hud_text"
                android:gravity="end"
                android:id="@+id/graceHud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:id="@+id/levelHud"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/hud_text"
            android:gravity="center"
            android:id="@+id/completedHud"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/neon_glow_cyan"
            android:gravity="center"
            android:id="@+id/tapHint"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_complete"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ScrollView
                android:id="@+id/habitScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:paddingHorizontal="16dp">
                <com.fortunequest.neontrack.ui.NeonHabitBoardView
                    android:id="@+id/habitBoard"
                    android:paddingBottom="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </ScrollView>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/hud_text"
                android:gravity="center"
                android:id="@+id/emptyState"
                android:padding="24dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/no_habits"/>
        </FrameLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/back_home"
            style="@style/NeonButton.Orange"/>
    </LinearLayout>
    <com.fortunequest.neontrack.ui.ColorWaveOverlay
        android:id="@+id/colorWave"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
