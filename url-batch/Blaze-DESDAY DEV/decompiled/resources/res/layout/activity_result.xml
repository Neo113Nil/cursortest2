<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/screen_background"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/hud_text"
        android:id="@+id/resultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/resultScore"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/food_neon"
        android:id="@+id/resultScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/resultFood"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/resultTitle"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/subtitle_text"
        android:id="@+id/resultFood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/resultMessage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/resultScore"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/hud_text"
        android:gravity="center"
        android:id="@+id/resultMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/retryButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/resultFood"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/retryButton"
        android:layout_marginTop="32dp"
        android:text="@string/retry"
        app:layout_constraintBottom_toTopOf="@+id/nextLevelButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/resultMessage"
        style="@style/WinWormButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/nextLevelButton"
        android:layout_marginTop="12dp"
        android:text="@string/next_level"
        app:layout_constraintBottom_toTopOf="@+id/homeButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/retryButton"
        style="@style/WinWormButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/homeButton"
        android:layout_marginTop="12dp"
        android:text="@string/home"
        android:backgroundTint="@color/accent_pink"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nextLevelButton"
        style="@style/WinWormButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
