<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/screen_background"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/icon"
        android:contentDescription="@string/home_title"
        app:layout_constraintBottom_toTopOf="@+id/titleText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/hud_text"
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/home_title"
        app:layout_constraintBottom_toTopOf="@+id/subtitleText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoImage"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/subtitle_text"
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_subtitle"
        app:layout_constraintBottom_toTopOf="@+id/crystalsText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleText"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/food_neon"
        android:id="@+id/crystalsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/quickPlayButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleText"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/quickPlayButton"
        android:layout_marginTop="32dp"
        android:text="@string/quick_play"
        app:layout_constraintBottom_toTopOf="@+id/levelsButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/crystalsText"
        style="@style/WinWormButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/levelsButton"
        android:layout_marginTop="12dp"
        android:text="@string/levels"
        app:layout_constraintBottom_toTopOf="@+id/rulesButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quickPlayButton"
        style="@style/WinWormButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/rulesButton"
        android:layout_marginTop="12dp"
        android:text="@string/rules"
        app:layout_constraintBottom_toTopOf="@+id/exitButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/levelsButton"
        style="@style/WinWormButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/exitButton"
        android:layout_marginTop="12dp"
        android:text="@string/exit_app"
        android:backgroundTint="@color/accent_pink"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rulesButton"
        style="@style/WinWormButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
