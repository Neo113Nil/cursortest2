<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_level_item"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:minHeight="72dp">
    <ImageView
        android:id="@+id/levelIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_level_star"
        android:contentDescription="@string/levels"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/hud_text"
            android:id="@+id/levelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/subtitle_text"
            android:id="@+id/levelBestScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/food_neon"
        android:id="@+id/levelStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
