<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_screen"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/hudBar"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/hud_text"
                android:gravity="start"
                android:id="@+id/hudIntake"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/hud_text"
                android:gravity="center"
                android:id="@+id/hudGoal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/hud_text"
                android:gravity="end"
                android:id="@+id/hudStreak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.glasspulse.glasspulse.view.WaterGlassView
                android:id="@+id/waterGlass"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="220dp"
                android:layout_height="300dp"
                android:contentDescription="@string/btn_track_water"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/neon_cyan"
                android:gravity="center"
                android:id="@+id/trackerHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/tap_to_add"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:id="@+id/btnAdd250"
                    android:background="@drawable/btn_neon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/add_250"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@null"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:id="@+id/btnAdd500"
                    android:background="@drawable/btn_neon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/add_500"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@null"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:id="@+id/btnAdd750"
                    android:background="@drawable/btn_neon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/add_750"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:backgroundTint="@null"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="14sp"
                android:textColor="@color/reset_accent"
                android:id="@+id/btnResetToday"
                android:background="@drawable/btn_neon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/btn_reset_today"
                android:textAllCaps="false"
                android:backgroundTint="@null"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/text_primary"
                android:id="@+id/btnBack"
                android:background="@drawable/btn_neon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:text="@string/btn_back"
                android:textAllCaps="false"
                android:backgroundTint="@null"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
