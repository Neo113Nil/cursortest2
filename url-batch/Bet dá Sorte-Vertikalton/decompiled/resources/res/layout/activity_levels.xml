<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/launch_start"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:id="@+id/levelsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/levels_title"/>
        <Button
            android:textColor="@color/text_primary"
            android:id="@+id/btnEasy"
            android:background="@drawable/btn_neon"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp"
            android:text="@string/level_easy"
            android:textAllCaps="false"
            android:backgroundTint="@null"/>
        <Button
            android:textColor="@color/text_primary"
            android:id="@+id/btnMedium"
            android:background="@drawable/btn_neon"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp"
            android:text="@string/level_medium"
            android:textAllCaps="false"
            android:backgroundTint="@null"/>
        <Button
            android:textColor="@color/text_primary"
            android:id="@+id/btnHard"
            android:background="@drawable/btn_neon"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:minHeight="48dp"
            android:text="@string/level_hard"
            android:textAllCaps="false"
            android:backgroundTint="@null"/>
        <Button
            android:textColor="@color/text_primary"
            android:id="@+id/btnBack"
            android:background="@drawable/btn_neon"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/btn_back"
            android:textAllCaps="false"
            android:backgroundTint="@null"/>
    </LinearLayout>
</FrameLayout>
