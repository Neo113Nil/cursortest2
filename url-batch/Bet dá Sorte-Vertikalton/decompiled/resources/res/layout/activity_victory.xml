<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/launch_start"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_water_drop"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:id="@+id/victoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/victory_title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/victoryBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:lineSpacingExtra="6dp"/>
        <Button
            android:textColor="@color/text_primary"
            android:id="@+id/btnContinue"
            android:background="@drawable/btn_neon"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp"
            android:text="@string/btn_continue"
            android:textAllCaps="false"
            android:backgroundTint="@null"/>
        <Button
            android:textColor="@color/text_primary"
            android:id="@+id/btnTrackMore"
            android:background="@drawable/btn_neon"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/btn_track_more"
            android:textAllCaps="false"
            android:backgroundTint="@null"/>
    </LinearLayout>
</FrameLayout>
