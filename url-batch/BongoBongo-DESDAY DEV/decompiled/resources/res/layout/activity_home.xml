<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/home_title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp"
            android:text="@string/home_subtitle"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_generate"
            app:icon="@drawable/ic_generate"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/neon_magenta"
            style="@style/NeonButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_presets"
            app:icon="@drawable/ic_dice"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/neon_cyan"
            style="@style/NeonButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_history"
            app:icon="@drawable/ic_history"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/neon_cyan"
            style="@style/NeonButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_rules"
            app:icon="@drawable/ic_lottery"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/neon_lime"
            style="@style/NeonButton.Accent"/>
    </LinearLayout>
</ScrollView>
