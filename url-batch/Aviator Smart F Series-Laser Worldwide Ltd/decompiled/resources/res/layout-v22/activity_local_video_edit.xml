<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#111111"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.crrepa.band.my.device.watchfacenew.video.widgets.VideoCropView
        android:id="@+id/video_crop_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_above="@+id/time_cut_layout"/>
    <com.crrepa.band.my.device.watchfacenew.video.widgets.TimeCutLayout
        android:id="@+id/time_cut_layout"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="40dp"
        android:layout_above="@+id/fl_operation"
        android:layout_marginHorizontal="40dp"/>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/fl_operation"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="10dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_play"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="0x7f0805bb"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/tv_cancel"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/cancel"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/main_1"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/tv_finish"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/done"/>
    </FrameLayout>
</RelativeLayout>
