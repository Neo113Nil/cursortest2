<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_step_chart"
    android:background="@color/white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/bg_2_f7"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/gps_training_steps_stride_title"
        android:layout_marginStart="20dp"
        style="@style/SubTitle"/>
    <View
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        style="@style/BorderView"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="40dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_avg_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/dark_grey"
                android:gravity="center"
                android:id="@+id/tv_avg_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dark_grey"
                android:gravity="center"
                android:id="@+id/tv_avg_rate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/gps_training_steps_avg_subtitle"
                android:drawablePadding="2dp"
                android:drawableStart="@drawable/shape_gps_training_step_frequency"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_avg_stride"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/dark_grey"
                android:gravity="center"
                android:id="@+id/tv_avg_stride"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dark_grey"
                android:gravity="center"
                android:id="@+id/tv_avg_stride_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/gps_training_stride_avg_subtitle"
                android:drawablePadding="2dp"
                android:drawableStart="@drawable/shape_gps_training_step_stride"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_gps_training"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_training_steps_unit"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_gps_finish_path_fast"
            android:id="@+id/tv_avg_stride_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_training_stride_unit"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.moyoung.dafit.module.common.widgets.chart.CrpLineChart
        android:id="@+id/chart_steps"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="41dp"
        android:layout_marginEnd="34dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/tv_start_time"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/tv_end_time_tips"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_end_time_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_end"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
