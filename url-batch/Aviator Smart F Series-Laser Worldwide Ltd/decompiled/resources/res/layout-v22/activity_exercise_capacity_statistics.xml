<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/physicalt_bg_2_nav"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="20dp">
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0801df"
            android:layout_centerVertical="true"
            app:tint="@color/physicalt_assist_1_nav"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/physicalt_assist_1_nav"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/lactate_threshold_hr_title"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@+id/iv_calendar"
            android:layout_toEndOf="@+id/iv_close"
            android:layout_marginHorizontal="20dp"/>
        <ImageView
            android:id="@+id/iv_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_calendar_w"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:tint="@color/physicalt_assist_1_nav"/>
    </RelativeLayout>
    <com.crrepa.band.my.health.widgets.MyNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/main_bg_5_function"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tl_tab"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:tabBackground="@color/physicalt_bg_3_title"
                app:tabIndicatorColor="@color/physicalt_assist_2_title"
                app:tabIndicatorHeight="3dp"
                app:tabRippleColor="@null"/>
            <com.crrepa.band.my.health.widgets.NoScrollViewPager
                android:id="@+id/vp_content"
                android:layout_width="match_parent"
                android:layout_height="260dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/physical_bg_5_detail"
                android:paddingLeft="20dp"
                android:paddingTop="17dp"
                android:paddingRight="20dp"
                android:paddingBottom="17dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="17dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/assist_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/training_data_overview"/>
                <View
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="20dp"
                    style="@style/BorderView"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:background="@color/physicalt_bg_6"
                        android:padding="15dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_max_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true">
                            <TextView
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/physical_main_1_word"
                                android:id="@+id/tv_max_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/physical_main_1_word"
                                android:id="@+id/tv_max_value_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:layout_marginStart="2dp"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/assist_14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:text="@string/training_max_value"
                            android:layout_below="@+id/ll_max_value"
                            android:layout_centerHorizontal="true"
                            android:layout_marginStart="2dp"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:background="@color/physicalt_bg_6"
                        android:padding="15dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_avg_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true">
                            <TextView
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/physical_main_1_word"
                                android:id="@+id/tv_avg_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/physical_main_1_word"
                                android:id="@+id/tv_avg_value_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:layout_marginStart="2dp"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/assist_14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:text="@string/training_avg_value"
                            android:layout_below="@+id/ll_avg_value"
                            android:layout_centerHorizontal="true"
                            android:layout_marginStart="2dp"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@color/main_bg_5_function"
                android:layout_width="match_parent"
                android:layout_height="20dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/physical_bg_5_detail"
                android:paddingLeft="20dp"
                android:paddingTop="17dp"
                android:paddingRight="20dp"
                android:paddingBottom="17dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="17dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/assist_14"
                    android:id="@+id/tv_about"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vo2max_about"/>
                <View
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="20dp"
                    style="@style/BorderView"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/shape_max_o2_note_bg"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/physical_main_5_tips"
                        android:id="@+id/tv_desc_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vo2max_understand"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/physical_main_5_tips"
                        android:id="@+id/tv_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/vo2max_desc"
                        android:lineSpacingExtra="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.crrepa.band.my.health.widgets.MyNestedScrollView>
</LinearLayout>
