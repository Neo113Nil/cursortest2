<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_back"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/assist_13_00"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_setting_training_title"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/assist_13_00"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/gps_setting_training_permission_title"
        android:layout_marginStart="20dp"/>
    <View
        android:background="@color/assist_5_D9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/sb_on_screen"
            app:kswAnimationDuration="300"
            app:kswBackDrawable="@drawable/switch_button_back_color"
            app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
            app:kswThumbHeight="24dp"
            app:kswThumbMarginBottom="1dp"
            app:kswThumbMarginLeft="1dp"
            app:kswThumbMarginRight="1dp"
            app:kswThumbMarginTop="1dp"
            app:kswThumbWidth="24dp"
            style="@style/SwitchButoonStyle"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/sb_on_screen"
            android:layout_alignParentStart="true"
            android:layout_marginVertical="15dp">
            <TextView
                android:text="@string/gps_setting_steady_lock_screen_title"
                style="@style/SettingItemText"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gps_setting_steady_lock_screen_content"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:background="@color/assist_5_D9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/assist_13_00"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/gps_setting_training_hint_title"
        android:layout_marginStart="20dp"/>
    <View
        android:background="@color/assist_5_D9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
    <RelativeLayout
        android:id="@+id/rl_voice_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <TextView
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:text="@string/gps_setting_voice_hint_title"
            android:layout_centerVertical="true"
            android:paddingVertical="17dp"
            style="@style/SettingItemText"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/sb_voice_tips"
            app:kswAnimationDuration="300"
            app:kswBackDrawable="@drawable/switch_button_back_color"
            app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
            app:kswThumbHeight="24dp"
            app:kswThumbMarginBottom="1dp"
            app:kswThumbMarginLeft="1dp"
            app:kswThumbMarginRight="1dp"
            app:kswThumbMarginTop="1dp"
            app:kswThumbWidth="24dp"
            style="@style/SwitchButoonStyle"/>
    </RelativeLayout>
    <View
        android:id="@+id/line_voice_tips"
        android:background="@color/assist_5_D9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
    <RelativeLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <TextView
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:text="@string/gps_setting_shake_hint_title"
            android:layout_centerVertical="true"
            android:paddingVertical="17dp"
            style="@style/SettingItemText"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/sb_vibration_tips"
            app:kswAnimationDuration="300"
            app:kswBackDrawable="@drawable/switch_button_back_color"
            app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
            app:kswThumbHeight="24dp"
            app:kswThumbMarginBottom="1dp"
            app:kswThumbMarginLeft="1dp"
            app:kswThumbMarginRight="1dp"
            app:kswThumbMarginTop="1dp"
            app:kswThumbWidth="24dp"
            style="@style/SwitchButoonStyle"/>
    </RelativeLayout>
    <View
        android:background="@color/assist_5_D9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
    <RelativeLayout
        android:id="@+id/rl_tips_frequency"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <TextView
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:text="@string/gps_setting_hint_frequency_title"
            android:layout_centerVertical="true"
            android:paddingVertical="17dp"
            style="@style/SettingItemText"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_9_99"
            android:id="@+id/tv_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/iv_tips_frequency"/>
        <ImageView
            android:id="@+id/iv_tips_frequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_continue"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/assist_5_D9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/assist_13_00"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/gps_training_setting_attention_title"
        android:layout_marginStart="20dp"/>
    <View
        android:background="@color/assist_5_D9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
    <RelativeLayout
        android:id="@+id/rl_training_attention"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <TextView
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:text="@string/gps_training_setting_attention_content"
            android:layout_centerVertical="true"
            android:paddingVertical="17dp"
            style="@style/SettingItemText"/>
        <ImageView
            android:id="@+id/iv_training_attention"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_continue"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/assist_5_D9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/assist_13_00"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/training_record_data_sync"
        android:layout_marginStart="20dp"/>
    <View
        android:background="@color/assist_5_D9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
    <RelativeLayout
        android:id="@+id/rl_data_sync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <TextView
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:text="@string/training_record_sync_tips_card"
            android:layout_centerVertical="true"
            android:paddingVertical="17dp"
            style="@style/SettingItemText"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/sb_training_sync_card"
            app:kswAnimationDuration="300"
            app:kswBackDrawable="@drawable/switch_button_back_color"
            app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
            app:kswThumbHeight="24dp"
            app:kswThumbMarginBottom="1dp"
            app:kswThumbMarginLeft="1dp"
            app:kswThumbMarginRight="1dp"
            app:kswThumbMarginTop="1dp"
            app:kswThumbWidth="24dp"
            style="@style/SwitchButoonStyle"/>
    </RelativeLayout>
</LinearLayout>
