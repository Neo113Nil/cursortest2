<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rl_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <TextView
            android:id="@+id/tv_back"
            android:background="@drawable/selector_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:layout_marginHorizontal="18dp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/title_assist_3_other"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_app_market_app_details_title"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_15"
            android:gravity="center"
            android:id="@+id/tv_title_uninstall"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_app_market_state_uninstall_title"
            android:layout_alignTop="@+id/tv_title"
            android:layout_alignBottom="@+id/tv_title"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <include
        android:id="@+id/include_base_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/rl_title_bar"
        layout="@layout/item_app_market_app"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_preview"
        android:layout_width="match_parent"
        android:layout_height="186dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/include_base_msg"
        android:layout_marginStart="20dp"/>
    <View
        android:layout_marginLeft="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/rv_preview"
        android:layout_marginHorizontal="20dp"
        style="@style/BorderView"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/rl_operation"
        android:layout_below="@+id/rv_preview">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_10"
                android:id="@+id/tv_introduction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginHorizontal="20dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_10"
                android:id="@+id/tv_update_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/tv_introduction"
                android:layout_marginHorizontal="20dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/assist_12"
                android:id="@+id/tv_app_info_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/device_app_market_app_info_title"
                android:layout_below="@+id/tv_update_msg"
                android:layout_marginHorizontal="20dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/tv_app_info_title"
                android:layout_marginHorizontal="20dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_10"
                    android:id="@+id/tv_version_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_app_market_version_title"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_10"
                    android:id="@+id/tv_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/tv_version_title"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_10"
                    android:id="@+id/tv_release_date_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/device_app_market_release_date_title"
                    android:layout_below="@+id/tv_version_title"
                    android:layout_marginVertical="10dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_10"
                    android:id="@+id/tv_release_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/tv_release_date_title"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_10"
                    android:id="@+id/tv_developer_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_app_market_developers_title"
                    android:layout_below="@+id/tv_release_date_title"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_10"
                    android:id="@+id/tv_developer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/tv_developer_title"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/rl_operation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="34dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="52dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_10"
            android:gravity="center"
            android:id="@+id/tv_installed"
            android:background="@drawable/shape_app_market_installed"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/device_app_market_state_installed_title"
            android:paddingHorizontal="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_1"
            android:gravity="center"
            android:id="@+id/tv_uninstall"
            android:background="@drawable/shape_app_market_unload"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/device_app_market_state_uninstall_title"
            android:paddingHorizontal="16dp"/>
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:id="@+id/shadow_install"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            app:cornerRadius="22dp"
            app:shadowColor="@color/main_btn"
            app:shadowRadius="8dp">
            <Button
                android:background="@drawable/shape_app_market_download"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                style="?android:attr/borderlessButtonStyle"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/assist_1"
                android:gravity="center"
                android:layout_gravity="center"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="270dp"
                android:text="@string/device_app_market_state_install_title"
                app:drawableStartCompat="0x7f08019d"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:id="@+id/shadow_update"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            app:cornerRadius="22dp"
            app:shadowColor="@color/main_btn"
            app:shadowRadius="8dp">
            <Button
                android:background="@drawable/shape_app_market_download"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                style="?android:attr/borderlessButtonStyle"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/assist_1"
                android:gravity="center"
                android:layout_gravity="center"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="270dp"
                android:text="@string/device_app_market_state_update_title"
                app:drawableStartCompat="0x7f08019f"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
        <ProgressBar
            android:id="@+id/pb"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100"
            android:progressDrawable="@drawable/progressbar_horizontal_app_market_downloading"
            android:layout_alignTop="@+id/shadow_install"
            style="@style/ProgressBarHorizontal"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/assist_1"
            android:gravity="center"
            android:id="@+id/tv_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="0%"
            android:layout_alignTop="@+id/shadow_install"
            android:layout_alignStart="@+id/shadow_install"
            android:layout_alignEnd="@+id/shadow_install"/>
    </RelativeLayout>
</RelativeLayout>
