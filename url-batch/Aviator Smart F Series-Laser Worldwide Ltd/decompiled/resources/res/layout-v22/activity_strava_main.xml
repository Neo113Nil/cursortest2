<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_1_ff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_title"
        layout="@layout/band_data_appbar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_9_99"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/strava_connect_subtitle"
                android:layout_marginHorizontal="20dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="110dp">
                <ImageView
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:src="0x7f080273"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/main"
                    android:id="@+id/tv_strava_connected"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/strava_connect_connected_tips"/>
            </LinearLayout>
            <com.moyoung.dafit.module.common.widgets.ShadowLayout
                android:id="@+id/shadow_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="52dp"
                android:layout_marginTop="110dp"
                android:layout_marginRight="52dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="52dp"
                app:cornerRadius="22dp"
                app:shadowColor="@color/main"
                app:shadowRadius="8dp">
                <Button
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:id="@+id/btn_connect"
                    android:background="@drawable/shape_ai_picture_commit"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/connect"
                    android:textAllCaps="false"
                    style="?android:attr/borderlessButtonStyle"/>
            </com.moyoung.dafit.module.common.widgets.ShadowLayout>
            <com.moyoung.dafit.module.common.widgets.ShadowLayout
                android:id="@+id/shadow_unbind"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="52dp"
                android:layout_marginTop="110dp"
                android:layout_marginRight="52dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="52dp"
                app:cornerRadius="22dp"
                app:shadowColor="@color/assist_5_D9"
                app:shadowRadius="8dp">
                <Button
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:id="@+id/btn_unbind"
                    android:background="@drawable/shape_ai_picture_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/disconnect_google_fit"
                    android:textAllCaps="false"
                    style="?android:attr/borderlessButtonStyle"/>
            </com.moyoung.dafit.module.common.widgets.ShadowLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
