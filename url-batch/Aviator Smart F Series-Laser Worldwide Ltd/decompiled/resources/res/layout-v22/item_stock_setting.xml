<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:paddingTop="10dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/assist_11_33"
        android:id="@+id/tv_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="190dp"
        android:layout_marginStart="18dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/assist_7_B3"
        android:id="@+id/tv_exchange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="2dp"
        android:singleLine="true"
        android:layout_alignTop="@+id/tv_symbol"
        android:layout_marginStart="6dp"
        android:layout_toStartOf="@+id/tv_currency"
        android:layout_toEndOf="@+id/tv_symbol"/>
    <com.moyoung.dafit.module.common.widgets.SingleLineZoomTextView
        android:textSize="11sp"
        android:textColor="@color/assist_11_33"
        android:id="@+id/tv_short_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        android:singleLine="true"
        android:layout_below="@+id/tv_symbol"
        android:layout_toStartOf="@+id/tv_markup"
        android:layout_alignStart="@+id/tv_symbol"/>
    <ImageView
        android:id="@+id/iv_sort"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="-5dp"
        android:src="0x7f080484"
        android:layout_below="@+id/tv_regular_market_price"
        android:layout_marginEnd="18dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/assist_7_B3"
        android:id="@+id/tv_closed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stock_market_closed_content"
        android:layout_below="@+id/tv_regular_market_price"
        android:layout_marginEnd="19dp"
        android:layout_toStartOf="@+id/iv_sort"/>
    <com.moyoung.dafit.module.common.widgets.SingleLineZoomTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/assist_11_33"
        android:gravity="end"
        android:id="@+id/tv_regular_market_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="19dp"
        android:layout_toStartOf="@+id/iv_sort"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/assist_7_B3"
        android:id="@+id/tv_currency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:singleLine="true"
        android:layout_alignBottom="@+id/tv_regular_market_price"
        android:layout_marginEnd="6dp"
        android:layout_toStartOf="@+id/tv_regular_market_price"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_markup"
        android:background="@drawable/shape_stock_markup_fall_bg"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        android:singleLine="true"
        android:layout_below="@+id/tv_regular_market_price"
        android:layout_alignEnd="@+id/tv_regular_market_price"
        android:paddingHorizontal="5dp"/>
    <View
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_below="@+id/tv_short_name"
        android:layout_marginHorizontal="18dp"
        style="@style/BorderView"/>
</RelativeLayout>
