<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/title_bar"
        layout="@layout/band_data_appbar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/view_daily_goals_setting"
                layout="@layout/view_daily_goals_setting"/>
            <View
                android:background="@color/color_my_picker_bg_h"
                android:layout_width="match_parent"
                android:layout_height="20dp"/>
            <RelativeLayout
                android:gravity="center"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:id="@+id/tv_exercise_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_exercise_day_title"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/sbtn_training_day"
                    android:layout_alignParentStart="true"/>
                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/sbtn_training_day"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:kswAnimationDuration="300"
                    app:kswBackDrawable="@drawable/switch_button_back_color"
                    app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
                    app:kswThumbHeight="24dp"
                    app:kswThumbMarginBottom="1dp"
                    app:kswThumbMarginLeft="1dp"
                    app:kswThumbMarginRight="1dp"
                    app:kswThumbMarginTop="1dp"
                    app:kswThumbWidth="24dp"
                    style="@style/SwitchButoonStyle"/>
            </RelativeLayout>
            <View style="@style/BorderView"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_training_days"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="@string/goal_exercise_day_subtitle"
                    android:includeFontPadding="false"
                    android:layout_marginStart="20dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="30dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <CheckBox
                        android:id="@+id/cb_sunday"
                        android:text="@string/sunday"
                        style="@style/GoalsCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_monday"
                        android:text="@string/monday"
                        style="@style/GoalsCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_tuesday"
                        android:text="@string/tuesday"
                        style="@style/GoalsCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_wednesday"
                        android:text="@string/wednesday"
                        style="@style/GoalsCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_thursday"
                        android:text="@string/thursday"
                        style="@style/GoalsCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_friday"
                        android:text="@string/friday"
                        style="@style/GoalsCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_saturday"
                        android:text="@string/saturday"
                        style="@style/GoalsCheckBoxTheme"/>
                </LinearLayout>
                <View style="@style/BorderView"/>
                <include
                    android:id="@+id/view_training_goals_setting"
                    layout="@layout/view_training_goals_setting"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
