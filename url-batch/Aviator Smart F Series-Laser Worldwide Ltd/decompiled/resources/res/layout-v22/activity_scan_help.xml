<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/bar"
        layout="@layout/band_data_appbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_14"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/binding_help_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_10"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/binding_help_content1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_10"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/binding_help_content2"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_10"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/binding_help_content3"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_10"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/binding_help_content4"/>
    </LinearLayout>
</LinearLayout>
