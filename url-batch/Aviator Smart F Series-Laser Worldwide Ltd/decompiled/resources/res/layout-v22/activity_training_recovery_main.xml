<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_bg_5_function"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/recovery_bg_2_nav"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="20dp">
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0801df"
            android:layout_centerVertical="true"
            app:tint="@color/physicalt_assist_1_nav"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/physicalt_assist_1_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_recovery_title"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_calendar_w"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:tint="@color/physicalt_assist_1_nav"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/recovery_bg_5_detail"
        android:paddingLeft="20dp"
        android:paddingTop="17dp"
        android:paddingRight="20dp"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="20dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="17dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_14"
            android:id="@+id/tv_training_recovery_level_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_recovery_level"
            android:drawablePadding="6dp"
            app:drawableEndCompat="0x7f0801f7"/>
        <View
            android:id="@+id/line"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:layout_below="@+id/tv_training_recovery_level_title"
            style="@style/BorderView"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line">
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_remaining_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/recovery_main_1_word"
                        android:id="@+id/tv_recovery_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/recovery_main_1_word"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="%"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/training_recovery_remaining_strength"
                    android:layout_below="@+id/ll_remaining_value"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="2dp"/>
            </RelativeLayout>
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/assist_6"
                android:layout_width="1dp"
                android:layout_height="35dp"/>
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/recovery_main_1_word"
                    android:id="@+id/tv_recovery_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/training_recovery_time"
                    android:layout_below="@+id/tv_recovery_time"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="2dp"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
