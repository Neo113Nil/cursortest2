<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    android:layout_marginBottom="6dp"
    android:layout_marginHorizontal="10dp">
    <com.crrepa.band.my.health.widgets.WaveCalendarView
        android:id="@+id/wcv_water"
        android:background="0x7f08089a"
        android:layout_width="22dp"
        android:layout_height="29dp"
        android:layout_marginStart="3dp"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_calendar_day"
        android:background="@drawable/shape_water_calendar_day_bg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/wcv_water"
        android:paddingHorizontal="6dp"/>
</RelativeLayout>
