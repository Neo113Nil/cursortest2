<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/analysis_bg_4_data"
    android:layout_width="match_parent"
    android:layout_height="260dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_highlight_value"
        android:background="@drawable/shape_physicalt_highlight_value_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginTop="15dp"
        android:layout_centerHorizontal="true"
        android:paddingHorizontal="10dp">
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/physicalt_assist_3_data"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_highlight_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/data_blank"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/physicalt_assist_3_data"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_highlight_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.moyoung.dafit.module.common.widgets.chart.WeightLineChart
        android:id="@+id/chart"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"
        android:layout_below="@+id/ll_highlight_value"
        android:layout_alignParentBottom="true"/>
    <View
        android:background="@color/main_bg_5_function"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"/>
    <com.crrepa.band.my.health.widgets.HandleView
        android:id="@+id/handle_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"/>
</RelativeLayout>
