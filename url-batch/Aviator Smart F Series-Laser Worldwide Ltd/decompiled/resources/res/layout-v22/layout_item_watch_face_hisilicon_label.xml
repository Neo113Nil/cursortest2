<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/rl_hisilicon_label_root"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.crrepa.band.my.device.watchfacenew.photo.widgets.DraggableLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_hisilicon_label"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="9dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_watch_face_time_top"
            android:layout_width="37dp"
            android:layout_height="7dp"/>
        <ImageView
            android:id="@+id/iv_watch_face_time"
            android:layout_width="54dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginVertical="2dp"/>
        <ImageView
            android:id="@+id/iv_watch_face_time_bottom"
            android:layout_width="37dp"
            android:layout_height="7dp"/>
    </com.crrepa.band.my.device.watchfacenew.photo.widgets.DraggableLinearLayout>
    <ImageView
        android:id="@+id/iv_hisilicon_clock_pointer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img_time_pointer"
        android:layout_centerInParent="true"/>
</RelativeLayout>
