<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:layout_marginVertical="10dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_me"
        android:background="@drawable/shape_ai_chat_records_me"
        android:padding="11dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="264dp"
        android:textIsSelectable="true"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/rl_gpt"
        android:background="@drawable/shape_ai_chat_records_gpt"
        android:padding="11dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/anim_answer_loading"
            android:layout_width="72dp"
            android:layout_height="41dp"
            android:layout_centerVertical="true"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/anim_chat_answer_loading"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_gpt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="264dp"
            android:textIsSelectable="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_operation"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/rl_gpt"
        android:layout_alignStart="@+id/rl_gpt">
        <RelativeLayout
            android:id="@+id/rl_tts"
            android:background="@drawable/shape_ai_answer_operation_bg"
            android:layout_width="40dp"
            android:layout_height="32dp">
            <TextView
                android:id="@+id/tv_tts_play"
                android:background="0x7f080196"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_centerInParent="true"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/anim_tts_playing"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_centerInParent="true"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/ani_ai_tts_playing"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/anim_tts_loading"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_centerInParent="true"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/ani_ai_tts_loading"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_txt_copy"
            android:background="@drawable/shape_ai_answer_operation_bg"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:src="0x7f080193"
            android:scaleType="centerInside"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/rl_tts"/>
    </RelativeLayout>
</RelativeLayout>
