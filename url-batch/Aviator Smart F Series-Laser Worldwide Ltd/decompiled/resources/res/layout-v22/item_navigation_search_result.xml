<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <ImageView
        android:id="@+id/iv_result_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0803ac"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/assist_12"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_result_name"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/iv_go_location"
        android:layout_toEndOf="@+id/iv_result_type"
        android:paddingHorizontal="10dp"/>
    <ImageView
        android:id="@+id/iv_go_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0803f0"
        android:layout_centerVertical="true"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="#e9e9e7"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="10dp"/>
</RelativeLayout>
