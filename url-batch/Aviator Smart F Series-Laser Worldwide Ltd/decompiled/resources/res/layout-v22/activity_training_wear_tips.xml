<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:src="@drawable/selector_title_close"
        android:layout_marginStart="20dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_above="@+id/sl_shoot"
        android:layout_below="@+id/iv_back">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_tips"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/assist_13_00"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/gps_training_wearing_tips_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_10_66"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/gps_training_wearing_tips_subtitle"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <View
                    android:background="0x7f080647"
                    android:layout_width="154dp"
                    android:layout_height="126dp"
                    android:layout_marginStart="12dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/assist_11_33"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/gps_training_wearing_tips_arm_bag_text"
                    android:drawablePadding="4dp"
                    android:layout_marginStart="130dp"
                    app:drawableStartCompat="0x7f0805c7"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/assist_11_33"
                    android:gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/gps_training_wearing_tips_fanny_pack_text"
                    android:drawablePadding="4dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="1dp"
                    android:layout_toStartOf="@+id/view_wear_pocket"
                    app:drawableStartCompat="0x7f0805c7"/>
                <View
                    android:id="@+id/view_wear_pocket"
                    android:background="0x7f080648"
                    android:layout_width="154dp"
                    android:layout_height="126dp"
                    android:layout_marginEnd="33dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="200dp"
                android:layout_height="104dp"
                android:layout_marginTop="46dp"
                android:src="0x7f080649"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_11_33"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/gps_training_wearing_tips_phone_treadmill_text"
                android:drawablePadding="4dp"
                app:drawableStartCompat="0x7f0805c8"/>
        </LinearLayout>
    </ScrollView>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:id="@+id/sl_shoot"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:cornerRadius="22dp"
        app:shadowColor="@color/color_gps_training"
        app:shadowRadius="8dp">
        <Button
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/white"
            android:id="@+id/btn_ok"
            android:background="@drawable/shape_gps_training_start"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/btn_ok"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
</RelativeLayout>
