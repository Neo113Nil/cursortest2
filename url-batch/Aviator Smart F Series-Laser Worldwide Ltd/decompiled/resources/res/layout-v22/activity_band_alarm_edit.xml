<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_alarm_edit_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_marginStart="15dp"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/set_alarm"
            android:lines="1"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/color_refresh"
            android:id="@+id/tv_alarm_edit_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_marginEnd="15dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="190dp">
        <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            aigestudio:wheel_atmospheric="true"
            aigestudio:wheel_curved="true"
            aigestudio:wheel_cyclic="false"
            aigestudio:wheel_data="@array/null_array"
            aigestudio:wheel_indicator="true"
            aigestudio:wheel_indicator_color="@color/grey"
            aigestudio:wheel_indicator_size="1dp"
            aigestudio:wheel_item_text_color="@color/grey"
            aigestudio:wheel_item_text_size="22sp"
            aigestudio:wheel_selected_item_text_color="@color/black"/>
        <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
            android:id="@+id/wp_time_hour"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            aigestudio:wheel_atmospheric="true"
            aigestudio:wheel_curved="true"
            aigestudio:wheel_cyclic="false"
            aigestudio:wheel_indicator="true"
            aigestudio:wheel_indicator_color="@color/grey"
            aigestudio:wheel_indicator_size="1dp"
            aigestudio:wheel_item_text_color="@color/grey"
            aigestudio:wheel_item_text_size="22sp"
            aigestudio:wheel_selected_item_text_color="@color/black"/>
        <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
            android:id="@+id/wp_time_minute"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            aigestudio:wheel_atmospheric="true"
            aigestudio:wheel_curved="true"
            aigestudio:wheel_cyclic="false"
            aigestudio:wheel_indicator="true"
            aigestudio:wheel_indicator_color="@color/grey"
            aigestudio:wheel_indicator_size="1dp"
            aigestudio:wheel_item_text_color="@color/grey"
            aigestudio:wheel_item_text_size="22sp"
            aigestudio:wheel_selected_item_text_color="@color/black"/>
        <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            aigestudio:wheel_atmospheric="true"
            aigestudio:wheel_curved="true"
            aigestudio:wheel_cyclic="false"
            aigestudio:wheel_data="@array/null_array"
            aigestudio:wheel_indicator="true"
            aigestudio:wheel_indicator_color="@color/grey"
            aigestudio:wheel_indicator_size="1dp"
            aigestudio:wheel_item_text_color="@color/grey"
            aigestudio:wheel_item_text_size="22sp"
            aigestudio:wheel_selected_item_text_color="@color/black"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/grey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/repeat"
        android:layout_marginStart="20dp"
        android:layout_marginVertical="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <CheckBox
            android:id="@+id/cb_sunday"
            android:text="@string/sunday"
            style="@style/AlarmCheckBoxTheme"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <CheckBox
            android:id="@+id/cb_monday"
            android:text="@string/monday"
            style="@style/AlarmCheckBoxTheme"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <CheckBox
            android:id="@+id/cb_tuesday"
            android:text="@string/tuesday"
            style="@style/AlarmCheckBoxTheme"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <CheckBox
            android:id="@+id/cb_wednesday"
            android:text="@string/wednesday"
            style="@style/AlarmCheckBoxTheme"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <CheckBox
            android:id="@+id/cb_thursday"
            android:text="@string/thursday"
            style="@style/AlarmCheckBoxTheme"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <CheckBox
            android:id="@+id/cb_friday"
            android:text="@string/friday"
            style="@style/AlarmCheckBoxTheme"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <CheckBox
            android:id="@+id/cb_saturday"
            android:text="@string/saturday"
            style="@style/AlarmCheckBoxTheme"/>
    </LinearLayout>
</LinearLayout>
