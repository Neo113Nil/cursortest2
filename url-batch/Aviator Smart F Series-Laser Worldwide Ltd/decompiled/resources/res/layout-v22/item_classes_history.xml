<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_training_records"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:paddingHorizontal="20dp">
    <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
        android:id="@+id/iv_cover"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        app:riv_corner_radius="8dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/assist_13_00"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:maxLines="1"
        android:layout_alignTop="@+id/iv_cover"
        android:layout_toStartOf="@+id/ll_date"
        android:layout_toEndOf="@+id/iv_cover"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/assist_7_B3"
        android:id="@+id/tv_spent_kcal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/tv_title"
        android:layout_toEndOf="@+id/iv_cover"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/ll_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/iv_continue">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/assist_7_B3"
            android:id="@+id/tv_training_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/assist_7_B3"
            android:id="@+id/tv_training_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_continue"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <View
        android:layout_alignParentBottom="true"
        style="@style/BorderView"/>
</RelativeLayout>
