<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="8dp"
    android:paddingTop="18dp"
    android:paddingRight="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp">
    <ImageView
        android:id="@+id/iv_cover"
        android:layout_width="100dp"
        android:layout_height="94dp"
        android:scaleType="fitXY"/>
    <View
        android:id="@+id/view_mask"
        android:background="@drawable/shape_white_noise_cover_mask"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/iv_cover"
        android:layout_alignBottom="@+id/iv_cover"
        android:layout_alignStart="@+id/iv_cover"
        android:layout_alignEnd="@+id/iv_cover"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/anima"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_alignTop="@+id/iv_cover"
        android:layout_alignBottom="@+id/iv_cover"
        android:layout_centerHorizontal="true"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/anim_in_play"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_1_ff"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/iv_cover"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
