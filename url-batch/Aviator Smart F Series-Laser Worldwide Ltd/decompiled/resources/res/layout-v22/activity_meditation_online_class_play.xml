<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:background="#40000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/rl_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="44dp">
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f0801e0"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/assist_1_ff"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/anim_loading"
        android:layout_width="375dp"
        android:layout_height="475dp"
        android:layout_centerInParent="true"
        app:lottie_autoPlay="true"
        app:lottie_loop="false"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/anim_playing"
        android:visibility="gone"
        android:layout_width="375dp"
        android:layout_height="475dp"
        android:layout_centerInParent="true"
        app:lottie_autoPlay="false"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/assist_1_ff"
        android:id="@+id/tv_loading_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/meditation_online_class_loading"
        android:layout_centerInParent="true"/>
    <com.google.android.exoplayer2.ui.PlayerControlView
        android:id="@+id/player_controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="45dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        app:controller_layout_id="@layout/custom_exo_audio_player_control_view"
        app:show_timeout="0"/>
</RelativeLayout>
