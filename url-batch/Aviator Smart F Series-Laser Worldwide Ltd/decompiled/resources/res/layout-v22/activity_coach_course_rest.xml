<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.moyoung.classes.coach.widget.SegmentVideoTimeBar
        android:id="@+id/segment_video_time_bar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="54dp"
        android:layout_marginRight="20dp"
        android:progressDrawable="@drawable/progressbar_segment_video_time_bar_rest"
        android:layout_marginHorizontal="20dp"
        style="@style/ProgressBarHorizontal"/>
    <com.moyoung.dafit.module.common.widgets.CircleDisplayView
        android:id="@+id/cdv_count_down"
        android:layout_width="186dp"
        android:layout_height="186dp"
        android:layout_marginTop="100dp"
        android:layout_below="@+id/segment_video_time_bar"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/view_center"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_alignTop="@+id/tv_delayed"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/class_assist_1"
        android:gravity="center"
        android:id="@+id/tv_delayed"
        android:background="@drawable/shape_classes_delayed_btn"
        android:layout_width="95dp"
        android:layout_height="35dp"
        android:layout_marginTop="38dp"
        android:text="@string/fitness_extension_seconds_text"
        android:layout_below="@+id/cdv_count_down"
        android:layout_toStartOf="@+id/view_center"/>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:id="@+id/sl_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:layout_below="@+id/cdv_count_down"
        android:layout_toEndOf="@+id/view_center"
        app:cornerRadius="22dp"
        app:shadowColor="@color/class_assist_1"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_1_ff"
            android:gravity="center"
            android:id="@+id/tv_skip"
            android:background="@drawable/shape_classes_assist_1_btn"
            android:layout_width="95dp"
            android:layout_height="35dp"
            android:text="@string/fitness_skip_break_text"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
    <RelativeLayout
        android:id="@+id/rl_next_action"
        android:background="@drawable/shape_coach_next_action_msg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="100dp"
        android:layout_marginRight="50dp"
        android:layout_below="@+id/tv_delayed"
        android:paddingStart="20dp"
        android:paddingEnd="7dp"
        android:layout_marginHorizontal="50dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/assist_12_22"
            android:ellipsize="end"
            android:id="@+id/tv_next_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/fitness_next_move_text"
            android:maxLines="2"
            android:layout_toStartOf="@+id/iv_next_action_cover"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/assist_13_00"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_next_action_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:layout_below="@+id/tv_next_action"
            android:layout_toStartOf="@+id/iv_next_action_cover"
            android:layout_alignParentStart="true"/>
        <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
            android:id="@+id/iv_next_action_cover"
            android:layout_width="92dp"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginVertical="7dp"
            app:riv_corner_radius="3dp"/>
    </RelativeLayout>
</RelativeLayout>
