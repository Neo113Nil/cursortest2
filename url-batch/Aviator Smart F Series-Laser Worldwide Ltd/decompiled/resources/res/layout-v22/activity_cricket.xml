<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_2_f7"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="0x7f0805f0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <include
        android:id="@+id/includedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        layout="@layout/band_data_appbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_cricket_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/includedTitle"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_cricket_type"
            android:background="@drawable/shape_cricket_tab_corner_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="8dp"
            app:tabIndicatorColor="@color/main"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="20dp"
            app:tabPaddingStart="20dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/black"
            app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
            app:tabTextColor="@color/assist_7_B3"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager_cricket"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </LinearLayout>
</RelativeLayout>
