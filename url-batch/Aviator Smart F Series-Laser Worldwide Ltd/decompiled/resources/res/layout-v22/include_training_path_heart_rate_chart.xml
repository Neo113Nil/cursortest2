<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_heart_rate_chart"
    android:background="@color/white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/bg_2_f7"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/heart_rate"
        android:layout_marginStart="20dp"
        style="@style/SubTitle"/>
    <View
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        style="@style/BorderView"/>
    <com.moyoung.dafit.module.common.widgets.chart.CrpLineChart
        android:id="@+id/chart_heart_rate"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="8dp"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="22dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/tv_start_time"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/tv_end_time_tips"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_end_time_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_end"
            android:layout_marginStart="5dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
