<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/guide_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextureView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="40dp"/>
    <View
        android:id="@+id/view_center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_centerInParent="true"/>
    <View
        android:id="@+id/view_bottom"
        android:background="@drawable/shape_gradient_guidance_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_center"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_alignTop="@+id/v_text_top"
        android:layout_marginHorizontal="20dp">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/assist_12"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/assist_10"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <View
        android:id="@+id/v_text_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="210dp"
        android:layout_above="@+id/ll_enable"/>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/ll_enable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:cornerRadius="22dp"
        app:shadowColor="@color/main_btn"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_enable"
            android:background="@drawable/shape_private_policy_agree"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/guidance_permission_enable"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main"
        android:id="@+id/tv_no_thanks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:text="@string/no_thanks"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
