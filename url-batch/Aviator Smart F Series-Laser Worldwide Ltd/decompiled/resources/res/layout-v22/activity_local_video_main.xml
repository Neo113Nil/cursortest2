<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/appbar"
        layout="@layout/band_data_appbar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_13_00"
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="18dp"
            android:layout_marginHorizontal="18dp"/>
        <RelativeLayout
            android:id="@+id/rl_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tv_description">
            <ImageView
                android:id="@+id/iv_empty"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="100dp"
                android:src="0x7f0803a1"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_9_99"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_local_video_no_video_tips_text"
                android:layout_below="@+id/iv_empty"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <com.yanzhenjie.recyclerview.SwipeRecyclerView
            android:id="@+id/rv_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/tv_description"/>
    </RelativeLayout>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/shadow_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        app:cornerRadius="22dp"
        app:shadowColor="@color/main"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_add"
            android:background="@drawable/shape_private_policy_agree"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/device_local_video_btn_text"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
