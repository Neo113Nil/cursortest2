<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_asr_input"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true">
    <RelativeLayout
        android:id="@+id/rl_input_keyboard"
        android:background="#f7f7f7"
        android:paddingLeft="14dp"
        android:paddingTop="17dp"
        android:paddingRight="14dp"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="17dp">
        <Button
            android:id="@+id/iv_switch_2_voice"
            android:background="0x7f08019a"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="14dp"/>
        <EditText
            android:textSize="16sp"
            android:textColor="@color/black"
            android:textColorHint="@color/assist_9_99"
            android:id="@+id/et_input"
            android:background="@drawable/shape_ai_chat_input"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:hint="@string/ai_enter_content_tip_text"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/iv_keyboard_send"
            android:layout_toEndOf="@+id/iv_switch_2_voice"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"/>
        <Button
            android:id="@+id/iv_keyboard_send"
            android:background="0x7f080195"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_input_voice"
        android:background="#f7f7f7"
        android:paddingLeft="14dp"
        android:paddingTop="17dp"
        android:paddingRight="14dp"
        android:paddingBottom="17dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="17dp">
        <Button
            android:id="@+id/iv_switch_2_keyboard"
            android:background="0x7f080194"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="14dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tv_voice_handle"
            android:background="@drawable/shape_ai_chat_input"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/ai_hold_speak_text"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/iv_switch_2_keyboard"/>
    </RelativeLayout>
    <View
        android:background="#e7e7e7"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</RelativeLayout>
