<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
        android:id="@+id/iv_picture"
        android:layout_width="85dp"
        android:layout_height="100dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:maxHeight="100dp"
        android:minHeight="85dp"
        android:layout_marginStart="20dp"
        android:layout_marginVertical="20dp"
        app:riv_corner_radius="10dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_13_00"
        android:id="@+id/tv_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/iv_picture"
        android:layout_marginHorizontal="20dp"/>
    <View
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/iv_picture"
        android:layout_marginHorizontal="20dp"
        style="@style/BorderView"/>
</RelativeLayout>
