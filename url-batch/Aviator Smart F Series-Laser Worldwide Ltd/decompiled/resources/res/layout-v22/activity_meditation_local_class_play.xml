<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <RelativeLayout
        android:id="@+id/rl_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="44dp">
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f0801e0"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/assist_1_ff"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/assist_1_ff"
        android:gravity="center"
        android:id="@+id/tv_white_noise"
        android:background="@drawable/shape_sound_effect_tv_bg"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:drawablePadding="6dp"
        android:layout_below="@+id/rl_title"
        android:layout_centerHorizontal="true"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        app:drawableEndCompat="@mipmap/ic_meditation_continue"
        app:drawableStartCompat="@mipmap/ic_meditation_in_play"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_count_down"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/anim_count_down"
            android:layout_width="115dp"
            android:layout_height="115dp"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_1_ff_99"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="70dp"
            android:layout_marginRight="30dp"
            android:text="@string/meditation_local_class_ready_tips"
            android:layout_marginHorizontal="30dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_picker"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginTop="103dp"
        android:layout_below="@+id/tv_white_noise"
        android:layout_centerHorizontal="true">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/anim_time_picker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/anim_time_picker"/>
        <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
            android:id="@+id/wheel_picker"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:minWidth="40dp"
            android:layout_centerInParent="true"
            android:layout_marginVertical="40dp"
            app:wheel_atmospheric="true"
            app:wheel_curved="false"
            app:wheel_cyclic="false"
            app:wheel_item_align="center"
            app:wheel_item_text_color="@color/assist_1_ff"
            app:wheel_item_text_size="30sp"
            app:wheel_selected_item_text_color="@color/assist_1_ff"
            app:wheel_visible_item_count="3"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_1_ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meditation_class_duration_unit"
            android:layout_centerVertical="true"
            android:layout_marginStart="2dp"
            android:layout_toEndOf="@+id/wheel_picker"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_breath"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="103dp"
        android:layout_below="@+id/tv_white_noise"
        android:layout_centerHorizontal="true">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/anim_breath"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/assist_1_ff"
            android:id="@+id/tv_breath_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_1_ff_99"
        android:id="@+id/tv_breath_times"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/meditation_class_breath_unit"
        android:layout_below="@+id/rl_picker"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/relax_assist_1"
        android:gravity="center"
        android:id="@+id/tv_start"
        android:background="@drawable/shape_meditation_play_start_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="52dp"
        android:layout_marginRight="52dp"
        android:layout_marginBottom="54dp"
        android:text="@string/meditation_class_start"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="52dp"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/assist_1_ff_99"
        android:gravity="center"
        android:id="@+id/tv_end"
        android:background="@drawable/shape_meditation_play_end_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="52dp"
        android:layout_marginRight="52dp"
        android:layout_marginBottom="54dp"
        android:text="@string/meditation_class_end"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="52dp"/>
</RelativeLayout>
