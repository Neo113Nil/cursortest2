<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_gomore_sport_training_effect"
    android:background="@color/running_bg_3_detail"
    android:paddingLeft="26dp"
    android:paddingRight="26dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="26dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_14"
        android:id="@+id/tv_training_effect_title"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/training_effect"
        android:drawablePadding="6dp"
        android:paddingVertical="17dp"
        app:drawableEndCompat="0x7f0801f7"/>
    <View style="@style/BorderView"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/center_space">
            <com.crrepa.band.my.training.widgets.TrainingEffectProgressView
                android:id="@+id/chart_aerobic"
                android:layout_width="104dp"
                android:layout_height="104dp"/>
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/assist_12"
                android:gravity="center"
                android:id="@+id/tv_aerobic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/chart_aerobic"
                android:layout_alignBottom="@+id/chart_aerobic"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/assist_10"
                android:gravity="center"
                android:id="@+id/tv_aerobic_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:layout_below="@+id/chart_aerobic"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/training_effect_aerobic"
                android:layout_below="@+id/tv_aerobic_level"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <Space
            android:id="@+id/center_space"
            android:layout_width="67dp"
            android:layout_height="1dp"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/center_space">
            <com.crrepa.band.my.training.widgets.TrainingEffectProgressView
                android:id="@+id/chart_anaerobic"
                android:layout_width="104dp"
                android:layout_height="104dp"/>
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/assist_12"
                android:gravity="center"
                android:id="@+id/tv_anaerobic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/chart_anaerobic"
                android:layout_alignBottom="@+id/chart_anaerobic"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/assist_10"
                android:gravity="center"
                android:id="@+id/tv_anaerobic_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:layout_below="@+id/chart_anaerobic"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/training_effect_anaerobic"
                android:layout_below="@+id/tv_anaerobic_level"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
