<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/black"
            android:id="@+id/tv_watch_face_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_photo_watch_face_title"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/main"
            android:id="@+id/tv_face_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="50dp">
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/rl_add_img"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp">
            <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
                android:id="@+id/iv_add_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:riv_border_color="@color/translucent"
                app:riv_border_width="0dp"
                app:riv_corner_radius="0dp"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="0x7f0805b3"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:gravity="center_horizontal"
            android:id="@+id/rcv_preset_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/assist_10"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/device_custom_watch_face_tips"
        android:layout_marginStart="20dp"/>
</LinearLayout>
