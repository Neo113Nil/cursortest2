<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll"
        android:background="@drawable/shape_bg_private_policy_select_dialog"
        android:layout_width="320dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_pop_title"/>
        <View
            android:background="#d9d9d9"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <RelativeLayout
            android:id="@+id/ll_us"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">
            <ImageView
                android:id="@+id/iv_select_us"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080480"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/dark_grey"
                android:gravity="center_horizontal"
                android:id="@+id/tv_title_us"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="U.S."
                android:layout_alignTop="@+id/iv_select_us"
                android:layout_centerInParent="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/iv_select_us"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:id="@+id/tv_content_us"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="If you live in the United States, this Privacy Policy will apply. "
                android:layout_below="@+id/tv_title_us"
                android:layout_alignStart="@+id/tv_title_us"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ll_uk"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">
            <ImageView
                android:id="@+id/iv_select_uk"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080481"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/dark_grey"
                android:gravity="center_horizontal"
                android:id="@+id/tv_title_uk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EEA, UK and Switzerland"
                android:layout_alignTop="@+id/iv_select_uk"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/iv_select_uk"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:id="@+id/tv_content_uk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="If you live in the European Economic Area, United Kingdom, or Switzerland, this Privacy Policy will apply."
                android:layout_below="@+id/tv_title_uk"
                android:layout_alignStart="@+id/tv_title_uk"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ll_other"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">
            <ImageView
                android:id="@+id/iv_select_other"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080481"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/dark_grey"
                android:gravity="center_horizontal"
                android:id="@+id/tv_title_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other regions"
                android:layout_alignTop="@+id/iv_select_other"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/iv_select_other"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:id="@+id/tv_content_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="If you live outside of the United States, European Economic Area, United Kingdom, or Switzerland, this Privacy Policy will apply."
                android:layout_below="@+id/tv_title_other"
                android:layout_alignStart="@+id/tv_title_other"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ll_cn"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">
            <ImageView
                android:id="@+id/iv_select_cn"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080481"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/dark_grey"
                android:gravity="center_horizontal"
                android:id="@+id/tv_title_cn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中国"
                android:layout_alignTop="@+id/iv_select_cn"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/iv_select_cn"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:id="@+id/tv_content_cn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="此条法律适用于中国。"
                android:layout_below="@+id/tv_title_cn"
                android:layout_alignStart="@+id/tv_title_cn"/>
        </RelativeLayout>
        <View
            android:background="#d9d9d9"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#17e6d3"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_next"
            android:padding="25dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/done"/>
    </LinearLayout>
</FrameLayout>
