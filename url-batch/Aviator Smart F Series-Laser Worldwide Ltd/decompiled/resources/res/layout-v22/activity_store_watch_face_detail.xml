<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_title_back"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/selector_title_back"
        android:layout_marginStart="20dp"/>
    <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
        android:id="@+id/iv_watch_face_preview"
        android:layout_width="120dp"
        android:layout_height="140dp"
        android:layout_marginTop="26dp"
        android:layout_below="@+id/iv_title_back"
        android:layout_marginStart="26dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_watch_face_base"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/iv_watch_face_preview"
        android:layout_alignBottom="@+id/iv_watch_face_preview"
        android:layout_marginStart="26dp"
        android:layout_toEndOf="@+id/iv_watch_face_preview">
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/assist_12_22"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/assist_9_99"
            android:id="@+id/tv_file_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/assist_9_99"
            android:id="@+id/tv_downloads"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/assist_9_99"
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/assist_9_99"
            android:id="@+id/tv_designer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
    </LinearLayout>
    <View
        android:layout_marginTop="25dp"
        android:layout_below="@+id/iv_watch_face_preview"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/BorderView"/>
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/assist_12_22"
        android:id="@+id/tv_description_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/watch_face_description"
        android:layout_below="@+id/iv_watch_face_preview"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/assist_9_99"
        android:id="@+id/tv_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/tv_description_title"
        android:layout_marginHorizontal="20dp"/>
    <View
        android:layout_marginTop="14dp"
        android:layout_below="@+id/tv_description"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/BorderView"/>
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/assist_12_22"
        android:id="@+id/tv_similar_watch_faces_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:text="@string/watch_face_similar"
        android:layout_below="@+id/tv_description"
        android:layout_marginStart="20dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_watch_face"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/rl_operation"
        android:layout_below="@+id/tv_similar_watch_faces_title"
        android:overScrollMode="never"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="10dp"/>
    <RelativeLayout
        android:id="@+id/rl_operation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="34dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="52dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bg_1_ff"
            android:gravity="center"
            android:id="@+id/tv_is_downloaded"
            android:background="@drawable/shape_watch_face_downloaded"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/watch_face_btn_downloaded"
            android:paddingHorizontal="16dp"/>
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:id="@+id/shadow_skip_edit_watch_face"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            app:cornerRadius="22dp"
            app:shadowColor="@color/color_refresh"
            app:shadowRadius="8dp">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/bg_1_ff"
                android:gravity="center"
                android:id="@+id/tv_skip_edit_watch_face"
                android:background="@drawable/shape_watch_face_upload"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/watch_face_to_manage_watch_face"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:id="@+id/shadow_apply"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            app:cornerRadius="22dp"
            app:shadowColor="@color/color_refresh"
            app:shadowRadius="8dp">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/bg_1_ff"
                android:gravity="center"
                android:id="@+id/tv_apply"
                android:background="@drawable/shape_watch_face_upload"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/watch_face_btn_apply"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
        <ProgressBar
            android:id="@+id/pb_watch_face"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100"
            android:progressDrawable="@drawable/progressbar_horizontal_watch_face_upload"
            android:layout_alignTop="@+id/shadow_apply"
            style="@style/ProgressBarHorizontal"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/bg_1_ff"
            android:gravity="center"
            android:id="@+id/tv_upload_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="0%"
            android:layout_alignTop="@+id/shadow_apply"
            android:layout_alignStart="@+id/shadow_apply"
            android:layout_alignEnd="@+id/shadow_apply"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_net_error"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="54dp">
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="216dp"
            android:layout_height="150dp"
            android:layout_marginTop="172dp"
            android:src="@drawable/ic_net_error"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/rl_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/iv_icon"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="20dp">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/assist_9_99"
                android:gravity="center_horizontal"
                android:id="@+id/tv_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/net_disonnected_hint"
                android:layout_centerHorizontal="true"
                android:paddingStart="22dp"
                android:paddingEnd="0dp"/>
            <View
                android:id="@+id/no_wifi"
                android:background="0x7f08045d"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignTop="@+id/tv_tips"
                android:layout_marginEnd="-18dp"
                android:layout_toStartOf="@+id/tv_tips"/>
        </RelativeLayout>
        <Button
            android:textSize="18sp"
            android:textColor="@color/bg_1_ff"
            android:gravity="center"
            android:id="@+id/btn_refresh"
            android:background="@drawable/shape_watch_face_upload"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="206dp"
            android:text="@string/refresh"
            android:layout_below="@+id/rl_tips"
            android:textAllCaps="false"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="52dp"/>
    </RelativeLayout>
</RelativeLayout>
