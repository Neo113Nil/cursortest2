<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/wechat_sport_qr_code"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/shape_wechat_sport_bg"
        android:paddingLeft="20dp"
        android:paddingTop="7dp"
        android:paddingRight="20dp"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="7dp">
        <ImageView
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:src="0x7f0805d3"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wechat_qr_code_step1"
            android:layout_centerVertical="true"
            android:layout_marginStart="50dp"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        app:srcCompat="@drawable/ic_arrow_drop_down_vector"/>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/shape_wechat_sport_bg"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">
        <ImageView
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:src="0x7f0805d4"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wechat_qr_code_step2"
            android:layout_centerVertical="true"
            android:layout_marginStart="50dp"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        app:srcCompat="@drawable/ic_arrow_drop_down_vector"/>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/shape_wechat_sport_bg"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">
        <ImageView
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:src="0x7f0805d5"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wechat_qr_code_step3"
            android:layout_centerVertical="true"
            android:layout_marginStart="50dp"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        app:srcCompat="@drawable/ic_arrow_drop_down_vector"/>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/shape_wechat_sport_bg"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">
        <ImageView
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:src="0x7f0805d6"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wechat_qr_code_step4"
            android:layout_centerVertical="true"
            android:layout_marginStart="50dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/shape_qr_code_bg"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginTop="57dp">
        <ImageView
            android:id="@+id/iv_qr_code"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <Button
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_save_qr_code"
        android:background="@drawable/shape_save_qr_code"
        android:layout_width="100dp"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="40dp"
        android:text="@string/save_qr_code"
        android:stateListAnimator="@null"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
