<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_title_bar"
        layout="@layout/app_toolbar"/>
    <com.crrepa.band.my.health.widgets.MyNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/light_gray"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tl_hr_statistics_tab"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:paddingHorizontal="8dp"
                app:tabBackground="@color/color_temperature"
                app:tabIndicatorColor="@color/white"
                app:tabIndicatorHeight="3dp"
                app:tabRippleColor="@null"/>
            <com.crrepa.band.my.health.widgets.NoScrollViewPager
                android:id="@+id/vp_hr_statistics_content"
                android:layout_width="match_parent"
                android:layout_height="235dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="26dp"
                android:paddingEnd="26dp">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_temperature"/>
                <View
                    android:layout_marginTop="20dp"
                    style="@style/BorderView"/>
                <include
                    android:id="@+id/include_about_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp"
                    layout="@layout/view_about_temperature"/>
            </LinearLayout>
            <include
                android:id="@+id/include_last_7_times_trend"
                android:layout_width="match_parent"
                android:layout_height="266dp"
                android:layout_marginTop="20dp"
                layout="@layout/last_7_times_trend_view"/>
        </LinearLayout>
    </com.crrepa.band.my.health.widgets.MyNestedScrollView>
</LinearLayout>
