<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="124dp"
    android:layout_height="88dp"
    android:layout_marginEnd="4dp">
    <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
        android:id="@+id/iv_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:riv_corner_radius="8dp"/>
    <View
        android:background="@drawable/shape_recent_class_cover_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:src="@mipmap/ic_fitness_class_play"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/assist_4_ED"
        android:gravity="center"
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="8dp"
        android:drawablePadding="2dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="10dp"
        app:drawableStartCompat="@mipmap/ic_class_duration"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/assist_1_ff"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_above="@+id/tv_duration"
        android:layout_alignStart="@+id/tv_duration"/>
</RelativeLayout>
