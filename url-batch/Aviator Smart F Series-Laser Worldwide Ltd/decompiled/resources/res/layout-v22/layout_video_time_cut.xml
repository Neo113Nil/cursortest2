<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#111111"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_time_start"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_time_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_time_end"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/fl_thumb"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_below="@+id/tv_time_duration">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_vertical"
            android:id="@+id/rv_thumb"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginVertical="2dp"/>
        <ImageView
            android:id="@+id/iv_cursor"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:src="@drawable/shape_video_thumb_cursor"
            android:contentDescription="@null"
            android:layout_marginHorizontal="18dp"/>
        <com.crrepa.band.my.device.watchfacenew.video.widgets.TimeCutView
            android:layout_gravity="center_vertical"
            android:id="@+id/timeCutView"
            android:layout_width="match_parent"
            android:layout_height="54dp"/>
    </FrameLayout>
</RelativeLayout>
