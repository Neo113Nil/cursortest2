<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp">
    <ImageView
        android:id="@+id/iv_setting_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:id="@+id/tv_setting_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/iv_continue"/>
    <RelativeLayout
        android:gravity="start"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/tv_setting_hint"
        android:layout_toEndOf="@+id/iv_setting_icon">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:id="@+id/tv_setting_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/faqs_assist_6"
            android:gravity="center"
            android:id="@+id/tv_unread_news"
            android:background="@drawable/shape_user_setting_unread_news_bg"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:includeFontPadding="false"
            android:layout_centerInParent="true"
            android:layout_alignEnd="@+id/tv_setting_name"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:id="@+id/tv_setting_content"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_below="@+id/tv_setting_name"
            android:paddingVertical="2dp"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_continue"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <View
        android:layout_alignParentBottom="true"
        style="@style/BorderView"/>
</RelativeLayout>
