<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/appbar"
        layout="@layout/band_data_appbar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="160dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_13_00"
            android:id="@+id/tv_limit_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="@string/device_local_photo_explain_text"
            android:layout_toStartOf="@+id/tv_select_all"
            android:layout_marginHorizontal="10dp"/>
        <CheckBox
            android:id="@+id/cb_select_all"
            android:background="@drawable/selector_local_music_select_check"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:button="@null"
            android:layout_alignTop="@+id/tv_select_all"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_13_00"
            android:id="@+id/tv_select_all"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_select_all"
            android:layout_toStartOf="@+id/cb_select_all"/>
        <RelativeLayout
            android:id="@+id/rl_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tv_limit_tips">
            <ImageView
                android:id="@+id/iv_empty"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="100dp"
                android:src="0x7f0803a2"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_9_99"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_local_no_photo_tips_text"
                android:layout_below="@+id/iv_empty"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_below="@+id/tv_limit_tips"
            android:layout_marginHorizontal="10dp"/>
    </RelativeLayout>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/shadow_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        app:cornerRadius="22dp"
        app:shadowColor="@color/assist_6"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_add"
            android:background="@drawable/selector_common_bottom_btn"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/device_local_photo_btn_text"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/shadow_delete"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        app:cornerRadius="22dp"
        app:shadowColor="@color/app_market_1_uninstall"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_delete"
            android:background="@drawable/shape_app_market_unload"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/delete"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
