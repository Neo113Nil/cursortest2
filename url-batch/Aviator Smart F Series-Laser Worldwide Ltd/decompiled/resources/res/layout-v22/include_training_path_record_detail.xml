<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <ImageView
            android:id="@+id/iv_data_origin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_records_item_text"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/iv_data_origin"/>
        <ImageView
            android:id="@+id/iv_weather"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/tv_temp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_records_item_text"
            android:id="@+id/tv_temp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="3dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/rl_training_top_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">
        <TextView
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_distance_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_alignBottom="@+id/tv_distance"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/tv_distance"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/rl_speed_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_gps_finish_path_slow"
            android:id="@+id/tv_slow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_training_slow_title"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_gps_finish_path_fast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_training_fast_title"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@drawable/shape_gps_training_speed_progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="1dp"
            android:layout_below="@+id/tv_slow"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_training_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:nestedScrollingEnabled="false"/>
</LinearLayout>
