<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/shape_coach_content_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="1000dp">
        <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="282dp"
            android:scaleType="centerCrop"/>
        <RelativeLayout
            android:id="@+id/rl_course_msg"
            android:background="@color/bg_2_f7"
            android:paddingLeft="30dp"
            android:paddingTop="15dp"
            android:paddingRight="30dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_below="@+id/iv_cover"
            android:paddingHorizontal="30dp"
            android:paddingVertical="15dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_10_66"
                android:ellipsize="end"
                android:id="@+id/tv_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_toStartOf="@+id/tv_action_detail"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/assist_13_00"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:maxLines="2"
                android:layout_below="@+id/tv_progress"
                android:layout_toStartOf="@+id/tv_action_detail"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_1_ff"
                android:gravity="center"
                android:id="@+id/tv_action_detail"
                android:background="@drawable/shape_classes_assist_1_btn"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:text="@string/fitness_action_details_text"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="13dp"/>
        </RelativeLayout>
        <View
            android:id="@+id/view_center"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_alignTop="@+id/iv_stop"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="15dp"/>
        <ImageView
            android:id="@+id/iv_stop"
            android:background="@drawable/selector_btn_coach_stop"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="120dp"
            android:layout_below="@+id/rl_course_msg"
            android:layout_toStartOf="@+id/view_center"/>
        <ImageView
            android:id="@+id/iv_continue"
            android:background="@drawable/selector_btn_coach_play"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_alignTop="@+id/iv_stop"
            android:layout_toEndOf="@+id/view_center"/>
    </RelativeLayout>
</FrameLayout>
