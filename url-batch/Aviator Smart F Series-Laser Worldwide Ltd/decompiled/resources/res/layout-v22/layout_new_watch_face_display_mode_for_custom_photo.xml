<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:paddingHorizontal="20dp">
    <View style="@style/BorderView"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/assist_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/device_custom_watch_face_preview_mode"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_display_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <RadioButton
            android:textSize="14sp"
            android:textColor="@drawable/selector_watch_face_look_way_title_color"
            android:gravity="center"
            android:id="@+id/rb_display_mode_singleton"
            android:background="@drawable/selector_watch_face_look_way"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:checked="false"
            android:button="@null"
            android:text="@string/device_custom_watch_face_singleton_showing"/>
        <RadioButton
            android:textSize="14sp"
            android:textColor="@drawable/selector_watch_face_look_way_title_color"
            android:gravity="center"
            android:id="@+id/rb_display_mode_sequential"
            android:background="@drawable/selector_watch_face_look_way"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:checked="true"
            android:button="@null"
            android:text="@string/device_custom_watch_face_sequential_switching"
            android:layout_marginHorizontal="4dp"/>
        <RadioButton
            android:textSize="14sp"
            android:textColor="@drawable/selector_watch_face_look_way_title_color"
            android:gravity="center"
            android:id="@+id/rb_display_mode_stochastic"
            android:background="@drawable/selector_watch_face_look_way"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:checked="false"
            android:button="@null"
            android:text="@string/device_custom_watch_face_stochastic_switching"/>
    </RadioGroup>
</LinearLayout>
