<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_title_bar"
        layout="@layout/app_toolbar"/>
    <FrameLayout
        android:id="@+id/statistics_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <RelativeLayout
        android:id="@+id/band_measure_view"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_anchor="@+id/nsv_content"
        app:layout_anchorGravity="bottom">
        <Button
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:id="@+id/btn_band_measure"
            android:background="@drawable/shape_heart_rate_measure"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="52dp"
            android:layout_marginBottom="20dp"
            android:layout_centerInParent="true"
            android:stateListAnimator="@null"
            android:layout_marginHorizontal="52dp"
            android:layout_marginVertical="20dp"/>
    </RelativeLayout>
</LinearLayout>
