<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_bg_5_function"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/physicalt_bg_2_nav"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="20dp">
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0801df"
            android:layout_centerVertical="true"
            app:tint="@color/physicalt_assist_1_nav"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/physicalt_assist_1_nav"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/exercise_capacity"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@+id/iv_calendar"
            android:layout_toEndOf="@+id/iv_close"
            android:layout_marginHorizontal="20dp"/>
        <ImageView
            android:id="@+id/iv_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_calendar_w"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:tint="@color/physicalt_assist_1_nav"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="20dp">
        <RelativeLayout
            android:id="@+id/rl_fitness_age"
            android:background="@color/physical_bg_5_detail"
            android:paddingLeft="20dp"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:paddingBottom="18dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/assist_14"
                android:id="@+id/tv_fitness_age_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fitness_age"
                android:drawablePadding="6dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:layout_toStartOf="@+id/tv_fitness_age"
                android:layout_alignParentStart="true"
                app:drawableEndCompat="0x7f0801f7"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/physical_main_1_word"
                android:id="@+id/tv_fitness_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_fitness_level"
            android:background="@color/physical_bg_5_detail"
            android:paddingLeft="20dp"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:paddingBottom="18dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/assist_14"
                android:id="@+id/tv_fitness_level_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fitness_level"
                android:drawablePadding="6dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:layout_toStartOf="@+id/tv_fitness_level"
                android:layout_alignParentStart="true"
                app:drawableEndCompat="0x7f0801f7"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/physical_main_1_word"
                android:id="@+id/tv_fitness_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_vo2_max"
            android:background="@color/physical_bg_5_detail"
            android:paddingLeft="20dp"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/assist_14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vo2max"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:layout_toStartOf="@+id/tv_vo2max"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/physical_main_1_word"
                android:id="@+id/tv_vo2max"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="2dp"
                android:layout_toStartOf="@+id/tv_vo2max_unit"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/physical_main_1_word"
                android:id="@+id/tv_vo2max_unit"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="ml/kg/min"
                android:layout_alignBottom="@+id/tv_vo2max"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/iv_vo2max_continue"/>
            <ImageView
                android:id="@+id/iv_vo2max_continue"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="0x7f0801ec"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_lactate_threshold_hr"
            android:background="@color/physical_bg_5_detail"
            android:paddingLeft="20dp"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/assist_14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lactate_threshold_hr_title"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:layout_toStartOf="@+id/tv_lactate_threshold_hr"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/physical_main_1_word"
                android:id="@+id/tv_lactate_threshold_hr"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="2dp"
                android:layout_toStartOf="@+id/tv_lactate_threshold_hr_unit"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/physical_main_1_word"
                android:id="@+id/tv_lactate_threshold_hr_unit"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="bpm"
                android:layout_alignBottom="@+id/tv_lactate_threshold_hr"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/iv_lactate_threshold_hr_continue"/>
            <ImageView
                android:id="@+id/iv_lactate_threshold_hr_continue"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="0x7f0801ec"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_lactate_threshold_pace"
            android:background="@color/physical_bg_5_detail"
            android:paddingLeft="20dp"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/assist_14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lactate_threshold_pace_title"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:layout_toStartOf="@+id/tv_lactate_threshold_pace"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/physical_main_1_word"
                android:id="@+id/tv_lactate_threshold_pace"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/iv_lactate_threshold_pace_continue"/>
            <ImageView
                android:id="@+id/iv_lactate_threshold_pace_continue"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="0x7f0801ec"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
