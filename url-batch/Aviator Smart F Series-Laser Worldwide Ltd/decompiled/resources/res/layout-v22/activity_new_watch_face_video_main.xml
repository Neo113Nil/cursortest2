<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/main_bg_6_overall_1"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <ImageView
            android:id="@+id/iv_back"
            android:background="@drawable/selector_title_back"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_video_watch_face_title"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/rl_video"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_below="@+id/ll_title"
        android:layout_centerHorizontal="true"
        android:layout_marginVertical="20dp">
        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/iv_video_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
            android:id="@+id/iv_default_img"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            app:riv_corner_radius="20dp"/>
        <include
            android:id="@+id/include_time_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/layout_new_watch_face_time_preview"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/shadow_apply"
        android:layout_below="@+id/rl_video">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/include_video"
                layout="@layout/layout_new_watch_face_video_video_container"/>
            <include
                android:id="@+id/include_display_mode"
                layout="@layout/layout_new_watch_face_display_mode_for_video"/>
            <include
                android:id="@+id/include_time_style"
                layout="@layout/layout_new_watch_face_time_style"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:id="@+id/shadow_apply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="52dp"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="52dp"
        android:layout_marginVertical="20dp"
        app:cornerRadius="22dp"
        app:shadowColor="@color/main"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/bg_1_ff"
            android:gravity="center"
            android:id="@+id/tv_apply"
            android:background="@drawable/shape_watch_face_upload"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/watch_face_btn_apply"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
</RelativeLayout>
