<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/view_bottom">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_thumb"
                android:layout_width="match_parent"
                android:layout_height="282dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/assist_13_00"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/iv_thumb"
                android:layout_marginHorizontal="20dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_10_66"
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="16dp"
                android:layout_below="@+id/tv_title"
                android:layout_marginHorizontal="20dp"/>
            <View
                android:background="@color/bg_2_f7"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_below="@+id/tv_description"/>
            <com.moyoung.dafit.module.common.widgets.NoTouchRecyclerView
                android:id="@+id/rv_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/tv_description"/>
            <View
                android:background="@color/bg_2_f7"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_below="@+id/rv_action"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/assist_13_00"
                android:gravity="center"
                android:id="@+id/tv_postscript_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="20dp"
                android:text="@string/meditation_local_class_postscript_title"
                android:layout_below="@+id/rv_action"
                android:layout_marginHorizontal="20dp"/>
            <com.moyoung.dafit.module.common.widgets.NoTouchRecyclerView
                android:id="@+id/rv_postscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/tv_postscript_title"
                android:layout_marginHorizontal="20dp"/>
        </RelativeLayout>
    </ScrollView>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="56dp"
        android:src="0x7f0801e0"
        android:layout_marginStart="20dp"/>
    <View
        android:id="@+id/view_bottom"
        android:background="@color/bg_2_f7"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_above="@+id/sl_skip"/>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:id="@+id/sl_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:cornerRadius="22dp"
        app:shadowColor="@color/class_assist_1"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/assist_1_ff"
            android:gravity="center"
            android:id="@+id/tv_start"
            android:background="@drawable/shape_classes_assist_1_btn"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/meditation_class_start"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
</RelativeLayout>
