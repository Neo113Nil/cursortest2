<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_search"
        layout="@layout/include_local_music_search"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_songs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/include_search">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_9_99"
            android:id="@+id/tv_selected_tag_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="12dp"/>
        <View
            android:id="@+id/line_selected_tag_title"
            android:visibility="gone"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginHorizontal="20dp"
            style="@style/BorderView"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <include
        android:id="@+id/include_no_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/include_search"
        layout="@layout/include_local_music_select_empty"/>
</RelativeLayout>
