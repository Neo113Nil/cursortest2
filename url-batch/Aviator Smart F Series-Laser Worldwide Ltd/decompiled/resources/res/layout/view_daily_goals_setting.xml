<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:id="@+id/tv_daily_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/steps"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
            android:id="@+id/wp_daily_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/tv_step_unit"
            app:picker_show_wheel="show"/>
        <TextView
            android:textColor="@color/color_goal_type_text"
            android:id="@+id/tv_step_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View style="@style/BorderView"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:id="@+id/tv_daily_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/goal_type_calories"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
            android:id="@+id/wp_daily_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/tv_calories_unit"
            app:picker_show_wheel="show"/>
        <TextView
            android:textColor="@color/color_goal_type_text"
            android:id="@+id/tv_calories_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calorie_unit"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View style="@style/BorderView"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:id="@+id/tv_daily_exercise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/goal_type_exercise"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
            android:id="@+id/wp_daily_training_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/tv_exercise_hour_unit"
            app:picker_show_wheel="show"/>
        <TextView
            android:textColor="@color/color_goal_type_text"
            android:id="@+id/tv_exercise_hour_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/goal_hour_unit"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/wp_daily_training_min"/>
        <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
            android:id="@+id/wp_daily_training_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/tv_exercise_min_unit"
            app:picker_show_wheel="show"/>
        <TextView
            android:textColor="@color/color_goal_type_text"
            android:id="@+id/tv_exercise_min_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/goal_minute_unit"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
