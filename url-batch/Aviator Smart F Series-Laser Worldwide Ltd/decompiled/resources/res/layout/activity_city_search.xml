<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/search_city_title"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_search_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp">
        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchview"
            android:background="@drawable/shape_net_city_search"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            app:closeIcon="0x7f0801db"
            app:iconifiedByDefault="false"
            app:queryBackground="@null"
            app:searchIcon="0x7f08047c"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_city_list"
        android:background="@color/color_city_search_activity_bg"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/ll_search_view"
        android:overScrollMode="never"/>
</RelativeLayout>
