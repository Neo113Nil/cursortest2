<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/appbar"
        layout="@layout/band_data_appbar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_user_info"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/appbar"
        android:overScrollMode="never"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:layout_gravity="bottom|center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        app:cornerRadius="22dp"
        app:shadowColor="@color/main"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_done"
            android:background="@drawable/shape_private_policy_agree"
            android:visibility="gone"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/done"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
