<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/shape_weight_dialog_bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/black"
        android:id="@+id/tv_calender_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textAlignment="center"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/color_water_calendar_tip"
        android:id="@+id/tv_calender_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/water_notification_request_content"
        android:layout_below="@+id/tv_calender_title"
        android:textAlignment="center"/>
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/assist_12_22"
        android:gravity="center"
        android:id="@+id/tv_calender_refuse"
        android:background="@drawable/shape_calendar_permission_btn_bg"
        android:layout_width="270dp"
        android:layout_height="44dp"
        android:layout_marginTop="47dp"
        android:text="@string/water_calendar_refuse"
        android:layout_below="@+id/tv_calender_tip"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"/>
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_calender_go_setting"
        android:background="0x7f0800e4"
        android:layout_width="302dp"
        android:layout_height="76dp"
        android:text="@string/water_notification_request_go_setting"
        android:layout_below="@+id/tv_calender_refuse"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"/>
</RelativeLayout>
