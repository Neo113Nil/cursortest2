<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_root_view"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <ImageView
            android:id="@+id/iv_title_back"
            android:background="@drawable/selector_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_watch_face"
            android:layout_alignTop="@+id/iv_title_back"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/main"
            android:gravity="center_horizontal"
            android:id="@+id/tv_history"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_picture_history_btn_text"
            android:layout_alignTop="@+id/iv_title_back"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
        android:id="@+id/iv_ai_picture"
        android:layout_width="155dp"
        android:layout_height="180dp"
        android:layout_marginTop="50dp"
        android:layout_below="@+id/title_bar"
        android:layout_centerHorizontal="true"
        app:riv_corner_radius="20dp"/>
    <com.moyoung.dafit.module.common.widgets.GifImageView
        android:id="@+id/gif_loading"
        android:visibility="gone"
        android:layout_width="155dp"
        android:layout_height="155dp"
        android:layout_alignTop="@+id/iv_ai_picture"
        android:layout_alignStart="@+id/iv_ai_picture"
        android:layout_alignEnd="@+id/iv_ai_picture"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_ai_service_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:layout_alignTop="@+id/iv_ai_picture"
        android:layout_alignStart="@+id/iv_ai_picture"
        android:layout_alignEnd="@+id/iv_ai_picture">
        <ImageView
            android:id="@+id/iv_ai_service_error"
            android:layout_width="62dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_ai_watchface_noserve"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_1_ff"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/ai_picture_error_serve_busy"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/assist_9_99"
        android:id="@+id/tv_drawing_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/ai_drawing_style_title"
        android:layout_below="@+id/iv_ai_picture"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_14"
        android:gravity="center"
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="20dp"
        android:text="@string/ai_picture_home_default_title_text"
        android:layout_below="@+id/tv_drawing_style"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_operation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="50dp"
        android:layout_alignParentBottom="true">
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:id="@+id/shadow_retry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cornerRadius="22dp"
            app:shadowColor="@color/assist_5_D9"
            app:shadowRadius="8dp">
            <Button
                android:textSize="18sp"
                android:textColor="@color/white"
                android:id="@+id/btn_retry"
                android:background="@drawable/shape_ai_picture_cancel"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/retry"
                android:textAllCaps="false"
                style="?android:attr/borderlessButtonStyle"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
        <View
            android:layout_width="15dp"
            android:layout_height="1dp"/>
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:id="@+id/shadow_save_disable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cornerRadius="22dp"
            app:shadowColor="@color/assist_5_D9"
            app:shadowRadius="8dp">
            <Button
                android:textSize="18sp"
                android:textColor="@color/white"
                android:id="@+id/btn_save_disable"
                android:background="@drawable/shape_ai_picture_cancel"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/save"
                android:textAllCaps="false"
                style="?android:attr/borderlessButtonStyle"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:id="@+id/shadow_save"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cornerRadius="22dp"
            app:shadowColor="@color/main"
            app:shadowRadius="8dp">
            <Button
                android:textSize="18sp"
                android:textColor="@color/white"
                android:id="@+id/btn_save"
                android:background="@drawable/shape_ai_picture_commit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/save"
                android:textAllCaps="false"
                style="?android:attr/borderlessButtonStyle"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
    </LinearLayout>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:id="@+id/shadow_edit_watch_face"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:cornerRadius="22dp"
        app:shadowColor="@color/main"
        app:shadowRadius="8dp">
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:id="@+id/btn_edit_watch_face"
            android:background="@drawable/shape_ai_picture_commit"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/ai_picture_edit_to_download_btn_title"
            android:layout_centerHorizontal="true"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
</RelativeLayout>
