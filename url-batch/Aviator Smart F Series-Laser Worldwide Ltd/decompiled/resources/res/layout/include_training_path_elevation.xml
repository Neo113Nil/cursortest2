<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_elevation_chart"
    android:background="@color/white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/bg_2_f7"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/gps_training_elevation_subtitle"
        android:textAllCaps="false"
        android:layout_marginStart="20dp"
        style="@style/SubTitle"/>
    <View
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        style="@style/BorderView"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/assist_11_33"
                android:id="@+id/tv_lowest_elevation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7&apos;40"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_11_33"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/gps_result_min_elevation_subtitle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/assist_11_33"
                android:id="@+id/tv_average_elevation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7&apos;40"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_11_33"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/gps_result_avg_elevation_subtitle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/assist_11_33"
                android:id="@+id/tv_highest_elevation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2&apos;40"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_11_33"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/gps_result_maxHeight_elevation_subtitle"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_elevation_cumulative"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/assist_11_33"
                android:gravity="center_horizontal"
                android:id="@+id/tv_gain_cumulative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="740"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_11_33"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/training_cumulative_gain"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/assist_11_33"
                android:gravity="center_horizontal"
                android:id="@+id/tv_loss_cumulative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="240"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_11_33"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/training_cumulative_loss"/>
        </LinearLayout>
    </LinearLayout>
    <com.moyoung.dafit.module.common.widgets.chart.CrpLineChart
        android:id="@+id/chart_elevation"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="8dp"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="22dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/tv_start_time"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/tv_end_time_tips"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_end_time_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_end"
            android:layout_marginStart="5dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
