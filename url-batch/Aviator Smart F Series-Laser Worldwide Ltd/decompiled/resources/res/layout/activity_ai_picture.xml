<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_root_view"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <ImageView
            android:id="@+id/iv_title_back"
            android:background="@drawable/selector_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_watch_face"
            android:maxLines="1"
            android:layout_alignTop="@+id/iv_title_back"
            android:layout_centerHorizontal="true"
            android:layout_toStartOf="@+id/tv_history"
            android:layout_toEndOf="@+id/iv_title_back"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/main"
            android:gravity="center_horizontal"
            android:id="@+id/tv_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_picture_history_btn_text"
            android:layout_alignTop="@+id/iv_title_back"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_above="@+id/include_asr_input"
        android:layout_below="@+id/title_bar">
        <RelativeLayout
            android:id="@+id/rl_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
                android:id="@+id/iv_ai_picture"
                android:layout_width="120dp"
                android:layout_height="140dp"
                android:layout_marginStart="26dp"
                app:riv_corner_radius="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_ai_picture_msg"
                android:layout_width="wrap_content"
                android:layout_height="140dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_alignTop="@+id/iv_ai_picture"
                android:layout_alignBottom="@+id/iv_ai_picture"
                android:layout_toEndOf="@+id/iv_ai_picture">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/assist_13_00"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_picture_home_default_title_text"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/assist_9_99"
                    android:id="@+id/tv_picture_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ai_picture_home_default_example_text"/>
            </LinearLayout>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/assist_13_00"
                android:id="@+id/tv_drawing_style_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/ai_drawing_style_title"
                android:layout_below="@+id/iv_ai_picture"
                android:layout_marginStart="20dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_9_99"
                android:id="@+id/tv_drawing_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:text="@string/ai_drawing_style_text"
                android:layout_below="@+id/tv_drawing_style_title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_picture"
                android:scrollbars="none"
                android:fadingEdge="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_below="@+id/tv_drawing_style"
                android:overScrollMode="never"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:id="@+id/rl_question_tips"
        android:background="#33000000"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/include_asr_input">
        <LinearLayout
            android:background="@drawable/shape_ai_chat_box"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/assist_11_33"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try asking me that:"/>
        </LinearLayout>
    </RelativeLayout>
    <include
        android:id="@+id/include_asr_input"
        layout="@layout/layout_asr_input"/>
</RelativeLayout>
