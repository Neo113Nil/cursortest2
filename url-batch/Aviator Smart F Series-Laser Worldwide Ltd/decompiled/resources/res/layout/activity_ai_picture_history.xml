<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_1_ff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <ImageView
            android:id="@+id/iv_title_back"
            android:background="@drawable/selector_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_picture_ai_watch_face_history_title"
            android:maxLines="1"
            android:layout_alignTop="@+id/iv_title_back"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <com.yanzhenjie.recyclerview.SwipeRecyclerView
        android:id="@+id/rv_picture"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
</LinearLayout>
