<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        app:cardElevation="@dimen/today_card_elevation"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        style="@style/BandDataCardView">
        <include layout="@layout/today_sync_data"/>
        <com.moyoung.dafit.module.common.widgets.chart.CrpBarChart
            android:id="@+id/stress_bar_chart"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:layout_marginTop="94dp"/>
        <com.crrepa.band.my.health.widgets.DayAxisTimeView
            android:id="@+id/day_axis_time_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="196dp"
            android:layout_marginBottom="@dimen/today_card_margin_bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <include
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/include_no_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/today_card_margin_top"
            android:layout_marginBottom="@dimen/today_card_margin_bottom"
            layout="@layout/not_data_hint_view"/>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/iv_data_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="0x7f0802a1"
        android:layout_marginStart="@dimen/main_page_card_margin_start"
        android:stateListAnimator="@drawable/selector_elevation"/>
</RelativeLayout>
