<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="20dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/assist_13_00"
                android:id="@+id/tv_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/classes_recent_title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="14dp"/>
        </LinearLayout>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            app:tabIndicator="@null"
            app:tabIndicatorColor="@color/class_assist_1"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorHeight="3dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/assist_13_00"
            app:tabTextAppearance="@style/TabWidget"
            app:tabTextColor="@color/assist_7_B3"/>
        <com.moyoung.dafit.module.common.widgets.NestedViewPager
            android:id="@+id/vp_class"
            android:paddingTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
