<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_about_temperature_bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textStyle="bold"
        android:textColor="@color/color_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/learn_temperature"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/color_temperature"
        android:id="@+id/tv_normal_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/normal_temperature"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/color_temperature"
        android:id="@+id/tv_fever_grade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/fever_grade"
        android:includeFontPadding="false"
        android:lineSpacingExtra="6dp"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/color_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/temperature_description"
        android:includeFontPadding="false"
        android:lineSpacingExtra="6dp"/>
</LinearLayout>
