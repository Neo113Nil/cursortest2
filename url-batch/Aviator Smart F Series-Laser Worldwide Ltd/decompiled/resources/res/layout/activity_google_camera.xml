<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.cameraview.CameraView
        android:id="@+id/camera_view"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:autoFocus="true"
        app:facing="back"
        app:flash="auto"/>
    <ImageView
        android:id="@+id/iv_help_take_photos"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"
        app:srcCompat="0x7f080483"/>
    <ImageView
        android:id="@+id/iv_flash"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="10dp"
        app:srcCompat="@drawable/ic_flash_auto"/>
    <TextView
        android:textSize="60sp"
        android:textColor="@color/light_teal"
        android:id="@+id/tv_camera_count_down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/camera_view"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp">
        <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
            android:id="@+id/iv_history_preview"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            app:riv_corner_radius="6dp"/>
        <ImageView
            android:id="@+id/iv_shutter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0800e3"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_switch_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080479"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
