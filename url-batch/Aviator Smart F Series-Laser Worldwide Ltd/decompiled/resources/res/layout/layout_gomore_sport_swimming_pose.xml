<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_gomore_sport_swimming_pose"
    android:background="@color/running_bg_3_detail"
    android:paddingLeft="26dp"
    android:paddingRight="26dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_14"
        android:id="@+id/tv_swimming_pose_title"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/swim_stroke_recognition"
        android:drawablePadding="6dp"
        app:drawableEndCompat="0x7f0801f7"/>
    <View style="@style/BorderView"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/swim_style_front_crawl"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/tv_swim_style_front_crawl"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/assist_12"
            android:id="@+id/tv_swim_style_front_crawl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/tv_swim_style_front_crawl_unit"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/assist_12"
            android:id="@+id/tv_swim_style_front_crawl_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="2dp"
            android:text="%"
            android:layout_alignBottom="@+id/tv_swim_style_front_crawl"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View style="@style/BorderView"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/swim_style_breaststroke"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/tv_swim_style_breaststroke"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/assist_12"
            android:id="@+id/tv_swim_style_breaststroke"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/tv_swim_style_breaststroke_unit"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/assist_12"
            android:id="@+id/tv_swim_style_breaststroke_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="2dp"
            android:text="%"
            android:layout_alignBottom="@+id/tv_swim_style_breaststroke"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View style="@style/BorderView"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/swim_style_backstroke"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/tv_swim_style_backstroke"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/assist_12"
            android:id="@+id/tv_swim_style_backstroke"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/tv_swim_style_backstroke_unit"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/assist_12"
            android:id="@+id/tv_swim_style_backstroke_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="2dp"
            android:text="%"
            android:layout_alignBottom="@+id/tv_swim_style_backstroke"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View style="@style/BorderView"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/swim_style_butterfly"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/tv_swim_style_swim_style_butterfly"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/assist_12"
            android:id="@+id/tv_swim_style_swim_style_butterfly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/tv_swim_style_swim_style_butterfly_unit"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/assist_12"
            android:id="@+id/tv_swim_style_swim_style_butterfly_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="2dp"
            android:text="%"
            android:layout_alignBottom="@+id/tv_swim_style_swim_style_butterfly"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View style="@style/BorderView"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/swim_type_title"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/tv_swim_type"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/assist_12"
            android:id="@+id/tv_swim_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
