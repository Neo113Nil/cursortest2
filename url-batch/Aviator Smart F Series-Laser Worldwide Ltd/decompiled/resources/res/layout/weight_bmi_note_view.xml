<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_weight_bmi_note"
    android:background="@drawable/shape_weight_bmi_note_bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textStyle="bold"
        android:textColor="@color/color_weight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/weight_bmi_note_title"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/color_weight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/weight_bmi_note_description_one"
        android:lineSpacingExtra="6dp"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/color_weight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/weight_bmi_note_description_two"
        android:lineSpacingExtra="6dp"/>
</LinearLayout>
