<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/top_bar"
        layout="@layout/band_data_appbar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp">
            <RelativeLayout
                android:id="@+id/rl_calculate_method"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:id="@+id/tv_calculate_method_title"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="@string/muslim_pray_calc_method"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/grey"
                    android:gravity="end"
                    android:id="@+id/tv_calculate_method"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/iv_continue"
                    android:layout_toEndOf="@+id/tv_calculate_method_title"/>
                <ImageView
                    android:id="@+id/iv_continue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f0801ed"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <View
                    android:layout_alignParentBottom="true"
                    style="@style/BorderView"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_asr_juristic_method"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:id="@+id/tv_asr_juristic_method_title"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="@string/muslim_pray_asr_juristic_method"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/grey"
                    android:gravity="end"
                    android:id="@+id/tv_asr_juristic_method"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/iv_asr_continue"
                    android:layout_toEndOf="@+id/tv_asr_juristic_method_title"/>
                <ImageView
                    android:id="@+id/iv_asr_continue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f0801ed"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <View
                    android:layout_alignParentBottom="true"
                    style="@style/BorderView"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_prayer_compensation"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/assist_14"
                    android:id="@+id/tv_prayer_compensation_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/muslim_prayer_compensation"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/assist_10"
                    android:gravity="end"
                    android:id="@+id/tv_prayer_compensation_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/iv_prayer_compensation_continue"
                    android:layout_toEndOf="@+id/tv_prayer_compensation_title"/>
                <ImageView
                    android:id="@+id/iv_prayer_compensation_continue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f0801ed"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <View
                    android:layout_alignParentBottom="true"
                    style="@style/BorderView"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_reminder"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:id="@+id/tv_function_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/muslim_pray_time_reminder_setting_title"
                    android:layout_centerVertical="true"/>
                <com.crrepa.band.my.device.muslim.view.SwitchButton
                    android:id="@+id/sbtn_prayer_reminder"
                    android:layout_width="44dp"
                    android:layout_height="30dp"
                    app:kswAnimationDuration="300"
                    app:kswBackDrawable="@drawable/muslim_switch_button_back_color"
                    app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbMargin="1dp"
                    app:kswThumbWidth="28dp"
                    style="@style/SwitchButoonStyle"/>
                <View
                    android:layout_alignParentBottom="true"
                    style="@style/BorderView"/>
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_muslim_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
