<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20dp"
    android:layout_marginTop="60dp"
    android:layout_marginRight="20dp"
    android:layout_marginBottom="60dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/assist_15"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textStyle="bold"
            android:gravity="end"
            android:id="@+id/tv_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick Up/Expanded"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Debug Model"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_provider_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_provider_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Provider: "/>
                <Spinner
                    android:id="@+id/spinner_provider_type"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_firmware_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_mac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_is_mac_authorized"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_is_oversea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_is_stream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_elapsed_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/tv_watch_callback_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:textIsSelectable="true"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_req"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_resp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
