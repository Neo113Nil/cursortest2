<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <TextView
            android:id="@+id/tv_cancel"
            android:background="@drawable/selector_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch_face_edit"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:gravity="end"
            android:id="@+id/tv_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <RelativeLayout
            android:id="@+id/start_time"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:text="@string/start_time"
                style="@style/SettingItemText"/>
            <include
                android:id="@+id/display_start_time"
                layout="@layout/continue_arrow"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:id="@+id/tv_start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:layout_toStartOf="@+id/display_start_time"/>
        </RelativeLayout>
        <View style="@style/BorderView"/>
        <RelativeLayout
            android:id="@+id/end_time"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:text="@string/end_time"
                style="@style/SettingItemText"/>
            <include
                android:id="@+id/display_end_time"
                layout="@layout/continue_arrow"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:id="@+id/tv_end_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:layout_toStartOf="@+id/display_end_time"/>
        </RelativeLayout>
        <View style="@style/BorderView"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tv_do_not_disturb_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:text="@string/do_not_disturb_hint"/>
</LinearLayout>
