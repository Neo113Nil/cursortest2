<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_root_view"
    android:background="0x7f08008b"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_back"
            android:background="@drawable/selector_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_assistant_title"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_title_arrow"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0801f9"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/tv_title"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/main"
            android:gravity="end"
            android:id="@+id/tv_new_topic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_new_topic_title"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="18dp"
            android:layout_toEndOf="@+id/tv_title"
            android:layout_alignParentEnd="true"/>
        <View
            android:id="@+id/debug_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/tv_title"
            android:layout_alignBottom="@+id/tv_title"
            android:layout_toStartOf="@+id/tv_title"
            android:layout_toEndOf="@+id/tv_back"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_records"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_above="@+id/include_asr_input"
        android:layout_below="@+id/rl_title"/>
    <include
        android:id="@+id/include_asr_input"
        layout="@layout/layout_asr_input"/>
</RelativeLayout>
