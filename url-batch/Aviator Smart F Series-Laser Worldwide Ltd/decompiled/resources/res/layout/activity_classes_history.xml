<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@color/class_assist_1"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <ImageView
            android:id="@+id/iv_title_back"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="3dp"
            android:src="0x7f0801e0"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/assist_1_ff"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fitness_class_records_title"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <FrameLayout
        android:background="@color/class_assist_1"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tb_records"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            app:tabIndicatorColor="@color/assist_1_ff"
            app:tabIndicatorHeight="3dp"
            app:tabRippleColor="@null"
            app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
            app:tabTextColor="@color/assist_1_ff"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/class_assist_1"
        android:paddingTop="22dp"
        android:paddingBottom="33dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="30dp"
        android:paddingEnd="30dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_1_ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/classes_record_total_time"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="50sp"
                android:textStyle="bold"
                android:textColor="@color/assist_1_ff"
                android:id="@+id/tv_total_spent_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_1_ff"
                android:id="@+id/tv_time_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/meditation_class_duration_unit"
                android:layout_alignBottom="@+id/tv_total_spent_time"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/tv_total_spent_time"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_1_ff"
                    android:id="@+id/tv_total_times_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/classes_record_total_times"/>
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/assist_1_ff"
                    android:id="@+id/tv_total_times"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:includeFontPadding="false"
                    android:layout_below="@+id/tv_total_times_title"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_1_ff"
                    android:id="@+id/tv_times_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:text="@string/classes_record_times"
                    android:layout_alignBottom="@+id/tv_total_times"
                    android:layout_marginStart="3dp"
                    android:layout_toEndOf="@+id/tv_total_times"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="90dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_1_ff"
                    android:id="@+id/tv_total_kcal_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/classes_record_total_kcal"/>
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/assist_1_ff"
                    android:id="@+id/tv_total_spent_kcal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:includeFontPadding="false"
                    android:layout_below="@+id/tv_total_kcal_title"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_1_ff"
                    android:id="@+id/tv_calories_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:text="@string/classes_calorie_unit"
                    android:layout_alignBottom="@+id/tv_total_spent_kcal"
                    android:layout_marginStart="3dp"
                    android:layout_toEndOf="@+id/tv_total_spent_kcal"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_history"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
</LinearLayout>
