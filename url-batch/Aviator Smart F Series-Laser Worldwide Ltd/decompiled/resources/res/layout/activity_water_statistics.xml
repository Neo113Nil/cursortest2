<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_water_statistics"
    android:background="@color/color_water"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/water_statistics_bar"
        layout="@layout/app_toolbar"/>
    <com.crrepa.band.my.health.widgets.MyNestedScrollView
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rl_water_data"
                android:background="@color/color_water"
                android:paddingBottom="26dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_water_total_intake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="@dimen/text_size_40"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_water_total_intake"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/tv_water_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_water_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ll_water_total_intake"
                    android:layout_centerHorizontal="true"/>
                <com.crrepa.band.my.health.widgets.WaveView
                    android:id="@+id/wv_water"
                    android:background="0x7f0808a0"
                    android:layout_width="129dp"
                    android:layout_height="172dp"
                    android:layout_marginTop="104dp"
                    android:layout_centerHorizontal="true"
                    app:behind_wave_color="@color/color_water_wave_behind"
                    app:front_wave_color="@color/color_water_wave_front"/>
                <TextView
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_water_percentage"
                    android:id="@+id/tv_water_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:layout_alignBottom="@+id/wv_water"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_water_percentage_note"
                    android:id="@+id/tv_water_percentage_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_below="@+id/wv_water"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_water_add_intake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:layout_below="@+id/tv_water_percentage_note"
                    android:layout_centerHorizontal="true">
                    <LinearLayout
                        android:theme="@style/RippleWhite"
                        android:orientation="vertical"
                        android:id="@+id/ll_water_add_intake_100"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_marginEnd="24dp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f08089d"
                            android:layout_marginStart="18dp"
                            android:layout_marginEnd="18dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/tv_water_add_intake_100"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:theme="@style/RippleWhite"
                        android:orientation="vertical"
                        android:id="@+id/ll_water_add_intake_200"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_marginEnd="24dp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f08089e"
                            android:layout_marginStart="18dp"
                            android:layout_marginEnd="18dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/tv_water_add_intake_200"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:theme="@style/RippleWhite"
                        android:orientation="vertical"
                        android:id="@+id/ll_water_add_intake_400"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?android:attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f08089f"
                            android:layout_marginStart="18dp"
                            android:layout_marginEnd="18dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/tv_water_add_intake_400"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="17.6sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_water"
                    android:gravity="center"
                    android:id="@+id/tv_add_water"
                    android:background="@drawable/shape_water_btn_bg"
                    android:layout_width="200dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/water_add"
                    android:layout_below="@+id/ll_water_add_intake"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_water_records"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_water_record_title"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/water_record_title"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rl_water_no_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="29dp"
                    android:layout_below="@+id/tv_water_record_title"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:id="@+id/iv_water_no_record"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080646"
                        android:layout_centerHorizontal="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/grey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="42dp"
                        android:text="@string/water_did_not_drink_tip"
                        android:layout_below="@+id/iv_water_no_record"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <com.yanzhenjie.recyclerview.SwipeRecyclerView
                android:id="@+id/rcv_water_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.crrepa.band.my.health.widgets.MyNestedScrollView>
</LinearLayout>
