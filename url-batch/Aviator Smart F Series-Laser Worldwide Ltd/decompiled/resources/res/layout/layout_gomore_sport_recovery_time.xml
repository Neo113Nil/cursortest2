<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_gomore_sport_recovery_time"
    android:background="@color/running_bg_3_detail"
    android:paddingLeft="26dp"
    android:paddingRight="26dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_14"
        android:id="@+id/tv_recovery_time_title"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/training_recovery_time"
        android:drawablePadding="6dp"
        app:drawableEndCompat="0x7f0801f7"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_14"
        android:id="@+id/tv_recovery_time"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
