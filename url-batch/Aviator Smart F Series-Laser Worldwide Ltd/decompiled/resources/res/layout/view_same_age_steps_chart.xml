<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_step_compared_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/grey"
        android:id="@+id/tv_same_age_gender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/compared_same_age_group"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"/>
    <com.moyoung.dafit.module.common.widgets.chart.CrpBarChart
        android:id="@+id/step_same_group_compared_chart"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/step_3000"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/step_6000"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/step_9000"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/step_12000"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/step_15000"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/step_18000"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/step_max"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
