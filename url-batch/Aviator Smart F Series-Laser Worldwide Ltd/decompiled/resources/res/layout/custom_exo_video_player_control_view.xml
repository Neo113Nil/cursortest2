<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exo_controller"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_exo_controller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="20dp">
        <View
            android:id="@+id/view_close"
            android:background="@mipmap/ic_video_close"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_full_screen"
            android:background="@mipmap/ic_video_full_screen"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffbebebe"
            android:id="@+id/exo_position"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:includeFontPadding="false"
            android:layout_above="@+id/rl_time_bar"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@+id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_above="@+id/rl_time_bar"
            android:layout_alignParentEnd="true"/>
        <RelativeLayout
            android:id="@+id/rl_time_bar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <com.moyoung.classes.coach.widget.CustomExoPlayerTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:bar_height="80dp"
                app:buffered_color="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:played_color="@color/class_assist_1"
                app:unplayed_color="@color/assist_1_ff_33"/>
            <ImageView
                android:id="@+id/exo_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/btn_exo_video_play"
                android:layout_centerInParent="true"
                android:contentDescription="@null"/>
            <ImageView
                android:id="@+id/exo_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/btn_exo_video_prev"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:layout_marginStart="50dp"/>
            <ImageView
                android:id="@+id/exo_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/btn_exo_video_next"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:layout_marginEnd="50dp"
                android:layout_alignParentEnd="true"/>
            <ImageView
                android:id="@+id/exo_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/btn_exo_video_pause"
                android:layout_centerInParent="true"
                android:contentDescription="@null"/>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
