<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="164dp"
    android:layout_height="116dp"
    android:layout_marginEnd="12dp">
    <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
        android:id="@+id/iv_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:riv_corner_radius="8dp"/>
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/assist_1_ff"
        android:id="@+id/tv_level"
        android:background="@drawable/shape_coach_level_lv0"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/assist_1_ff"
        android:id="@+id/tv_duration"
        android:background="@drawable/shape_coach_duration_bg"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="x min"
        android:layout_alignTop="@+id/tv_level"
        android:layout_alignBottom="@+id/tv_level"
        android:layout_marginStart="2dp"
        android:layout_toEndOf="@+id/tv_level"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/assist_1_ff"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxLines="2"
        android:layout_above="@+id/tv_level"
        android:layout_marginEnd="12dp"
        android:layout_alignStart="@+id/tv_level"/>
</RelativeLayout>
