<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/heart_rate_description"
    android:background="@drawable/shape_active_heart_rate_bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textStyle="bold"
        android:textColor="@color/color_heart_rate"
        android:id="@+id/tv_find_heart_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/find_heart_rate"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/color_heart_rate"
        android:id="@+id/tv_resting_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/resting_description"
        android:lineSpacingExtra="6dp"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/color_heart_rate"
        android:id="@+id/tv_active_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/active_description"
        android:lineSpacingExtra="6dp"/>
</LinearLayout>
