<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="26dp"
    android:paddingEnd="26dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/dark_grey"
        android:gravity="center_vertical"
        android:id="@+id/tv_weight_day"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
    <RelativeLayout
        android:id="@+id/rl_weight_record"
        android:layout_width="match_parent"
        android:layout_height="62dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/text_size_26"
                android:textStyle="bold"
                android:textColor="@color/color_weight"
                android:id="@+id/tv_weight_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_weight_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_weight_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="22dp"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_continue"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View style="@style/BorderView"/>
</LinearLayout>
