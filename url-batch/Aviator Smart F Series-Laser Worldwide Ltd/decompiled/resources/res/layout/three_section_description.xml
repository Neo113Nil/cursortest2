<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/sleep_degree_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_first_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_first_section"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/shape_restful"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_first_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/restful"
            android:lines="2"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_second_section"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/shape_light"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_second_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/light"
            android:lines="2"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_third_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_third_section"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/shape_awake"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_third_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/awake"
            android:lines="2"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
