<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_water_remind"
    android:background="@color/color_water_reminder_bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/shape_water_reminder_dialog_bg"
        android:padding="20dp"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lav_drink_once_animation"
            android:layout_width="114dp"
            android:layout_height="114dp"
            android:layout_marginTop="2dp"
            android:layout_centerHorizontal="true"
            app:lottie_autoPlay="false"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lav_drink_circulate_animation"
            android:layout_width="114dp"
            android:layout_height="114dp"
            android:layout_marginTop="2dp"
            android:layout_centerHorizontal="true"
            app:lottie_autoPlay="false"/>
        <TextView
            android:textSize="@dimen/text_size_40"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_drink_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/lav_drink_once_animation"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_drink_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_drink_total"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/assist_12_22"
            android:id="@+id/tv_drink_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_below="@+id/tv_drink_goal"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_below="@+id/tv_drink_tip"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                android:textColor="@color/assist_12_22"
                android:gravity="center"
                android:id="@+id/tv_got_it"
                android:background="@drawable/shape_dialog_delete_confirm_cancel"
                android:layout_width="110dp"
                android:layout_height="38dp"
                android:text="@string/water_got_it"
                android:textAlignment="center"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_go_drink"
                android:background="@drawable/shape_dialog_water_reminder_drink"
                android:layout_width="110dp"
                android:layout_height="38dp"
                android:text="@string/water_let_us_drink"
                android:textAlignment="center"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
