<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        app:cardElevation="@dimen/today_card_elevation"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        style="@style/BandDataCardView">
        <include layout="@layout/today_sync_data"/>
        <com.crrepa.band.my.health.ecg.view.EcgView
            android:id="@+id/ecgview"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="@dimen/today_card_margin_top"
            android:layout_marginBottom="@dimen/today_card_margin_bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:ecg_background="@color/white"
            app:ecg_line_color="@color/color_ecg"/>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="0x7f08028f"
        android:layout_marginStart="@dimen/main_page_card_margin_start"
        android:stateListAnimator="@drawable/selector_elevation"/>
</RelativeLayout>
