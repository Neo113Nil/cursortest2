<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heart_rate_chart_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_physiological"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <View
            android:id="@+id/physiological_1"
            android:background="@drawable/shape_period_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="9dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/physiological_2"
            android:background="@drawable/shape_period_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="9dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/physiological_3"
            android:background="@drawable/shape_period_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="9dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/physiological_4"
            android:background="@drawable/shape_period_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="9dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/physiological_5"
            android:background="@drawable/shape_period_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="9dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/physiological_6"
            android:background="@drawable/shape_period_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="9dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/physiological_7"
            android:background="@drawable/shape_period_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="9dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/physiological_8"
            android:background="@drawable/shape_period_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="9dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/physiological_9"
            android:background="@drawable/shape_period_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/ll_physiological">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_physiological"
            android:id="@+id/tv_start_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_physiological"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/today"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_physiological"
            android:id="@+id/tv_end_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
