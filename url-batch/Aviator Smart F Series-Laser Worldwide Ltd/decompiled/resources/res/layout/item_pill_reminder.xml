<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:stateListAnimator="@drawable/selector_elevation"
    app:cardCornerRadius="10dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_pill_reminder_item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="70dp">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/text_size_20"
                    android:textColor="@color/black"
                    android:id="@+id/tv_pill_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey"
                    android:id="@+id/tv_reminder_repeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.kyleduo.switchbutton.SwitchButton
                android:layout_gravity="center_vertical"
                android:id="@+id/sbtn_pill_reminder_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:kswAnimationDuration="300"
                app:kswBackDrawable="@drawable/switch_button_back_color"
                app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
                app:kswThumbHeight="24dp"
                app:kswThumbMarginBottom="1dp"
                app:kswThumbMarginLeft="1dp"
                app:kswThumbMarginRight="1dp"
                app:kswThumbMarginTop="1dp"
                app:kswThumbWidth="24dp"/>
        </LinearLayout>
        <View style="@style/BorderView"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/tv_reminder_times"
            android:layout_width="wrap_content"
            android:layout_height="50dp"/>
        <com.moyoung.dafit.module.common.widgets.NoTouchRecyclerView
            android:id="@+id/rcv_reminder_time_list"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
