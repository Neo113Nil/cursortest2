<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:id="@+id/tv_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:layout_marginStart="15dp"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/add_new_pill"
            android:layout_weight="3"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:gravity="end"
            android:id="@+id/tv_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_weight="1"
            android:layout_marginEnd="15dp"/>
    </LinearLayout>
    <View style="@style/BorderView"/>
    <EditText
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:textColorHint="@color/grey"
        android:id="@+id/et_pill_name"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:hint="@string/input_pill_name"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <View
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/BorderView"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/repeat"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/every"/>
        <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
            android:id="@+id/pill_repeat_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/day"/>
    </LinearLayout>
    <View
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/BorderView"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/reminder_times"
            android:layout_weight="1"/>
        <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
            android:id="@+id/pill_times_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/times_a_day"/>
    </LinearLayout>
    <View
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/BorderView"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_reminder_time_list"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <Button
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/color_delete_text"
        android:id="@+id/btn_delete_reminder"
        android:background="@drawable/shape_delete_pill_reminder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="60dp"
        android:text="@string/delete"
        android:textAllCaps="false"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="52dp"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
