<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fl_content"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/iv_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_close"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:layout_marginStart="23dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/assist_11_33"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_gomore_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/assist_1"
                android:background="@drawable/shape_gomore_gps_title_bg"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/assist_11_33"
                android:id="@+id/tv_gomore_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_share"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/selector_training_path_share"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:layout_marginEnd="23dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.crrepa.band.my.training.map.MapContainer
                android:id="@+id/fl_map"
                android:layout_width="match_parent"
                android:layout_height="510dp">
                <com.crrepa.band.my.training.map.view.GpsTrackView
                    android:layout_gravity="center"
                    android:id="@+id/gpsTrackView"
                    android:visibility="invisible"
                    android:layout_width="300dp"
                    android:layout_height="300dp"/>
                <com.google.android.gms.maps.MapView
                    android:id="@+id/google_map_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/ll_replay"
                    android:background="@drawable/shape_training_path_replay_btn_bg"
                    android:padding="7dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="38dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_gps_route_play"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/assist_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="轨迹视频"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="end|bottom"
                    android:id="@+id/iv_location"
                    android:background="@drawable/selector_map_location"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginBottom="60dp"
                    android:layout_marginEnd="20dp"/>
            </com.crrepa.band.my.training.map.MapContainer>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_content"
                android:background="@color/main_bg_5_function"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/include_detail"
                    layout="@layout/include_training_path_record_detail"/>
                <include
                    android:id="@+id/include_hr_chart"
                    layout="@layout/include_training_path_heart_rate_chart"/>
                <include
                    android:id="@+id/include_hr_zone"
                    layout="@layout/include_training_path_heart_rate_zone"/>
                <include
                    android:id="@+id/include_real_time_pace"
                    layout="@layout/include_training_path_real_time_pace"/>
                <include
                    android:id="@+id/include_one_distance_pace"
                    layout="@layout/include_training_path_one_distance_pace"/>
                <include
                    android:id="@+id/include_elevation"
                    layout="@layout/include_training_path_elevation"/>
                <include
                    android:id="@+id/include_steps"
                    layout="@layout/include_training_path_steps"/>
                <include
                    android:id="@+id/include_running_pose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    layout="@layout/layout_gomore_sport_running_pose"/>
                <include
                    android:id="@+id/include_training_effect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    layout="@layout/layout_gomore_sport_training_effect"/>
                <include
                    android:id="@+id/include_energy_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    layout="@layout/layout_gomore_sport_energy_source"/>
                <include
                    android:id="@+id/include_vo2max"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    layout="@layout/layout_gomore_sport_vo2max"/>
                <include
                    android:id="@+id/include_recovery_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    layout="@layout/layout_gomore_sport_recovery_time"/>
            </LinearLayout>
            <com.moyoung.dafit.module.common.widgets.ShadowLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/sl_shoot"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="40dp"
                app:cornerRadius="22dp"
                app:shadowColor="@color/color_gps_training"
                app:shadowRadius="8dp">
                <Button
                    android:id="@+id/btn_shoot"
                    android:background="@drawable/shape_gps_training_start"
                    android:clickable="false"
                    android:layout_width="270dp"
                    android:layout_height="44dp"
                    style="?android:attr/borderlessButtonStyle"/>
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="270dp"
                    android:text="@string/gps_record_save_image_photos"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="0x7f080596"/>
            </com.moyoung.dafit.module.common.widgets.ShadowLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
