<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/ll_number_picker"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.crrepa.band.my.device.pillreminder.picker.MyWheelPicker
        android:id="@+id/wp_number"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        aigestudio:wheel_atmospheric="true"
        aigestudio:wheel_curved="true"
        aigestudio:wheel_cyclic="true"
        aigestudio:wheel_indicator="false"
        aigestudio:wheel_item_space="3.9dp"
        aigestudio:wheel_item_text_color="@color/color_my_picker_text"
        aigestudio:wheel_item_text_size="@dimen/text_size_18"
        aigestudio:wheel_selected_item_text_color="@color/color_refresh"
        aigestudio:wheel_visible_item_count="1"/>
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:id="@+id/tv_number"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"/>
</LinearLayout>
