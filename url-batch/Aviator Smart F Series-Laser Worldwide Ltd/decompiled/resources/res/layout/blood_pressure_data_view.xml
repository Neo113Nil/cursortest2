<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/color_blood_pressure"
    android:layout_width="match_parent"
    android:layout_height="252dp">
    <com.crrepa.band.my.health.widgets.BloodPressureDisplayView
        android:id="@+id/blood_pressure_display_view"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:layout_width="170dp"
        android:layout_height="match_parent"
        app:color="@color/white"
        app:dp_width="28dp"
        app:line_width="2dp"
        app:max_bp="200"
        app:min_bp="0"
        app:text_size="11sp"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_sbp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/data_blank"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/systolic_blood_pressure"
            android:layout_alignTop="@+id/tv_sbp"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/tv_sbp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/blood_pressure_unit"
            android:layout_alignBottom="@+id/tv_sbp"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/tv_sbp"/>
        <TextView
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_dbp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/data_blank"
            android:includeFontPadding="false"
            android:layout_below="@+id/tv_sbp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/diastolic_blood_pressure"
            android:layout_alignTop="@+id/tv_dbp"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/tv_dbp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/blood_pressure_unit"
            android:layout_alignBottom="@+id/tv_dbp"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/tv_dbp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:id="@+id/tv_statistics_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/tv_dbp"/>
    </RelativeLayout>
</LinearLayout>
