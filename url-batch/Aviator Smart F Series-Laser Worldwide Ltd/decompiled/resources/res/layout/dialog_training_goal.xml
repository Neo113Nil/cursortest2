<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/shape_training_goal_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/shape_training_goal_dialog_handle"
            android:layout_width="34dp"
            android:layout_height="3dp"
            android:layout_marginTop="15dp"/>
        <TextView
            android:textSize="50sp"
            android:textStyle="bold"
            android:textColor="@color/assist_11_33"
            android:id="@+id/tv_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/black"
            android:id="@+id/tv_goal_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false"/>
        <View
            android:background="@color/assist_5_D9"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="20dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_picker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:background="0x7f080096"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignTop="@+id/rv_picker"
                android:layout_alignBottom="@+id/rv_picker"/>
            <View
                android:id="@+id/pointer_selected"
                android:tag="noScale"
                android:background="@color/color_gps_training"
                android:layout_width="56dp"
                android:layout_height="5dp"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="38dp"
            app:cornerRadius="22dp"
            app:shadowColor="@color/color_gps_training"
            app:shadowRadius="8dp">
            <Button
                android:textSize="@dimen/text_size_18"
                android:textColor="@color/white"
                android:id="@+id/btn_done"
                android:background="@drawable/shape_gps_training_start"
                android:layout_width="270dp"
                android:layout_height="44dp"
                android:text="@string/done"
                android:textAllCaps="false"
                style="?android:attr/borderlessButtonStyle"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
    </LinearLayout>
</FrameLayout>
