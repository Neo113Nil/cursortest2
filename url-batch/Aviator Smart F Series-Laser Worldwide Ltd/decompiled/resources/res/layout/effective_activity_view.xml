<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_effective_activity_time"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/text_size_28"
                android:textStyle="bold"
                android:textColor="@color/color_step"
                android:id="@+id/tv_effective_activity_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/effective_activity_unit"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/effective_activity"
            android:lines="1"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@+id/ll_effective_activity_time"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="26dp">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/week_effective_activity"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_week_effective_activity_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/effective_activity_unit"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/grey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/recommend_weak_effective_activity"
        android:layout_marginStart="26dp"/>
    <com.moyoung.dafit.module.common.widgets.chart.CrpBarChart
        android:id="@+id/effective_activity_chart"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"/>
    <RelativeLayout
        android:background="@drawable/shape_recommend_effetive_bg"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            android:textColor="@color/color_step"
            android:id="@+id/tv_title_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/find_effective_activity"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/color_step"
            android:id="@+id/tv_description_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/effective_activity_description"
            android:layout_below="@+id/tv_title_1"
            android:lineSpacingExtra="6dp"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/color_step"
            android:id="@+id/tv_title_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/step_about_met_title"
            android:layout_below="@+id/tv_description_1"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/color_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/step_about_met_desc"
            android:layout_below="@+id/tv_title_2"/>
    </RelativeLayout>
</LinearLayout>
