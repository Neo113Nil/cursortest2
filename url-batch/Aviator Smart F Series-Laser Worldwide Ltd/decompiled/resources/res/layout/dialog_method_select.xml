<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="200dp">
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/cancel"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_done"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/done"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:layout_marginTop="39dp"
        style="@style/BorderView"/>
    <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
        android:id="@+id/wp_period"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        aigestudio:wheel_atmospheric="true"
        aigestudio:wheel_curved="true"
        aigestudio:wheel_cyclic="true"
        aigestudio:wheel_indicator="true"
        aigestudio:wheel_indicator_color="@color/grey"
        aigestudio:wheel_item_text_color="@color/grey"
        aigestudio:wheel_item_text_size="@dimen/text_size_16"
        aigestudio:wheel_selected_item_text_color="@color/black"/>
</RelativeLayout>
