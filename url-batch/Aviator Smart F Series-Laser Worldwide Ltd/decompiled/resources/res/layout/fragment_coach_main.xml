<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:descendantFocusability="beforeDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/assist_7_B3"
        android:gravity="center"
        android:id="@+id/tv_net_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="136dp"
        android:text="@string/classes_click_refresh"
        android:drawablePadding="20dp"
        app:drawableTopCompat="@mipmap/ic_classes_network_error"/>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:id="@+id/sl_refresh"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:cornerRadius="22dp"
        app:shadowColor="@color/class_assist_1"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/assist_1_ff"
            android:gravity="center"
            android:id="@+id/tv_refresh"
            android:background="@drawable/shape_classes_assist_1_btn"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/classes_refresh"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
</RelativeLayout>
