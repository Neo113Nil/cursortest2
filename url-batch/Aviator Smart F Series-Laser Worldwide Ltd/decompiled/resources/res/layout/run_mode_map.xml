<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_run_map"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="110dp">
    <TextView
        android:textSize="50sp"
        android:textColor="@color/black"
        android:id="@+id/tv_runing_map_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="0.00"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/black"
        android:id="@+id/tv_runing_map_distance_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:text="@string/distance_unit_km"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/tv_runing_map_distance"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_runing_map_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/text_size_20"
            android:textColor="@color/black"
            android:id="@+id/tv_runing_map_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"/>
        <TextView
            android:textSize="@dimen/text_size_20"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"/>
        <TextView
            android:textSize="@dimen/text_size_20"
            android:textColor="@color/black"
            android:id="@+id/tv_runing_map_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"/>
        <TextView
            android:textSize="@dimen/text_size_20"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"/>
        <TextView
            android:textSize="@dimen/text_size_20"
            android:textColor="@color/black"
            android:id="@+id/tv_runing_map_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_runing_map_gps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="15dp"
        android:layout_alignParentStart="true">
        <ImageView
            android:background="0x7f080282"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_runing_map_gps_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_status_disenable"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_runing_ordinary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="15dp"
        android:layout_alignParentEnd="true">
        <ImageView
            android:background="@drawable/selector_run_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/run_normal_mode"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</RelativeLayout>
