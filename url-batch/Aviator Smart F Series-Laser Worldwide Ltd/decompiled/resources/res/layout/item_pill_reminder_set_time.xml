<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <com.crrepa.band.my.device.pillreminder.picker.MyTimePicker
        android:id="@+id/reminder_time_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_time_system"
        android:background="@drawable/shape_time_picker_n"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/reminder_time_picker">
        <RadioButton
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/selector_am_pm_text_color"
            android:id="@+id/rbtn_am"
            android:background="@drawable/selector_am_pm_picker"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:checked="true"
            android:button="@null"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <RadioButton
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/selector_am_pm_text_color"
            android:id="@+id/rbtn_pm"
            android:background="@drawable/selector_am_pm_picker"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:button="@null"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </RadioGroup>
    <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
        android:id="@+id/pill_count_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="X"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/pill_count_picker"/>
    <View
        android:layout_alignParentBottom="true"
        style="@style/BorderView"/>
</RelativeLayout>
