<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_title"
        layout="@layout/band_data_appbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:id="@+id/tv_quick_contact_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_empty_contart"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080234"/>
            <Button
                android:textSize="@dimen/text_size_18"
                android:textColor="@color/white"
                android:id="@+id/btn_add_contact"
                android:background="@drawable/shape_add_contart"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="150dp"
                android:text="@string/add_quick_contact"
                android:layout_marginStart="52dp"
                android:layout_marginEnd="52dp"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/rl_contact_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp">
            <RelativeLayout
                android:id="@+id/rl_contact_done"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="80dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="52dp"
                android:layout_marginEnd="52dp">
                <com.moyoung.dafit.module.common.widgets.CornerProgressBar
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/pb_edit_contact"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:barBackColor="@color/color_line_bg"
                    app:barEndColor="@color/color_refresh"
                    app:barMax="100"
                    app:barProgress="0"
                    app:barStartColor="@color/color_refresh"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_edit_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/contact_upload_hint"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="0.75"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
            </RelativeLayout>
            <com.yanzhenjie.recyclerview.SwipeRecyclerView
                android:id="@+id/rcv_contact_list"
                android:scrollbars="none"
                android:fadingEdge="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/rl_contact_done"
                android:layout_alignParentTop="true"
                android:overScrollMode="never"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
