<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/watch_face_edit"
            android:layout_weight="3"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/done"
            android:layout_weight="1"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_watch_face_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="75dp"
            android:src="0x7f0805b1"
            android:scaleType="centerCrop"
            android:layout_above="@+id/tv_empty"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/grey"
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notice_watchface_empty"
            android:layout_centerInParent="true"/>
        <Button
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/white"
            android:id="@+id/btn_add_watch_face"
            android:background="@drawable/shape_add_contart"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="56dp"
            android:text="@string/add"
            android:layout_alignParentBottom="true"
            android:textAllCaps="false"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:gravity="center_vertical"
        android:id="@+id/rcv_download_watch_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</LinearLayout>
