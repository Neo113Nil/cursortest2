<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        style="@style/BandDataCardView">
        <RelativeLayout
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_sync_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:src="0x7f080398"
                android:layout_marginStart="16dp"/>
            <ImageView
                android:id="@+id/iv_hide"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0801f5"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/assist_14"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/training_record_import_title"
                android:layout_marginStart="10dp"
                android:layout_toStartOf="@+id/iv_hide"
                android:layout_toEndOf="@+id/iv_sync_status"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_14"
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/training_record_importing"
                android:layout_below="@+id/tv_title"
                android:layout_marginEnd="30dp"
                android:layout_alignStart="@+id/tv_title"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/main"
                android:id="@+id/tv_not_display"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/training_record_card_not_display_again"
                android:layout_below="@+id/tv_content"
                android:layout_marginEnd="30dp"
                android:layout_alignStart="@+id/tv_title"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
