<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_handle"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginLeft="20dp"
    android:layout_marginTop="20dp"
    android:layout_marginRight="20dp">
    <View
        android:id="@+id/view_full_screen"
        android:background="@mipmap/ic_video_full_screen"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffbebebe"
        android:id="@+id/exo_position"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:includeFontPadding="false"
        android:layout_above="@+id/rl_time_bar"/>
    <RelativeLayout
        android:id="@+id/rl_time_bar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:progressDrawable="@drawable/progressbar_video_bar"
            style="@style/ProgressBarHorizontal"/>
        <ImageView
            android:id="@+id/iv_play"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/btn_exo_video_play"
            android:layout_centerInParent="true"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/iv_pause"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/btn_exo_video_pause"
            android:layout_centerInParent="true"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/iv_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/btn_exo_video_prev"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:layout_marginStart="50dp"/>
        <ImageView
            android:id="@+id/iv_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/btn_exo_video_next"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:layout_marginEnd="50dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
