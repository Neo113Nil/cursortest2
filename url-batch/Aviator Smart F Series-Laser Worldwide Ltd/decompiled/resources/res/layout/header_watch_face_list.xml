<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/BorderView"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch_face"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/color_refresh"
            android:id="@+id/tv_download_watch_face_edit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.moyoung.dafit.module.common.widgets.CustomRecyclerView
        android:id="@+id/rcv_watch_face_list"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:overScrollMode="never"/>
</LinearLayout>
