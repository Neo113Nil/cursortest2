<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_gomore_sport_energy_source"
    android:background="@color/running_bg_3_detail"
    android:paddingLeft="26dp"
    android:paddingRight="26dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_14"
        android:id="@+id/tv_energy_source_title"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/training_energy_source"
        android:drawablePadding="6dp"
        app:drawableEndCompat="0x7f0801f7"/>
    <View style="@style/BorderView"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp">
        <Space
            android:id="@+id/center_space"
            android:layout_width="100dp"
            android:layout_height="1dp"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/center_space">
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/assist_12"
                android:id="@+id/tv_energy_fat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/assist_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="2dp"
                android:text="%"
                android:layout_alignBottom="@+id/tv_energy_fat"
                android:layout_toEndOf="@+id/tv_energy_fat"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_energy_fat"
                android:layout_below="@+id/tv_energy_fat"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/center_space">
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/assist_12"
                android:id="@+id/tv_energy_carb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/assist_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="2dp"
                android:text="%"
                android:layout_alignBottom="@+id/tv_energy_carb"
                android:layout_toEndOf="@+id/tv_energy_carb"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_energy_carb"
                android:layout_below="@+id/tv_energy_carb"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
