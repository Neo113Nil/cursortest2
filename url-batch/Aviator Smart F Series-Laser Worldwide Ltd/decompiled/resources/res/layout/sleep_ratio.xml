<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_sleep_ratio"
    android:background="@color/white"
    android:paddingTop="17dp"
    android:paddingBottom="20dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="216dp"
    android:paddingStart="26dp"
    android:paddingEnd="26dp">
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sleep_ratio"/>
    <View
        android:layout_marginTop="33dp"
        style="@style/BorderView"/>
    <com.moyoung.dafit.module.common.widgets.chart.CrpPieChart
        android:id="@+id/pc_sleep_ratio"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="56dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="56dp"
        android:layout_marginStart="24dp"
        android:layout_toEndOf="@+id/pc_sleep_ratio">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/shape_restful"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/restful"
                android:layout_weight="1"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_restful_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hour"
                android:layout_marginStart="2dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_restful_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"
                android:layout_marginStart="2dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minute"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/shape_light"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/light"
                android:layout_weight="1"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_light_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hour"
                android:layout_marginStart="2dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_light_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"
                android:layout_marginStart="2dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minute"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_sleep_rem"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/shape_rem"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sleep_rem"
                android:layout_weight="1"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_rem_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hour"
                android:layout_marginStart="2dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_rem_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"
                android:layout_marginStart="2dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minute"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
