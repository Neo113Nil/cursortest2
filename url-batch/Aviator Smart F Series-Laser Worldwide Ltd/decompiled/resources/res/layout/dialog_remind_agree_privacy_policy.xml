<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_bg_remind_agree_privacy_policy"
        android:paddingLeft="48dp"
        android:paddingTop="30dp"
        android:paddingRight="48dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/assist_14"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guidance_remind_dialog_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_10"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/assist_1_ff"
            android:gravity="center"
            android:id="@+id/btn_agree"
            android:background="@drawable/shape_guidance_remind_dialog_btn_bg"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:text="@string/privacy_agree_btn_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/popup_btn"
            android:gravity="center"
            android:id="@+id/btn_disagree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/guidance_leave"/>
    </LinearLayout>
</FrameLayout>
