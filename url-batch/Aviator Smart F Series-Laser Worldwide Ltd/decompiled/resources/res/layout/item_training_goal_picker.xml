<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/pointer_unselected"
        android:tag="noScale"
        android:background="@color/assist_6_C4"
        android:layout_width="28dp"
        android:layout_height="2dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/assist_6_C4"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="130dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_centerInParent="true"/>
    <com.moyoung.dafit.module.common.widgets.SingleLineZoomTextView
        android:textSize="14sp"
        android:textColor="@color/assist_6_C4"
        android:gravity="end|center_vertical"
        android:id="@+id/tv_description"
        android:tag="noScale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/tv_content"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
