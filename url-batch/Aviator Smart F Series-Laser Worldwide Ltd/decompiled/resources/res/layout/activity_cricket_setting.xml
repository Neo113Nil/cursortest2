<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/included_title"
        layout="@layout/band_history_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <RelativeLayout
            android:id="@+id/start_reminder"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:text="@string/cricket_setting_match_start_reminder"
                style="@style/SettingItemText"/>
            <include
                android:id="@+id/display_start_time"
                layout="@layout/continue_arrow"/>
            <TextView
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/assist_9_99"
                android:id="@+id/tv_start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:layout_toStartOf="@+id/display_start_time"/>
        </RelativeLayout>
        <View style="@style/BorderView"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:text="@string/cricket_setting_score_reminder"
                style="@style/SettingItemText"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/sbtn_score_reminder"
                app:kswAnimationDuration="300"
                app:kswBackDrawable="@drawable/switch_button_back_color"
                app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
                app:kswThumbHeight="24dp"
                app:kswThumbMarginBottom="1dp"
                app:kswThumbMarginLeft="1dp"
                app:kswThumbMarginRight="1dp"
                app:kswThumbMarginTop="1dp"
                app:kswThumbWidth="24dp"
                style="@style/SwitchButoonStyle"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
