<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp">
    <View style="@style/BorderView"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_14"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/device_custom_watch_face_time_display_method_title"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_time_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">
        <RadioButton
            android:textSize="14sp"
            android:textColor="@drawable/selector_watch_face_look_way_title_color"
            android:gravity="center"
            android:id="@+id/rb_time_style_number"
            android:background="@drawable/selector_watch_face_look_way"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:checked="false"
            android:button="@null"
            android:minWidth="100dp"
            android:text="@string/device_custom_watch_face_digital_display_title"
            android:layout_marginEnd="4dp"/>
        <RadioButton
            android:textSize="14sp"
            android:textColor="@drawable/selector_watch_face_look_way_title_color"
            android:gravity="center"
            android:id="@+id/rb_time_style_clock"
            android:background="@drawable/selector_watch_face_look_way"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:checked="true"
            android:button="@null"
            android:minWidth="100dp"
            android:text="@string/device_custom_watch_face_analog_display_title"/>
    </RadioGroup>
    <include
        android:id="@+id/include_number_picker"
        layout="@layout/layout_new_watch_face_time_style_number_picker"/>
</LinearLayout>
