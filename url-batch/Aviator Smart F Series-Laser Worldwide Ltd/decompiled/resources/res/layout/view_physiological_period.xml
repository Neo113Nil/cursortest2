<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rl_physiological_period_remind"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_26"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/physiological_period"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/grey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/physiological_period_hint"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="6dp">
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/sbtn_physiological_period"
            app:kswAnimationDuration="300"
            app:kswBackDrawable="@drawable/switch_button_back_color"
            app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
            app:kswThumbHeight="24dp"
            app:kswThumbMarginBottom="1dp"
            app:kswThumbMarginLeft="1dp"
            app:kswThumbMarginRight="1dp"
            app:kswThumbMarginTop="1dp"
            app:kswThumbWidth="24dp"
            style="@style/SwitchButoonStyle"/>
        <TextView
            android:text="@string/physiological_period"
            android:layout_toStartOf="@+id/sbtn_physiological_period"
            android:layout_alignParentStart="true"
            style="@style/SettingItemText"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/BorderView"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_physiological_period_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_physiological_cycle"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:text="@string/physiological_cycle"
                style="@style/SettingItemText"/>
            <include
                android:id="@+id/arrow_physiological_cycle"
                layout="@layout/continue_arrow"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey"
                android:id="@+id/tv_physiological_cycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/arrow_physiological_cycle"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/BorderView"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_menstrual_period"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:text="@string/physiological_menstrual_days"
                style="@style/SettingItemText"/>
            <include
                android:id="@+id/arrow_menstrual_period"
                layout="@layout/continue_arrow"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey"
                android:id="@+id/tv_menstrual_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/arrow_menstrual_period"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/BorderView"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_last_menstrual_date"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <include
                android:id="@+id/arrow_last_menstrual_date"
                layout="@layout/continue_arrow"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey"
                android:id="@+id/tv_last_menstrual_period_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/arrow_last_menstrual_date"/>
            <TextView
                android:text="@string/physiological_last_menstrual"
                android:layout_marginEnd="10dp"
                android:layout_toStartOf="@+id/tv_last_menstrual_period_date"
                android:layout_alignParentStart="true"
                style="@style/SettingItemText"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/BorderView"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_reminder_mode"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:text="@string/reminder_mode"
                style="@style/SettingItemText"/>
            <include
                android:id="@+id/arrow_reminder_mode"
                layout="@layout/continue_arrow"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/BorderView"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_reminder_time"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:text="@string/reminder_time"
                style="@style/SettingItemText"/>
            <include
                android:id="@+id/arrow_reminder_time"
                layout="@layout/continue_arrow"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey"
                android:id="@+id/tv_reminder_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/arrow_reminder_time"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/BorderView"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_physiological_cycle_calendar"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:text="@string/physiological_cycle_calendar"
                style="@style/SettingItemText"/>
            <include
                android:id="@+id/arrow_physiological_cycle_calendar"
                layout="@layout/continue_arrow"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/BorderView"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
