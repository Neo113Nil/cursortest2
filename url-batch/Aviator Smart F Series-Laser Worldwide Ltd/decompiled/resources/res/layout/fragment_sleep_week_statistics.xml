<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="315dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_sleep_time_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hour"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_sleep_time_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minute"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/black"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <com.moyoung.dafit.module.common.widgets.chart.CrpBarChart
        android:id="@+id/sleep_statistics_chart"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="40dp"
        android:layout_alignParentBottom="true"/>
    <View
        android:background="@color/light_gray"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"/>
    <com.crrepa.band.my.health.widgets.HandleView
        android:id="@+id/sleep_handle_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"/>
</RelativeLayout>
