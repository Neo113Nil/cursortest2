<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_sleep_bo"
    android:background="@color/white"
    android:paddingBottom="20dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/average_sleep_blood_oxygen_abbreviation"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/text_size_28"
                android:textStyle="bold"
                android:textColor="@color/color_blood_oxygen"
                android:id="@+id/tv_sleep_average_bo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/percent_unit"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        style="@style/BorderView"/>
    <include
        android:id="@+id/include_blood_oxygen_statistics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        layout="@layout/view_blood_oxygen_extremes"/>
    <com.moyoung.dafit.module.common.widgets.chart.CrpLineChart
        android:id="@+id/blood_oxygen_chart"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/black"
            android:id="@+id/tv_bo_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/black"
            android:id="@+id/tv_bo_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
