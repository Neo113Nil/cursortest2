<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_history"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_classes_history_n"
        android:layout_marginEnd="23dp"
        android:layout_alignParentEnd="true"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab"
        android:background="#00000000"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true"
        app:tabIndicator="@null"
        app:tabIndicatorHeight="0dp"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/assist_13_00"
        app:tabTextAppearance="@style/HomeSportTabWidget"
        app:tabTextColor="@color/assist_8_A9"/>
    <com.moyoung.dafit.module.common.widgets.NoScrollViewPager
        android:id="@+id/vp_class"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tab"/>
</RelativeLayout>
