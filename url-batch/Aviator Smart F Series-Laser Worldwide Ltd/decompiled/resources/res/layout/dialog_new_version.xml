<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_confirm_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/black"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/new_app_title"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/new_app_change_log"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:id="@+id/tv_change_log"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/grey"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_app_name_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/app_name"
        android:includeFontPadding="false"/>
    <View
        android:background="@color/light_gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"/>
    <TextView
        android:textColor="@color/color_new_app_update"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_update"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/new_app_update"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_no_reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/light_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textColor="@color/color_new_app_update"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_no_reminder"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/new_app_no_reminder"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_remind_later"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/light_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textColor="@color/color_new_app_update"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_remind_later"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/new_app_remind_later"/>
    </LinearLayout>
</LinearLayout>
