<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_weight_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold"
            android:textColor="@color/assist_12_22"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/water_intake"
            android:layout_centerInParent="true"
            android:textAlignment="center"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08046a"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/color_indicator"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="60dp"/>
    <com.crrepa.band.my.health.widgets.WaveView
        android:id="@+id/wv_water_intake"
        android:background="0x7f0808a2"
        android:layout_width="218dp"
        android:layout_height="290.5dp"
        android:layout_marginTop="97.5dp"
        android:layout_centerHorizontal="true"
        app:behind_wave_color="@color/color_water_record_wave_behind"
        app:front_wave_color="@color/color_water_record_wave_front"/>
    <TextView
        android:textSize="@dimen/text_size_30"
        android:textStyle="bold"
        android:textColor="@color/color_dialog_add_water_intake"
        android:id="@+id/tv_water_intake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_below="@+id/wv_water_intake"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="17.6sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_add_water"
        android:background="@drawable/shape_add_water_btn_bg"
        android:layout_width="302dp"
        android:layout_height="76dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="38dp"
        android:text="@string/water_add"
        android:layout_below="@+id/tv_water_intake"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
