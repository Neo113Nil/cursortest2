<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/title_bar"
        layout="@layout/band_data_appbar"/>
    <RelativeLayout
        android:id="@+id/rl_device_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/assist_9_99"
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/guide_click_band_list_item"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_scan_band"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/tv_hint"
            android:overScrollMode="never"/>
    </RelativeLayout>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/sl_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        app:cornerRadius="22dp"
        app:shadowColor="@color/main"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_skip"
            android:background="@drawable/shape_private_policy_agree"
            android:visibility="gone"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/guide_device_not_found"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
