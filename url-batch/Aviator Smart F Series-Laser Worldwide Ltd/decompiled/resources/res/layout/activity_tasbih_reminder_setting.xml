<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_tasbih_setting"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/top_bar"
        layout="@layout/band_data_appbar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/view_split"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="20dp"/>
            <RelativeLayout
                android:id="@+id/rl_reminder"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/muslim_tasbih_reminder_title"
                    android:layout_centerVertical="true"/>
                <com.crrepa.band.my.device.muslim.view.SwitchButton
                    android:id="@+id/sbtn_tasbih_reminder"
                    android:layout_width="44dp"
                    android:layout_height="30dp"
                    app:kswAnimationDuration="300"
                    app:kswBackDrawable="@drawable/muslim_switch_button_back_color"
                    app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbMargin="1dp"
                    app:kswThumbWidth="28dp"
                    style="@style/SwitchButoonStyle"/>
                <View
                    android:layout_alignParentBottom="true"
                    style="@style/BorderView"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_config_reminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/rl_interval_time"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/muslim_tasbih_interval_time"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="@color/grey"
                        android:id="@+id/tv_interval_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_toStartOf="@+id/iv_time_continue"/>
                    <ImageView
                        android:id="@+id/iv_time_continue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f0801ed"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/grey"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="@string/muslim_tasbih_time_range"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"/>
                <RelativeLayout
                    android:id="@+id/rl_reminder_start_time"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/muslim_tasbih_start_time"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="@color/grey"
                        android:id="@+id/tv_start_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_toStartOf="@+id/iv_start_continue"/>
                    <ImageView
                        android:id="@+id/iv_start_continue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f0801ed"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                    <View
                        android:layout_alignParentBottom="true"
                        style="@style/BorderView"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_reminder_end_time"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/muslim_tasbih_end_time"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="@color/grey"
                        android:id="@+id/tv_end_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_toStartOf="@+id/iv_end_continue"/>
                    <ImageView
                        android:id="@+id/iv_end_continue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f0801ed"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/grey"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="@string/muslim_tasbih_repeat"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <CheckBox
                        android:id="@+id/cb_sunday"
                        android:text="@string/sunday"
                        style="@style/MuslimCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:textStyle="bold"
                        android:id="@+id/cb_monday"
                        android:checked="true"
                        android:text="@string/monday"
                        style="@style/MuslimCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_tuesday"
                        android:text="@string/tuesday"
                        style="@style/MuslimCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_wednesday"
                        android:text="@string/wednesday"
                        style="@style/MuslimCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_thursday"
                        android:text="@string/thursday"
                        style="@style/MuslimCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_friday"
                        android:text="@string/friday"
                        style="@style/MuslimCheckBoxTheme"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_saturday"
                        android:text="@string/saturday"
                        style="@style/MuslimCheckBoxTheme"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/assist_6_B3"
                    android:id="@+id/tv_description"
                    android:paddingTop="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/muslim_tasbih_tips"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
