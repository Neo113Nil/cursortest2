<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_label"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <View style="@style/BorderView"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_14"
            android:id="@+id/tv_label_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Label 1"/>
        <ImageView
            android:id="@+id/iv_label_arrow"
            style="@style/ContinueArrow"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/grey"
            android:id="@+id/tv_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/iv_label_arrow"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_label_wp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:visibility="gone"
            style="@style/BorderView"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_10"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_label_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/device_custom_watch_face_jerry_drag_tips"
            android:layout_marginEnd="2dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_label_tips">
            <View
                android:background="@drawable/shape_wheel_back_7dp"
                android:layout_width="match_parent"
                android:layout_height="31dp"
                android:layout_centerVertical="true"/>
            <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
                android:id="@+id/wp"
                android:background="@color/translucent"
                android:layout_width="match_parent"
                android:layout_height="164dp"
                aigestudio:wheel_atmospheric="true"
                aigestudio:wheel_curved="true"
                aigestudio:wheel_cyclic="false"
                aigestudio:wheel_indicator_size="60dp"
                aigestudio:wheel_item_align="center"
                aigestudio:wheel_item_space="60dp"
                aigestudio:wheel_item_text_color="@color/grey"
                aigestudio:wheel_item_text_size="22dp"
                aigestudio:wheel_same_width="false"
                aigestudio:wheel_selected_item_text_color="@color/black"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
