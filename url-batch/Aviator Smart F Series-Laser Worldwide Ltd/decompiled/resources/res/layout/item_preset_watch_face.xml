<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="86dp"
        android:layout_height="86dp">
        <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
            android:id="@+id/iv_preset_watch_face"
            android:layout_width="86dp"
            android:layout_height="86dp"/>
        <ImageView
            android:id="@+id/iv_add_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0805af"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/black"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_watch_face_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <Button
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_watch_face_edit"
        android:background="@drawable/shape_watch_face_edit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minWidth="60dp"
        android:minHeight="20dp"
        android:text="@string/edit"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
