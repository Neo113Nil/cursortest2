<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/light_gray"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/include_data_view"
            layout="@layout/blood_pressure_data_view"/>
        <include
            android:id="@+id/include_about_bo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            layout="@layout/view_about_bo"/>
        <RelativeLayout
            android:background="@color/white"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="281dp"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/last_7_times_blood_pressure_trend"
                android:layout_marginStart="26dp"/>
            <View
                android:layout_marginTop="56dp"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                style="@style/BorderView"/>
            <com.moyoung.dafit.module.common.widgets.chart.CrpBarChart
                android:id="@+id/last_7_times_blood_pressure_trend_chart"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="66dp"
                android:layout_marginBottom="18dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:layout_alignParentBottom="true"
                android:layoutDirection="ltr"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp">
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_dbp_first_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_dbp_second_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_dbp_third_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_dbp_fourth_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_dbp_fifth_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_dbp_sixth_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_dbp_seventh_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layoutDirection="ltr"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp">
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_sbp_first_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_sbp_second_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_sbp_third_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_sbp_fourth_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_sbp_fifth_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_sbp_sixth_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_sbp_seventh_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
