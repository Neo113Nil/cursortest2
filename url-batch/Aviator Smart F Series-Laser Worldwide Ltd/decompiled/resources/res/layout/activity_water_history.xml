<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_water_history"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/water_history_bar"
        layout="@layout/app_toolbar"/>
    <com.crrepa.band.my.health.widgets.MyNestedScrollView
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rl_water_data"
                android:background="@color/white"
                android:paddingBottom="26dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_water_total_intake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="@dimen/text_size_40"
                        android:textStyle="bold"
                        android:textColor="@color/assist_12_22"
                        android:gravity="center"
                        android:id="@+id/tv_water_total_intake"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textStyle="bold"
                        android:textColor="@color/assist_12_22"
                        android:id="@+id/tv_water_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/assist_12_22"
                    android:id="@+id/tv_water_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ll_water_total_intake"
                    android:layout_centerHorizontal="true"/>
                <com.crrepa.band.my.health.widgets.WaveView
                    android:id="@+id/wv_water"
                    android:background="0x7f0808a4"
                    android:layout_width="129dp"
                    android:layout_height="172dp"
                    android:layout_marginTop="104dp"
                    android:layout_centerHorizontal="true"
                    app:behind_wave_color="@color/color_water_record_wave_behind"
                    app:front_wave_color="@color/color_water_record_wave_front"/>
                <TextView
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tv_water_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_alignBottom="@+id/wv_water"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/assist_6_B3"
                    android:id="@+id/tv_water_percentage_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_below="@+id/wv_water"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <com.yanzhenjie.recyclerview.SwipeRecyclerView
                android:id="@+id/rcv_water_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.crrepa.band.my.health.widgets.MyNestedScrollView>
</LinearLayout>
