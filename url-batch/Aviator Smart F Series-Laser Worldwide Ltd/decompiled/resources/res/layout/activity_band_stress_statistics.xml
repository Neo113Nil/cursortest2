<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_title_bar"
        layout="@layout/app_toolbar"/>
    <com.crrepa.band.my.health.widgets.MyNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/light_gray"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tl_stress_tab"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:tabBackground="@color/color_stress"
                app:tabIndicatorColor="@color/white"
                app:tabIndicatorHeight="3dp"
                app:tabRippleColor="@null"/>
            <com.crrepa.band.my.health.widgets.NoScrollViewPager
                android:id="@+id/vp_stress_content"
                android:layout_width="match_parent"
                android:layout_height="235dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:id="@+id/tv_stress_evaluation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stress_evaluation"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:id="@+id/iv_help"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f0801e5"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="6dp"
                        android:layout_toEndOf="@+id/tv_stress_evaluation"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true">
                        <TextView
                            android:textSize="28sp"
                            android:textColor="@color/color_stress"
                            android:layout_gravity="end"
                            android:id="@+id/tv_last_stress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/grey"
                            android:id="@+id/tv_stress_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-4dp"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                </RelativeLayout>
                <View
                    android:layout_marginTop="8dp"
                    style="@style/BorderView"/>
                <com.crrepa.band.my.health.widgets.segmentedbar.SegmentedBarView
                    android:id="@+id/stress_slider_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="9dp"
                    app:sbv_arrow_height="5dp"
                    app:sbv_arrow_width="10dp"
                    app:sbv_bar_height="14dp"
                    app:sbv_descriptionAlign="Both"
                    app:sbv_descriptionTopAlign="Center"
                    app:sbv_segment_bg="false"
                    app:sbv_segment_gap_width="0dp"
                    app:sbv_segment_rule="average"
                    app:sbv_show_description_text="false"
                    app:sbv_show_description_top_text="false"
                    app:sbv_show_segment_text="false"
                    app:sbv_side_style="rounded"
                    app:sbv_side_text_style="oneSided"
                    app:sbv_sliderType="Sign"
                    app:sbv_value_sign_background="@color/color_stress"
                    app:sbv_value_sign_height="7dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="3dp">
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/grey"
                        android:gravity="center_horizontal"
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="0"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/stress_relaxed"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/grey"
                        android:gravity="center_horizontal"
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="30"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/stress_normal"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/grey"
                        android:gravity="center_horizontal"
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="60"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/stress_medium"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/grey"
                        android:gravity="center_horizontal"
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="80"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/stress_stressed"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/grey"
                        android:gravity="center_horizontal"
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="100"/>
                </LinearLayout>
            </LinearLayout>
            <include
                android:id="@+id/include_mindsoothe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/include_stress_mindsoothe_card"/>
            <RelativeLayout
                android:id="@+id/rl_stress_ratio"
                android:background="@color/white"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stress_ratio"/>
                <View
                    android:layout_marginTop="36dp"
                    style="@style/BorderView"/>
                <com.moyoung.dafit.module.common.widgets.chart.CrpPieChart
                    android:id="@+id/chart_stress_percent"
                    android:visibility="invisible"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="56dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="56dp"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="34dp"
                    android:layout_toEndOf="@+id/chart_stress_percent">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/shape_stress_relaxed"/>
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/stress_relaxed"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/black"
                            android:gravity="end"
                            android:id="@+id/tv_relaxed_percent"
                            android:layout_width="42dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_blank"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/shape_stress_normal"/>
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/stress_normal"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/black"
                            android:gravity="end"
                            android:id="@+id/tv_normal_percent"
                            android:layout_width="42dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_blank"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/shape_stress_medium"/>
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/stress_medium"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/black"
                            android:gravity="end"
                            android:id="@+id/tv_medium_percent"
                            android:layout_width="42dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_blank"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/shape_stress_stressed"/>
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/stress_stressed"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/black"
                            android:gravity="end"
                            android:id="@+id/tv_stressed_percent"
                            android:layout_width="42dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_blank"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <include
                android:id="@+id/include_last_7_times_trend"
                android:layout_width="match_parent"
                android:layout_height="266dp"
                android:layout_marginTop="20dp"
                layout="@layout/last_7_times_trend_view"/>
        </LinearLayout>
    </com.crrepa.band.my.health.widgets.MyNestedScrollView>
    <RelativeLayout
        android:id="@+id/band_measure_view"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_anchor="@+id/nsv_content"
        app:layout_anchorGravity="bottom">
        <Button
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:id="@+id/btn_band_measure"
            android:background="@drawable/shape_stress_measure_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="52dp"
            android:layout_marginBottom="20dp"
            android:layout_centerInParent="true"
            android:stateListAnimator="@null"/>
    </RelativeLayout>
</LinearLayout>
