<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_weather"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_26"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/weather"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/grey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/update_weather_every_hour"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="6dp">
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/sbtn_weather"
            app:kswAnimationDuration="300"
            app:kswBackDrawable="@drawable/switch_button_back_color"
            app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
            app:kswThumbHeight="24dp"
            app:kswThumbMarginBottom="1dp"
            app:kswThumbMarginLeft="1dp"
            app:kswThumbMarginRight="1dp"
            app:kswThumbMarginTop="1dp"
            app:kswThumbWidth="24dp"
            style="@style/SwitchButoonStyle"/>
        <TextView
            android:text="@string/weather"
            android:layout_toStartOf="@+id/sbtn_weather"
            android:layout_alignParentStart="true"
            style="@style/SettingItemText"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/BorderView"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_weather_temp_system"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:text="@string/weather_temp_system"
            style="@style/SettingItemText"/>
        <include
            android:id="@+id/arrow_weather_temp_system"
            layout="@layout/continue_arrow"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:id="@+id/tv_weather_temp_system"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/arrow_weather_temp_system"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/BorderView"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_weather_location"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:text="@string/location"
            style="@style/SettingItemText"/>
        <include
            android:id="@+id/arrow_location"
            layout="@layout/continue_arrow"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:id="@+id/tv_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/arrow_location"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/BorderView"/>
    </RelativeLayout>
</LinearLayout>
