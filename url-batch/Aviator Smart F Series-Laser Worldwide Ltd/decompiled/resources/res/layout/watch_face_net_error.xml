<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="216dp"
        android:layout_height="150dp"
        android:layout_marginTop="172dp"
        android:src="@drawable/ic_net_error"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/rl_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/iv_icon"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/assist_9_99"
            android:gravity="center"
            android:id="@+id/tv_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/net_disonnected_hint"
            android:layout_centerHorizontal="true"
            android:paddingStart="22dp"
            android:paddingEnd="0dp"/>
        <View
            android:id="@+id/no_wifi"
            android:background="0x7f08045d"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignTop="@+id/tv_tips"
            android:layout_marginEnd="-18dp"
            android:layout_toStartOf="@+id/tv_tips"/>
    </RelativeLayout>
    <Button
        android:textSize="18sp"
        android:textColor="@color/bg_1_ff"
        android:gravity="center"
        android:id="@+id/btn_refresh"
        android:background="@drawable/shape_watch_face_upload"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="206dp"
        android:text="@string/refresh"
        android:layout_below="@+id/rl_tips"
        android:textAllCaps="false"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="52dp"/>
</RelativeLayout>
