<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        app:cardElevation="@dimen/today_card_elevation"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        style="@style/BandDataCardView">
        <include layout="@layout/today_sync_data"/>
        <com.moyoung.dafit.module.common.widgets.chart.CrpLineChart
            android:id="@+id/weight_line_chart"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:layout_marginTop="94dp"
            android:layout_marginBottom="20dp"/>
        <include
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/include_no_data"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="109dp"
            android:layout_marginBottom="20dp"
            layout="@layout/not_data_hint_view"/>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="0x7f080393"
        android:stateListAnimator="@drawable/selector_elevation"/>
</RelativeLayout>
