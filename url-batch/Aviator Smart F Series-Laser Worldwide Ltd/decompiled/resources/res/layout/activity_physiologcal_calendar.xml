<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@color/color_physiological_title_bg"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <ImageView
            android:id="@+id/iv_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_close_w"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/white"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/physiological_period_title"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:id="@+id/tv_title_today"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/today"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="@color/color_physiological_title_bg"
                android:layout_width="match_parent"
                android:layout_height="194dp"/>
            <RelativeLayout
                android:id="@+id/rl_date_year_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="75dp"
                android:paddingEnd="75dp">
                <ImageView
                    android:id="@+id/iv_last_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_continue_left"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:textColor="@color/white"
                    android:id="@+id/tv_year_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"/>
                <ImageView
                    android:id="@+id/iv_next_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_continue_right"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_physiological_message"
                android:background="@drawable/shape_physiological_message_bg"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:layout_below="@+id/rl_date_year_month"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f080468"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/dark_grey"
                    android:id="@+id/tv_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <com.haibin.calendarview.CalendarLayout
                android:orientation="vertical"
                android:id="@+id/cl_physiologcal"
                android:background="@drawable/shape_physiological_calendar_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_below="@+id/ll_physiological_message"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:default_status="expand">
                <com.haibin.calendarview.CalendarView
                    android:id="@+id/cv_physiologcal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:calendar_padding="10dp"
                    app:current_day_text_color="@color/black"
                    app:max_year="@integer/calendar_max_year"
                    app:max_year_day="@integer/max_day"
                    app:max_year_month="@integer/max_month"
                    app:min_year="@integer/calendar_min_year"
                    app:min_year_day="@integer/min_day"
                    app:min_year_month="@integer/min_month"
                    app:month_view="com.crrepa.band.my.health.physiologicalcycle.calendar.CustomMonthView"
                    app:month_view_show_mode="mode_fix"
                    app:other_month_text_color="@color/color_calendar_other_month_text"
                    app:week_bar_height="46dp"
                    app:week_bar_view="com.crrepa.band.my.health.physiologicalcycle.calendar.CustomWeekBar"
                    app:week_line_background="#00000000"
                    app:week_line_margin="16dp"
                    app:week_start_with="sun"
                    app:week_text_size="16sp"/>
            </com.haibin.calendarview.CalendarLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/rl_physiologcal_dateset1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_below="@+id/cl_physiologcal"
                android:layout_marginStart="45dp"
                android:layout_marginEnd="45dp">
                <androidx.constraintlayout.helper.widget.Flow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="tv_prediction_menstruation,tv_menstruation,tv_ovulation,tv_ovulation_day"
                    app:flow_horizontalGap="6dp"
                    app:flow_horizontalStyle="spread"
                    app:flow_maxElementsWrap="3"
                    app:flow_verticalGap="16dp"
                    app:flow_wrapMode="aligned"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/dark_grey"
                    android:id="@+id/tv_prediction_menstruation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/physiological_predict_period_title"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/shape_prediction_menstruation"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/dark_grey"
                    android:id="@+id/tv_menstruation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/physiological_menstruation_title"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/shape_menstruation"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/dark_grey"
                    android:id="@+id/tv_ovulation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/physiological_ovulation_title"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/shape_ovulation"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/dark_grey"
                    android:id="@+id/tv_ovulation_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/physiological_ovulation_day_title"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/shape_ovulation_day"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_below="@+id/rl_physiologcal_dateset1">
                <RelativeLayout
                    android:id="@+id/rl_reminder_mode"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:onClick="onReminderModeClicked"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <TextView
                        android:text="@string/physiological_notification_reminder_title"
                        style="@style/SettingItemText"/>
                    <include layout="@layout/continue_arrow"/>
                    <View
                        android:layout_alignParentBottom="true"
                        style="@style/BorderView"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_cycle_setting"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_below="@+id/rl_reminder_mode"
                    android:onClick="onCycleSettings"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <TextView
                        android:text="@string/physiological_cycle_setting_title"
                        style="@style/SettingItemText"/>
                    <include layout="@layout/continue_arrow"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_physiological_phase"
                    android:background="@color/white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_below="@+id/rl_cycle_setting"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <View style="@style/BorderView"/>
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:id="@+id/tv_physiological_phase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_pregnancy_chance"
                    android:background="@color/white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_below="@+id/rl_physiological_phase"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <View style="@style/BorderView"/>
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pregnancy_chance"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_28"
                        android:textColor="@color/color_pregnancy_chance"
                        android:id="@+id/tv_pregnancy_chance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
