<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:layout_marginTop="13dp"
    android:layout_marginEnd="12dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/text_size_28"
            android:textStyle="bold"
            android:textColor="@color/color_weight"
            android:id="@+id/tv_date_first_part"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_date_first_part_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_data_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lines="1"
        android:layout_marginStart="40dp"/>
    <TextView
        android:textSize="@dimen/text_size_10"
        android:textColor="@color/assist_6_C4"
        android:id="@+id/tv_sync_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/tv_data_type"
        android:layout_marginStart="40dp"/>
    <TextView
        android:textSize="@dimen/text_size_10"
        android:textColor="@color/assist_6_C4"
        android:id="@+id/tv_today_data_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/tv_sync_time"
        android:layout_alignParentEnd="true"/>
    <View
        android:layout_alignParentBottom="true"
        android:layout_marginStart="40dp"
        style="@style/BorderView"/>
</RelativeLayout>
