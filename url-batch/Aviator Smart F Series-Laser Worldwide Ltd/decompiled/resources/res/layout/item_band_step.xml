<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        app:cardElevation="@dimen/today_card_elevation"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        style="@style/BandDataCardView">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/today_sync_data"/>
            <com.moyoung.dafit.module.common.widgets.chart.CrpBarChart
                android:id="@+id/today_steps_detail_chart"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="-6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="@dimen/today_card_margin_bottom"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                layout="@layout/sport_detail_view"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="0x7f08029d"
        android:layout_marginStart="@dimen/main_page_card_margin_start"
        android:stateListAnimator="@drawable/selector_elevation"/>
</RelativeLayout>
