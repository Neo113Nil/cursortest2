<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sleep_time_distributed"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.crrepa.band.my.health.widgets.segmentedview.SegmentedView
        android:id="@+id/sleep_time_distributed_view"
        android:layout_width="match_parent"
        android:layout_height="110dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/sleep_time_distributed_view">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_fall_asleep_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dark_grey"
            android:gravity="end"
            android:id="@+id/tv_wake_up_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
