<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_mic_icon_bg"
            android:background="0x7f0805e8"
            android:layout_width="match_parent"
            android:layout_height="122dp"
            android:layout_alignParentBottom="true"/>
        <ImageView
            android:id="@+id/iv_mic_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="60dp"
            android:src="0x7f08019a"
            android:layout_alignTop="@+id/iv_mic_icon_bg"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/rl_operation_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="38dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="22dp"
            android:layout_above="@+id/iv_mic_icon_bg"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/iv_result_cancel"
                android:visibility="invisible"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="0x7f080191"/>
            <ImageView
                android:id="@+id/iv_cancel"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="0x7f080191"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/iv_result_send"
                android:visibility="invisible"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="0x7f080198"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_input_status"
            android:background="@drawable/shape_ai_chat_box"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:minHeight="110dp"
            android:layout_above="@+id/rl_operation_handle">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/anim_asr_recording"
                android:visibility="invisible"
                android:layout_width="72dp"
                android:layout_height="41dp"
                android:layout_marginTop="26dp"
                android:layout_centerHorizontal="true"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/anim_asr_recording"/>
            <ProgressBar
                android:id="@+id/pb_asr_recognizing"
                android:visibility="invisible"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:indeterminateDrawable="@drawable/anim_ai_asr_recognizing"
                android:indeterminateDuration="500"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/assist_13_00"
                android:gravity="center"
                android:id="@+id/tv_asr_recognizing"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/ai_speak_recognizing_text"
                android:layout_below="@+id/pb_asr_recognizing"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/assist_13_00"
                android:gravity="start"
                android:id="@+id/tv_asr_result"
                android:visibility="invisible"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/assist_15"
                android:gravity="center"
                android:id="@+id/tv_asr_error"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_speak_unrecognized_text"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <View
            android:background="0x7f080192"
            android:layout_width="25dp"
            android:layout_height="15dp"
            android:layout_below="@+id/rl_input_status"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:id="@+id/ll_question_tips"
            android:background="@drawable/shape_ai_chat_box"
            android:padding="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_above="@+id/rl_input_status"
            android:layout_alignStart="@+id/rl_input_status"
            android:layout_alignEnd="@+id/rl_input_status">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/assist_11_33"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try asking me that:"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
