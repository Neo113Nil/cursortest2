<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:paddingBottom="20dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_alignTop="@+id/tv_title"
        android:layout_alignBottom="@+id/tv_title"
        android:layout_marginStart="10dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/assist_14"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="80dp"
        android:layout_marginStart="3dp"
        android:layout_toEndOf="@+id/iv_icon"/>
    <ImageView
        android:id="@+id/iv_tips"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="0x7f0801f7"
        android:layout_alignTop="@+id/tv_title"
        android:layout_alignBottom="@+id/tv_title"
        android:layout_marginStart="-12dp"
        android:layout_toEndOf="@+id/tv_title"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/running_main_1_word"
        android:id="@+id/tv_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/tv_title"
        android:layout_alignStart="@+id/tv_title"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/assist_8"
        android:gravity="center"
        android:id="@+id/tv_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_alignBottom="@+id/tv_data"
        android:layout_marginStart="2dp"
        android:layout_toEndOf="@+id/tv_data"/>
</RelativeLayout>
