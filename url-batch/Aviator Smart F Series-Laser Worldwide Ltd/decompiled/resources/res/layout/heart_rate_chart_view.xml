<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heart_rate_chart_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.moyoung.dafit.module.common.widgets.chart.CrpBarChart
        android:id="@+id/heart_rate_chart"
        android:layout_width="match_parent"
        android:layout_height="100dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_below="@+id/heart_rate_chart">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/grey"
            android:id="@+id/tv_start_measure_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/grey"
            android:id="@+id/tv_stop_measure_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
