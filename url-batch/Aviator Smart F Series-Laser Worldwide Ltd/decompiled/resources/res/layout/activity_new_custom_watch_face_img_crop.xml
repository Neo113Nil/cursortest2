<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_dialog_add_water_intake"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rl_top"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/iv_title_back"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="3dp"
            android:src="@drawable/ic_back_w"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/selector_crop_complete_color"
            android:id="@+id/tv_completion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:text="@string/done"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/footer_bar"
        android:background="#1a1a1a"
        android:paddingBottom="34dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_preview"
            android:layout_width="match_parent"
            android:layout_height="71dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/crop_free_space_textcolor"
            android:gravity="center"
            android:id="@+id/tv_space"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="27dp"
            android:text="@string/device_custom_watch_face_residue_space"
            android:layout_below="@+id/rcv_preview"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_1"
            android:gravity="center"
            android:id="@+id/tv_next"
            android:background="@drawable/selector_17e6d3_d9d9d9"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/device_custom_watch_face_picture_next"
            android:layout_below="@+id/rcv_preview"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="20dp"
        android:layout_above="@+id/footer_bar"
        android:layout_below="@+id/rl_top">
        <com.crrepa.band.my.device.watchfacenew.photo.widgets.CropImageView
            android:id="@+id/cv_crop_image"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:maxHeight="420dp"
            android:minHeight="290dp"
            android:layout_centerVertical="true"
            app:cropBorderColor="@color/assist_1_ff"
            app:cropBorderWidth="3dp"
            app:cropFocusHeight="290dp"
            app:cropFocusWidth="290dp"
            app:cropMaskColor="#b3d9d9d9"/>
    </RelativeLayout>
</RelativeLayout>
