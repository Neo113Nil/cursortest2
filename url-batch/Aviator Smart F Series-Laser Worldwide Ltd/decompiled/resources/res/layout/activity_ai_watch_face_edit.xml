<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <ImageView
            android:id="@+id/iv_back"
            android:background="@drawable/selector_title_back"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch_face_edit"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rl_ai_picture_operation"
        android:layout_below="@+id/ll_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="20dp">
                <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
                    android:id="@+id/iv_watch_face_preview"
                    android:layout_width="154dp"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_watch_face_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp">
                    <ImageView
                        android:id="@+id/iv_watch_face_time_top"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"/>
                    <ImageView
                        android:id="@+id/iv_watch_face_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        app:srcCompat="@drawable/watch_face_time_vector"/>
                    <ImageView
                        android:id="@+id/iv_watch_face_time_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_watch_face_time_position"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="45dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_face_time_position"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_watch_face_time_position_arrow"
                    style="@style/ContinueArrow"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey"
                    android:id="@+id/tv_watch_face_time_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/iv_watch_face_time_position_arrow"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_watch_face_time_position_top_content"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <View style="@style/BorderView"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_face_time_position_top_content"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_watch_face_time_position_top_arrow"
                    style="@style/ContinueArrow"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey"
                    android:id="@+id/tv_watch_face_time_position_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/iv_watch_face_time_position_top_arrow"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_watch_face_time_position_bottom_content"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <View style="@style/BorderView"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_face_time_position_bottom_content"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_watch_face_time_position_bottom_arrow"
                    style="@style/ContinueArrow"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey"
                    android:id="@+id/tv_watch_face_time_position_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/iv_watch_face_time_position_bottom_arrow"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <View style="@style/BorderView"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/watch_face_text_color"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/rg_watch_face_text_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:layout_alignParentBottom="true">
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_white"
                        android:drawableStart="@drawable/selector_watch_face_text_color_white"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_black"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_black"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_yellow"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_yellow"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_origin"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_origin"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_red"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_red"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_purple"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_purple"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_blue"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_blue"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_indigo"
                        android:drawableStart="@drawable/selector_watch_face_text_color_indigo"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_green"
                        android:drawableStart="@drawable/selector_watch_face_text_color_green"
                        style="@style/WatchFaceTextColorRadioButton"/>
                </RadioGroup>
            </RelativeLayout>
            <View
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/BorderView"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:id="@+id/rl_ai_picture_operation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="52dp"
        android:layout_marginBottom="38dp"
        android:layout_alignParentBottom="true">
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:id="@+id/shadow_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            app:cornerRadius="22dp"
            app:shadowColor="@color/main"
            app:shadowRadius="8dp">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/bg_1_ff"
                android:gravity="center"
                android:id="@+id/tv_apply"
                android:background="@drawable/shape_watch_face_upload"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/watch_face_btn_apply"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
        <ProgressBar
            android:id="@+id/pb_watch_face"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100"
            android:progressDrawable="@drawable/progressbar_horizontal_watch_face_upload"
            style="@style/ProgressBarHorizontal"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/bg_1_ff"
            android:gravity="center"
            android:id="@+id/tv_upload_progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="0%"/>
    </RelativeLayout>
    <View
        android:id="@+id/mask_ai_picture"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
