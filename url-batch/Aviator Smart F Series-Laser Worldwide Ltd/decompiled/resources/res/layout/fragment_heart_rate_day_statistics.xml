<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_heart_rate_chart"
    android:background="@color/color_training"
    android:layout_width="match_parent"
    android:layout_height="235dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_average_hr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/data_blank"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:id="@+id/tv_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_statistics_date"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_data"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:id="@+id/tv_statistics_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:id="@+id/tv_hr_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.moyoung.dafit.module.common.widgets.chart.CrpLineChart
        android:id="@+id/heart_rate_chart"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-10dp"
        android:layout_marginBottom="40dp"
        android:layout_below="@+id/ll_statistics_date"
        android:layout_alignParentBottom="true"/>
    <com.crrepa.band.my.health.widgets.DayAxisTimeView
        android:id="@+id/day_axis_time_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <View
        android:background="@color/light_gray"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"/>
    <com.crrepa.band.my.health.widgets.HandleView
        android:id="@+id/hr_handle_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"/>
</RelativeLayout>
