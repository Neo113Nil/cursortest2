<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_weight_gap"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_app_toolbar"
        layout="@layout/app_toolbar"/>
    <com.crrepa.band.my.health.widgets.MyNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/light_gray"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tl_weight_tab"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:tabBackground="@color/color_weight"
                app:tabIndicatorColor="@color/white"
                app:tabIndicatorHeight="3dp"
                app:tabRippleColor="@null"/>
            <com.crrepa.band.my.health.widgets.NoScrollViewPager
                android:id="@+id/vp_weight_content"
                android:layout_width="match_parent"
                android:layout_height="235dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp">
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weight_bmi_title"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_28"
                        android:textStyle="bold"
                        android:textColor="@color/color_weight"
                        android:id="@+id/tv_weight_bmi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/data_blank"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <View
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="26dp"
                    android:layout_marginEnd="26dp"
                    style="@style/BorderView"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_weight_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true">
                        <TextView
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_weight"
                            android:id="@+id/tv_weight_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_blank"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_weight_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/tv_weight_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_weight_num"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <com.crrepa.band.my.health.widgets.segmentedbar.SegmentedBarView
                    android:id="@+id/sbv_weight_slider_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    app:sbv_arrow_height="5dp"
                    app:sbv_arrow_width="10dp"
                    app:sbv_bar_height="14dp"
                    app:sbv_descriptionAlign="Both"
                    app:sbv_descriptionTopAlign="Center"
                    app:sbv_segment_bg="false"
                    app:sbv_segment_gap_width="0dp"
                    app:sbv_segment_rule="scale"
                    app:sbv_segment_text_decimal="1"
                    app:sbv_show_description_text="false"
                    app:sbv_show_description_top_text="false"
                    app:sbv_show_segment_text="true"
                    app:sbv_side_style="rounded"
                    app:sbv_side_text_style="oneSided"
                    app:sbv_sliderType="Sign"
                    app:sbv_value_sign_background="@color/color_weight"
                    app:sbv_value_sign_height="7dp"/>
                <com.crrepa.band.my.health.widgets.CustomAxisView
                    android:id="@+id/cav_weight_statistics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_marginEnd="26dp"/>
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="26dp"
                    android:layout_marginEnd="26dp"
                    layout="@layout/weight_bmi_note_view"/>
            </LinearLayout>
            <include
                android:id="@+id/include_last_7_times_trend"
                android:layout_width="match_parent"
                android:layout_height="266dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                layout="@layout/last_7_times_trend_view"/>
        </LinearLayout>
    </com.crrepa.band.my.health.widgets.MyNestedScrollView>
    <RelativeLayout
        android:id="@+id/rl_weight_record"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_anchor="@+id/nsv_content"
        app:layout_anchorGravity="bottom">
        <Button
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:id="@+id/btn_weight_record"
            android:background="@drawable/shape_weight_record_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="52dp"
            android:layout_marginBottom="20dp"
            android:layout_centerInParent="true"
            android:textAllCaps="false"
            android:stateListAnimator="@null"/>
    </RelativeLayout>
</LinearLayout>
