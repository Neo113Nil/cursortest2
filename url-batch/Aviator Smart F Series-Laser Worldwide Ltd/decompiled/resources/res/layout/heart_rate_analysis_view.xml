<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_heart_rate_analysis"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="26dp"
    android:paddingEnd="26dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_analysis"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/black"
            android:id="@+id/tv_total_measure_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/BorderView"/>
    </RelativeLayout>
    <com.crrepa.band.my.health.widgets.HeartRateRangeAnalysisView
        android:id="@+id/heart_rate_range_analysis"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_marginTop="30dp"/>
    <include
        android:id="@+id/include_hr_analysis_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="20dp"
        layout="@layout/heart_rate_analysis_description_view"/>
</LinearLayout>
