<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        app:cardElevation="@dimen/today_card_elevation"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        style="@style/BandDataCardView">
        <include layout="@layout/today_sync_data"/>
        <com.crrepa.band.my.health.widgets.BloodPressureHorizontalDisplayView
            android:id="@+id/bp_horizontal_display_view"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="118dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:color="@color/color_blood_pressure"
            app:line_width="2dp"
            app:max_bp="200"
            app:min_bp="0"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="145dp"
            android:layout_marginBottom="30dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/color_blood_pressure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
            <androidx.legacy.widget.Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/color_blood_pressure"
                android:id="@+id/tv_eighty_five"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50"/>
            <androidx.legacy.widget.Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/color_blood_pressure"
                android:id="@+id/tv_ninety"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"/>
            <androidx.legacy.widget.Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/color_blood_pressure"
                android:id="@+id/tv_ninety_five"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150"/>
            <androidx.legacy.widget.Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/color_blood_pressure"
                android:id="@+id/tv_hundred"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="0x7f08028c"
        android:layout_marginStart="@dimen/main_page_card_margin_start"
        android:stateListAnimator="@drawable/selector_elevation"/>
</RelativeLayout>
