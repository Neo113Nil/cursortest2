<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="175dp">
                <com.crrepa.band.my.health.ecg.view.EcgView
                    android:id="@+id/ecgview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:ecg_background="@color/color_ecg_chart_bg"
                    app:ecg_line_color="@color/black"/>
                <ImageView
                    android:id="@+id/iv_ecg_full"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="10dp"
                    android:src="0x7f08024d"
                    android:layout_marginEnd="10dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <include
                android:id="@+id/include_ecg_analysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/ecg_analysis_view"/>
            <include
                android:id="@+id/include_hr_variability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/view_ecg_heart_rate_variability"/>
            <include
                android:id="@+id/include_ecg_fatigue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/view_ecg_fatigue"/>
            <include
                android:id="@+id/include_ecg_mental_stress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/view_ecg_mental_stress"/>
            <include
                android:id="@+id/include_ecg_heart_load"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/view_ecg_heart_load"/>
            <include
                android:id="@+id/include_ecg_heart_strength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/view_ecg_heart_strength"/>
            <include
                android:id="@+id/include_ecg_auxiliary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                layout="@layout/view_ecg_auxiliary"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:id="@+id/band_measure_view"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="49dp">
        <View style="@style/BorderView"/>
        <Button
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:id="@+id/btn_ecg_measure"
            android:background="@drawable/shape_ecg_measure"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="@string/click_to_start_measure"
            android:layout_centerInParent="true"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp"/>
    </RelativeLayout>
</LinearLayout>
