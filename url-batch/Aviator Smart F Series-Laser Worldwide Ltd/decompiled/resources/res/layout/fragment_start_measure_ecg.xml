<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <TextView
        android:textSize="@dimen/text_size_26"
        android:textColor="@color/black"
        android:id="@+id/tv_measure_ecg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/measure_ecg_title"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="@dimen/text_size_20"
        android:textColor="@color/grey"
        android:id="@+id/tv_measure_ecg_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/measure_ecg_content"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/red"
        android:id="@+id/tv_measure_ecg_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/press_electrode_opportunity_hint"
        android:includeFontPadding="false"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/btn_measure_ecg"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/selector_ecg_start"
            android:layout_centerInParent="true"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text="@string/start_measure"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
