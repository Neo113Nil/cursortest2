<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/rl_preview"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true">
        <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
            android:id="@+id/iv_img_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            app:riv_oval="true"/>
        <include
            android:id="@+id/include_time_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/layout_new_watch_face_time_preview"/>
        <include
            android:id="@+id/include_pointer_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/layout_new_watch_face_pointer_preview"/>
    </RelativeLayout>
    <View
        android:id="@+id/border"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/rl_preview"
        style="@style/BorderView"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btn_set_watch_face"
        android:layout_below="@+id/border">
        <LinearLayout
            android:orientation="vertical"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/include_img"
                layout="@layout/layout_new_custom_watch_face_img"/>
            <include
                android:id="@+id/include_display_mode"
                layout="@layout/layout_new_watch_face_display_mode_for_custom_photo"/>
            <include
                android:id="@+id/include_time_style"
                layout="@layout/layout_new_watch_face_time_style"/>
            <include
                android:id="@+id/include_pointer_style"
                layout="@layout/layout_new_watch_face_pointer_style"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_set_watch_face"
        android:background="@drawable/selector_17e6d3_d9d9d9"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="53dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="53dp"
        android:layout_marginBottom="20dp"
        android:text="@string/device_video_watch_face_set_current_button_title"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:stateListAnimator="@null"/>
</RelativeLayout>
