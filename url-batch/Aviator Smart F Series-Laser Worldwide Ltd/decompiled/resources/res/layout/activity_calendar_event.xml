<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_title"
        layout="@layout/band_data_appbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/calendar_alarm_content"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="6dp">
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/sbtn_reminder"
                app:kswAnimationDuration="300"
                app:kswBackDrawable="@drawable/switch_button_back_color"
                app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
                app:kswThumbHeight="24dp"
                app:kswThumbMarginBottom="1dp"
                app:kswThumbMarginLeft="1dp"
                app:kswThumbMarginRight="1dp"
                app:kswThumbMarginTop="1dp"
                app:kswThumbWidth="24dp"
                style="@style/SwitchButoonStyle"/>
            <TextView
                android:text="@string/calendar_whether_remind"
                android:layout_toStartOf="@+id/sbtn_reminder"
                android:layout_alignParentStart="true"
                style="@style/SettingItemText"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/BorderView"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/reminderTime"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:text="@string/calendar_remind_time"
                style="@style/SettingItemText"/>
            <include
                android:id="@+id/reminderTime_arrow"
                layout="@layout/continue_arrow"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey"
                android:id="@+id/tv_reminderTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/reminderTime_arrow"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/BorderView"/>
        </RelativeLayout>
        <androidx.legacy.widget.Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"/>
        <Button
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/white"
            android:id="@+id/btn_unsync_calendar_event"
            android:background="@drawable/shape_add_contart"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/disable_calendar_event"
            android:textAllCaps="false"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="52dp"/>
        <androidx.legacy.widget.Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
