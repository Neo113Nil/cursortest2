<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_weight_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="9dp"
    android:paddingEnd="9dp">
    <RelativeLayout
        android:id="@+id/rl_dialog_weight"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_weight_record"
            android:layout_centerInParent="true"
            android:textAlignment="center"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close_b"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:layout_below="@+id/rl_dialog_weight"
        style="@style/BorderView"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_weight_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_below="@+id/rl_dialog_weight"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/text_size_30"
            android:textStyle="bold"
            android:textColor="@color/color_weight"
            android:id="@+id/tv_dialog_weight_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/color_weight"
            android:id="@+id/tv_dialog_weight_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_mark"
        android:layout_width="15dp"
        android:layout_height="7.5dp"
        android:layout_marginTop="12dp"
        android:src="0x7f0803f3"
        android:layout_below="@+id/ll_weight_num"
        android:layout_centerHorizontal="true"/>
    <com.crrepa.band.my.health.widgets.ScaleView
        android:id="@+id/sv_dialog_scaleView"
        android:layout_width="match_parent"
        android:layout_height="56.5dp"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/iv_mark"
        app:baseLine_margin_bottom="24"
        app:font_margin_bottom="2"
        app:high_pointer_margin="0"
        app:high_scale_color="@color/assist_6_C4"
        app:high_scale_width="1.5"
        app:line_interval="8"
        app:low_pointer_margin="11"
        app:low_scale_color="@color/assist_6_C4"
        app:low_scale_width="1"
        app:middle_pointer_margin="11"
        app:middle_scale_color="@color/assist_6_C4"
        app:middle_scale_width="1"
        app:num_color="@color/assist_7_B3"
        app:pointer_color="@color/color_weight"
        app:pointer_margin_top="0"
        app:pointer_width="2"
        app:scale_position="top"
        app:scaleview_text_size="14"/>
    <Button
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/white"
        android:id="@+id/btn_dialog_save"
        android:background="@drawable/shape_weight_record_bg"
        android:layout_width="270dp"
        android:layout_height="44dp"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="20dp"
        android:text="@string/save"
        android:layout_below="@+id/sv_dialog_scaleView"
        android:layout_centerHorizontal="true"
        android:textAllCaps="false"/>
</RelativeLayout>
