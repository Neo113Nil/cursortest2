<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_edit_watch_face_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/watch_face_edit"
            android:layout_weight="3"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_edit_watch_face_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/rl_watch_face_preview"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="20dp">
                <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
                    android:id="@+id/iv_watch_face_preview"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_watch_face_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp">
                    <ImageView
                        android:id="@+id/iv_watch_face_time_top"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"/>
                    <ImageView
                        android:id="@+id/iv_watch_face_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        app:srcCompat="@drawable/watch_face_time_vector"/>
                    <ImageView
                        android:id="@+id/iv_watch_face_time_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
            </RelativeLayout>
            <View
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/BorderView"/>
            <androidx.recyclerview.widget.RecyclerView
                android:gravity="center_vertical"
                android:id="@+id/rcv_preset_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"/>
            <View
                android:layout_height="1dp"
                android:layout_marginTop="25dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/BorderView"/>
            <RelativeLayout
                android:id="@+id/rl_watch_face_time_position"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <View style="@style/BorderView"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_face_time_position"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_watch_face_time_position_arrow"
                    style="@style/ContinueArrow"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey"
                    android:id="@+id/tv_watch_face_time_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/iv_watch_face_time_position_arrow"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_watch_face_time_position_top_content"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <View style="@style/BorderView"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_face_time_position_top_content"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_watch_face_time_position_top_arrow"
                    style="@style/ContinueArrow"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey"
                    android:id="@+id/tv_watch_face_time_position_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/iv_watch_face_time_position_top_arrow"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_watch_face_time_position_bottom_content"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <View style="@style/BorderView"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_face_time_position_bottom_content"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_watch_face_time_position_bottom_arrow"
                    style="@style/ContinueArrow"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey"
                    android:id="@+id/tv_watch_face_time_position_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/iv_watch_face_time_position_bottom_arrow"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <View style="@style/BorderView"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/watch_face_text_color"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/rg_watch_face_text_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:layout_alignParentBottom="true">
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_white"
                        android:layout_height="33dp"
                        android:drawableStart="@drawable/selector_watch_face_text_color_white"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_black"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_black"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_yellow"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_yellow"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_origin"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_origin"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_red"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_red"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_purple"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_purple"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_blue"
                        android:checked="false"
                        android:drawableStart="@drawable/selector_watch_face_text_color_blue"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_indigo"
                        android:drawableStart="@drawable/selector_watch_face_text_color_indigo"
                        style="@style/WatchFaceTextColorRadioButton"/>
                    <RadioButton
                        android:id="@+id/rb_watch_face_text_color_green"
                        android:drawableStart="@drawable/selector_watch_face_text_color_green"
                        style="@style/WatchFaceTextColorRadioButton"/>
                </RadioGroup>
            </RelativeLayout>
            <View
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/BorderView"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
