<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/view_bottom"
        android:layout_alignParentTop="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="match_parent"
                android:layout_height="282dp"
                android:scaleType="centerCrop"/>
            <View
                android:background="@drawable/shape_meditation_online_class_cover_mask"
                android:layout_width="match_parent"
                android:layout_height="100dp"/>
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="44dp"
                android:src="0x7f0801e0"
                android:layout_marginStart="20dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#b9b9b9"
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:drawablePadding="2dp"
                android:layout_alignBottom="@+id/iv_cover"
                android:layout_marginStart="20dp"
                app:drawableStartCompat="@mipmap/ic_coach_duration"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#b9b9b9"
                android:id="@+id/tv_kcal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="2dp"
                android:layout_alignTop="@+id/tv_duration"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@+id/tv_duration"
                app:drawableStartCompat="@mipmap/ic_coach_kcal"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#b9b9b9"
                android:id="@+id/tv_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="2dp"
                android:layout_alignTop="@+id/tv_duration"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@+id/tv_kcal"
                app:drawableStartCompat="@mipmap/ic_fitness_level_l1"/>
            <TextView
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/assist_1_ff"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:maxLines="2"
                android:layout_above="@+id/tv_duration"
                android:layout_marginEnd="20dp"
                android:layout_alignStart="@+id/tv_duration"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/class_assist_1"
                android:id="@+id/tv_view_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="@string/fitness_class_view_more_title"
                android:layout_alignTop="@+id/tv_description"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_13_00"
                android:ellipsize="end"
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:maxLines="4"
                android:layout_below="@+id/iv_cover"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <View
                android:background="@color/bg_2_f7"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/tv_description"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_coach_action_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp"
                android:text="@string/course_fitness_detail_course_content_title"
                android:layout_below="@+id/tv_description"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/assist_6_C4"
                android:gravity="center_vertical"
                android:id="@+id/tv_coach_action_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_alignTop="@+id/tv_coach_action_title"
                android:layout_toStartOf="@+id/view_continue"/>
            <View
                android:id="@+id/view_continue"
                android:background="@drawable/ic_continue"
                android:layout_width="6dp"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/tv_coach_action_count"
                android:layout_alignBottom="@+id/tv_coach_action_count"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="20dp"
                android:layout_alignParentEnd="true"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_coach_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/tv_coach_action_title"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/assist_13_00"
                android:id="@+id/tv_related_courses_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="36dp"
                android:layout_marginRight="20dp"
                android:text="@string/course_fitness_detail_related_courses_title"
                android:layout_below="@+id/rv_coach_action"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_related_courses"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/tv_related_courses_title"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:id="@+id/view_bottom"
        android:background="@color/bg_2_f7"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/sl_start"/>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:id="@+id/sl_start"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:cornerRadius="22dp"
        app:shadowColor="@color/class_assist_1"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/assist_1_ff"
            android:gravity="center"
            android:id="@+id/tv_download"
            android:background="@drawable/shape_classes_assist_1_btn"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/course_fitness_download_button_title"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/assist_1_ff"
            android:gravity="center"
            android:id="@+id/tv_start"
            android:background="@drawable/shape_classes_assist_1_btn"
            android:visibility="gone"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/fitness_start_training"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
    <ProgressBar
        android:id="@+id/pb_audio"
        android:visibility="gone"
        android:layout_width="270dp"
        android:layout_height="44dp"
        android:max="100"
        android:progressDrawable="@drawable/progressbar_meditation_download_audio"
        android:layout_alignTop="@+id/sl_start"
        android:layout_centerHorizontal="true"
        style="@style/ProgressBarHorizontal"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/bg_1_ff"
        android:gravity="center"
        android:id="@+id/tv_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="0%"
        android:layout_alignTop="@+id/pb_audio"
        android:layout_alignStart="@+id/pb_audio"
        android:layout_alignEnd="@+id/pb_audio"/>
</RelativeLayout>
