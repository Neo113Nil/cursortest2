<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        app:cardElevation="@dimen/today_card_elevation"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        app:contentPaddingBottom="16dp"
        style="@style/BandDataCardView">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0801af"/>
            <TextView
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_band_hint"
                android:includeFontPadding="false"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
        <Button
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_gravity="end"
            android:id="@+id/btn_add_band"
            android:background="@drawable/shape_add_band"
            android:paddingLeft="11dp"
            android:paddingRight="11dp"
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            android:layout_marginTop="76dp"
            android:text="@string/bound_band"
            android:layout_marginEnd="12dp"/>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
