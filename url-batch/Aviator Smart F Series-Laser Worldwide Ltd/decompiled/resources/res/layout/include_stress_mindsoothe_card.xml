<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_mindsoothe"
    android:background="@color/stress_bg_5_detail"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="@string/meditation_related_app_title"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_mindsoothe"
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false">
        <ImageView
            android:id="@+id/iv_mindsoothe_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f080090"
            android:scaleType="centerCrop"/>
        <RelativeLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp">
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0801a9"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#545d8e"
                android:gravity="center_vertical"
                android:id="@+id/tv_mindsoothe_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meditation_app_name"
                android:drawablePadding="5dp"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@+id/iv_icon"
                app:drawableEndCompat="0x7f0801a7"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#555d88"
                android:gravity="center_vertical"
                android:id="@+id/tv_mindsoothe_content1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/meditation_app_stress_content1"
                android:layout_below="@+id/tv_mindsoothe_title"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#555d88"
                android:gravity="center_vertical"
                android:id="@+id/tv_mindsoothe_content2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/meditation_app_stress_content2"
                android:layout_below="@+id/tv_mindsoothe_content1"/>
            <TextView
                android:textSize="9sp"
                android:textColor="#cfcbd5"
                android:gravity="center_vertical"
                android:id="@+id/tv_mindsoothe_white_noise"
                android:background="@drawable/shape_stress_mindsoothe_text_bg_1"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginTop="6dp"
                android:text="@string/meditation_app_white_noise"
                android:layout_below="@+id/tv_mindsoothe_content2"/>
            <TextView
                android:textSize="9sp"
                android:textColor="#cfcbd5"
                android:gravity="center_vertical"
                android:background="@drawable/shape_stress_mindsoothe_text_bg_2"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginTop="6dp"
                android:text="@string/meditation_app_ambient_music"
                android:layout_below="@+id/tv_mindsoothe_content2"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/tv_mindsoothe_white_noise"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
