<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/toolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <ImageView
            android:id="@+id/iv_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="23dp"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_wear_watch_face"
            android:layout_centerInParent="true"
            style="@style/CollapsingToolbarLayoutCollapsedTitle"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_btn"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:id="@+id/card_watch_face"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="30dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:elevation="0dp"
                app:cardCornerRadius="18dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/riv_watch_face"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ai_select_you_like"/>
            <View
                android:layout_marginTop="20dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/BorderView"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/ai_adjust_watch_face"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recommend_watch_face"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="20dp"/>
            <View
                android:layout_marginTop="20dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/BorderView"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/ai_kaleidoscope_dial"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <androidx.cardview.widget.CardView
                    android:layout_gravity="center"
                    android:id="@+id/card_ka_face"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="20dp"
                    android:elevation="0dp"
                    app:cardCornerRadius="18dp">
                    <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
                        android:id="@+id/riv_ka_face"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:riv_border_width="3dp"/>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ai_number"
                    android:layout_marginStart="34dp"
                    android:layout_toEndOf="@+id/card_ka_face"/>
                <SeekBar
                    android:id="@+id/seek_quantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="60"
                    android:progress="30"
                    android:layout_below="@+id/tv_quantity"
                    android:layout_alignStart="@+id/tv_quantity"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_angle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ai_angle"
                    android:layout_below="@+id/seek_quantity"
                    android:layout_alignStart="@+id/tv_quantity"/>
                <SeekBar
                    android:id="@+id/seek_angle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="360"
                    android:progress="180"
                    android:layout_below="@+id/tv_angle"
                    android:layout_alignStart="@+id/tv_quantity"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_btn"
        android:paddingTop="30dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/white"
            android:id="@+id/btn_take_photo"
            android:background="@drawable/shape_remove_contart"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:text="@string/ai_take_photo_repeat"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="15dp"
            android:stateListAnimator="@null"/>
        <Button
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/white"
            android:id="@+id/btn_confirm"
            android:background="@drawable/shape_add_contart"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:text="@string/confirm"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginEnd="20dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_anima"
        android:background="@color/white"
        android:paddingTop="200dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/fr_anima"
            android:background="0x7f0805b0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/iv_anima"
                android:layout_width="110dp"
                android:layout_height="130dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/ani_watchface"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/ai_creating_watch_face"
            android:layout_below="@+id/fr_anima"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
