<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/toolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <ImageView
            android:id="@+id/iv_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="23dp"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_wear_watch_face"
            android:layout_centerInParent="true"
            style="@style/CollapsingToolbarLayoutCollapsedTitle"/>
        <ImageView
            android:id="@+id/iv_flash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08018b"
            android:layout_centerVertical="true"
            android:layout_marginEnd="23dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.google.android.cameraview.CameraView
        android:id="@+id/camera_view"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rl_shutter_control"
        android:layout_below="@+id/toolbar"
        app:autoFocus="true"
        app:facing="back"
        app:flash="off"/>
    <RelativeLayout
        android:id="@+id/rl_shutter_control"
        android:background="@color/white"
        android:paddingLeft="54dp"
        android:paddingTop="10dp"
        android:paddingRight="54dp"
        android:paddingBottom="45dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/iv_gallery_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:src="0x7f08018d"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/iv_shutter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08018e"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/iv_switch_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:src="0x7f08018f"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
