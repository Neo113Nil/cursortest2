<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="160dp">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/rl_watch_face"
        android:layout_width="96dp"
        android:layout_height="96dp">
        <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
            android:id="@+id/iv_watch_face"
            android:layout_width="96dp"
            android:layout_height="96dp"/>
        <ImageView
            android:id="@+id/iv_add_watch_face"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0805ae"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_center_logo"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_home_device_ai_picture"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_photo_picture"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="0x7f0805bf"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_watch_face_content"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="9dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/iv_watch_face_time_top"
                android:layout_width="32dp"
                android:layout_height="6dp"/>
            <ImageView
                android:id="@+id/iv_watch_face_time"
                android:layout_width="40dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"/>
            <ImageView
                android:id="@+id/iv_watch_face_time_bottom"
                android:layout_width="32dp"
                android:layout_height="6dp"/>
        </LinearLayout>
        <include
            android:id="@+id/include_hisilicon_label"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            layout="@layout/layout_item_watch_face_hisilicon_label"/>
        <include
            android:id="@+id/include_jieli_pointer_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            layout="@layout/layout_new_watch_face_pointer_preview"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/black"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_watch_face_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="20dp"/>
    <Button
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_watch_face_edit"
        android:background="@drawable/shape_watch_face_edit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minWidth="60dp"
        android:minHeight="20dp"
        android:text="@string/edit"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
