<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ucrop_photobox"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/toolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <ImageView
            android:id="@+id/iv_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="23dp"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_wear_watch_face"
            android:layout_centerInParent="true"
            style="@style/CollapsingToolbarLayoutCollapsedTitle"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/ucrop_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/controls_wrapper"
        android:layout_below="@+id/toolbar">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/image_view_logo"
            android:layout_width="@dimen/ucrop_default_crop_logo_size"
            android:layout_height="@dimen/ucrop_default_crop_logo_size"
            app:srcCompat="@drawable/ucrop_vector_ic_crop"/>
        <com.yalantis.ucrop.view.UCropView
            android:id="@+id/ucrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/controls_wrapper"
        android:background="@android:color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/rl_control"
        android:background="@color/white"
        android:padding="25dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/white"
            android:id="@+id/btn_take_photo"
            android:background="@drawable/shape_remove_contart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:minHeight="40dp"
            android:text="@string/ai_take_photo_repeat"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginEnd="20dp"
            android:stateListAnimator="@null"/>
        <Button
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/white"
            android:id="@+id/btn_create_watch_face"
            android:background="@drawable/shape_add_contart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:minHeight="40dp"
            android:text="@string/ai_create_watch_face"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/watch_face_capture_area"
        android:layout_above="@+id/rl_control"
        android:layout_centerHorizontal="true"
        android:drawableStart="0x7f08018c"/>
</RelativeLayout>
