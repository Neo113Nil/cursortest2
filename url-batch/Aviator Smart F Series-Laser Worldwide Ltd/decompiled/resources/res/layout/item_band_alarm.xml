<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_time"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="15dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:id="@+id/tv_time_noon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="@dimen/text_size_36"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="2dp"
            android:layout_toEndOf="@+id/tv_time_noon"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/grey"
        android:id="@+id/tv_alarm_repeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/rl_time"/>
    <com.kyleduo.switchbutton.SwitchButton
        android:id="@+id/sbtn_alarm"
        app:kswAnimationDuration="300"
        app:kswBackDrawable="@drawable/switch_button_back_color"
        app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
        app:kswThumbHeight="24dp"
        app:kswThumbMarginBottom="1dp"
        app:kswThumbMarginLeft="1dp"
        app:kswThumbMarginRight="1dp"
        app:kswThumbMarginTop="1dp"
        app:kswThumbWidth="24dp"
        style="@style/SwitchButoonStyle"/>
    <View
        android:layout_alignParentBottom="true"
        style="@style/BorderView"/>
</RelativeLayout>
