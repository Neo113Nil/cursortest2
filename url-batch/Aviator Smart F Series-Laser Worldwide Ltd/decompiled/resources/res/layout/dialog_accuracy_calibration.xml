<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/shape_muslim_direction_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/muslim_accuracy_calibration_dialog_title"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_description"
        android:layout_width="219dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/muslim_accuracy_calibration_dialog_description"
        android:layout_below="@+id/tv_title"
        android:layout_centerHorizontal="true"/>
    <com.moyoung.dafit.module.common.widgets.GifImageView
        android:id="@+id/giv_gif"
        android:layout_width="205dp"
        android:layout_height="205dp"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/tv_description"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_current_accuracy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="@string/muslim_accuracy_calibration_dialog_accuracy"
        android:layout_below="@+id/giv_gif"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textStyle="bold"
        android:textColor="@color/main"
        android:gravity="center"
        android:id="@+id/tv_sensor_state"
        android:background="@drawable/shape_muslim_sensor_state_bg"
        android:paddingLeft="20dp"
        android:paddingTop="4dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/muslim_accuracy_calibration_dialog_accuracy_high"
        android:layout_below="@+id/tv_current_accuracy"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_below="@+id/tv_sensor_state"
        android:layout_centerHorizontal="true">
        <View
            android:background="@color/assist_4_D9"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/main"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:text="@string/done"/>
    </LinearLayout>
</RelativeLayout>
