<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_time_label_position"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp">
        <View style="@style/BorderView"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_14"
            android:id="@+id/tv_time_label_position_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/watch_face_time_position"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_10"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_time_label_position_tips"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/device_custom_watch_face_position_tips"
            android:layout_below="@+id/tv_time_label_position_title"
            android:layout_marginEnd="2dp"
            android:layout_toStartOf="@+id/tv_time_label_position"/>
        <ImageView
            android:id="@+id/iv_time_label_position_arrow"
            style="@style/ContinueArrow"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:id="@+id/tv_time_label_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/iv_time_label_position_arrow"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_wp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View style="@style/BorderView"/>
        <View
            android:background="@drawable/shape_wheel_back_7dp"
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_centerVertical="true"/>
        <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
            android:id="@+id/wp_time_position"
            android:background="@color/translucent"
            android:layout_width="match_parent"
            android:layout_height="164dp"
            aigestudio:wheel_atmospheric="true"
            aigestudio:wheel_curved="true"
            aigestudio:wheel_cyclic="false"
            aigestudio:wheel_indicator_size="60dp"
            aigestudio:wheel_item_align="center"
            aigestudio:wheel_item_space="60dp"
            aigestudio:wheel_item_text_color="@color/grey"
            aigestudio:wheel_item_text_size="22dp"
            aigestudio:wheel_same_width="false"
            aigestudio:wheel_selected_item_text_color="@color/black"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_top_label"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <View style="@style/BorderView"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch_face_time_position_top_content"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_top_label_arrow"
            style="@style/ContinueArrow"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:id="@+id/tv_top_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/iv_top_label_arrow"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_top_wp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View style="@style/BorderView"/>
        <View
            android:background="@drawable/shape_wheel_back_7dp"
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_centerVertical="true"/>
        <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
            android:id="@+id/wp_time_top"
            android:background="@color/translucent"
            android:layout_width="match_parent"
            android:layout_height="164dp"
            aigestudio:wheel_atmospheric="true"
            aigestudio:wheel_curved="true"
            aigestudio:wheel_cyclic="false"
            aigestudio:wheel_indicator_size="60dp"
            aigestudio:wheel_item_align="center"
            aigestudio:wheel_item_space="60dp"
            aigestudio:wheel_item_text_color="@color/grey"
            aigestudio:wheel_item_text_size="22dp"
            aigestudio:wheel_same_width="false"
            aigestudio:wheel_selected_item_text_color="@color/black"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_bottom_label"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <View style="@style/BorderView"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch_face_time_position_bottom_content"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_bottom_label_arrow"
            style="@style/ContinueArrow"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:id="@+id/tv_bottom_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/iv_bottom_label_arrow"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_bottom_wp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View style="@style/BorderView"/>
        <View
            android:background="@drawable/shape_wheel_back_7dp"
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_centerVertical="true"/>
        <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
            android:id="@+id/wp_time_bottom"
            android:background="@color/translucent"
            android:layout_width="match_parent"
            android:layout_height="164dp"
            aigestudio:wheel_atmospheric="true"
            aigestudio:wheel_curved="true"
            aigestudio:wheel_cyclic="false"
            aigestudio:wheel_indicator_size="60dp"
            aigestudio:wheel_item_align="center"
            aigestudio:wheel_item_space="60dp"
            aigestudio:wheel_item_text_color="@color/grey"
            aigestudio:wheel_item_text_size="22dp"
            aigestudio:wheel_same_width="false"
            aigestudio:wheel_selected_item_text_color="@color/black"/>
    </RelativeLayout>
    <include
        android:id="@+id/include_color_picker"
        layout="@layout/layout_new_watch_face_label_color_picker"/>
</LinearLayout>
