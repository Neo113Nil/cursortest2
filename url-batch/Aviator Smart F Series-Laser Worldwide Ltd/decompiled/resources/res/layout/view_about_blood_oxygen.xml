<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_blood_oxygen_bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/color_blood_oxygen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/find_blood_oxygen"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/color_blood_oxygen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/blood_oxygen_description"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/color_blood_oxygen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/normal_blood_oxygen_range"/>
</LinearLayout>
