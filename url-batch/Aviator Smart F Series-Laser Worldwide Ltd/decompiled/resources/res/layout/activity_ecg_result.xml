<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_title_bar"
        layout="@layout/data_title_bar"/>
    <com.crrepa.band.my.health.ecg.view.EcgView
        android:id="@+id/ecgview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="60dp"
        app:ecg_background="@color/color_ecg_chart_bg"
        app:ecg_line_color="@color/black"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:id="@+id/tv_ecg_average_heart_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/ecg_average_heart_rate"
        android:layout_alignBottom="@+id/ecgview"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:id="@+id/tv_ecg_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/ecg_speed"
        android:layout_alignBottom="@+id/ecgview"
        android:layout_marginEnd="20dp"
        android:layout_alignEnd="@+id/ecgview"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/ecg_gain"
        android:layout_alignBottom="@+id/ecgview"
        android:layout_marginEnd="30dp"
        android:layout_toStartOf="@+id/tv_ecg_speed"/>
    <com.crrepa.band.my.health.ecg.view.EcgView
        android:id="@+id/thumbnail_ecgview"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        app:ecg_background="@color/color_ecg_chart_bg"
        app:ecg_line_color="@color/black"/>
    <com.moyoung.dafit.module.common.widgets.DragImageView
        android:id="@+id/iv_drag"
        android:background="0x7f080231"
        android:layout_width="64dp"
        android:layout_height="34dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_above="@+id/thumbnail_ecgview">
        <TextView
            android:textSize="@dimen/text_size_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"/>
        <androidx.legacy.widget.Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:07"/>
        <androidx.legacy.widget.Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:15"/>
        <androidx.legacy.widget.Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:22"/>
        <androidx.legacy.widget.Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:30"/>
    </LinearLayout>
</RelativeLayout>
