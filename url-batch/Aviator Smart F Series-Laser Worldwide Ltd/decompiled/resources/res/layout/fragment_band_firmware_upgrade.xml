<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/dark_grey"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/band_upgrade_hint"
        android:lineSpacingExtra="5dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_upgrade_animation"
        android:layout_width="106dp"
        android:layout_height="106dp"
        android:layout_marginTop="80dp"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/grey"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_upgrade_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"/>
    <ProgressBar
        android:layout_gravity="center_horizontal"
        android:id="@+id/pb_upgrade_percent"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressDrawable="@drawable/progressbar_horizontal_firmware_upgrade"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        style="@style/ProgressBarHorizontal"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_upgrade_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"/>
    <Button
        android:id="@+id/btn_upgrade_complete"
        android:visibility="gone"
        android:layout_marginTop="40dp"
        android:text="@string/done"
        android:textAllCaps="false"
        style="@style/BottomButton"/>
</LinearLayout>
