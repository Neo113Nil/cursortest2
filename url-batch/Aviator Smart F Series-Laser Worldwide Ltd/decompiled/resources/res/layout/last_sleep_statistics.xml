<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="246dp"
    android:paddingStart="26dp"
    android:paddingEnd="26dp">
    <include
        android:id="@+id/include_last_statistics"
        layout="@layout/band_last_statistics"/>
    <include
        android:id="@+id/include_sleep_state_description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        layout="@layout/three_section_description"/>
    <include
        android:id="@+id/include_sleep_time_description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        layout="@layout/sleep_three_section_time_description"/>
    <include
        android:id="@+id/include_sleep_time_segment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        layout="@layout/sleep_time_segment_view"/>
    <include
        android:id="@+id/include_not_data_hint"
        layout="@layout/not_data_hint_view"/>
</LinearLayout>
