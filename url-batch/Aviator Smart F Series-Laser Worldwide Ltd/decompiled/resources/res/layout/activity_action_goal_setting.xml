<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <ImageView
            android:id="@+id/iv_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="23dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_title"
            android:layout_centerInParent="true"
            style="@style/CollapsingToolbarLayoutCollapsedTitle"/>
        <TextView
            android:textColor="@color/main"
            android:id="@+id/tv_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/done"
            android:layout_centerVertical="true"
            android:layout_marginEnd="23dp"
            android:layout_alignParentEnd="true"
            style="@style/CollapsingToolbarLayoutCollapsedTitle"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:paddingStart="23dp"
        android:paddingEnd="23dp">
        <View
            android:background="@drawable/shape_wheel_view_indicator"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp">
            <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
                android:id="@+id/wp_goal_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                aigestudio:wheel_atmospheric="true"
                aigestudio:wheel_curved="true"
                aigestudio:wheel_cyclic="false"
                aigestudio:wheel_item_align="center"
                aigestudio:wheel_item_text_color="@color/grey"
                aigestudio:wheel_item_text_size="22sp"
                aigestudio:wheel_selected_item_text_color="@color/black"
                aigestudio:wheel_visible_item_count="8"/>
            <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
                android:id="@+id/wp_goal_unit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                aigestudio:wheel_atmospheric="true"
                aigestudio:wheel_curved="true"
                aigestudio:wheel_cyclic="false"
                aigestudio:wheel_item_align="center"
                aigestudio:wheel_item_text_color="@color/grey"
                aigestudio:wheel_item_text_size="22sp"
                aigestudio:wheel_selected_item_text_color="@color/black"/>
            <com.moyoung.dafit.module.common.widgets.wheelpicker.WheelPicker
                android:id="@+id/wp_goal_second"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                aigestudio:wheel_atmospheric="true"
                aigestudio:wheel_curved="true"
                aigestudio:wheel_cyclic="false"
                aigestudio:wheel_item_align="center"
                aigestudio:wheel_item_text_color="@color/grey"
                aigestudio:wheel_item_text_size="22sp"
                aigestudio:wheel_selected_item_text_color="@color/black"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
