<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <EditText
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/dark_grey"
        android:textColorHint="@color/color_edittext_hint"
        android:id="@+id/et_response_content"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:hint="@string/sms_can_not_empty"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="5dp"
        android:layout_toStartOf="@+id/iv_delete_response"/>
    <ImageView
        android:id="@+id/iv_delete_response"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="0x7f0801f4"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/line_response"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/et_response_content"
        style="@style/BorderView"/>
</RelativeLayout>
