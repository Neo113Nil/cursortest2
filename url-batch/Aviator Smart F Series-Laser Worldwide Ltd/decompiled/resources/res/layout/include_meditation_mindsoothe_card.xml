<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_mindsoothe"
    android:layout_width="match_parent"
    android:layout_height="125dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:layout_marginEnd="20dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false">
    <ImageView
        android:id="@+id/iv_mindsoothe_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="0x7f08008e"
        android:scaleType="centerCrop"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f08008c"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="137dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#dad5ff"
            android:gravity="center_vertical"
            android:id="@+id/tv_mindsoothe_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meditation_app_name"
            android:drawablePadding="5dp"
            android:drawableEnd="0x7f0801a5"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#dad5ff"
            android:gravity="center_vertical"
            android:id="@+id/tv_mindsoothe_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/meditation_app_home_content"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:textSize="9sp"
                android:textColor="#4054ae"
                android:gravity="center_vertical"
                android:background="@drawable/shape_meditation_mindsoothe_text_bg_1"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:text="@string/meditation_app_white_noise"/>
            <TextView
                android:textSize="9sp"
                android:textColor="#4054ae"
                android:gravity="center_vertical"
                android:background="@drawable/shape_meditation_mindsoothe_text_bg_2"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:text="@string/meditation_app_meditation_course"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
