<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/shape_permission_dialog_bg"
        android:paddingLeft="48dp"
        android:paddingTop="10dp"
        android:paddingRight="48dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp">
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/assist_14"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_10"
            android:gravity="center"
            android:id="@+id/tv_content_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_7"
            android:gravity="center"
            android:id="@+id/tv_tips"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/assist_1_ff"
            android:gravity="center"
            android:id="@+id/btn_enable"
            android:background="@drawable/shape_guidance_remind_dialog_btn_bg"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:text="@string/guidance_permission_enable"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/popup_btn"
            android:gravity="center"
            android:id="@+id/btn_not_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="25dp"
            android:text="@string/guidance_permission_not_now"/>
    </LinearLayout>
</FrameLayout>
