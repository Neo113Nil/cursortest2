<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="0x7f0805fd"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_top"
        layout="@layout/include_guidance_top_view"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rl_bottom"
        android:background="@drawable/shape_guidance_set_user_info_bg"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/assist_14"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/guidance_gender_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_11"
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/guidance_gender_content"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_male"
            android:background="@drawable/selector_guidance_gender_btn_bg"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:minWidth="177dp">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/selector_guidance_gender_color"
                android:gravity="center"
                android:id="@+id/tv_male"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender_male"
                android:drawablePadding="15dp"
                app:drawableStartCompat="@drawable/selector_guidance_gender_male"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_female"
            android:background="@drawable/selector_guidance_gender_btn_bg"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:minWidth="177dp">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/selector_guidance_gender_color"
                android:gravity="center"
                android:id="@+id/tv_female"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender_female"
                android:drawablePadding="15dp"
                app:drawableStartCompat="@drawable/selector_guidance_gender_female"/>
        </LinearLayout>
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="38dp"
            app:cornerRadius="22dp"
            app:shadowColor="@color/main_btn"
            app:shadowRadius="8dp">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_next"
                android:background="@drawable/shape_private_policy_agree"
                android:layout_width="270dp"
                android:layout_height="44dp"
                android:text="@string/next"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
    </LinearLayout>
</RelativeLayout>
