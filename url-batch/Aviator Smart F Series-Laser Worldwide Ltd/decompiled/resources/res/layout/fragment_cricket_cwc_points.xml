<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_cricket_tab_corner_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_8_A9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cricket_team"
            android:layout_weight="5"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_8_A9"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cricket_pl"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_8_A9"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cricket_w"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_8_A9"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cricket_l"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_8_A9"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cricket_pts"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_cwc_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
