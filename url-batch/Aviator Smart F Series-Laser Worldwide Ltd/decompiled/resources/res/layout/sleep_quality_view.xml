<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingTop="17dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="26dp"
    android:paddingEnd="26dp">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/rl_value"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_sleep_quality_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_quality"/>
            <ImageView
                android:id="@+id/iv_help"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0801e5"
                android:baselineAlignBottom="true"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/rl_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/text_size_28"
                android:textStyle="bold"
                android:textColor="@color/color_sleep"
                android:id="@+id/tv_sleep_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fraction"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@+id/tv_sleep_quality"/>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:layout_marginTop="17dp"
        style="@style/BorderView"/>
    <include
        android:id="@+id/include_sleep_quality_segment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        layout="@layout/sleep_quality_segment_view"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_sleep_quality_bg"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            android:textColor="@color/color_sleep_quality_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/find_sleep_quality"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/color_sleep_quality_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sleep_quality_description"
            android:lineSpacingExtra="6dp"/>
    </LinearLayout>
</LinearLayout>
