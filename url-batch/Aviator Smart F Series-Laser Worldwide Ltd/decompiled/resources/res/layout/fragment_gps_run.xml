<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_20"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_run_start"
        android:background="@drawable/selector_gps_run"
        android:paddingTop="66dp"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:text="@string/start"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/dark_grey"
        android:gravity="center"
        android:id="@+id/tv_gps_state"
        android:background="0x7f080092"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:minWidth="120dp"
        android:layout_below="@+id/tv_run_start"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="120sp"
        android:textColor="@color/color_gps_run"
        android:gravity="center"
        android:id="@+id/tv_run_countdown"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="3"/>
</RelativeLayout>
