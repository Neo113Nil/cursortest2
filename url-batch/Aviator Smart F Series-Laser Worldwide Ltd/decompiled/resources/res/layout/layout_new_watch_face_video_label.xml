<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_watch_face_time_position"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="45dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch_face_time_position"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_watch_face_time_position_arrow"
            style="@style/ContinueArrow"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:id="@+id/tv_watch_face_time_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/iv_watch_face_time_position_arrow"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_watch_face_time_position_top_content"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <View style="@style/BorderView"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch_face_time_position_top_content"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_watch_face_time_position_top_arrow"
            style="@style/ContinueArrow"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:id="@+id/tv_watch_face_time_position_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/iv_watch_face_time_position_top_arrow"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_watch_face_time_position_bottom_content"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <View style="@style/BorderView"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watch_face_time_position_bottom_content"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_watch_face_time_position_bottom_arrow"
            style="@style/ContinueArrow"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/grey"
            android:id="@+id/tv_watch_face_time_position_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/iv_watch_face_time_position_bottom_arrow"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <View style="@style/BorderView"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/watch_face_text_color"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/rg_watch_face_text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true">
            <RadioButton
                android:id="@+id/rb_watch_face_text_color_white"
                android:drawableStart="@drawable/selector_watch_face_text_color_white"
                style="@style/WatchFaceTextColorRadioButton"/>
            <RadioButton
                android:id="@+id/rb_watch_face_text_color_black"
                android:checked="false"
                android:drawableStart="@drawable/selector_watch_face_text_color_black"
                style="@style/WatchFaceTextColorRadioButton"/>
            <RadioButton
                android:id="@+id/rb_watch_face_text_color_yellow"
                android:checked="false"
                android:drawableStart="@drawable/selector_watch_face_text_color_yellow"
                style="@style/WatchFaceTextColorRadioButton"/>
            <RadioButton
                android:id="@+id/rb_watch_face_text_color_origin"
                android:checked="false"
                android:drawableStart="@drawable/selector_watch_face_text_color_origin"
                style="@style/WatchFaceTextColorRadioButton"/>
            <RadioButton
                android:id="@+id/rb_watch_face_text_color_red"
                android:checked="false"
                android:drawableStart="@drawable/selector_watch_face_text_color_red"
                style="@style/WatchFaceTextColorRadioButton"/>
            <RadioButton
                android:id="@+id/rb_watch_face_text_color_purple"
                android:checked="false"
                android:drawableStart="@drawable/selector_watch_face_text_color_purple"
                style="@style/WatchFaceTextColorRadioButton"/>
            <RadioButton
                android:id="@+id/rb_watch_face_text_color_blue"
                android:checked="false"
                android:drawableStart="@drawable/selector_watch_face_text_color_blue"
                style="@style/WatchFaceTextColorRadioButton"/>
            <RadioButton
                android:id="@+id/rb_watch_face_text_color_indigo"
                android:drawableStart="@drawable/selector_watch_face_text_color_indigo"
                style="@style/WatchFaceTextColorRadioButton"/>
            <RadioButton
                android:id="@+id/rb_watch_face_text_color_green"
                android:drawableStart="@drawable/selector_watch_face_text_color_green"
                style="@style/WatchFaceTextColorRadioButton"/>
        </RadioGroup>
    </RelativeLayout>
    <View
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/BorderView"/>
</LinearLayout>
