<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="62dp">
    <ImageView
        android:id="@+id/iv_message_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="0x7f08041f"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:id="@+id/tv_message_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/iv_message_icon"/>
    <com.kyleduo.switchbutton.SwitchButton
        android:id="@+id/sbtn_message"
        app:kswAnimationDuration="300"
        app:kswBackDrawable="@drawable/switch_button_back_color"
        app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
        app:kswThumbHeight="24dp"
        app:kswThumbMarginBottom="1dp"
        app:kswThumbMarginLeft="1dp"
        app:kswThumbMarginRight="1dp"
        app:kswThumbMarginTop="1dp"
        app:kswThumbWidth="24dp"
        style="@style/SwitchButoonStyle"/>
    <View
        android:layout_alignParentBottom="true"
        style="@style/BorderView"/>
</RelativeLayout>
