<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="95dp">
    <View style="@style/BorderView"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/assist_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/watch_face_text_color"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true">
        <RadioButton
            android:id="@+id/rb_color_white"
            android:drawableStart="@drawable/selector_watch_face_text_color_white"
            style="@style/WatchFaceTextColorRadioButton"/>
        <RadioButton
            android:id="@+id/rb_color_black"
            android:checked="false"
            android:drawableStart="@drawable/selector_watch_face_text_color_black"
            style="@style/WatchFaceTextColorRadioButton"/>
        <RadioButton
            android:id="@+id/rb_color_yellow"
            android:checked="false"
            android:drawableStart="@drawable/selector_watch_face_text_color_yellow"
            style="@style/WatchFaceTextColorRadioButton"/>
        <RadioButton
            android:id="@+id/rb_color_origin"
            android:checked="false"
            android:drawableStart="@drawable/selector_watch_face_text_color_origin"
            style="@style/WatchFaceTextColorRadioButton"/>
        <RadioButton
            android:id="@+id/rb_color_red"
            android:checked="false"
            android:drawableStart="@drawable/selector_watch_face_text_color_red"
            style="@style/WatchFaceTextColorRadioButton"/>
        <RadioButton
            android:id="@+id/rb_color_purple"
            android:checked="false"
            android:drawableStart="@drawable/selector_watch_face_text_color_purple"
            style="@style/WatchFaceTextColorRadioButton"/>
        <RadioButton
            android:id="@+id/rb_color_blue"
            android:checked="false"
            android:drawableStart="@drawable/selector_watch_face_text_color_blue"
            style="@style/WatchFaceTextColorRadioButton"/>
        <RadioButton
            android:id="@+id/rb_color_indigo"
            android:drawableStart="@drawable/selector_watch_face_text_color_indigo"
            style="@style/WatchFaceTextColorRadioButton"/>
        <RadioButton
            android:id="@+id/rb_color_green"
            android:drawableStart="@drawable/selector_watch_face_text_color_green"
            style="@style/WatchFaceTextColorRadioButton"/>
    </RadioGroup>
</RelativeLayout>
