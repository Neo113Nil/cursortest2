<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_title_bar"
        layout="@layout/app_toolbar"/>
    <com.crrepa.band.my.health.widgets.MyNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/light_gray"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tl_hr_statistics_tab"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:tabBackground="@color/color_heart_rate"
                app:tabIndicatorColor="@color/white"
                app:tabIndicatorHeight="3dp"
                app:tabRippleColor="@null"/>
            <com.crrepa.band.my.health.widgets.NoScrollViewPager
                android:id="@+id/vp_hr_statistics_content"
                android:layout_width="match_parent"
                android:layout_height="235dp"/>
            <include
                android:id="@+id/include_heart_rate_analysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/heart_rate_analysis_view"/>
        </LinearLayout>
    </com.crrepa.band.my.health.widgets.MyNestedScrollView>
</LinearLayout>
