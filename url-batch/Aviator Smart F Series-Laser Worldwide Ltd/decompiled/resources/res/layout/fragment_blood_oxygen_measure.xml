<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/light_gray"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="@color/color_blood_oxygen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/tv_bo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/data_blank"
                android:includeFontPadding="false"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white"
                android:id="@+id/tv_statistics_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/tv_bo"
                android:layout_centerHorizontal="true"/>
            <com.crrepa.band.my.health.widgets.BoDisplayView
                android:id="@+id/bo_display_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="30dp"
                android:layout_below="@+id/tv_statistics_date"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"/>
        </RelativeLayout>
        <include
            android:id="@+id/include_about_bo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            layout="@layout/view_about_bo"/>
        <include
            android:id="@+id/include_last_7_times_trend"
            android:layout_width="match_parent"
            android:layout_height="266dp"
            android:layout_marginTop="20dp"
            layout="@layout/last_7_times_trend_view"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
