<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/shape_weight_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/black"
        android:id="@+id/tv_goal_input_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="@string/water_setting_manual_input"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_goal_input"
        android:background="@drawable/shape_water_goal_input_bg"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginTop="47dp"
        android:layout_below="@+id/tv_goal_input_title"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/color_water"
            android:id="@+id/tv_goal_input_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/color_water"
        android:gravity="center"
        android:id="@+id/tv_goal_input_confirm"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginTop="23dp"
        android:layout_marginBottom="23dp"
        android:text="@string/confirm"
        android:layout_below="@+id/ll_goal_input"
        android:layout_centerHorizontal="true"/>
    <EditText
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/color_water"
        android:textColorHint="@color/assist_6_B3"
        android:id="@+id/et_goal_input"
        android:background="@null"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginTop="47dp"
        android:maxLength="5"
        android:layout_below="@+id/tv_goal_input_title"
        android:layout_centerHorizontal="true"
        android:inputType="number"
        android:paddingStart="8dp"/>
</RelativeLayout>
