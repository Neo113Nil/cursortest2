<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_bg_5_function"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/analysis_bg_2_nav"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0801df"
            android:layout_centerVertical="true"
            app:tint="@color/physicalt_assist_1_nav"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/physicalt_assist_1_nav"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/training_analysis"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@+id/iv_calendar"
            android:layout_toEndOf="@+id/iv_close"/>
        <ImageView
            android:id="@+id/iv_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_title_calendar_w"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:tint="@color/physicalt_assist_1_nav"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_training_load"
        android:background="@color/physical_bg_5_detail"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_load_title"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/tv_training_load"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/analysis_main_1_word"
            android:id="@+id/tv_training_load"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="2dp"
            android:layout_toStartOf="@+id/iv_training_load_continue"/>
        <ImageView
            android:id="@+id/iv_training_load_continue"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="0x7f0801ec"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_acwr"
        android:background="@color/recovery_bg_5_detail"
        android:paddingLeft="20dp"
        android:paddingTop="17dp"
        android:paddingRight="20dp"
        android:paddingBottom="17dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_14"
            android:id="@+id/tv_acwr_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_acwr_title"
            android:drawablePadding="6dp"
            app:drawableEndCompat="0x7f0801f7"/>
        <View
            android:id="@+id/line"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:layout_below="@+id/tv_acwr_title"
            style="@style/BorderView"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line">
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/analysis_main_1_word"
                    android:id="@+id/tv_training_load_short_term"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/data_blank"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/training_load_short_term"
                    android:layout_below="@+id/tv_training_load_short_term"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="2dp"/>
            </RelativeLayout>
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/assist_6"
                android:layout_width="1dp"
                android:layout_height="35dp"/>
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/analysis_main_1_word"
                    android:id="@+id/tv_training_load_long_term"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/data_blank"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/training_load_long_term"
                    android:layout_below="@+id/tv_training_load_long_term"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="2dp"/>
            </RelativeLayout>
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/assist_6"
                android:layout_width="1dp"
                android:layout_height="35dp"/>
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/analysis_main_1_word"
                    android:id="@+id/tv_training_acwr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/data_blank"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/training_acwr_title"
                    android:layout_below="@+id/tv_training_acwr"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="2dp"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:background="@color/physical_bg_5_detail"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/assist_14"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_training_status_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/training_status_title"
            android:drawablePadding="6dp"
            android:layout_weight="1"
            android:layout_marginEnd="20dp"
            app:drawableEndCompat="0x7f0801f7"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/analysis_main_1_word"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_training_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/training_status_none"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
