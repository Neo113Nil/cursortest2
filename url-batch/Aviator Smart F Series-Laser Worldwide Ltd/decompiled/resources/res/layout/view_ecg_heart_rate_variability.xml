<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rl_heart_rate_variability"
    android:background="@color/white"
    android:paddingBottom="30dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="26dp"
    android:paddingEnd="26dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate_variability_parentheses"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_28"
            android:textStyle="bold"
            android:textColor="@color/color_ecg"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_heart_rate_variability_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <View style="@style/BorderView"/>
    <com.crrepa.band.my.health.widgets.segmentedbar.SegmentedBarView
        android:id="@+id/heart_rate_variability_slider_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:sbv_arrow_height="5dp"
        app:sbv_arrow_width="10dp"
        app:sbv_bar_height="14dp"
        app:sbv_descriptionAlign="Both"
        app:sbv_descriptionTopAlign="Center"
        app:sbv_segment_bg="false"
        app:sbv_segment_gap_width="0dp"
        app:sbv_segment_rule="average"
        app:sbv_show_description_text="false"
        app:sbv_show_description_top_text="false"
        app:sbv_show_segment_text="false"
        app:sbv_side_style="normal"
        app:sbv_side_text_style="oneSided"
        app:sbv_sliderType="Sign"
        app:sbv_value_sign_background="@color/color_ecg"
        app:sbv_value_sign_height="7dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zero"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hundred"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@drawable/shape_heart_rate_variability_bg"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/color_ecg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/learn_heart_rate_variability"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/color_ecg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="@string/heart_rate_variability_description"/>
    </RelativeLayout>
</LinearLayout>
