<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/color_weight"
    android:layout_width="match_parent"
    android:layout_height="358dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_weight_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_weight_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/data_blank"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_weight_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_weight_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_weight_num"
        android:layout_centerHorizontal="true"/>
    <com.moyoung.dafit.module.common.widgets.chart.WeightLineChart
        android:id="@+id/weight_line_chart"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginBottom="40dp"
        android:layout_alignParentBottom="true"/>
    <View
        android:background="@color/light_gray"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"/>
    <com.crrepa.band.my.health.widgets.HandleView
        android:id="@+id/hr_handle_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"/>
</RelativeLayout>
