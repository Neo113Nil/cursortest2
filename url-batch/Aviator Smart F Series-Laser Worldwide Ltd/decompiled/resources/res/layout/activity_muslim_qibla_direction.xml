<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/top_bar"
        layout="@layout/band_data_appbar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/tv_gps_off_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                layout="@layout/layout_location_off"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_angle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <RelativeLayout
                    android:background="@drawable/shape_muslim_direction_bg"
                    android:layout_width="0dp"
                    android:layout_height="71dp"
                    android:layout_weight="1"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">
                    <ImageView
                        android:id="@+id/iv_device_angle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080471"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/tv_device_angle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="15dp"
                        android:layout_toEndOf="@+id/iv_device_angle"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/assist_10_66"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/muslim_device_angle"
                        android:layout_below="@+id/tv_device_angle"
                        android:layout_marginStart="15dp"
                        android:layout_toEndOf="@+id/iv_device_angle"/>
                </RelativeLayout>
                <RelativeLayout
                    android:background="@drawable/shape_muslim_direction_bg"
                    android:layout_width="0dp"
                    android:layout_height="71dp"
                    android:layout_weight="1"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:layout_marginStart="12dp">
                    <ImageView
                        android:id="@+id/iv_muslim_angle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080473"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/tv_muslim_angle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginStart="15dp"
                        android:layout_toEndOf="@+id/iv_muslim_angle"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/assist_10_66"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/muslim_qibla_angle"
                        android:layout_below="@+id/tv_muslim_angle"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_toEndOf="@+id/iv_muslim_angle"/>
                </RelativeLayout>
            </LinearLayout>
            <com.crrepa.band.my.device.muslim.view.CompassView
                android:layout_gravity="center"
                android:id="@+id/compass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
