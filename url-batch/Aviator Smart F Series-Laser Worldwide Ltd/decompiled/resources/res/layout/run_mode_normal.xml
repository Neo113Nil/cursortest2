<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:CircleProgressView="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_run_normal"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_runing_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="70sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_runing_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_runing_distance_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/distance_unit_km"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_runing_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/ll_runing_distance"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="30sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_runing_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_runing_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_runing_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"/>
    </LinearLayout>
    <View
        android:id="@+id/view_first_line"
        android:background="@color/dark_grey"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="30dp"
        android:layout_marginTop="74dp"
        android:layout_below="@+id/ll_runing_time"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_runing_firstline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_below="@+id/ll_runing_time">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_running_calorie"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/black"
                android:id="@+id/tv_runing_calories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dark_grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/run_calorie"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/black"
                android:id="@+id/tv_runing_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00&apos;00&apos;&apos;"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dark_grey"
                android:id="@+id/tv_runing_speed_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/run_speed"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/view_second_line"
        android:background="@color/dark_grey"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="30dp"
        android:layout_marginTop="44dp"
        android:layout_below="@+id/ll_runing_firstline"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_runing_secondline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/ll_runing_firstline">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_running_steps"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/black"
                android:id="@+id/tv_runing_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dark_grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/run_steps"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_running_hr"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/black"
                android:id="@+id/tv_runing_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dark_grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/run_heart"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_runing_pause"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:layout_below="@+id/ll_runing_secondline"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_runing_pause"
            android:background="@drawable/selector_run_pause"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_centerInParent="true"/>
        <com.moyoung.dafit.module.common.widgets.CircleProgressView
            android:id="@+id/cpv_runing_pasue_progress"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_centerInParent="true"
            CircleProgressView:endColor="@color/color_gps_run"
            CircleProgressView:max="100"
            CircleProgressView:min="0"
            CircleProgressView:progress="0"
            CircleProgressView:ringBias="0.1"
            CircleProgressView:startColor="@color/color_gps_run"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/white"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:text="@string/training_pause"
            android:layout_centerInParent="true"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_runing_option"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_runing_secondline"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/tv_runing_finish"
            android:background="@drawable/selector_run_pause"
            android:paddingTop="40dp"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:text="@string/training_end"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/tv_runing_continue"
            android:background="@drawable/selector_run_pause"
            android:paddingTop="40dp"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:text="@string/training_continue"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginStart="50dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_runing_gps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true">
        <ImageView
            android:background="0x7f080282"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:id="@+id/tv_runing_gps_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_status_disenable"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_runing_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true">
        <ImageView
            android:background="@drawable/selector_run_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/run_map_mode"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</RelativeLayout>
