<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll"
        android:background="@drawable/shape_bg_custom_uploading_dialog"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/assist_13_00"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_9_99"
            android:gravity="center"
            android:id="@+id/tv_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
        <ProgressBar
            android:id="@+id/pb"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:max="100"
            android:progressDrawable="@drawable/custom_uploading_horizontal_progressbar"
            style="@style/ProgressBarHorizontal"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/assist_15"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"/>
    </LinearLayout>
</FrameLayout>
