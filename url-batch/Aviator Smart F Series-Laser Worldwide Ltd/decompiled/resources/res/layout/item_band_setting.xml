<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="79dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <View style="@style/BorderView"/>
    <ImageView
        android:id="@+id/iv_setting_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:id="@+id/tv_setting_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/iv_setting_icon"/>
    <ImageView
        android:id="@+id/iv_badge"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:src="@drawable/shape_new_version"
        android:layout_alignTop="@+id/tv_setting_name"
        android:layout_toEndOf="@+id/tv_setting_name"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_continue"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
