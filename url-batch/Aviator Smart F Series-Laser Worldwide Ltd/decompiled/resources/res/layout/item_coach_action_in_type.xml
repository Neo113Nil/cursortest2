<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="77dp">
        <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
            android:id="@+id/iv_cover"
            android:layout_width="117dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:riv_corner_radius="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/assist_13_00"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@+id/iv_cover"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_10_66"
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/tv_title"
            android:layout_alignStart="@+id/tv_title"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_rest"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/assist_8_A9"
            android:gravity="center"
            android:background="@drawable/shape_coach_rest_bg"
            android:layout_width="117dp"
            android:layout_height="32dp"
            android:text="@string/course_fitness_action_breaks_text"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_8_A9"
            android:id="@+id/tv_rest_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
</LinearLayout>
