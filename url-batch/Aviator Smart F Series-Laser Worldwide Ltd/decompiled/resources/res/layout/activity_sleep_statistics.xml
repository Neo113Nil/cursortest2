<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_title_bar"
        layout="@layout/app_toolbar"/>
    <com.crrepa.band.my.health.widgets.MyNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/light_gray"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tl_sleep_statistics_tab"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:tabBackground="@color/sleep_bg_3_title"
                app:tabIndicatorColor="@color/white"
                app:tabIndicatorHeight="3dp"
                app:tabRippleColor="@null"/>
            <View
                android:background="@color/sleep_bg_3_title"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>
            <com.crrepa.band.my.health.widgets.NoScrollViewPager
                android:id="@+id/vp_sleep_statistics_content"
                android:layout_width="match_parent"
                android:layout_height="315dp"/>
            <include
                android:id="@+id/include_nap"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                layout="@layout/sleep_nap_day"/>
            <include
                android:id="@+id/include_sleep_ratio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                layout="@layout/sleep_ratio"/>
            <include
                android:id="@+id/include_sleep_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/sleep_quality_view"/>
            <include
                android:id="@+id/include_mindsoothe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/include_sleep_mindsoothe_card"/>
            <include
                android:id="@+id/include_heart_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/view_sleep_heart_rate"/>
            <include
                android:id="@+id/include_blood_oxygen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/view_sleep_blood_oxygen"/>
            <include
                android:id="@+id/include_last_week_sleep_trend"
                android:layout_width="match_parent"
                android:layout_height="266dp"
                android:layout_marginTop="20dp"
                layout="@layout/last_week_sleep_trend"/>
            <include
                android:id="@+id/include_sleep_early_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/view_sleep_early_chart"/>
            <include
                android:id="@+id/include_get_up_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/view_get_up_chart"/>
            <include
                android:id="@+id/include_less_sleep_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/view_less_sleep_chart"/>
        </LinearLayout>
    </com.crrepa.band.my.health.widgets.MyNestedScrollView>
</LinearLayout>
