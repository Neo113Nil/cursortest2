<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="254dp"
    android:layout_height="180dp"
    android:layout_marginEnd="12dp">
    <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
        android:id="@+id/iv_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:riv_corner_radius="12dp"/>
    <View
        android:background="@drawable/shape_meditation_local_class_cover_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/assist_1_ff"
        android:id="@+id/tv_white_noise_title"
        android:background="@drawable/shape_sound_effect_home_tv_bg"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:text="River"
        android:drawablePadding="6dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="18dp"
        app:drawableStartCompat="@mipmap/ic_meditation_in_play"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/assist_1_ff"
        android:id="@+id/tv_class_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tv_white_noise_title"
        android:layout_alignStart="@+id/tv_white_noise_title"/>
    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginBottom="18dp"
        android:src="@mipmap/ic_meditation_class_play"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="18dp"
        android:layout_alignEnd="@+id/iv_cover"/>
</RelativeLayout>
