<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/shape_cricket_tab_half_bottom_corner"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_match_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_13_00"
            android:id="@+id/tv_match_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/assist_8_A9"
            android:id="@+id/tv_match_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rl_match_state"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_alignParentEnd="true">
        <View
            android:background="@color/assist_4_ED"
            android:layout_width="1dp"
            android:layout_height="44dp"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/bg_1_ff"
            android:id="@+id/btn_reserve"
            android:background="@drawable/shape_cricket_reserve"
            android:layout_width="60dp"
            android:layout_height="26dp"
            android:text="@string/cricket_match_reserve"
            android:layout_centerInParent="true"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/tv_match_end"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cricket_match_over"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_toStartOf="@+id/rl_match_state"
        android:layout_toEndOf="@+id/ll_match_time">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_first_team"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080245"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_13_00"
                android:id="@+id/tv_first_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_13_00"
                android:id="@+id/tv_first_team_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TBD"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toStartOf="@+id/tv_first_points"
                android:layout_toEndOf="@+id/iv_first_team"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <ImageView
                android:id="@+id/iv_second_team"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080245"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_13_00"
                android:id="@+id/tv_second_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_13_00"
                android:id="@+id/tv_second_team_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cricket_tbd"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toStartOf="@+id/tv_second_points"
                android:layout_toEndOf="@+id/iv_second_team"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:id="@+id/border"
        android:layout_alignParentBottom="true"
        style="@style/BorderView"/>
</RelativeLayout>
