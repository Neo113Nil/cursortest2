<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_nap"
    android:background="@color/sleep_bg_4_detail"
    android:paddingTop="11dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/assist_14"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/health_sleep_nap_title"/>
    <ImageView
        android:id="@+id/iv_tips"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="0x7f08028b"
        android:layout_alignTop="@+id/tv_title"
        android:layout_alignBottom="@+id/tv_title"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/tv_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_nap_total_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/sleep_main_1_word"
            android:gravity="bottom"
            android:id="@+id/tv_nap_time_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_14"
            android:layout_gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/hour"
            android:layout_marginStart="2dp"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/sleep_main_1_word"
            android:id="@+id/tv_nap_time_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/assist_14"
            android:layout_gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/minute"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <View
        android:id="@+id/border"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/ll_nap_total_duration"
        style="@style/BorderView"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_nap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/border"/>
</RelativeLayout>
