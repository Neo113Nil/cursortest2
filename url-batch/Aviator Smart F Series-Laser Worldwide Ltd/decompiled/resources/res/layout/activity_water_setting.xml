<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/water_setting_bar"
        layout="@layout/app_toolbar"/>
    <com.crrepa.band.my.health.widgets.MyNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="78.5dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <TextView
                        android:textSize="@dimen/text_size_26"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_intake_reminder"/>
                    <TextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="@color/grey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_intake_reminder_note"/>
                </LinearLayout>
                <com.crrepa.band.my.device.muslim.view.SwitchButton
                    android:id="@+id/sbtn_water_intake_reminder"
                    android:layout_width="44dp"
                    android:layout_centerVertical="true"
                    app:kswAnimationDuration="300"
                    app:kswBackDrawable="@drawable/water_switch_button_back"
                    app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbMargin="1dp"
                    app:kswThumbWidth="28dp"
                    style="@style/SwitchButoonStyle"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_water_intake_reminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/ll_start_time"
                    android:layout_width="match_parent"
                    android:layout_height="70dp">
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_start_time"
                        android:layout_centerVertical="true"/>
                    <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
                        android:enabled="false"
                        android:id="@+id/mp_start_time_unit"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_toStartOf="@+id/mp_start_time_hour"
                        app:picker_show_wheel="show"
                        app:picker_wheel_cyclic="false"
                        app:picker_wheel_select_text_color="@color/color_water"
                        app:picker_wheel_text_bold="true"
                        app:picker_wheel_text_color="@color/color_water_text_unselected"
                        app:picker_wheel_type="1"/>
                    <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
                        android:enabled="false"
                        android:id="@+id/mp_start_time_hour"
                        android:layout_width="41.5dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_toStartOf="@+id/mp_start_time_minute"
                        app:picker_show_wheel="show"
                        app:picker_wheel_select_text_color="@color/color_water"
                        app:picker_wheel_text_bold="true"
                        app:picker_wheel_text_color="@color/color_water_text_unselected"
                        app:picker_wheel_type="1"/>
                    <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
                        android:enabled="false"
                        android:id="@+id/mp_start_time_minute"
                        android:layout_width="41.5dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_alignParentEnd="true"
                        app:picker_show_wheel="show"
                        app:picker_wheel_select_text_color="@color/color_water"
                        app:picker_wheel_text_bold="true"
                        app:picker_wheel_text_color="@color/color_water_text_unselected"
                        app:picker_wheel_type="1"/>
                    <View
                        android:layout_alignParentBottom="true"
                        style="@style/BorderView"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp">
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_reminder_times"
                        android:layout_centerVertical="true"/>
                    <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
                        android:enabled="false"
                        android:id="@+id/mp_reminder_times"
                        android:layout_width="41.5dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_toStartOf="@+id/tv_reminder_times_unit"
                        app:picker_show_wheel="show"
                        app:picker_wheel_select_text_color="@color/color_water"
                        app:picker_wheel_text_bold="true"
                        app:picker_wheel_text_color="@color/color_water_text_unselected"
                        app:picker_wheel_type="1"/>
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_water"
                        android:id="@+id/tv_reminder_times_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_times"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                    <View
                        android:layout_alignParentBottom="true"
                        style="@style/BorderView"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp">
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_interval_time"
                        android:layout_centerVertical="true"/>
                    <com.crrepa.band.my.device.pillreminder.picker.MyNumberPicker
                        android:enabled="false"
                        android:id="@+id/mp_interval_time_mins"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_toStartOf="@+id/tv_interval_time_unit"
                        app:picker_show_wheel="show"
                        app:picker_wheel_select_text_color="@color/color_water"
                        app:picker_wheel_text_bold="true"
                        app:picker_wheel_text_color="@color/color_water_text_unselected"
                        app:picker_wheel_type="1"/>
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_water"
                        android:id="@+id/tv_interval_time_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_mins"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                    <View
                        android:layout_alignParentBottom="true"
                        style="@style/BorderView"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_prompt_tip"
                    android:layout_width="match_parent"
                    android:layout_height="70dp">
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:text="@string/water_app_prompt_settings"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="@color/grey"
                        android:gravity="end"
                        android:id="@+id/tv_prompt_tip"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:drawablePadding="10dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:drawableRightCompat="0x7f0801ed"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rl_intake_goal"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="@dimen/text_size_26"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/water_intake_goal"
                    android:layout_centerVertical="true"/>
                <View
                    android:layout_alignParentBottom="true"
                    style="@style/BorderView"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_hand_intake_goal"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/black"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:text="@string/water_setting_set_intake_goal"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:textStyle="bold"
                    android:textColor="@color/color_water"
                    android:gravity="end"
                    android:id="@+id/tv_hand_intake_goal"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:drawablePadding="10dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:drawableRightCompat="0x7f0801ed"/>
                <View
                    android:layout_alignParentBottom="true"
                    style="@style/BorderView"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="32dp"
                    android:layout_toStartOf="@+id/tv_auto_intake_goal">
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_auto_calculation_goal"/>
                    <TextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="@color/grey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_auto_calculation_goal_note"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:textStyle="bold"
                    android:textColor="@color/color_water"
                    android:gravity="end"
                    android:id="@+id/tv_auto_intake_goal"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/sbtn_water_calculation"/>
                <com.crrepa.band.my.device.muslim.view.SwitchButton
                    android:id="@+id/sbtn_water_calculation"
                    android:layout_width="44dp"
                    android:layout_centerVertical="true"
                    app:kswAnimationDuration="300"
                    app:kswBackDrawable="@drawable/water_switch_button_back"
                    app:kswThumbDrawable="@drawable/selector_switch_button_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbMargin="1dp"
                    app:kswThumbWidth="28dp"
                    style="@style/SwitchButoonStyle"/>
                <View
                    android:id="@+id/view_auto_calculation_line"
                    android:layout_alignParentBottom="true"
                    style="@style/BorderView"/>
            </RelativeLayout>
        </LinearLayout>
    </com.crrepa.band.my.health.widgets.MyNestedScrollView>
</LinearLayout>
