<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        app:cardCornerRadius="@dimen/today_card_corner_radius"
        app:cardElevation="@dimen/today_card_elevation"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        style="@style/BandDataCardView">
        <include layout="@layout/today_sync_data"/>
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="118dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="10dp">
            <com.crrepa.band.my.health.widgets.segmentedbar.SegmentedBarView
                android:id="@+id/stress_slider_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="9dp"
                app:sbv_arrow_height="5dp"
                app:sbv_arrow_width="10dp"
                app:sbv_bar_height="14dp"
                app:sbv_descriptionAlign="Both"
                app:sbv_descriptionTopAlign="Center"
                app:sbv_segment_bg="false"
                app:sbv_segment_gap_width="0dp"
                app:sbv_segment_rule="average"
                app:sbv_show_description_text="false"
                app:sbv_show_description_top_text="false"
                app:sbv_show_segment_text="false"
                app:sbv_side_style="rounded"
                app:sbv_side_text_style="oneSided"
                app:sbv_sliderType="Sign"
                app:sbv_value_sign_background="@color/color_stress"
                app:sbv_value_sign_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="3dp">
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/grey"
                    android:gravity="center_horizontal"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:text="0"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/stress_relaxed"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/grey"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="30"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/stress_normal"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/grey"
                    android:gravity="center_horizontal"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:text="60"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/stress_medium"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/grey"
                    android:gravity="center_horizontal"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:text="80"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/stress_stressed"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/text_size_10"
                    android:textColor="@color/grey"
                    android:gravity="center_horizontal"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:text="100"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="0x7f0802a1"
        android:stateListAnimator="@drawable/selector_elevation"/>
</RelativeLayout>
