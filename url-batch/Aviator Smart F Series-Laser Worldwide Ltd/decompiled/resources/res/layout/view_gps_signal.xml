<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/shape_map_gps_signal_bg"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="7dp">
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gps"/>
    <View
        android:id="@+id/view_gps_signal_1"
        android:background="@drawable/shape_gps_signal_null"
        android:layout_width="4dp"
        android:layout_height="10dp"
        android:layout_marginStart="6dp"/>
    <View
        android:id="@+id/view_gps_signal_2"
        android:background="@drawable/shape_gps_signal_null"
        android:layout_width="4dp"
        android:layout_height="10dp"
        android:layout_marginStart="6dp"/>
    <View
        android:id="@+id/view_gps_signal_3"
        android:background="@drawable/shape_gps_signal_null"
        android:layout_width="4dp"
        android:layout_height="10dp"
        android:layout_marginStart="6dp"/>
    <View
        android:id="@+id/view_gps_signal_4"
        android:background="@drawable/shape_gps_signal_null"
        android:layout_width="4dp"
        android:layout_height="10dp"
        android:layout_marginStart="6dp"/>
    <View
        android:id="@+id/view_gps_signal_5"
        android:background="@drawable/shape_gps_signal_null"
        android:layout_width="4dp"
        android:layout_height="10dp"
        android:layout_marginStart="6dp"/>
</LinearLayout>
