<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:text="@string/heart_rate_light"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:text="@string/heart_rate_weight"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:text="@string/heart_rate_aerobic"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:text="@string/heart_rate_anaerobic"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:text="@string/heart_rate_max_full_name"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp">
        <ProgressBar
            android:id="@+id/light_progressbar"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:progressDrawable="@drawable/progressbar_heart_rate_light"
            android:layout_marginStart="6dp"
            style="@style/ProgressBarHorizontal"/>
        <ProgressBar
            android:id="@+id/wight_progressbar"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:progressDrawable="@drawable/progressbar_heart_rate_wight"
            android:layout_marginStart="6dp"
            style="@style/ProgressBarHorizontal"/>
        <ProgressBar
            android:id="@+id/aerobic_progressbar"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:progressDrawable="@drawable/progressbar_heart_rate_aerobic"
            android:layout_marginStart="6dp"
            style="@style/ProgressBarHorizontal"/>
        <ProgressBar
            android:id="@+id/anaerobic_progressbar"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:progressDrawable="@drawable/progressbar_heart_rate_anaerobic"
            android:layout_marginStart="6dp"
            style="@style/ProgressBarHorizontal"/>
        <ProgressBar
            android:id="@+id/max_progressbar"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:progressDrawable="@drawable/progressbar_heart_rate_max"
            android:layout_marginStart="6dp"
            style="@style/ProgressBarHorizontal"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:gravity="center_vertical"
            android:id="@+id/tv_light_time"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:gravity="center_vertical"
            android:id="@+id/tv_wight_time"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:gravity="center_vertical"
            android:id="@+id/tv_aerobic_time"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:gravity="center_vertical"
            android:id="@+id/tv_anaerobic_time"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@color/dark_grey"
            android:gravity="center_vertical"
            android:id="@+id/tv_max_time"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
