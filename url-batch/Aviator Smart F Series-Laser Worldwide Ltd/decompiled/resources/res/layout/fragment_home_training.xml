<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/assist_13_00"
        android:id="@+id/tv_title"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gps_exercise_workout_title"/>
    <RelativeLayout
        android:id="@+id/rl_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/tv_title"
        android:layout_marginStart="20dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/assist_13_00"
            android:id="@+id/tv_record_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/training_record_subtitle"/>
        <View
            android:background="@drawable/ic_training_record_more"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignTop="@+id/tv_record_more"
            android:layout_alignBottom="@+id/tv_record_more"
            android:layout_toEndOf="@+id/tv_record_more"/>
        <TextView
            android:textSize="50sp"
            android:textStyle="bold"
            android:textColor="@color/assist_13_00"
            android:id="@+id/tv_total_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_record_more"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/assist_7_B3"
            android:id="@+id/tv_total_duration_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/training_record_mins"
            android:layout_alignBottom="@+id/tv_total_duration"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/tv_total_duration"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_7_B3"
            android:id="@+id/tv_total_duration_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/training_record_total_time"
            android:layout_below="@+id/tv_total_duration"
            android:layout_alignStart="@+id/tv_total_duration"/>
        <View
            android:id="@+id/view_border"
            android:background="@color/assist_5_D9"
            android:visibility="invisible"
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_alignTop="@+id/tv_total_duration"
            android:layout_alignBottom="@+id/tv_total_duration_hint"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="50sp"
            android:textStyle="bold"
            android:textColor="@color/assist_13_00"
            android:id="@+id/tv_total_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/tv_total_duration"
            android:layout_marginStart="40dp"
            android:layout_toEndOf="@+id/view_border"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/assist_7_B3"
            android:id="@+id/tv_total_times_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/training_record_times"
            android:layout_alignBottom="@+id/tv_total_times"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/tv_total_times"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/assist_7_B3"
            android:id="@+id/tv_total_times_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/training_record_total_times"
            android:layout_below="@+id/tv_total_times"
            android:layout_alignStart="@+id/tv_total_times"/>
    </RelativeLayout>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_training_type"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/rl_record"
        app:tabIndicatorColor="@color/color_gps_training"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabPaddingEnd="20dp"
        app:tabPaddingStart="20dp"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/color_gps_training"
        app:tabTextAppearance="@style/HomeTrainingTabWidget"
        app:tabTextColor="@color/assist_7_B3"/>
    <FrameLayout
        android:id="@+id/fl_map"
        android:paddingBottom="1dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tab_training_type">
        <com.google.android.gms.maps.MapView
            android:id="@+id/google_map_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_no_permissions"
        android:background="0x7f080097"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tab_training_type"/>
    <ImageView
        android:id="@+id/iv_cover"
        android:background="0x7f080096"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tab_training_type"/>
    <com.crrepa.band.my.training.widgets.GpsSignalView
        android:id="@+id/gps_signal_view"
        android:layout_width="100dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/tab_training_type"
        android:layout_marginStart="20dp"/>
    <TextView
        android:id="@+id/iv_location"
        android:background="@drawable/selector_map_location"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginBottom="150dp"
        android:layout_above="@+id/tv_goal"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/iv_indoor_running"
        android:background="0x7f080093"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tab_training_type"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_wear_tips"
        android:background="@drawable/shape_map_gps_wear_tips_bg"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/gps_home_wearing_tips_text"
        android:layout_alignTop="@+id/gps_signal_view"
        android:layout_alignParentStart="true"
        app:drawableStartCompat="0x7f0805c9"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/gps_signal_view"
        android:layout_alignBottom="@+id/gps_signal_view"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_band_connect_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ble_disconnected"
            android:drawablePadding="5dp"
            app:drawableStartCompat="0x7f08027a"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/not_data_hint"
            android:layout_marginStart="20dp"
            app:drawableStartCompat="0x7f0805d2"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_goal"
        android:background="@drawable/selector_home_training_goal"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="40dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="42dp"/>
    <TextView
        android:id="@+id/iv_setting"
        android:background="@drawable/selector_home_training_setting"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="40dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="42dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textColor="@color/bg_1_ff"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_start"
        android:background="@drawable/selector_home_training_start"
        android:paddingBottom="35dp"
        android:layout_width="130dp"
        android:layout_height="110dp"
        android:layout_marginBottom="10dp"
        android:text="@string/start"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_training_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="0x7f080257"
        android:layout_alignTop="@+id/tv_start"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/rl_training_guidance"
        android:background="@drawable/fade_training_instruction"
        android:paddingLeft="30dp"
        android:paddingTop="15dp"
        android:paddingRight="30dp"
        android:paddingBottom="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:layout_marginBottom="12dp"
        android:layout_above="@+id/sl_shoot_running">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/assist_12"
            android:id="@+id/tv_training_guidance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_training_use_guidance_tips"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/tv_training_guidance_btn"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textStyle="bold"
            android:textColor="@color/training_assist_4_alert"
            android:id="@+id/tv_training_guidance_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_training_use_guidance_btn_title"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="15dp"
            android:layout_toStartOf="@+id/iv_training_guidance_close"/>
        <ImageView
            android:id="@+id/iv_training_guidance_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080386"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:id="@+id/sl_shoot_running"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="5dp"
        android:layout_above="@+id/tv_start"
        android:layout_centerHorizontal="true"
        app:cornerRadius="12dp"
        app:shadowColor="@color/assist_10_66"
        app:shadowRadius="12dp">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_training_running"
            android:background="@drawable/shape_home_training_tab_bg"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:tabIndicatorHeight="0dp"
            app:tabMode="fixed"
            app:tabPaddingEnd="18dp"
            app:tabPaddingStart="18dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/color_gps_training"
            app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
            app:tabTextColor="@color/assist_10_66"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:id="@+id/sl_shoot_walking"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="5dp"
        android:layout_above="@+id/tv_start"
        android:layout_centerHorizontal="true"
        app:cornerRadius="12dp"
        app:shadowColor="@color/assist_10_66"
        app:shadowRadius="12dp">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_training_walking"
            android:background="@drawable/shape_home_training_tab_bg"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:tabIndicatorHeight="0dp"
            app:tabMode="fixed"
            app:tabPaddingEnd="18dp"
            app:tabPaddingStart="18dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/color_gps_training"
            app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
            app:tabTextColor="@color/assist_10_66"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
</RelativeLayout>
