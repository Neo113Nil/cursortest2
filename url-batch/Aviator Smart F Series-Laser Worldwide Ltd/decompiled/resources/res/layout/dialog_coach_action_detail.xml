<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_coach_content_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fl_graphic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="200dp">
        <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
            android:id="@+id/iv_cover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="282dp"
            android:scaleType="centerCrop"
            app:riv_corner_radius_top_left="6dp"
            app:riv_corner_radius_top_right="6dp"/>
        <com.moyoung.classes.coach.widget.CustomPlayerView
            android:layout_gravity="top"
            android:id="@+id/video_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:controller_layout_id="@layout/custom_exo_video_player_control_view"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="13dp"
        android:src="0x7f0801e0"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/assist_13_00"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="10dp"
        android:maxLines="2"
        android:layout_below="@+id/fl_graphic"
        android:layout_marginStart="20dp"/>
    <View
        android:background="@color/bg_2_f7"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/tv_title"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:tag="PortScreen"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_below="@+id/tv_title">
        <TextView
            android:textColor="@color/assist_13_00"
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="20dp"/>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
