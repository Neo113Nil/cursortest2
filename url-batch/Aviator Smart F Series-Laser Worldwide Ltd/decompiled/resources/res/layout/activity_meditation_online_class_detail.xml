<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/sl_start">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_thumb"
                android:layout_width="match_parent"
                android:layout_height="282dp"
                android:scaleType="centerCrop"/>
            <View
                android:background="@drawable/shape_meditation_online_class_cover_mask"
                android:layout_width="match_parent"
                android:layout_height="166dp"/>
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="56dp"
                android:src="0x7f0801e0"
                android:layout_marginStart="20dp"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/assist_13_00"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/iv_thumb"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_12_22"
                android:gravity="center"
                android:id="@+id/tv_duration"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="20dp"
                android:drawablePadding="3dp"
                android:layout_below="@+id/tv_title"
                app:drawableStartCompat="@mipmap/ic_meditation_class_duration"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/assist_10_66"
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/tv_duration"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/assist_13_00"
                android:gravity="center"
                android:id="@+id/tv_skill_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/meditation_online_class_skill_title"
                android:layout_below="@+id/tv_description"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/assist_11_33"
                android:id="@+id/tv_skill"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/tv_skill_title"/>
        </RelativeLayout>
    </ScrollView>
    <com.moyoung.dafit.module.common.widgets.ShadowLayout
        android:id="@+id/sl_start"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:cornerRadius="22dp"
        app:shadowColor="@color/class_assist_1"
        app:shadowRadius="8dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/assist_1_ff"
            android:gravity="center"
            android:id="@+id/tv_download"
            android:background="@drawable/shape_classes_assist_1_btn"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/meditation_class_download"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/assist_1_ff"
            android:gravity="center"
            android:id="@+id/tv_start"
            android:background="@drawable/shape_classes_assist_1_btn"
            android:visibility="gone"
            android:layout_width="270dp"
            android:layout_height="44dp"
            android:text="@string/meditation_class_start"/>
    </com.moyoung.dafit.module.common.widgets.ShadowLayout>
    <ProgressBar
        android:id="@+id/pb_audio"
        android:visibility="gone"
        android:layout_width="270dp"
        android:layout_height="44dp"
        android:max="100"
        android:progressDrawable="@drawable/progressbar_meditation_download_audio"
        android:layout_alignTop="@+id/sl_start"
        android:layout_centerHorizontal="true"
        style="@style/ProgressBarHorizontal"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/bg_1_ff"
        android:gravity="center"
        android:id="@+id/tv_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="0%"
        android:layout_alignTop="@+id/pb_audio"
        android:layout_alignStart="@+id/pb_audio"
        android:layout_alignEnd="@+id/pb_audio"/>
</RelativeLayout>
