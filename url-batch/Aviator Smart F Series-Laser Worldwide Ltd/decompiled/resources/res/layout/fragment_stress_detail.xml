<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <TextView
        android:textSize="32sp"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/stress_record_detail"/>
    <View
        android:layout_marginTop="20dp"
        style="@style/BorderView"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stress_date"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/grey"
            android:id="@+id/tv_stress_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/BorderView"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stress_time"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/grey"
            android:id="@+id/tv_stress_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/BorderView"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stress_name"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/grey"
            android:id="@+id/tv_stress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/BorderView"/>
    </RelativeLayout>
</LinearLayout>
