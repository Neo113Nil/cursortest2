<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="315dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_statistics_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_sleep_time_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/hour"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_sleep_time_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_blank"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/minute"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/black"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <include
        android:id="@+id/include_sleep_state_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        layout="@layout/sleep_state_description"/>
    <com.crrepa.band.my.health.widgets.segmentedview.SegmentedView
        android:id="@+id/sleep_segmented_view"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginBottom="56dp"
        android:layout_alignParentBottom="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <View
        android:background="@color/light_gray"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"/>
    <com.crrepa.band.my.health.widgets.HandleView
        android:id="@+id/sleep_handle_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/dark_grey"
        android:id="@+id/tv_fall_asleep_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="8dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/dark_grey"
        android:id="@+id/tv_wake_up_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
