<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="106dp"
        android:layout_height="106dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/upgrade_00000"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/dark_grey"
        android:id="@+id/tv_firmware_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
    <View
        android:id="@+id/border"
        android:layout_marginTop="20dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        style="@style/BorderView"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/dark_grey"
        android:ellipsize="end"
        android:id="@+id/tv_firmware_beta_hint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/firmware_beta_hint"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/dark_grey"
        android:ellipsize="end"
        android:id="@+id/tv_firmware_describe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="25dp"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <Button
        android:id="@+id/btn_firmware_upgrade"
        android:text="@string/upgrade"
        android:textAllCaps="false"
        style="@style/BottomButton"/>
</LinearLayout>
