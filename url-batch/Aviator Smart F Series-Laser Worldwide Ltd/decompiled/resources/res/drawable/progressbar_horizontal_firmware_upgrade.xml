<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5dp"/>
            <gradient
                android:startColor="#f9f6f6"
                android:endColor="#f9f6f6"
                android:angle="270"
                android:centerY="0.75"
                android:centerColor="#f9f6f6"/>
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="5dp"/>
                <gradient
                    android:startColor="#f9f6f6"
                    android:endColor="#f9f6f6"
                    android:angle="270"
                    android:centerY="0.75"
                    android:centerColor="#f9f6f6"/>
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="5dp"/>
                <gradient
                    android:startColor="@color/color_customize_watch_face"
                    android:endColor="@color/color_customize_watch_face"
                    android:angle="270"
                    android:centerY="0.75"
                    android:centerColor="@color/color_customize_watch_face"/>
            </shape>
        </clip>
    </item>
</layer-list>
