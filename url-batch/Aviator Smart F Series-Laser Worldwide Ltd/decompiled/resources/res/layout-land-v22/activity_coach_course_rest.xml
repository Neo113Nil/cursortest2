<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.moyoung.classes.coach.widget.SegmentVideoTimeBar
        android:id="@+id/segment_video_time_bar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:progressDrawable="@drawable/progressbar_segment_video_time_bar_rest"
        style="@style/ProgressBarHorizontal"/>
    <RelativeLayout
        android:id="@+id/rl_count_down"
        android:layout_width="278dp"
        android:layout_height="248dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="40dp">
        <com.moyoung.dafit.module.common.widgets.CircleDisplayView
            android:id="@+id/cdv_count_down"
            android:layout_width="186dp"
            android:layout_height="186dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/class_assist_1"
            android:gravity="center"
            android:id="@+id/tv_delayed"
            android:background="@drawable/shape_classes_delayed_btn"
            android:layout_width="95dp"
            android:layout_height="35dp"
            android:text="@string/fitness_extension_seconds_text"
            android:layout_alignTop="@+id/sl_skip"/>
        <com.moyoung.dafit.module.common.widgets.ShadowLayout
            android:id="@+id/sl_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            app:cornerRadius="22dp"
            app:shadowColor="@color/class_assist_1"
            app:shadowRadius="8dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/assist_1_ff"
                android:gravity="center"
                android:id="@+id/tv_skip"
                android:background="@drawable/shape_classes_assist_1_btn"
                android:layout_width="95dp"
                android:layout_height="35dp"
                android:text="@string/fitness_skip_break_text"/>
        </com.moyoung.dafit.module.common.widgets.ShadowLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_next_action"
        android:background="@drawable/shape_coach_next_action_msg"
        android:visibility="gone"
        android:layout_width="262dp"
        android:layout_height="78dp"
        android:layout_centerVertical="true"
        android:paddingStart="21dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="40dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/assist_12_22"
            android:ellipsize="end"
            android:id="@+id/tv_next_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="@string/fitness_next_move_text"
            android:maxLines="2"
            android:layout_toStartOf="@+id/iv_next_action_cover"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/assist_13_00"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_next_action_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxLines="1"
            android:layout_below="@+id/tv_next_action"
            android:layout_toStartOf="@+id/iv_next_action_cover"
            android:layout_alignParentStart="true"/>
        <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
            android:id="@+id/iv_next_action_cover"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_width="104dp"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:paddingVertical="7dp"
            app:riv_corner_radius="3dp"/>
    </RelativeLayout>
</RelativeLayout>
