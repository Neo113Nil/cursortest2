<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/assist_1_ff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="15dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="300dp">
            <com.moyoung.dafit.module.common.widgets.roundedimageview.RoundedImageView
                android:id="@+id/iv_cover"
                android:layout_width="266dp"
                android:layout_height="150dp"
                android:layout_marginTop="30dp"
                android:scaleType="centerCrop"
                android:layout_marginStart="20dp"
                app:riv_corner_radius_top_left="8dp"
                app:riv_corner_radius_top_right="8dp"/>
            <RelativeLayout
                android:background="@drawable/shape_coach_paused_action_msg"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:paddingRight="20dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_cover"
                android:layout_alignStart="@+id/iv_cover"
                android:layout_alignEnd="@+id/iv_cover"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/assist_10_66"
                    android:ellipsize="end"
                    android:id="@+id/tv_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_toStartOf="@+id/tv_action_detail"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/assist_13_00"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:maxLines="2"
                    android:layout_below="@+id/tv_progress"
                    android:layout_toStartOf="@+id/tv_action_detail"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/assist_1_ff"
                    android:gravity="center"
                    android:id="@+id/tv_action_detail"
                    android:background="@drawable/shape_classes_assist_1_btn"
                    android:paddingLeft="13dp"
                    android:paddingRight="13dp"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:text="@string/fitness_action_details_text"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="5dp"
                    android:layout_alignParentEnd="true"
                    android:paddingHorizontal="13dp"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/iv_stop"
                android:background="@drawable/selector_btn_coach_stop"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="30dp"
                android:layout_toEndOf="@+id/iv_cover"/>
            <ImageView
                android:id="@+id/iv_continue"
                android:background="@drawable/selector_btn_coach_play"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="1dp"
                android:layout_toEndOf="@+id/iv_stop"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
