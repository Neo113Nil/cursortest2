<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center_vertical"
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:text="@string/back"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/tvTripTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <View
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/neon_cyan"
        android:gravity="center"
        android:id="@+id/tvProgress"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginBottom="16dp"
        android:max="100"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:progressTint="@color/neon_green"
        android:progressBackgroundTint="@color/btn_fill"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:id="@+id/etNewItem"
            android:background="@drawable/item_checklist_bg"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="@string/add_item_hint"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textCapSentences"
            android:imeOptions="actionDone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/btnAddItem"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="72dp"
            android:text="@string/add_item"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChecklist"
        android:padding="12dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/btnDone"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:text="@string/mark_complete"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/btnReset"
            android:background="@drawable/btn_neon_pink"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/reset_list"/>
    </LinearLayout>
</LinearLayout>
