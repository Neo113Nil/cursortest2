<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_neon_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trip_select_title"
            app:layout_constraintBottom_toTopOf="@+id/btnSea"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/btnSea"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/trip_sea"
            android:drawablePadding="12dp"
            app:drawableStartCompat="@drawable/ic_sea"
            app:layout_constraintBottom_toTopOf="@+id/btnMountains"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/btnMountains"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/trip_mountains"
            android:drawablePadding="12dp"
            app:drawableStartCompat="@drawable/ic_mountain"
            app:layout_constraintBottom_toTopOf="@+id/btnBusiness"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnSea"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/btnBusiness"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/trip_business"
            android:drawablePadding="12dp"
            app:drawableStartCompat="@drawable/ic_business"
            app:layout_constraintBottom_toTopOf="@+id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnMountains"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/btnBack"
            android:background="@drawable/btn_neon_pink"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:text="@string/back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnBusiness"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
