<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_neon_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/neon_green"
            android:gravity="center"
            android:id="@+id/tvOutcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/summary_ready"
            app:layout_constraintBottom_toTopOf="@+id/tvTripName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:id="@+id/tvTripName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@+id/tvItemCount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvOutcome"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/tvItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toTopOf="@+id/btnEditList"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTripName"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/btnEditList"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="40dp"
            android:text="@string/edit_list"
            app:layout_constraintBottom_toTopOf="@+id/btnNewTrip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvItemCount"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/btnNewTrip"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/new_trip"
            app:layout_constraintBottom_toTopOf="@+id/btnHome"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnEditList"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/btnHome"
            android:background="@drawable/btn_neon_pink"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/home"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnNewTrip"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
