<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAchievement"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="34sp"
            android:gravity="center"
            android:id="@+id/tvAchievementEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvAchievementTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/colorTextSecondary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvAchievementDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
