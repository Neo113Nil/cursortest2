<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/main_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/adContainer"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/sep"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_above="@+id/adContainer"/>
    <ImageView
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:src="@drawable/icone_splash"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_above="@+id/sep"
        android:layout_below="@+id/topContainer"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="top"
            android:id="@+id/mitake"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/take"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/migalery"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/gallery"
            android:layout_weight="1"
            android:layout_below="@+id/mitake"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/mi_moreApps"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_toRightOf="@+id/mi_galerySelect"
            android:layout_below="@+id/mi_galerySelect"/>
    </LinearLayout>
</RelativeLayout>
