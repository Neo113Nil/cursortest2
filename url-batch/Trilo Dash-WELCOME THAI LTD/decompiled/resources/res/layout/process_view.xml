<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/main_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/adContainer"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/sep"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_above="@+id/adContainer"/>
    <RelativeLayout
        android:id="@+id/btns_top"
        android:background="@drawable/top_bg"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="20dp">
        <ImageView
            android:id="@+id/btn_save"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/save"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/btn_share"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/share"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/pen_params"
        android:background="@drawable/top_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_above="@+id/sep"
        android:layout_alignLeft="@+id/btns_top"
        android:layout_alignRight="@+id/btns_top">
        <RadioGroup
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/radioFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:soundEffectsEnabled="true"
            android:showDividers="middle">
            <RadioButton
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/radioLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/radio_low"
                android:layout_weight="1"/>
            <RadioButton
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/radioMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/radio_medium"
                android:layout_weight="1"/>
            <RadioButton
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/radioHigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/radio_high"
                android:layout_weight="1"/>
        </RadioGroup>
    </LinearLayout>
    <ImageView
        android:id="@+id/image"
        android:background="@drawable/frame"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/pen_params"
        android:layout_below="@+id/btns_top"
        android:layout_centerInParent="true"/>
</RelativeLayout>
