<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/sdk_pay_bg_product_details"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/product_image"
            android:layout_width="@dimen/sdk_pay_product_image_size"
            android:layout_height="@dimen/sdk_pay_product_image_size"
            android:layout_marginTop="@dimen/sdk_pay_spacer_s"
            android:layout_marginBottom="@dimen/sdk_pay_spacer_s"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/sdk_pay_spacer_s"
            android:layout_marginVertical="@dimen/sdk_pay_spacer_s"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/sdk_pay_spacer_s"
            android:layout_marginRight="@dimen/sdk_pay_spacer_s"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/sdk_pay_spacer_s">
            <TextView
                android:textColor="?attr/sdk_pay_text_primary"
                android:ellipsize="end"
                android:id="@+id/product_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/Body.Body10"/>
            <TextView
                android:textColor="?attr/sdk_pay_text_secondary"
                android:ellipsize="end"
                android:id="@+id/product_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sdk_pay_spacer_xxxs"
                android:maxLines="1"
                style="@style/Body.Body30"/>
        </LinearLayout>
        <include
            android:layout_gravity="center_vertical"
            android:id="@+id/price_cell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/sdk_pay_purchase_price_cell"/>
    </LinearLayout>
    <include
        android:id="@+id/price_details_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sdk_pay_spacer_xxs"
        android:layout_marginStart="@dimen/sdk_pay_spacer_s"
        android:layout_marginEnd="@dimen/sdk_pay_price_details_land_margin_end"
        layout="@layout/sdk_pay_calculations_cell"/>
    <include
        android:id="@+id/subscription_tariffs_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sdk_pay_spacer_s"
        android:layout_marginEnd="@dimen/sdk_pay_price_details_land_margin_end"
        layout="@layout/sdk_pay_subscription_tariffs_cell"/>
</LinearLayout>
