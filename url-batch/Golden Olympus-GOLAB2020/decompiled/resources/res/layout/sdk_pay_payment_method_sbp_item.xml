<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/sdk_pay_spacer_s"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="@dimen/sdk_pay_payment_method_item_width"
    android:layout_height="@dimen/sdk_pay_payment_method_item_height"
    android:foreground="@drawable/sdk_pay_ripple_foreground"
    android:layout_marginEnd="@dimen/sdk_pay_spacer_xs">
    <ImageView
        android:layout_width="@dimen/sdk_pay_payment_method_item_icon_size"
        android:layout_height="@dimen/sdk_pay_payment_method_item_icon_size"
        android:src="@drawable/sdk_pay_ic_sbp"
        android:importantForAccessibility="no"/>
    <TextView
        android:textColor="?attr/sdk_pay_text_primary"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sdk_pay_spacer_xs"
        android:text="@string/sdk_pay_payment_method_sbp"
        android:maxLines="1"
        style="@style/Captions.Caption20"/>
</LinearLayout>
