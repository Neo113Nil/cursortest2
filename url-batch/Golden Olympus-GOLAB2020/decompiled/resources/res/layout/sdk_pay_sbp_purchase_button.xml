<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/sdk_pay_action_button_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sdk_pay_spacer_l"
        android:layout_marginTop="@dimen/sdk_pay_spacer_xs"
        android:layout_marginRight="@dimen/sdk_pay_spacer_l"
        android:layout_marginBottom="@dimen/sdk_pay_spacer_xs"
        android:foreground="@drawable/sdk_pay_ripple_foreground"
        android:backgroundTint="?attr/sdk_pay_sbp_button_color"
        android:layout_marginHorizontal="@dimen/sdk_pay_spacer_l"
        android:layout_marginVertical="@dimen/sdk_pay_spacer_xs">
        <TextView
            android:textColor="?attr/sdk_pay_text_quaternary_constant"
            android:id="@+id/sbp_purchase_button_price"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Theme.ActionButton"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/sbp_button_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/sdk_pay_ic_sbp"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/sdk_pay_spacer_xs"/>
    </LinearLayout>
</FrameLayout>
