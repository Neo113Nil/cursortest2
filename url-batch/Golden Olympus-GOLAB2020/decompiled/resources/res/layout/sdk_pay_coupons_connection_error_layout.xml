<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/sdk_pay_spacer_l"
    android:layout_marginRight="@dimen/sdk_pay_spacer_l"
    android:layout_marginHorizontal="@dimen/sdk_pay_spacer_l">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sdk_pay_im_coupon_connection_error"
        android:contentDescription="@null"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/sdk_pay_spacer_xxxl"/>
    <TextView
        android:textColor="?attr/sdk_pay_text_primary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sdk_pay_coupon_connection_error_title"
        style="@style/Headlines.Headline20"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/sdk_pay_spacer_s"/>
    <TextView
        android:textColor="?attr/sdk_pay_text_secondary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sdk_pay_coupon_connection_error_message"
        style="@style/Body.Body10"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/sdk_pay_spacer_m"/>
    <Button
        android:textColor="?attr/sdk_pay_text_quaternary_constant"
        android:id="@+id/retry_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sdk_pay_spacer_xs"
        android:layout_marginBottom="@dimen/sdk_pay_spacer_xs"
        android:text="@string/sdk_pay_coupon_connection_update"
        android:layout_marginVertical="@dimen/sdk_pay_spacer_xs"
        style="@style/Theme.MediumButton"/>
</LinearLayout>
