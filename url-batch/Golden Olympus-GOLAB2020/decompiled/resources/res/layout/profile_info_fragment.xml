<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/profile_info_fragment_0"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <EditText
        android:textSize="18sp"
        android:textColor="@color/target_item_text"
        android:textColorHint="@color/text_hint"
        android:gravity="center_vertical"
        android:id="@+id/displayNameEditText"
        android:tag="binding_1"
        android:background="@color/background"
        android:paddingTop="30dp"
        android:paddingBottom="19dp"
        android:layout_width="0dp"
        android:layout_height="121dp"
        android:hint="@string/openchat_create_profile_input_placeholder"
        android:includeFontPadding="true"
        android:maxLength="@integer/max_profile_name_length"
        android:drawablePadding="18dp"
        android:imeOptions="actionNext"
        android:layout_marginEnd="13dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_hint"
        android:id="@+id/displayNameGuide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/openchat_create_profile_input_guide"
        android:maxLines="2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/displayNameEditText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
