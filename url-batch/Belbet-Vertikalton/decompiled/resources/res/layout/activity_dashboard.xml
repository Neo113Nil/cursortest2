<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.winpower.neonfit.ui.StarrySkyView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/back"
                    style="@style/NeonButton"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/neon_yellow"
                    android:gravity="center"
                    android:background="@drawable/bg_neon_panel"
                    android:padding="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_title"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_bright"
                    android:gravity="center"
                    android:id="@+id/tvCaloriesToday"
                    android:background="@drawable/bg_neon_panel"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/hot_pink"
                    android:gravity="center"
                    android:id="@+id/tvRemaining"
                    android:background="@drawable/bg_neon_panel"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/neon_yellow"
                    android:gravity="center"
                    android:id="@+id/tvGoal"
                    android:background="@drawable/bg_neon_panel"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.winpower.neonfit.ui.MacroRingView
                        android:id="@+id/ringProtein"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"/>
                    <com.winpower.neonfit.ui.CalorieCoreView
                        android:id="@+id/calorieCore"
                        android:layout_width="160dp"
                        android:layout_height="160dp"/>
                    <com.winpower.neonfit.ui.MacroRingView
                        android:id="@+id/ringFat"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"/>
                </LinearLayout>
                <com.winpower.neonfit.ui.MacroRingView
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/ringCarbs"
                    android:layout_width="120dp"
                    android:layout_height="120dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/neon_cyan"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_neon_panel"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hydration_reminder"
                    android:drawablePadding="8dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_water"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/hot_pink"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_neon_panel"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/steps_placeholder"
                    android:drawablePadding="8dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_dumbbell"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddFood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/add_food"
                style="@style/NeonButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/quick_add"
                style="@style/NeonButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFoodLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/todays_log"
                style="@style/NeonButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/settings"
                style="@style/NeonButton"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
