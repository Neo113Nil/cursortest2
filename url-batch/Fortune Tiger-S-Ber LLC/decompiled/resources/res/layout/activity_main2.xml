<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:background="@color/calculator_background"
    android:padding="@dimen/screen_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/header_text_size"
        android:textStyle="bold"
        android:textColor="@color/text_purple_dim"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/calculator_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/header_text_size"
        android:textStyle="bold"
        android:textColor="@color/streak_gold"
        android:id="@+id/tvStreakLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_streak"
        app:layout_constraintEnd_toStartOf="@+id/tvStreakValue"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/header_text_size"
        android:textStyle="bold"
        android:textColor="@color/streak_gold"
        android:id="@+id/tvStreakValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/header_text_size"
        android:textColor="@color/text_purple_dim"
        android:id="@+id/tvMemory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/label_memory_empty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/header_text_size"
        android:textStyle="bold"
        android:textColor="@color/text_purple_bright"
        android:id="@+id/btnToggleHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:text="@string/label_history"
        android:contentDescription="@string/content_description_toggle_history"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toStartOf="@+id/btnToggleScientific"
        app:layout_constraintTop_toBottomOf="@+id/tvMemory"
        style="@style/Widget.Material3.Button.TextButton"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/header_text_size"
        android:textStyle="bold"
        android:textColor="@color/text_purple_bright"
        android:id="@+id/btnToggleScientific"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:text="@string/label_scientific_on"
        android:contentDescription="@string/content_description_toggle_scientific"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMemory"
        style="@style/Widget.Material3.Button.TextButton"/>
    <ScrollView
        android:id="@+id/historyPanel"
        android:background="@drawable/bg_history_panel"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnToggleScientific">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/displayCard"
        android:background="@drawable/bg_display"
        android:padding="@dimen/display_padding"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/historyPanel">
        <TextView
            android:textSize="@dimen/expression_text_size"
            android:textColor="@color/text_purple_dim"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <TextView
            android:textSize="@dimen/display_text_size"
            android:textStyle="bold"
            android:textColor="@color/text_purple_bright"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/display_default"
            android:maxLines="1"
            app:autoSizeMaxTextSize="@dimen/display_text_size"
            app:autoSizeMinTextSize="24sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttonGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/displayCard">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/rowScientific1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btnSin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_sin"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
            <Button
                android:id="@+id/btnCos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_cos"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
            <Button
                android:id="@+id/btnTan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_tan"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
            <Button
                android:id="@+id/btnPower"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_power"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/rowScientific2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btnLog"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_log"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
            <Button
                android:id="@+id/btnLn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_ln"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
            <Button
                android:id="@+id/btnPi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_pi"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
            <Button
                android:id="@+id/btnSqrt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_sqrt"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btnMemoryClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_memory_clear"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
            <Button
                android:id="@+id/btnMemoryRecall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_memory_recall"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
            <Button
                android:id="@+id/btnMemorySubtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_memory_subtract"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
            <Button
                android:id="@+id/btnMemoryAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_memory_add"
                android:layout_weight="1"
                style="@style/CalculatorButton.Small"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_all_clear"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btnBackspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_backspace"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btnPercent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_percent"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_divide"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_7"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_8"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_9"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_multiply"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_4"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_5"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_6"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btnSubtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_subtract"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_1"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_2"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_3"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_add"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btnSign"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_sign"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_0"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btnDecimal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_decimal"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
            <Button
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_equals"
                android:layout_weight="1"
                style="@style/CalculatorButton"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
