<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:background="@color/bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.playgen.securelock.view.NeonBackgroundView
        android:id="@+id/neonBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingTop="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/settingsPanel"
                android:background="@drawable/overlay_panel"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/neon_cyan"
                    android:gravity="center"
                    android:id="@+id/settingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:id="@+id/settingsTypeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/groupSecure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:id="@+id/lengthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"/>
                    <SeekBar
                        android:id="@+id/lengthSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="24"
                        android:minHeight="44dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:textColor="@color/text_primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/uppercase"
                            android:layout_weight="1"/>
                        <Switch
                            android:id="@+id/switchUpper"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:textColor="@color/text_primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/lowercase"
                            android:layout_weight="1"/>
                        <Switch
                            android:id="@+id/switchLower"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:textColor="@color/text_primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/digits"
                            android:layout_weight="1"/>
                        <Switch
                            android:id="@+id/switchDigits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:textColor="@color/text_primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/symbols"
                            android:layout_weight="1"/>
                        <Switch
                            android:id="@+id/switchSymbols"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/groupPin"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:id="@+id/pinLengthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"/>
                    <SeekBar
                        android:id="@+id/pinLengthSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="8"
                        android:minHeight="44dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/groupPassphrase"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:id="@+id/wordCountValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"/>
                    <SeekBar
                        android:id="@+id/wordCountSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="3"
                        android:minHeight="44dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/separator_label"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <Button
                            android:textColor="@color/neon_cyan"
                            android:id="@+id/btnSepHyphen"
                            android:background="@drawable/btn_neon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/sep_hyphen"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:layout_marginEnd="8dp"/>
                        <Button
                            android:textColor="@color/neon_cyan"
                            android:id="@+id/btnSepSpace"
                            android:background="@drawable/btn_neon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/sep_space"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:layout_marginEnd="8dp"/>
                        <Button
                            android:textColor="@color/neon_cyan"
                            android:id="@+id/btnSepUnderscore"
                            android:background="@drawable/btn_neon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/sep_underscore"
                            android:layout_weight="1"
                            android:textAllCaps="false"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/groupAlphanumeric"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:id="@+id/alnumLengthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"/>
                    <SeekBar
                        android:id="@+id/alnumLengthSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="24"
                        android:minHeight="44dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/groupHex"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:id="@+id/hexLengthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"/>
                    <SeekBar
                        android:id="@+id/hexLengthSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="24"
                        android:minHeight="44dp"/>
                </LinearLayout>
                <Button
                    android:textColor="@color/neon_cyan"
                    android:id="@+id/btnSave"
                    android:background="@drawable/btn_neon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="48dp"
                    android:text="@string/save"
                    android:textAllCaps="false"/>
                <Button
                    android:textColor="@color/text_primary"
                    android:id="@+id/btnBack"
                    android:background="@drawable/btn_neon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/back"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
