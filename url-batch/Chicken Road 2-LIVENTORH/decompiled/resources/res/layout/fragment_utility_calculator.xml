<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/star_white"
            android:id="@+id/utility_title_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/utility_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/glider_cyan"
            android:gravity="center"
            android:id="@+id/utility_description_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Calculate optimal drift parameters for asteroid field navigation. Input your glider specs and get precise racing metrics ��"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/utility_title_header"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/input_fields_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/space_blue"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/utility_description_text">
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/star_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="�� Velocity (km/s)"/>
                <EditText
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/asteroid_gray"
                    android:id="@+id/velocity_input_field"
                    android:background="@drawable/input_field_background"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:hint="Enter velocity"
                    android:inputType="numberDecimal"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/star_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚖️ Glider Mass (tons)"/>
                <EditText
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/asteroid_gray"
                    android:id="@+id/mass_input_field"
                    android:background="@drawable/input_field_background"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:hint="Enter mass"
                    android:inputType="numberDecimal"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/star_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="�� Asteroid Density (%)"/>
                <EditText
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/asteroid_gray"
                    android:id="@+id/asteroid_density_input_field"
                    android:background="@drawable/input_field_background"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:hint="Enter density"
                    android:inputType="numberDecimal"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/star_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="�� Distance (km)"/>
                <EditText
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/asteroid_gray"
                    android:id="@+id/distance_input_field"
                    android:background="@drawable/input_field_background"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:hint="Enter distance"
                    android:inputType="numberDecimal"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <Button
            android:textSize="16sp"
            android:textStyle="bold"
            android:id="@+id/calculate_drift_button"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:text="@string/calculate"
            android:backgroundTint="@color/energy_blue"
            app:layout_constraintEnd_toStartOf="@+id/reset_calculator_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_fields_card"
            app:layout_constraintWidth_percent="0.48"/>
        <Button
            android:textSize="16sp"
            android:id="@+id/reset_calculator_button"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:text="@string/reset"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/asteroid_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/calculate_drift_button"
            app:layout_constraintTop_toBottomOf="@+id/input_fields_card"
            app:layout_constraintWidth_percent="0.48"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/results_container_card"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/cosmic_purple"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/calculate_drift_button">
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/star_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="�� Results"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/glider_cyan"
                    android:id="@+id/result_kinetic_energy_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/glider_cyan"
                    android:id="@+id/result_drift_angle_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/glider_cyan"
                    android:id="@+id/result_optimal_speed_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/glider_cyan"
                    android:id="@+id/result_safety_rating_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/glider_cyan"
                    android:id="@+id/result_fuel_efficiency_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
