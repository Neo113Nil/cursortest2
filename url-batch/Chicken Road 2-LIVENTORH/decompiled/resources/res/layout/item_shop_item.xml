<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/space_blue"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="40sp"
            android:id="@+id/shop_item_emoji_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/star_white"
            android:gravity="center"
            android:id="@+id/shop_item_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/glider_cyan"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/shop_item_description_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:maxLines="3"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/warning_orange"
            android:id="@+id/shop_item_price_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
        <Button
            android:textSize="11sp"
            android:id="@+id/shop_item_buy_button"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="Buy"
            android:backgroundTint="@color/energy_blue"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
