<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.luckycounter.drinkwater.ui.StarrySkyView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hudRow"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/aqua"
                android:id="@+id/textToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/hot_pink"
                android:id="@+id/textGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/neon_white"
                    android:id="@+id/textStreak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/plasma_aqua"
                    android:id="@+id/textTier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.luckycounter.drinkwater.ui.HydrationCoreView
                android:id="@+id/hydrationCore"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.luckycounter.drinkwater.ui.PercentRingView
                android:id="@+id/percentRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp">
            <Button
                android:textSize="12sp"
                android:textColor="@color/neon_white"
                android:id="@+id/btnAdd150"
                android:background="@drawable/bg_neon_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="44dp"
                android:text="@string/add_150"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="4dp"
                style="@style/Widget.AppCompat.Button"/>
            <Button
                android:textSize="12sp"
                android:textColor="@color/neon_white"
                android:id="@+id/btnAdd250"
                android:background="@drawable/bg_neon_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="44dp"
                android:text="@string/add_250"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginHorizontal="4dp"
                style="@style/Widget.AppCompat.Button"/>
            <Button
                android:textSize="12sp"
                android:textColor="@color/neon_white"
                android:id="@+id/btnAdd500"
                android:background="@drawable/bg_neon_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="44dp"
                android:text="@string/add_500"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginHorizontal="4dp"
                style="@style/Widget.AppCompat.Button"/>
            <Button
                android:textSize="12sp"
                android:textColor="@color/aqua"
                android:id="@+id/btnCustom"
                android:background="@drawable/bg_neon_button_aqua"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="44dp"
                android:text="@string/add_custom"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                style="@style/Widget.AppCompat.Button"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="12sp"
                android:textColor="@color/aqua"
                android:id="@+id/btnLog"
                android:background="@drawable/bg_neon_button_aqua"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="44dp"
                android:text="@string/log"
                android:drawableTop="@drawable/ic_log"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="4dp"
                style="@style/Widget.AppCompat.Button"/>
            <Button
                android:textSize="12sp"
                android:textColor="@color/hot_pink"
                android:id="@+id/btnPyramid"
                android:background="@drawable/bg_neon_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="44dp"
                android:text="@string/pyramid"
                android:drawableTop="@drawable/ic_pyramid"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginHorizontal="4dp"
                style="@style/Widget.AppCompat.Button"/>
            <Button
                android:textSize="12sp"
                android:textColor="@color/hot_pink"
                android:id="@+id/btnSettings"
                android:background="@drawable/bg_neon_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="44dp"
                android:text="@string/settings"
                android:drawableTop="@drawable/ic_settings"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                style="@style/Widget.AppCompat.Button"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
