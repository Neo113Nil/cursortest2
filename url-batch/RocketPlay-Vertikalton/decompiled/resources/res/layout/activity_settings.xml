<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.luckycounter.drinkwater.ui.StarrySkyView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/hot_pink"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/aqua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/daily_goal"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/neon_white"
            android:id="@+id/textGoalValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"/>
        <SeekBar
            android:id="@+id/seekGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3500"
            android:progressTint="@color/hot_pink"
            android:thumbTint="@color/aqua"
            android:min="500"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/plasma_aqua"
            android:id="@+id/textMaxGoal"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:textColor="@color/hot_pink"
            android:id="@+id/btnResetStreak"
            android:background="@drawable/bg_neon_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:minHeight="44dp"
            android:text="@string/reset_streak"
            android:textAllCaps="false"/>
    </LinearLayout>
</FrameLayout>
