<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.luckycounter.drinkwater.ui.StarrySkyView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/hot_pink"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_water_title"/>
        <EditText
            android:textSize="18sp"
            android:textColor="@color/neon_white"
            android:textColorHint="@color/aqua"
            android:id="@+id/editAmount"
            android:background="@drawable/bg_neon_button_aqua"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/amount_ml"
            android:inputType="number"
            android:paddingHorizontal="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="11sp"
                android:textColor="@color/neon_white"
                android:id="@+id/chip150"
                android:background="@drawable/bg_neon_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/add_150"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="4dp"/>
            <Button
                android:textSize="11sp"
                android:textColor="@color/neon_white"
                android:id="@+id/chip250"
                android:background="@drawable/bg_neon_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/add_250"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginHorizontal="4dp"/>
            <Button
                android:textSize="11sp"
                android:textColor="@color/neon_white"
                android:id="@+id/chip500"
                android:background="@drawable/bg_neon_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/add_500"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textColor="@color/hot_pink"
                android:id="@+id/btnCancel"
                android:background="@drawable/bg_neon_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="44dp"
                android:text="@string/cancel"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp"/>
            <Button
                android:textColor="@color/aqua"
                android:id="@+id/btnSave"
                android:background="@drawable/bg_neon_button_aqua"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="44dp"
                android:text="@string/save"
                android:layout_weight="1"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
