<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/launch_start"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/hudBar"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/hud_text"
            android:id="@+id/hudScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:id="@+id/hudCrystals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/neon_magenta"
            android:gravity="center"
            android:id="@+id/hudLives"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/neon_green"
            android:gravity="end"
            android:id="@+id/hudLevel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/hud_text"
        android:gravity="center"
        android:id="@+id/hudTime"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.neonpulse.gridlogic.view.NodeChargeView
        android:id="@+id/circuitView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="16sp"
            android:textColor="@color/neon_cyan"
            android:id="@+id/btnReset"
            android:background="@drawable/btn_neon_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reset"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"
            app:backgroundTint="@null"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/hud_text"
            android:id="@+id/btnBackGame"
            android:background="@drawable/btn_neon_secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/back"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"
            app:backgroundTint="@null"/>
    </LinearLayout>
</LinearLayout>
