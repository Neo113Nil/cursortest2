<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:layout_gravity="start|bottom"
        android:id="@+id/pob_mute_btn"
        android:background="@drawable/pob_mute_button_background"
        android:padding="0dp"
        android:layout_width="@dimen/pob_control_width"
        android:layout_height="@dimen/pob_control_height"
        android:layout_marginLeft="@dimen/pob_mute_button_left_margin"
        android:layout_marginBottom="@dimen/pob_mute_button_bottom_margin"
        android:src="@drawable/pob_mute_button_icon_selector_default"
        android:scaleType="centerInside"
        android:contentDescription="@null"/>
</FrameLayout>
