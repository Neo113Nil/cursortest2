<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ActivityTheme" parent="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>
    <style name="FullscreenAdActivity" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="MobileFuseFullscreenActivity" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>
    <style name="MobileFuseFullscreenActivityTranslucent" parent="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>
    <style name="POBFullScreenActivityTheme" parent="@style/POBTransparentTheme">
    </style>
    <style name="mbridge_transparent_common_activity_style" parent="@style/mbridge_common_activity_style">
    </style>
</resources>
