<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_dark_arcade"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_wood_ring"
            android:contentDescription="@string/home_title"/>
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/home_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/hud_text"
            android:gravity="center"
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_subtitle"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/neon_lime"
            android:gravity="center"
            android:id="@+id/bestScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/neon_magenta"
            android:gravity="center"
            android:id="@+id/crystalsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="@color/button_text"
            android:id="@+id/playButton"
            android:background="@drawable/btn_neon_primary"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="36dp"
            android:text="@string/play"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="@color/neon_magenta"
            android:id="@+id/rulesButton"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/rules"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
    </LinearLayout>
</FrameLayout>
