<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_dark_arcade"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rules_title"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/hud_text"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/rules_body"
            android:lineSpacingExtra="4dp"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="@color/neon_magenta"
            android:id="@+id/backButton"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:text="@string/back"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
    </LinearLayout>
</FrameLayout>
