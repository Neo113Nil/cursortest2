<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_dark_arcade"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_difficulty"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="@color/button_text"
            android:id="@+id/easyButton"
            android:background="@drawable/btn_neon_primary"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:text="@string/easy"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="@color/button_text"
            android:id="@+id/mediumButton"
            android:background="@drawable/btn_neon_primary"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/medium"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="@color/button_text"
            android:id="@+id/hardButton"
            android:background="@drawable/btn_neon_primary"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/hard"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="@color/neon_magenta"
            android:id="@+id/backButton"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:text="@string/back"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
    </LinearLayout>
</FrameLayout>
