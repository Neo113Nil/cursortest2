<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_dark_arcade"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <TextView
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:id="@+id/resultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/hud_text"
            android:gravity="center"
            android:id="@+id/resultOutcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/neon_lime"
            android:gravity="center"
            android:id="@+id/resultScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="@color/button_text"
            android:id="@+id/playAgainButton"
            android:background="@drawable/btn_neon_primary"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="36dp"
            android:text="@string/play_again"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="@color/neon_magenta"
            android:id="@+id/menuButton"
            android:background="@drawable/btn_neon_outline"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu"
            android:textAllCaps="false"
            app:backgroundTint="@null"/>
    </LinearLayout>
</FrameLayout>
