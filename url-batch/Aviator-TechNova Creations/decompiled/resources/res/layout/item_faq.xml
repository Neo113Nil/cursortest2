<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_language_card_selected"
    android:padding="14dp"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/tvFaqTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="① What is Aviator Game?"
        android:singleLine="true"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#b3ffffff"
        android:ellipsize="end"
        android:id="@+id/tvFaqDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Aviator is an online multiplier-style game features a virtual airplane."
        android:maxLines="3"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="10sp"
        android:textColor="#ffffff"
        android:id="@+id/btnRead"
        android:background="@drawable/bg_aviator_unique_button"
        android:layout_width="70dp"
        android:layout_height="28dp"
        android:layout_marginTop="10dp"
        android:text="READ"/>
</LinearLayout>
