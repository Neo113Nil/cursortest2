<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_10sdp"
    app:cardCornerRadius="@dimen/_10sdp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/_20sdp"
            android:textColor="#ff0000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="ERROR"
            android:fontFamily="@font/bold"/>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="#ff0000"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:text="You closed the Advertisement before it was fully loaded"
            android:fontFamily="@font/semi_bold"
            android:layout_marginHorizontal="@dimen/_10sdp"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="#000000"
            android:gravity="center_horizontal"
            android:id="@+id/txtSecondMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:text="@string/reopen_ads_message"
            android:fontFamily="@font/semi_bold"
            android:layout_marginHorizontal="@dimen/_10sdp"/>
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:indeterminateTint="@color/colorPrimary"/>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="#000000"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:text="Waiting for your ads click."
            android:fontFamily="@font/semi_bold"
            android:layout_marginHorizontal="@dimen/_10sdp"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/btnReOpen"
            android:background="@drawable/qopenbtn"
            android:layout_width="@dimen/_180sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_marginVertical="@dimen/_10sdp">
            <TextView
                android:textSize="@dimen/_18sdp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Re-Open Ads"
                android:fontFamily="@font/semi_bold"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
