<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        app:cardCornerRadius="4dp">
        <com.google.android.gms.ads.nativead.NativeAdView
            android:id="@+id/uadview"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:orientation="vertical"
                android:paddingBottom="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/ad_call_to_action">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="7">
                        <ImageView
                            android:id="@+id/blue"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                        <com.google.android.gms.ads.nativead.MediaView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/ad_media"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="7"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <androidx.core.widget.NestedScrollView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/icone"
                            android:paddingRight="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/icon_card"
                                android:layout_width="@dimen/_40sdp"
                                android:layout_height="@dimen/_40sdp"
                                android:layout_margin="4dp">
                                <ImageView
                                    android:id="@+id/ad_app_icon"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:adjustViewBounds="true"/>
                            </androidx.cardview.widget.CardView>
                            <LinearLayout
                                android:orientation="vertical"
                                android:paddingTop="2dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="4dp"
                                android:layout_marginStart="4dp">
                                <TextView
                                    android:textSize="@dimen/_11sdp"
                                    android:textStyle="bold"
                                    android:ellipsize="end"
                                    android:id="@+id/ad_headline"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginRight="8dp"
                                    android:maxLines="3"
                                    android:layout_marginEnd="8dp"/>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:visibility="visible"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <TextView
                                        android:textSize="@dimen/_9sdp"
                                        android:ellipsize="end"
                                        android:id="@+id/ad_body"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginTop="3dp"
                                        android:layout_marginRight="8dp"
                                        android:maxLines="3"
                                        android:layout_marginEnd="8dp"/>
                                    <RatingBar
                                        android:id="@+id/ad_stars"
                                        android:visibility="gone"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:numStars="5"
                                        android:stepSize="0.5"
                                        android:isIndicator="true"
                                        android:progressTint="@color/colorPrimary"
                                        style="?android:attr/ratingBarStyleSmall"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/ad_call_to_action"
                    android:background="@drawable/install_btn"
                    android:paddingLeft="@dimen/_10sdp"
                    android:paddingRight="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_alignParentBottom="true"
                    android:textAllCaps="false"/>
                <androidx.cardview.widget.CardView
                    android:gravity="center"
                    android:id="@+id/adcardView"
                    android:layout_width="18dp"
                    android:layout_height="13.5dp"
                    app:cardBackgroundColor="@color/colorPrimary2">
                    <TextView
                        android:textSize="9dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:background="@drawable/bg_ads"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="AD"/>
                </androidx.cardview.widget.CardView>
                <RelativeLayout
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:id="@+id/btnview"
                    android:paddingLeft="@dimen/_10sdp"
                    android:paddingTop="10dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentBottom="true">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ad_text_secondary"
                        android:ellipsize="end"
                        android:id="@+id/ad_advertiser"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="10dp"
                        android:maxLines="2"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:id="@+id/ad_price"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:id="@+id/ad_store"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:background="@drawable/install_btn"
                        android:paddingLeft="@dimen/_10sdp"
                        android:paddingRight="@dimen/_10sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_alignParentRight="true"
                        android:textAllCaps="false"/>
                </RelativeLayout>
            </RelativeLayout>
        </com.google.android.gms.ads.nativead.NativeAdView>
    </androidx.cardview.widget.CardView>
</LinearLayout>
