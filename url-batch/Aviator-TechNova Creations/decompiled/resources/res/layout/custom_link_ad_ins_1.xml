<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/relative"
        android:background="#faf5f5"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/logo_view"
            android:layout_width="match_parent"
            android:layout_height="120dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/logo_card"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="10dp"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="#fff"
                app:cardCornerRadius="5dp">
                <ImageView
                    android:id="@+id/logo_ins"
                    android:background="#fff"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#000"
                android:ellipsize="end"
                android:id="@+id/ins_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginRight="10dp"
                android:singleLine="true"
                android:layout_toRightOf="@+id/logo_card"/>
            <androidx.cardview.widget.CardView
                android:gravity="center"
                android:id="@+id/ad"
                android:layout_width="18dp"
                android:layout_height="13.5dp"
                android:layout_marginLeft="1dp"
                android:layout_marginTop="6dp"
                android:layout_toRightOf="@+id/logo_card"
                android:layout_below="@+id/ins_title">
                <TextView
                    android:textSize="9dp"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:background="@drawable/bg_ads"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="AD"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="13dp"
                android:textColor="#787878"
                android:ellipsize="end"
                android:id="@+id/ins_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="10dp"
                android:text=""
                android:maxLines="2"
                android:layout_toRightOf="@+id/ad"
                android:layout_below="@+id/ins_title"/>
        </RelativeLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/card_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="-10dp"
            android:layout_below="@+id/logo_view"
            android:layout_alignParentBottom="true"
            app:cardBackgroundColor="#fff"
            app:cardCornerRadius="8dp"
            app:cardElevation="8dp">
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/relative2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="10dp">
                <androidx.cardview.widget.CardView
                    android:id="@+id/banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="25dp"
                    android:layout_above="@+id/spon_name"
                    app:cardCornerRadius="8dp">
                    <ImageView
                        android:id="@+id/image_ins"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/spon_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    android:layout_above="@+id/btn_view">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#787878"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="Sponsored"
                        android:singleLine="true"
                        android:layout_alignParentBottom="true"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#000"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/ins_name2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_alignParentBottom="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/btn_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    android:layout_alignParentBottom="true">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/close"
                        android:background="@drawable/btn_cancle"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:layout_marginRight="10dp"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="15dp"
                            android:textColor="#000"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="5dp"
                            android:text="Close"
                            android:singleLine="true"
                            android:layout_alignParentBottom="true"/>
                        <View
                            android:background="#000"
                            android:layout_width="0.5dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="6dp"
                            android:layout_marginRight="6dp"/>
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">
                            <TextView
                                android:textSize="14dp"
                                android:textColor="#656161"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:id="@+id/left_time"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="8"
                                android:singleLine="true"
                                android:layout_alignParentBottom="true"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/tick"
                                android:padding="0.5dp"
                                android:visibility="gone"
                                android:layout_width="17dp"
                                android:layout_height="20dp"
                                android:src="@drawable/tick"/>
                        </FrameLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="17dp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/native_ad_call_to_action"
                        android:background="@drawable/qopenbtn"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:layout_marginRight="20dp"
                        android:text="Install"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                </LinearLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_alignParentRight="true"
        app:cardCornerRadius="@dimen/_100sdp"
        app:cardElevation="@dimen/_1sdp">
        <ImageView
            android:id="@+id/imgClose"
            android:padding="@dimen/_3sdp"
            android:visibility="gone"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="match_parent"
            android:src="@drawable/qureka_qureka_ic_close"
            app:tint="@color/black"/>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_20sdp"
            android:minHeight="@dimen/_20sdp"
            android:text="5"/>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/info"
        android:padding="4dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_info"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        app:tint="#4e97d6"/>
</RelativeLayout>
