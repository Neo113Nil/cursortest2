<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/native_ad_view"
    android:background="@color/bgcolor"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/ad_badge"
            android:background="@drawable/bg_mini_ad"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ad"
            android:backgroundTint="#6dd3d3d3"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/textcolor"
            android:id="@+id/ad_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/_5sdp"/>
        <TextView
            android:textColor="@color/textcolor"
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Install"/>
        <ImageView
            android:id="@+id/arrow"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:src="@drawable/arrow"
            android:layout_marginStart="@dimen/_2sdp"
            app:tint="@color/textcolor"/>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
