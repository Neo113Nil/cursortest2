<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="300dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <Button
            android:id="@+id/test_admob"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:text="Admob插屏"/>
        <Button
            android:id="@+id/test_chartboost"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:text="Chartboost插屏"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <Button
            android:id="@+id/test_unity"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:text="Unity插屏"/>
        <Button
            android:id="@+id/test_vungle"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:text="Vungle插屏"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <Button
            android:id="@+id/test_mopub"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:text="Mopub插屏"/>
        <Button
            android:id="@+id/test_adx"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:text="ADX插屏"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <Button
            android:id="@+id/test_facebook"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:text="FaceBook插屏"/>
        <Button
            android:id="@+id/test_ironsource"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:text="IronSource插屏"/>
    </LinearLayout>
</LinearLayout>
