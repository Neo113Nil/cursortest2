<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/popup_corners"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="20dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ad_choices_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_alignParentLeft="true"/>
        <Button
            android:id="@+id/iv_close"
            android:background="@drawable/vast_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="10dp"
            android:layout_alignParentRight="true"/>
        <com.facebook.ads.MediaView
            android:gravity="center"
            android:id="@+id/native_ad_media"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:layout_below="@+id/iv_close"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/native_ad_media">
            <ImageView
                android:id="@+id/iv_ad_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:maxWidth="80dp"
                android:maxHeight="80dp"
                android:minWidth="64dp"
                android:minHeight="64dp"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#ff999999"
                android:gravity="center_horizontal"
                android:id="@+id/native_ad_social_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/iv_ad_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ff252525"
                android:layout_gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="20dp"
                android:text="app name"
                android:maxLines="2"
                android:layout_below="@+id/native_ad_social_context"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ff888888"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/tv_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:maxLines="2"
                android:layout_below="@+id/tv_title"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <Button
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:id="@+id/btn_calltoaction"
            android:background="@drawable/btn_calltoaction_bg_blue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="25dp"
            android:text="Install"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
