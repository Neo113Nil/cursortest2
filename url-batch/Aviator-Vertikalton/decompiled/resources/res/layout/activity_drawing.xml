<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/topBar"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageButton
            android:id="@+id/backButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/drawing_title"
            android:layout_weight="1"/>
        <View
            android:layout_width="44dp"
            android:layout_height="44dp"/>
    </LinearLayout>
    <FrameLayout
        android:background="@drawable/canvas_frame"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <com.fortuneink.neonpad.DrawingCanvasView
            android:id="@+id/drawingCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/colorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <View
                android:id="@+id/swatchCyan"
                android:background="@drawable/swatch_cyan"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"/>
            <View
                android:id="@+id/swatchMagenta"
                android:background="@drawable/swatch_magenta"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"/>
            <View
                android:id="@+id/swatchLime"
                android:background="@drawable/swatch_lime"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"/>
            <View
                android:id="@+id/swatchYellow"
                android:background="@drawable/swatch_yellow"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"/>
            <View
                android:id="@+id/swatchRed"
                android:background="@drawable/swatch_red"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"/>
            <View
                android:id="@+id/swatchPurple"
                android:background="@drawable/swatch_purple"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"/>
            <View
                android:id="@+id/swatchOrange"
                android:background="@drawable/swatch_orange"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"/>
            <View
                android:id="@+id/swatchWhite"
                android:background="@drawable/swatch_white"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/brushRow"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/brushThin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/brush_thin"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:icon="@drawable/ic_brush"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            style="@style/NeonButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/brushMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/brush_medium"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:icon="@drawable/ic_brush"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            style="@style/NeonButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/brushThick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/brush_thick"
            android:layout_weight="1"
            app:icon="@drawable/ic_brush"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            style="@style/NeonButton"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/actionRow"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/clear_canvas"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:icon="@drawable/ic_clear"
            app:iconGravity="textStart"
            style="@style/NeonButton.Magenta"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/save_gallery"
            android:layout_weight="1"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart"
            style="@style/NeonButton"/>
    </LinearLayout>
</LinearLayout>
