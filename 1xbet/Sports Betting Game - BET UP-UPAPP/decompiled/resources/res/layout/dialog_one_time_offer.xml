<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/background_coins"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/black_transparent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="@drawable/dialog_shop_shape"
        android:paddingBottom="16dp"
        android:layout_width="@dimen/dialog_header_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:id="@+id/container"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/betcoinsContainer">
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/betcoin_pack_preview_shape"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp">
                <org.betup.ui.views.GradientTextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/big"
                    android:textAllCaps="true"
                    android:layout_marginStart="4dp"
                    app:centerColor="@color/white"
                    app:mainColor="@color/colorAccent"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/starting_balance"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/betcoin_pack_preview_shape"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp">
                <org.betup.ui.views.GradientTextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/access"
                    android:textAllCaps="true"
                    android:layout_marginStart="4dp"
                    app:centerColor="@color/white"
                    app:mainColor="@color/colorAccent"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/to_all_sports"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/betcoin_pack_preview_shape"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp">
                <org.betup.ui.views.GradientTextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_badge"
                    android:textAllCaps="true"
                    android:layout_marginStart="4dp"
                    app:centerColor="@color/white"
                    app:mainColor="@color/colorAccent"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/on_your_profile"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/betcoin_pack_preview_shape"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp">
                <org.betup.ui.views.GradientTextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_limit"
                    android:textAllCaps="true"
                    android:layout_marginStart="4dp"
                    app:centerColor="@color/white"
                    app:mainColor="@color/colorAccent"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/on_betting_amount"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/betcoin_pack_preview_shape"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp">
                <org.betup.ui.views.GradientTextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_copy"
                    android:textAllCaps="true"
                    android:layout_marginStart="4dp"
                    app:centerColor="@color/white"
                    app:mainColor="@color/colorAccent"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/other_user_bets"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/betcoin_pack_preview_shape"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp">
                <org.betup.ui.views.GradientTextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ads_removed"
                    android:textAllCaps="true"
                    android:layout_marginStart="4dp"
                    app:centerColor="@color/LightBlue"
                    app:mainColor="@color/blue"/>
            </LinearLayout>
            <org.betup.ui.views.GradientTextView
                android:textSize="18sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/now_only"
                android:textAllCaps="true"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:id="@+id/timer"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="96dp"
            android:paddingStart="24dp"
            android:paddingEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/one_time_offer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/timer"
            app:layout_constraintBottom_toBottomOf="@+id/timer"
            app:layout_constraintEnd_toStartOf="@+id/timer"
            app:layout_constraintStart_toStartOf="@+id/timer"
            app:layout_constraintTop_toTopOf="@+id/timer"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/betcoinsContainer"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timer">
            <org.betup.ui.views.GradientTextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:id="@+id/betcoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/betcoin"/>
            <org.betup.ui.views.GradientTextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:id="@+id/tickets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ticket"/>
        </LinearLayout>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/buy"
            android:background="@drawable/ok_button"
            android:layout_width="240dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/container">
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp">
                <org.betup.ui.views.GradientTextView
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:id="@+id/old_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:text="19.99 $"
                    app:centerColor="@color/white"
                    app:mainColor="@color/white"
                    app:outlineColor="@color/Black"
                    app:outlineWidth="1dp"/>
                <View
                    android:background="@drawable/red_diagonal_line"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <org.betup.ui.views.GradientTextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19.99 $"
                app:centerColor="@color/white"
                app:mainColor="@color/white"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
        </org.betup.ui.views.AlphaPressButton>
        <View
            android:background="@drawable/offer_discount"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            app:layout_constraintBottom_toBottomOf="@+id/buy"
            app:layout_constraintEnd_toStartOf="@+id/buy"
            app:layout_constraintStart_toStartOf="@+id/buy"
            app:layout_constraintTop_toTopOf="@+id/buy"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialog_container">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="400dp"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="false"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/offer_header"/>
        <org.betup.ui.controls.ArcTextView
            android:id="@+id/label"
            android:layout_width="300dp"
            android:layout_height="72dp"
            android:layout_marginBottom="40dp"
            android:src="@drawable/shop_label"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shadowEnabled="true"
            app:text="@string/vip_pack"
            app:textColor="@color/colorAccent"
            app:textSize="@dimen/font_size_maximum"/>
        <org.betup.ui.views.AlphaPressButton
            android:id="@+id/close"
            android:background="@drawable/dialog_close_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
