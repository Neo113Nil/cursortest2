<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/item_my_bets_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="left"
        android:orientation="vertical"
        android:id="@+id/container"
        android:padding="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/oddHolder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/fragment_standings_text_color"
                android:id="@+id/itemBetslipTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/font_size_small_10"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/itemBetslipIsLiveText"
                android:background="@drawable/betslip_live_shape"
                android:paddingLeft="5dp"
                android:paddingTop="1dp"
                android:paddingRight="5dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/itemBetslipTeamNames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="name 1 - name 2"
            android:maxLines="2"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/fragment_standings_text_color"
                android:id="@+id/itemBetslipSportName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="name"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:id="@+id/itemBetslipUsersPick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="name"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/oddHolder"
        android:background="@drawable/betslip_odd_shape"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/itemBetslipIsSelected"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/stat"
            android:visibility="visible"
            android:layout_width="8dp"
            android:layout_height="12dp"
            android:layout_marginRight="5dp"
            app:srcCompat="@drawable/bet_arrow"/>
        <TextView
            android:textSize="@dimen/font_size_small_10"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/itemBetslipOdds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/itemBetslipIsSelected"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/remove_bet"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/lock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="lockView, remove, lockIcon"/>
    <View
        android:orientation="horizontal"
        android:id="@+id/lockView"
        android:background="@color/transparent_lock"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:baselineAligned="false"
        android:layout_alignParentTop="false"
        android:layout_alignParentBottom="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/remove"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:layout_alignParentTop="false"
        android:layout_alignParentRight="false"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="false"
        android:layout_centerVertical="false"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/remove_bet"/>
    <ImageView
        android:id="@+id/lockIcon"
        android:visibility="visible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_weight="1"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/locked"/>
</androidx.constraintlayout.widget.ConstraintLayout>
