<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="@drawable/dialog_shop_shape"
        android:paddingBottom="16dp"
        android:layout_width="@dimen/dialog_header_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/mission_header_placeholder"/>
        <org.betup.ui.views.GradientTextView
            android:textSize="@dimen/font_size_giant"
            android:textStyle="bold"
            android:id="@+id/missionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mission"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:centerColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:mainColor="@color/colorAccent"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <org.betup.ui.views.GradientTextView
            android:textSize="@dimen/font_size_giant"
            android:textStyle="bold"
            android:id="@+id/displayNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:centerColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/missionLabel"
            app:mainColor="@color/colorAccent"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tasks"
            android:background="@drawable/bets_container_background"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="@dimen/tasks_min_height"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView"/>
        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="@+id/tasks"
            app:layout_constraintEnd_toEndOf="@+id/tasks"
            app:layout_constraintStart_toStartOf="@+id/tasks"
            app:layout_constraintTop_toTopOf="@+id/tasks"/>
        <org.betup.ui.views.GradientTextView
            android:textSize="@dimen/font_size_big"
            android:id="@+id/earnedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/missions_reward"
            android:textAllCaps="true"
            app:centerColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tasks"
            app:mainColor="@color/white"
            app:outlineWidth="1dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/rewardContainer"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:paddingTop="4dp"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/earnedLabel">
            <org.betup.ui.views.GradientTextView
                android:textSize="@dimen/font_size_big"
                android:textStyle="bold"
                android:id="@+id/tickets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ticket"/>
            <org.betup.ui.views.GradientTextView
                android:textSize="@dimen/font_size_big"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
            <org.betup.ui.views.GradientTextView
                android:textSize="@dimen/font_size_big"
                android:textStyle="bold"
                android:id="@+id/betcoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25,000"
                android:layout_marginEnd="8dp"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/betcoin"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ok"
            android:background="@drawable/buy_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rewardContainer">
            <org.betup.ui.views.GradientTextView
                android:textSize="@dimen/font_size_big"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/actionTitle"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/missions_claim"
                android:textAllCaps="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:centerColor="#ac7300"
                app:mainColor="#784701"
                app:outlineWidth="0dp"
                app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
        </org.betup.ui.views.AlphaPressButton>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/close"
        android:background="@drawable/dialog_close_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_container"
        app:layout_constraintEnd_toEndOf="@+id/dialog_container"
        app:layout_constraintStart_toEndOf="@+id/dialog_container"
        app:layout_constraintTop_toTopOf="@+id/dialog_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
