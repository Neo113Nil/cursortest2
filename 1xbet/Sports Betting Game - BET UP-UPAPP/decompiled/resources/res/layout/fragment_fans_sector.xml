<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        ads:layout_constraintLeft_toLeftOf="parent"
        ads:layout_constraintRight_toRightOf="parent"
        ads:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/header"
            android:background="@color/lightCyan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/likesContainer"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/likeIcon"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/like"
                    style="@style/TeamLogoItem"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="12sp"
                    android:textColor="@color/settings_header_text"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/likes"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:text="0"
                    android:maxLines="2"
                    android:layout_weight="0.1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:baselineAligned="false"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/drawer_divider"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/commentsContainer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/commentIcon"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/comment"
                        style="@style/TeamLogoItem"/>
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textSize="12sp"
                        android:textColor="@color/settings_header_text"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:id="@+id/comments"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="10dp"
                        android:text="0"
                        android:maxLines="2"
                        android:layout_weight="0.1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/drawer_divider"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/betIcon"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/bet"
                    style="@style/TeamLogoItem"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="12sp"
                    android:textColor="@color/settings_header_text"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/bets"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:text="0"
                    android:maxLines="2"
                    android:layout_weight="0.1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/drawer_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="2dp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/reposts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/info_reposts"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="8dp"
        ads:layout_constraintBottom_toBottomOf="@+id/viewsSmall"
        ads:layout_constraintLeft_toRightOf="@+id/viewsSmall"
        ads:layout_constraintRight_toLeftOf="@+id/imageView22"
        ads:layout_constraintTop_toTopOf="@+id/viewsSmall"
        ads:layout_constraintVertical_bias="0.444"/>
    <ImageView
        android:id="@+id/viewsSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        ads:layout_constraintBottom_toBottomOf="parent"
        ads:layout_constraintHorizontal_chainStyle="packed"
        ads:layout_constraintLeft_toLeftOf="parent"
        ads:layout_constraintRight_toLeftOf="@+id/reposts"
        ads:layout_constraintTop_toBottomOf="@+id/linearLayout3"
        ads:srcCompat="@drawable/repost"/>
    <TextView
        android:id="@+id/views"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="@string/info_views"
        android:layout_marginStart="8dp"
        ads:layout_constraintBottom_toBottomOf="@+id/imageView22"
        ads:layout_constraintLeft_toRightOf="@+id/imageView22"
        ads:layout_constraintRight_toRightOf="parent"
        ads:layout_constraintTop_toTopOf="@+id/imageView22"/>
    <ImageView
        android:id="@+id/imageView22"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        ads:layout_constraintBottom_toBottomOf="@+id/viewsSmall"
        ads:layout_constraintLeft_toRightOf="@+id/reposts"
        ads:layout_constraintRight_toLeftOf="@+id/views"
        ads:layout_constraintTop_toTopOf="@+id/viewsSmall"
        ads:srcCompat="@drawable/views"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/linearLayout3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        ads:layout_constraintBottom_toTopOf="@+id/viewsSmall"
        ads:layout_constraintLeft_toLeftOf="parent"
        ads:layout_constraintRight_toRightOf="parent"
        ads:layout_constraintTop_toBottomOf="@+id/linearLayout2"
        ads:layout_constraintVertical_chainStyle="packed">
        <ImageView
            android:id="@+id/facebook"
            android:background="@drawable/facebook_share"
            android:padding="8dp"
            android:clickable="true"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="5dp"
            android:src="@drawable/facebook"/>
        <ImageView
            android:id="@+id/email"
            android:background="@drawable/share_universal"
            android:padding="8dp"
            android:clickable="true"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="5dp"
            android:src="@drawable/share_email"/>
        <ImageView
            android:id="@+id/vk"
            android:background="@drawable/vk_share"
            android:padding="8dp"
            android:clickable="true"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="5dp"
            android:src="@drawable/vk"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
