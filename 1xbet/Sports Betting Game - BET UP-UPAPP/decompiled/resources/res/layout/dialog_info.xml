<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/dialog_shape"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="260dp"
        android:layout_centerInParent="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">
        <TextView
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/achievement_got"
            android:maxLines="4"
            android:shadowColor="@color/Black"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:breakStrategy="balanced"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="FIRST ATTEMPT"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:breakStrategy="balanced"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:src="@mipmap/achievements_icon"/>
        <TextView
            android:gravity="center"
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Place your first bet"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:breakStrategy="balanced"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 2000"
                android:layout_weight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center_horizontal"
                android:id="@+id/xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="300 XP"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/ok"
            android:background="@drawable/dialog_ok_selector"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/ok"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:gravity="center"
            android:id="@+id/secondButton"
            android:background="@drawable/gray_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/cancel_big"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:gravity="center"
            android:id="@+id/thirdButton"
            android:background="@drawable/gray_button_selector"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@android:string/cancel"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/social"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/gray"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/share_with_friends"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp">
                <ImageView
                    android:id="@+id/facebook"
                    android:background="@drawable/dialog_social_button_selector"
                    android:padding="8dp"
                    android:clickable="true"
                    android:layout_width="48dp"
                    android:layout_height="32dp"
                    android:layout_margin="5dp"
                    android:src="@drawable/facebook"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/vk"
                    android:background="@drawable/dialog_social_button_selector"
                    android:padding="8dp"
                    android:clickable="true"
                    android:layout_width="48dp"
                    android:layout_height="32dp"
                    android:layout_margin="5dp"
                    android:src="@drawable/vk"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/email"
                    android:background="@drawable/dialog_social_button_selector"
                    android:padding="8dp"
                    android:clickable="true"
                    android:layout_width="48dp"
                    android:layout_height="32dp"
                    android:layout_margin="5dp"
                    android:src="@drawable/share_email"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
