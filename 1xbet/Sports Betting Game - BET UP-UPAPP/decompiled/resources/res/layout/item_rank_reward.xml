<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/rank_reward_text_item_size"
        android:textStyle="bold"
        android:textColor="@color/DarkGray"
        android:id="@+id/place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/rank_reward_text_item_size"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/betcoins"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rank_reward_text_item_distance"/>
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/betcoin"
        android:layout_marginStart="@dimen/rank_reward_text_item_distance"
        android:layout_marginEnd="@dimen/rank_reward_text_item_distance"/>
</LinearLayout>
