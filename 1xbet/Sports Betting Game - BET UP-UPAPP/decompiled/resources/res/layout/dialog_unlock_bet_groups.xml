<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="@drawable/dialog_shop_shape"
        android:layout_width="@dimen/dialog_header_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <org.betup.ui.views.GradientTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:text="@string/unlock_all_bet_types"
            android:textAllCaps="true"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:centerColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:mainColor="@color/white"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <View
            android:id="@+id/iconContainer"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:layout_width="190dp"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <ImageView
            android:id="@+id/icon"
            android:layout_width="0dp"
            android:layout_height="354dp"
            android:layout_marginTop="0dp"
            android:src="@drawable/unlock_bet_groups_icon"
            android:scaleType="fitXY"
            android:layout_marginStart="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <org.betup.ui.views.GradientTextView
            android:textSize="18sp"
            android:id="@+id/only_now"
            android:background="@drawable/only_now_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/unlock_for_text"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iconContainer"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/exchange"
            android:background="@drawable/buy_button"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/or"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/only_now">
            <org.betup.ui.views.GradientTextView
                android:textSize="@dimen/font_size_very_big"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/price"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:centerColor="#ac7300"
                app:mainColor="#784701"
                app:outlineWidth="0dp"
                app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
        </org.betup.ui.views.AlphaPressButton>
        <LinearLayout
            android:id="@+id/betcoinsContainer"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/exchange"
            app:layout_constraintEnd_toEndOf="@+id/exchange"
            app:layout_constraintStart_toStartOf="@+id/exchange"
            app:layout_constraintTop_toBottomOf="@+id/exchange">
            <org.betup.ui.views.GradientTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:id="@+id/bonusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+25,0000"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/betcoin"/>
        </LinearLayout>
        <org.betup.ui.views.GradientTextView
            android:textSize="18sp"
            android:id="@+id/or"
            android:background="@drawable/only_now_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/or"
            android:textAllCaps="true"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/exchange"
            app:layout_constraintEnd_toStartOf="@+id/watchVideo"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/exchange"
            app:layout_constraintTop_toTopOf="@+id/exchange"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/watchVideo"
            android:background="@drawable/ok_button"
            android:visibility="gone"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/exchange"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/or"
            app:layout_constraintTop_toTopOf="@+id/exchange">
            <androidx.appcompat.widget.AppCompatTextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/multiplyBonusTitle"
                android:layout_width="120dp"
                android:layout_height="24dp"
                android:text="@string/watch_ad"
                android:maxLines="1"
                android:shadowColor="@color/black"
                android:shadowRadius="3"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:autoSizeMaxTextSize="24sp"
                app:autoSizeTextType="uniform"/>
        </org.betup.ui.views.AlphaPressButton>
        <ImageView
            android:id="@+id/videoIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/video_reward_icon"
            app:layout_constraintBottom_toTopOf="@+id/watchVideo"
            app:layout_constraintEnd_toEndOf="@+id/watchVideo"
            app:layout_constraintStart_toEndOf="@+id/watchVideo"
            app:layout_constraintTop_toTopOf="@+id/watchVideo"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialog_container">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="400dp"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="false"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/unlocks_header"/>
        <org.betup.ui.views.AlphaPressButton
            android:id="@+id/close"
            android:background="@drawable/dialog_close_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <org.betup.ui.controls.ArcTextView
            android:textStyle="bold"
            android:id="@+id/label"
            android:layout_width="300dp"
            android:layout_height="54dp"
            android:layout_marginBottom="44dp"
            android:src="@drawable/shop_label"
            android:textAllCaps="true"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shadowEnabled="true"
            app:text="@string/become_betting_master"
            app:textAllCaps="true"
            app:textColor="@color/colorAccent"
            app:textSize="@dimen/font_size_big"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
