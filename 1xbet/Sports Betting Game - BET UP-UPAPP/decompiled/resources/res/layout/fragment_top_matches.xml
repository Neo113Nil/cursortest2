<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/tabBarCompose"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/expandRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">
            <ImageView
                android:id="@+id/one_click_bet_iv"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/flash_unselected"
                android:contentDescription="@string/cd_one_click_bet"
                android:layout_marginEnd="6dp"/>
            <FrameLayout
                android:id="@+id/expandContainer"
                android:layout_width="40dp"
                android:layout_height="20dp">
                <ImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/expandButton"
                    android:visibility="visible"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/collapse_btn"
                    android:tint="@color/primary_btn"/>
            </FrameLayout>
        </LinearLayout>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/topMatchesPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</RelativeLayout>
