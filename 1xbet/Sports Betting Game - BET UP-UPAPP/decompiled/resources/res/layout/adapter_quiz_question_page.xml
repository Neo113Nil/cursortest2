<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/quiz_question_number_ll"
        android:background="@drawable/black_border_circle_shape"
        android:padding="5dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/font_size_big"
            android:id="@+id/quiz_question_number_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:shadowColor="#000000"
            android:shadowDy="5"
            android:shadowRadius="3"
            android:fontFamily="@font/montserrat_extra_bold"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/quiz_question_number_iv"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/achievement_taken"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
