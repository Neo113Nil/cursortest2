<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_dice_container"
    android:background="@drawable/fragment_dice_main_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/curve"
        android:background="@drawable/curve_20_gradus_to_bottom"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/schene"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_arc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curve">
        <org.betup.ui.views.BetUpLabelView
            android:id="@+id/labelView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="33dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            app:labelBackground="BLUE"
            app:starBackground="BLUE"/>
        <View
            android:id="@+id/firstDice"
            android:layout_width="64dp"
            android:layout_height="64dp"/>
        <View
            android:id="@+id/secondDice"
            android:layout_width="64dp"
            android:layout_height="64dp"/>
    </RelativeLayout>
    <View
        android:id="@+id/constraintContainerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_arc"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/containerDialogResult"
        android:background="@drawable/game_result_won_background"
        android:paddingTop="28dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_arc">
        <include
            android:id="@+id/won_container"
            layout="@layout/container_result_games"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/resultScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
        <org.betup.ui.views.AlphaPressButton
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/okButton"
            android:background="@drawable/mini_games_make_bet"
            android:layout_width="150dp"
            android:layout_height="35dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp">
            <TextView
                android:textSize="16sp"
                android:layout_gravity="center"
                android:paddingTop="6dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ok"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_arc">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/progressBarStyle"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/bottomHideGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="diceResultSelectRadioGroup,diceContainerButtons"/>
    <org.betup.ui.views.AdvancedRadioGroup
        android:orientation="horizontal"
        android:id="@+id/diceResultSelectRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/diceContainerButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <org.betup.ui.views.CheckableAlphaPressButton
            android:orientation="vertical"
            android:id="@+id/buttonMore"
            android:background="@drawable/mini_games_green_button"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/Black"
                android:layout_gravity="center"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mini_games_over_than"
                android:shadowColor="@color/mini_game_button_light_green"
                android:shadowDy="2"
                android:shadowRadius="1"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:layout_gravity="center"
                android:id="@+id/coefMore"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/mini_game_button_light_green"
                android:shadowDy="2"
                android:shadowRadius="1"/>
        </org.betup.ui.views.CheckableAlphaPressButton>
        <org.betup.ui.views.CheckableAlphaPressButton
            android:orientation="vertical"
            android:id="@+id/buttonEqual"
            android:background="@drawable/mini_games_green_button"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/Black"
                android:layout_gravity="center"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7"
                android:shadowColor="@color/mini_game_button_light_green"
                android:shadowDy="2"
                android:shadowRadius="1"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:layout_gravity="center"
                android:id="@+id/coefEquals"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/mini_game_button_light_green"
                android:shadowDy="2"
                android:shadowRadius="1"/>
        </org.betup.ui.views.CheckableAlphaPressButton>
        <org.betup.ui.views.CheckableAlphaPressButton
            android:orientation="vertical"
            android:id="@+id/buttonLess"
            android:background="@drawable/mini_games_green_button"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="24dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/Black"
                android:layout_gravity="center"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mini_games_less_than"
                android:shadowColor="@color/mini_game_button_light_green"
                android:shadowDy="2"
                android:shadowRadius="1"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:layout_gravity="center"
                android:id="@+id/coefLess"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/mini_game_button_light_green"
                android:shadowDy="2"
                android:shadowRadius="1"/>
        </org.betup.ui.views.CheckableAlphaPressButton>
    </org.betup.ui.views.AdvancedRadioGroup>
    <include
        android:id="@+id/diceContainerButtons"
        layout="@layout/place_betcoins_amount_container"/>
    <View
        android:id="@+id/bottom_arc"
        android:background="@drawable/brown_arc"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/diceResultSelectRadioGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
