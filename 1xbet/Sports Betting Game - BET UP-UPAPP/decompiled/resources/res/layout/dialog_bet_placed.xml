<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="0x7f0805f7"
        android:paddingBottom="16dp"
        android:layout_width="@dimen/dialog_header_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/stats"
            android:background="0x7f081235"
            android:paddingTop="8dp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="110dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/blue_stats_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placed"
                android:textAllCaps="true"
                android:layout_marginEnd="8dp"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/betcoin"
                android:layout_marginEnd="8dp"/>
            <org.betup.ui.views.GradientTextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:id="@+id/placed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17000"
                android:layout_marginEnd="8dp"
                app:centerColor="@color/colorAccent"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/blue_stats_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_bets_odds"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="8dp"/>
            <org.betup.ui.views.GradientTextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:id="@+id/odds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.88"
                android:textAllCaps="true"
                android:layout_marginEnd="8dp"
                app:centerColor="@color/colorAccent"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bets"
            android:background="@drawable/bets_container_background"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stats"/>
        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="@+id/bets"
            app:layout_constraintEnd_toEndOf="@+id/bets"
            app:layout_constraintStart_toStartOf="@+id/bets"
            app:layout_constraintTop_toTopOf="@+id/bets"/>
        <Button
            android:textColor="@color/gray"
            android:id="@+id/close"
            android:background="@drawable/button_round_background"
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:text="@string/close"
            android:textAllCaps="false"
            android:translationZ="5dp"
            app:layout_constraintEnd_toStartOf="@+id/videoButton"
            app:layout_constraintStart_toStartOf="@+id/bets"
            app:layout_constraintTop_toBottomOf="@+id/bets"
            app:textSize="@dimen/font_size_medium"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/videoButton"
            android:background="@drawable/ok_button"
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:alpha="1"
            app:layout_constraintBottom_toBottomOf="@+id/close"
            app:layout_constraintEnd_toEndOf="@+id/bets"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/close"
            app:layout_constraintTop_toTopOf="@+id/close">
            <androidx.appcompat.widget.AppCompatTextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/multiplyBonusTitle"
                android:layout_width="140dp"
                android:layout_height="24dp"
                android:text="@string/get_bonus"
                android:maxLines="1"
                android:shadowColor="@color/black"
                android:shadowRadius="3"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:autoSizeMaxTextSize="24sp"
                app:autoSizeTextType="uniform"/>
        </org.betup.ui.views.AlphaPressButton>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/consolation_prize"
            android:background="@drawable/video_bonus_amount_shape"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/videoButton"
            app:layout_constraintEnd_toEndOf="@+id/videoButton"
            app:layout_constraintStart_toStartOf="@+id/videoButton">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/consolationPrizeAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/betcoin"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/videoRewardIcon"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="-8dp"
            android:src="@drawable/video_reward_icon"
            app:layout_constraintEnd_toEndOf="@+id/videoButton"
            app:layout_constraintStart_toEndOf="@+id/videoButton"
            app:layout_constraintTop_toTopOf="@+id/videoButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialog_container">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="390dp"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="false"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/bet_placed_header"/>
        <ImageView
            android:id="@+id/label"
            android:layout_width="250dp"
            android:layout_height="81dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/bet_placed_header_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
