<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/header"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <ImageView
                    android:id="@+id/chatsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/chat_icon"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/no_bets_toolbar_text"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:id="@+id/messagesCount"
                    android:background="@drawable/events_shape"
                    android:paddingBottom="1dp"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <ImageView
                    android:id="@+id/notificationsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/notification_icon"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/no_bets_toolbar_text"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:id="@+id/eventsDrawerCount"
                    android:background="@drawable/events_shape"
                    android:paddingBottom="1dp"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.1">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/avatarIcon"
                android:layout_width="81dp"
                android:layout_height="81dp"
                android:src="@mipmap/bowls"
                android:scaleType="fitXY"
                app:riv_border_color="@color/magentaCyanBlack"
                app:riv_border_width="5dp"
                app:riv_corner_radius="30dp"
                app:riv_mutate_background="true"
                app:riv_oval="true"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="BETUP User"
                android:maxLines="1"/>
            <org.betup.ui.controls.RoiView
                android:id="@+id/roiView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:fontColor="@color/colorAccent"
                app:fontSize="14"
                app:transparent="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/achievementsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/new_menu_achievements_active"/>
            <ImageView
                android:id="@+id/moneyButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/shop_icon"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
