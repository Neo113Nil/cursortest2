<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="@color/blackCyan"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="14sp"
        android:textColor="@color/item_top_text_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/topUsersListRank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/topUsersListPhoto"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/user_round_avatar"
        android:scaleType="fitXY"
        android:adjustViewBounds="false"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/topUsersListRank"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_border_color="@color/magentaCyanBlack"
        app:riv_border_width="3dp"
        app:riv_corner_radius="30dp"
        app:riv_mutate_background="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="14sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/topUsersListName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:text="Medium Text"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/roiView"
        app:layout_constraintStart_toEndOf="@+id/topUsersListPhoto"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.betup.ui.controls.RoiView
        android:id="@+id/roiView"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:maxWidth="112dp"
        android:minWidth="62dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
