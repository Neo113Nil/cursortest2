<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/daily_bonus_item_background"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginStart="3dp"
    android:layout_marginEnd="3dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <View
        android:id="@+id/userGroupViews"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rightDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:id="@+id/winner_place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1."
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/avatarContainer"
        android:paddingTop="6dp"
        android:layout_width="44dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/winner_place"
        app:layout_constraintTop_toTopOf="parent">
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/player_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon"
            android:scaleType="fitXY"
            android:layout_marginStart="4dp"
            app:riv_border_color="@color/magentaCyanBlack"
            app:riv_border_width="3dp"
            app:riv_corner_radius="30dp"
            app:riv_mutate_background="true"
            app:riv_oval="true"/>
        <TextView
            android:textSize="10sp"
            android:gravity="center"
            android:layout_gravity="end|bottom"
            android:id="@+id/rankLevel"
            android:background="@drawable/level_shape_4"
            android:paddingBottom="1dp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:maxLength="2"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/tupUserImageHomeFragment"/>
    </FrameLayout>
    <View
        android:id="@+id/leftDivider"
        android:background="@color/color_midnight_blue"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatarContainer"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/icon_country"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/leftDivider"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/participant_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/rightDivider"
        app:layout_constraintStart_toEndOf="@+id/icon_country"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.betup.ui.controls.RoiView
        android:id="@+id/roiView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/participant_name"
        app:layout_constraintStart_toStartOf="@+id/participant_name"
        app:layout_constraintTop_toBottomOf="@+id/participant_name"/>
    <View
        android:id="@+id/rightDivider"
        android:background="@color/color_midnight_blue"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/challengeButtonContainer"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/challengeButtonContainer"
        android:background="@drawable/dark_blue_button"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:id="@+id/challengeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/challenge"/>
        <ImageView
            android:id="@+id/challengeIcon"
            android:background="@drawable/new_menu_challenges_active"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
