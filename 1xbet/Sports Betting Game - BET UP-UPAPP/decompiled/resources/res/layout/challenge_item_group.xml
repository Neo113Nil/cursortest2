<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/challenge_item_container"
    android:background="@drawable/challenge_list_item_main_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="32dp">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/Gray"
            android:gravity="center"
            android:id="@+id/time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/userBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/firstUserIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:src="@mipmap/bowls"
            android:scaleType="fitXY"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_border_color="@color/magentaCyanBlack"
            app:riv_border_width="0dp"
            app:riv_mutate_background="true"
            app:riv_oval="true"/>
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/secondUserIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:src="@mipmap/bowls"
            android:scaleType="fitXY"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_border_color="@color/magentaCyanBlack"
            app:riv_border_width="0dp"
            app:riv_mutate_background="true"
            app:riv_oval="true"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/firstUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:lines="2"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/firstUserIcon"
            app:layout_constraintEnd_toStartOf="@+id/textView16"
            app:layout_constraintStart_toEndOf="@+id/firstUserIcon"
            app:layout_constraintTop_toTopOf="@+id/firstUserIcon"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/secondUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:lines="3"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/secondUserIcon"
            app:layout_constraintEnd_toStartOf="@+id/secondUserIcon"
            app:layout_constraintStart_toEndOf="@+id/textView16"
            app:layout_constraintTop_toTopOf="@+id/secondUserIcon"/>
        <ImageView
            android:id="@+id/textView16"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/vs_icon"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/secondUserName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/secondUserName"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/challenge_status_bar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAllCaps="true"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/challenge_status_bottom"
            app:layout_constraintStart_toEndOf="@+id/challenge_status_bottom"
            app:layout_constraintTop_toTopOf="@+id/challenge_status_bottom"/>
        <ImageView
            android:id="@+id/imageView18"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/prize"
            app:layout_constraintEnd_toStartOf="@+id/prize"
            app:layout_constraintTop_toTopOf="@+id/prize"
            app:srcCompat="@drawable/betcoin"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/prize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </LinearLayout>
</LinearLayout>
