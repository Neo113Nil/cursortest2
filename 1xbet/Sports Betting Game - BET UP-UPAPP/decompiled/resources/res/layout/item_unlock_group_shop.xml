<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="98dp"
    android:layout_marginTop="4dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:background="@drawable/shop_item_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/amountContainer"
            android:background="@drawable/shop_coins_shape"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:paddingStart="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title">
            <org.betup.ui.views.FontText
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/bonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:text="TextView"
                android:maxLines="1"
                android:shadowColor="@color/Black"
                android:shadowDx="5"
                android:shadowDy="5"
                android:shadowRadius="5"
                android:layout_marginStart="16dp"
                app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/betcoin"/>
        </LinearLayout>
        <View
            android:background="@drawable/competition_random_button_background"
            android:layout_width="74dp"
            android:layout_height="34dp"
            app:layout_constraintBottom_toBottomOf="@+id/priceContainer"
            app:layout_constraintEnd_toEndOf="@+id/priceContainer"
            app:layout_constraintStart_toStartOf="@+id/priceContainer"
            app:layout_constraintTop_toTopOf="@+id/priceContainer"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/priceContainer"
            android:background="@drawable/buy_button"
            android:clickable="false"
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/amountContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <org.betup.ui.views.GradientTextView
                android:textSize="@dimen/font_size_medium"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/price"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                app:centerColor="#ac7300"
                app:mainColor="#784701"
                app:outlineWidth="0dp"
                app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
            <View
                android:background="@drawable/ticket"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <org.betup.ui.views.GradientTextView
            android:textSize="@dimen/font_size_big"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="3"
            android:lineSpacingMultiplier="0.8"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="8dp"
            app:centerColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/priceContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_centerVertical="true"
        app:srcCompat="@drawable/money_cup"/>
</RelativeLayout>
