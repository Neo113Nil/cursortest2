<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="64sp"
            android:textColor="@color/double_game_result_dialog_win_text"
            android:id="@+id/result_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/double_game_result_title_win"
            android:maxLines="1"
            android:fontFamily="@font/open_sans_bold"
            android:textAlignment="center"
            android:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="32sp"
            android:textColor="@color/double_game_result_dialog_win_text"
            android:id="@+id/subtitle_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/double_game_result_subtitle_lost"
            android:maxLines="1"
            android:fontFamily="@font/open_sans_bold"
            android:textAlignment="center"
            android:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/result_tv"/>
        <ImageView
            android:id="@+id/result_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/double_game_result_dialog_win"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitle_tv"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/amount_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/result_iv">
            <TextView
                android:textSize="32sp"
                android:textColor="@color/double_game_result_dialog_win_text"
                android:id="@+id/amount_type_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/double_game_result_amount_win"
                android:fontFamily="@font/open_sans_bold"
                android:textAlignment="center"
                android:autoSizeTextType="uniform"/>
            <TextView
                android:textSize="32sp"
                android:textColor="@color/double_game_text"
                android:id="@+id/amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_bold"
                android:textAlignment="center"
                android:autoSizeTextType="uniform"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/betcoin"/>
        </LinearLayout>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/result_fl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:alignItems="center"
            app:justifyContent="space_evenly"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/amount_ll">
            <LinearLayout
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/double_game_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/double_game_your_pick"
                    android:fontFamily="@font/open_sans_bold"
                    android:textAlignment="center"
                    android:autoSizeTextType="uniform"/>
                <View
                    android:id="@+id/selected_bet_type_v"
                    android:background="@drawable/double_game_bet_type_button_red_bg"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/double_game_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/double_game_result_label"
                    android:fontFamily="@font/open_sans_bold"
                    android:textAlignment="center"
                    android:autoSizeTextType="uniform"/>
                <View
                    android:id="@+id/result_bet_type_v"
                    android:background="@drawable/double_game_bet_type_button_red_bg"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </com.google.android.flexbox.FlexboxLayout>
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:alignItems="center"
            app:flexWrap="wrap"
            app:justifyContent="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/result_fl">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/confirm_ll"
                android:background="@drawable/round_corners"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/double_game_result_dialog_win_text"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/double_game_zero_bet_type_text"
                    android:id="@+id/confirm_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/double_game_result_watch_ad_lost"
                    android:fontFamily="@font/open_sans_bold"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/watch_ad_ll"
                android:background="@drawable/round_corners"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/double_game_make_bet_active_bg"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/double_game_text"
                    android:id="@+id/watch_ad_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_bold"/>
                <ImageView
                    android:id="@+id/watch_ad_iv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/betcoin"/>
                <ImageView
                    android:id="@+id/watch_ad_icon_iv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/double_game_watch_ad"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </com.google.android.flexbox.FlexboxLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
