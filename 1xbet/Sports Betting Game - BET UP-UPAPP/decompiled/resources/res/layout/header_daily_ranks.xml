<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rays"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageView16"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toStartOf="@+id/imageView19"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ranks_day_rope"/>
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/secondUserName"
        android:background="@drawable/rank_name_shape"
        android:padding="2dp"
        android:layout_width="81dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text=""
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/imageView21"
        app:layout_constraintEnd_toEndOf="@+id/imageView16"
        app:layout_constraintStart_toStartOf="@+id/imageView16"/>
    <ImageView
        android:id="@+id/imageView19"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/imageView20"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/imageView16"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ranks_day_rope"/>
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/firstUserName"
        android:background="@drawable/rank_name_shape"
        android:padding="2dp"
        android:layout_width="81dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text=""
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/imageView28"
        app:layout_constraintEnd_toEndOf="@+id/imageView19"
        app:layout_constraintStart_toStartOf="@+id/imageView19"/>
    <ImageView
        android:id="@+id/imageView20"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:scaleType="fitXY"
        android:layout_marginStart="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/imageView19"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ranks_day_rope"/>
    <ImageView
        android:id="@+id/imageView21"
        android:layout_width="128dp"
        android:layout_height="128dp"
        app:layout_constraintEnd_toEndOf="@+id/imageView16"
        app:layout_constraintStart_toStartOf="@+id/imageView16"
        app:layout_constraintTop_toBottomOf="@+id/imageView16"
        app:srcCompat="@drawable/silver_medal"/>
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/thirdUserName"
        android:background="@drawable/rank_name_shape"
        android:padding="2dp"
        android:layout_width="81dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text=""
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/imageView21"
        app:layout_constraintEnd_toEndOf="@+id/imageView20"
        app:layout_constraintStart_toStartOf="@+id/imageView20"/>
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/secondUserIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/user_round_avatar"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/imageView21"
        app:layout_constraintEnd_toEndOf="@+id/imageView21"
        app:layout_constraintStart_toStartOf="@+id/imageView21"
        app:layout_constraintTop_toTopOf="@+id/imageView21"
        app:riv_border_color="@color/white"
        app:riv_border_width="2dp"
        app:riv_corner_radius="30dp"
        app:riv_mutate_background="true"
        app:riv_oval="true"/>
    <ImageView
        android:id="@+id/secondUserCountry"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/secondUserIcon"
        app:layout_constraintStart_toStartOf="@+id/imageView21"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/Black"
        android:gravity="center"
        android:id="@+id/secondUserLevel"
        android:background="@drawable/rank_level_shape"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:text="12"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/secondUserIcon"
        app:layout_constraintEnd_toEndOf="@+id/imageView21"/>
    <ImageView
        android:id="@+id/imageView24"
        android:layout_width="128dp"
        android:layout_height="128dp"
        app:layout_constraintEnd_toEndOf="@+id/imageView20"
        app:layout_constraintStart_toStartOf="@+id/imageView20"
        app:layout_constraintTop_toBottomOf="@+id/imageView20"
        app:srcCompat="@drawable/bronze_medal"/>
    <org.betup.ui.controls.RoiView
        android:textSize="@dimen/font_size_very_small"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/thirdUserRank"
        android:background="@drawable/rank_field_bronze"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/imageView24"
        app:layout_constraintStart_toStartOf="@+id/imageView24"
        app:layout_constraintTop_toBottomOf="@+id/imageView24"/>
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/thirdUserIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/user_round_avatar"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/imageView24"
        app:layout_constraintEnd_toEndOf="@+id/imageView24"
        app:layout_constraintStart_toStartOf="@+id/imageView24"
        app:layout_constraintTop_toTopOf="@+id/imageView24"
        app:riv_border_color="@color/white"
        app:riv_border_width="2dp"
        app:riv_corner_radius="30dp"
        app:riv_mutate_background="true"
        app:riv_oval="true"/>
    <ImageView
        android:id="@+id/thirdUserCountry"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/thirdUserIcon"
        app:layout_constraintStart_toStartOf="@+id/imageView24"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/Black"
        android:gravity="center"
        android:id="@+id/thirdUserLevel"
        android:background="@drawable/rank_level_shape"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:text="12"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/thirdUserIcon"
        app:layout_constraintEnd_toEndOf="@+id/imageView24"/>
    <ImageView
        android:id="@+id/imageView28"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:layout_constraintEnd_toEndOf="@+id/imageView19"
        app:layout_constraintStart_toStartOf="@+id/imageView19"
        app:layout_constraintTop_toBottomOf="@+id/imageView19"
        app:srcCompat="@drawable/gold_medal"/>
    <org.betup.ui.controls.RoiView
        android:textSize="@dimen/font_size_very_small"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/firstUserRank"
        android:background="@drawable/rank_field_gold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/imageView28"
        app:layout_constraintStart_toStartOf="@+id/imageView28"
        app:layout_constraintTop_toBottomOf="@+id/imageView28"/>
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/firstUserIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/user_round_avatar"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/imageView28"
        app:layout_constraintEnd_toEndOf="@+id/imageView28"
        app:layout_constraintStart_toStartOf="@+id/imageView28"
        app:layout_constraintTop_toTopOf="@+id/imageView28"
        app:riv_border_color="@color/white"
        app:riv_border_width="2dp"
        app:riv_corner_radius="30dp"
        app:riv_mutate_background="true"
        app:riv_oval="true"/>
    <ImageView
        android:id="@+id/firstUserCountry"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/firstUserIcon"
        app:layout_constraintStart_toStartOf="@+id/imageView28"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/Black"
        android:gravity="center"
        android:id="@+id/firstUserLevel"
        android:background="@drawable/rank_level_shape"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:text="12"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/firstUserIcon"
        app:layout_constraintEnd_toEndOf="@+id/imageView28"/>
    <org.betup.ui.controls.RoiView
        android:textSize="@dimen/font_size_very_small"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/secondUserRank"
        android:background="0x7f0811d1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/imageView21"
        app:layout_constraintStart_toStartOf="@+id/imageView21"
        app:layout_constraintTop_toBottomOf="@+id/imageView21"/>
</androidx.constraintlayout.widget.ConstraintLayout>
