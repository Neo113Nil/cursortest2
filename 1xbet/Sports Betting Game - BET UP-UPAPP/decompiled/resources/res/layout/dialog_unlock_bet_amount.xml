<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="@drawable/dialog_shop_shape"
        android:layout_width="@dimen/dialog_header_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:background="@drawable/rays"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:src="@drawable/chains_background"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <org.betup.ui.views.GradientTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:text="@string/remove_bet_limits"
            android:textAllCaps="true"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:centerColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:mainColor="@color/white"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <View
            android:id="@+id/iconContainer"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <ImageView
            android:id="@+id/icon"
            android:layout_width="240dp"
            android:layout_height="210dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/unlock_bet_amount_icon"
            android:layout_marginStart="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/iconContainer"
            app:layout_constraintEnd_toEndOf="@+id/iconContainer"
            app:layout_constraintStart_toStartOf="@+id/iconContainer"
            app:layout_constraintTop_toTopOf="@+id/iconContainer"/>
        <LinearLayout
            android:id="@+id/betcoinsContainer"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iconContainer">
            <org.betup.ui.views.GradientTextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:id="@+id/bonusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25,0000"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/betcoin"/>
        </LinearLayout>
        <org.betup.ui.views.GradientTextView
            android:textSize="18sp"
            android:id="@+id/only_now"
            android:background="@drawable/only_now_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/now_only"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/betcoinsContainer"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <org.betup.ui.controls.SpriteImageButton
            android:id="@+id/exchange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/only_now"
            app:spriteSrc="@drawable/buy_button"
            app:verticalPadding="32dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialog_container">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="400dp"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="false"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/unlocks_header"/>
        <org.betup.ui.views.AlphaPressButton
            android:id="@+id/close"
            android:background="@drawable/dialog_close_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <org.betup.ui.controls.ArcTextView
            android:textStyle="bold"
            android:id="@+id/label"
            android:layout_width="300dp"
            android:layout_height="54dp"
            android:layout_marginBottom="44dp"
            android:src="@drawable/shop_label"
            android:textAllCaps="true"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shadowEnabled="true"
            app:text="@string/say_no_limits"
            app:textAllCaps="true"
            app:textColor="@color/colorAccent"
            app:textSize="@dimen/font_size_very_big"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
