<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/item_my_bets_competition_group"
    android:background="@drawable/competition_active_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:elevation="4dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/competition_name"
        android:background="@drawable/competition_footer_active_background"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:text="@string/competition_name"
        android:layout_centerInParent="true"
        android:paddingStart="32dp"
        android:paddingEnd="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/sportIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="-2dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/competition_name"
        app:layout_constraintStart_toStartOf="@+id/competition_name"
        app:layout_constraintTop_toTopOf="@+id/competition_name"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/White"
        android:id="@+id/buy_in_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/competition_list_buy_in"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/competition_name"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/betcoin"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/betcoin"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/buy_in_title"
        app:layout_constraintStart_toEndOf="@+id/buy_in_title"
        app:layout_constraintTop_toTopOf="@+id/buy_in_title"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/White"
        android:id="@+id/buy_in_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_marginStart="4dp"
        android:layout_alignParentStart="true"
        app:layout_constraintBottom_toBottomOf="@+id/buy_in_title"
        app:layout_constraintStart_toEndOf="@+id/betcoin"
        app:layout_constraintTop_toTopOf="@+id/buy_in_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/White"
        android:id="@+id/status_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/competition_status"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buy_in_title"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/White"
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text=""
        android:layout_marginStart="8dp"
        android:layout_alignParentStart="true"
        app:layout_constraintBottom_toTopOf="@+id/footer"
        app:layout_constraintStart_toEndOf="@+id/status_title"
        app:layout_constraintTop_toTopOf="@+id/status_title"/>
    <TextView
        android:textSize="@dimen/font_size_small_10"
        android:textStyle="bold"
        android:textColor="@color/White"
        android:gravity="center"
        android:id="@+id/enter"
        android:background="@drawable/competition_enter_button_background"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="56dp"
        android:layout_height="26dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/competition_enter"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="16dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="12dp"/>
    <View
        android:id="@+id/footer"
        android:background="@drawable/competition_footer_active_background"
        android:layout_width="0dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="@color/Black"
        android:id="@+id/prize_pool_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/competition_list_prize_pool"
        app:layout_constraintBottom_toBottomOf="@+id/footer"
        app:layout_constraintEnd_toStartOf="@+id/betcoin_prize_pool"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/footer"/>
    <ImageView
        android:id="@+id/betcoin_prize_pool"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/betcoin"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/footer"
        app:layout_constraintEnd_toStartOf="@+id/prize_pool_amount"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/prize_pool_title"
        app:layout_constraintTop_toTopOf="@+id/footer"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/Black"
        android:id="@+id/prize_pool_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/competition_list_prize_pool"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/betcoin_prize_pool"
        app:layout_constraintTop_toTopOf="@+id/footer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
