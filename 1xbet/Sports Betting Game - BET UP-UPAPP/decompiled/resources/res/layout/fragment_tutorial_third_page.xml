<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/favorites_search_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/button_text_size"
                android:textColor="#ffff"
                android:gravity="center"
                android:id="@+id/search"
                android:background="@drawable/search_favorite_shape"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="@string/search_your_league"
                android:drawableEnd="@android:drawable/ic_menu_search"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <ImageView
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_centerVertical="true"
                android:alpha="0.5"
                app:srcCompat="0x7f080f94"/>
        </RelativeLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/save"
            android:background="@drawable/dialog_ok_selector"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/save_changes"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Spinner
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/spinnerSecondPage"
                    android:background="@drawable/favorites_spinner_background"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <RelativeLayout
                android:background="#282832"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ListView
                    android:id="@+id/leaguesListView"
                    android:background="#282832"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/favorites_border_gray"
                    android:dividerHeight="1px"/>
                <ProgressBar
                    android:id="@+id/progress"
                    android:visibility="visible"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    style="?android:attr/progressBarStyleLarge"/>
            </RelativeLayout>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffff"
                android:id="@+id/footer"
                android:background="#345f06"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/favourite_teams"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:background="#99345f06"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="10dp"
                    app:srcCompat="@android:drawable/btn_star_big_off"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textSize="@dimen/button_text_size"
                    android:textColor="#ffff"
                    android:gravity="center_vertical"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/show_favourite_teams"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"/>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="81dp"
        android:layout_height="81dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/star"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        app:backgroundTint="@color/colorPrimary"
        app:fabSize="normal"
        app:rippleColor="@color/black_transparent"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="-32dp"
        android:layout_toLeftOf="@+id/fab"
        android:layout_alignTop="@+id/fab"
        android:layout_alignBottom="@+id/fab">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/no_bets_toolbar_text"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/favCount"
            android:background="@drawable/balance_add"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:text="0"
            android:layout_centerVertical="true"
            app:layout_constraintTop_toTopOf="parent"/>
    </RelativeLayout>
</RelativeLayout>
