<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/magentaCyanBlack"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container_competition_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/middle_divider"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="@dimen/font_size_small_10"
            android:id="@+id/players_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="@dimen/font_size_small_10"
            android:id="@+id/slot_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="@dimen/font_size_tiny"
            android:textStyle="italic"
            android:textColor="@color/Gray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="4dp"
            android:text="@string/updates_every_30_mins"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <View
        android:id="@+id/middle_divider"
        android:background="@color/drawer_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_centerInParent="true"/>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/middle_divider"
        android:layout_alignParentEnd="true"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@+id/middle_divider"
        android:layout_alignParentEnd="true"
        layout="@layout/base_item_competition_bet"/>
</RelativeLayout>
