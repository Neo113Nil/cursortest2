<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/intro_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/icon"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/font_size_very_big"
            android:gravity="center"
            android:id="@+id/bet_quiz_header_tv"
            android:background="@drawable/ic_quiz_intro_3_header"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="@string/quiz_intro_3_title"
            android:shadowColor="@color/Black"
            android:shadowDx="5"
            android:shadowRadius="4"
            android:fontFamily="@font/montserrat_extra_bold"
            android:textAlignment="center"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:id="@+id/top_description_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="68dp"
            android:text="@string/quiz_intro_3_top_description"
            android:lineSpacingExtra="10sp"
            android:fontFamily="@font/montserrat_extra_bold"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bet_quiz_header_tv"/>
        <ImageView
            android:id="@+id/quiz_intro_3_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:src="@drawable/ic_quiz_intro_3_trophies"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_description_tv"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:id="@+id/quiz_intro_3_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/quiz_intro_3_bottom_description"
            android:lineSpacingExtra="10sp"
            android:fontFamily="@font/montserrat_extra_bold"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quiz_intro_3_iv"/>
        <TextView
            android:textSize="@dimen/font_size_medium"
            android:textColor="@color/quiz_silver"
            android:id="@+id/quiz_intro_3_comment_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/quiz_intro_3_bottom_comment"
            android:lineSpacingExtra="10sp"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quiz_intro_3_tv"/>
        <TextView
            android:textSize="@dimen/font_size_medium"
            android:id="@+id/quiz_intro_3_share_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/quiz_intro_3_bottom_share"
            android:lineSpacingExtra="10sp"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
