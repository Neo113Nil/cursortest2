<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adapter_container_cl"
    android:background="@drawable/round_adapter_item_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:translationZ="4dp"
    android:elevation="3dp"
    android:backgroundTint="@color/background_dark_blue"
    android:layout_marginVertical="@dimen/quiz_history_margin_vertical_items"
    android:clipToOutline="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/bet_challenge_adapter_icon_cl"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon_iv"
            android:layout_width="40dp"
            android:layout_height="60dp"
            android:src="@drawable/challenge_bronze_ic"
            android:contentDescription="@string/bet_challenge_history_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/quiz_history_secondary_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bet_challenge_adapter_icon_cl"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bet_challenge_adapter_match_info_cl"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bet_challenge_adapter_coef_cl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bet_challenge_adapter_date_time_cl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/font_size_small_10"
                    android:textColor="@color/quiz_history_secondary_text"
                    android:id="@+id/participation_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18.12.2002"
                    android:fontFamily="@font/montserrat_extra_bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/font_size_small_10"
                    android:textColor="@color/quiz_history_secondary_text"
                    android:id="@+id/divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginHorizontal="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/participation_time_tv"
                    app:layout_constraintStart_toEndOf="@+id/participation_date_tv"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/font_size_small_10"
                    android:textColor="@color/quiz_history_secondary_text"
                    android:id="@+id/participation_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:00"
                    android:fontFamily="@font/montserrat_extra_bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/font_size_small_10"
                android:ellipsize="end"
                android:id="@+id/match_name_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Match Name"
                android:maxLines="1"
                android:fontFamily="@font/montserrat_extra_bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bet_challenge_adapter_date_time_cl"
                app:layout_goneMarginTop="5dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bet_challenge_adapter_coef_cl"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bet_challenge_adapter_status_cl"
            app:layout_constraintStart_toEndOf="@+id/bet_challenge_adapter_match_info_cl"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/font_size_small_10"
                android:textColor="@color/gray"
                android:id="@+id/bet_challenge_adapter_coef_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quiz_history_odds_title"
                android:fontFamily="@font/montserrat_extra_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_small_10"
                android:id="@+id/coefficient_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="1.2"
                android:fontFamily="@font/montserrat_extra_bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bet_challenge_adapter_coef_title_tv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/bet_challenge_adapter_status_cl"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/font_size_small_10"
                android:gravity="center_vertical"
                android:id="@+id/participation_status_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:maxLines="1"
                android:fontFamily="@font/montserrat_extra_bold"/>
            <ImageView
                android:id="@+id/participation_status_icon_iv"
                android:layout_width="20sp"
                android:layout_height="20sp"
                android:src="@drawable/betcoin"
                android:layout_marginHorizontal="5dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
