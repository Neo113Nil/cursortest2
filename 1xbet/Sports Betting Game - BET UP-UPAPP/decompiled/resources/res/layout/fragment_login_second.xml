<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/container"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.betup.ui.views.AlphaPressButton
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/back"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f080f7d"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorAccent"
            android:id="@+id/back_button"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:maxLines="1"
            android:layout_marginStart="4dp"/>
    </org.betup.ui.views.AlphaPressButton>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/imageView"
        android:layout_width="150dp"
        android:layout_height="72dp"
        android:src="@drawable/text_logo"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/loginTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/font_size_medium"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/play_as_guest"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/play_as_guest"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/signInButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textStyle="bold"
        android:textColor="@color/login_screen_text_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/loginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/login_sign_in_title"
        android:textAllCaps="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/signInButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"/>
    <Button
        android:textSize="@dimen/button_text_size"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/signInButton"
        android:background="@drawable/green_button_with_round_coners"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="10dp"
        android:text="@string/login_sign_in_button"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/googlePlusButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loginTitle"/>
    <Button
        android:textSize="@dimen/button_text_size"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/googlePlusButton"
        android:background="@drawable/red_button_with_round_coners"
        android:paddingLeft="30dp"
        android:paddingRight="40dp"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="10dp"
        android:text="@string/login_sign_in_g_plus_button"
        android:drawableLeft="@mipmap/google"
        android:textAllCaps="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/fbButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signInButton"/>
    <Button
        android:id="@+id/fbButton"
        android:paddingLeft="30dp"
        android:paddingRight="40dp"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:drawableLeft="@mipmap/fb"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:textAllCaps="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toTopOf="@+id/vkButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/googlePlusButton"
        style="@style/FacebookLoginButton"/>
    <Button
        android:textSize="@dimen/button_text_size"
        android:id="@+id/vkButton"
        android:background="@drawable/vk_login_button"
        android:paddingLeft="30dp"
        android:paddingRight="40dp"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:text="@string/login_sign_in_vk"
        android:drawableLeft="@mipmap/vk"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:textAllCaps="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fbButton"/>
    <TextView
        android:id="@+id/bottomDivider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vkButton"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/privacyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/terms_privacy_policy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loginRegOption"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/login_screen_text_color"
        android:id="@+id/forgot_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/forgot_password"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/drawer_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/login_screen_text_color"
        android:id="@+id/loginRegOption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/new_here"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomDivider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
