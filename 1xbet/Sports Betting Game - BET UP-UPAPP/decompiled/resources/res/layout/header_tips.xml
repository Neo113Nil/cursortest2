<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/lightCyan"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp">
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/expertIcon"
        android:layout_width="81dp"
        android:layout_height="81dp"
        android:layout_marginTop="8dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_border_color="@color/white"
        app:riv_border_width="1dp"
        app:riv_corner_radius="30dp"
        app:riv_mutate_background="true"
        app:riv_oval="true"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/expertName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/betup_experts"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/expertIcon"
        app:layout_constraintTop_toTopOf="@+id/expertIcon"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/hints_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/number_of_hints"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/expertIcon"
        app:layout_constraintTop_toBottomOf="@+id/expertName"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:id="@+id/hints_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/hints_desc"
        app:layout_constraintTop_toTopOf="@+id/hints_desc"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/wins_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@+id/winnings_label"
        app:layout_constraintStart_toStartOf="@+id/winnings_label"
        app:layout_constraintTop_toBottomOf="@+id/expertIcon"/>
    <TextView
        android:textColor="@color/sublabel_gray_color"
        android:gravity="center"
        android:id="@+id/winnings_label"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="@string/winnings_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/losses_label"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wins_number"/>
    <View
        android:id="@+id/winnings_divider"
        android:background="@color/sublabel_gray_color"
        android:layout_width="1dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/winnings_label"
        app:layout_constraintEnd_toStartOf="@+id/losses_label"
        app:layout_constraintStart_toEndOf="@+id/winnings_label"
        app:layout_constraintTop_toTopOf="@+id/wins_number"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/losses_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/losses_label"
        app:layout_constraintStart_toStartOf="@+id/losses_label"
        app:layout_constraintTop_toTopOf="@+id/wins_number"/>
    <TextView
        android:textColor="@color/sublabel_gray_color"
        android:gravity="center"
        android:id="@+id/losses_label"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/losses_label"
        app:layout_constraintEnd_toStartOf="@+id/canceled_label"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/winnings_label"
        app:layout_constraintTop_toBottomOf="@+id/losses_number"/>
    <View
        android:id="@+id/canceled_divider"
        android:background="@color/sublabel_gray_color"
        android:layout_width="1dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/winnings_label"
        app:layout_constraintEnd_toStartOf="@+id/canceled_label"
        app:layout_constraintStart_toEndOf="@+id/losses_label"
        app:layout_constraintTop_toTopOf="@+id/wins_number"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/canceled_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/canceled_label"
        app:layout_constraintStart_toStartOf="@+id/canceled_label"
        app:layout_constraintTop_toTopOf="@+id/wins_number"/>
    <TextView
        android:textColor="@color/sublabel_gray_color"
        android:gravity="center"
        android:id="@+id/canceled_label"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/canceled_label"
        app:layout_constraintEnd_toStartOf="@+id/textView4"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/losses_label"
        app:layout_constraintTop_toBottomOf="@+id/canceled_number"/>
    <View
        android:id="@+id/ratio_divider"
        android:background="@color/sublabel_gray_color"
        android:layout_width="1dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/winnings_label"
        app:layout_constraintEnd_toStartOf="@+id/textView4"
        app:layout_constraintStart_toEndOf="@+id/canceled_label"
        app:layout_constraintTop_toTopOf="@+id/wins_number"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/ratio_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/textView4"
        app:layout_constraintStart_toStartOf="@+id/textView4"
        app:layout_constraintTop_toTopOf="@+id/wins_number"/>
    <TextView
        android:textColor="@color/sublabel_gray_color"
        android:gravity="center"
        android:id="@+id/textView4"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/win_ratio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/canceled_label"
        app:layout_constraintTop_toBottomOf="@+id/ratio_number"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/wins_number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/expertIcon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
