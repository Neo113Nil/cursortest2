<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container_winners"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textColor="@color/Gray"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/current_winners"/>
    <RelativeLayout
        android:id="@+id/first_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="@dimen/font_size_default"
            android:layout_gravity="center_vertical"
            android:id="@+id/first_winner_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:layout_marginStart="4dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/first_winner_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/first_winner_place"/>
        <TextView
            android:textSize="@dimen/font_size_very_small"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/first_winner_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_stats_yet"
            android:maxLines="1"
            android:maxLength="20"
            android:layout_marginStart="4dp"
            android:layout_toStartOf="@+id/first_winner_coef_view"
            android:layout_toEndOf="@+id/first_winner_icon"/>
        <TextView
            android:textSize="@dimen/font_size_very_small"
            android:layout_gravity="center_vertical"
            android:id="@+id/first_winner_coef_view"
            android:background="@drawable/competition_odds_amount_button_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/second_place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="@dimen/font_size_default"
            android:layout_gravity="center_vertical"
            android:id="@+id/second_winner_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:layout_marginStart="4dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/second_winner_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/second_winner_place"/>
        <TextView
            android:textSize="@dimen/font_size_very_small"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/second_winner_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_stats_yet"
            android:maxLines="1"
            android:maxLength="20"
            android:layout_marginStart="4dp"
            android:layout_toStartOf="@+id/second_winner_coef_view"
            android:layout_toEndOf="@+id/second_winner_icon"/>
        <TextView
            android:textSize="@dimen/font_size_very_small"
            android:layout_gravity="center_vertical"
            android:id="@+id/second_winner_coef_view"
            android:background="@drawable/competition_odds_amount_button_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/third_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="@dimen/font_size_default"
            android:layout_gravity="center_vertical"
            android:id="@+id/third_winner_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:layout_marginStart="4dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/third_winner_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/third_winner_place"/>
        <TextView
            android:textSize="@dimen/font_size_very_small"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/third_winner_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_stats_yet"
            android:maxLines="1"
            android:maxLength="20"
            android:layout_marginStart="4dp"
            android:layout_toStartOf="@+id/third_winner_coef_view"
            android:layout_toEndOf="@+id/third_winner_icon"/>
        <TextView
            android:textSize="@dimen/font_size_default"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/third_winner_coef_view"
            android:background="@drawable/competition_odds_amount_button_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:maxLines="1"
            android:maxLength="20"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/font_size_default"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:id="@+id/info_button"
        android:background="@drawable/competition_history_info_button_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="8dp"
        android:text="@string/info"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</LinearLayout>
