<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="360dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/header"
        android:background="@drawable/bet_shape_amount"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/battle_received_title"
        android:shadowColor="@color/White"
        app:layout_constraintBottom_toTopOf="@+id/topDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/closeButton"
        android:background="@drawable/dialog_close_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/header"
        app:layout_constraintEnd_toEndOf="@+id/header"
        app:layout_constraintTop_toTopOf="@+id/header"/>
    <View
        android:gravity="center"
        android:id="@+id/topDivider"
        android:background="@drawable/betcoin"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/descriptionContainer"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/descriptionContainer"
        android:background="@drawable/competition_odds_amount_button_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <TextView
            android:textSize="@dimen/font_size_very_big"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/type"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:shadowColor="@color/White"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"/>
        <com.makeramen.roundedimageview.RoundedImageView
            android:layout_gravity="center"
            android:id="@+id/userIcon"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/type"
            app:riv_border_color="@color/magentaCyanBlack"
            app:riv_oval="true"/>
        <TextView
            android:textSize="@dimen/font_size_default"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:gravity="center"
            android:id="@+id/userName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shadowColor="@color/White"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/userIcon"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/amountContainer"
            android:background="@drawable/item_competition_top_container_background"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/descriptionContainer">
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prize_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="parent"/>
            <View
                android:gravity="center"
                android:background="@drawable/betcoin"
                android:paddingBottom="4dp"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="@dimen/font_size_medium"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/betcoinAmount"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/colorAccent"
                android:layout_marginStart="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="parent"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonsContainer"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:gravity="center"
                android:id="@+id/rejectButton"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reject"
                android:maxLines="1"
                android:layout_weight="0.5"/>
            <TextView
                android:textSize="@dimen/font_size_medium"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/detailsButton"
                android:background="@drawable/bet_shape_amount"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/see_details"
                android:maxLines="1"
                android:layout_weight="0.5"
                android:layout_marginStart="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="parent"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/progressBar"
        android:background="@color/black_transparent"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/progressBarStyle"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
