<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quiz_result_match_info_cl"
        android:background="#08153e"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/font_size_small_10"
            android:textColor="@color/gray"
            android:id="@+id/quiz_result_match_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UEFA Nations League"
            android:shadowColor="#000000"
            android:shadowDx="5"
            android:shadowDy="5"
            android:fontFamily="@font/montserrat_extra_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/quiz_result_match_teams_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quiz_result_match_name_tv">
            <TextView
                android:textSize="@dimen/font_size_small_10"
                android:ellipsize="end"
                android:id="@+id/home_team_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="150dp"
                android:text="Croatia Croatia Croatia Croatia Croatia "
                android:maxLines="1"
                android:shadowColor="#000000"
                android:shadowDx="5"
                android:shadowDy="5"
                android:fontFamily="@font/montserrat_extra_bold"
                android:textAlignment="textEnd"
                android:layout_marginEnd="5dp"/>
            <LinearLayout
                android:id="@+id/score_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="5dp">
                <TextView
                    android:textSize="@dimen/font_size_small_10"
                    android:id="@+id/home_team_score_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:shadowColor="#000000"
                    android:shadowDx="5"
                    android:shadowDy="5"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:textSize="@dimen/font_size_small_10"
                    android:id="@+id/separator_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:shadowColor="#000000"
                    android:shadowDx="5"
                    android:shadowDy="5"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:textSize="@dimen/font_size_small_10"
                    android:id="@+id/away_team_score_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:shadowColor="#000000"
                    android:shadowDx="5"
                    android:shadowDy="5"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginEnd="5dp"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/font_size_small_10"
                android:ellipsize="end"
                android:id="@+id/away_team_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="150dp"
                android:text="Portugal Portugal Portugasdssdsdsdal Portugal "
                android:maxLines="1"
                android:shadowColor="#000000"
                android:shadowDx="5"
                android:shadowDy="5"
                android:fontFamily="@font/montserrat_extra_bold"
                android:layout_marginEnd="5dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quiz_question_results_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="10dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quiz_result_match_info_cl"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/quiz_reward_option_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginVertical="5dp"
        app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/quiz_result_total_cl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.555"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quiz_question_results_rv"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quiz_result_total_cl"
        android:background="#08153e"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toTopOf="@+id/make_bet_cl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quiz_reward_option_rv">
        <TextView
            android:textSize="@dimen/font_size_small_10"
            android:textColor="@color/gray"
            android:ellipsize="end"
            android:id="@+id/quiz_result_total_odds_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TotalTotal  Odds: "
            android:maxLines="1"
            android:shadowColor="#000000"
            android:shadowDx="5"
            android:shadowDy="5"
            android:fontFamily="@font/montserrat_extra_bold"
            android:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.flexbox.FlexboxLayout
            android:gravity="center"
            android:id="@+id/quiz_result_total_potential_win_fl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            app:alignItems="center"
            app:flexWrap="nowrap"
            app:justifyContent="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quiz_result_total_odds_tv">
            <TextView
                android:textSize="@dimen/font_size_medium"
                android:ellipsize="end"
                android:id="@+id/quiz_result_total_potential_win_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":Potential Win"
                android:maxLines="1"
                android:shadowColor="#000000"
                android:shadowDx="5"
                android:shadowDy="5"
                android:fontFamily="@font/montserrat_extra_bold"
                android:textAlignment="textEnd"
                android:autoSizeTextType="uniform"/>
            <LinearLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:id="@+id/quiz_result_total_potential_win_ll"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="#03bb04"
                    android:id="@+id/quiz_result_total_potential_win_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1000022"
                    android:maxLines="1"
                    android:shadowColor="#000000"
                    android:shadowDx="5"
                    android:shadowDy="5"
                    android:fontFamily="@font/montserrat_extra_bold"/>
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/betcoin"/>
            </LinearLayout>
        </com.google.android.flexbox.FlexboxLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/make_bet_cl"
        android:background="@drawable/bet_button"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:minWidth="120dp"
        android:minHeight="70dp"
        android:translationZ="10dp"
        android:layout_marginVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/font_size_big"
            android:gravity="center"
            android:id="@+id/make_bet_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/quiz_result_bet_default_btn"
            android:shadowColor="#000000"
            android:shadowDy="5"
            android:shadowRadius="2"
            android:textAllCaps="true"
            android:fontFamily="@font/montserrat_extra_bold"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
