<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/header"
        android:background="0x7f080f70"
        android:layout_width="match_parent"
        android:layout_height="190dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="16dp"
            android:src="@mipmap/bowls"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="false"/>
        <ImageView
            android:id="@+id/fav"
            android:background="@drawable/star_timer_shape"
            android:padding="2dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="64dp"
            android:src="@drawable/star_empty"
            android:layout_alignLeft="@+id/icon"
            android:layout_alignBottom="@+id/icon"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textSize="@dimen/font_size_default"
            android:gravity="center_horizontal"
            android:id="@+id/teamName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_below="@+id/icon"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/stats"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_weight="1"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <org.betup.ui.fragment.home.views.MyNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/header">
        <RelativeLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="@dimen/font_size_default"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/labelFavTeams"
                android:background="@color/mirageDark"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/next_matches"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/nextMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/labelFavTeams"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="@dimen/font_size_default"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/labelFavLeagues"
                android:background="@color/mirageDark"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/last_matches"
                android:layout_below="@+id/nextMatches"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/lastMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/labelFavLeagues"/>
        </RelativeLayout>
    </org.betup.ui.fragment.home.views.MyNestedScrollView>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/progressBarStyle"/>
</RelativeLayout>
