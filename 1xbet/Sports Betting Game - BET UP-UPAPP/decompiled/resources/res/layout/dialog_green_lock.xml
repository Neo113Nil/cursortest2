<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dark_dialog_shape"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true">
    <TextView
        android:textSize="@dimen/font_size_very_big"
        android:textStyle="bold"
        android:textColor="@color/White"
        android:gravity="center"
        android:id="@+id/title"
        android:background="@drawable/lock_dialog_title_shape"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/first_bet_tutorial"
        android:shadowColor="@color/Black"
        android:shadowDx="1.5"
        android:shadowDy="1.5"
        android:shadowRadius="3"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/font_size_big"
        android:textStyle="bold"
        android:textColor="@color/green_dialog_text"
        android:gravity="center"
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:shadowColor="@color/Black"
        android:shadowDx="1.5"
        android:shadowDy="1.5"
        android:shadowRadius="2.5"
        android:textAllCaps="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/dialog_lock"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/desc"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/dialog_unlock_button_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notice">
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/unlock_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@color/Black"
            android:shadowDx="1.5"
            android:shadowDy="1.5"
            android:shadowRadius="2.5"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/unlock_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@color/Black"
            android:shadowDx="1.5"
            android:shadowDy="1.5"
            android:shadowRadius="2.5"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/font_size_default"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/notice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView6"/>
</androidx.constraintlayout.widget.ConstraintLayout>
