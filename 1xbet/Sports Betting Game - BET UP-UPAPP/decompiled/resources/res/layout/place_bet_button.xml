<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/placeBetButton"
    android:background="@drawable/yellow_button_selector"
    android:paddingLeft="5dp"
    android:paddingTop="10dp"
    android:paddingRight="5dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <org.betup.ui.views.GradientTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/betslip_place_bet"
        android:paddingEnd="2dp"
        android:layout_marginEnd="8dp"
        app:centerColor="@color/white"
        app:mainColor="@color/white"
        app:outlineColor="@color/Black"
        app:outlineWidth="1dp"/>
</LinearLayout>
