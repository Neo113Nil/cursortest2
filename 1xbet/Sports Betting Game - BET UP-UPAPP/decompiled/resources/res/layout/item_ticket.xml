<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="98dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container"
            android:background="@drawable/shop_item_background"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="81dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/amountContainer"
                android:background="@drawable/shop_coins_shape"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingStart="12dp"
                android:paddingEnd="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <org.betup.ui.views.FontText
                    android:textSize="@dimen/font_size_default"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccent"
                    android:gravity="center"
                    android:id="@+id/tickets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:text="50"
                    android:maxLines="1"
                    android:shadowColor="@color/Black"
                    android:shadowDx="5"
                    android:shadowDy="5"
                    android:shadowRadius="5"
                    android:paddingEnd="2dp"
                    android:layout_marginStart="8dp"
                    app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="4dp"
                    app:srcCompat="@drawable/ticket"/>
                <org.betup.ui.views.FontText
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/betcoins"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:text="+ 1,000,000"
                    android:maxLines="1"
                    android:shadowColor="@color/Black"
                    android:shadowDx="5"
                    android:shadowDy="5"
                    android:shadowRadius="5"
                    android:layout_marginStart="2dp"
                    app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
                <ImageView
                    android:visibility="gone"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    app:srcCompat="@drawable/betcoin"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/buy_button"
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/amountContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/amountContainer">
                <org.betup.ui.views.GradientTextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/price"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    app:centerColor="#ac7300"
                    app:mainColor="#784701"
                    app:outlineWidth="0dp"
                    app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="top|center_horizontal"
                android:id="@+id/discount"
                android:background="@drawable/shop_corner_label"
                android:layout_width="48dp"
                android:layout_height="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/money_cup"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/bonus_container"
            android:background="@drawable/bottom_bonus"
            android:layout_width="128dp"
            android:layout_height="24dp"
            android:layout_marginBottom="10dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView
                android:id="@+id/bonus_icon"
                android:layout_width="32dp"
                android:layout_height="24dp"
                android:scaleType="fitXY"/>
            <TextView
                android:theme="@style/ShadowedTextStyle"
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/bonus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shop_bonus"/>
        </LinearLayout>
        <TextView
            android:theme="@style/ShadowedTextStyle"
            android:textSize="8sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:id="@+id/label"
            android:background="@drawable/popular_label"
            android:paddingTop="7dp"
            android:layout_width="130dp"
            android:layout_height="32dp"
            android:layout_marginTop="3dp"
            android:text="@string/most_popular"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:textAllCaps="true"
            android:paddingStart="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </RelativeLayout>
</RelativeLayout>
