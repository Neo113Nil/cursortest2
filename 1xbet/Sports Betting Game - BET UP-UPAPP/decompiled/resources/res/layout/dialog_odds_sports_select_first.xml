<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/dialog_shape"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffff"
        android:gravity="center_horizontal"
        android:id="@+id/odds_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="320dp"
        android:text="@string/select_odds"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/teamsOddsExampleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/odds_label">
        <org.betup.ui.views.BetView
            android:layout_gravity="center_vertical"
            android:id="@+id/firstBet"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"/>
        <org.betup.ui.views.BetView
            android:layout_gravity="center_vertical"
            android:id="@+id/secondBet"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/decimalOddsButton"
        android:background="@drawable/not_selected_odd_button"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/decimal_odds"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teamsOddsExampleContainer"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/americanOddsButton"
        android:background="@drawable/not_selected_odd_button"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/american_odds"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/decimalOddsButton"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/fractionalOddsButton"
        android:background="@drawable/not_selected_odd_button"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/fractional_odds"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/americanOddsButton"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/advanced_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/fractionalOddsButton">
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bet_amount_dialog_title"/>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/bet_suggestion_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <CheckBox
                android:theme="@style/SettingsCheckBox"
                android:textColor="@color/White"
                android:id="@+id/enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/suggested_bet_amount"/>
            <CheckBox
                android:theme="@style/SettingsCheckBox"
                android:textColor="@color/White"
                android:id="@+id/disable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/custom_bet_amount"/>
            <EditText
                android:textColor="@color/White"
                android:textColorHint="@color/gray"
                android:gravity="center"
                android:id="@+id/amount"
                android:background="@drawable/achievements_num_shape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="10dp"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:layout_marginStart="8dp"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/amountLimitsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true">
                    <ImageView
                        android:id="@+id/leftCoin"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/betcoin"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/minAmount"/>
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="italic|bold"
                        android:textColor="@color/gray"
                        android:gravity="start|center_vertical"
                        android:id="@+id/minAmount"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:minWidth="32dp"
                        android:text="100"
                        android:maxLines="2"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/thirdBet"
                        app:layout_constraintStart_toEndOf="@+id/leftCoin"
                        app:layout_constraintTop_toTopOf="@+id/thirdBet"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:id="@+id/rightCoin"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/betcoin"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/minAmount"/>
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="italic|bold"
                        android:textColor="@color/gray"
                        android:gravity="start|center_vertical"
                        android:id="@+id/maxAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="32dp"
                        android:text="1,000,000,000"
                        android:maxLines="1"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/thirdBet"
                        app:layout_constraintStart_toEndOf="@+id/leftCoin"
                        app:layout_constraintTop_toTopOf="@+id/thirdBet"/>
                </LinearLayout>
            </RelativeLayout>
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="8dp"
                app:layout_constraintEnd_toStartOf="@+id/maxAmount"
                app:layout_constraintStart_toEndOf="@+id/minAmount"
                app:layout_constraintTop_toBottomOf="@+id/maxBet"
                style="@style/AppTheme"/>
        </RadioGroup>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/ok"
        android:background="@drawable/dialog_ok_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/ok"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/cancel_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/advanced_container"/>
    <TextView
        android:gravity="center"
        android:id="@+id/cancel_button"
        android:background="@drawable/gray_button_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@android:string/cancel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
