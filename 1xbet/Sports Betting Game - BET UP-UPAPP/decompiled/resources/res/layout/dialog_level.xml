<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="@drawable/dialog_shop_shape"
        android:paddingBottom="16dp"
        android:layout_width="@dimen/dialog_header_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <org.betup.ui.views.GradientTextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/levelLabel"
            android:background="@drawable/level_label"
            android:paddingTop="32dp"
            android:layout_width="240dp"
            android:layout_height="160dp"
            app:centerColor="@color/colorAccent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:mainColor="@color/colorAccent"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <View
            android:gravity="center"
            android:id="@+id/effects"
            android:background="@drawable/dialog_level_effects_background"
            android:layout_width="0dp"
            android:layout_height="128dp"
            android:layout_marginTop="8dp"
            android:text="@string/visit_store_tickets"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/levelLabel"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ok"
            android:background="@drawable/ok_button"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/effects">
            <org.betup.ui.views.GradientTextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/price"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="128dp"
                android:layout_height="wrap_content"
                android:text="@string/get_all"
                android:maxLines="2"
                android:textAllCaps="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform"
                app:centerColor="@color/white"
                app:mainColor="@color/white"
                app:outlineWidth="0dp"
                app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
        </org.betup.ui.views.AlphaPressButton>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/share_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ok">
            <org.betup.ui.views.GradientImageButton
                android:id="@+id/fb_share"
                android:background="@drawable/fb_share_button"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <org.betup.ui.views.GradientImageButton
                android:id="@+id/vk_share"
                android:background="@drawable/vk_share_button"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            <org.betup.ui.views.GradientImageButton
                android:id="@+id/share"
                android:background="@drawable/generic_share_button"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:textSize="24sp"
        android:gravity="center"
        android:id="@+id/effectsList"
        android:layout_width="wrap_content"
        android:layout_height="128dp"
        android:layout_marginTop="54dp"
        android:text="@string/visit_store_tickets"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialog_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialog_container">
        <ImageView
            android:id="@+id/star"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_marginBottom="81dp"
            android:src="@drawable/level_star"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintEnd_toEndOf="@+id/imageView"
            app:layout_constraintStart_toStartOf="@+id/imageView"/>
        <ImageView
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            android:src="@drawable/ribbon_back"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/left_pipes"
            android:layout_width="128dp"
            android:layout_height="200dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/level_left_pipes"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintStart_toStartOf="@+id/imageView"/>
        <ImageView
            android:id="@+id/right_pipes"
            android:layout_width="128dp"
            android:layout_height="200dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/level_right_pipes"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintEnd_toEndOf="@+id/imageView"/>
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="332dp"
            android:layout_height="150dp"
            android:layout_marginTop="96dp"
            android:layout_marginBottom="54dp"
            android:adjustViewBounds="false"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ribbon_front"/>
        <ImageView
            android:id="@+id/trumpery"
            android:layout_width="350dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/trumpery"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:textStyle="bold"
            android:id="@+id/label"
            android:layout_width="@dimen/dialog_header_width"
            android:layout_height="96dp"
            android:layout_marginBottom="42dp"
            android:src="@drawable/level_up_title"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
