<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/wonMoneyAmountContainer"
    android:background="@drawable/container_game_result_background"
    android:paddingTop="12dp"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="64dp"
    android:layout_marginEnd="64dp"
    app:layout_constraintBottom_toTopOf="@+id/okButton"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/resultDetailsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/video_offer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textStyle="bold"
            android:id="@+id/gameResultTitle"
            android:paddingTop="6dp"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/font_size_big"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:id="@+id/betcoins"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:textSize="@dimen/font_size_medium"
                android:id="@+id/betcoin_label"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="3dp"
                android:src="@drawable/betcoin"
                android:textAllCaps="true"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <org.betup.ui.views.AlphaPressButton
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/video_offer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rightMargin"
        app:layout_constraintStart_toEndOf="@+id/resultDetailsContainer"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/videoIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/video_reward_icon"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/video_bonus_amount_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/videoRewardAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+1000"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/betcoin"/>
        </LinearLayout>
    </org.betup.ui.views.AlphaPressButton>
    <View
        android:id="@+id/rightMargin"
        android:layout_width="48dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
