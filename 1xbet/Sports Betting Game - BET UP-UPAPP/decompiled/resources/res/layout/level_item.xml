<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/level_effect_background"
    android:layout_width="100dp"
    android:layout_height="128dp">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/level_up_unlock"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/label_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/label_container"
        android:background="@drawable/level_up_label"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/subIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/betcoin"/>
        <org.betup.ui.views.GradientTextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:centerColor="@color/colorAccent"
            app:mainColor="@color/colorAccent"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
