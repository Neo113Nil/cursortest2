<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/favorites_search_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/save"
            android:background="@drawable/dialog_ok_selector"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/save_changes"/>
        <RelativeLayout
            android:id="@+id/progress"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <ListView
            android:id="@+id/list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@color/favorites_border_gray"
            android:dividerHeight="1px"/>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="81dp"
        android:layout_height="81dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/star"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        app:backgroundTint="@color/colorPrimary"
        app:fabSize="normal"
        app:rippleColor="@color/black_transparent"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="-32dp"
        android:layout_toLeftOf="@+id/fab"
        android:layout_alignTop="@+id/fab"
        android:layout_alignBottom="@+id/fab">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/no_bets_toolbar_text"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/favCount"
            android:background="@drawable/balance_add"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:text="0"
            android:layout_centerVertical="true"
            app:layout_constraintTop_toTopOf="parent"/>
    </RelativeLayout>
</RelativeLayout>
