<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/highLowFragmentContainer"
    android:background="@color/black_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/fragment_dice_main_background"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/background_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/top_background"
            android:background="@drawable/digital_round_lines"
            android:layout_width="wrap_content"
            android:layout_height="420dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <org.betup.ui.views.DigitalTextView
            android:id="@+id/topDigitalNumber"
            android:background="@drawable/digital_round_glass_background"
            android:layout_width="260dp"
            android:layout_height="260dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textSize="19sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/background_divider"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomDigitalNumber"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottomDigitalNumber"/>
    <include
        android:id="@+id/containerHighLowerResult"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/background_divider"
        layout="@layout/container_result_high_low"/>
    <org.betup.ui.views.DigitalTextView
        android:id="@+id/bottomDigitalNumber"
        android:background="@drawable/digital_glass_background"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/bet_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:textSize="19sp"/>
    <FrameLayout
        android:id="@+id/progressBar"
        android:background="@color/black_transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomDigitalNumber">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            style="?android:attr/progressBarStyle"/>
    </FrameLayout>
    <include
        android:id="@+id/bet_container"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/place_betcoins_amount_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selectBetTypeContainer"
        android:paddingTop="8dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:id="@+id/buttonHigher"
            android:background="@drawable/mini_games_green_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/buttonEqual"
            app:layout_constraintEnd_toStartOf="@+id/buttonLower"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:id="@+id/textButtonHigher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/high_with_coef"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:id="@+id/buttonLower"
            android:background="@drawable/mini_games_green_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/buttonEqual"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/buttonHigher">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:id="@+id/textButtonLower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lower_with_coef"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:id="@+id/buttonEqual"
            android:background="@drawable/mini_games_green_button"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintBottom_toTopOf="@+id/buttonEven"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginStart="32dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:id="@+id/textButtonEqual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equal_with_coef"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:id="@+id/buttonEven"
            android:background="@drawable/mini_games_green_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginBottom="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/buttonOdd"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:id="@+id/textButtonEven"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/even_with_coef"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:id="@+id/buttonOdd"
            android:background="@drawable/mini_games_green_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginBottom="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/buttonEven">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/White"
                android:gravity="center_horizontal"
                android:id="@+id/textButtonOdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/odd_with_coef"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/clickedStub"
        android:background="@color/transparent"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/background_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
