<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorPrimaryDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.betup.ui.views.PagerSlidingTabStrip
        android:id="@+id/pagerSlidingTabStrip"
        android:background="?attr/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:pstsShouldExpand="@bool/support_tabs_should_expand"
        app:pstsTabPaddingLeftRight="0dp"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:background="?attr/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/pagerSlidingTabStrip"/>
</RelativeLayout>
