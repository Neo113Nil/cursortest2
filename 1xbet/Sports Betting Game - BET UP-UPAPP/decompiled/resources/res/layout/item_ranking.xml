<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:background="@drawable/ranking_selector"
    android:paddingTop="4dp"
    android:paddingBottom="2dp"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/main"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="14sp"
                android:textColor="@color/item_top_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/position"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="22k"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"/>
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/rewardIcon"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginLeft="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/avatarContainer"
                android:layout_width="40dp"
                android:layout_height="38dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/icon"
                    android:scaleType="fitXY"
                    app:riv_border_color="@color/magentaCyanBlack"
                    app:riv_border_width="3dp"
                    app:riv_corner_radius="30dp"
                    app:riv_mutate_background="true"
                    app:riv_oval="true"/>
                <TextView
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/rankLevel"
                    android:background="@drawable/level_shape_4"
                    android:paddingBottom="1dp"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintStart_toEndOf="@+id/tupUserImageHomeFragment"/>
            </FrameLayout>
            <View
                android:id="@+id/first_divider"
                android:background="0x7f0805e9"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:id="@+id/country"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="fitXY"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="Medium Text"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="4dp"/>
            <View
                android:id="@+id/second_divider"
                android:background="0x7f0805e9"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
        <org.betup.ui.controls.RoiView
            android:id="@+id/roiView"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
</RelativeLayout>
