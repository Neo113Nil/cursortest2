<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <SurfaceView
            android:visibility="gone"
            android:layout_width="0px"
            android:layout_height="0px"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="org.betup.utils.SnackbarAwareBehavior">
            <include layout="@layout/view_toolbar"/>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/bottomPanel"/>
                <TextView
                    android:textSize="18sp"
                    android:gravity="center"
                    android:id="@+id/inet_error"
                    android:background="@color/black_transparent"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_inet_connection"
                    android:layout_above="@+id/bottomPanel"/>
                <org.betup.services.menu.MenuView
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/bottomPanel"
                    android:background="@drawable/bottom_navigation_bg"
                    android:visibility="visible"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="10dp"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/tour_overlay"
        android:focusable="false"
        android:visibility="gone"
        android:fitsSystemWindows="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="2000dp"/>
    <View
        android:id="@+id/drawer_scrim_touch_blocker"
        android:background="@android:color/transparent"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:layout_gravity="end"
        android:id="@+id/drawer"
        android:layout_width="256dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
