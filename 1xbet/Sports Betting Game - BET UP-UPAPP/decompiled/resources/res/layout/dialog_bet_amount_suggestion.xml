<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_shape"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/Gold"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/bet_amount_dialog_title"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/bet_suggestion_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <CheckBox
            android:theme="@style/SettingsCheckBox"
            android:textColor="@color/White"
            android:id="@+id/default_bet_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/suggested_bet_amount"/>
        <CheckBox
            android:theme="@style/SettingsCheckBox"
            android:textColor="@color/White"
            android:id="@+id/custom_bet_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/custom_bet_amount"/>
    </RadioGroup>
    <TextView
        android:gravity="center"
        android:id="@+id/ok_button"
        android:background="@drawable/dialog_ok_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/ok"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
    <TextView
        android:gravity="center"
        android:id="@+id/cancel_button"
        android:background="@drawable/gray_button_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@android:string/cancel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
</LinearLayout>
