<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@color/betup_dark_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="100dp"
    android:layout_marginBottom="80dp"
    android:paddingStart="30dp"
    android:paddingEnd="30dp">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/Gold"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/message_send"
        android:textAllCaps="true"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/message_success_send"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:text="@string/message_successful_send"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/message_send_ok"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="20dp"/>
    <Button
        android:layout_gravity="center_horizontal"
        android:id="@+id/ok"
        android:background="@drawable/ok_button"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ok"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/gray"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/message_feedback"/>
</LinearLayout>
