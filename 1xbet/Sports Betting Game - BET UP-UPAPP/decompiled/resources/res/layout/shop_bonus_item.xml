<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_offer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:background="@drawable/shop_bonus_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="2dp">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/amountContainer"
            android:background="@drawable/shop_bonus_coins_shape"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/price_container"
            app:layout_constraintStart_toStartOf="@+id/icon"
            app:layout_constraintTop_toTopOf="parent">
            <org.betup.ui.views.FontText
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/betcoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:text="1,000"
                android:maxLines="1"
                android:shadowColor="@color/Black"
                android:shadowDx="5"
                android:shadowDy="5"
                android:shadowRadius="5"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:autoSizeTextType="uniform"
                app:autoSizeMaxTextSize="18sp"
                app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/betcoin"
                android:importantForAccessibility="no"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/price_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/videoIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/video_reward_icon"
                android:importantForAccessibility="no"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/video_bonus_amount_shape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:paddingHorizontal="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/videoRewardAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="80dp"
                    android:text="@string/watch_ad"
                    android:maxLines="2"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/offer_home"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
