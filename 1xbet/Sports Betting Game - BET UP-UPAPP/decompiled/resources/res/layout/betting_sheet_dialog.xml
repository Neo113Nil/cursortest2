<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheetContainer"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/colorPrimaryDark"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/bestCoin"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/betcoin"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/highscoreLabel"
            app:layout_constraintStart_toEndOf="@+id/highscoreLabel"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:id="@+id/highscore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.75"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/highscoreLabel"
            app:layout_constraintStart_toEndOf="@+id/bestCoin"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/gray"
            android:id="@+id/highscoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/highscore"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/odds"
            app:layout_constraintStart_toEndOf="@+id/odds"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/header"
            android:background="@color/magentaCyanBlack"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_bet"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/lockIcon"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toTopOf="@+id/maxBet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header"
            app:srcCompat="@drawable/locked"/>
        <ImageView
            android:id="@+id/deleteBet"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/remove_bet_dialog"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/header"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/header"/>
        <ImageView
            android:id="@+id/settingsIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/cog_icon"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/header"/>
        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/maxBet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header"/>
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            app:layout_constraintEnd_toStartOf="@+id/maxAmount"
            app:layout_constraintStart_toEndOf="@+id/minAmount"
            app:layout_constraintTop_toBottomOf="@+id/maxBet"
            style="@style/AppTheme"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/oddHolder"
            android:background="@drawable/betslip_odd_shape"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/itemBetslipTeamNames">
            <ImageView
                android:id="@+id/stat"
                android:visibility="visible"
                android:layout_width="8dp"
                android:layout_height="12dp"
                android:layout_marginRight="5dp"
                app:srcCompat="@drawable/bet_arrow"/>
            <TextView
                android:textColor="@color/black"
                android:gravity="center_horizontal"
                android:id="@+id/itemBetslipOdds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="99.99"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/itemBetslipTeamNames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="name 1 - name 2"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="86dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/fragment_standings_text_color"
            android:id="@+id/itemBetslipSportName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="name"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemBetslipUsersPick"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:ellipsize="end"
            android:id="@+id/itemBetslipUsersPick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="name"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/oddHolder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemBetslipTeamNames"/>
        <ImageView
            android:id="@+id/leftCoin"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/betcoin"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/minAmount"/>
        <TextView
            android:textStyle="italic|bold"
            android:textColor="@color/gray"
            android:gravity="start|center_vertical"
            android:id="@+id/minAmount"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:minWidth="32dp"
            android:text="100"
            android:maxLines="2"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/thirdBet"
            app:layout_constraintStart_toEndOf="@+id/leftCoin"
            app:layout_constraintTop_toTopOf="@+id/thirdBet"/>
        <ImageView
            android:id="@+id/rightCoin"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/betcoin"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/maxAmount"
            app:layout_constraintTop_toTopOf="@+id/maxAmount"/>
        <TextView
            android:textStyle="italic|bold"
            android:textColor="@color/gray"
            android:gravity="start"
            android:id="@+id/maxAmount"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:maxWidth="64dp"
            android:text="32,500"
            android:maxLines="2"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/maxBet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/maxBet"/>
        <TextView
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/thirdBet"
            android:background="@drawable/betslip_bet_selector"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="1/3"
            app:layout_constraintEnd_toStartOf="@+id/halfBet"
            app:layout_constraintStart_toEndOf="@+id/minAmount"
            app:layout_constraintTop_toTopOf="@+id/maxBet"/>
        <ImageView
            android:id="@+id/lock_third"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:layout_centerInParent="true"
            android:alpha="0.75"
            app:layout_constraintBottom_toBottomOf="@+id/thirdBet"
            app:layout_constraintEnd_toEndOf="@+id/thirdBet"
            app:layout_constraintStart_toStartOf="@+id/thirdBet"
            app:layout_constraintTop_toTopOf="@+id/thirdBet"
            app:srcCompat="@drawable/lock_item"/>
        <TextView
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/halfBet"
            android:background="@drawable/betslip_bet_selector"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="1/2"
            app:layout_constraintEnd_toStartOf="@+id/maxBet"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/thirdBet"
            app:layout_constraintTop_toTopOf="@+id/maxBet"/>
        <ImageView
            android:id="@+id/lock_half"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:layout_centerInParent="true"
            android:alpha="0.75"
            app:layout_constraintBottom_toBottomOf="@+id/halfBet"
            app:layout_constraintEnd_toEndOf="@+id/halfBet"
            app:layout_constraintStart_toStartOf="@+id/halfBet"
            app:layout_constraintTop_toTopOf="@+id/halfBet"
            app:srcCompat="@drawable/lock_item"/>
        <TextView
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/maxBet"
            android:background="@drawable/betslip_bet_selector"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="MAX"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/rightCoin"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/halfBet"
            app:layout_constraintTop_toBottomOf="@+id/itemBetslipSportName"/>
        <ImageView
            android:id="@+id/lock_max"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:layout_centerInParent="true"
            android:alpha="0.75"
            app:layout_constraintBottom_toBottomOf="@+id/maxBet"
            app:layout_constraintEnd_toEndOf="@+id/maxBet"
            app:layout_constraintStart_toStartOf="@+id/maxBet"
            app:layout_constraintTop_toTopOf="@+id/maxBet"
            app:srcCompat="@drawable/lock_item"/>
        <include
            android:id="@+id/amountContainer"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/seekBar"
            layout="@layout/betting_amount"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/gray"
            android:id="@+id/textView12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/betslip_odds_big"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/amountContainer"
            app:layout_constraintStart_toEndOf="@+id/amountContainer"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/gray"
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/betslip_return"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toTopOf="@+id/textView12"
            app:layout_constraintStart_toEndOf="@+id/amountContainer"/>
        <ImageView
            android:id="@+id/returnCoinIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/betcoin"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/returnBalance"
            app:layout_constraintStart_toEndOf="@+id/textView6"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:id="@+id/returnBalance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="7500"
            android:maxLines="2"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/returnCoinIcon"
            app:layout_constraintTop_toTopOf="@+id/textView6"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:id="@+id/odds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.75"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView12"
            app:layout_constraintStart_toEndOf="@+id/textView12"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:id="@+id/challengeButton"
            android:background="@drawable/light_gray_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/placeBetButton"
            app:layout_constraintEnd_toStartOf="@+id/tipButton"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/amountContainer">
            <TextView
                android:textSize="@dimen/font_size_default"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battle"
                android:maxLines="1"
                android:layout_centerInParent="true"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
        <RelativeLayout
            android:id="@+id/tipButton"
            android:background="@drawable/light_gray_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/placeBetButton"
            app:layout_constraintEnd_toStartOf="@+id/removeAllButton"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/challengeButton"
            app:layout_constraintTop_toBottomOf="@+id/amountContainer">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_tip"
                android:layout_centerInParent="true"
                android:textAllCaps="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/removeAllButton"
            android:background="@drawable/light_gray_button"
            android:paddingLeft="5dp"
            android:paddingTop="10dp"
            android:paddingRight="5dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/add_to_betlist"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAllCaps="true"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/placeBetButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/tipButton"
            app:layout_constraintTop_toBottomOf="@+id/amountContainer"/>
        <include
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:layout_marginStart="72dp"
            android:layout_marginEnd="72dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/place_bet_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
