<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="@drawable/dialog_shop_shape"
        android:paddingBottom="16dp"
        android:layout_width="@dimen/dialog_header_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:id="@+id/effects"
            android:background="@drawable/bets_container_background"
            android:layout_width="0dp"
            android:layout_height="128dp"
            android:layout_marginTop="128dp"
            android:text="@string/visit_store_tickets"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/stars"
                android:background="@drawable/achievement_stars"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_default"
                android:textColor="@color/colorAccent"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:textAllCaps="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_tiny"
                android:gravity="center"
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:textAllCaps="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/earned_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/you_have_earned"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/effects"/>
        <TextView
            android:textSize="@dimen/font_size_very_big"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:id="@+id/betcoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/coin"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/earned_label"/>
        <ImageView
            android:id="@+id/coin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/betcoin"
            app:layout_constraintBottom_toBottomOf="@+id/betcoins"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/betcoins"
            app:layout_constraintTop_toTopOf="@+id/betcoins"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ok"
            android:background="@drawable/ok_button"
            android:layout_width="128dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/betcoins">
            <org.betup.ui.views.GradientTextView
                android:textSize="@dimen/font_size_big"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/price"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/got_it"
                android:textAllCaps="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:centerColor="@color/white"
                app:mainColor="@color/white"
                app:outlineWidth="0dp"
                app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
        </org.betup.ui.views.AlphaPressButton>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/share_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ok">
            <org.betup.ui.views.GradientImageButton
                android:id="@+id/fb_share"
                android:background="@drawable/fb_share_button"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <org.betup.ui.views.GradientImageButton
                android:id="@+id/vk_share"
                android:background="@drawable/vk_share_button"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            <org.betup.ui.views.GradientImageButton
                android:id="@+id/share"
                android:background="@drawable/generic_share_button"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialog_container">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="370dp"
            android:layout_height="250dp"
            android:layout_marginTop="96dp"
            android:layout_marginBottom="54dp"
            android:adjustViewBounds="false"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/achievement_header"/>
        <org.betup.ui.controls.ArcTextView
            android:textStyle="bold"
            android:id="@+id/label"
            android:layout_width="@dimen/dialog_header_width"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/level_up_title"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shadowEnabled="true"
            app:text="@string/achievement_got"
            app:textColor="@color/colorAccent"
            app:textSize="@dimen/font_size_very_big"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
