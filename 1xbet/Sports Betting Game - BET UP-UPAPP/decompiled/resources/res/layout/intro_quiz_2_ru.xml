<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/intro_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/icon"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/font_size_big"
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/quiz_intro_2_title"
            android:fontFamily="@font/montserrat_extra_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/quiz_intro_2_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_tv">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/quiz_bronze"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quiz_intro_2_bronze"
                    android:fontFamily="@font/montserrat_extra_bold"/>
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- 200"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginStart="5dp"/>
                <ImageView
                    android:textSize="@dimen/font_size_big"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/betcoin"
                    android:adjustViewBounds="true"
                    android:fontFamily="@font/montserrat_extra_bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/quiz_silver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quiz_intro_2_silver"
                    android:fontFamily="@font/montserrat_extra_bold"/>
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- 500"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginStart="5dp"/>
                <ImageView
                    android:textSize="@dimen/font_size_big"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/betcoin"
                    android:adjustViewBounds="true"
                    android:fontFamily="@font/montserrat_extra_bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:textColor="@color/quiz_gold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quiz_intro_2_gold"
                    android:fontFamily="@font/montserrat_extra_bold"/>
                <TextView
                    android:textSize="@dimen/font_size_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- 1000"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginStart="5dp"/>
                <ImageView
                    android:textSize="@dimen/font_size_big"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/betcoin"
                    android:adjustViewBounds="true"
                    android:fontFamily="@font/montserrat_extra_bold"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/quiz_intro_2_example_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_quiz_intro_2_ru"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quiz_intro_2_ll"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:id="@+id/bottom_description_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/quiz_intro_2_bottom_description"
            android:lineSpacingExtra="12sp"
            android:fontFamily="@font/montserrat_extra_bold"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quiz_intro_2_example_1"/>
        <ImageView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_quiz_intro_2_2"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bottom_description_tv"
            app:layout_constraintVertical_bias="0.13"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
