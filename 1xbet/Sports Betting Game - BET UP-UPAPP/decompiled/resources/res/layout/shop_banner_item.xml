<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:background="@drawable/shop_banner_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="2dp">
        <org.betup.ui.views.FontText
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="2dp"
            android:text="STARTER PACK"
            android:maxLines="1"
            android:shadowColor="@color/Black"
            android:shadowDx="5"
            android:shadowDy="5"
            android:shadowRadius="5"
            android:textAllCaps="true"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/benefitContainer"
            app:layout_constraintStart_toStartOf="@+id/benefitContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/benefitContainer"
            android:padding="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/price_container"
            android:background="@drawable/buy_button_blue"
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/benefitContainer"
            app:layout_constraintStart_toStartOf="@+id/benefitContainer"
            app:layout_constraintTop_toBottomOf="@+id/benefitContainer">
            <org.betup.ui.views.GradientTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/price"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:centerColor="#ffffff"
                app:mainColor="#ffffff"
                app:outlineWidth="0dp"
                app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/icon"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/money_cup"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
