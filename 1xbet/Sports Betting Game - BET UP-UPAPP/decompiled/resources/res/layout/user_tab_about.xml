<?xml version="1.0" encoding="utf-8"?>
<org.betup.ui.fragment.home.views.MyNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/inviteLabel"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/invite_friends"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/share"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/inviteLabel">
                <ImageView
                    android:id="@+id/vkShare"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/vk_share"/>
                <ImageView
                    android:id="@+id/facebookShare"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/facebook_share"/>
                <ImageView
                    android:id="@+id/firebaseShare"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/share_universal"/>
            </LinearLayout>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/codeInfo"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TextView"
                android:layout_below="@+id/share"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/labelStats"
                android:background="@color/mirageDark"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats"
                android:layout_below="@+id/codeInfo"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profileContainer"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/labelStats">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:id="@+id/referrals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/stats_referrals"
                    app:layout_constraintHorizontal_bias="0.482"
                    app:layout_constraintLeft_toLeftOf="@+id/imageView5"
                    app:layout_constraintRight_toRightOf="@+id/imageView5"
                    app:layout_constraintTop_toBottomOf="@+id/imageView5"/>
                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/stats_referrals"
                    app:layout_constraintLeft_toRightOf="@+id/imageView27"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:id="@+id/inPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/homescreen_home_in_play"
                    android:layout_weight="1"
                    app:layout_constraintLeft_toLeftOf="@+id/imageView26"
                    app:layout_constraintRight_toRightOf="@+id/imageView26"
                    app:layout_constraintTop_toBottomOf="@+id/imageView26"/>
                <ImageView
                    android:id="@+id/imageView27"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/stats_rank"
                    app:layout_constraintLeft_toRightOf="@+id/imageView26"
                    app:layout_constraintRight_toLeftOf="@+id/imageView5"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/imageView26"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/stats_in_play"
                    app:layout_constraintLeft_toRightOf="@+id/imageView25"
                    app:layout_constraintRight_toLeftOf="@+id/imageView27"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/imageView25"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/stats_lost"
                    app:layout_constraintLeft_toRightOf="@+id/imageView23"
                    app:layout_constraintRight_toLeftOf="@+id/imageView26"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/imageView23"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/stats_won"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/imageView25"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:id="@+id/won"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/homescreen_home_won"
                    android:layout_weight="1"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintLeft_toLeftOf="@+id/imageView23"
                    app:layout_constraintRight_toRightOf="@+id/imageView23"
                    app:layout_constraintTop_toBottomOf="@+id/imageView23"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:id="@+id/lost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/homescreen_home_lost"
                    app:layout_constraintLeft_toLeftOf="@+id/imageView25"
                    app:layout_constraintRight_toRightOf="@+id/imageView25"
                    app:layout_constraintTop_toBottomOf="@+id/imageView25"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:id="@+id/rank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/homescreen_home_rank"
                    app:layout_constraintHorizontal_bias="0.428"
                    app:layout_constraintLeft_toLeftOf="@+id/imageView27"
                    app:layout_constraintRight_toRightOf="@+id/imageView27"
                    app:layout_constraintTop_toBottomOf="@+id/imageView27"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/labelAchievements"
                android:background="@color/mirageDark"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drawer_achievements"
                android:layout_below="@+id/profileContainer"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/achievements"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_below="@+id/labelAchievements"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/labelFavTeams"
                android:background="@color/mirageDark"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/favourite_teams"
                android:layout_below="@+id/achievements"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/nextMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/labelFavTeams"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/labelFavLeagues"
                android:background="@color/mirageDark"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/favourite_leagues"
                android:layout_below="@+id/nextMatches"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/lastMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/labelFavLeagues"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/labelFavSports"
                android:background="@color/mirageDark"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/favourite_sports"
                android:layout_below="@+id/lastMatches"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/favSports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/labelFavSports"/>
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?android:attr/progressBarStyle"/>
    </RelativeLayout>
</org.betup.ui.fragment.home.views.MyNestedScrollView>
