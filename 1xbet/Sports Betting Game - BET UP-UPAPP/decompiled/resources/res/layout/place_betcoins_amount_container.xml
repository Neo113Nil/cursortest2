<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <org.betup.ui.views.AlphaPressButton
        android:orientation="vertical"
        android:id="@+id/buttonMin"
        android:background="@drawable/mini_games_blue_button"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/enterBet"
        app:layout_constraintEnd_toStartOf="@+id/buttonDouble"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="16sp"
            android:layout_gravity="center"
            android:paddingTop="3dp"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mini_games_bettype_min"/>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:orientation="vertical"
        android:id="@+id/buttonDouble"
        android:background="@drawable/mini_games_blue_button"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/enterBet"
        app:layout_constraintEnd_toStartOf="@+id/buttonHalf"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/buttonMin">
        <TextView
            android:textSize="16sp"
            android:layout_gravity="center"
            android:paddingTop="3dp"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mini_games_bettype_double"/>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:orientation="vertical"
        android:id="@+id/buttonHalf"
        android:background="@drawable/mini_games_blue_button"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/enterBet"
        app:layout_constraintEnd_toStartOf="@+id/buttonMax"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/buttonDouble">
        <TextView
            android:textSize="16sp"
            android:layout_gravity="center"
            android:paddingTop="3dp"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mini_games_bettype_half"/>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:orientation="vertical"
        android:id="@+id/buttonMax"
        android:background="@drawable/mini_games_blue_button"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/enterBet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/buttonHalf">
        <TextView
            android:textSize="16sp"
            android:layout_gravity="center"
            android:paddingTop="3dp"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mini_games_bettype_max"/>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/enterBet"
        android:background="@drawable/mini_games_amount_shape"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/makeBet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <EditText
            android:textSize="16sp"
            android:textColorHint="@color/mini_game_make_bet_dark_blue"
            android:layout_gravity="center_vertical"
            android:id="@+id/editBetAmount"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_custom_bet_slip_amount"
            android:maxLength="9"
            android:inputType="number"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:orientation="vertical"
        android:id="@+id/makeBet"
        android:background="@drawable/mini_games_make_bet"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="16sp"
            android:layout_gravity="center"
            android:paddingTop="6dp"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/betslip_place_bet"/>
    </org.betup.ui.views.AlphaPressButton>
</androidx.constraintlayout.widget.ConstraintLayout>
