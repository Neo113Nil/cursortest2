<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/wonMoneyAmountContainer"
    android:background="@drawable/high_low_game_won_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <View
        android:background="@drawable/high_low_game_parallel_arc"
        android:layout_width="20dp"
        android:layout_height="110dp"
        app:layout_constraintBottom_toBottomOf="@+id/result_container"
        app:layout_constraintEnd_toStartOf="@+id/result_container"
        app:layout_constraintTop_toTopOf="@+id/result_container"/>
    <include
        android:id="@+id/result_container"
        layout="@layout/container_result_games"/>
    <View
        android:background="@drawable/high_low_game_parallel_arc"
        android:layout_width="20dp"
        android:layout_height="110dp"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="@+id/result_container"
        app:layout_constraintStart_toEndOf="@+id/result_container"
        app:layout_constraintTop_toTopOf="@+id/result_container"/>
    <org.betup.ui.views.AlphaPressButton
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/okButton"
        android:background="@drawable/mini_games_make_bet"
        android:layout_width="220dp"
        android:layout_height="35dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="13sp"
            android:layout_gravity="center"
            android:paddingTop="6dp"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            android:textAllCaps="true"/>
    </org.betup.ui.views.AlphaPressButton>
</androidx.constraintlayout.widget.ConstraintLayout>
