<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/big_button_min_height">
    <org.betup.ui.fragment.home.adapter.TrapezoidSvgImageView
        android:id="@+id/background_iv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/middle_end_home_btn_bg"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="@dimen/big_button_min_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/indicator_v"
        android:background="@drawable/button_indicator"
        android:layout_width="0dp"
        android:layout_height="@dimen/big_button_indicator_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/background_iv"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/button_container_ll"
        android:padding="@dimen/big_button_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/indicator_v"
        app:layout_constraintEnd_toEndOf="@+id/indicator_v"
        app:layout_constraintStart_toStartOf="@+id/indicator_v"
        app:layout_constraintTop_toTopOf="@+id/background_iv">
        <ImageView
            android:id="@+id/icon_iv"
            android:layout_width="@dimen/medium_icon"
            android:layout_height="@dimen/medium_icon"
            android:src="@drawable/ic_battle"
            android:minWidth="36dp"
            android:minHeight="36dp"/>
        <TextView
            android:textSize="@dimen/font_size_medium"
            android:textColor="@color/active_text"
            android:gravity="center"
            android:id="@+id/btn_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/battles"
            android:maxLines="2"
            android:textAllCaps="true"
            android:fontFamily="@font/open_sans_bold"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="fullFast"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="14sp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
