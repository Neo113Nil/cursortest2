<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_quiz_outer_cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_quiz_cl"
        android:background="#044c83"
        android:layout_width="@dimen/dialog_header_width"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_cl"
            android:background="@drawable/quiz_dialog_header_background_ic"
            android:paddingTop="10dp"
            android:paddingBottom="35dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/font_size_big"
                android:id="@+id/title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bet Quiz"
                android:fontFamily="@font/montserrat_extra_bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/font_size_medium"
                android:textColor="#05cbf5"
                android:id="@+id/subtitle_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Guess all 3 outcomes and win BIG!"
                android:maxLines="2"
                android:fontFamily="@font/montserrat_extra_bold"
                android:textAlignment="center"
                android:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title_tv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_cl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_cl">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/container_fcv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </ScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/close_btn"
        android:background="@drawable/dialog_close_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:elevation="3dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_quiz_cl"
        app:layout_constraintEnd_toEndOf="@+id/dialog_quiz_cl"
        app:layout_constraintStart_toEndOf="@+id/dialog_quiz_cl"
        app:layout_constraintTop_toTopOf="@+id/dialog_quiz_cl"/>
</androidx.constraintlayout.widget.ConstraintLayout>
