<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="1dp"
    android:paddingBottom="1dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/lightCyan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:baselineAligned="false">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2">
                <ImageView
                    android:id="@+id/likeIcon"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:src="@mipmap/bowls"
                    style="@style/TeamLogoItem"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="@dimen/font_size_very_small"
                    android:ellipsize="end"
                    android:id="@+id/firstTeamName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Team 1"
                    android:maxLines="2"
                    android:layout_weight="0.1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="86dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:baselineAligned="false">
                <View
                    android:orientation="horizontal"
                    android:background="@color/drawer_divider"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textSize="@dimen/font_size_medium"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/matchDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="22.05"
                        android:maxLines="1"
                        android:layout_weight="1"/>
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textSize="@dimen/font_size_very_small"
                        android:textStyle="bold"
                        android:textColor="@color/gray"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/matchTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="10dp"
                        android:text="19:15"
                        android:maxLines="1"
                        android:layout_weight="1"/>
                </LinearLayout>
                <View
                    android:orientation="vertical"
                    android:background="@color/drawer_divider"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="@dimen/font_size_very_small"
                    android:ellipsize="end"
                    android:gravity="right"
                    android:id="@+id/secondTeamName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="Team 2"
                    android:maxLines="2"
                    android:layout_weight="0.1"/>
                <ImageView
                    android:id="@+id/secondTeamIcon"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp"
                    android:src="@mipmap/bowls"
                    style="@style/TeamLogoItem"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/drawer_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="2dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/remove"
                android:padding="5dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="5dp"
                android:src="@android:drawable/ic_delete"
                android:layout_alignParentRight="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/start"
                    android:background="@color/colorPrimary"
                    android:padding="5dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="5dp"
                    android:src="@drawable/start"/>
                <ImageView
                    android:id="@+id/score"
                    android:background="@color/colorPrimary"
                    android:padding="5dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="5dp"
                    android:src="@drawable/score_changed"/>
                <ImageView
                    android:id="@+id/finish"
                    android:background="@color/colorPrimary"
                    android:padding="5dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="5dp"
                    android:src="@drawable/finished"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
