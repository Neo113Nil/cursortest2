<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/double_game_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/history_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintBottom_toTopOf="@+id/timer_cl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/history_rv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timer_cl"
        android:background="@drawable/double_game_timer_bg"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:maxWidth="500dp"
        android:minWidth="100dp"
        android:alpha="0"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toTopOf="@+id/roulette_cl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/history_cl">
        <View
            android:id="@+id/timer_active_v"
            android:background="@drawable/double_game_timer_active_bg_color"
            android:layout_width="50dp"
            android:layout_height="0dp"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/timer_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wait: 3.02 sec"
            android:fontFamily="@font/open_sans_regular"
            android:paddingHorizontal="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/roulette_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_cl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timer_cl">
        <ImageView
            android:id="@+id/roulette_top_bg_v"
            android:background="@drawable/double_game_roulette_center_item_top_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/roulette_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/roulette_bottom_bg_v"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/roulette_top_bg_v"/>
        <ImageView
            android:id="@+id/roulette_bottom_bg_v"
            android:background="@drawable/double_game_roulette_center_item_bottom_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/roulette_center_bg_v"
            android:background="@drawable/double_game_roulette_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/roulette_cl">
        <com.google.android.flexbox.FlexboxLayout
            android:orientation="horizontal"
            android:id="@+id/bet_type_btn_fl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:justifyContent="space_between"
            app:layout_constraintBottom_toTopOf="@+id/bet_container_fl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/red_bet_type_ll"
                android:background="@drawable/double_game_bet_type_button_active_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="25dp"
                android:paddingVertical="15dp">
                <View
                    android:background="@drawable/double_game_bet_type_button_red_bg"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>
                <TextView
                    android:textColor="@color/double_game_bet_type_active_text"
                    android:id="@+id/red_bet_type_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X 2"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/zero_bet_type_ll"
                android:background="@drawable/double_game_bet_type_button_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="25dp"
                android:paddingVertical="15dp">
                <View
                    android:background="@drawable/double_game_bet_type_button_zero_bg"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>
                <TextView
                    android:textColor="@color/double_game_bet_type_text"
                    android:id="@+id/zero_bet_type_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X 14"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/black_bet_type_ll"
                android:background="@drawable/double_game_bet_type_button_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="25dp"
                android:paddingVertical="15dp">
                <View
                    android:background="@drawable/double_game_bet_type_button_black_bg"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>
                <TextView
                    android:textColor="@color/double_game_bet_type_text"
                    android:id="@+id/black_bet_type_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X 2"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </com.google.android.flexbox.FlexboxLayout>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/bet_container_fl"
            android:background="@color/double_game_bg"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:flexDirection="column"
            app:justifyContent="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bet_type_btn_fl">
            <com.google.android.flexbox.FlexboxLayout
                android:orientation="horizontal"
                android:background="@drawable/button_round_background"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/double_game_secondary_bg"
                app:alignItems="center"
                app:justifyContent="space_around">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/buttonMin"
                    android:background="@drawable/double_game_bet_type_button_active_bg"
                    android:padding="5dp"
                    android:layout_width="50dp"
                    android:layout_height="50dp">
                    <TextView
                        android:textSize="@dimen/font_size_medium"
                        android:textColor="@color/double_game_bet_type_active_text"
                        android:id="@+id/min_bet_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/double_game_min"
                        android:fontFamily="@font/open_sans_regular"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/buttonHalf"
                    android:background="@drawable/double_game_bet_type_button_bg"
                    android:padding="5dp"
                    android:layout_width="50dp"
                    android:layout_height="50dp">
                    <TextView
                        android:textSize="@dimen/font_size_medium"
                        android:textColor="@color/double_game_bet_type_text"
                        android:id="@+id/half_bet_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1/2"
                        android:fontFamily="@font/open_sans_regular"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/bet_amount_ll"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="@dimen/font_size_very_big"
                        android:textColor="@color/double_game_bet_type_active_text"
                        android:textColorHint="@color/mini_game_make_bet_dark_blue"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/bet_amount_et"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="80dp"
                        android:text="150"
                        android:cursorVisible="false"
                        android:maxLength="9"
                        android:inputType="number"
                        android:fontFamily="@font/open_sans_bold"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/betcoin"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/buttonDouble"
                    android:background="@drawable/double_game_bet_type_button_bg"
                    android:padding="5dp"
                    android:layout_width="50dp"
                    android:layout_height="50dp">
                    <TextView
                        android:textSize="@dimen/font_size_medium"
                        android:textColor="@color/double_game_bet_type_text"
                        android:id="@+id/double_bet_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="X 2"
                        android:fontFamily="@font/open_sans_regular"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/buttonMax"
                    android:background="@drawable/double_game_bet_type_button_bg"
                    android:padding="5dp"
                    android:layout_width="50dp"
                    android:layout_height="50dp">
                    <TextView
                        android:textSize="@dimen/font_size_medium"
                        android:textColor="@color/double_game_bet_type_text"
                        android:id="@+id/max_bet_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/double_game_max"
                        android:fontFamily="@font/open_sans_regular"/>
                </LinearLayout>
            </com.google.android.flexbox.FlexboxLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/make_bet_ll"
                android:background="@drawable/button_round_background"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/double_game_make_bet_active_bg">
                <TextView
                    android:textSize="@dimen/font_size_very_big"
                    android:textColor="@color/double_game_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/double_game_play_btn"
                    android:fontFamily="@font/open_sans_bold"/>
            </LinearLayout>
        </com.google.android.flexbox.FlexboxLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
