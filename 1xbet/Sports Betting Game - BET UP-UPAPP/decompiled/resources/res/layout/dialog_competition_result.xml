<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="@color/backgroundCompetitionDialogColor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/competition_match_view_max_width">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bets"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="300dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/competition_header"/>
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="@+id/bets"
            app:layout_constraintEnd_toEndOf="@+id/bets"
            app:layout_constraintStart_toStartOf="@+id/bets"
            app:layout_constraintTop_toTopOf="@+id/bets"/>
        <View
            android:background="#031829"
            android:layout_width="0dp"
            android:layout_height="120dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bets"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/result_first_line"
            android:background="#03182b"
            android:layout_width="0dp"
            android:layout_height="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bets">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:gravity="center"
                android:id="@+id/buyin_title"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="@string/competition_buy_in"
                android:textAllCaps="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/buyin_amount_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/buyin_amount_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/buyin_title"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/yellowCompetitionColor"
                    android:gravity="center"
                    android:id="@+id/buyin_amount"
                    android:background="@drawable/competition_amount_shape"
                    android:layout_width="81dp"
                    android:layout_height="wrap_content"
                    android:lines="1"/>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/betcoin"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:gravity="center"
                android:id="@+id/prize_pool_title"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="@string/competition_prize_pool"
                android:textAllCaps="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/prize_pool_amount_container"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/prize_pool_amount_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/yellowCompetitionColor"
                    android:gravity="center"
                    android:id="@+id/prize_pool_amount"
                    android:background="@drawable/competition_amount_shape"
                    android:layout_width="81dp"
                    android:layout_height="wrap_content"
                    android:lines="1"/>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/betcoin"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/result_second_line"
            android:background="#03182b"
            android:layout_width="0dp"
            android:layout_height="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/result_first_line">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:gravity="center"
                android:id="@+id/result_title"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="@string/result"
                android:textAllCaps="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/result_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/result_title"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/yellowCompetitionColor"
                    android:gravity="center"
                    android:id="@+id/result_amount"
                    android:background="@drawable/competition_amount_shape"
                    android:layout_width="81dp"
                    android:layout_height="wrap_content"
                    android:lines="1"/>
                <ImageView
                    android:id="@+id/jackpotIcon"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/competition_winner_logo"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:gravity="center"
                android:id="@+id/won_title"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="@string/full_won"
                android:textAllCaps="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/won_container"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/won_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/yellowCompetitionColor"
                    android:gravity="center"
                    android:id="@+id/won_amount"
                    android:background="@drawable/competition_amount_shape"
                    android:layout_width="81dp"
                    android:layout_height="wrap_content"
                    android:lines="1"/>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/betcoin"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <org.betup.ui.views.AlphaPressButton
            android:id="@+id/ok_button"
            android:background="@drawable/competition_inactive_confirm_button_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/bets"
            app:layout_constraintStart_toStartOf="@+id/bets">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:text="@string/ok"
                android:maxLines="1"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2.5"
                android:textAllCaps="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:autoSizeTextType="uniform"/>
        </org.betup.ui.views.AlphaPressButton>
        <View
            android:id="@+id/competition_header"
            android:background="@drawable/competition_in_play_header"
            android:layout_width="0dp"
            android:layout_height="100dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/competition_name"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginTop="28dp"
            android:shadowColor="@color/black"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2.5"
            app:autoSizeMaxTextSize="24sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/competition_header"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
