<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/competition_item_match"
    android:background="@drawable/item_competition_background"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_container"
        android:background="@drawable/item_competition_top_container_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:background="@drawable/item_competiton_title_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/away_team_icon"
            app:layout_constraintStart_toEndOf="@+id/home_team_icon"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/title_sport_icon"
                android:background="@drawable/info_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/title_sport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:maxLines="1"
                android:layout_marginEnd="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/away_team_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="-"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/away_team_icon"
            app:layout_constraintStart_toEndOf="@+id/container_date_time"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/away_team_icon"
            android:background="@drawable/info_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/container_date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_container">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/DarkGray"
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/DarkGray"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/DarkGray"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/home_team_icon"
            android:background="@drawable/info_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:layout_gravity="start"
            android:id="@+id/home_team_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="-"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/container_date_time"
            app:layout_constraintStart_toEndOf="@+id/home_team_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/Red"
        android:ellipsize="end"
        android:id="@+id/bet_type_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/select_your_bet_to_accept_competition"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/bet_type"
        app:layout_constraintEnd_toStartOf="@+id/coef_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_container"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:id="@+id/bet_type"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bet_type_name"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/coef_container"
        android:background="@drawable/item_competition_background"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="-"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/status_icon"
        app:layout_constraintTop_toBottomOf="@+id/top_container"/>
    <ImageView
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/status_icon"
        android:background="@drawable/bet_placed"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
