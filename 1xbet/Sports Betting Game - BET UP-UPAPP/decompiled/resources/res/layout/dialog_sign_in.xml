<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_shape"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp">
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textStyle="bold"
        android:textColor="@color/colorAccent"
        android:gravity="center_horizontal"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/dialog_sign_in_text"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <EditText
                android:id="@+id/email"
                android:paddingLeft="10dp"
                android:paddingRight="42dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="@string/dialog_hint_email"
                style="@style/AppEditTextStyle"/>
            <ImageView
                android:layout_width="32dp"
                android:layout_height="24dp"
                android:layout_marginRight="8dp"
                android:src="@mipmap/email_icon"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <EditText
                android:id="@+id/password"
                android:paddingLeft="10dp"
                android:paddingRight="42dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="@string/dialog_hint_password"
                android:inputType="textPassword"
                style="@style/AppEditTextStyle"/>
            <ImageView
                android:layout_width="32dp"
                android:layout_height="24dp"
                android:layout_marginRight="8dp"
                android:src="@mipmap/password_icon"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <Button
                android:id="@+id/cancelButton"
                android:background="@drawable/red_button_selector"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:text="@string/dialog_cancel_button"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/signInButton"
                android:background="@drawable/dialog_ok_selector"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginLeft="10dp"
                android:text="@string/dialog_sign_in_button"
                android:layout_weight="1"/>
        </LinearLayout>
        <Button
            android:id="@+id/registerButton"
            android:background="@drawable/dialog_blue_button"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:text="@string/dialog_sign_up_text"/>
        <TextView
            android:textSize="@dimen/button_text_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/resetPass"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:text="@string/reset_password"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
