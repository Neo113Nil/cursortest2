<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/default_container_margin">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="20dp"
        style="@style/MatchItemStyle">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/match_container"
                android:background="@drawable/match_item_inner_banner_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.flexbox.FlexboxLayout
                    android:orientation="horizontal"
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="16dp"
                    app:alignItems="center"
                    app:justifyContent="center">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        app:layout_flexGrow="1"
                        app:layout_flexShrink="1">
                        <ImageView
                            android:id="@+id/likeIcon"
                            android:layout_marginBottom="5dp"
                            android:src="@mipmap/bowls"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            app:layout_flexShrink="1"
                            style="@style/TeamLogoItem"/>
                        <TextView
                            android:gravity="center"
                            android:id="@+id/firstTeamName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Team 1"
                            android:maxLines="2"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        app:layout_flexGrow="0.5"
                        app:layout_flexShrink="1">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textColor="@color/secondary_text"
                                    android:gravity="center"
                                    android:id="@+id/score_home_tv"
                                    android:background="@drawable/match_score_bg"
                                    android:padding="5dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="30dp"
                                    android:minHeight="30dp"
                                    android:text="-"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:textColor="@color/secondary_text"
                                    android:gravity="center"
                                    android:id="@+id/score_away_tv"
                                    android:background="@drawable/match_score_bg"
                                    android:padding="5dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="30dp"
                                    android:minHeight="30dp"
                                    android:text="-"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/secondary_text"
                                android:ellipsize="end"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/period_scores_tv"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="2"/>
                            <TextView
                                android:textColor="@color/secondary_text"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/matchTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="19:15"
                                android:maxLines="1"/>
                            <TextView
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/matchDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="22.05"
                                android:maxLines="1"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        app:layout_flexGrow="1"
                        app:layout_flexShrink="1">
                        <ImageView
                            android:id="@+id/secondTeamIcon"
                            android:layout_marginBottom="10dp"
                            android:src="@mipmap/bowls"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            style="@style/TeamLogoItem"/>
                        <TextView
                            android:gravity="center"
                            android:id="@+id/secondTeamName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Team 2"
                            android:maxLines="2"/>
                    </LinearLayout>
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>
            <include
                android:layout_gravity="end|top"
                android:layout_width="@dimen/match_share_button_size"
                android:layout_height="@dimen/match_share_button_size"
                android:layout_marginTop="@dimen/match_share_button_edge_inset"
                android:layout_marginEnd="@dimen/match_share_button_edge_inset"
                layout="@layout/match_share_list_button"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.1">
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/bets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/betsList"
                    android:focusableInTouchMode="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/label"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="-5dp"
        android:layout_alignParentTop="true"
        android:importantForAccessibility="no"
        android:layout_marginEnd="2dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
