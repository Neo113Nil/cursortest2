<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="@drawable/dialog_shop_shape"
        android:layout_width="@dimen/dialog_header_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <org.betup.ui.views.GradientTextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/thanks_label"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/daily_bonus"
            android:maxLines="1"
            android:textAllCaps="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:autoSizeMinTextSize="@dimen/font_size_medium"
            app:autoSizeTextType="uniform"
            app:centerColor="@color/goldenLight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:mainColor="@color/colorAccent"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/your_purchase_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/come_every_day_for_rewards"
            android:maxLines="2"
            android:textAllCaps="true"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/thanks_label"/>
        <androidx.recyclerview.widget.RecyclerView
            android:textSize="24sp"
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/list"
            android:layout_width="wrap_content"
            android:layout_height="240dp"
            android:layout_marginTop="8dp"
            android:text="@string/do_you_want_to_buy_missing_betcoin"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/your_purchase_label"/>
        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/list"
            app:layout_constraintEnd_toEndOf="@+id/list"
            app:layout_constraintStart_toStartOf="@+id/list"
            app:layout_constraintTop_toTopOf="@+id/list"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/specialDay"
            android:background="@drawable/daily_bonus_item_background"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/list">
            <ImageView
                android:id="@+id/specialDayIcon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitEnd"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/light_blue"
                android:id="@+id/day_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/daily_bonus_footer"
                android:layout_width="0dp"
                android:layout_height="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/betcoinBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="betcoinsIcon,betcoins"/>
                <ImageView
                    android:id="@+id/specialCheck"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/check"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:id="@+id/betcoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:shadowColor="@color/Black"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/betcoinsIcon"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/specialCheck"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/betcoinsIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/betcoin"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/betcoins"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <org.betup.ui.views.GradientTextView
            android:id="@+id/nextAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/specialDay"/>
        <org.betup.ui.controls.SpriteImageButton
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ok"
            android:background="@drawable/buy_button"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/multiplyBonus"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nextAvailable"
            app:title="@string/collect"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/multiplyBonus"
            android:background="@drawable/ok_button"
            android:visibility="gone"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/ok"
            app:layout_constraintTop_toBottomOf="@+id/nextAvailable">
            <androidx.appcompat.widget.AppCompatTextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/multiplyBonusTitle"
                android:layout_width="120dp"
                android:layout_height="24dp"
                android:text="Get x3 bonus"
                android:maxLines="1"
                android:shadowColor="@color/black"
                android:shadowRadius="3"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:autoSizeMaxTextSize="24sp"
                app:autoSizeTextType="uniform"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/multiplyBetcoinsBonus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/black"
                    android:shadowRadius="1.5"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/betcoin"/>
            </LinearLayout>
        </org.betup.ui.views.AlphaPressButton>
        <ImageView
            android:id="@+id/videoRewardIcon"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="-8dp"
            android:src="@drawable/video_reward_icon"
            app:layout_constraintEnd_toEndOf="@+id/multiplyBonus"
            app:layout_constraintStart_toEndOf="@+id/multiplyBonus"
            app:layout_constraintTop_toTopOf="@+id/multiplyBonus"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/close"
        android:background="@drawable/dialog_close_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:elevation="3dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_container"
        app:layout_constraintEnd_toEndOf="@+id/dialog_container"
        app:layout_constraintStart_toEndOf="@+id/dialog_container"
        app:layout_constraintTop_toTopOf="@+id/dialog_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
