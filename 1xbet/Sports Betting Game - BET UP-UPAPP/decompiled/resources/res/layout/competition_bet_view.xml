<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/competition_bet_available_shape"
    android:layout_width="match_parent"
    android:layout_height="28dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/bet_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:maxLines="2"
        android:textAllCaps="true"
        android:paddingStart="4dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bet_coef"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="32dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:gravity="center"
        android:id="@+id/bet_coef"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:maxWidth="54dp"
        android:minWidth="36dp"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
