<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/balance_view"
    android:paddingTop="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/betcoins"
        android:background="@drawable/shop_field_money_shape"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:minWidth="84dp"
        android:text="2,000,000,000"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/betcoin_iv"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/betcoin"
        app:layout_constraintBottom_toBottomOf="@+id/betcoins"
        app:layout_constraintEnd_toStartOf="@+id/betcoins"
        app:layout_constraintStart_toStartOf="@+id/betcoins"
        app:layout_constraintTop_toTopOf="@+id/betcoins"/>
</androidx.constraintlayout.widget.ConstraintLayout>
