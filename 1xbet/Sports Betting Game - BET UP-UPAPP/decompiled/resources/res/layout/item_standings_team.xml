<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/standings_stats_team"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/position"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_weight="1"
        app:layout_constraintEnd_toStartOf="@+id/textView21"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/teamLabel"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/team"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:text="@string/standings_team"
        android:maxLines="1"
        android:layout_weight="3"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/played"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:text="@string/standings_p"
        android:layout_weight="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/won"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:text="@string/standings_w"
        android:layout_weight="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/draw"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:text="@string/standings_d"
        android:layout_weight="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/lost"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:text="@string/standings_l"
        android:layout_weight="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/f_a"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:text="@string/standings_f_a"
        android:layout_weight="1.5"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/pts"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:text="@string/standings_pts"
        android:layout_weight="1.5"/>
</LinearLayout>
