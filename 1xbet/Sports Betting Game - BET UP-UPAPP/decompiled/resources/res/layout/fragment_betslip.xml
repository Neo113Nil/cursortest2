<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/blackCyan"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footer"
        android:layout_alignParentTop="true">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/betslipList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="singleChoice"/>
        <TextView
            android:textSize="@dimen/font_size_medium"
            android:gravity="center"
            android:id="@+id/no_bets"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/betslip_no_bets_in_list"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            style="?android:attr/progressBarStyle"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/footer"
        android:background="@color/colorPrimaryDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/gray"
                android:id="@+id/textView12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/betslip_odds_big"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/amountContainer"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/gray"
                android:id="@+id/textView50"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@+id/odds"
                app:layout_constraintTop_toTopOf="@+id/odds"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:id="@+id/odds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/textView12"
                app:layout_constraintStart_toEndOf="@+id/textView12"
                app:layout_constraintTop_toTopOf="@+id/textView12"/>
            <ImageView
                android:id="@+id/bestCoin"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/betcoin"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/odds"
                app:layout_constraintStart_toEndOf="@+id/highscoreLabel"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:id="@+id/highscore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.75"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/highscoreLabel"
                app:layout_constraintStart_toEndOf="@+id/bestCoin"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/gray"
                android:id="@+id/highscoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/highscore"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/bestCoin"
                app:layout_constraintStart_toEndOf="@+id/odds"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                app:layout_constraintStart_toEndOf="@+id/textView50"
                app:layout_constraintTop_toTopOf="@+id/textView50"/>
            <include
                android:id="@+id/amountContainer"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/betting_amount"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/gray"
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/betslip_return"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toTopOf="@+id/textView12"
                app:layout_constraintStart_toEndOf="@+id/amountContainer"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/returnCoinIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/betcoin"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/returnBalance"
                app:layout_constraintStart_toEndOf="@+id/textView6"
                app:layout_constraintTop_toTopOf="@+id/returnBalance"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:id="@+id/returnBalance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/returnCoinIcon"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/betcoin"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textStyle="italic|bold"
                android:textColor="@color/colorAccent"
                android:gravity="start|center_vertical"
                android:id="@+id/minAmount"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:minWidth="32dp"
                android:maxLines="2"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <LinearLayout
                    android:paddingTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_very_small"
                            android:gravity="center"
                            android:id="@+id/thirdBet"
                            android:background="@drawable/betslip_bet_selector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1/3"/>
                        <ImageView
                            android:id="@+id/lock_third"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_weight="1"
                            android:layout_centerInParent="true"
                            android:alpha="0.75"
                            app:srcCompat="@drawable/lock_item"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:textSize="@dimen/font_size_very_small"
                            android:gravity="center"
                            android:id="@+id/halfBet"
                            android:background="@drawable/betslip_bet_selector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1/2"/>
                        <ImageView
                            android:id="@+id/lock_half"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_weight="1"
                            android:layout_centerInParent="true"
                            android:alpha="0.75"
                            app:srcCompat="@drawable/lock_item"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_very_small"
                            android:gravity="center"
                            android:id="@+id/maxBet"
                            android:background="@drawable/betslip_bet_selector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MAX"/>
                        <ImageView
                            android:id="@+id/lock_max"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerInParent="true"
                            android:alpha="0.75"
                            app:srcCompat="@drawable/lock_item"/>
                    </RelativeLayout>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="5dp"
                    android:layout_weight="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/maxAmount"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/minAmount"
                    app:layout_constraintTop_toBottomOf="@+id/maxBet"
                    style="@style/AppTheme"/>
            </LinearLayout>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/betcoin"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textStyle="italic|bold"
                android:textColor="@color/colorAccent"
                android:gravity="end"
                android:id="@+id/maxAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:maxWidth="64dp"
                android:maxLines="2"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </LinearLayout>
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginBottom="8dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <ImageView
                android:id="@+id/removeAllButton"
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="40dp"
                android:src="@drawable/trash_icon"
                android:tint="@color/DarkGray"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="4dp"/>
            <include
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                layout="@layout/place_bet_button"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/tipButton"
                android:background="@drawable/light_gray_button"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:textSize="@dimen/font_size_medium"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="@string/create_tip"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/settings"
                android:padding="2dp"
                android:layout_width="32dp"
                android:layout_height="24dp"
                android:src="@drawable/cog_icon"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
