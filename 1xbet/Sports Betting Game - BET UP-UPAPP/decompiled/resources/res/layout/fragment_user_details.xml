<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profileContainer"
        android:background="@color/blackCyan"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/profileBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/linearLayout5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/balanceLabel"
            app:layout_constraintStart_toStartOf="@+id/balanceLabel"
            app:layout_constraintTop_toBottomOf="@+id/balanceLabel">
            <ImageView
                android:id="@+id/coin"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/betcoin"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:id="@+id/countryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/country"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/avatar"/>
        <ImageView
            android:id="@+id/countryLogo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/balanceLabel"
            app:layout_constraintEnd_toEndOf="@+id/countryName"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="@+id/countryName"
            app:layout_constraintTop_toBottomOf="@+id/countryName"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:id="@+id/balanceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/user_balance"
            android:layout_weight="1"
            app:layout_constraintBottom_toTopOf="@+id/linearLayout5"
            app:layout_constraintEnd_toStartOf="@+id/avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/countryLogo"/>
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/avatar"
            android:layout_width="@dimen/user_details_avatar_size"
            android:layout_height="@dimen/user_details_avatar_size"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/user_round_avatar"
            android:scaleType="fitXY"
            android:adjustViewBounds="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_border_color="@color/magentaCyanBlack"
            app:riv_border_width="5dp"
            app:riv_corner_radius="30dp"
            app:riv_mutate_background="true"
            app:riv_oval="true"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold"
            android:id="@+id/userName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="8dp"
            app:layout_constraintLeft_toLeftOf="@+id/avatar"
            app:layout_constraintRight_toRightOf="@+id/avatar"
            app:layout_constraintTop_toBottomOf="@+id/avatar"/>
        <ImageView
            android:id="@+id/followersButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toTopOf="@+id/followersTitle"
            app:layout_constraintEnd_toEndOf="@+id/followersCount"
            app:layout_constraintStart_toStartOf="@+id/followersTitle"
            app:srcCompat="@drawable/follow_false"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/followersGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="followersCount, followersTitle, followersButton"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/Black"
            android:gravity="center"
            android:id="@+id/followersCount"
            android:background="@drawable/followers_count_background"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="-"
            android:maxLength="4"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/followersTitle"
            app:layout_constraintStart_toStartOf="@+id/countDivider"
            app:layout_constraintTop_toTopOf="@+id/followersTitle"/>
        <View
            android:id="@+id/countDivider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/followersTitle"
            app:layout_constraintEnd_toEndOf="@+id/followersTitle"
            app:layout_constraintTop_toTopOf="@+id/followersTitle"/>
        <TextView
            android:textSize="@dimen/font_size_small_10"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/followersTitle"
            android:background="@drawable/followers_title_background"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="@string/followers"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <org.betup.ui.views.PagerSlidingTabStrip
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toBottomOf="@+id/profileContainer"/>
    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pages">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:background="@color/blackCyan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            style="?android:attr/progressBarStyle"/>
    </RelativeLayout>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/chat"
        android:background="@drawable/chat_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/pages"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/pages"
        app:layout_constraintEnd_toStartOf="@+id/chat"
        app:srcCompat="@drawable/challenge_icon"/>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/createChallengeButton"
        android:background="@drawable/icon_private_challenge"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/pages"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
