<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="@color/item_my_bets_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/dividerTop"
        android:background="@color/item_my_bets_background"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/datetime"
        app:layout_constraintEnd_toEndOf="@+id/divider"
        app:layout_constraintStart_toStartOf="@+id/divider"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/dividerBottom"
        android:background="@color/item_my_bets_background"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/divider"
        app:layout_constraintStart_toStartOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/return_amount_title"/>
    <View
        android:id="@+id/divider_horizontal"
        android:background="@color/divider_bets_horizontal"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/footer"
        app:layout_constraintEnd_toEndOf="@+id/singleOdd"
        app:layout_constraintStart_toStartOf="@+id/divider"/>
    <View
        android:id="@+id/divider_horizontal_placeholder"
        android:background="@color/item_my_bets_background"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="@+id/divider_horizontal"
        app:layout_constraintStart_toStartOf="@+id/divider_horizontal"
        app:layout_constraintTop_toTopOf="@+id/divider_horizontal"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/fragment_standings_text_color"
        android:id="@+id/datetime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="start|top"
        android:id="@+id/teamNames"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Greece. LOTTO. It&apos;s a very-very long match name, because of lottery"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/singleOdd"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/datetime"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/colorAccent"
        android:gravity="start|top"
        android:layout_gravity="center_vertical"
        android:id="@+id/bet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/singleOdd"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teamNames"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/results"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bet"/>
    <TextView
        android:textColor="@color/black"
        android:gravity="center_horizontal"
        android:id="@+id/singleOdd"
        android:background="@drawable/my_bet_odd_shape"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/results"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/divider"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/bet_amount_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@+id/results"
        app:layout_constraintTop_toBottomOf="@+id/results"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/colorAccent"
        android:id="@+id/bet_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/bet_amount_title"
        app:layout_constraintStart_toEndOf="@+id/bet_amount_title"
        app:layout_constraintTop_toTopOf="@+id/bet_amount_title"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/bet_coin"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/betcoin"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/bet_amount"
        app:layout_constraintStart_toEndOf="@+id/bet_amount"
        app:layout_constraintTop_toTopOf="@+id/bet_amount"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/return_amount_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/bet_amount_title"
        app:layout_constraintTop_toBottomOf="@+id/bet_amount"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/button_green"
        android:id="@+id/return_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/return_amount_title"
        app:layout_constraintStart_toEndOf="@+id/return_amount_title"
        app:layout_constraintTop_toTopOf="@+id/return_amount_title"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/return_coin"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/betcoin"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/return_amount"
        app:layout_constraintStart_toEndOf="@+id/return_amount"
        app:layout_constraintTop_toTopOf="@+id/return_amount"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/odd_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/odd"
        app:layout_constraintTop_toTopOf="@+id/odd"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/colorAccent"
        android:id="@+id/odd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bet_amount_title"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/buttonGroup"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bet_amount,bet_amount_title,return_amount,return_amount_title,odd_title,odd,return_coin,bet_coin,dividerTop,dividerBottom,divider_horizontal_placeholder"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/betActionsGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="cancel_bet,sell_bet"/>
    <View
        android:id="@+id/footer"
        android:background="@color/bets_item_footer"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/return_amount_title"/>
    <TextView
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/congratulations"
        android:background="@color/Green"
        android:padding="2dp"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/bet_won_congrat"
        android:shadowColor="@color/Black"
        android:shadowRadius="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sell_bet"/>
    <org.betup.ui.views.AlphaPressButton
        android:gravity="center"
        android:id="@+id/cancel_bet"
        android:background="@drawable/dark_blue_button"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.8"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:clickableWhenDisabled="false"
        app:layout_constraintBottom_toTopOf="@+id/congratulations"
        app:layout_constraintEnd_toStartOf="@+id/sell_bet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/return_amount_title">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel_bet"
            android:layout_marginEnd="5dp"/>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:gravity="center"
        android:id="@+id/sell_bet"
        android:background="@drawable/dark_blue_button"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_weight="1"
        android:alpha="0.8"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:clickableWhenDisabled="false"
        app:layout_constraintBottom_toBottomOf="@+id/cancel_bet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cancel_bet"
        app:layout_constraintTop_toTopOf="@+id/cancel_bet">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sell_bet"
            android:layout_marginEnd="5dp"/>
    </org.betup.ui.views.AlphaPressButton>
</androidx.constraintlayout.widget.ConstraintLayout>
