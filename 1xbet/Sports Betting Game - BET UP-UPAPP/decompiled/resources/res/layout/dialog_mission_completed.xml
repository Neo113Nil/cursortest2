<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="@drawable/dialog_shop_shape"
        android:layout_width="@dimen/dialog_header_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <org.betup.ui.views.GradientTextView
            android:textSize="@dimen/font_size_default"
            android:textStyle="bold"
            android:id="@+id/thanks_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/mission_completed"
            android:maxLines="1"
            android:textAllCaps="true"
            app:centerColor="@color/colorAccent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:mainColor="@color/colorAccent"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <org.betup.ui.views.GradientTextView
            android:textSize="@dimen/font_size_big"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/your_purchase_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/missions_reward"
            android:maxLines="2"
            android:textAllCaps="true"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            app:centerColor="@color/colorAccent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/thanks_label"
            app:mainColor="@color/colorAccent"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <LinearLayout
            android:textSize="@dimen/font_size_very_big"
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/message"
            android:background="@drawable/purchase_amount_shape"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:text="@string/do_you_want_to_buy_missing_betcoin"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/your_purchase_label">
            <ImageView
                android:id="@+id/betcoin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/betcoin"
                android:layout_marginStart="8dp"/>
            <org.betup.ui.views.GradientTextView
                android:textSize="@dimen/font_size_very_big"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:id="@+id/balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:centerColor="@color/goldenLight"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/betcoin"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
        </LinearLayout>
        <org.betup.ui.views.GradientTextView
            android:textSize="@dimen/font_size_very_big"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/wish_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/we_wish_you_happy_betting"
            android:maxLines="2"
            android:textAllCaps="true"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            app:centerColor="@color/goldenLight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/message"
            app:mainColor="@color/colorAccent"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <View
            android:background="@drawable/rays"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:rotation="180"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/message"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ok"
            android:background="@drawable/buy_button"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/wish_label">
            <org.betup.ui.views.GradientTextView
                android:textSize="@dimen/font_size_big"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/actionTitle"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/got_it"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:centerColor="#ac7300"
                app:mainColor="#784701"
                app:outlineWidth="0dp"
                app:typefaceAsset="fonts/AvenitNextCyr-Bold.ttf"/>
        </org.betup.ui.views.AlphaPressButton>
        <View
            android:background="@drawable/tickets_frame_top"
            android:layout_width="0dp"
            android:layout_height="@dimen/ticket_frame_element_height"
            android:rotation="180"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
