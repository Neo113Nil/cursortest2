<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/challenge_status_dialog_container"
    android:paddingBottom="2dp"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutGroup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="top_level_status_imagines,league_icon,league_name,matchInfo,vs_divider,firstPlayerBetContainer,secondPlayerBetContainer,statusText,prizeContainer,action_button,action_button_background"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/top_level_status_imagines"
        android:background="@drawable/challenge_list_item_main_container"
        android:layout_width="0dp"
        android:layout_height="42dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/top_level_status_text"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="8dp"
            android:text="@string/your_challenge_started"
            android:maxLines="1"
            android:maxLength="50"
            android:shadowColor="@color/black"
            android:shadowRadius="2"
            app:autoSizeMaxTextSize="18sp"
            app:autoSizeTextType="uniform"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/closebtn"
        app:layout_constraintBottom_toBottomOf="@+id/top_level_status_imagines"
        app:layout_constraintStart_toStartOf="@+id/top_level_status_imagines"
        app:layout_constraintTop_toTopOf="@+id/top_level_status_imagines"/>
    <ImageView
        android:id="@+id/league_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/league_name"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_level_status_imagines"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/gray"
        android:ellipsize="end"
        android:id="@+id/league_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/league_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/league_icon"
        app:layout_constraintTop_toTopOf="@+id/league_icon"
        app:layout_constraintWidth_max="150dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/matchInfo"
        android:background="@drawable/challenge_dialog_match_info_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="5dp"
        android:baselineAligned="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/league_icon">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <ImageView
                android:id="@+id/firstTeamIcon"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:src="@mipmap/bowls"
                style="@style/TeamLogoItem"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="12sp"
                android:ellipsize="end"
                android:id="@+id/firstTeamName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="Team 1"
                android:maxLines="2"
                android:layout_weight="0.1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="86dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:baselineAligned="false">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/matchDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="227/13     -     241/35"
                    android:maxLines="3"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/matchTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:maxLines="1"
                    android:layout_weight="1"
                    app:autoSizeMinTextSize="4sp"
                    app:autoSizeTextType="uniform"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="12sp"
                android:ellipsize="end"
                android:gravity="right"
                android:id="@+id/secondTeamName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="Team 2"
                android:maxLines="2"
                android:layout_weight="0.1"/>
            <ImageView
                android:id="@+id/secondTeamIcon"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:src="@mipmap/bowls"
                style="@style/TeamLogoItem"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/firstPlayerBetContainer"
        android:background="@drawable/challenge_bet_background"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/matchInfo">
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/avatarIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/challenge_me_player_icon"
            android:scaleType="fitXY"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_border_color="@color/magentaCyanBlack"
            app:riv_border_width="1dp"
            app:riv_corner_radius="30dp"
            app:riv_mutate_background="true"
            app:riv_oval="true"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/select_my_bet"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/secondPlayerBetContainer">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:background="@drawable/green_challenge_button"
                android:paddingBottom="4dp"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/select_your_bet"
                android:shadowColor="@color/black"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginEnd="8dp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeTextType="uniform"/>
        </org.betup.ui.views.AlphaPressButton>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/firstBetDetailsContainer"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="#e9a10a"
                android:id="@+id/firstBetPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/firstBetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/firstBetCoefficient"
            android:background="@drawable/challenge_bet_coefficient_container"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/vs_divider"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/vs_icon"
        app:layout_constraintBottom_toTopOf="@+id/secondPlayerBetContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/firstPlayerBetContainer"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/secondPlayerBetContainer"
        android:background="@drawable/challenge_bet_background"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vs_divider">
        <FrameLayout
            android:id="@+id/secondAvatarIconContainer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/secondAvatarIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/challenge_me_player_icon"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:riv_border_color="@color/magentaCyanBlack"
                app:riv_border_width="1dp"
                app:riv_corner_radius="30dp"
                app:riv_mutate_background="true"
                app:riv_oval="true"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/secondUserCountry"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
        </FrameLayout>
        <TextView
            android:textColor="@color/grayLight"
            android:gravity="center"
            android:id="@+id/no_opponent_label"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_opponent"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/secondBetDetailsContainer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="#e9a10a"
                android:id="@+id/secondBetPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/secondBetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/secondBetCoefficient"
            android:background="@drawable/challenge_bet_coefficient_container"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/nobody_joined_yet"
        android:shadowColor="@color/black"
        android:shadowDy="2"
        android:shadowRadius="3"
        app:layout_constraintEnd_toEndOf="@+id/firstPlayerBetContainer"
        app:layout_constraintStart_toStartOf="@+id/firstPlayerBetContainer"
        app:layout_constraintTop_toBottomOf="@+id/secondPlayerBetContainer"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/prizeContainer"
        android:background="@drawable/challenge_dialog_prize_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statusText">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/prizeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/prizeContainerInfo"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/betcoin"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:id="@+id/prize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/action_button_background"
        android:background="@drawable/green_challenge_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_button"
        app:layout_constraintEnd_toEndOf="@+id/action_button"
        app:layout_constraintStart_toStartOf="@+id/action_button"
        app:layout_constraintTop_toTopOf="@+id/action_button"/>
    <org.betup.ui.views.AlphaPressButton
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prizeContainer">
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/actionTitle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginBottom="8dp"
            android:minWidth="64dp"
            android:text="@string/join_battle"
            android:maxLines="1"
            android:shadowColor="@color/black"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/actionPriceContainer"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/betcoin"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:id="@+id/actionPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </org.betup.ui.views.AlphaPressButton>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
