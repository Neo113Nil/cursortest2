<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/background_coins"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/black_transparent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:background="@drawable/dialog_shop_shape"
        android:paddingBottom="16dp"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/firstItem"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:padding="4dp"
            android:layout_width="320dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/betcoinsContainer">
            <org.betup.ui.views.GradientTextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/each_day"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/subscription_bonus_icon_size"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"/>
            <TextView
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_betting_tips"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <ImageView
            android:layout_width="@dimen/subscription_bonus_icon_size"
            android:layout_height="@dimen/subscription_bonus_icon_size"
            android:src="@drawable/subscribe_card_1"
            app:layout_constraintBottom_toBottomOf="@+id/firstItem"
            app:layout_constraintStart_toStartOf="@+id/firstItem"
            app:layout_constraintTop_toTopOf="@+id/firstItem"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/secondItem"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:padding="4dp"
            android:layout_width="320dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/firstItem">
            <org.betup.ui.views.GradientTextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/subscription_bonus_icon_size"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"/>
            <TextView
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bet_types_unlocked"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <ImageView
            android:layout_width="@dimen/subscription_bonus_icon_size"
            android:layout_height="@dimen/subscription_bonus_icon_size"
            android:src="@drawable/subscribe_card_2"
            app:layout_constraintBottom_toBottomOf="@+id/secondItem"
            app:layout_constraintStart_toStartOf="@+id/secondItem"
            app:layout_constraintTop_toTopOf="@+id/secondItem"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/thirdItem"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:padding="4dp"
            android:layout_width="320dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/secondItem">
            <org.betup.ui.views.GradientTextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_limit"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/subscription_bonus_icon_size"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"/>
            <TextView
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/on_bet_placement"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <ImageView
            android:layout_width="@dimen/subscription_bonus_icon_size"
            android:layout_height="@dimen/subscription_bonus_icon_size"
            android:src="@drawable/subscribe_card_3"
            app:layout_constraintBottom_toBottomOf="@+id/thirdItem"
            app:layout_constraintStart_toStartOf="@+id/thirdItem"
            app:layout_constraintTop_toTopOf="@+id/thirdItem"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/fourthItem"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:padding="4dp"
            android:layout_width="320dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/thirdItem">
            <org.betup.ui.views.GradientTextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_ads"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/subscription_bonus_icon_size"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"/>
        </LinearLayout>
        <ImageView
            android:layout_width="@dimen/subscription_bonus_icon_size"
            android:layout_height="@dimen/subscription_bonus_icon_size"
            android:src="@drawable/subscribe_card_5"
            app:layout_constraintBottom_toBottomOf="@+id/fourthItem"
            app:layout_constraintStart_toStartOf="@+id/fourthItem"
            app:layout_constraintTop_toTopOf="@+id/fourthItem"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/fifthItem"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:padding="4dp"
            android:layout_width="320dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fourthItem">
            <org.betup.ui.views.GradientTextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/free"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/subscription_bonus_icon_size"
                app:centerColor="@color/white"
                app:mainColor="@color/colorAccent"/>
            <TextView
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/three_days_cancel"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <ImageView
            android:layout_width="@dimen/subscription_bonus_icon_size"
            android:layout_height="@dimen/subscription_bonus_icon_size"
            android:src="@drawable/subscribe_card_4"
            app:layout_constraintBottom_toBottomOf="@+id/fifthItem"
            app:layout_constraintStart_toStartOf="@+id/fifthItem"
            app:layout_constraintTop_toTopOf="@+id/fifthItem"/>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/access_label"
            android:paddingTop="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:text="@string/get_access"
            android:paddingStart="24dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/betcoinsContainer"
            android:background="@drawable/betcoin_pack_preview_shape"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/access_label">
            <org.betup.ui.views.GradientTextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tickets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/become_premium"
                app:centerColor="@color/colorAccent"
                app:mainColor="@color/colorAccent"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
        </LinearLayout>
        <org.betup.ui.views.GradientTextView
            android:textSize="18sp"
            android:id="@+id/or_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/or"
            android:textAllCaps="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/month"
            app:layout_constraintEnd_toStartOf="@+id/month"
            app:layout_constraintStart_toEndOf="@+id/week"
            app:layout_constraintTop_toTopOf="@+id/week"
            app:outlineColor="@color/Black"
            app:outlineWidth="1dp"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/week"
            android:background="@drawable/ok_button"
            android:layout_width="128dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fifthItem">
            <org.betup.ui.views.GradientTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:id="@+id/priceWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.99$/week"
                app:centerColor="@color/white"
                app:mainColor="@color/white"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
        </org.betup.ui.views.AlphaPressButton>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/month"
            android:background="@drawable/buy_button"
            android:layout_width="128dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fifthItem">
            <org.betup.ui.views.GradientTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:id="@+id/priceMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.99$/month"
                android:layout_marginStart="16dp"
                app:centerColor="@color/white"
                app:mainColor="@color/white"
                app:outlineColor="@color/Black"
                app:outlineWidth="1dp"/>
        </org.betup.ui.views.AlphaPressButton>
        <View
            android:background="@drawable/off_60"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            app:layout_constraintBottom_toBottomOf="@+id/month"
            app:layout_constraintEnd_toStartOf="@+id/month"
            app:layout_constraintStart_toStartOf="@+id/month"
            app:layout_constraintTop_toTopOf="@+id/month"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialog_container">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="400dp"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="false"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/offer_header"/>
        <org.betup.ui.controls.ArcTextView
            android:id="@+id/label"
            android:layout_width="300dp"
            android:layout_height="72dp"
            android:layout_marginBottom="40dp"
            android:src="@drawable/shop_label"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shadowEnabled="true"
            app:text="@string/vip_arena"
            app:textColor="@color/colorAccent"
            app:textSize="@dimen/font_size_maximum"/>
        <org.betup.ui.views.AlphaPressButton
            android:id="@+id/close"
            android:background="@drawable/dialog_close_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
