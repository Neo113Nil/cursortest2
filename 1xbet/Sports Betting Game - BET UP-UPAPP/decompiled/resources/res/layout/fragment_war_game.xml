<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragmentWarGame"
    android:background="@drawable/war_game_scene_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/schene"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/divide_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:src="@drawable/war_game_schene_background"
            android:scaleType="fitEnd"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/leftCardBound"
            android:background="@drawable/game_card_round_border"
            android:layout_width="94dp"
            android:layout_height="138dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toStartOf="@+id/rightCardBound"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/betupLabel"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/opponent"
            app:layout_constraintEnd_toEndOf="@+id/leftCardBound"
            app:layout_constraintStart_toStartOf="@+id/leftCardBound"
            app:layout_constraintTop_toBottomOf="@+id/leftCardBound"/>
        <View
            android:id="@+id/leftCardBack"
            android:background="@drawable/card_view_back_background"
            android:visibility="invisible"
            android:layout_width="94dp"
            android:layout_height="138dp"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/leftCardBound"/>
        <org.betup.ui.views.GameCardView
            android:id="@+id/leftCard"
            android:visibility="invisible"
            android:layout_width="94dp"
            android:layout_height="138dp"
            android:elevation="4dp"
            app:layout_constraintStart_toStartOf="@+id/leftCardBound"
            app:layout_constraintTop_toTopOf="@+id/leftCardBound"/>
        <View
            android:id="@+id/rightCardBound"
            android:background="@drawable/game_card_round_border"
            android:layout_width="94dp"
            android:layout_height="138dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/leftCardBound"
            app:layout_constraintTop_toBottomOf="@+id/betupLabel"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/player"
            app:layout_constraintEnd_toEndOf="@+id/rightCardBound"
            app:layout_constraintStart_toStartOf="@+id/rightCardBound"
            app:layout_constraintTop_toBottomOf="@+id/rightCardBound"/>
        <View
            android:id="@+id/rightCardBack"
            android:background="@drawable/card_view_back_background"
            android:visibility="invisible"
            android:layout_width="94dp"
            android:layout_height="138dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rightCardBound"/>
        <org.betup.ui.views.GameCardView
            android:id="@+id/rightCard"
            android:visibility="invisible"
            android:layout_width="94dp"
            android:layout_height="138dp"
            android:elevation="4dp"
            app:layout_constraintStart_toStartOf="@+id/rightCardBound"
            app:layout_constraintTop_toTopOf="@+id/rightCardBound"/>
        <org.betup.ui.views.BetUpLabelView
            android:id="@+id/betupLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:labelBackground="GREEN"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:starBackground="GREEN"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/divide_line"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/containerMakeCustomBet"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/containerDialogResult"
        android:background="@drawable/war_game_won_background"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:visibility="invisible"
        android:clickable="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/arc">
        <include
            android:id="@+id/containerResultGames"
            layout="@layout/container_result_games"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/resultScore"
            android:focusable="false"
            android:visibility="invisible"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/your_score"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/okButton"
            android:background="@drawable/mini_games_make_bet"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:minHeight="40dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp">
            <TextView
                android:textSize="12sp"
                android:layout_gravity="center"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ok"
                android:textAllCaps="true"
                android:paddingVertical="4dp"/>
        </org.betup.ui.views.AlphaPressButton>
    </LinearLayout>
    <View
        android:id="@+id/stub"
        android:focusable="true"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/arc"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerMakeCustomBet"
        android:background="@drawable/war_game_footer_background"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/buttonMin"
            android:background="@drawable/mini_games_blue_button"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/textWin"
            app:layout_constraintEnd_toStartOf="@+id/buttonDouble"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="12sp"
                android:paddingTop="3dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mini_games_bettype_min"/>
        </org.betup.ui.views.AlphaPressButton>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/buttonDouble"
            android:background="@drawable/mini_games_blue_button"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/textWin"
            app:layout_constraintEnd_toStartOf="@+id/buttonHalf"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/buttonMin">
            <TextView
                android:textSize="12sp"
                android:paddingTop="3dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mini_games_bettype_double"/>
        </org.betup.ui.views.AlphaPressButton>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/buttonHalf"
            android:background="@drawable/mini_games_blue_button"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/textWin"
            app:layout_constraintEnd_toStartOf="@+id/buttonMax"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/buttonDouble">
            <TextView
                android:textSize="12sp"
                android:paddingTop="3dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mini_games_bettype_half"/>
        </org.betup.ui.views.AlphaPressButton>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/buttonMax"
            android:background="@drawable/mini_games_blue_button"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/textWin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/buttonHalf">
            <TextView
                android:textSize="12sp"
                android:gravity="center"
                android:paddingTop="3dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mini_games_bettype_max"/>
        </org.betup.ui.views.AlphaPressButton>
        <TextView
            android:textSize="16sp"
            android:id="@+id/textWin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/win"
            android:alpha="1"
            android:textAllCaps="true"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/textDraw"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/textDraw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:text="@string/match_details_x"
            android:alpha="0.4"
            android:textAllCaps="true"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/makeBetButton"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/labelsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="textWin,textDraw"/>
        <EditText
            android:textSize="14sp"
            android:id="@+id/editWinBet"
            android:background="@drawable/war_game_edit_bet_background"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/enter_stake_amount"
            android:inputType="number"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/textWin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/labelsBarrier"
            app:layout_constraintTop_toTopOf="@+id/textWin"/>
        <EditText
            android:textSize="14sp"
            android:id="@+id/editDrawBet"
            android:background="@drawable/war_game_edit_bet_background"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/enter_stake_amount"
            android:inputType="number"
            android:alpha="0.4"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/labelsBarrier"
            app:layout_constraintTop_toTopOf="@+id/textDraw"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/makeBetButton"
            android:background="@drawable/mini_games_make_bet"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:minHeight="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="12sp"
                android:layout_gravity="center"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/betslip_place_bet"
                android:paddingVertical="4dp"/>
        </org.betup.ui.views.AlphaPressButton>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/containerDrawResult"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/buttonWar"
            android:background="@drawable/mini_games_blue_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:textSize="19sp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/war"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/buttonGiveUp"
            android:background="@drawable/mini_games_blue_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:textSize="19sp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/give_up"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/progress"
        android:background="@drawable/war_game_footer_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/containerMakeCustomBet">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/progressBarStyle"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/arc"
        android:background="@drawable/brown_arc"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/divide_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
