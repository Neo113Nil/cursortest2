<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/dialog_shape"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="16dp"
            android:text="@string/daily_store_bonus"
            android:textAllCaps="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/balanceContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/betcoin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/betcoin"
                android:layout_marginStart="8dp"/>
            <org.betup.ui.views.GradientTextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:id="@+id/balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                custom:centerColor="@color/goldenLight"
                custom:layout_constraintHorizontal_bias="0.5"
                custom:layout_constraintStart_toEndOf="@+id/betcoin"
                custom:mainColor="@color/colorAccent"
                custom:outlineColor="@color/Black"
                custom:outlineWidth="1dp"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="4dp"
            android:text="FIRST ATTEMPT"
            android:textAllCaps="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/getDouble"
            android:background="@drawable/dialog_dark_blue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                custom:srcCompat="@drawable/betcoin"/>
            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_double_bonus"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                custom:srcCompat="@drawable/play_video"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/ok"
            android:background="@drawable/dialog_ok_selector"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="20dp"
            android:text="@string/ok"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/multiplyBonus"
            android:background="@drawable/ok_button"
            android:visibility="gone"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            custom:layout_constraintHorizontal_chainStyle="packed">
            <androidx.appcompat.widget.AppCompatTextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/multiplyBonusTitle"
                android:visibility="gone"
                android:layout_width="120dp"
                android:layout_height="24dp"
                android:text="Get x3 bonus"
                android:maxLines="1"
                android:shadowColor="@color/black"
                android:shadowRadius="3"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                custom:autoSizeMaxTextSize="24sp"
                custom:autoSizeTextType="uniform"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/multiplyBetcoinsBonus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/black"
                    android:shadowRadius="1.5"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/betcoin"/>
            </LinearLayout>
        </org.betup.ui.views.AlphaPressButton>
    </LinearLayout>
</RelativeLayout>
