<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/default_button_secondary"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/default_gap"
    android:layout_marginEnd="@dimen/default_gap"
    app:layout_constraintDimensionRatio="1:1">
    <ImageView
        android:id="@+id/icon_iv"
        android:layout_width="94dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_minigames"
        android:layout_marginVertical="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/active_text"
        android:gravity="center"
        android:id="@+id/btn_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/battles"
        android:maxLines="2"
        android:breakStrategy="high_quality"
        android:hyphenationFrequency="fullFast"
        app:layout_constraintBottom_toBottomOf="@+id/icon_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
