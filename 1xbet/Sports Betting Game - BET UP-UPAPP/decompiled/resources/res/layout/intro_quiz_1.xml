<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/intro_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/icon"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="20sp"
            android:id="@+id/introducing_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/introducing"
            android:fontFamily="@font/montserrat_extra_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:textColor="@color/Yellow"
            android:gravity="center"
            android:id="@+id/bet_quiz_header_tv"
            android:background="@drawable/header_intro1"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="@string/bet_quiz"
            android:shadowColor="@color/Black"
            android:shadowDx="0"
            android:shadowRadius="4"
            android:fontFamily="@font/montserrat_extra_bold"
            android:textAlignment="center"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/introducing_tv"/>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:id="@+id/top_description_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="68dp"
            android:text="@string/quiz_intro_1_top_description"
            android:lineSpacingExtra="8sp"
            android:fontFamily="@font/montserrat_extra_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bet_quiz_header_tv"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/quiz_container_cl"
            android:background="@drawable/quiz_intro_1_background_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:translationZ="20dp"
            android:elevation="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="40dp"
            android:paddingVertical="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_description_tv">
            <TextView
                android:textSize="@dimen/font_size_medium"
                android:textColor="#fff000"
                android:id="@+id/intro_quiz_1_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quiz_intro_1_title"
                android:shadowColor="#000000"
                android:shadowDy="5"
                android:shadowRadius="2"
                android:fontFamily="@font/montserrat_extra_bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/flexbox_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:alignItems="center"
                app:justifyContent="space_around"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/intro_quiz_1_title_tv">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/quiz_option_container_cl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/quiz_option_cl"
                        android:background="@drawable/bet_button_unchecked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="100dp"
                        android:minHeight="40dp"
                        android:translationZ="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="@dimen/font_size_small_10"
                            android:gravity="center"
                            android:id="@+id/quiz_option_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="@string/yes"
                            android:shadowColor="#000000"
                            android:shadowDy="5"
                            android:shadowRadius="2"
                            android:fontFamily="@font/montserrat_extra_bold"
                            android:paddingHorizontal="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/font_size_small_10"
                        android:gravity="center"
                        android:id="@+id/quiz_option_coefficient_tv"
                        android:background="#7b7b7b"
                        android:paddingTop="2dp"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-5dp"
                        android:text="4.5"
                        android:shadowColor="#000000"
                        android:shadowDy="5"
                        android:shadowRadius="2"
                        android:fontFamily="@font/montserrat_extra_bold"
                        android:paddingHorizontal="15dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/quiz_option_cl"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/quiz_option_second_container_cl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/quiz_option_second_cl"
                        android:background="@drawable/bet_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="100dp"
                        android:minHeight="40dp"
                        android:translationZ="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="@dimen/font_size_small_10"
                            android:gravity="center"
                            android:id="@+id/quiz_option_second_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="@string/no"
                            android:shadowColor="#000000"
                            android:shadowDy="5"
                            android:shadowRadius="2"
                            android:fontFamily="@font/montserrat_extra_bold"
                            android:paddingHorizontal="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/font_size_small_10"
                        android:gravity="center"
                        android:id="@+id/quiz_option_second_coefficient_tv"
                        android:background="@color/quiz_option_button_active_color"
                        android:paddingTop="2dp"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-5dp"
                        android:text="4.5"
                        android:shadowColor="#000000"
                        android:shadowDy="5"
                        android:shadowRadius="2"
                        android:fontFamily="@font/montserrat_extra_bold"
                        android:paddingHorizontal="15dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/quiz_option_second_cl"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.flexbox.FlexboxLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/font_size_big"
            android:id="@+id/bottom_description_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/quiz_intro_1_bottom_description"
            android:lineSpacingExtra="8sp"
            android:fontFamily="@font/montserrat_extra_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quiz_container_cl"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
