<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/stats"
        android:background="@drawable/home_stats_background"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:id="@+id/daily_bonus"
            android:background="@drawable/daily_bonus_home"
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/won_icon"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/font_size_small_10"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bonus"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
        <ImageView
            android:id="@+id/won_icon"
            android:layout_width="@dimen/home_stat_icon_size"
            android:layout_height="@dimen/home_stat_icon_size"
            android:layout_marginTop="4dp"
            android:src="@drawable/won_home"
            app:layout_constraintEnd_toStartOf="@+id/lost_icon"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/daily_bonus"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/won_label"
            app:layout_constraintEnd_toEndOf="@+id/won_icon"
            app:layout_constraintStart_toStartOf="@+id/won_icon"
            app:layout_constraintTop_toBottomOf="@+id/won_icon"
            style="@style/HomeStatsLabel"/>
        <ImageView
            android:id="@+id/lost_icon"
            android:layout_width="@dimen/home_stat_icon_size"
            android:layout_height="@dimen/home_stat_icon_size"
            android:layout_marginTop="4dp"
            android:src="@drawable/lost_home"
            app:layout_constraintEnd_toStartOf="@+id/in_play_icon"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/won_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/lost_label"
            app:layout_constraintEnd_toEndOf="@+id/lost_icon"
            app:layout_constraintStart_toStartOf="@+id/lost_icon"
            app:layout_constraintTop_toBottomOf="@+id/lost_icon"
            style="@style/HomeStatsLabel"/>
        <ImageView
            android:id="@+id/in_play_icon"
            android:layout_width="@dimen/home_stat_icon_size"
            android:layout_height="@dimen/home_stat_icon_size"
            android:layout_marginTop="4dp"
            android:src="@drawable/pending_home"
            app:layout_constraintEnd_toStartOf="@+id/rank_icon"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/lost_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/pending_label"
            app:layout_constraintEnd_toEndOf="@+id/in_play_icon"
            app:layout_constraintStart_toStartOf="@+id/in_play_icon"
            app:layout_constraintTop_toBottomOf="@+id/in_play_icon"
            style="@style/HomeStatsLabel"/>
        <ImageView
            android:id="@+id/rank_icon"
            android:layout_width="@dimen/home_stat_icon_size"
            android:layout_height="@dimen/home_stat_icon_size"
            android:layout_marginTop="4dp"
            android:src="@drawable/rank_home"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/in_play_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/rank_label"
            app:layout_constraintEnd_toEndOf="@+id/rank_icon"
            app:layout_constraintStart_toStartOf="@+id/rank_icon"
            app:layout_constraintTop_toBottomOf="@+id/rank_icon"
            style="@style/HomeStatsLabel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/avatar"
        android:background="@drawable/avatar_frame"
        android:paddingTop="3dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/user_round_avatar"
        android:adjustViewBounds="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stats"
        app:riv_oval="true"/>
    <TextView
        android:textSize="@dimen/font_size_medium"
        android:textColor="@color/white"
        android:id="@+id/username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="@color/black"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="2"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="@+id/avatar"
        app:layout_constraintTop_toBottomOf="@+id/avatar"/>
    <org.betup.ui.controls.RoiView
        android:id="@+id/roi"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        app:layout_constraintEnd_toEndOf="@+id/username"
        app:layout_constraintStart_toStartOf="@+id/username"
        app:layout_constraintTop_toBottomOf="@+id/username"/>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/tvbet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar">
        <ImageView
            android:layout_width="128dp"
            android:layout_height="81dp"
            android:src="@drawable/tvbet_games_home"
            android:scaleType="fitXY"/>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/mini_games"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar">
        <ImageView
            android:layout_width="128dp"
            android:layout_height="81dp"
            android:src="@drawable/mini_games_home"
            android:scaleType="fitXY"/>
    </org.betup.ui.views.AlphaPressButton>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/tasks"
        android:background="@drawable/home_stats_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/competitions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/roi"
        app:layout_constraintVertical_bias="0">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tasksList"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/mission_ok"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <org.betup.ui.views.AlphaPressButton
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/mission_ok"
            android:background="@drawable/ok_button"
            android:layout_width="100dp"
            android:layout_height="24dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tasksList"
            app:layout_constraintStart_toStartOf="@+id/tasksList">
            <TextView
                android:textSize="@dimen/font_size_small_10"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/missionActionTitle"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="@string/missions_claim"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:textAllCaps="true"/>
        </org.betup.ui.views.AlphaPressButton>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/one_time_offer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tasks"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tasks">
        <FrameLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="end|top"
                android:id="@+id/offerIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/offer_home"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/offersAmount"
                android:background="@drawable/red_circle_shape"
                android:layout_width="17dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="3dp"/>
        </FrameLayout>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/video_offer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tasks"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tasks">
        <ImageView
            android:id="@+id/videoIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/video_reward_icon"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/video_bonus_amount_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/videoRewardAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/betcoin"/>
        </LinearLayout>
    </org.betup.ui.views.AlphaPressButton>
    <ProgressBar
        android:id="@+id/taskProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tasks"
        app:layout_constraintEnd_toEndOf="@+id/tasks"
        app:layout_constraintStart_toStartOf="@+id/tasks"
        app:layout_constraintTop_toTopOf="@+id/tasks"/>
    <ImageView
        android:id="@+id/missionsHeader"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:src="@drawable/missions_header"
        app:layout_constraintBottom_toTopOf="@+id/tasks"
        app:layout_constraintEnd_toEndOf="@+id/tasks"
        app:layout_constraintStart_toStartOf="@+id/tasks"
        app:layout_constraintTop_toTopOf="@+id/tasks"/>
    <org.betup.ui.controls.ArcTextView
        android:id="@+id/missionLabel"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/missionsHeader"
        app:layout_constraintEnd_toEndOf="@+id/missionsHeader"
        app:layout_constraintStart_toStartOf="@+id/missionsHeader"
        app:layout_constraintTop_toTopOf="@+id/missionsHeader"
        app:text="MISSION 7"
        app:textColor="@color/white"
        app:textSize="@dimen/font_size_medium"/>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/leaderboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/home_bottom_button_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/challenges"
        app:layout_constraintStart_toStartOf="parent">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_bottom_button_height">
            <View
                android:background="@drawable/home_bottom_button"
                android:layout_width="81dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/home_bottom_button_marginTop"/>
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/new_menu_leaderboard_active"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/font_size_tiny"
                android:textStyle="bold"
                android:visibility="@integer/home_bottom_button_show_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/leaderboard_title"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/challenges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/home_bottom_button_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/competitions"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/leaderboard">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_bottom_big_button_height">
            <View
                android:background="@drawable/home_bottom_button"
                android:layout_width="81dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/home_bottom_big_button_marginTop"/>
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/new_menu_challenges_active"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/font_size_tiny"
                android:textStyle="bold"
                android:visibility="@integer/home_bottom_button_show_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/battles"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:textAllCaps="true"/>
        </RelativeLayout>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/competitions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/home_bottom_button_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/notifications"
        app:layout_constraintStart_toEndOf="@+id/challenges">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_bottom_big_button_height">
            <View
                android:background="@drawable/home_bottom_button"
                android:layout_width="81dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/home_bottom_big_button_marginTop"/>
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/new_menu_competitions_active"
                android:scaleX="-1"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="@dimen/font_size_tiny"
                android:textStyle="bold"
                android:visibility="@integer/home_bottom_button_show_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/drawer_competitions"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:textAllCaps="true"/>
        </RelativeLayout>
    </org.betup.ui.views.AlphaPressButton>
    <org.betup.ui.views.AlphaPressButton
        android:id="@+id/notifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="@dimen/home_bottom_button_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/competitions">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_bottom_button_height">
            <View
                android:background="@drawable/home_bottom_button"
                android:layout_width="81dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/home_bottom_button_marginTop"/>
            <ImageView
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:src="@drawable/notifications_new_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/font_size_tiny"
                android:textStyle="bold"
                android:visibility="@integer/home_bottom_button_show_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/notifications_title"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:textAllCaps="true"/>
        </RelativeLayout>
    </org.betup.ui.views.AlphaPressButton>
</androidx.constraintlayout.widget.ConstraintLayout>
