<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dark_challenge_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/userIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/user_round_avatar"
        android:scaleType="fitXY"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_border_color="@color/magentaCyanBlack"
        app:riv_border_width="0dp"
        app:riv_mutate_background="true"
        app:riv_oval="true"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="TextView"
        app:layout_constraintBottom_toBottomOf="@+id/userIcon"
        app:layout_constraintStart_toStartOf="@+id/betName"
        app:layout_constraintTop_toTopOf="@+id/userIcon"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/Black"
        android:gravity="center"
        android:id="@+id/repeat"
        android:background="@drawable/accept_button_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="64dp"
        android:text="@string/repeat"
        android:textAllCaps="true"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="15.06"
        app:layout_constraintStart_toStartOf="@+id/userIcon"
        app:layout_constraintTop_toBottomOf="@+id/userIcon"/>
    <TextView
        android:textColor="@color/Gray"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="17:45"
        app:layout_constraintStart_toStartOf="@+id/userIcon"
        app:layout_constraintTop_toBottomOf="@+id/date"/>
    <TextView
        android:textStyle="bold"
        android:ellipsize="end"
        android:id="@+id/betName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:alpha="1"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/time"
        app:layout_constraintEnd_toStartOf="@+id/odd"
        app:layout_constraintStart_toEndOf="@+id/time"
        app:layout_constraintTop_toTopOf="@+id/date"/>
    <TextView
        android:id="@+id/textView15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/period"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/time"
        app:layout_constraintTop_toBottomOf="@+id/time"/>
    <TextView
        android:textColor="@color/colorAccent"
        android:ellipsize="end"
        android:id="@+id/period"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/hidden"
        android:maxLines="1"
        android:textAllCaps="true"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/textView15"
        app:layout_constraintEnd_toStartOf="@+id/textView28"
        app:layout_constraintStart_toStartOf="@+id/betName"
        app:layout_constraintTop_toTopOf="@+id/textView15"/>
    <TextView
        android:id="@+id/textView28"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/amount"
        android:textAllCaps="true"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView18"
        app:layout_constraintEnd_toStartOf="@+id/imageView18"
        app:layout_constraintTop_toTopOf="@+id/imageView18"/>
    <ImageView
        android:id="@+id/imageView18"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/amount"
        app:layout_constraintEnd_toStartOf="@+id/amount"
        app:layout_constraintTop_toTopOf="@+id/amount"
        app:srcCompat="@drawable/betcoin"/>
    <TextView
        android:textColor="@color/colorAccent"
        android:id="@+id/amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/odd"
        android:background="@drawable/my_bet_odd_shape"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:text="99.99"
        app:layout_constraintBottom_toBottomOf="@+id/betName"
        app:layout_constraintEnd_toEndOf="@+id/repeat"
        app:layout_constraintTop_toTopOf="@+id/betName"/>
</androidx.constraintlayout.widget.ConstraintLayout>
