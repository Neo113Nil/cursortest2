<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/colorAccent"/>
            <padding
                android:left="5dp"
                android:top="6dp"
                android:right="5dp"
                android:bottom="6dp"/>
            <corners
                android:topLeftRadius="3dp"
                android:topRightRadius="3dp"
                android:bottomLeftRadius="3dp"
                android:bottomRightRadius="3dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/colorAccent"/>
            <padding
                android:left="5dp"
                android:top="6dp"
                android:right="5dp"
                android:bottom="6dp"/>
            <corners
                android:topLeftRadius="3dp"
                android:topRightRadius="3dp"
                android:bottomLeftRadius="3dp"
                android:bottomRightRadius="3dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/colorAccent"/>
            <padding
                android:left="5dp"
                android:top="6dp"
                android:right="5dp"
                android:bottom="6dp"/>
            <corners
                android:topLeftRadius="3dp"
                android:topRightRadius="3dp"
                android:bottomLeftRadius="3dp"
                android:bottomRightRadius="3dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/facebook_blue"/>
            <padding
                android:left="5dp"
                android:top="6dp"
                android:right="5dp"
                android:bottom="6dp"/>
            <corners
                android:topLeftRadius="3dp"
                android:topRightRadius="3dp"
                android:bottomLeftRadius="3dp"
                android:bottomRightRadius="3dp"/>
        </shape>
    </item>
</selector>
