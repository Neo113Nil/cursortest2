<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_pressed="true"
        android:drawable="@color/blackCyan_selected"/>
    <item android:state_pressed="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#303c60"
                        android:endColor="#303c60"
                        android:angle="0"
                        android:centerColor="#384d76"/>
                </shape>
            </item>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/Black"/>
                </shape>
            </item>
            <item
                android:top="4dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#161c26"
                        android:endColor="#161c26"
                        android:angle="0"
                        android:centerColor="#1d273d"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
