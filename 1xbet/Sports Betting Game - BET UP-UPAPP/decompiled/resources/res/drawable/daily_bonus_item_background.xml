<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#000000"/>
                    <corners android:radius="5dp"/>
                </shape>
            </item>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#212c47"
                        android:endColor="#171c26"
                        android:angle="0"
                        android:type="radial"
                        android:gradientRadius="200dp"/>
                    <corners android:radius="5dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#4697ff"
                        android:endColor="#272547"
                        android:angle="0"
                        android:type="radial"
                        android:gradientRadius="250dp"/>
                    <corners android:radius="5dp"/>
                </shape>
            </item>
            <item android:drawable="@drawable/item_rays"/>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="@color/white"/>
                    <corners android:radius="5dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
