<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <solid android:color="#485fbe"/>
        </shape>
    </item>
    <item android:top="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <solid android:color="#1c2773"/>
        </shape>
    </item>
    <item
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <gradient
                android:startColor="#3548bb"
                android:endColor="#1d2c53"
                android:angle="0"/>
        </shape>
    </item>
</layer-list>
