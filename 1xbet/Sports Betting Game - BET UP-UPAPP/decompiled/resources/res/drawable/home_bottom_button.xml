<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#376797"
                android:endColor="#232141"
                android:angle="270"
                android:type="linear"
                android:gradientRadius="100dp"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#212c47"
                android:endColor="#171c26"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="200dp"/>
            <corners
                android:topLeftRadius="5dp"
                android:topRightRadius="5dp"/>
        </shape>
    </item>
</layer-list>
