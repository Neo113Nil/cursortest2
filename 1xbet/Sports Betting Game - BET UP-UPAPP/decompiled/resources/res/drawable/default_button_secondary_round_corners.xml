<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/gradient_secondary_stroke"
                android:endColor="@color/gradient_primary_stroke"
                android:angle="90"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/gradient_dark_secondary_btn_bg"
                android:endColor="@color/gradient_dark_primary_btn_bg"
                android:angle="270"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</layer-list>
