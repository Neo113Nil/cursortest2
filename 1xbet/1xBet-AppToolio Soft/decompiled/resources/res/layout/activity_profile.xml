<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="20dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/man"/>
        <Button
            android:textSize="30sp"
            android:textStyle="bold"
            android:id="@+id/scoreWalletID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score:"
            android:textAlignment="center"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:id="@+id/firstname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Here Name:"
                android:layout_weight="0.5"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:id="@+id/lastname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Here Phone:"
                android:layout_weight="0.5"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Here Eamil:"
                android:layout_weight="0.5"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:id="@+id/phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Here Points:"
                android:layout_weight="0.5"/>
        </LinearLayout>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Here Points:"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:id="@+id/dogeearn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Here Points:"/>
        <Button
            android:textSize="25sp"
            android:textStyle="bold"
            android:id="@+id/referemail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Here Points:"
            android:textAllCaps="false"/>
        <Button
            android:textSize="25sp"
            android:textStyle="bold"
            android:id="@+id/invalidclick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Invalid Click"
            android:textAllCaps="false"/>
        <com.google.android.gms.ads.AdView
            android:layout_gravity="center"
            android:id="@+id/adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:adSize="MEDIUM_RECTANGLE"
            app:adUnitId="ca-app-pub-3940256099942544/6300978111"/>
    </LinearLayout>
</ScrollView>
