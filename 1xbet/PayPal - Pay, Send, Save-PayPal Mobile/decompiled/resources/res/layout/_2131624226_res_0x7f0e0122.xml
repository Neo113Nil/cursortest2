<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    gravity="center_vertical"
    background="?android:attr/selectableItemBackground"
    paddingRight="?android:attr/scrollbarSize"
    layout_width="match_parent"
    layout_height="wrap_content"
    minHeight="?android:attr/listPreferredItemHeight"
    paddingEnd="?android:attr/scrollbarSize">
    <Spinner
        id="@+id/_2131428927_res_0x7f0b063f"
        visibility="invisible"
        layout_width="0dp"
        layout_height="wrap_content"
        layout_weight="0"/>
    <FrameLayout
        id="@+id/_2131428130_res_0x7f0b0322"
        layout_width="wrap_content"
        layout_height="wrap_content">
        <androidx.preference.internal.PreferenceImageView
            id="@android:id/icon"
            layout_width="wrap_content"
            layout_height="wrap_content"
            NOT_FOUND_0x1a="48dp"
            NOT_FOUND_0x1b="48dp"/>
    </FrameLayout>
    <RelativeLayout
        layout_width="0dp"
        layout_height="wrap_content"
        layout_marginLeft="15dp"
        layout_marginTop="6dp"
        layout_marginRight="6dp"
        layout_marginBottom="6dp"
        layout_weight="1"
        layout_marginStart="15dp"
        layout_marginEnd="6dp">
        <TextView
            textAppearance="?android:attr/textAppearanceLarge"
            textColor="?android:attr/textColorPrimary"
            ellipsize="marquee"
            id="@android:id/title"
            fadingEdge="horizontal"
            layout_width="wrap_content"
            layout_height="wrap_content"
            singleLine="true"/>
        <TextView
            textAppearance="?android:attr/textAppearanceSmall"
            textColor="?android:attr/textColorSecondary"
            id="@android:id/summary"
            layout_width="wrap_content"
            layout_height="wrap_content"
            maxLines="4"
            layout_below="@android:id/title"
            layout_alignLeft="@android:id/title"
            layout_alignStart="@android:id/title"/>
    </RelativeLayout>
    <LinearLayout
        gravity="center_vertical"
        orientation="vertical"
        id="@android:id/widget_frame"
        layout_width="wrap_content"
        layout_height="match_parent"/>
</LinearLayout>
