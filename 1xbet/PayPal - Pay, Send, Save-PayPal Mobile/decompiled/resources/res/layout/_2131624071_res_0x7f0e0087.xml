<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    background="#555"
    clickable="true"
    layout_width="match_parent"
    layout_height="match_parent">
    <LinearLayout
        layout_gravity="center"
        orientation="vertical"
        layout_width="wrap_content"
        layout_height="wrap_content">
        <ImageView
            layout_gravity="center"
            layout_width="wrap_content"
            layout_height="wrap_content"
            src="@drawable/_2131231478_res_0x7f0802f6"
            contentDescription="Camera permission is required."/>
        <TextView
            textSize="20sp"
            textColor="#80ffffff"
            gravity="center"
            layout_gravity="center"
            id="@+id/_2131427678_res_0x7f0b015e"
            layout_width="wrap_content"
            layout_height="wrap_content"
            layout_margin="20dp"
            text="Camera permission is required."
            drawablePadding="30dp"
            fontFamily="sans-serif-light"/>
        <Button
            layout_gravity="center"
            id="@+id/_2131427679_res_0x7f0b015f"
            layout_width="wrap_content"
            layout_height="wrap_content"
            text="Enable camera"/>
    </LinearLayout>
</FrameLayout>
