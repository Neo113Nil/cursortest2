<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    orientation="vertical"
    layout_width="match_parent"
    layout_height="match_parent">
    <FrameLayout
        id="@android:id/list_container"
        layout_width="match_parent"
        layout_height="0dp"
        layout_weight="1"/>
    <TextView
        gravity="center"
        id="@android:id/empty"
        padding="8dp"
        visibility="gone"
        layout_width="match_parent"
        layout_height="match_parent"/>
</LinearLayout>
