<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    gravity="center_vertical"
    paddingRight="?android:attr/scrollbarSize"
    clipChildren="false"
    clipToPadding="false"
    layout_width="match_parent"
    layout_height="wrap_content"
    minHeight="?android:attr/listPreferredItemHeight"
    paddingEnd="?android:attr/scrollbarSize">
    <ImageView
        layout_gravity="center"
        id="@android:id/icon"
        layout_width="wrap_content"
        layout_height="wrap_content"
        minWidth="0dp"/>
    <RelativeLayout
        clipChildren="false"
        clipToPadding="false"
        layout_width="0dp"
        layout_height="wrap_content"
        layout_marginLeft="16dp"
        layout_marginTop="6dp"
        layout_marginRight="8dp"
        layout_marginBottom="6dp"
        layout_weight="1"
        layout_marginStart="16dp"
        layout_marginEnd="8dp">
        <TextView
            textAppearance="?android:attr/textAppearanceMedium"
            ellipsize="marquee"
            id="@android:id/title"
            fadingEdge="horizontal"
            layout_width="wrap_content"
            layout_height="wrap_content"
            singleLine="true"/>
        <TextView
            textAppearance="?android:attr/textAppearanceSmall"
            textColor="?android:attr/textColorSecondary"
            id="@android:id/summary"
            layout_width="wrap_content"
            layout_height="wrap_content"
            maxLines="4"
            layout_below="@android:id/title"
            layout_alignLeft="@android:id/title"
            layout_alignStart="@android:id/title"/>
        <androidx.preference.UnPressableLinearLayout
            clipChildren="false"
            clipToPadding="false"
            layout_width="match_parent"
            layout_height="wrap_content"
            layout_below="@android:id/summary"
            layout_alignLeft="@android:id/title"
            layout_alignStart="@android:id/title">
            <SeekBar
                id="@+id/_2131428860_res_0x7f0b05fc"
                background="@null"
                paddingLeft="0dp"
                paddingRight="22dp"
                focusable="false"
                clickable="false"
                layout_width="0dp"
                layout_height="wrap_content"
                layout_weight="1"
                paddingStart="0dp"
                paddingEnd="22dp"/>
            <TextView
                textAppearance="?android:attr/textAppearanceMedium"
                ellipsize="marquee"
                gravity="center"
                id="@+id/_2131428861_res_0x7f0b05fd"
                fadingEdge="horizontal"
                layout_width="36dp"
                layout_height="match_parent"
                singleLine="true"
                fontFamily="sans-serif-condensed"/>
        </androidx.preference.UnPressableLinearLayout>
    </RelativeLayout>
</LinearLayout>
