// Flag to track if we've already notified about button readiness
let hasNotifiedButtonReady = false;
let hasNotifiedPayButtonReady = false;
let hasSeenLoadingState = false;
let hasSeenPayButtonLoadingState = false;

// Helper function to get element text content
function getElementText(element) {
    return (element.textContent || element.value || '').toLowerCase().trim();
}

// Helper function to post events
function postEvent(eventType) {
    window.jsHandler.postCustomerInteractionEvent(JSON.stringify({
        event_type: eventType
    }));
}

// Helper function to check if element or any parent has specific ID
function hasParentWithId(element, targetId) {
    let current = element;
    while (current && current !== document.body) {
        if (current.id === targetId) {
            return true;
        }
        current = current.parentElement;
    }
    return false;
}

// Helper function to check if element is a continue button
function isContinueButton(element) {
    if (element.id === 'consentButton' || element.id === 'continueButton') return true;
    const text = getElementText(element);
    return text === 'agree and continue' || text === 'save and continue';
}

// Helper function to check if element is a pay button
function isPayButton(element) {
    if (element.id === 'one-time-cta') {
        return true;
    }

    // Check parent elements for the ID (in case user clicks nested element)
    if (hasParentWithId(element, 'one-time-cta')) {
        return true;
    }

    // Check text content (should be exactly "pay")
    const text = getElementText(element);
    if (text === 'pay') {
        return true;
    }

    return false;
}

// Helper function to check if element is a return button
function isReturnButton(element) {
    return element.id === 'returnToMerchantButton' || element.id === 'cancelLink';
}

// Helper function to check if button is in loading state
function isLoading(text) {
    return text.toLowerCase().trim().includes('loading');
}

// Helper function to check if element is visible
function isElementVisible(element) {
    const style = window.getComputedStyle(element);
    return style.display !== 'none' && style.visibility !== 'hidden' && style.opacity !== '0';
}

// Helper function to check if button is ready
function isButtonReady(element, hasSeenLoading, hasNotifiedReady) {
    const text = getElementText(element);

    if (isLoading(text)) {
        return { isReady: false, shouldUpdateLoadingState: true };
    }

    // Button is ready if it's visible AND either:
    // - We've seen it load and it's finished loading
    // - OR it's ready immediately without loading
    const isReady = isElementVisible(element) && (!isLoading(text) || hasSeenLoading);
    return { isReady, shouldUpdateLoadingState: false };
}

// Helper function to check button state
function checkButtonState(element) {

    // Check continue button state
    if (!hasNotifiedButtonReady && isContinueButton(element)) {
        const { isReady, shouldUpdateLoadingState } = isButtonReady(element, hasSeenLoadingState, hasNotifiedButtonReady);

        if (shouldUpdateLoadingState) {
            hasSeenLoadingState = true;
            return;
        }

        if (isReady) {
            postEvent('continue_button_ready');
            hasNotifiedButtonReady = true;
            observer.disconnect();
        }
    }

    // Check pay button state
    if (!hasNotifiedPayButtonReady && isPayButton(element)) {
        const { isReady, shouldUpdateLoadingState } = isButtonReady(element, hasSeenPayButtonLoadingState, hasNotifiedPayButtonReady);

        if (shouldUpdateLoadingState) {
            hasSeenPayButtonLoadingState = true;
            return;
        }

        if (isReady) {
            postEvent('pay_button_ready');
            hasNotifiedPayButtonReady = true;
        }
    }
}

// Continuously monitor for button state changes
const observer = new MutationObserver((mutations) => {
    if (hasNotifiedButtonReady && hasNotifiedPayButtonReady) {
        return;
    }
    for (const mutation of mutations) {
        checkButtonState(mutation.target);
        mutation.target.querySelectorAll('*').forEach(checkButtonState);
    }
});

// Start observing the document
observer.observe(document.body, {
    childList: true,
    subtree: true,
    characterData: true,
    attributes: true
});

// Initial scan of existing elements
document.querySelectorAll('*').forEach(element => {
    checkButtonState(element);
});

// Track button clicks
document.addEventListener('click', function(event) {
    const element = event.target;
    if (!element) return;

    // Check if clicked element or any parent is a tracked button
    let currentElement = element;
    while (currentElement && currentElement !== document.body) {
        if (isContinueButton(currentElement)) {
            postEvent('continue_button_clicked');
            return;
        } else if (isPayButton(currentElement)) {
            postEvent('pay_button_clicked');
            return;
        } else if (isReturnButton(currentElement)) {
            postEvent('return_button_clicked');
            return;
        }
        currentElement = currentElement.parentElement;
    }
})
