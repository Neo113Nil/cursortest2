<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item state_pressed="true">
        <shape
            padding="10dp"
            shape="rectangle">
            <solid color="#ff006ea9"/>
            <corners radius="2dp"/>
        </shape>
    </item>
    <item state_focused="true">
        <shape
            padding="10dp"
            shape="rectangle">
            <solid color="#ff006ea9"/>
            <corners radius="2dp"/>
        </shape>
    </item>
    <item state_enabled="false">
        <shape
            padding="10dp"
            shape="rectangle">
            <solid color="#0c000000"/>
            <corners radius="2dp"/>
        </shape>
    </item>
    <item>
        <shape
            padding="10dp"
            shape="rectangle">
            <solid color="#23ad4b"/>
            <corners radius="2dp"/>
        </shape>
    </item>
</selector>
