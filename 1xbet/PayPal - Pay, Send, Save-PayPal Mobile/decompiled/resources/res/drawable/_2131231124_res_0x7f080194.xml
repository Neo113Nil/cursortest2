<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item state_pressed="true">
        <shape shape="rectangle">
            <solid color="#23ad4b"/>
            <corners radius="2dp"/>
            <stroke
                width="1dp"
                color="#23ad4b"/>
        </shape>
    </item>
    <item state_focused="true">
        <shape shape="rectangle">
            <solid color="#23ad4b"/>
            <corners radius="2dp"/>
            <stroke
                width="1dp"
                color="#23ad4b"/>
        </shape>
    </item>
    <item>
        <shape shape="rectangle">
            <solid color="#ffffff"/>
            <corners radius="2dp"/>
            <stroke
                width="1dp"
                color="#23ad4b"/>
        </shape>
    </item>
</selector>
