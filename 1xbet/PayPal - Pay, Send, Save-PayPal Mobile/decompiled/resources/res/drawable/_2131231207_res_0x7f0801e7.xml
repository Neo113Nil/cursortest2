<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item state_pressed="true">
        <shape shape="rectangle">
            <corners radius="10dp"/>
            <solid color="#396e99"/>
            <stroke
                width="0dp"
                color="#00ffffff"/>
        </shape>
    </item>
    <item state_enabled="false">
        <shape shape="rectangle">
            <corners radius="10dp"/>
            <solid color="#66417fb2"/>
            <stroke
                width="0dp"
                color="#00ffffff"/>
        </shape>
    </item>
    <item state_pressed="false">
        <shape shape="rectangle">
            <corners radius="10dp"/>
            <solid color="#417fb2"/>
            <stroke
                width="0dp"
                color="#00ffffff"/>
        </shape>
    </item>
</selector>
