<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0"
    android:toDegrees="360"
    android:pivotX="50%"
    android:pivotY="50%">
    <shape
        shape="ring"
        innerRadiusRatio="3"
        thicknessRatio="28"
        useLevel="false">
        <size
            height="48dp"
            width="48dp"/>
        <gradient
            startColor="#00737373"
            endColor="#283661"
            useLevel="false"
            angle="0"
            type="sweep"
            centerY="0.5"
            centerColor="#4c737373"/>
    </shape>
</rotate>
