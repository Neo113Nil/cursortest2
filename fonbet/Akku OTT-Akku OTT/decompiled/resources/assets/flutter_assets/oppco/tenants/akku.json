{
  "$schema": "../../docs/schemas/oppco-manifest.schema.json",
  "identity": {
    "tenantId": "akku",
    "displayName": "Akku OTT",
    "android": {
      "packageId": "com.haryanvi.netstream",
      "appName": "Akku"
    },
    "ios": {
      "bundleId": "com.haryanvi.netstream",
      "displayName": "Akku"
    }
  },
  "theme": {
    "colors": {
      "brandRed": "#E50914",
      "brandRedLight": "#F67E7D",
      "brandGold": "#C09000",
      "subRedDark": "#8F1319",
      "subRedBright": "#ED000C",
      "surface": "#1F1F1F",
      "background": "#000000",
      "onBrand": "#FFFFFF",
      "onSurface": "#FFFFFF",
      "onBackground": "#FFFFFF",
      "outline": "#404A51",
      "errorRed": "#ED000C",
      "ctaGradient": {
        "start": "#E50914",
        "end": "#C09000"
      },
      "subscriptionGradient": {
        "start": "#8F1319",
        "end": "#ED000C"
      }
    },
    "materialMapping": {
      "primary": "brandRed",
      "onPrimary": "onBrand",
      "secondary": "brandRedLight",
      "onSecondary": "onBrand",
      "tertiary": "brandGold",
      "onTertiary": "onBrand",
      "surface": "surface",
      "onSurface": "onSurface",
      "background": "background",
      "onBackground": "onBackground",
      "outline": "outline",
      "error": "errorRed",
      "onError": "onBrand"
    },
    "typography": {
      "fontFamily": "Montserrat",
      "scale": 1.0
    },
    "radii": {
      "button": 12,
      "card": 8,
      "input": 8,
      "sheet": 32
    }
  },
  "components": {
    "primaryButton": {
      "variant": "gradient",
      "gradient": "ctaGradient",
      "textColor": "onBrand",
      "height": 50,
      "radius": 12
    },
    "secondaryButton": {
      "variant": "flat",
      "fillColor": "brandRedLight",
      "textColor": "onBrand",
      "height": 50,
      "radius": 12
    },
    "destructiveButton": {
      "variant": "gradient",
      "gradient": "ctaGradient",
      "textColor": "onBrand",
      "height": 50,
      "radius": 12
    },
    "outlineButton": {
      "variant": "outline",
      "borderColor": "onSurface",
      "textColor": "onSurface",
      "height": 50,
      "radius": 30,
      "borderWidth": 1
    },
    "card": {
      "fillColor": "surface",
      "radius": 8,
      "elevation": 0,
      "borderColor": "outline"
    }
  },
  "assets": {
    "launcherIcon": "assets/images/ic_launcher.png",
    "splashLogo": "assets/images/ic_launcher.png",
    "appBarLogo": "assets/images/ic_launcher.png",
    "appBarLogoFallback": "assets/images/ic_launcher.png",
    "shareImage": "",
    "fonts": []
  },
  "features": {
    "liveTv": false,
    "shorts": null,
    "downloads": null,
    "casting": null,
    "aiChat": null,
    "subscription": null,
    "rentals": null,
    "podcast": null,
    "tabsOrder": [
      "home",
      "search",
      "watchlist",
      "profile"
    ]
  },
  "routing": {
    "enabledRoutes": [
      "home",
      "search",
      "watchlist",
      "profile",
      "continueWatching",
      "subscription",
      "movieDetails",
      "tvShow",
      "videoDetails",
      "settings",
      "notifications",
      "coupons",
      "genres",
      "genreDetails",
      "passwordChange",
      "passwordForgot",
      "auth",
      "payment",
      "aiChat",
      "shorts",
      "podcast",
      "downloads",
      "channelList",
      "comingSoon",
      "personDetails",
      "personList",
      "rentedContent",
      "review",
      "sectionViewAll",
      "movieList",
      "tvShowList",
      "videoList"
    ],
    "deepLinkScheme": "akkuott",
    "universalLinkHost": "akkuott.com"
  },
  "meta": {
    "supportedLocales": [
      "en",
      "hi",
      "fr",
      "de",
      "ar"
    ],
    "defaultLocale": "en",
    "schemaVersion": "1.0",
    "webBaseUrl": "https://akkuott.com"
  }
}
