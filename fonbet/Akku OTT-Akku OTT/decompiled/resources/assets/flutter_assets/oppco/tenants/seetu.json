{
  "$schema": "../../docs/schemas/oppco-manifest.schema.json",
  "identity": {
    "tenantId": "seetu",
    "displayName": "Seetu OTT",
    "android": {
      "packageId": "com.seetu.ott",
      "appName": "Seetu"
    },
    "ios": {
      "bundleId": "com.seetu.ott",
      "displayName": "Seetu"
    }
  },
  "theme": {
    "colors": {
      "brandViolet": "#7A33E0",
      "brandVioletLight": "#9B6BF0",
      "brandMagenta": "#A855F7",
      "chromeSilver": "#B7BCC7",
      "subVioletDark": "#3B1470",
      "subVioletBright": "#7A33E0",
      "surface": "#0E0C12",
      "background": "#040406",
      "onBrand": "#FFFFFF",
      "onSurface": "#F2F0F5",
      "onBackground": "#F2F0F5",
      "outline": "#2A2733",
      "errorRed": "#E4495A",
      "ctaGradient": {
        "start": "#6D28D9",
        "end": "#9333EA"
      },
      "subscriptionGradient": {
        "start": "#3B1470",
        "end": "#7A33E0"
      }
    },
    "materialMapping": {
      "primary": "brandViolet",
      "onPrimary": "onBrand",
      "secondary": "brandVioletLight",
      "onSecondary": "onBrand",
      "tertiary": "chromeSilver",
      "onTertiary": "background",
      "surface": "surface",
      "onSurface": "onSurface",
      "background": "background",
      "onBackground": "onBackground",
      "outline": "outline",
      "error": "errorRed",
      "onError": "onBrand"
    },
    "typography": {
      "fontFamily": "Montserrat",
      "scale": 1.0
    },
    "radii": {
      "button": 12,
      "card": 8,
      "input": 8,
      "sheet": 32
    }
  },
  "components": {
    "primaryButton": {
      "variant": "gradient",
      "gradient": "ctaGradient",
      "textColor": "onBrand",
      "height": 50,
      "radius": 12
    },
    "secondaryButton": {
      "variant": "flat",
      "fillColor": "brandVioletLight",
      "textColor": "onBrand",
      "height": 50,
      "radius": 12
    },
    "destructiveButton": {
      "variant": "gradient",
      "gradient": "ctaGradient",
      "textColor": "onBrand",
      "height": 50,
      "radius": 12
    },
    "outlineButton": {
      "variant": "outline",
      "borderColor": "chromeSilver",
      "textColor": "onSurface",
      "height": 50,
      "radius": 30,
      "borderWidth": 1
    },
    "card": {
      "fillColor": "surface",
      "radius": 8,
      "elevation": 0,
      "borderColor": "outline"
    }
  },
  "assets": {
    "launcherIcon": "assets/brands/seetu/seetu_ott_logo.png",
    "splashLogo": "assets/brands/seetu/seetu_ott_logo.png",
    "appBarLogo": "assets/brands/seetu/seetu_ott_logo.png",
    "appBarLogoFallback": "assets/brands/seetu/seetu_ott_logo.png",
    "shareImage": "",
    "fonts": []
  },
  "features": {
    "liveTv": false,
    "shorts": null,
    "downloads": null,
    "casting": null,
    "aiChat": null,
    "subscription": null,
    "rentals": null,
    "podcast": null,
    "tabsOrder": [
      "home",
      "search",
      "watchlist",
      "profile"
    ]
  },
  "routing": {
    "enabledRoutes": [
      "home",
      "search",
      "watchlist",
      "profile",
      "continueWatching",
      "subscription",
      "movieDetails",
      "tvShow",
      "videoDetails",
      "settings",
      "notifications",
      "coupons",
      "genres",
      "genreDetails",
      "passwordChange",
      "passwordForgot",
      "auth",
      "payment",
      "aiChat",
      "shorts",
      "podcast",
      "downloads",
      "channelList",
      "comingSoon",
      "personDetails",
      "personList",
      "rentedContent",
      "review",
      "sectionViewAll",
      "movieList",
      "tvShowList",
      "videoList"
    ],
    "deepLinkScheme": "seetuott",
    "universalLinkHost": ""
  },
  "meta": {
    "supportedLocales": [
      "en",
      "hi",
      "fr",
      "de",
      "ar"
    ],
    "defaultLocale": "en",
    "schemaVersion": "1.0",
    "webBaseUrl": "https://seetu.com"
  }
}
