<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sabpaisa_background_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/lottie_main"
        android:layout_width="@dimen/padding_150_dp"
        android:layout_height="@dimen/padding_150_dp"
        android:layout_marginTop="150dp"
        android:src="@drawable/cancel"
        android:contentDescription="@string/cancelled"/>
    <io.github.sabpaisaandroid.customcomponents.RaleWayBoldTextView
        android:textSize="@dimen/text_size_20_sp"
        android:textColor="@color/sabpaisa_text_color_bold"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/redirecting_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="@string/payment_failed"/>
    <io.github.sabpaisaandroid.customcomponents.RaleWayTextView
        android:textSize="@dimen/text_size_14_sp"
        android:textColor="@color/sabpaisa_time_remaining_grey"
        android:gravity="center"
        android:id="@+id/during_payment_process"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="@dimen/margin_45_dp"
        android:text="@string/your_payment_wasn_t_done_please_try_again_if_your_account_was_debited_it_will_be_credited_within_a_week"
        android:lineSpacingMultiplier="1.15"
        android:layout_marginStart="@dimen/padding_75_dp"
        android:layout_marginEnd="@dimen/padding_75_dp"/>
    <Button
        android:textSize="@dimen/text_size_16_sp"
        android:textColor="@color/sabpaisa_background_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/try_again"
        android:background="@drawable/ellipse_button_retry_green"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/padding_55_dp"
        android:text="@string/try_again"
        android:textAllCaps="false"
        android:paddingStart="@dimen/padding_60_dp"
        android:paddingEnd="@dimen/padding_60_dp"/>
</LinearLayout>
