<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main_header"
    android:background="@color/sabpaisa_blue_checkout_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <io.github.sabpaisaandroid.customcomponents.SatoshiBoldTextView
        android:textSize="@dimen/text_size_18_sp"
        android:textColor="@color/sabpaisa_background_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title_offer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/padding_63_dp"
        android:lines="2"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/margin_20_dp"
        android:layout_marginEnd="@dimen/margin_20_dp"/>
</LinearLayout>
