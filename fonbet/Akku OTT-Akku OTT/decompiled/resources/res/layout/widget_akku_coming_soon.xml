<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/widget_root"
    android:background="@drawable/widget_background"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/coming_card_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="3dp">
        <ImageView
            android:id="@+id/coming_img_0"
            android:background="@drawable/widget_thumbnail_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Coming Soon 1"/>
        <TextView
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_gravity="end|top"
            android:id="@+id/coming_date_0"
            android:background="@drawable/widget_date_badge_bg"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="#99000000"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/coming_name_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="8sp"
                android:textColor="#aaaaaa"
                android:ellipsize="end"
                android:id="@+id/coming_genre_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/coming_card_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp">
        <ImageView
            android:id="@+id/coming_img_1"
            android:background="@drawable/widget_thumbnail_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Coming Soon 2"/>
        <TextView
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_gravity="end|top"
            android:id="@+id/coming_date_1"
            android:background="@drawable/widget_date_badge_bg"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="#99000000"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/coming_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="8sp"
                android:textColor="#aaaaaa"
                android:ellipsize="end"
                android:id="@+id/coming_genre_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/coming_card_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="3dp">
        <ImageView
            android:id="@+id/coming_img_2"
            android:background="@drawable/widget_thumbnail_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Coming Soon 3"/>
        <TextView
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_gravity="end|top"
            android:id="@+id/coming_date_2"
            android:background="@drawable/widget_date_badge_bg"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="#99000000"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/coming_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="8sp"
                android:textColor="#aaaaaa"
                android:ellipsize="end"
                android:id="@+id/coming_genre_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
