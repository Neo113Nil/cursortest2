<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/talkCallActionButtonActivatedBackgroundColor">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="@color/talk_sdk_android_palette_white"/>
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <ripple android:color="?attr/talkCallActionButtonActivatedRippleColor">
                    <item>
                        <shape android:shape="oval">
                            <solid android:color="?attr/talkCallActionButtonActivatedBackgroundColor"/>
                        </shape>
                    </item>
                </ripple>
            </item>
            <item>
                <shape android:shape="oval">
                    <stroke
                        android:width="1dp"
                        android:color="@color/material_on_surface_stroke"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
