<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/siq_chat_card_type_slider"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/siq_chat_card_image"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginHorizontal="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.Style.chatwindow_widget_image"/>
    <View
        android:id="@+id/connector_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image"/>
    <include layout="@layout/siq_item_message_text_merge_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/siq_chat_card_slider_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/siq_message_text">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/siq_chat_card_slider_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/siq_chat_card_slider_indicator_text"
                style="@style/SalesIQ.Style.widget_slider_indicator_text"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <com.google.android.material.slider.Slider
                android:id="@+id/siq_slider"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="@dimen/siq_8"/>
            <com.google.android.material.slider.RangeSlider
                android:id="@+id/siq_range_slider"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_below="@+id/siq_slider"
                android:paddingStart="12dp"
                android:paddingEnd="@dimen/siq_8"/>
            <TextView
                android:id="@+id/siq_slider_seekbar_start"
                android:layout_below="@+id/siq_range_slider"
                style="@style/SalesIQ.Style.widget_slider_seekbar_start_text"/>
            <TextView
                android:id="@+id/siq_slider_seekbar_end"
                android:layout_below="@+id/siq_range_slider"
                style="@style/SalesIQ.Style.widget_slider_seekbar_end_text"/>
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/siq_text_12"
        android:id="@+id/siq_slider_widget_timetextview"
        android:paddingLeft="@dimen/siq_12"
        android:paddingRight="@dimen/siq_12"
        android:paddingBottom="@dimen/siq_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:30PM"
        android:paddingStart="@dimen/siq_12"
        android:paddingEnd="@dimen/siq_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_slider_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_slider_widget_timetextview">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/siq_chat_card_button"
            android:background="@drawable/salesiq_links_list_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:id="@+id/siq_chat_card_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
