<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/siq_chat_card_type_rating_happy"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/siq_chat_card_happiness_image"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginHorizontal="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.Style.chatwindow_widget_image"/>
    <View
        android:id="@+id/connector_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_happiness_image"/>
    <include layout="@layout/siq_item_message_text_merge_layout"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/siq_chat_card_happiness_parent"
        android:paddingTop="5dp"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="5"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_message_text">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/siq_chat_card_level1_parent"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/siq_3"
            android:layout_marginRight="@dimen/siq_3"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/siq_3">
            <ImageView
                android:id="@+id/siq_chat_card_level1_icon"
                style="@style/SalesIQ.Style.chatwindow_happiness_rating"/>
            <TextView
                android:id="@+id/siq_chat_card_level1_text"
                style="@style/SalesIQ.Style.chatwindow_happiness_text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/siq_chat_card_level2_parent"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/siq_3"
            android:layout_marginRight="@dimen/siq_3"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/siq_3">
            <ImageView
                android:id="@+id/siq_chat_card_level2_icon"
                style="@style/SalesIQ.Style.chatwindow_happiness_rating"/>
            <TextView
                android:id="@+id/siq_chat_card_level2_text"
                style="@style/SalesIQ.Style.chatwindow_happiness_text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/siq_chat_card_level3_parent"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/siq_3"
            android:layout_marginRight="@dimen/siq_3"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/siq_3">
            <ImageView
                android:id="@+id/siq_chat_card_level3_icon"
                style="@style/SalesIQ.Style.chatwindow_happiness_rating"/>
            <TextView
                android:id="@+id/siq_chat_card_level3_text"
                style="@style/SalesIQ.Style.chatwindow_happiness_text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/siq_chat_card_level4_parent"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/siq_3"
            android:layout_marginRight="@dimen/siq_3"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/siq_3">
            <ImageView
                android:id="@+id/siq_chat_card_level4_icon"
                style="@style/SalesIQ.Style.chatwindow_happiness_rating"/>
            <TextView
                android:id="@+id/siq_chat_card_level4_text"
                style="@style/SalesIQ.Style.chatwindow_happiness_text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/siq_chat_card_level5_parent"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/siq_3"
            android:layout_marginRight="@dimen/siq_3"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/siq_3">
            <ImageView
                android:id="@+id/siq_chat_card_level5_icon"
                style="@style/SalesIQ.Style.chatwindow_happiness_rating"/>
            <TextView
                android:id="@+id/siq_chat_card_level5_text"
                style="@style/SalesIQ.Style.chatwindow_happiness_text"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/siq_text_12"
        android:id="@+id/siq_chat_card_happiness_timetextview"
        android:paddingLeft="@dimen/siq_12"
        android:paddingRight="@dimen/siq_12"
        android:paddingBottom="@dimen/siq_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:30PM"
        android:paddingStart="@dimen/siq_12"
        android:paddingEnd="@dimen/siq_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_happiness_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
