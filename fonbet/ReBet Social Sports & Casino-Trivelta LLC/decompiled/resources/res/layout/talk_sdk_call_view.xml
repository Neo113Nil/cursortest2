<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/talk_sdk_android_call_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/talk_sdk_android_call_progress_loader_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TextAppearance.AppCompat.Medium"/>
    <FrameLayout
        android:id="@+id/talk_sdk_android_call_progress_loader_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/talk_sdk_android_end_call"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/talk_sdk_android_call_title">
        <TextView
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/talk_sdk_android_call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="150dp"
            android:minHeight="70dp"
            android:maxLines="1"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            style="@style/TextAppearance.MaterialComponents.Headline3"/>
        <androidx.core.widget.ContentLoadingProgressBar
            android:layout_gravity="center"
            android:id="@+id/talk_sdk_android_call_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="70dp"
            style="?android:attr/progressBarStyle"/>
    </FrameLayout>
    <ImageButton
        android:id="@+id/talk_sdk_android_audio"
        android:background="@drawable/talk_sdk_call_action_button_background"
        android:visibility="gone"
        android:layout_width="@dimen/talk_sdk_call_action_button_size"
        android:layout_height="@dimen/talk_sdk_call_action_button_size"
        android:src="@drawable/ic_talk_sdk_android_speakers_24"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/talk_sdk_android_end_call"
        app:layout_constraintEnd_toStartOf="@+id/talk_sdk_android_end_call"
        app:tint="@color/talk_sdk_android_call_action_button_icon"/>
    <ImageButton
        android:id="@+id/talk_sdk_android_end_call"
        android:background="@drawable/talk_sdk_call_action_button_background_red"
        android:layout_width="@dimen/talk_sdk_call_action_button_size"
        android:layout_height="@dimen/talk_sdk_call_action_button_size"
        android:layout_marginBottom="104dp"
        android:src="@drawable/ic_talk_sdk_android_call_end_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/talk_sdk_android_palette_white"/>
    <ImageButton
        android:id="@+id/talk_sdk_android_mute"
        android:background="@drawable/talk_sdk_call_action_button_background"
        android:visibility="gone"
        android:layout_width="@dimen/talk_sdk_call_action_button_size"
        android:layout_height="@dimen/talk_sdk_call_action_button_size"
        android:src="@drawable/ic_talk_sdk_android_mic_off_24"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/talk_sdk_android_end_call"
        app:layout_constraintStart_toEndOf="@+id/talk_sdk_android_end_call"
        app:tint="@color/talk_sdk_android_call_action_button_icon"/>
</merge>
