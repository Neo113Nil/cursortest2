<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/replied_message_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/siq_2"
        android:layout_marginTop="@dimen/siq_2"
        android:layout_marginRight="@dimen/siq_2"
        android:layout_marginHorizontal="@dimen/siq_2"
        app:layout_constraintBottom_toBottomOf="@+id/vertical_bar_bottom_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vertical_bar"
        android:background="@drawable/replied_message_vertical_bar_separator_background"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/siq_8"
        android:layout_marginStart="@dimen/siq_8"
        android:layout_marginEnd="@dimen/siq_6"
        app:layout_constraintBottom_toBottomOf="@+id/text_view_replied_message"
        app:layout_constraintEnd_toStartOf="@+id/image_replied_attachment_type"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/replied_message_background"
        app:layout_constraintTop_toTopOf="@+id/replied_message_background"/>
    <View
        android:id="@+id/vertical_bar_bottom_space"
        android:layout_width="@dimen/siq_3"
        android:layout_height="@dimen/siq_8"
        app:layout_constraintStart_toStartOf="@+id/vertical_bar"
        app:layout_constraintTop_toBottomOf="@+id/vertical_bar"/>
    <ImageView
        android:id="@+id/image_replied_attachment_type"
        android:visibility="gone"
        android:layout_width="@dimen/siq_20"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/siq_4"
        app:layout_constraintBottom_toBottomOf="@+id/text_view_replied_message"
        app:layout_constraintEnd_toStartOf="@+id/text_view_replied_message"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/vertical_bar"
        app:layout_constraintTop_toTopOf="@+id/text_view_replied_message"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_15"
        android:textStyle="bold"
        android:ellipsize="end"
        android:id="@+id/text_view_replied_message_sender_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/siq_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/image_replied_attachment_type"
        app:layout_constraintTop_toTopOf="@+id/vertical_bar"
        app:textTypeface="medium"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_14"
        android:ellipsize="end"
        android:id="@+id/text_view_replied_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_4"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/siq_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/image_replied_attachment_type"
        app:layout_constraintTop_toBottomOf="@+id/text_view_replied_message_sender_name"/>
</merge>
