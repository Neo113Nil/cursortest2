<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/siq_backgroundcolor"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/siq_dialog_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/siq_toolbar_height"
        android:minHeight="@dimen/siq_toolbar_height"
        app:popupTheme="?attr/siq_pop_menu_style"
        style="?attr/siq_toolbar_style"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/siq_timezone_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
