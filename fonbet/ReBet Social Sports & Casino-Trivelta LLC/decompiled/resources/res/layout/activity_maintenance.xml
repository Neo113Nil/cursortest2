<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:background="@color/maintenance_bg_color"
    android:padding="36dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_icon"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/maintenance_icon"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/maintenance_text_color"
        android:gravity="center"
        android:id="@+id/txt_title_maintain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/the_app_is_under_maintenance"
        android:fontFamily="@font/inter_regular"
        android:textAlignment="center"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/maintenance_text_color"
        android:gravity="center"
        android:id="@+id/txt_des_maintain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="5dp"
        android:fontFamily="@font/inter_regular"
        android:textAlignment="center"/>
</LinearLayout>
