<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_chat_card_type_rating_star"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/siq_chat_card_image"
        android:layout_marginLeft="@dimen/siq_2"
        android:layout_marginTop="@dimen/siq_2"
        android:layout_marginRight="@dimen/siq_2"
        android:layout_marginHorizontal="@dimen/siq_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.Style.chatwindow_widget_image"/>
    <View
        android:id="@+id/connector_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image"/>
    <include layout="@layout/siq_item_message_text_merge_layout"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/siq_chat_card_star_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@+id/siq_message_text">
        <RelativeLayout
            android:id="@+id/siq_star_1_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_star_1"
                style="@style/SalesIQ.Style.widget_star"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/siq_star_2_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_star_2"
                style="@style/SalesIQ.Style.widget_star"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/siq_star_3_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_star_3"
                style="@style/SalesIQ.Style.widget_star"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/siq_star_4_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_star_4"
                style="@style/SalesIQ.Style.widget_star"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/siq_star_5_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_star_5"
                style="@style/SalesIQ.Style.widget_star"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/siq_star_6_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_star_6"
                style="@style/SalesIQ.Style.widget_star"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/siq_star_7_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_star_7"
                style="@style/SalesIQ.Style.widget_star"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/siq_star_8_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_star_8"
                style="@style/SalesIQ.Style.widget_star"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/siq_star_9_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_star_9"
                style="@style/SalesIQ.Style.widget_star"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/siq_star_10_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_star_10"
                style="@style/SalesIQ.Style.widget_star"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:id="@+id/siq_star_widget_status_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_star_parent">
        <TextView
            android:textSize="@dimen/siq_text_12"
            android:id="@+id/siq_star_widget_timetextview"
            android:paddingLeft="@dimen/siq_12"
            android:paddingRight="@dimen/siq_12"
            android:paddingBottom="@dimen/siq_10"
            android:paddingStart="@dimen/siq_12"
            android:paddingEnd="@dimen/siq_12"
            style="@style/SalesIQ.Style.chatwindow_time_textcolor_operator"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
