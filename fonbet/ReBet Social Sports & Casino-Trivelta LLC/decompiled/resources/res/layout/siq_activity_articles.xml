<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_layout"
    android:background="?attr/siq_backgroundcolor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/siq_chat_app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:backgroundTint="?attr/siq_statusbar_color"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/siq_articles_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/siq_toolbar_height"
            android:minHeight="@dimen/siq_toolbar_height"
            android:elevation="0dp"
            app:popupTheme="?attr/siq_pop_menu_style"
            style="?attr/siq_toolbar_style"/>
    </com.google.android.material.appbar.AppBarLayout>
    <View
        android:id="@+id/siq_toolbar_separator"
        android:background="?attr/siq_toolbar_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/siq_articles_framelayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_toolbar_separator"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_gravity="center"
        android:id="@+id/siq_chat_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorAccent"
        app:indicatorSize="@dimen/siq_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackCornerRadius="@dimen/siq_3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
