<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_edit_reply"
    android:background="@drawable/edit_or_reply_background"
    android:visibility="gone"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:outlineProvider="background">
    <View
        android:id="@+id/vertical_bar"
        android:background="@drawable/edit_or_reply_vertical_separator_background"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/siq_9"
        android:layout_marginStart="@dimen/siq_12"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_or_reply_message_sub_text"
        app:layout_constraintEnd_toStartOf="@+id/edit_or_reply_attachment_type_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_14"
        android:textColor="?attr/colorAccent"
        android:ellipsize="end"
        android:id="@+id/edit_or_reply_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/siq_text_4"
        android:textDirection="locale"
        android:layout_marginEnd="@dimen/siq_12"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintStart_toStartOf="@+id/edit_or_reply_attachment_type_image"
        app:layout_constraintTop_toTopOf="@+id/vertical_bar"
        app:layout_constraintWidth="match_constraint"
        app:textTypeface="medium"/>
    <ImageView
        android:id="@+id/edit_or_reply_close"
        android:background="@drawable/salesiq_circle_bg"
        android:padding="@dimen/siq_2"
        android:layout_width="@dimen/siq_18"
        android:layout_height="@dimen/siq_18"
        android:layout_marginTop="@dimen/siq_8"
        android:src="@drawable/salesiq_ic_close"
        android:layout_marginEnd="@dimen/siq_14"
        android:elevation="@dimen/siq_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/siq_text_tertiary_color"/>
    <ImageView
        android:id="@+id/edit_or_reply_attachment_type_image"
        android:visibility="visible"
        android:layout_width="@dimen/siq_16"
        android:layout_height="@dimen/siq_16"
        android:src="@drawable/salesiq_vector_image"
        android:layout_marginEnd="@dimen/siq_4"
        app:layout_constraintBottom_toBottomOf="@+id/edit_or_reply_message_sub_text"
        app:layout_constraintEnd_toStartOf="@+id/edit_or_reply_message_sub_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/vertical_bar"
        app:layout_constraintTop_toTopOf="@+id/edit_or_reply_message_sub_text"
        app:tint="?attr/siq_text_tertiary_color"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_14"
        android:textColor="?attr/siq_text_tertiary_color"
        android:ellipsize="end"
        android:id="@+id/edit_or_reply_message_sub_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_2"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/siq_text_6"
        android:textDirection="locale"
        android:layout_marginEnd="@dimen/siq_2"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintStart_toEndOf="@+id/edit_or_reply_attachment_type_image"
        app:layout_constraintTop_toBottomOf="@+id/edit_or_reply_title_text"
        app:layout_constraintWidth="match_constraint"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="edit_or_reply_close, edit_or_reply_image_preview"/>
    <ImageView
        android:id="@+id/edit_or_reply_image_preview"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-1dp"
        android:layout_marginBottom="-1dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_marginEnd="@dimen/siq_14"
        app:layout_constraintBottom_toBottomOf="@+id/edit_or_reply_message_sub_text"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/edit_or_reply_message_sub_text"
        app:layout_constraintTop_toTopOf="@+id/edit_or_reply_title_text"/>
    <View
        android:id="@+id/bottom_spacer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/siq_9"
        app:layout_constraintTop_toBottomOf="@+id/vertical_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
