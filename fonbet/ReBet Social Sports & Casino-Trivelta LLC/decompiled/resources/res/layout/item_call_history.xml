<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_call_item_parent"
    android:paddingTop="@dimen/siq_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/siq_16"
    android:paddingEnd="@dimen/siq_10">
    <ImageView
        android:id="@+id/siq_user_dp"
        android:layout_width="@dimen/siq_44"
        android:layout_height="@dimen/siq_44"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_16"
        android:textColor="?attr/siq_text_primary_color"
        android:ellipsize="end"
        android:id="@+id/siq_call_title_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_1"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/siq_8"
        android:layout_marginStart="@dimen/siq_12"
        android:layout_marginEnd="@dimen/siq_8"
        app:layout_constraintEnd_toStartOf="@+id/siq_last_modified_time"
        app:layout_constraintStart_toEndOf="@+id/siq_user_dp"
        app:layout_constraintTop_toTopOf="@+id/siq_user_dp"
        app:textTypeface="medium"/>
    <ImageView
        android:id="@+id/siq_call_status"
        android:layout_width="@dimen/siq_18"
        android:layout_height="@dimen/siq_18"
        android:translationX="@dimen/siq_1"
        android:translationY="@dimen/siq_1"
        app:layout_constraintBottom_toBottomOf="@+id/siq_user_dp"
        app:layout_constraintEnd_toEndOf="@+id/siq_user_dp"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_14"
        android:textColor="?attr/siq_text_tertiary_color"
        android:ellipsize="end"
        android:id="@+id/siq_call_sub_title_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_2"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/siq_6"
        android:layout_marginStart="@dimen/siq_12"
        android:layout_marginEnd="@dimen/siq_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siq_user_dp"
        app:layout_constraintTop_toBottomOf="@+id/siq_call_title_content"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_12"
        android:textColor="?attr/siq_text_tertiary_color"
        android:id="@+id/siq_last_modified_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/siq_4"
        android:layout_marginStart="@dimen/siq_12"
        android:layout_marginEnd="@dimen/siq_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/siq_user_dp"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/siq_call_expandable_views_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="siq_department_icon, siq_call_department_name, siq_calendar_icon, siq_call_date_and_time"/>
    <ImageView
        android:id="@+id/siq_department_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_1"
        android:layout_marginBottom="@dimen/siq_1"
        android:src="@drawable/ic_departments_light"
        android:layout_marginStart="@dimen/siq_12"
        app:layout_constraintBottom_toBottomOf="@+id/siq_call_department_name"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@+id/siq_user_dp"
        app:layout_constraintTop_toTopOf="@+id/siq_call_department_name"
        app:tint="?attr/siq_text_tertiary_color"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_14"
        android:textColor="?attr/siq_text_secondary_color"
        android:id="@+id/siq_call_department_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_12"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/siq_6"
        android:layout_marginStart="@dimen/siq_8"
        android:layout_marginEnd="@dimen/siq_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/siq_department_icon"
        app:layout_constraintTop_toBottomOf="@+id/siq_call_sub_title_content"/>
    <ImageView
        android:id="@+id/siq_calendar_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_1"
        android:layout_marginBottom="@dimen/siq_1"
        android:src="@drawable/siq_calendar_icon"
        android:layout_marginStart="@dimen/siq_12"
        app:layout_constraintBottom_toBottomOf="@+id/siq_call_date_and_time"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@+id/siq_user_dp"
        app:layout_constraintTop_toTopOf="@+id/siq_call_date_and_time"
        app:tint="?attr/siq_text_tertiary_color"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_14"
        android:textColor="?attr/siq_text_secondary_color"
        android:id="@+id/siq_call_date_and_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_12"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/siq_6"
        android:layout_marginStart="@dimen/siq_8"
        android:layout_marginEnd="@dimen/siq_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/siq_department_icon"
        app:layout_constraintTop_toBottomOf="@+id/siq_call_department_name"/>
    <View
        android:id="@+id/siq_call_divider"
        android:background="?attr/siq_separator_grey"
        android:layout_width="0dp"
        android:layout_height="@dimen/siq_1"
        android:layout_marginTop="@dimen/siq_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/siq_call_title_content"
        app:layout_constraintTop_toBottomOf="@+id/siq_call_date_and_time"
        app:layout_constraintWidth_min="@dimen/siq_1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
