<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_launcher_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:hapticFeedbackEnabled="true"
    android:animateLayoutChanges="false">
    <com.zoho.livechat.android.ui.customviews.SalesIQFloatingActionButton
        android:layout_gravity="center"
        android:id="@+id/siq_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/siq_16"
        android:tint="@color/red"
        app:hoveredFocusedTranslationZ="@dimen/siq_1"
        app:pressedTranslationZ="@dimen/siq_1"/>
    <TextView
        android:id="@+id/siq_launcher_badge"
        android:visibility="gone"
        android:layout_marginTop="@dimen/siq_12"
        android:layout_marginEnd="@dimen/siq_12"
        android:elevation="@dimen/siq_10"
        style="@style/SalesIQ.Style.launcher_textview"/>
</FrameLayout>
