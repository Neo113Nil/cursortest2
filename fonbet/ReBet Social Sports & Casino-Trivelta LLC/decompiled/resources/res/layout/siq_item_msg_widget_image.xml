<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/siq_chat_card_type_image"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/siq_cardview_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:contentPadding="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:background="?attr/siq_chat_message_backgroundcolor_operator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/siq_chat_fileprovider_parent"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="12dp"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent">
                        <RelativeLayout
                            android:id="@+id/siq_chat_fileprovider_title_parent"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/siq_10">
                            <TextView
                                android:textSize="@dimen/siq_text_16"
                                android:id="@+id/siq_chat_fileprovider_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/livechat.chat.queue.banner.title"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/siq_chat_fileprovider_text_parent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/siq_10">
                            <ImageView
                                android:id="@+id/siq_chat_fileprovider_icon"
                                android:visibility="gone"
                                android:layout_width="@dimen/siq_20"
                                android:layout_height="@dimen/siq_20"
                                android:layout_marginRight="@dimen/siq_8"
                                android:layout_marginEnd="@dimen/siq_8"/>
                            <TextView
                                android:id="@+id/siq_chat_fileprovider_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/livechat.chat.queue.banner.title"/>
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/siq_chat_card_image"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/siq_chat_fileprovider_parent"
                        style="@style/SalesIQ.Style.chatwindow_widget_image"/>
                    <WebView
                        android:id="@+id/siq_chat_video_card_webview"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="H,3:2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image"/>
                    <RelativeLayout
                        android:id="@+id/siq_image_action_parent"
                        android:background="@drawable/salesiq_attachment_download_bg"
                        android:visibility="visible"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:layout_constraintBottom_toBottomOf="@+id/siq_chat_card_image"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/siq_chat_card_image">
                        <ImageView
                            android:id="@+id/siq_image_action"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            app:srcCompat="@drawable/ic_play"/>
                    </RelativeLayout>
                    <View
                        android:id="@+id/connector_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/siq_chat_video_card_webview"/>
                    <include layout="@layout/siq_item_message_text_merge_layout"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:gravity="bottom"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:id="@+id/siq_chat_card_links_actionlist_parent"
                    android:background="@drawable/salesiq_links_list_bg"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:background="?attr/siq_chat_message_backgroundcolor_operator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/siq_chat_card_links_actionlist"
                            android:background="@drawable/salesiq_links_list_bg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
