<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_chat_card_type_articles"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/siq_chat_card_image"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginHorizontal="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.Style.chatwindow_widget_image"/>
    <TextView
        android:id="@+id/siq_chat_card_text"
        android:layout_marginLeft="@dimen/siq_14"
        android:layout_marginTop="@dimen/siq_10"
        android:layout_marginRight="@dimen/siq_14"
        android:layout_marginBottom="@dimen/siq_10"
        android:layout_marginHorizontal="@dimen/siq_14"
        android:layout_marginVertical="@dimen/siq_10"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image"
        style="@style/SalesIQ.Style.chatwindow_widget_text"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/siq_chat_card_articles_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_text">
        <TextView
            android:id="@+id/siq_chat_card_description"
            style="@style/SalesIQ.Style.widget_description_text"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/siq_chat_card_articles_list_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/siq_chat_card_articles_title"
                style="@style/SalesIQ.Style.widget_articles_title_text"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/siq_chat_card_articles_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/siq_chat_card_links_actionlist_parent"
        android:background="@drawable/salesiq_links_list_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/siq_chat_card_articles_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:background="?attr/siq_chat_message_backgroundcolor_operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/siq_chat_card_links_actionlist"
                android:background="@drawable/salesiq_links_list_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="1dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/siq_text_12"
        android:id="@+id/siq_article_widget_timetextview"
        android:paddingBottom="@dimen/siq_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/siq_12"
        android:paddingEnd="@dimen/siq_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_links_actionlist_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
