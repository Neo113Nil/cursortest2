<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_msg_audio_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/top_spacer_view_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/siq_2"
        app:layout_constraintTop_toBottomOf="@+id/replied_message_background"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/siq_audioparent"
        android:paddingLeft="@dimen/siq_2"
        android:paddingRight="@dimen/siq_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/siq_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_spacer_view_card">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/siq_audio_layout"
            android:padding="@dimen/siq_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.2">
                <RelativeLayout
                    android:id="@+id/siq_audio_download_parent"
                    android:layout_width="@dimen/siq_42"
                    android:layout_height="@dimen/siq_42"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true">
                    <RelativeLayout
                        android:id="@+id/siq_audio_download_progress_parent"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true">
                        <ImageView
                            android:id="@+id/siq_audio_cancel_icon"
                            app:srcCompat="@drawable/salesiq_vector_cancel_light"
                            style="@style/SalesIQ.Style.chatwindow_attachment_cancel_image"/>
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/siq_audio_progressbar"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:indeterminate="true"
                            android:layout_centerInParent="true"
                            android:indeterminateTint="@color/siq_white"
                            app:indicatorSize="@dimen/siq_38"
                            app:trackCornerRadius="@dimen/siq_2"
                            app:trackThickness="@dimen/siq_3"/>
                    </RelativeLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/siq_action_parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:id="@+id/siq_audio_action_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/salesiq_download_arrow"
                        style="@style/SalesIQ.Style.chatwindow_attachment_download_image"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/siq_audio_seekbar_parent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.55">
                <SeekBar
                    android:id="@+id/siq_audio_seekbar"
                    android:progress="0"
                    style="@style/SalesIQ.Seekbar.chatwindow_attachment"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/siq_audio_duration_parent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.25">
                <TextView
                    android:id="@+id/siq_audio_duration"
                    style="@style/SalesIQ.Style.chatwindow_audio_duration_text"/>
            </RelativeLayout>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/siq_audio_status_layout"
            android:paddingBottom="@dimen/siq_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="@dimen/siq_12"
            app:layout_constraintTop_toBottomOf="@+id/siq_audio_layout">
            <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
                android:id="@+id/siq_audio_message_edited"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/siq_audio_timeView"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SalesIQ.Style.message_bubble_edited_text"/>
            <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
                android:id="@+id/siq_audio_timeView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/siq_audio_status_icon"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/SalesIQ.Style.chatwindow_time_textcolor_visitor"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/siq_audio_status_icon"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/siq_audio_timeView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/siq_audio_timeView"
                app:layout_constraintTop_toTopOf="@+id/siq_audio_timeView"
                app:srcCompat="@drawable/ic_salesiq_mobilisten_tick"
                style="@style/SalesIQ.Style.ChatWindow_Message_Status_Icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/connector_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siq_audio_status_layout"/>
        <include layout="@layout/siq_item_message_text_with_status_merge_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
