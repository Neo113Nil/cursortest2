<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/siq_infoview_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/siq_4"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/siq_connected_to_banner"
            android:background="?attr/siq_chat_connected_to_banner_color"
            android:paddingLeft="@dimen/siq_24"
            android:paddingTop="@dimen/siq_9"
            android:paddingRight="@dimen/siq_24"
            android:paddingBottom="@dimen/siq_9"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="@dimen/siq_24"
            android:paddingVertical="@dimen/siq_9">
            <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
                android:textSize="@dimen/siq_text_14"
                android:textColor="?attr/siq_chat_connected_to_banner_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/siq_connected_to_banner_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mobilisten_chat_connected_to_operator_or_bot"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/siq_noInternet_layout"
            android:background="?attr/siq_nointernetbanner_backgroundcolor"
            android:paddingTop="@dimen/siq_9"
            android:paddingBottom="@dimen/siq_9"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/siq_connected_to_banner">
            <LinearLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/siq_noInternet_progressBar"
                    android:layout_width="@dimen/siq_16"
                    android:layout_height="@dimen/siq_16"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/siq_text_secondary_color"/>
                <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
                    android:textSize="@dimen/siq_text_14"
                    android:textColor="?attr/siq_text_secondary_color"
                    android:id="@+id/siq_no_internet_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/livechat.message.waitingforconnection"
                    android:layout_marginStart="@dimen/siq_10"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/siq_offline_message"
            android:visibility="gone"
            android:layout_below="@+id/siq_noInternet_layout"
            style="@style/SalesIQ.Style.chatwindow_offline_message"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/siq_transfer_operator_layout"
            android:background="?attr/siq_handoffbanner_backgroundcolor"
            android:paddingTop="@dimen/siq_15"
            android:paddingBottom="@dimen/siq_15"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="1"
            android:layout_below="@+id/siq_offline_message">
            <LinearLayout
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.75">
                <TextView
                    android:id="@+id/siq_transfer_content"
                    android:layout_marginLeft="@dimen/siq_15"
                    android:text="@string/livechat.bot.connectwithhuman"
                    android:layout_marginStart="@dimen/siq_15"
                    style="@style/SalesIQ.Style.chatwindow_transfer_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/siq_transfer_yes_parent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.25">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:id="@+id/siq_transfer_yes"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/siq_16">
                    <TextView
                        android:id="@+id/siq_transfer_yes_text"
                        android:text="@string/livechat.common.yes"
                        style="@style/SalesIQ.Style.chatwindow_transfer_content_positive_text"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/siq_queue_parent"
            android:background="?attr/siq_chat_queuebanner_backgroundcolor"
            android:paddingTop="@dimen/siq_10"
            android:paddingBottom="@dimen/siq_12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_below="@+id/siq_transfer_operator_layout"
            android:paddingStart="@dimen/siq_14"
            android:paddingEnd="@dimen/siq_12">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/siq_queue_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/siq_queue_position_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/siq_text_16"
                    android:ellipsize="end"
                    android:id="@+id/siq_queue_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/livechat.chat.queue.banner.title"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="@dimen/siq_text_14"
                    android:id="@+id/siq_queue_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/siq_5"
                    android:text="@string/livechat.chat.queue.banner.calculating"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/siq_queue_position_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/siq_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/siq_queue_layout"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:id="@+id/siq_queue_position_parent"
                    android:background="@drawable/siq_queue_position_background"
                    android:paddingLeft="@dimen/siq_8"
                    android:paddingTop="@dimen/siq_4"
                    android:paddingRight="@dimen/siq_8"
                    android:paddingBottom="@dimen/siq_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1"
                    android:minWidth="@dimen/siq_50"
                    android:paddingHorizontal="@dimen/siq_8"
                    android:paddingVertical="@dimen/siq_4">
                    <TextView
                        android:textSize="@dimen/siq_text_14"
                        android:ellipsize="end"
                        android:id="@+id/siq_queue_position_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/livechat.chat.queue.banner.position.subtitle"
                        android:maxLines="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/siq_queue_position"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/siq_text_16"
                        android:id="@+id/siq_queue_position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/siq_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintStart_toEndOf="@+id/siq_queue_position_subtitle"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_reply"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_salesiq_reply"
        app:layout_constraintBottom_toTopOf="@+id/layout_edit_reply"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:tint="?attr/siq_text_tertiary_color"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/siq_chatmessagesrecylerview"
        android:background="?attr/siq_backgroundcolor"
        android:paddingTop="@dimen/siq_16"
        android:paddingBottom="@dimen/siq_12"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/siq_timer_layout"
        app:layout_constraintTop_toBottomOf="@+id/siq_infoview_parent"
        app:layout_constraintVertical_bias="1"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_scroll_to_end"
        android:background="@null"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/salesiq_ic_keyboard_arrow_down"
        android:scaleType="center"
        android:layout_alignBottom="@+id/siq_chatmessagesrecylerview"
        android:layout_alignParentEnd="true"
        app:backgroundTint="?attr/siq_scroll_to_bottom_fab_background"
        app:elevation="2dp"
        app:fabCustomSize="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/siq_chatmessagesrecylerview"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="28dp"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_gravity="center"
        android:id="@+id/siq_messages_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorAccent"
        app:indicatorSize="@dimen/siq_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackCornerRadius="@dimen/siq_3"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/siq_timer_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/layout_edit_reply">
        <TextView
            android:id="@+id/siq_timerclocktext"
            android:layout_marginLeft="@dimen/siq_24"
            android:layout_marginRight="@dimen/siq_24"
            android:layout_marginHorizontal="@dimen/siq_24"
            style="@style/SalesIQ.Style.chatwindow_timer_clock_text"/>
    </LinearLayout>
    <include
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/siq_bottom_layout"
        app:layout_constraintHeight_percent="0"
        layout="@layout/item_edit_reply_bubble"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/siq_bottom_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        app:layout_constraintBottom_toTopOf="@+id/reopen_layout_divider">
        <View
            android:id="@+id/siq_bottom_layout_separator"
            android:background="?attr/siq_divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <RelativeLayout
            android:id="@+id/siq_text_file_input"
            android:background="?attr/siq_chat_input_backgroundcolor"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp">
            <RelativeLayout
                android:id="@+id/siq_action_layout"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignBottom="@+id/siq_msg_input"
                android:layout_alignParentStart="true">
                <ImageView
                    android:id="@+id/siq_action_button"
                    app:srcCompat="@drawable/ic_attachment_pin"
                    style="@style/SalesIQ.Style.chatwindow_action_button"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/siq_send_layout"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignBottom="@+id/siq_msg_input"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/siq_send_button"
                    app:srcCompat="@drawable/salesiq_vector_send"
                    style="@style/SalesIQ.Style.chatwindow_send_button"/>
            </RelativeLayout>
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/siq_msg_input"
                android:layout_toStartOf="@+id/siq_send_layout"
                android:layout_toEndOf="@+id/siq_action_layout"
                style="@style/SalesIQ.Style.chatwindow_message_input_text"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/siq_audio_input"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/siq_1"
        app:layout_constraintBottom_toTopOf="@+id/siq_advertise_badge_parent">
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <RelativeLayout
                android:layout_gravity="start"
                android:id="@+id/siq_record_time_layout"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:layout_width="wrap_content"
                android:layout_height="50dp">
                <View
                    android:id="@+id/siq_recording_icon"
                    android:background="@drawable/salesiq_circle_bg"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:id="@+id/siq_recording_time"
                    android:layout_toRightOf="@+id/siq_recording_icon"
                    android:layout_toEndOf="@+id/siq_recording_icon"
                    style="@style/SalesIQ.Style.chatwindow_recording_time"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/siq_slidecancel_view"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <ImageView
                    android:id="@+id/siq_record_cancel_swipe_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/salesiq_vector_nav_left"/>
                <TextView
                    android:id="@+id/siq_record_cancel_text"
                    android:text="@string/livechat.messages.record.slidetocancel"
                    style="@style/SalesIQ.Style.chatwindow_recording_cancel_text"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp">
                <RelativeLayout
                    android:layout_gravity="end|bottom"
                    android:id="@+id/siq_record_audio_anim_view"
                    android:background="@drawable/salesiq_circle_bg"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="-5dp"
                    android:layout_marginBottom="-5dp"
                    android:minWidth="60dp"
                    android:minHeight="60dp"
                    android:layout_marginEnd="-5dp"/>
            </FrameLayout>
            <RelativeLayout
                android:layout_gravity="end|bottom"
                android:id="@+id/siq_record_button_layout"
                android:background="@drawable/salesiq_circle_bg"
                android:visibility="visible"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginRight="-5dp"
                android:layout_marginBottom="-5dp"
                android:layout_marginEnd="-5dp">
                <ImageView
                    android:id="@+id/siq_record_button"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerInParent="true"
                    app:srcCompat="@drawable/ic_microphone"/>
            </RelativeLayout>
        </FrameLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/siq_reopen_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="reopen_layout_divider, siq_reopen_button_text"/>
    <View
        android:id="@+id/reopen_layout_divider"
        android:background="?attr/siq_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/siq_8"
        app:layout_constraintBottom_toTopOf="@+id/siq_reopen_button_text"/>
    <TextView
        android:id="@+id/siq_reopen_button_text"
        android:text="@string/livechat.reopen.title"
        app:layout_constraintBottom_toTopOf="@+id/siq_advertise_badge_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SalesIQ.Style.chatwindow_continue_chat_button_text"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/siq_advertise_badge_parent"
        android:background="?attr/siq_backgroundcolor"
        android:padding="@dimen/siq_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/siq_1"
        app:layout_constraintBottom_toTopOf="@+id/siq_bottom_navigation_divider">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/siq_advertise_badge_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/siq_advertise_badge_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/ic_salesiq_icon"/>
            <TextView
                android:textSize="@dimen/siq_text_12"
                android:id="@+id/siq_advertise_badge_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/siq_6"
                android:text="@string/salesiq.advertisebadge.content"
                android:layout_marginStart="@dimen/siq_6"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/siq_bottom_navigation_divider"
        android:background="?attr/siq_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
