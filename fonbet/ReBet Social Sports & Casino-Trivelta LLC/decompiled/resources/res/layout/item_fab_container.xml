<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_fab_container"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/siq_fab_call_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="siq_fab_call, siq_fab_call_title"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_14"
        android:textColor="?attr/siq_primary_white_color"
        android:id="@+id/siq_fab_call_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/siq_call_text"
        android:lineSpacingExtra="@dimen/siq_text_6"
        android:layout_marginEnd="@dimen/siq_10"
        app:layout_constraintBottom_toBottomOf="@+id/siq_fab_call"
        app:layout_constraintEnd_toStartOf="@+id/siq_fab_call"
        app:layout_constraintTop_toTopOf="@+id/siq_fab_call"/>
    <com.zoho.livechat.android.ui.customviews.SalesIQFloatingActionButton
        android:id="@+id/siq_fab_call"
        android:layout_width="@dimen/siq_small_launcher_size"
        android:layout_height="@dimen/siq_small_launcher_size"
        android:layout_marginBottom="@dimen/siq_16"
        app:fabCustomSize="@dimen/siq_small_launcher_size"
        app:hoveredFocusedTranslationZ="@dimen/siq_1"
        app:layout_constraintBottom_toTopOf="@+id/siq_fab_chat"
        app:layout_constraintEnd_toEndOf="@+id/siq_fab_chat"
        app:layout_constraintStart_toStartOf="@+id/siq_fab_chat"
        app:pressedTranslationZ="@dimen/siq_1"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/siq_fab_chat_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="siq_fab_chat, siq_fab_chat_title"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_14"
        android:textColor="?attr/siq_primary_white_color"
        android:id="@+id/siq_fab_chat_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/siq_chat_text"
        android:lineSpacingExtra="@dimen/siq_text_6"
        android:layout_marginEnd="@dimen/siq_10"
        app:layout_constraintBottom_toBottomOf="@+id/siq_fab_chat"
        app:layout_constraintEnd_toStartOf="@+id/siq_fab_chat"
        app:layout_constraintTop_toTopOf="@+id/siq_fab_chat"/>
    <com.zoho.livechat.android.ui.customviews.SalesIQFloatingActionButton
        android:id="@+id/siq_fab_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/siq_24"
        app:fabCustomSize="@dimen/siq_small_launcher_size"
        app:hoveredFocusedTranslationZ="@dimen/siq_1"
        app:layout_constraintBottom_toTopOf="@+id/siq_fab_add_chat"
        app:layout_constraintEnd_toEndOf="@+id/primary_fab_center_view"
        app:layout_constraintStart_toStartOf="@+id/primary_fab_center_view"
        app:pressedTranslationZ="@dimen/siq_1"/>
    <com.zoho.livechat.android.ui.customviews.SalesIQFloatingActionButton
        android:id="@+id/siq_fab_add_chat"
        android:layout_width="@dimen/siq_launcher_size"
        android:layout_height="@dimen/siq_launcher_size"
        android:layout_marginBottom="@dimen/siq_16"
        app:fabCustomSize="@dimen/siq_launcher_size"
        app:hoveredFocusedTranslationZ="@dimen/siq_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/primary_fab_center_view"
        app:layout_constraintStart_toStartOf="@+id/primary_fab_center_view"
        app:pressedTranslationZ="@dimen/siq_1"/>
    <View
        android:id="@+id/primary_fab_center_view"
        android:layout_width="@dimen/siq_launcher_size"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/siq_16"
        android:layout_marginRight="@dimen/siq_16"
        android:layout_marginHorizontal="@dimen/siq_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/siq_launcher_size"/>
</androidx.constraintlayout.widget.ConstraintLayout>
