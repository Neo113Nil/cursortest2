<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_chat_card_type_selection"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/siq_chat_card_image"
        app:layout_constraintEnd_toEndOf="@+id/siq_chat_card_image"
        app:layout_constraintStart_toStartOf="@+id/siq_chat_card_image"
        app:layout_constraintTop_toTopOf="@+id/siq_chat_card_image"
        layout="@layout/salesiq_center_image_message_action_view"/>
    <ImageView
        android:id="@+id/siq_chat_card_image"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginHorizontal="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.Style.chatwindow_widget_image"/>
    <View
        android:id="@+id/connector_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image"/>
    <include layout="@layout/siq_item_message_text_merge_layout"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/siq_chat_card_options"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:alignContent="flex_start"
        app:alignItems="flex_start"
        app:dividerDrawableHorizontal="@drawable/flexbox_horizontal_divider"
        app:dividerDrawableVertical="@drawable/flexbox_vertical_divider"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_message_text"
        app:showDividerHorizontal="middle"
        app:showDividerVertical="middle"/>
    <TextView
        android:textSize="@dimen/siq_text_12"
        android:id="@+id/siq_selection_widget_timetextview"
        android:paddingLeft="@dimen/siq_12"
        android:paddingRight="@dimen/siq_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_4"
        android:layout_marginBottom="@dimen/siq_10"
        android:paddingStart="@dimen/siq_12"
        android:paddingEnd="@dimen/siq_14"
        app:layout_constraintBottom_toTopOf="@+id/siq_chat_card_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_options"
        style="@style/SalesIQ.Style.chatwindow_time_textcolor_operator"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/siq_chat_card_button"
        android:background="@drawable/salesiq_links_list_bg"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/siq_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_selection_widget_timetextview">
        <TextView
            android:id="@+id/siq_chat_card_button_text"
            style="@style/SalesIQ.Style.chatwindow_widget_button_text"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
