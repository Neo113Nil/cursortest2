<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/siq_status_bar_view"
            android:background="?attr/siq_image_viewer_status_bar_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/siq_100"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/siq_chatimagesview_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/siq_toolbar_height"
            android:layout_marginTop="0dp"
            android:minHeight="@dimen/siq_toolbar_height"
            android:elevation="@dimen/siq_100"
            app:layout_constraintTop_toBottomOf="@+id/siq_status_bar_view"
            app:popupTheme="?attr/siq_pop_menu_style"
            style="?attr/siq_image_viewer_toolbar_style"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_view_shared_element_transition"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:minHeight="@dimen/siq_160"
            android:transitionName="chatImageTransition"
            android:elevation="@dimen/siq_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zoho.livechat.android.ui.ImagePager
            android:id="@+id/siq_imagepager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="@dimen/siq_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
