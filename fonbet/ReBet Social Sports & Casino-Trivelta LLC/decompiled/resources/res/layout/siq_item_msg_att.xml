<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_msg_att_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/top_spacer_view_card"
        android:layout_width="0dp"
        android:layout_height="@dimen/siq_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/replied_message_background"/>
    <View
        android:id="@+id/siq_file_background_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/siq_2"
        android:layout_marginRight="@dimen/siq_2"
        android:layout_marginBottom="-10dp"
        android:layout_marginHorizontal="@dimen/siq_2"
        app:layout_constraintBottom_toBottomOf="@+id/siq_file_details_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_spacer_view_card"/>
    <RelativeLayout
        android:id="@+id/siq_att_download_parent"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="@dimen/siq_12"
        app:layout_constraintBottom_toBottomOf="@+id/siq_file_details_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/siq_file_details_layout">
        <RelativeLayout
            android:id="@+id/siq_att_icon_parent"
            android:visibility="gone"
            android:layout_width="42dp"
            android:layout_height="42dp">
            <ImageView
                android:id="@+id/siq_att_icon"
                app:srcCompat="@drawable/ic_salesiq_file_filled"
                style="@style/SalesIQ.Style.chatwindow_file_image"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/siq_att_download_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/siq_att_action_icon"
                app:srcCompat="@drawable/salesiq_download_arrow"
                style="@style/SalesIQ.Style.chatwindow_action_icon"/>
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/siq_att_progressbar"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:max="100"
                android:indeterminate="true"
                android:layout_centerInParent="true"
                android:layout_centerHorizontal="true"
                android:indeterminateTint="@color/siq_white"
                app:indicatorSize="@dimen/siq_38"
                app:trackCornerRadius="@dimen/siq_2"
                app:trackThickness="@dimen/siq_3"/>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="top"
        android:orientation="vertical"
        android:id="@+id/siq_file_details_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/siq_12"
        android:layout_marginTop="@dimen/siq_10"
        android:layout_marginRight="@dimen/siq_12"
        android:layout_toEndOf="@+id/siq_att_download_parent"
        android:layout_marginHorizontal="@dimen/siq_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/siq_att_download_parent"
        app:layout_constraintTop_toBottomOf="@+id/top_spacer_view_card">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/siq_att_name"
                style="@style/SalesIQ.Style.chatwindow_attachment_name_text"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/siq_4">
                <TextView
                    android:id="@+id/siq_att_size"
                    style="@style/SalesIQ.Style.chatwindow_attachment_size_text"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/siq_att_file_dot_separator"
                    android:background="@drawable/salesiq_badge_background"
                    android:layout_width="@dimen/siq_4"
                    android:layout_height="@dimen/siq_4"
                    android:layout_marginStart="@dimen/siq_6"/>
                <TextView
                    android:id="@+id/siq_att_file_ext"
                    style="@style/SalesIQ.Style.chatwindow_file_extension_text"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/siq_att_status_layout"
        android:background="?attr/siq_backgroundcolor"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="@dimen/siq_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_4"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_file_background_view">
        <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
            android:id="@+id/siq_attachment_message_edited_text"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/siq_att_timeView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SalesIQ.Style.message_bubble_edited_text"/>
        <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
            android:id="@+id/siq_att_timeView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/siq_att_status_icon"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/siq_attachment_message_edited_text"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SalesIQ.Style.chatwindow_time_textcolor_operator"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/siq_att_status_icon"
            android:visibility="gone"
            android:layout_marginStart="@dimen/siq_4"
            app:layout_constraintBottom_toBottomOf="@+id/siq_att_timeView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/siq_att_timeView"
            app:layout_constraintTop_toTopOf="@+id/siq_att_timeView"
            style="@style/SalesIQ.Style.ChatWindow_Message_Status_Icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/connector_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_file_background_view"/>
    <include layout="@layout/siq_item_message_text_with_status_merge_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
