<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/talk_sdk_android_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_talk_sdk_android_close_24"
        android:scaleType="center"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface"/>
    <FrameLayout
        android:id="@+id/talk_sdk_android_call_setup_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/talk_sdk_android_margin_medium"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/talk_sdk_android_setup_indicator"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/talk_sdk_android_close"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/talk_sdk_android_setup_indicator"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginBottom="@dimen/talk_sdk_android_margin_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:tabBackground="@drawable/talk_sdk_android_dots_selector"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
