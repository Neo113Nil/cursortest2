<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/siq_backgroundcolor"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:id="@+id/siq_suggestion_parent"
        style="@style/SalesIQ.Style.chatwindow_suggestion_parent">
        <RelativeLayout
            android:id="@+id/siq_suggestion_view"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
                android:id="@+id/siq_suggestion_text"
                style="@style/SalesIQ.Style.chatwindow_suggestions_text"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
