<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/siq_backgroundcolor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/siq_category_view"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/siq_articles_emptystate"
        android:background="?attr/siq_emptyview_backgroundcolor"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/siq_empty_state_icon"
        android:src="?attr/siq_knowledge_base_articles_empty_state"
        app:layout_constraintBottom_toTopOf="@+id/siq_empty_state_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/SalesIQ.Style.articles_emptyview_image"/>
    <TextView
        android:id="@+id/siq_empty_state_text"
        android:text="@string/articles.emptystate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_empty_state_icon"
        style="@style/SalesIQ.Style.articles_emptystate_text"/>
    <ProgressBar
        android:id="@+id/siq_articles_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.ProgressBar.articles"/>
</androidx.constraintlayout.widget.ConstraintLayout>
