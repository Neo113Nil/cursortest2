<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_chat_card_type_links"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/siq_chat_card_image"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginHorizontal="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.Style.chatwindow_widget_image"/>
    <View
        android:id="@+id/connector_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image"/>
    <include layout="@layout/siq_item_message_text_merge_layout"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/siq_chat_card_links_list"
        android:background="@drawable/salesiq_links_list_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/siq_2"
        android:layout_marginRight="@dimen/siq_2"
        android:layout_marginBottom="@dimen/siq_2"
        android:layout_marginHorizontal="@dimen/siq_2"
        app:layout_constraintBottom_toTopOf="@+id/siq_chat_card_links_actionlist_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_message_text"
        app:layout_constraintVertical_chainStyle="packed"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/siq_chat_card_links_actionlist_parent"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/siq_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_links_list">
        <LinearLayout
            android:id="@+id/siq_chat_card_links_actionlist_layout"
            android:background="@drawable/salesiq_actions_card_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/siq_2"
            android:layout_marginRight="@dimen/siq_2"
            android:layout_marginBottom="@dimen/siq_2"
            android:layout_marginHorizontal="@dimen/siq_2">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/siq_chat_card_links_actionlist"
                android:background="@drawable/salesiq_actions_card_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
