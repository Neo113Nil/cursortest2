<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_msg_img_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/top_spacer_view_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/siq_2"
        app:layout_constraintTop_toBottomOf="@+id/replied_message_background"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/siq_msg_att_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:minHeight="@dimen/siq_160"
        android:transitionName="chatImageTransition"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_scrim_view"
        app:layout_constraintDimensionRatio="H,3:2"
        app:layout_constraintEnd_toEndOf="@+id/gradient_scrim_view"
        app:layout_constraintStart_toStartOf="@+id/gradient_scrim_view"
        app:layout_constraintTop_toTopOf="@+id/gradient_scrim_view"/>
    <View
        android:id="@+id/scrim_view"
        android:background="?attr/siq_ripple_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_scrim_view"
        app:layout_constraintDimensionRatio="H,3:2"
        app:layout_constraintEnd_toEndOf="@+id/gradient_scrim_view"
        app:layout_constraintStart_toStartOf="@+id/gradient_scrim_view"
        app:layout_constraintTop_toTopOf="@+id/gradient_scrim_view"/>
    <View
        android:id="@+id/gradient_scrim_view"
        android:background="?attr/siq_ripple_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/siq_2"
        android:layout_marginRight="@dimen/siq_2"
        android:layout_marginBottom="@dimen/siq_2"
        android:layout_marginHorizontal="@dimen/siq_2"
        app:layout_constraintDimensionRatio="H,3:2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_spacer_view_card"/>
    <View
        android:id="@+id/siq_msg_att_img_blur"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_scrim_view"
        app:layout_constraintDimensionRatio="H,3:2"
        app:layout_constraintEnd_toEndOf="@+id/gradient_scrim_view"
        app:layout_constraintStart_toStartOf="@+id/gradient_scrim_view"
        app:layout_constraintTop_toTopOf="@+id/gradient_scrim_view"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_scrim_view"
        app:layout_constraintEnd_toEndOf="@+id/gradient_scrim_view"
        app:layout_constraintStart_toStartOf="@+id/gradient_scrim_view"
        app:layout_constraintTop_toTopOf="@+id/gradient_scrim_view"
        layout="@layout/salesiq_center_image_message_action_view"/>
    <RelativeLayout
        android:id="@+id/siq_attachment_detail_parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/siq_8"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/siq_10"
        android:layout_alignParentStart="true"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_scrim_view"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/siq_attachment_icon"
            android:layout_width="@dimen/siq_18"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/siq_attachment_detail_text"
            android:layout_alignBottom="@+id/siq_attachment_detail_text"
            android:layout_alignParentStart="true"/>
        <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
            android:textSize="@dimen/siq_text_12"
            android:id="@+id/siq_attachment_detail_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/siq_text_4"
            android:layout_marginStart="@dimen/siq_4"
            android:layout_toEndOf="@+id/siq_attachment_icon"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/siq_image_status_parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/siq_8"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/siq_14"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_scrim_view"
        app:layout_constraintEnd_toEndOf="parent">
        <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
            android:id="@+id/siq_image_message_edited"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SalesIQ.Style.message_bubble_edited_text"/>
        <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
            android:textSize="@dimen/siq_text_12"
            android:id="@+id/siq_image_timeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/siq_image_message_edited"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/siq_image_status_icon"
            app:layout_constraintBottom_toBottomOf="@+id/siq_image_timeView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/siq_image_timeView"
            app:layout_constraintTop_toTopOf="@+id/siq_image_timeView"
            app:srcCompat="@drawable/ic_salesiq_mobilisten_tick"
            style="@style/SalesIQ.Style.ChatWindow_Message_Status_Icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/bottom_spacer_view_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/siq_2"
        app:layout_constraintTop_toBottomOf="@+id/gradient_scrim_view"/>
    <View
        android:id="@+id/connector_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gradient_scrim_view"/>
    <include layout="@layout/siq_item_message_text_with_status_merge_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
