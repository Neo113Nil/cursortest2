<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_chat_card_type_input_email"
    android:paddingLeft="@dimen/siq_2"
    android:paddingRight="@dimen/siq_2"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/siq_2">
    <ImageView
        android:id="@+id/siq_chat_card_image"
        android:layout_width="0dp"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.Style.chatwindow_widget_image"/>
    <View
        android:id="@+id/connector_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image"/>
    <include layout="@layout/siq_item_message_text_merge_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/siq_chat_card_input_email_parent"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        app:layout_constraintTop_toBottomOf="@+id/siq_message_text">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/siq_chat_card_input_email_edittext"
                android:maxLines="1"
                android:inputType="textEmailAddress"
                style="@style/SalesIQ.Style.forms_input_email_edittext"/>
            <RelativeLayout
                android:id="@+id/siq_chat_card_input_send_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="34dp"
                android:layout_height="44dp"
                android:layout_marginRight="1dp"
                android:layout_alignRight="@+id/siq_chat_card_input_email_edittext"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="1dp"
                android:layout_alignEnd="@+id/siq_chat_card_input_email_edittext"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    app:srcCompat="@drawable/salesiq_widget_input_send"/>
            </RelativeLayout>
        </RelativeLayout>
        <TextView
            android:id="@+id/siq_chat_card_input_errorview"
            style="@style/SalesIQ.Style.forms_email_error_text"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/siq_text_12"
        android:id="@+id/siq_input_email_timetextview"
        android:paddingLeft="@dimen/siq_12"
        android:paddingRight="@dimen/siq_12"
        android:paddingBottom="@dimen/siq_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/siq_12"
        android:paddingEnd="@dimen/siq_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_input_email_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
