<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_base_message_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/time_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="siq_time_middle_layout_textview, time_view_spacer"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textSize="@dimen/siq_text_12"
        android:textColor="?attr/siq_text_secondary_color"
        android:layout_gravity="center"
        android:id="@+id/siq_time_middle_layout_textview"
        android:paddingLeft="@dimen/siq_10"
        android:paddingTop="@dimen/siq_4"
        android:paddingRight="@dimen/siq_10"
        android:paddingBottom="@dimen/siq_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/siq_text_4"
        android:paddingHorizontal="@dimen/siq_10"
        android:paddingVertical="@dimen/siq_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/time_view_spacer"
        android:layout_width="1dp"
        android:layout_height="@dimen/siq_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_time_middle_layout_textview"/>
    <View
        android:id="@+id/top_spacer_view"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/siq_1"
        app:layout_constraintTop_toBottomOf="@+id/time_view_spacer"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:gravity="top"
        android:id="@+id/siq_sender_name"
        android:tag="swipeable_sender_name_view_for_reply"
        android:paddingTop="@dimen/siq_4"
        android:paddingBottom="@dimen/siq_4"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_spacer_view"
        style="@style/SalesIQ.Style.chatwindow_sender_name_textcolor_operator"/>
    <ImageView
        android:id="@+id/siq_sender_avatar"
        android:tag="swipeable_sender_image_view_for_reply"
        android:visibility="gone"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_sender_name"
        style="@style/SalesIQ.Style.chatwindow_sender_avatar_left"/>
    <ImageView
        android:id="@+id/siq_message_status_failed"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="@dimen/siq_12"
        android:layout_marginRight="@dimen/siq_12"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/siq_8"
        android:layout_marginHorizontal="@dimen/siq_12"
        app:srcCompat="@drawable/salesiq_failed_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
