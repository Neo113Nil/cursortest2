<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_chat_card_type_phrases"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constrainedWidth="true"
    app:layout_constraintWidth="match_constraint"
    app:layout_constraintWidth_min="wrap">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/siq_phrases_card_content_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth="match_constraint"
        app:layout_constraintWidth_min="wrap">
        <ImageView
            android:id="@+id/siq_chat_card_image"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginHorizontal="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SalesIQ.Style.chatwindow_widget_image"/>
        <View
            android:id="@+id/connector_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image"/>
        <include layout="@layout/siq_item_message_text_merge_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/siq_phrases_flowlayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_10"
        app:alignContent="flex_start"
        app:alignItems="flex_start"
        app:dividerDrawableHorizontal="@drawable/flexbox_horizontal_divider"
        app:dividerDrawableVertical="@drawable/flexbox_vertical_divider"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_phrases_card_content_layout"
        app:layout_constraintWidth="match_constraint"
        app:layout_constraintWidth_min="wrap"
        app:showDividerHorizontal="middle"
        app:showDividerVertical="middle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
