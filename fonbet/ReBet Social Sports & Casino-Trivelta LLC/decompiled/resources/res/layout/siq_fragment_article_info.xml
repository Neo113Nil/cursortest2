<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/siq_backgroundcolor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/siq_article_bottom_view"
        android:background="?attr/siq_backgroundcolor"
        android:paddingBottom="@dimen/siq_15"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_alignParentBottom="true">
        <View
            android:id="@+id/siq_article_bottom_view_shadow"
            android:background="?attr/siq_divider_color"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/siq_articles_thanks_for_feedback"
            android:id="@+id/siq_thanks_feedback"
            android:paddingTop="@dimen/siq_2"
            android:paddingBottom="@dimen/siq_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/siq_16"
            android:layout_marginTop="@dimen/siq_15"
            android:layout_marginRight="@dimen/siq_16"
            android:text="@string/articles.feedback.thanks"
            android:layout_below="@+id/siq_article_bottom_view_shadow"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="@dimen/siq_16"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/siq_like_layout"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/siq_15"
            android:layout_below="@+id/siq_article_bottom_view_shadow"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/siq_16"
            android:layout_alignParentStart="true">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/siq_like_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/salesiq_vector_like"/>
                <ImageView
                    android:id="@+id/siq_like_icon_selected"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>
            </RelativeLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/siq_like_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/siq_dislike_layout"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/siq_15"
            android:layout_toRightOf="@+id/siq_like_layout"
            android:layout_below="@+id/siq_article_bottom_view_shadow"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/siq_16"
            android:layout_toEndOf="@+id/siq_like_layout">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/siq_dislike_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/salesiq_vector_dislike"/>
                <ImageView
                    android:id="@+id/siq_dislike_icon_selected"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>
            </RelativeLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/siq_dislike_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/siq_article_content_parent"
        android:background="?attr/siq_backgroundcolor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/siq_article_bottom_view">
        <com.zoho.livechat.android.ui.customviews.ArticleWebView
            android:id="@+id/siq_article_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/siq_articles_progress"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:indeterminate="true"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:backgroundTint="?attr/colorPrimary"/>
</RelativeLayout>
