<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zoho.livechat.android.ui.customviews.ZoomableImageView
        android:id="@+id/siq_imagepreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_imgpreview_top"/>
    <RelativeLayout
        android:id="@+id/siq_imgpreview_top"
        android:background="#99000000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/siq_toolbar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/siq_imgpreview_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            app:srcCompat="@drawable/salesiq_vector_cancel_light"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/siq_imgpreview_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/siq_imgpreview_back"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/siq_imagepreview_send_layout"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="@dimen/siq_16"
        app:layout_constraintBottom_toBottomOf="@+id/siq_imagepreview"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/siq_imagepreview_send_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
