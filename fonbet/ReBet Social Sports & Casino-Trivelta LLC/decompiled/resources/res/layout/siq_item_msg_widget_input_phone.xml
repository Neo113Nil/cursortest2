<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/siq_chat_card_type_input_phone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/siq_chat_message_backgroundcolor_operator"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_chat_card_image"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginHorizontal="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SalesIQ.Style.chatwindow_widget_image"/>
            <View
                android:id="@+id/connector_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image"/>
            <include layout="@layout/siq_item_message_text_merge_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/siq_chat_card_input_phone_parent"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                app:layout_constraintTop_toBottomOf="@+id/siq_message_text">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/siq_chat_card_input_ccode"
                        android:background="?attr/siq_chat_card_button_backgroundcolor"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp">
                        <TextView
                            android:id="@+id/siq_chat_card_input_ccode_text"
                            style="@style/SalesIQ.Style.forms_input_countrycode_text"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/siq_chat_card_input_ccode_dropdown"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:srcCompat="@drawable/salesiq_ic_dropdown"/>
                        <View
                            android:layout_gravity="center_vertical"
                            android:background="?attr/siq_chat_message_inputcard_separatorcolor"
                            android:layout_width="1.5dp"
                            android:layout_height="38dp"
                            android:layout_marginLeft="@dimen/siq_6"
                            android:layout_marginStart="@dimen/siq_6"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/siq_chat_card_input_phone_edittext"
                        android:maxLines="1"
                        android:layout_toRightOf="@+id/siq_chat_card_input_ccode"
                        android:inputType="phone"
                        android:layout_toEndOf="@+id/siq_chat_card_input_ccode"
                        style="@style/SalesIQ.Style.forms_input_phone_edittext"/>
                    <RelativeLayout
                        android:id="@+id/siq_chat_card_input_send_button"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="34dp"
                        android:layout_height="44dp"
                        android:layout_marginRight="1dp"
                        android:layout_alignRight="@+id/siq_chat_card_input_phone_edittext"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="1dp"
                        android:layout_alignEnd="@+id/siq_chat_card_input_phone_edittext"
                        android:layout_alignParentEnd="true">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerInParent="true"
                            app:srcCompat="@drawable/salesiq_widget_input_send"/>
                    </RelativeLayout>
                </RelativeLayout>
                <TextView
                    android:id="@+id/siq_chat_card_input_errorview"
                    style="@style/SalesIQ.Style.forms_phone_error_text"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/siq_text_12"
                android:id="@+id/siq_input_phone_timetextview"
                android:paddingLeft="@dimen/siq_12"
                android:paddingRight="@dimen/siq_14"
                android:paddingBottom="@dimen/siq_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/siq_12"
                android:paddingEnd="@dimen/siq_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_input_phone_parent"
                style="@style/SalesIQ.Style.chatwindow_time_textcolor_operator"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
