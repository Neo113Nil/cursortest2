<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/siq_dialog_background_color"
    android:padding="@dimen/siq_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:id="@+id/siq_title_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.Style.alert_dialog_text"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:id="@+id/siq_sub_title_text_view"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_title_text_view"
        style="@style/SalesIQ.Style.alert_dialog_sub_text"/>
    <androidx.constraintlayout.widget.Placeholder
        android:id="@+id/siq_alert_dialog_content_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/siq_sub_title_text_view"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:id="@+id/siq_positive_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_alert_dialog_content_placeholder"
        app:textTypeface="medium"
        style="@style/SalesIQ.Style.alert_dialog_positive_button"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:id="@+id/siq_negative_button"
        app:layout_constraintBottom_toBottomOf="@+id/siq_positive_button"
        app:layout_constraintEnd_toStartOf="@+id/siq_positive_button"
        app:layout_constraintTop_toTopOf="@+id/siq_positive_button"
        app:textTypeface="medium"
        style="@style/SalesIQ.Style.alert_dialog_negative_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
