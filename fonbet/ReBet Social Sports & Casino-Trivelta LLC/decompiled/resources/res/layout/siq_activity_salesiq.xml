<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_layout"
    android:background="?attr/siq_backgroundcolor"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/siq_conversations_scrim_view"
        android:background="@color/siq_fab_background_scrim_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="1dp"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/siq_conversations_progress_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/siq_24"
        android:maxHeight="@dimen/siq_24"
        android:scaleX="0.6667"
        android:scaleY="0.6667"
        android:elevation="@dimen/siq_10"
        android:indeterminateTint="?attr/siq_primary_white_color"/>
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/siq_app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:backgroundTint="?attr/siq_statusbar_color"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/siq_live_chat_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/siq_toolbar_height"
            android:layout_marginTop="@dimen/siq_30"
            android:minHeight="@dimen/siq_toolbar_height"
            android:elevation="0dp"
            app:popupTheme="?attr/siq_pop_menu_style"
            style="?attr/siq_toolbar_style"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/child_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/siq_toolbar_separator"
            android:background="?attr/siq_toolbar_divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/siq_offline_message"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:text="@string/livechat.messages.offline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siq_toolbar_separator"
            style="@style/SalesIQ.Style.conversation_offline_message_text"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/siq_top_barrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="siq_toolbar_separator,siq_offline_message"/>
        <com.zoho.livechat.android.ui.customviews.CustomViewPager
            android:id="@+id/siq_viewpager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/siq_bottom_tab_separator"
            app:layout_constraintHeight="match_constraint"
            app:layout_constraintTop_toBottomOf="@+id/siq_top_barrier"/>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/siq_fragment_container_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/siq_bottom_tab_separator"
            app:layout_constraintHeight="match_constraint"
            app:layout_constraintTop_toBottomOf="@+id/siq_top_barrier"/>
        <View
            android:id="@+id/siq_bottom_tab_separator"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="0.1dp"
            app:layout_constraintBottom_toTopOf="@+id/siq_tabview"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/siq_tabview"
            android:background="?attr/siq_tabbar_backgroundcolor"
            app:layout_constraintBottom_toTopOf="@+id/siq_bottom_navigation_separator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tabBackground="@drawable/salesiq_tab_indicator"
            style="@style/SalesIQ.Style.tablayout"/>
        <View
            android:id="@+id/siq_bottom_navigation_separator"
            android:background="?attr/siq_divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenToggleFAB
        android:layout_gravity="end|bottom"
        android:id="@+id/siq_fab_container"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationZ="@dimen/siq_10"
        android:elevation="@dimen/siq_10"
        app:layout_anchor="@+id/siq_bottom_tab_separator"
        app:layout_anchorGravity="end|bottom"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
