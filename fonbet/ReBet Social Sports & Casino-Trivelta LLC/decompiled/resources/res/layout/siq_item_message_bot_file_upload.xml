<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_bot_file_upload_layout_parent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/siq_bot_file_upload_background_image"
        android:layout_marginLeft="@dimen/siq_2"
        android:layout_marginTop="@dimen/siq_2"
        android:layout_marginRight="@dimen/siq_2"
        android:src="@drawable/ic_mobilisten_chat"
        android:layout_marginHorizontal="@dimen/siq_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.Style.chatwindow_widget_image"/>
    <View
        android:id="@+id/connector_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_bot_file_upload_background_image"/>
    <include layout="@layout/siq_item_message_text_merge_layout"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/siq_bot_file_upload_button_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="siq_bot_file_upload_button_text,siq_bot_file_upload_button_view,siq_bot_file_upload_icon_image_view"/>
    <View
        android:id="@+id/siq_bot_file_upload_button_view"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="@dimen/siq_2"
        android:layout_marginRight="@dimen/siq_2"
        android:layout_marginBottom="@dimen/siq_2"
        android:layout_marginHorizontal="@dimen/siq_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_message_text"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/siq_bot_file_upload_icon_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_upload"
        app:layout_constraintBottom_toBottomOf="@+id/siq_bot_file_upload_button_view"
        app:layout_constraintEnd_toStartOf="@+id/siq_bot_file_upload_button_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/siq_bot_file_upload_button_view"
        app:tint="?attr/colorAccent"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:textColor="?attr/colorAccent"
        android:id="@+id/siq_bot_file_upload_button_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mobilisten_file_upload"
        android:layout_marginStart="@dimen/siq_8"
        app:layout_constraintBottom_toBottomOf="@+id/siq_bot_file_upload_button_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siq_bot_file_upload_icon_image_view"
        app:layout_constraintTop_toTopOf="@+id/siq_bot_file_upload_button_view"
        app:textTypeface="medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
