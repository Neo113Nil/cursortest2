<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/siq_chat_card_type_single_product"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/siq_chat_message_backgroundcolor_operator"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/siq_chat_card_text_parent"
            android:background="?attr/siq_backgroundcolor"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/connector_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <include layout="@layout/siq_item_message_text_merge_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/siq_chat_card_images_list_parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/siq_message_text">
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/siq_chat_card_images_list_layout"
                    android:background="?attr/siq_chat_message_backgroundcolor_operator"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/siq_170">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/siq_chat_card_images_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:layout_gravity="bottom|center_horizontal"
                        android:id="@+id/scrollingIndicatorParent"
                        android:padding="@dimen/siq_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/siq_6">
                        <com.zoho.commons.PagerScrollingIndicator
                            android:id="@+id/scrollingIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </FrameLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:id="@+id/siq_chat_card_description_text_parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/siq_chat_card_title_text"
                        android:layout_width="0dp"
                        android:layout_marginLeft="@dimen/siq_14"
                        android:layout_marginTop="@dimen/siq_8"
                        android:layout_marginRight="@dimen/siq_14"
                        android:layout_marginHorizontal="@dimen/siq_14"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/SalesIQ.Style.chatwindow_widget_title_text"/>
                    <View
                        android:id="@+id/spacer"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/siq_4"
                        app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_title_text"/>
                    <View
                        android:id="@+id/connector_view_alternative"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/spacer"/>
                    <include layout="@layout/siq_item_message_text_merge_layout_alternative"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/siq_chat_card_actions_list"
                    android:background="@drawable/salesiq_links_list_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
