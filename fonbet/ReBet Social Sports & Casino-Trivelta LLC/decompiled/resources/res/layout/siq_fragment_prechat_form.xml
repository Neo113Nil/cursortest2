<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/siq_pre_chat_form_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_gravity="center"
        android:id="@+id/siq_pre_chat_form_progress"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorAccent"
        app:indicatorSize="@dimen/siq_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackCornerRadius="@dimen/siq_3"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/siq_form_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/siq_submit_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenButton
        android:id="@+id/siq_submit_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/livechat.prechatform.submit"
        app:buttonTextTypeface="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_form_recycler_view"
        style="@style/SalesIQ.Layout.forms_submit"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/siq_form_submit_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateOnly="true"
        android:elevation="@dimen/siq_5"
        android:indeterminateTint="@color/siq_white"
        app:indicatorColor="@color/siq_white"
        app:indicatorSize="@dimen/siq_24"
        app:layout_constraintBottom_toBottomOf="@+id/siq_submit_button"
        app:layout_constraintEnd_toEndOf="@+id/siq_submit_button"
        app:layout_constraintStart_toStartOf="@+id/siq_submit_button"
        app:layout_constraintTop_toTopOf="@+id/siq_submit_button"
        app:trackCornerRadius="@dimen/siq_2"
        app:trackThickness="2dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
