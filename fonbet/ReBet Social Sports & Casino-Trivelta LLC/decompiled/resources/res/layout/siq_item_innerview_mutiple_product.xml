<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/siq_widget_guide_line_begin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/siq_52"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/siq_chat_card_images_parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siq_widget_guide_line_begin"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:id="@+id/siq_chat_card_image_parent_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/siq_170"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/siq_chat_card_image"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </LinearLayout>
        <TextView
            android:id="@+id/siq_chat_card_title_text"
            android:paddingLeft="@dimen/siq_14"
            android:paddingTop="@dimen/siq_10"
            android:paddingRight="@dimen/siq_14"
            android:paddingHorizontal="@dimen/siq_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image_parent_layout"
            style="@style/SalesIQ.Style.chatwindow_widget_title_text"/>
        <TextView
            android:id="@+id/siq_chat_card_subtitle_text"
            android:paddingLeft="@dimen/siq_14"
            android:paddingTop="@dimen/siq_10"
            android:paddingRight="@dimen/siq_14"
            android:paddingBottom="@dimen/siq_9"
            android:paddingHorizontal="@dimen/siq_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_title_text"
            style="@style/SalesIQ.Style.chatwindow_widget_subtitle_text"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/siq_chat_card_actions_list"
            android:background="@drawable/salesiq_links_list_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_subtitle_text"
            app:layout_constraintVertical_bias="1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
