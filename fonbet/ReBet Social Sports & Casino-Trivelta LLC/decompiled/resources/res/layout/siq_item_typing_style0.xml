    android:layout_height="32dp">
    <View
        android:id="@+id/siq_typing_circle1"
        android:layout_marginStart="@dimen/siq_14"
        style="@style/SalesIQ.View.typing_indication"/>
    <View
        android:id="@+id/siq_typing_circle2"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"
        style="@style/SalesIQ.View.typing_indication"/>
    <View
