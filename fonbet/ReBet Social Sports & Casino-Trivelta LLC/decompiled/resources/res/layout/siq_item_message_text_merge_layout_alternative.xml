<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:id="@+id/siq_message_alternative_text"
        android:paddingLeft="@dimen/siq_14"
        android:paddingTop="@dimen/siq_10"
        android:paddingRight="@dimen/siq_14"
        android:paddingBottom="@dimen/siq_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/siq_14"
        android:paddingVertical="@dimen/siq_10"
        app:layout_constraintEnd_toEndOf="@+id/connector_view_alternative"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/connector_view_alternative"
        app:layout_constraintTop_toBottomOf="@+id/connector_view_alternative"
        style="@style/Theme.SalesIQ.TextStyle.Message"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:id="@+id/siq_message_alternative_time_text_view"
        android:layout_marginBottom="@dimen/siq_10"
        android:layout_marginEnd="@dimen/siq_14"
        app:layout_constraintBottom_toBottomOf="@+id/siq_message_alternative_text"
        app:layout_constraintEnd_toEndOf="@+id/connector_view_alternative"
        style="@style/SalesIQ.Style.chatwindow_time_textcolor_operator"/>
</merge>
