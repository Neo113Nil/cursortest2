<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/siq_chat_card_type_input_url"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/siq_chat_message_backgroundcolor_operator"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/siq_chat_card_image"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginHorizontal="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SalesIQ.Style.chatwindow_widget_image"/>
            <View
                android:id="@+id/connector_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_image"/>
            <include layout="@layout/siq_item_message_text_merge_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/siq_chat_card_input_url_parent"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                app:layout_constraintTop_toBottomOf="@+id/siq_message_text">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?attr/siq_hint_textcolor"
                        android:gravity="start|center_vertical"
                        android:id="@+id/siq_chat_card_input_url_edittext"
                        android:paddingLeft="16dp"
                        android:paddingRight="50dp"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:maxLines="1"
                        android:inputType="textUri"
                        android:paddingStart="16dp"
                        android:paddingEnd="50dp"/>
                    <RelativeLayout
                        android:id="@+id/siq_chat_card_input_send_button"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="34dp"
                        android:layout_height="44dp"
                        android:layout_marginRight="1dp"
                        android:layout_alignRight="@+id/siq_chat_card_input_url_edittext"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="1dp"
                        android:layout_alignEnd="@+id/siq_chat_card_input_url_edittext"
                        android:layout_alignParentEnd="true">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerInParent="true"
                            app:srcCompat="@drawable/salesiq_widget_input_send"/>
                    </RelativeLayout>
                </RelativeLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ff002e"
                    android:id="@+id/siq_chat_card_input_errorview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/siq_text_12"
                android:id="@+id/siq_input_url_timetextview"
                android:paddingLeft="@dimen/siq_12"
                android:paddingRight="@dimen/siq_14"
                android:paddingBottom="@dimen/siq_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/siq_12"
                android:paddingEnd="@dimen/siq_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/siq_chat_card_input_url_parent"
                style="@style/SalesIQ.Style.chatwindow_time_textcolor_operator"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
