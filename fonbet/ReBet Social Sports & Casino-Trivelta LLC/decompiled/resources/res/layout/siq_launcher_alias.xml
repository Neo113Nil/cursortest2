<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end|bottom"
    android:id="@+id/siq_launcher_alias_parent_layout"
    android:background="@android:color/transparent"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:hapticFeedbackEnabled="true"
    android:animateLayoutChanges="false"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent">
    <com.zoho.livechat.android.ui.customviews.SalesIQFloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/siq_base_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_16"
        android:layout_marginBottom="@dimen/siq_16"
        android:hapticFeedbackEnabled="true"
        android:layout_marginStart="@dimen/siq_16"
        android:layout_marginEnd="@dimen/siq_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:gravity="center"
        android:id="@+id/siq_badge_count"
        android:padding="@dimen/siq_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/siq_18"
        android:minHeight="@dimen/siq_18"
        android:textAlignment="center"
        android:elevation="@dimen/siq_15"
        app:layout_constraintBottom_toTopOf="@+id/siq_base_fab"
        app:layout_constraintEnd_toStartOf="@+id/siq_base_fab"
        app:layout_constraintStart_toStartOf="@+id/siq_base_fab"
        app:layout_constraintTop_toTopOf="@+id/siq_base_fab"
        app:textTypeface="medium"
        style="@style/SalesIQ.Style.launcher_textview"/>
</androidx.constraintlayout.widget.ConstraintLayout>
