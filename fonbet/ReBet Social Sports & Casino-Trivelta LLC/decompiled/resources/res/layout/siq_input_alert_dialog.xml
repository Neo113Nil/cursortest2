<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/siq_dialog_background_color"
    android:padding="@dimen/siq_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:id="@+id/siq_title_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SalesIQ.Style.alert_dialog_text"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenTextView
        android:id="@+id/siq_sub_title_text_view"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_title_text_view"
        style="@style/SalesIQ.Style.alert_dialog_sub_text"/>
    <EditText
        android:id="@+id/siq_edit_text"
        android:padding="@dimen/siq_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/siq_36"
        app:layout_constraintTop_toBottomOf="@+id/siq_sub_title_text_view"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenButton
        android:id="@+id/siq_positive_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:buttonTextTypeface="medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_edit_text"
        style="@style/SalesIQ.Style.Input.AlertDialog.Positive.Button"/>
    <com.zoho.livechat.android.modules.common.ui.views.MobilistenButton
        android:id="@+id/siq_negative_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:buttonTextTypeface="medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siq_positive_button"
        style="@style/SalesIQ.Style.Input.AlertDialog.Negative.Button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
