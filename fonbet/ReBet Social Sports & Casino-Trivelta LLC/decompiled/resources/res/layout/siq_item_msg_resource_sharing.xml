<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resourceview_parent"
    android:paddingLeft="@dimen/siq_1"
    android:paddingRight="@dimen/siq_1"
    android:paddingBottom="@dimen/siq_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/siq_1">
    <View
        android:id="@+id/top_spacer_view_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/siq_1"
        app:layout_constraintTop_toBottomOf="@+id/replied_message_background"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/resourceview_layout"
        android:paddingLeft="@dimen/siq_15"
        android:paddingTop="@dimen/siq_15"
        android:paddingRight="@dimen/siq_15"
        android:paddingBottom="@dimen/siq_10"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/siq_15"
        android:paddingEnd="@dimen/siq_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_spacer_view_card"
        app:layout_constraintWidth="match_constraint"
        app:layout_constraintWidth_min="wrap">
        <TextView
            android:id="@+id/resource_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/livechat.common.article"/>
        <TextView
            android:id="@+id/resource_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/siq_15"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/siq_15">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/creator_profile_icon"
                android:background="@drawable/salesiq_circle_bg"
                android:layout_width="@dimen/siq_20"
                android:layout_height="@dimen/siq_20"
                app:srcCompat="@drawable/salesiq_operator_default_light"/>
            <TextView
                android:id="@+id/creator_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/siq_10"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/siq_10"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="end"
            android:id="@+id/siq_resource_sharing_status_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/siq_resource_sharing_timetextview"
                style="@style/SalesIQ.Style.chatwindow_time_textcolor_operator"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
