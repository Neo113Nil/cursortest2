<?xml version="1.0" encoding="utf-8"?>
<!--
  Prevents R8 optimized resource shrinking (AGP 9.0+) from stripping Braze config
  resources. The SDK reads these via Resources.getIdentifier() at runtime, so R8
  cannot detect usage. See ConfigField in BrazeConfigurationProvider and
  CachedConfigurationProvider.getResourceIdentifier(). Legacy com_appboy_* names
  are kept for hosts that still use appboy.xml (fallback in getFallbackConfigKey).
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="
        @string/com_braze_*,
        @string/com_appboy_*,
        @integer/com_braze_*,
        @integer/com_appboy_*,
        @bool/com_braze_*,
        @bool/com_appboy_*,
        @color/com_braze_*,
        @color/com_appboy_*,
        @array/com_braze_*,
        @array/com_appboy_*,
        @drawable/com_braze_*,
        @drawable/com_appboy_*
    " />

