<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ru.yandex.music.ui.view.AspectRatioLayout
        android:theme="@style/AppTheme.Dark"
        android:id="@+id/cover_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        app:dimensionPart="0.444">
        <ru.yandex.music.ui.view.SquareFrameLayout
            android:theme="@style/AppTheme.PoliteRipple"
            android:background="@null"
            android:addStatesFromChildren="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?attr/selectableItemBackground">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RoundedImageView50"/>
        </ru.yandex.music.ui.view.SquareFrameLayout>
    </ru.yandex.music.ui.view.AspectRatioLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cover_root"
        android:layout_alignLeft="@+id/cover_root"
        android:layout_alignRight="@+id/cover_root">
        <TextView
            android:textSize="@dimen/text_size_mid"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/unit_margin"
            android:maxLines="2"
            style="@style/PhonotekaTitle"/>
        <TextView
            android:textSize="@dimen/text_size_mid"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/PhonotekaTitleAlpha"/>
        <TextView
            android:textSize="@dimen/text_size_mid"
            android:gravity="center"
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/PhonotekaTitleAlpha"/>
    </LinearLayout>
</RelativeLayout>
