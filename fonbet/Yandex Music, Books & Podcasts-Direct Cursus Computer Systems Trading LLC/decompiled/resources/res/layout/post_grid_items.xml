<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_grid_items"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:tag="@string/bottom_player_scrolling_view_behavior"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:theme="@style/AppActionBarTheme.White"
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:outlineProvider="none"
            app:layout_behavior="ru.yandex.music.ui.FlingBehavior">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="?attr/colorPrimary"
                app:layout_scrollFlags="exitUntilCollapsed|scroll"
                app:titleEnabled="false">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.5">
                    <ru.yandex.music.ui.view.CompoundImageView
                        android:id="@+id/compound_background_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignTop="@+id/texts"
                        android:layout_alignBottom="@+id/texts"/>
                    <ImageView
                        android:id="@+id/background_img"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:layout_alignTop="@+id/texts"
                        android:layout_alignBottom="@+id/texts"/>
                    <LinearLayout
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:id="@+id/texts"
                        android:paddingTop="?attr/actionBarSize"
                        android:paddingBottom="@dimen/edge_margin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/edge_margin"
                        android:layout_marginRight="@dimen/edge_margin">
                        <TextView
                            android:textColor="?attr/textPrimary"
                            android:id="@+id/title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="30sp"
                            style="@style/Bold_HL_22_24"/>
                        <TextView
                            android:id="@+id/subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/unit_margin"
                            android:maxLines="4"
                            style="@style/PhonotekaTitle"/>
                        <TextView
                            android:textColor="?attr/textButtonColor"
                            android:id="@+id/open_full_info"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/read_promo_description"
                            android:textAllCaps="true"
                            style="@style/PhonotekaTitle"/>
                    </LinearLayout>
                </RelativeLayout>
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:outlineProvider="none"
                    app:layout_collapseMode="pin">
                    <TextView
                        android:textColor="?android:attr/textColorPrimary"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/toolbar_title"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        style="@style/Bold_Title_20_24"/>
                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:background="?android:attr/colorBackground"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            style="@style/VerticalScrollBar"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <include layout="@layout/player_informer"/>
    <include layout="@layout/player_bottom_sheet"/>
    <include layout="@layout/bottom_tabs_layout"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
