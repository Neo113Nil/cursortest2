<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dialog_menu_expanded_header_container"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.yandex.music.ui.view.RoundedOutlineProviderImageView
        android:id="@+id/bottom_dialog_expanded_header_cover"
        android:layout_width="@dimen/juicy_bottom_sheet_cover_size"
        android:layout_height="@dimen/juicy_bottom_sheet_cover_size"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:outline_corner_radius="@dimen/corner_4"/>
    <TextView
        android:id="@+id/bottom_dialog_expanded_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="4"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_dialog_expanded_header_cover"
        style="@style/Bold_20_24"/>
    <TextView
        android:textColor="?attr/textSecondary"
        android:id="@+id/bottom_dialog_expanded_header_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="4"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_dialog_expanded_header_title"
        style="@style/Medium_16_20"/>
</androidx.constraintlayout.widget.ConstraintLayout>
