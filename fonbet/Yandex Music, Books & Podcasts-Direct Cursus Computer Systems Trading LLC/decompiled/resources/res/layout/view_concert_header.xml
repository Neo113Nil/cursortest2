<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes"
    android:paddingVertical="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/textPrimary"
                android:id="@+id/day_of_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxLength="3"
                android:importantForAccessibility="no"
                style="@style/Medium_14_16"/>
            <TextView
                android:id="@+id/day_of_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:importantForAccessibility="no"
                style="@style/Bold_HL_22_24"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="?attr/textSecondary"
                android:id="@+id/month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxLength="3"
                android:importantForAccessibility="no"
                style="@style/Medium_14_16"/>
        </LinearLayout>
        <View
            android:layout_width="20dp"
            android:layout_height="0dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/textPrimary"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/concert_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:importantForAccessibility="no"
                style="@style/Bold_HL_22_24"/>
            <TextView
                android:textSize="@dimen/text_size_mid"
                android:textColor="?attr/textSecondary"
                android:id="@+id/concert_brief_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:importantForAccessibility="no"
                style="@style/Medium_14_16"/>
            <TextView
                android:textColor="?attr/textPrimary"
                android:id="@+id/concert_cashback_info"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:drawablePadding="4dp"
                android:importantForAccessibility="no"
                app:drawableStartCompat="@drawable/ic_plus_12"
                app:drawableTint="?attr/iconPrimary"
                style="@style/Medium_14_16"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="16dp"/>
    <Button
        android:textColor="@color/text_primary_day"
        android:id="@+id/purchase_ticket"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tall_material_button_height"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:minHeight="@dimen/tall_material_button_height"
        android:layout_marginHorizontal="16dp"
        style="@style/Medium_16_20"/>
</LinearLayout>
