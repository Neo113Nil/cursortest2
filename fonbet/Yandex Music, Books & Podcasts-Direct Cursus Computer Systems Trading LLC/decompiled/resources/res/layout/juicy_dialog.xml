<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/dialog_catalog_menu_header_container"
        android:background="?attr/bgSecondary"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/juicy_item_catalog_header_height"
        android:outlineProvider="none">
        <ru.yandex.music.ui.view.RoundedOutlineProviderImageView
            android:id="@+id/bottom_dialog_header_cover"
            android:layout_width="@dimen/juicy_bottom_sheet_cover_size"
            android:layout_height="@dimen/juicy_bottom_sheet_cover_size"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:outline_corner_radius="@dimen/corner_4"/>
        <ru.yandex.music.ui.view.ImageSpannableEllipsizedTextView
            android:ellipsize="end"
            android:id="@+id/bottom_dialog_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/bottom_dialog_header_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bottom_dialog_header_cover"
            app:layout_constraintTop_toTopOf="@+id/bottom_dialog_header_cover"
            style="@style/Bold_20_24"/>
        <ru.yandex.music.ui.view.ImageSpannableEllipsizedTextView
            android:textColor="?android:attr/textColorSecondary"
            android:ellipsize="end"
            android:id="@+id/bottom_dialog_header_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_dialog_header_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bottom_dialog_header_cover"
            app:layout_constraintTop_toBottomOf="@+id/bottom_dialog_header_title"
            style="@style/Medium_16_20"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialog_catalog_menu_actions_list"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/juicy_bottom_sheet_list_side_padding"
        android:paddingEnd="@dimen/juicy_bottom_sheet_list_side_padding"/>
    <FrameLayout
        android:id="@+id/bottom_dialog_loading_placeholder"
        android:background="?attr/bgSecondary"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/juicy_bottom_sheet_peekheight">
        <ru.yandex.music.ui.view.YaRotatingProgress
            android:layout_gravity="center"
            android:id="@+id/bottom_dialog_loading_progress"
            android:layout_width="@dimen/yprogress_middle"
            android:layout_height="@dimen/yprogress_middle"/>
    </FrameLayout>
</FrameLayout>
