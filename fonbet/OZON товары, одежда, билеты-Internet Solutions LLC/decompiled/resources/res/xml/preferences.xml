<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        app:key="fintech_system_category"
        app:title="Системные">
        <Preference
            app:key="fintech_reload_app"
            app:title="Рестарт аппа"/>
        <Preference
            android:persistent="false"
            android:title="isStandalone"
            android:selectable="false"
            android:key="fintech_is_standalone"/>
        <Preference
            app:key="fintech_native_bridge_testing"
            app:title="Экран нейтивбриджей"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_servers_category"
        app:title="Серверы">
        <ListPreference
            app:dialogTitle="Выберите сервер"
            app:entries="@array/web_bank_server_entries"
            app:entryValues="@array/web_bank_server_values"
            app:key="fintech_web_bank_server"
            app:title="Сервер WebBank"
            app:useSimpleSummaryProvider="true"/>
        <EditTextPreference
            android:defaultValue="https://bozon-albus-ng-ob-13250-otp-presets-dev.ozonru.me/"
            app:dialogTitle="Выберите сервер"
            app:key="fintech_web_bank_server_manual"
            app:title="Сервер WebBank ручками"
            app:useSimpleSummaryProvider="true"/>
        <EditTextPreference
            android:defaultValue="https://localhost.ozonru.me:3000/"
            app:dialogTitle="Выберите сервер"
            app:key="fintech_web_bank_server_localhost"
            app:title="Сервер localhost"
            app:useSimpleSummaryProvider="true"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="force_web_bank_server_from_sp"
            app:title="Форсировать выбранный сервер"/>
        <Preference
            app:key="fintech_tracker_logs"
            app:title="Прочитать логи из трекера"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_mesh_category"
        app:title="Mesh">
        <Preference
            android:persistent="false"
            android:title="Текущий Mesh"
            android:selectable="false"
            android:key="fintech_mesh_header_final_key"/>
        <EditTextPreference
            app:dialogTitle="Добавить mesh header к запросам"
            app:key="fintech_mesh_header"
            app:title="Добавьте mesh header к запросам"
            app:useSimpleSummaryProvider="true"/>
        <Preference
            app:key="fintech_clear_mesh_header"
            app:title="Очистить mesh header"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_testing_features_category"
        app:title="Фичи фронта">
        <Preference
            app:key="fintech_testing_features_v1_edit"
            app:title="К редактированию фичей фронта V1"/>
        <Preference
            app:key="fintech_testing_features_v2_edit"
            app:title="К редактированию фичей фронта V2"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="fintech_is_autotests_header_key"
            app:summary="Вкл/Выкл header is-mobile-autotests"
            app:title="Дефолтный конфиг фичей фронта"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_session_duration_category"
        app:title="Длительность сессии">
        <EditTextPreference
            app:dialogTitle="в секундах (12s | 12)"
            app:key="fintech_session_duration_set"
            app:title="Установить длительность сессии"
            app:useSimpleSummaryProvider="false"/>
        <Preference
            app:key="fintech_session_duration_clear"
            app:title="Очистить хэдер длительности сессии"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_testing_features_category"
        app:title="Internal token">
        <Preference
            android:persistent="false"
            android:title="Текущий Internal token header"
            android:selectable="false"
            android:key="fintech_internal_header_token_final_key"/>
        <EditTextPreference
            app:dialogTitle="Добавить internal token header к запросам"
            app:key="@string/fintech_internal_header_token_key"
            app:title="Добавьте internal token header к запросам"
            app:useSimpleSummaryProvider="true"/>
        <Preference
            app:key="fintech_clear_header_token"
            app:title="Очистить internal token header"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_ab_variants_category"
        app:title="AB-Variants">
        <Preference
            android:persistent="false"
            android:title="Текущий AB-Variants header"
            android:selectable="false"
            android:key="fintech_ab_variants_header_final"/>
        <EditTextPreference
            app:dialogTitle="Добавить AB-Variants header к запросам"
            app:key="fintech_ab_variants_header"
            app:title="Добавьте AB-Variants header к запросам"
            app:useSimpleSummaryProvider="true"/>
        <Preference
            app:key="fintech_clear_ab_variants_header"
            app:title="Очистить AB-Variants header"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_other_category"
        app:title="Тема/Оценка приложения/Обновление приложения">
        <Preference
            app:key="fintech_nav_goto_theme"
            app:title="Открыть экран выбора темы"/>
        <Preference
            app:key="fintech_nav_goto_review"
            app:title="Открыть экран оценки приложения"/>
        <Preference
            app:key="fintech_nav_goto_hard_update"
            app:title="Открыть экран жесткого обновления приложения"/>
        <Preference
            app:key="fintech_nav_goto_soft_update"
            app:title="Открыть экран мягкого обновления приложения"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_auth_category"
        app:title="Авторизация">
        <Preference
            android:persistent="false"
            android:title="User"
            android:selectable="false"
            android:key="fintech_is_ozon_signed"/>
        <Preference
            app:key="fintech_ozon_id_logout"
            app:title="Разлогиниться"/>
        <Preference
            app:key="fintech_nav_goto_ozon_id"
            app:title="Открыть OzonId sign in"/>
        <Preference
            app:key="fintech_nav_goto_pin_pad"
            app:title="Открыть Pin Pad"/>
        <Preference
            app:key="fintech_expire_session"
            app:title="Протухнуть сессию"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_push_category"
        app:title="Пуши и UUID (soon)">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="fintech_bank_push_error"
            app:title="Ошибка при формировании пуша"/>
        <Preference
            app:key="fintech_copy_firebase_token"
            app:title="Скопировать Firebase Token"/>
        <Preference
            app:key="fintech_copy_device_uuid"
            app:title="Скопировать device UUID"/>
        <Preference
            app:key="fintech_copy_device_adid"
            app:title="Скопировать device AD ID"/>
        <Preference
            app:key="fintech_test_notification_ozonbank"
            app:title="Тестовая нотификация OzonBank"/>
        <Preference
            app:key="fintech_test_notification_https"
            app:title="Тестовая нотификация https"/>
        <Preference
            app:key="fintech_test_notification_otp"
            app:title="Тестовая нотиф OTP"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_nav_category"
        app:title="Навигация">
        <Preference
            app:key="fintech_nav_camera"
            app:title="@string/fintech_preference_camera_settings"/>
        <Preference
            app:key="fintech_qr_settings"
            app:title="@string/fintech_preference_qr_scanner_settings_title"/>
        <Preference
            app:key="fintech_share_file_settings"
            app:title="Share file"/>
        <Preference
            app:key="fintech_cbottom"
            app:title="Открыть нативный боттом"/>
        <Preference
            app:key="fintech_photo"
            app:title="Открыть фотки URLS"/>
        <Preference
            app:key="fintech_photo_64"
            app:title="Открыть фотки Base64"/>
        <Preference
            app:key="fintech_stories"
            app:title="Открыть Stories"/>
        <Preference
            app:key="fintech_onboarding"
            app:title="Открыть Onboarding"/>
        <Preference
            app:key="demo_recycli"
            app:title="Демо Recycli"/>
        <Preference
            app:key="input_playground"
            app:title="Input Playground"/>
        <Preference
            app:key="fintech_cbdc_mfe_script"
            app:title="@string/fintech_preference_cbdc_mfe_script"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:key="fintech_other_category"
        app:title="Остальное">
        <Preference
            app:key="fintech_get_installed_bank_apps"
            app:title="Получение установленных банков"/>
        <Preference
            app:key="fintech_open_installed_bank_app"
            app:title="Открытие установленного банка по пакету"/>
        <Preference
            app:key="fintech_start_audio_record"
            app:title="Старт записи аудио"/>
        <Preference
            app:key="fintech_stop_audio_record"
            app:title="Стоп записи аудио"/>
        <Preference
            app:key="fintech_feature_toggles_clear"
            app:title="Очистить фича тоглы"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="fintech_other_logger"
            app:title="Включить логирование"/>
        <Preference
            app:key="fintech_crash_app"
            app:title="Крашнуть приложение"/>
        <Preference
            app:key="fintech_anr_app"
            app:title="Вызвать ANR"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="fintech_feature_first_launch"
            app:title="Первый запуск приложения"/>
        <Preference
            app:key="fintech_view_logs"
            app:title="Посмотреть лог файл"/>
        <Preference
            app:key="fintech_send_graylog"
            app:title="Отправить накопленные логи graylog"/>
        <Preference
            app:key="fintech_view_antifraud"
            app:title="Посмотреть json антифрода"/>
        <Preference
            app:key="fintech_clear_saved_notifications"
            app:title="Сбросить сохранение показа запроса разрешения для уведомлений"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="fintech_render_gone_key"
            app:title="Включить эмуляцию краша рендера"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="fintech_ignore_load_pending_tabs"
            app:title="Игнорировать load_pending_tabs (Lazy tabs)"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="ultra_state"
            app:title="Ultra"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="video_muxer_error"
            app:title="Video Muxer error"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="video_upload_video"
            app:title="Video upload video mode"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:key="allow_webview_ssl_error"
            app:title="Allow webview ssl error"/>
    </PreferenceCategory>
</PreferenceScreen>
