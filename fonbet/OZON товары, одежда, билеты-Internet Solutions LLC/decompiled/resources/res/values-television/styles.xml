<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OzonIdTheme" parent="@style/OzonIdBaseTheme">
        <item name="android:windowBackground">@color/ozdt_bg_secondary</item>
    </style>
    <style name="SmallBorderlessButton" parent="@style/TextStyle.Body.M">
        <item name="android:textColor">@color/o2_selector_color_text_for_button_borderless</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/o2_button_borderless_s</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="UncontainedButtonDefaultStyle" parent="@style/Button.ActionPrimary">
    </style>
