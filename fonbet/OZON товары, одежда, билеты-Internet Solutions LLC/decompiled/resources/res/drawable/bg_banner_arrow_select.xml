<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="11dp"
        android:width="11dp"
        android:left="2dp"
        android:right="2dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="@color/bg_dark_key"/>
                <corners android:radius="2dp"/>
            </shape>
        </rotate>
    </item>
</layer-list>
