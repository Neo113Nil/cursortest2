<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/oz_semantic_bg_secondary"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
            <item>
                <ripple android:color="?attr/oz_semantic_accent_primary_pale">
                    <item android:id="@android:id/mask">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/oz_semantic_bg_secondary"/>
                            <corners android:radius="4dp"/>
                        </shape>
                    </item>
                </ripple>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="@color/oz_semantic_accent_primary"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/oz_semantic_bg_secondary"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
            <item>
                <ripple android:color="?attr/oz_semantic_accent_primary_pale">
                    <item android:id="@android:id/mask">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/oz_semantic_bg_secondary"/>
                            <corners android:radius="4dp"/>
                        </shape>
                    </item>
                </ripple>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="@color/oz_gray_80"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
