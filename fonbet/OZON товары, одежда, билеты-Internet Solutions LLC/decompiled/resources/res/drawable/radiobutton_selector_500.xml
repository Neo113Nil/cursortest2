<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:state_enabled="true"
        android:state_checked="true"
        android:id="@+id/checked"
        android:drawable="@drawable/radiobutton_checked_500"
        app:state_error="false"/>
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:id="@+id/checked_disabled"
        android:drawable="@drawable/radiobutton_checked_disabled_500"
        app:state_error="false"/>
    <item
        android:state_enabled="true"
        android:state_checked="true"
        android:id="@+id/checked_error"
        android:drawable="@drawable/radiobutton_checked_error_500"
        app:state_error="true"/>
    <item
        android:state_enabled="true"
        android:state_checked="false"
        android:id="@+id/unchecked"
        android:drawable="@drawable/radiobutton_unchecked_500"
        app:state_error="false"/>
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:id="@+id/unchecked_disabled"
        android:drawable="@drawable/radiobutton_unchecked_disabled_500"
        app:state_error="false"/>
    <item
        android:state_enabled="true"
        android:state_checked="false"
        android:id="@+id/unchecked_error"
        android:drawable="@drawable/radiobutton_unchecked_error_500"
        app:state_error="true"/>
    <item android:drawable="@drawable/radiobutton_unchecked_500"/>
</animated-selector>
