<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/layerFloor2"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/bg_variant_frame"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/selector_aspects_v2_selected_frame"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/dash_gap_variant_frame"
                android:dashWidth="3dp"
                android:dashGap="3dp"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <ripple android:color="?attr/bgActionSecondary">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/bgLightKey"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
