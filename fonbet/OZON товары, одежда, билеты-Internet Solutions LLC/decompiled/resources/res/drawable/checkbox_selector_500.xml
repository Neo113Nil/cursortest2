<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:state_enabled="true"
        android:id="@+id/checked"
        android:drawable="@drawable/checkbox_checked_500"
        app:state_checked="true"
        app:state_error="false"/>
    <item
        android:state_enabled="false"
        android:id="@+id/checked_disabled"
        android:drawable="@drawable/checkbox_checked_disabled_500"
        app:state_checked="true"
        app:state_error="false"/>
    <item
        android:state_enabled="true"
        android:id="@+id/checked_error"
        android:drawable="@drawable/checkbox_checked_error_500"
        app:state_checked="true"
        app:state_error="true"/>
    <item
        android:state_enabled="true"
        android:id="@+id/indeterminate"
        android:drawable="@drawable/checkbox_indeterminate_500"
        app:state_error="false"
        app:state_indeterminate="true"/>
    <item
        android:state_enabled="false"
        android:id="@+id/indeterminate_disabled"
        android:drawable="@drawable/checkbox_indeterminate_disabled_500"
        app:state_error="false"
        app:state_indeterminate="true"/>
    <item
        android:state_enabled="true"
        android:id="@+id/indeterminate_error"
        android:drawable="@drawable/checkbox_indeterminate_error_500"
        app:state_error="true"
        app:state_indeterminate="true"/>
    <item
        android:state_enabled="true"
        android:id="@+id/unchecked"
        android:drawable="@drawable/checkbox_unchecked_500"
        app:state_error="false"
        app:state_unchecked="true"/>
    <item
        android:state_enabled="false"
        android:id="@+id/unchecked_disabled"
        android:drawable="@drawable/checkbox_unchecked_disabled_500"
        app:state_error="false"
        app:state_unchecked="true"/>
    <item
        android:state_enabled="true"
        android:id="@+id/unchecked_error"
        android:drawable="@drawable/checkbox_unchecked_error_500"
        app:state_error="true"
        app:state_unchecked="true"/>
    <item android:drawable="@drawable/checkbox_unchecked_500"/>
</animated-selector>
