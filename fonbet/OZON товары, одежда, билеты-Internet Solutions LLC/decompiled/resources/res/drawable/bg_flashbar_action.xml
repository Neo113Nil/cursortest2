<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/oz_semantic_accent_primary_pale">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/bgActionSecondaryInverted"/>
            <corners android:radius="14dp"/>
            <padding
                android:left="16dp"
                android:top="6dp"
                android:right="16dp"
                android:bottom="6dp"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="?attr/bgActionSecondaryInverted"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</ripple>
