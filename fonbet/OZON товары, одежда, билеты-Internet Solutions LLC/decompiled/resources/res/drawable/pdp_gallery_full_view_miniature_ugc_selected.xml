<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <solid android:color="?attr/bgLightKey"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <stroke
                android:width="2dp"
                android:color="?attr/graphicActionPrimary"/>
        </shape>
    </item>
</layer-list>
