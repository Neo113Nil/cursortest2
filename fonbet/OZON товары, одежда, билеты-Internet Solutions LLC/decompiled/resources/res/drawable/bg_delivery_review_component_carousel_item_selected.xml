<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <stroke
                android:width="2dp"
                android:color="?attr/graphicActionPrimary"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <solid android:color="?attr/layerFloor1"/>
        </shape>
    </item>
</layer-list>
