<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false"
        android:state_selected="false">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <solid android:color="@color/oz_semantic_bg_primary"/>
        </shape>
    </item>
    <item
        android:state_enabled="true"
        android:state_selected="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <solid android:color="@color/oz_semantic_accent_secondary_light"/>
                </shape>
            </item>
            <item android:drawable="@drawable/ripple_rect_round_bluewave"/>
        </layer-list>
    </item>
    <item
        android:state_enabled="false"
        android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <solid android:color="?attr/oz_semantic_accent_primary_pale"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <solid android:color="?attr/oz_semantic_accent_primary"/>
                </shape>
            </item>
            <item android:drawable="@drawable/ripple_rect_round_blue_whitewave"/>
        </layer-list>
    </item>
</selector>
