<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_story_outer_corner_radius"/>
            <stroke
                android:width="2dp"
                android:color="?attr/oz_semantic_accent_primary"/>
        </shape>
    </item>
    <item
        android:id="@+id/storyBg"
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/oz_semantic_bg_secondary"/>
        </shape>
    </item>
</layer-list>
