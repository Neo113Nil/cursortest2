<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false"
        android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="?attr/bgPrimary"/>
            <size
                android:height="24dp"
                android:width="24dp"/>
            <stroke
                android:width="5.5dp"
                android:color="?attr/graphicTertiary"/>
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="?attr/bgLightKey"/>
            <size
                android:height="24dp"
                android:width="24dp"/>
            <stroke
                android:width="5.5dp"
                android:color="?attr/bgActionPrimary"/>
        </shape>
    </item>
    <item android:drawable="@drawable/ic_checkbox_unchecked"/>
</selector>
