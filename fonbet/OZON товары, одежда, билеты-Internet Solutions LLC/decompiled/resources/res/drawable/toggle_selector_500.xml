<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_checked="true"
        android:id="@+id/checked"
        android:drawable="@drawable/toggle_checked_500"/>
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:id="@+id/checked_disabled"
        android:drawable="@drawable/toggle_checked_disabled_500"/>
    <item
        android:state_enabled="true"
        android:state_checked="false"
        android:id="@+id/unchecked"
        android:drawable="@drawable/toggle_unchecked_500"/>
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:id="@+id/unchecked_disabled"
        android:drawable="@drawable/toggle_unchecked_disabled_500"/>
    <transition
        android:drawable="@drawable/toggle_unchecked_to_checked_500"
        android:toId="@+id/checked"
        android:fromId="@+id/unchecked"/>
    <transition
        android:drawable="@drawable/toggle_checked_to_unchecked_500"
        android:toId="@+id/unchecked"
        android:fromId="@+id/checked"/>
    <transition
        android:drawable="@drawable/toggle_checked_to_checked_disabled_500"
        android:toId="@+id/checked_disabled"
        android:fromId="@+id/checked"/>
    <transition
        android:drawable="@drawable/toggle_checked_disabled_to_checked_500"
        android:toId="@+id/checked"
        android:fromId="@+id/checked_disabled"/>
    <transition
        android:drawable="@drawable/toggle_unchecked_to_unchecked_disabled_500"
        android:toId="@+id/unchecked_disabled"
        android:fromId="@+id/unchecked"/>
    <transition
        android:drawable="@drawable/toggle_unchecked_disabled_to_unchecked_500"
        android:toId="@+id/unchecked"
        android:fromId="@+id/unchecked_disabled"/>
    <item android:drawable="@drawable/toggle_unchecked_500"/>
</animated-selector>
