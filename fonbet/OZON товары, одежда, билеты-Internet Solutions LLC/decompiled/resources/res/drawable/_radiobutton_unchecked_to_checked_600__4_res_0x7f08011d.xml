<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:duration="100"
        android:valueFrom="?attr/graphicNeutral"
        android:valueTo="?attr/bgActionPrimary"
        android:propertyName="strokeColor"/>
    <objectAnimator
        android:duration="100"
        android:valueFrom="1"
        android:valueTo="0"
        android:valueType="floatType"
        android:propertyName="strokeWidth"/>
</set>
