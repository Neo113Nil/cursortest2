<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/colorLayer">
        <shape android:shape="oval">
            <size
                android:height="32dp"
                android:width="32dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/graphic_neutral"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:drawable="@drawable/ic_color_picker"/>
</layer-list>
