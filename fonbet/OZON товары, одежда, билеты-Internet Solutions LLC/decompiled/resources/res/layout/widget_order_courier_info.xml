<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/orderCourierInfoContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/orderCourierInfoTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/orderCourierInfoCell"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.app.android.uikit.view.atoms.cells.subtitled.CellWithSubtitle24IconPickerView
        android:id="@+id/orderCourierInfoCell"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderCourierInfoTitle"/>
    <ru.ozon.app.android.uikit.view.atoms.cells.subtitled.CellWithSubtitle24IconView
        android:id="@+id/leaveAtDoorInfoCell"
        android:layout_width="0dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderCourierInfoCell"/>
    <ImageView
        android:id="@+id/leaveAtDoorIcon"
        android:background="@drawable/ic_s_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        app:backgroundTint="?attr/oz_semantic_text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderCourierInfoCell"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:id="@+id/leaveAtDoorGalleryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/leaveAtDoorIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/leaveAtDoorIcon"
        app:layout_constraintTop_toTopOf="@+id/leaveAtDoorIcon"/>
    <ru.ozon.app.android.atoms.v3.molecules.list.GalleryView
        android:id="@+id/leaveAtDoorGallery"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/leaveAtDoorIcon"
        app:layout_constraintTop_toBottomOf="@+id/leaveAtDoorGalleryTitle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/leaveAtDoorGalleryGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="leaveAtDoorIcon, leaveAtDoorGalleryTitle, leaveAtDoorGallery"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/leaveAtDoorBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="leaveAtDoorInfoCell, leaveAtDoorGallery"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.LargeButtonView
        android:id="@+id/orderCourierInfoCallCourierButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/leaveAtDoorBarrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
