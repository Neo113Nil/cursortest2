<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/uWidgetHeaderCl"
    android:background="@drawable/bg_white_ripple_blue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextStyle.Head.M"
        android:ellipsize="end"
        android:id="@+id/uWidgetHeaderTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxLines="3"
        android:layout_marginStart="@dimen/default_margin"
        android:layout_marginEnd="@dimen/margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/uWidgetHeaderSubTitleTv"
        app:layout_constraintEnd_toStartOf="@+id/uWidgetHeaderDisclosureIv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="18dp"
        app:layout_goneMarginEnd="16dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Gray60"
        android:ellipsize="end"
        android:id="@+id/uWidgetHeaderSubTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="18dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/uWidgetHeaderDisclosureIv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/uWidgetHeaderTitleTv"
        app:layout_goneMarginEnd="@dimen/default_margin"
        app:layout_goneMarginTop="16dp"/>
    <ImageView
        android:id="@+id/uWidgetHeaderDisclosureIv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="@dimen/margin_medium_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_disclosure_gray"/>
</androidx.constraintlayout.widget.ConstraintLayout>
