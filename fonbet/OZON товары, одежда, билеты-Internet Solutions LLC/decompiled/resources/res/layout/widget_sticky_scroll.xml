<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="end"
    android:orientation="horizontal"
    android:background="@drawable/bg_sticky_fire"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dimen_44"
    android:layout_marginBottom="@dimen/dimen_12"
    android:layout_marginEnd="@dimen/dimen_12">
    <ru.ozon.uni.android.atom.icon.IconView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/fire_iv"
        android:layout_width="@dimen/dimen_28"
        android:layout_height="@dimen/dimen_28"
        android:layout_marginTop="@dimen/dimen_10"
        android:layout_marginBottom="@dimen/dimen_10"
        android:scaleType="center"
        android:layout_marginStart="@dimen/dimen_6"
        android:layout_marginEnd="@dimen/dimen_6"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:textSize="@dimen/dimen_16"
        android:textColor="?attr/textLightKey"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/sticky_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10"
        android:layout_marginBottom="@dimen/dimen_10"
        android:maxLines="1"
        android:fontFamily="@font/onest_semibold"
        android:layout_marginEnd="@dimen/dimen_16"/>
</LinearLayout>
