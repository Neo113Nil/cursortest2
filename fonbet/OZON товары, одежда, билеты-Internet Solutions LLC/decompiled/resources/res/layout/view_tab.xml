<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/selector_travel_tab"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:paddingHorizontal="12dp">
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/tabBadgeBv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:textColor="@color/selector_travel_tab_text"
        android:ellipsize="end"
        android:id="@+id/tabTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
</LinearLayout>
