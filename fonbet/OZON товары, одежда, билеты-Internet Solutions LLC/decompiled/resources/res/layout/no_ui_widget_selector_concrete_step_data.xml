<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/concreteStepWidget"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/backButton"
        android:background="@drawable/ic_arrow_back_black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/appbarGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/stepTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Body.L.Bold"/>
    <TextView
        android:gravity="center"
        android:id="@+id/stepSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/appbarGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stepTitle"
        app:layout_constraintVertical_bias="0"
        style="@style/TextStyle.Caption.Gray60"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.borderless.LargeBorderlessButtonView
        android:id="@+id/closeAllStepButton"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:foregroundGravity="right"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/appbarGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/appbarGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="48dp"/>
    <androidx.appcompat.widget.SearchView
        android:id="@+id/stepSearch"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:imeOptions="actionSearch"
        android:overScrollMode="always"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        app:closeIcon="@drawable/ic_close_circle"
        app:iconifiedByDefault="false"
        app:layout="@layout/mobilization_search_view_layout"
        app:layout_constraintBottom_toTopOf="@+id/stepItems"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/appbarGuideline"
        app:layout_constraintVertical_bias="0"
        app:queryBackground="@null"
        app:searchIcon="@drawable/ic_search_grey"
        app:theme="@style/AppSearchViewNew"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stepItems"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/concreteStepActionButtonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stepSearch"/>
    <FrameLayout
        android:id="@+id/concreteStepActionButtonContainer"
        android:background="@color/layer_floor_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="45dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.LargeButtonView
            android:id="@+id/concreteStepActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/stepProgressContaienr"
        android:background="?attr/layerFloor1"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appbarGuideline"
        app:layout_constraintVertical_bias="0">
        <me.zhanghai.android.materialprogressbar.MaterialProgressBar
            android:layout_gravity="center"
            android:id="@+id/stepProgressBar"
            style="@style/ProgressBarStyle"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
