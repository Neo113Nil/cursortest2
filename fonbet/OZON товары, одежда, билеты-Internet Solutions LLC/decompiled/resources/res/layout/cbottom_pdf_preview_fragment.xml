<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_cbottom_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:orientation="vertical"
        android:id="@+id/shimmer_placeholder"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline_cbottom_header">
        <View
            android:background="@drawable/fintech_sharing_info_placeholder_background"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <ru.ozon.fintech.features.cbottombase.ui.CbottomUINoScrollableView
        android:id="@+id/cbottom_views"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.fintech.ui.screenstate.ScreenStateView
        android:id="@+id/screen_state"
        android:background="@color/oz_semantic_bg_primary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline_cbottom_header"/>
    <ru.ozon.fintech.permissions.ui.PermissionsScreenStateView
        android:id="@+id/permissions_screen_state"
        android:background="@color/oz_semantic_bg_primary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline_cbottom_header"/>
</androidx.constraintlayout.widget.ConstraintLayout>
