<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pinpadMainContainer"
    android:background="@color/oz_semantic_bg_secondary"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/top_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_container_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/native_pinpad_marker"
        android:background="@drawable/ic_m_ozon_bank_filled"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/middle_guideline"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/keys"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_container"/>
    <ImageView
        android:id="@+id/logo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:src="@drawable/pin_logo"
        android:contentDescription="@string/pinpad_ozon_bank_logo_desc"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_container"/>
    <ImageView
        android:id="@+id/logo_mini"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/pin_logo_mini"
        android:contentDescription="@string/pinpad_ozon_bank_logo_desc"
        app:layout_constraintBottom_toBottomOf="@+id/top_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_container"/>
    <TextView
        android:textColor="@color/text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/title_bottom_margin"
        android:text="@string/pin_pad_title"
        app:layout_constraintBottom_toTopOf="@+id/subTitle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/OzonTextAppearance.Headline.600large"/>
    <TextView
        android:textColor="@color/text_secondary"
        android:gravity="center_horizontal"
        android:id="@+id/subTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/subtitle_bottom_margin"
        android:text="@string/pin_pad_sub_title"
        app:layout_constraintBottom_toTopOf="@+id/middle_guideline"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/OzonTextAppearance.Body.500medium"/>
    <ru.ozon.fintech.ui.pinprogress.PinProgressWrapper
        android:id="@+id/pins2"
        android:layout_width="136dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/middle_guideline"/>
    <TextView
        android:textColor="@color/text_negative"
        android:gravity="center_horizontal"
        android:id="@+id/error_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/error_message_top_margin"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pins2"
        style="@style/OzonTextAppearance.Compact.400large"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/keys"
        android:layout_width="@dimen/pins_block_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/pins_block_bottom_margin"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/forget"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
            android:id="@+id/key1"
            android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/button_1_desc"
            app:layout_constraintBottom_toTopOf="@+id/key4"
            app:layout_constraintEnd_toStartOf="@+id/key2"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:pinIcon="@drawable/pin_1"/>
        <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
            android:id="@+id/key2"
            android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/button_2_desc"
            app:layout_constraintBottom_toTopOf="@+id/key5"
            app:layout_constraintEnd_toStartOf="@+id/key3"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/key1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:pinIcon="@drawable/pin_2"/>
        <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
            android:id="@+id/key3"
            android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/button_3_desc"
            app:layout_constraintBottom_toTopOf="@+id/key6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/key2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:pinIcon="@drawable/pin_3"/>
        <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
            android:id="@+id/key4"
            android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/button_4_desc"
            app:layout_constraintBottom_toTopOf="@+id/key7"
            app:layout_constraintEnd_toStartOf="@+id/key5"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/key1"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:pinIcon="@drawable/pin_4"/>
        <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
            android:id="@+id/key5"
            android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/button_5_desc"
            app:layout_constraintBottom_toTopOf="@+id/key8"
            app:layout_constraintEnd_toStartOf="@+id/key6"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/key4"
            app:layout_constraintTop_toBottomOf="@+id/key2"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:pinIcon="@drawable/pin_5"/>
        <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
            android:id="@+id/key6"
            android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/button_6_desc"
            app:layout_constraintBottom_toTopOf="@+id/key9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/key5"
            app:layout_constraintTop_toBottomOf="@+id/key3"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:pinIcon="@drawable/pin_6"/>
        <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
            android:id="@+id/key7"
            android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/button_7_desc"
            app:layout_constraintBottom_toTopOf="@+id/key_left_bottom"
            app:layout_constraintEnd_toStartOf="@+id/key8"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/key4"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:pinIcon="@drawable/pin_7"/>
        <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
            android:id="@+id/key8"
            android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/button_8_desc"
            app:layout_constraintBottom_toTopOf="@+id/key0"
            app:layout_constraintEnd_toStartOf="@+id/key9"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/key7"
            app:layout_constraintTop_toBottomOf="@+id/key5"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:pinIcon="@drawable/pin_8"/>
        <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
            android:id="@+id/key9"
            android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/button_9_desc"
            app:layout_constraintBottom_toTopOf="@+id/key_right_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/key8"
            app:layout_constraintTop_toBottomOf="@+id/key6"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:pinIcon="@drawable/pin_9"/>
        <FrameLayout
            android:id="@+id/key_left_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/key0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/key7"
            app:layout_constraintVertical_chainStyle="spread_inside">
            <TextView
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:id="@+id/key_logout"
                android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/pin_button_size"
                android:layout_height="@dimen/pin_button_size"
                android:layout_marginTop="4dp"
                android:text="@string/pinpad_logout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/key_right_bottom"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toEndOf="@+id/key_left_bottom"
                app:layout_constraintTop_toBottomOf="@+id/key8"
                app:layout_constraintVertical_chainStyle="spread_inside"
                style="@style/OzonTextAppearance.BodyControl.500medium"/>
        </FrameLayout>
        <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
            android:id="@+id/key0"
            android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/button_0_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/key_right_bottom"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/key_left_bottom"
            app:layout_constraintTop_toBottomOf="@+id/key8"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:pinIcon="@drawable/pin_0"/>
        <FrameLayout
            android:id="@+id/key_right_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/key0"
            app:layout_constraintTop_toBottomOf="@+id/key9"
            app:layout_constraintVertical_chainStyle="spread_inside">
            <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
                android:id="@+id/key_back"
                android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/pinpad_delete_button_desc"
                app:pinIcon="@drawable/ic_m_delete_text"
                app:pinIconColor="@color/oz_text_secondary"/>
            <ru.ozon.fintech.features.pinpad.presentation.pinpad.pinbutton.PinButtonView
                android:id="@+id/key_bio"
                android:background="@drawable/fintech_ripple_rect_round_bg_overlap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/pinpad_bioauth_button_desc"
                app:pinIcon="@drawable/ic_l_touch_id"
                app:pinIconColor="@color/oz_text_secondary"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:id="@+id/forget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/forget_btn_bottom_margin"
        android:text="@string/pinpad_forget_password"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OzonTextAppearance.BodyControl.500medium"/>
    <ImageView
        android:id="@+id/close"
        android:background="@drawable/background_circle_bg_overlap"
        android:visibility="invisible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/ic_close_top_margin"
        android:src="@drawable/ic_s_cross_filled"
        android:scaleType="center"
        android:contentDescription="@string/pinpad_close_desc"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/graphic_tertiary"/>
    <ImageView
        android:id="@+id/back"
        android:visibility="invisible"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="6dp"
        android:src="@drawable/ic_m_disclosure_back_filled"
        android:scaleType="center"
        android:contentDescription="@string/pinpad_back_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/graphic_tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
