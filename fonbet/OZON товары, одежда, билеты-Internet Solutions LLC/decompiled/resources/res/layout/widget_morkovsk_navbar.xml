<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/statusBarSpace"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navbarContainer"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ru.ozon.app.android.regulardraw.widgets.navbar.ShadowImageButton
            android:id="@+id/menuButton"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ru.ozon.app.android.regulardraw.widgets.navbar.ShadowImageButton
            android:id="@+id/rightButton"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/buttonsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="rightButton, menuButton"/>
        <ru.ozon.app.android.regulardraw.ui.currencyBadge.MorkovskCurrencyBadge
            android:id="@+id/currencyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/buttonsBarrier"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
