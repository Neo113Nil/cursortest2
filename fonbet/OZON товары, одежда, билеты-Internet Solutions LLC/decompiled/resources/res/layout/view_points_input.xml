<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:gravity="center"
        android:id="@+id/pointsInputTitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textAppearance="@style/TextStyle.Body.L"
        android:textColorHint="?attr/textOriginalpriceAvailable"
        android:gravity="center_vertical"
        android:id="@+id/pointsInputEditText"
        android:background="@drawable/bg_rounded_primary_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:singleLine="true"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_s_search"
        android:paddingStart="10dp"
        android:paddingEnd="34dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        android:paddingVertical="8dp"
        app:drawableTint="?attr/graphicTertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pointsInputTitleTextView"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pointsInputClearSearchIcon"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_s_cross_circle"
        android:tint="?attr/graphicTertiary"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/pointsInputEditText"
        app:layout_constraintEnd_toEndOf="@+id/pointsInputEditText"
        app:layout_constraintTop_toTopOf="@+id/pointsInputEditText"/>
</merge>
