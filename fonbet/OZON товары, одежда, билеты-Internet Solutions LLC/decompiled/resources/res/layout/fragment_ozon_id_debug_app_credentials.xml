<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ozonIdDebugAppCredentialsRoot"
    android:paddingTop="60dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ozonIdDebugAppCredentialsContent"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/appCredentialsBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-16dp"
            app:layout_constraintBottom_toBottomOf="@+id/copyAppCredentialsButton"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/appCredentialsBlockTitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Креды приложения"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/appCredentialsBlock"/>
        <androidx.appcompat.widget.SwitchCompat
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/appCredentialsSwitchButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="Показать все куки"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/appCredentialsBlockTitleTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.400small"
            android:id="@+id/mainDomainCookiesTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/appCredentialsSwitchButton"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/mainDomainCookiesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/mainDomainCookiesTitleTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.400small"
            android:id="@+id/mainDomainCookiesTitleTextViewSSO2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/mainDomainCookiesTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/mainDomainCookiesTextViewSSO2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/mainDomainCookiesTitleTextViewSSO2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.400small"
            android:id="@+id/otherDomainsCookiesTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Прочие домены:"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/mainDomainCookiesTextViewSSO2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/otherDomainsCookiesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/otherDomainsCookiesTitleTextView"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyAppCredentialsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Скопировать"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/otherDomainsCookiesTextView"
            style="@style/ButtonDebug"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
