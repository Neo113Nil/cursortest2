<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/OzonTextAppearance.Headline.400small"
        android:id="@+id/tv_feature_name_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_app_config_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/fintech_preference_feature_toggle_use_app_config_title"
        app:layout_constraintBottom_toTopOf="@+id/tv_local_config_title"
        app:layout_constraintStart_toStartOf="@+id/tv_feature_name_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_feature_name_title"
        app:layout_goneMarginBottom="12dp"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_appconfig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_app_config_title"
        app:layout_constraintEnd_toEndOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/tv_app_config_title"/>
    <TextView
        android:id="@+id/tv_local_config_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Локальное значение"
        app:layout_constraintStart_toStartOf="@+id/tv_app_config_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_config_title"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_local"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_local_config_title"
        app:layout_constraintEnd_toEndOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/tv_local_config_title"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/local_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_local_config_title, sw_local"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.75"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_final_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_local_config_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/tv_feature_name_title"/>
    <TextView
        android:id="@+id/tv_string_data_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/fintech_preference_feature_toggle_stringdata_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_app_config_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_local_config_title"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginTop="8dp"/>
    <EditText
        android:id="@+id/et_string_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="10"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_string_data_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_local_config_title"
        app:layout_goneMarginTop="2dp"
        style="@style/TextStyle.Body.L.Gray40"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/string_data_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="et_string_data, tv_string_data_title"/>
    <TextView
        android:id="@+id/tv_string_array_data_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/fintech_preference_feature_toggle_stringarraydata_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_app_config_title"
        app:layout_constraintTop_toBottomOf="@+id/et_string_data"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginTop="8dp"/>
    <EditText
        android:id="@+id/et_string_array_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_string_array_data_title"
        app:layout_constraintTop_toBottomOf="@+id/et_string_data"
        app:layout_goneMarginTop="2dp"
        style="@style/TextStyle.Body.L.Gray40"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/string_array_data_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_string_array_data_title, et_string_array_data"/>
    <TextView
        android:id="@+id/tv_dict_data_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/fintech_preference_feature_toggle_dict_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_app_config_title"
        app:layout_constraintTop_toBottomOf="@+id/et_string_array_data"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginTop="8dp"/>
    <EditText
        android:id="@+id/et_dict_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_dict_data_title"
        app:layout_constraintTop_toBottomOf="@+id/et_string_array_data"
        app:layout_goneMarginTop="2dp"
        style="@style/TextStyle.Body.L.Gray40"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/dict_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_dict_data_title, et_dict_data"/>
</merge>
