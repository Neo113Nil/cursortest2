<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/topBgView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="@+id/topImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topImage"/>
    <ru.ozon.uni.android.atom.image.Image
        android:id="@+id/topImage"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/topBgView"
        app:layout_constraintStart_toStartOf="@+id/topBgView"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/topTitleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6"
        app:layout_constraintEnd_toEndOf="@+id/topBgView"
        app:layout_constraintStart_toStartOf="@+id/topBgView"
        app:layout_constraintTop_toBottomOf="@+id/topImage"/>
    <View
        android:id="@+id/topClickAreaView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/topTitleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottomBgView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="@+id/bottomImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottomImage"/>
    <ru.ozon.uni.android.atom.image.Image
        android:id="@+id/bottomImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        app:layout_constraintEnd_toEndOf="@+id/bottomBgView"
        app:layout_constraintStart_toStartOf="@+id/bottomBgView"
        app:layout_constraintTop_toBottomOf="@+id/topTitleView"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/bottomTitleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6"
        app:layout_constraintEnd_toEndOf="@+id/bottomBgView"
        app:layout_constraintStart_toStartOf="@+id/bottomBgView"
        app:layout_constraintTop_toBottomOf="@+id/bottomImage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
