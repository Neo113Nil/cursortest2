<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.ozon.fintech.ui.toolbar.FinToolbarView
        android:id="@+id/tool_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="0dp"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.MyApp.ToolBar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/divider_toolbar"
                style="@style/FeaturesV2Divider"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/testing_features_v1_features_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fintech_testing_features_v1_features_description"
                style="@style/FeaturesV2TextView"/>
            <View
                android:id="@+id/divider_features_description"
                style="@style/FeaturesV2Divider"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/testing_features_v1_current_features_title"
                android:paddingTop="2dp"
                android:paddingBottom="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fintech_testing_features_v1_current_features_title"
                style="@style/FeaturesV2TextView"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/testing_features_v1_current_features"
                android:paddingTop="0dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fintech_testing_features_v1_current_features_default"
                style="@style/FeaturesV2TextView"/>
            <View
                android:id="@+id/divider_current_features"
                style="@style/FeaturesV2Divider"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/testing_features_v1_current_header_title"
                android:paddingTop="2dp"
                android:paddingBottom="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fintech_testing_features_v1_current_header_title"
                style="@style/FeaturesV2TextView"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/testing_features_v1_current_header"
                android:paddingTop="0dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fintech_testing_features_v1_current_header_default"
                style="@style/FeaturesV2TextView"/>
            <View
                android:id="@+id/divider_description"
                style="@style/FeaturesV2Divider"/>
            <TextView
                android:textColor="@color/oz_black"
                android:id="@+id/fintech_testing_features_v1_enable_features_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fintech_testing_features_v1_enable_features_title"
                style="@style/FeaturesV2TextView"/>
            <EditText
                android:id="@+id/fintech_testing_features_v1_enable_features_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/fintech_testing_features_v1_enable_features_hint"
                style="@style/FeaturesV2EditText"/>
            <View
                android:id="@+id/divider_disable_features"
                android:layout_marginTop="16dp"
                style="@style/FeaturesV2Divider"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
