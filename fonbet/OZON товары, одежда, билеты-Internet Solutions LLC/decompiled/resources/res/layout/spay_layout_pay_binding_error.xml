<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/spay_slpbine_root"
    android:paddingBottom="@dimen/spay_extra_large_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/spay_bottom_sheet_common_height"
    android:transitionName="payTransition"
    android:paddingHorizontal="@dimen/spay_large_margin">
    <spay.sdk.view.SPayTextView
        android:gravity="center"
        android:id="@+id/spay_slpbine_actv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spay_100dp"
        android:text="@string/spay_pay_binding_default_error_title_text"
        android:layout_marginHorizontal="@dimen/spay_24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:spay_font="medium"
        style="@style/SpayFailurePaymentTitleTextStyle"/>
    <spay.sdk.view.SPayTextView
        android:gravity="center"
        android:id="@+id/spay_slpbine_actv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/spay_pay_bonuses_error_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spay_slpbine_actv_title"
        app:spay_font="medium"
        style="@style/SpayBottomSheet.TranslucentTextStyle"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center_horizontal"
        android:id="@+id/spay_slpbine_lottie_failure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/spay_slpbine_mb_pay_other_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spay_slpbine_actv_subtitle"
        app:layout_constraintVertical_bias="0"
        app:lottie_autoPlay="true"
        app:lottie_clipToCompositionBounds="true"
        app:lottie_rawRes="@raw/spay_ic_error_lottie"/>
    <spay.sdk.view.SPayMaterialButton
        android:id="@+id/spay_slpbine_mb_pay_other_button"
        android:layout_marginTop="@dimen/spay_124dp"
        android:layout_marginBottom="@dimen/spay_second_button_bottom_margin"
        android:text="@string/spay_pay_binding_error_button_text"
        app:layout_constraintBottom_toTopOf="@+id/spay_slpbine_mb_close_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SpayGreenButton"/>
    <spay.sdk.view.SPayMaterialButton
        android:id="@+id/spay_slpbine_mb_close_button"
        android:text="@string/spay_label_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SpayButtonBlank"/>
</androidx.constraintlayout.widget.ConstraintLayout>
