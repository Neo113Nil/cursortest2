<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/big_pin"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.geo.map.presentation.mapicons.ElevationImageView
        android:layout_gravity="center"
        android:id="@+id/pin_form"
        android:layout_width="48dp"
        android:layout_height="65dp"
        android:src="@drawable/big_pin_outer"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/pin_background"
        android:layout_width="48dp"
        android:layout_height="65dp"
        android:src="@drawable/big_pin_inner"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/pin_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/text_light_key"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/pins_count"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        style="@style/OzonTextAppearance.BodyControl.600large"/>
</FrameLayout>
