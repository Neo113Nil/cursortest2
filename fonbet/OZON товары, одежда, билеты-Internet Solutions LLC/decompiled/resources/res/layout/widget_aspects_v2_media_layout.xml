<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.pdp.ui.configurators.aspectsCompactV2.VariantConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/bg_aspects_media_selectable"
    android:layout_width="match_parent"
    android:layout_height="92dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageIv"
        android:background="?attr/bgLightKey"
        android:layout_width="70dp"
        android:layout_height="68dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:foreground="?attr/layerOverlayParanja"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:shapeAppearanceOverlay="@style/roundedImageVariant"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        android:layout_marginEnd="@dimen/dimen_12"
        app:constraint_referenced_ids="pricePa,titleTav,subtitleTav"
        app:flow_verticalGap="@dimen/dimen_2"
        app:layout_constraintBottom_toBottomOf="@+id/imageIv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageIv"
        app:layout_constraintTop_toTopOf="@+id/imageIv"
        app:layout_constraintVertical_bias="0.5"/>
    <ru.ozon.uni.android.atom.price.ui.PriceAtomView
        android:id="@+id/pricePa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/titleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintWidth_default="wrap"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/subtitleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintWidth_default="wrap"/>
</ru.ozon.app.android.pdp.ui.configurators.aspectsCompactV2.VariantConstraintLayout>
