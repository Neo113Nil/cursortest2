<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:id="@+id/travelServiceBlockV3TitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/travelServiceBlockV3ChangeServiceButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
        android:id="@+id/travelServiceBlockV3ChangeServiceButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/travelServiceBlockV3TitleBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="travelServiceBlockV3TitleTextView,travelServiceBlockV3ChangeServiceButton"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/travelServiceBlockV3PriceView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelServiceBlockV3TitleBarrier"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.M.Secondary"
        android:id="@+id/travelServiceBlockV3PriceSuffixTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/travelServiceBlockV3PriceView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/travelServiceBlockV3PriceView"
        app:layout_constraintTop_toTopOf="@+id/travelServiceBlockV3PriceView"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/travelServiceBlockV3PriceGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="travelServiceBlockV3PriceView,travelServiceBlockV3PriceSuffixTextView"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/travelServiceBlockV3PriceBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="travelServiceBlockV3PriceView,travelServiceBlockV3PriceSuffixTextView"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Body.M.Gray40"
        android:id="@+id/travelServiceBlockV3DescriptionTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelServiceBlockV3PriceBarrier"/>
    <ru.ozon.app.android.travel.molecules.view.linkButton.LinkButtonView
        android:id="@+id/moreActionTAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelServiceBlockV3DescriptionTextView"/>
    <View
        android:id="@+id/travelServiceBlockV3Separator"
        android:background="?attr/graphicNeutral"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moreActionTAV"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Body.M"
        android:id="@+id/travelServiceBlockV3NextServiceBenefitsTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelServiceBlockV3Separator"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/additionalInfoListRV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelServiceBlockV3NextServiceBenefitsTextView"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/travelServiceBlockV3NextServiceGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="travelServiceBlockV3Separator,travelServiceBlockV3NextServiceBenefitsTextView"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/travelServiceBlockV3NextServicePriceView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/additionalInfoListRV"
        app:layout_goneMarginTop="12dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.M.Secondary"
        android:id="@+id/travelServiceBlockV3NextServicePriceSuffixTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/travelServiceBlockV3NextServicePriceView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/travelServiceBlockV3NextServicePriceView"
        app:layout_constraintTop_toTopOf="@+id/travelServiceBlockV3NextServicePriceView"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/travelServiceBlockV3NextPriceGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="travelServiceBlockV3NextServicePriceView,travelServiceBlockV3NextServicePriceSuffixTextView"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/travelServiceBlockV3NextPriceBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="travelServiceBlockV3NextServicePriceView,travelServiceBlockV3NextServicePriceSuffixTextView"/>
    <ru.ozon.app.android.travel.molecules.view.travelBadge.v1.TravelBadgeListView
        android:orientation="horizontal"
        android:id="@+id/travelServiceBlockV3BadgeListView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelServiceBlockV3NextPriceBarrier"/>
</merge>
