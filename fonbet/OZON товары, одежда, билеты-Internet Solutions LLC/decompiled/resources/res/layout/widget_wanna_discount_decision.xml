<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:paddingBottom="@dimen/dimen_16"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/wannaDiscountStatusTitle"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/infoStatusButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/wannaDiscountStatusSubtitle"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/infoStatusButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wannaDiscountStatusTitle"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:id="@+id/infoStatusButton"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/wannaDiscountStatusTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/wannaDiscountStatusTitle"/>
    <View
        android:id="@+id/wannaDiscountPriceBg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="16dp"
        app:barrierAllowsGoneWidgets="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wannaDiscountStatusSubtitle"
        app:layout_goneMarginTop="@dimen/dimen_0"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/wannaDiscountPriceView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:barrierAllowsGoneWidgets="true"
        app:layout_constraintEnd_toEndOf="@+id/wannaDiscountPriceBg"
        app:layout_constraintStart_toStartOf="@+id/wannaDiscountPriceBg"
        app:layout_constraintTop_toTopOf="@+id/wannaDiscountPriceBg"
        app:layout_goneMarginTop="@dimen/dimen_0"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/wannaDiscountPriceTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:barrierAllowsGoneWidgets="true"
        app:layout_constraintBottom_toBottomOf="@+id/wannaDiscountPriceBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wannaDiscountPriceView"
        app:layout_goneMarginTop="@dimen/dimen_0"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:ellipsize="end"
        android:id="@+id/wannaDiscountTimerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginVertical="@dimen/dimen_20"
        app:barrierAllowsGoneWidgets="true"
        app:layout_constraintBottom_toTopOf="@+id/sellerMessageView"
        app:layout_constraintEnd_toStartOf="@+id/wannaDiscountTimerBadge"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wannaDiscountPriceBg"
        app:layout_goneMarginTop="@dimen/dimen_0"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/wannaDiscountTimerBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        android:paddingHorizontal="@dimen/dimen_10"
        app:barrierAllowsGoneWidgets="true"
        app:layout_constraintBottom_toBottomOf="@+id/wannaDiscountTimerTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/wannaDiscountTimerTitle"
        app:layout_constraintTop_toTopOf="@+id/wannaDiscountTimerTitle"
        app:layout_goneMarginTop="@dimen/dimen_0"/>
    <View
        android:id="@+id/sellerMessageView"
        android:background="?attr/bgSecondary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_20"
        android:minHeight="@dimen/dimen_84"
        app:layout_constraintBottom_toBottomOf="@+id/sellerMessageSubtitleTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wannaDiscountTimerTitle"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:ellipsize="end"
        android:id="@+id/sellerMessageTitleTv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/dimen_12"
        app:layout_constraintEnd_toEndOf="@+id/sellerMessageView"
        app:layout_constraintStart_toStartOf="@+id/sellerMessageView"
        app:layout_constraintTop_toTopOf="@+id/sellerMessageView"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/sellerMessageSubtitleTv"
        android:paddingBottom="@dimen/dimen_12"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:layout_marginBottom="@dimen/dimen_12"
        app:layout_constraintEnd_toEndOf="@+id/sellerMessageTitleTv"
        app:layout_constraintStart_toStartOf="@+id/sellerMessageTitleTv"
        app:layout_constraintTop_toBottomOf="@+id/sellerMessageTitleTv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
