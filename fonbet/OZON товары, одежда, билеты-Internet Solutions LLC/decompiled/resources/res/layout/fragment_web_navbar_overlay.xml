<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.ozon.app.android.web.webview.OzonWebView
        android:id="@+id/webView"
        android:fitsSystemWindows="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <ru.ozon.app.android.uikit.view.button.ShadowImageButton
            android:layout_gravity="center"
            android:id="@+id/backButton"
            android:layout_width="@dimen/dimen_44"
            android:layout_height="@dimen/dimen_44"
            android:src="@drawable/ic_m_disclosure_back_filled"
            android:scaleType="center"
            android:tint="@color/transparent_navbar_button_icon_color"
            android:layout_marginStart="@dimen/dimen_12"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <ru.ozon.app.android.uikit.view.button.ShadowImageButton
            android:layout_gravity="center"
            android:id="@+id/shareBtn"
            android:layout_width="@dimen/dimen_44"
            android:layout_height="@dimen/dimen_44"
            android:src="@drawable/ic_m_share_universal_filled"
            android:scaleType="center"
            android:tint="@color/transparent_navbar_button_icon_color"
            android:layout_marginEnd="@dimen/dimen_12"/>
    </LinearLayout>
</FrameLayout>
