<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/logoImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_ozon_id_logo"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/titleTextAtomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_40"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoImageView"
        style="@style/OzonTextAppearance.Headline.700xlarge"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/checkboxesFlow"
        android:background="@drawable/bg_ozon_id_agreements_sheet_checkboxes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="4dp"
        app:constraint_referenced_ids="termsOfUseCheckbox,adsCheckbox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextAtomView"/>
    <ru.ozon.uni.android.cell.selection.checkbox.CheckboxTitleSubtitleCellView
        android:id="@+id/termsOfUseCheckbox"
        android:paddingTop="@dimen/dimen_14"
        android:paddingBottom="@dimen/dimen_4"
        android:nextFocusUp="@+id/closeButton"
        android:nextFocusDown="@+id/adsCheckbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:focusedByDefault="true"/>
    <View
        android:id="@+id/checkboxesSeparator"
        android:background="@color/graphic_neutral"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/termsOfUseCheckbox"
        app:layout_constraintEnd_toEndOf="@+id/checkboxesFlow"
        app:layout_constraintStart_toStartOf="@+id/checkboxesFlow"/>
    <ru.ozon.uni.android.cell.selection.checkbox.CheckboxTitleSubtitleCellView
        android:id="@+id/adsCheckbox"
        android:paddingTop="@dimen/dimen_4"
        android:paddingBottom="@dimen/dimen_16"
        android:nextFocusUp="@+id/termsOfUseCheckbox"
        android:nextFocusDown="@+id/completeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dimen_16"/>
    <ru.ozon.uni.android.controls.button.ButtonView
        android:id="@+id/completeButton"
        android:nextFocusUp="@+id/checkboxesFlow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="40dp"
        android:layout_marginHorizontal="16dp"
        app:buttonsSize="size_600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checkboxesFlow"
        style="@style/Button.ActionPrimary"/>
    <ru.ozon.uni.android.controls.button.UncontainedButtonView
        android:id="@+id/returnToMainScreenButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/completeButton"
        style="@style/UncontainedButtonDefaultStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
