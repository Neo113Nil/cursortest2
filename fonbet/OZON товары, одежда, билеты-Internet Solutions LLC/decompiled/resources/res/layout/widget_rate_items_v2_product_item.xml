<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dimen_8"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="94dp"
    android:paddingVertical="@dimen/dimen_8">
    <ru.ozon.uni.android.atom.productMedia.ProductMediaView
        android:id="@+id/productMedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintEnd_toStartOf="@+id/hideCL"
        app:layout_constraintStart_toEndOf="@+id/productMedia"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/dimen_0"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/timer"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/productMedia"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_20"
        android:layout_marginStart="@dimen/dimen_4"
        app:layout_constraintBottom_toBottomOf="@+id/badge"
        app:layout_constraintEnd_toStartOf="@+id/hideCL"
        app:layout_constraintStart_toEndOf="@+id/badge"
        app:layout_constraintTop_toTopOf="@+id/badge"/>
    <ru.ozon.uni.android.atom.rating.RatingView
        android:id="@+id/rating"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_6"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/hideCL"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/productMedia"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/hideCL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:paddingEnd="@dimen/dimen_16"
        android:paddingVertical="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
            android:id="@+id/hideButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/hideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ru.ozon.uni.android.cell.CellView
        android:id="@+id/cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_8"
        android:layout_marginRight="@dimen/dimen_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/productMedia"
        app:layout_constraintTop_toBottomOf="@+id/rating"/>
</androidx.constraintlayout.widget.ConstraintLayout>
