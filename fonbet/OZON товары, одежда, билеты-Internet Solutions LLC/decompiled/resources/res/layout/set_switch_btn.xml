<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/switchBtn"
    android:background="@drawable/switch_set_rounded_bg"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:paddingStart="12dp"
    android:layout_marginEnd="8dp">
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:textColor="@color/switch_set_title_color"
        android:ellipsize="end"
        android:id="@+id/switchTitle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:maxLines="1"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/switchSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:textColor="@color/switch_set_subtitle_color"
        android:ellipsize="end"
        android:id="@+id/switchSubtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:maxLines="1"
        android:alpha="0.6"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/switchTitle"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
