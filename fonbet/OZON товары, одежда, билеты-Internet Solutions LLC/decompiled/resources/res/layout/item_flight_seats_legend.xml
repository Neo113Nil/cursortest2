<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.travel.feature.avia.shared.airplaneSeat.AirplaneSeatView
        android:id="@+id/flightSeatsLegendSignASV"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/flightSeatsLegendDescriptionTAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/flightSeatsLegendSignASV"
        app:layout_constraintEnd_toStartOf="@+id/flightSeatsLegendBadgeBV"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/flightSeatsLegendSignASV"
        app:layout_constraintTop_toTopOf="@+id/flightSeatsLegendSignASV"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/flightSeatsLegendBadgeBV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/flightSeatsLegendSignASV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/flightSeatsLegendSignASV"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/flightSeatsLegendBarrierB"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="flightSeatsLegendDescriptionTAV,flightSeatsLegendSignASV"/>
    <View
        android:id="@+id/flightSeatsLegendSeparatorV"
        android:background="?attr/graphicNeutral"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/flightSeatsLegendDescriptionTAV"
        app:layout_constraintTop_toBottomOf="@+id/flightSeatsLegendBarrierB"/>
</androidx.constraintlayout.widget.ConstraintLayout>
