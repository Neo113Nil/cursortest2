<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.ozon.fintech.ui.toolbar.FinToolbarView
        android:id="@+id/tool_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="0dp"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.MyApp.ToolBar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/start_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_back_camera"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tool_bar"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_front_camera"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <View
                android:background="#818181"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_pass"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_self"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_reg"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <View
                android:background="#818181"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_enabled"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_disabled"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <View
                android:background="#818181"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_sd"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_hd"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_fhd"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <View
                android:background="#818181"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_chunk3"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_chunk5"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
            <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
                android:id="@+id/frbv_video_chunk10"
                android:background="@color/oz_semantic_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frbv_back_camera"/>
        </LinearLayout>
    </ScrollView>
    <ru.ozon.fintech.ui.button.large.FinLargeButtonView
        android:id="@+id/start_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
