<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextStyle.Head.M"
        android:textColor="?attr/textPrimary"
        android:gravity="center"
        android:id="@+id/newReviewTitleTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>
    <ru.ozon.uni.android.uikit.view.atoms.rating.VectorRatingBar
        android:id="@+id/ratingRb"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:rb_stepSize="1"
        style="@style/RatingBarStyle.L"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption"
        android:textColor="?attr/textSecondary"
        android:id="@+id/ratingTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:textColor="?attr/textPrimary"
        android:id="@+id/titleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"/>
</LinearLayout>
