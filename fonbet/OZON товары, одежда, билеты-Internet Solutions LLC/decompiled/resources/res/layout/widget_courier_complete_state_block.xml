<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/completeStateContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="76dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/completeStateIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/completeStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/completeStateSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
