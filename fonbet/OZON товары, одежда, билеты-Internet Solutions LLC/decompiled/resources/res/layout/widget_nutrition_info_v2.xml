<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/TextStyle.Caption.AC"
        android:textSize="14sp"
        android:id="@+id/titleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAllCaps="false"/>
    <ru.ozon.app.android.pdp.ui.configurators.pdp.nutritionInfov2.NutritionCustomSeparatorView
        android:id="@+id/customView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
