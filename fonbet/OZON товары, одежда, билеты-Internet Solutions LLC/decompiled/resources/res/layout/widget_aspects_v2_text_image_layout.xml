<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.pdp.ui.configurators.aspectsCompactV2.VariantLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_aspects_tile_selectable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingStart="@dimen/dimen_8">
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_gravity="center"
        android:id="@+id/imageView"
        android:background="?attr/graphicNeutralOnLight"
        android:layout_width="@dimen/dimen_32"
        android:layout_height="@dimen/dimen_32"
        android:layout_marginEnd="@dimen/dimen_6"
        android:layout_marginVertical="@dimen/dimen_8"
        app:shapeAppearanceOverlay="@style/roundedTilesImageVariant"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/titleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/dimen_10"
        android:hyphenationFrequency="full"
        android:layout_marginVertical="@dimen/dimen_8"/>
</ru.ozon.app.android.pdp.ui.configurators.aspectsCompactV2.VariantLinearLayout>
