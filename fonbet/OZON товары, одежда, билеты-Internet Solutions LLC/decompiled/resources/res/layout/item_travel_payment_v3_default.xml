<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.travel.utils.view.constraintLayoutWithBorder.ConstraintLayoutWithBorder xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="6dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="116dp"
    android:minHeight="74dp"
    app:clwbCornerRadius="6dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/travelPaymentV3DefaultBgIV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedCorners3ImageStyle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/travelPaymentV3DefaultIconIV"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="@+id/travelPaymentV3DefaultBgIV"
        app:layout_constraintStart_toStartOf="@+id/travelPaymentV3DefaultBgIV"
        app:layout_constraintTop_toTopOf="@+id/travelPaymentV3DefaultBgIV"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:gravity="center"
        android:id="@+id/travelPaymentV3DefaultTitleTAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/travelPaymentV3DefaultBgIV"
        app:layout_constraintEnd_toEndOf="@+id/travelPaymentV3DefaultBgIV"
        app:layout_constraintStart_toStartOf="@+id/travelPaymentV3DefaultBgIV"/>
</ru.ozon.app.android.travel.utils.view.constraintLayoutWithBorder.ConstraintLayoutWithBorder>
