<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_reviews_progress_root"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dimen_16">
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:id="@+id/titleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:id="@+id/subtitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>
    <ru.ozon.app.android.uikit.view.atoms.progressbar.ProgressBarView
        android:id="@+id/reviewsProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
