<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/freshTabOnboardingRoot"
    android:background="@color/oz_semantic_dimming"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tooltipContainer"
        android:background="@drawable/bg_rounded_both_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/oz_semantic_bg_secondary"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/fakeFreshTab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1">
        <TextView
            android:textAppearance="@style/TextStyle.Body.L.Bold"
            android:textColor="@color/oz_semantic_text_primary"
            android:id="@+id/onBoardingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:text="@string/fresh_tab_onboarding_title"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/onBoardingDescription"
            app:layout_constraintEnd_toStartOf="@+id/onBoardingImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextStyle.Caption"
            android:textColor="@color/oz_semantic_text_secondary"
            android:id="@+id/onBoardingDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/fresh_tab_onboarding_description"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/onBoardingImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/onBoardingTitle"/>
        <ImageView
            android:id="@+id/onBoardingImage"
            android:layout_width="108dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/onBoardingCloseIcon"
            android:background="@drawable/onboarding_cross_shape"
            android:padding="3dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="12dp"
            android:src="@drawable/ic_s_cross_compact"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/oz_semantic_text_primary_negative"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/fakeFreshTab"
        android:background="@drawable/bg_fake_fresh_tab"
        android:layout_width="75dp"
        android:layout_height="36dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/ic_m_food"
        android:paddingHorizontal="25dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/realFreshTabMiddle"
        app:layout_constraintStart_toStartOf="@+id/realFreshTabMiddle"
        app:tint="@color/oz_semantic_text_secondary"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/realFreshTabMiddle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.25"/>
</androidx.constraintlayout.widget.ConstraintLayout>
