<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLl"
    android:background="?attr/oz_semantic_bg_secondary"
    android:paddingTop="4dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="124dp"
    android:layout_height="match_parent"
    android:paddingHorizontal="4dp">
    <ru.ozon.app.android.product.imagesswipeview.AdultServerBlurImageView
        android:id="@+id/imagesSwipeView"
        android:layout_width="116dp"
        android:layout_height="127dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/overlayImage"
        android:visibility="gone"
        android:layout_width="116dp"
        android:layout_height="127dp"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.product.common.overlaytitle.OverlayTitleView
        android:id="@+id/overlayTitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/imagesSwipeView"
        app:layout_constraintEnd_toEndOf="@+id/imagesSwipeView"
        app:layout_constraintStart_toStartOf="@+id/imagesSwipeView"/>
    <ru.ozon.app.android.product.common.wave.WaveView
        android:id="@+id/waveView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/imagesSwipeView"
        app:layout_constraintEnd_toEndOf="@+id/imagesSwipeView"
        app:layout_constraintStart_toStartOf="@+id/imagesSwipeView"/>
    <ru.ozon.app.android.universalwidgets.widgets.uw.badgescontainer.BadgesContainerView
        android:id="@+id/badgesContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/imagesSwipeView"
        app:layout_constraintLeft_toLeftOf="@+id/imagesSwipeView"
        app:layout_constraintRight_toRightOf="@+id/imagesSwipeView"
        app:layout_constraintTop_toTopOf="@+id/imagesSwipeView"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/topRightButtonsRV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.universalwidgets.widgets.uw.badgescontainer.BadgesContainerView
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/stateVrc"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toTopOf="@+id/barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="top"
        app:barrierMargin="-12dp"
        app:constraint_referenced_ids="productSa,buttonSubtitle"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/productSa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="0dp"/>
    <ru.ozon.app.android.uikit.view.atoms.texts.TextAtomWithIconView
        android:id="@+id/buttonSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
