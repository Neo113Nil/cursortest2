<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:gravity="center_vertical">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/island"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:baselineAligned="false"
        android:minHeight="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/name_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2323"
                android:singleLine="true"
                style="@style/OzonTextAppearance.Compact.500medium"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_secondary"
                android:ellipsize="end"
                android:id="@+id/number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2323"
                android:singleLine="true"
                style="@style/OzonTextAppearance.Body.400small"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_m_chevron_right_filled"
            android:scaleType="center"
            android:layout_marginEnd="16dp"
            app:tint="@color/graphic_tertiary"/>
    </LinearLayout>
</merge>
