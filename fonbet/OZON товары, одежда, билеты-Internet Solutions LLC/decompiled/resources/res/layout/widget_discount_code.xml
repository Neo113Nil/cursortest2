<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:layout_marginHorizontal="16dp">
    <ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout
        android:id="@+id/valueTil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <EditText
            android:textAppearance="@style/TextStyle.Body.L"
            android:id="@+id/valueEt"
            android:background="@drawable/mobilization_bg_edit_text_selector"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxLength="50"
            android:inputType="text"
            android:imeOptions="actionDone"/>
    </ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout>
    <ru.ozon.app.android.atoms.atom2.ButtonAtom
        android:id="@+id/buttonAtom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"/>
</LinearLayout>
