<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.uni.android.atom.aspect.AspectView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aspectContainer"
    android:layout_width="wrap_content"
    android:layout_height="44dp">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_32">
        <ru.ozon.uni.android.atom.icon.IconView
            android:layout_gravity="center_vertical"
            android:id="@+id/brandIv"
            android:layout_width="@dimen/dimen_32"
            android:layout_height="@dimen/dimen_32"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Body.500medium"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/brandTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            android:paddingHorizontal="@dimen/dimen_4"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</ru.ozon.uni.android.atom.aspect.AspectView>
