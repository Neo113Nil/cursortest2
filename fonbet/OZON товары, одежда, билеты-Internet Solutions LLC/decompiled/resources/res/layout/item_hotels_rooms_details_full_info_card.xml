<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_rounded_secondary_12_stroke_separator_1"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="150dp"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hotelsRoomsDetailsInfoCardIv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/hotelsRoomsDetailsInfoCardKeyTAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/hotelsRoomsDetailsInfoCardIv"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/hotelsRoomsDetailsInfoCardValueTAV"
        android:paddingTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/hotelsRoomsDetailsInfoCardIv"
        app:layout_constraintTop_toBottomOf="@+id/hotelsRoomsDetailsInfoCardKeyTAV"/>
</androidx.constraintlayout.widget.ConstraintLayout>
