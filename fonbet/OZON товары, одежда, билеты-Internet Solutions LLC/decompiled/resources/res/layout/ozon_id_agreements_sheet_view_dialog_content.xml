<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.CompactControl.500medium"
        android:gravity="center"
        android:id="@+id/titleTextAtomView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/closeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OzonTextAppearance.CompactControl.500medium"/>
    <ru.ozon.uni.android.controls.button.IconButtonView
        android:id="@+id/closeButton"
        android:nextFocusDown="@+id/subtitleTextAtomView"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Button.NeutralSecondary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/navBarBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="titleTextAtomView,closeButton"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Body.500medium"
        android:textColor="@color/text_secondary"
        android:id="@+id/subtitleTextAtomView"
        android:nextFocusUp="@+id/closeButton"
        android:nextFocusDown="@+id/checkboxesFlow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarBarrier"
        style="@style/OzonTextAppearance.Body.500medium"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/checkboxesFlow"
        android:background="@drawable/bg_ozon_id_agreements_sheet_checkboxes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="4dp"
        app:constraint_referenced_ids="termsOfUseCheckbox,adsCheckbox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTextAtomView"/>
    <ru.ozon.uni.android.cell.selection.checkbox.CheckboxTitleSubtitleCellView
        android:id="@+id/termsOfUseCheckbox"
        android:nextFocusUp="@+id/closeButton"
        android:nextFocusDown="@+id/adsCheckbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="9dp"
        android:focusedByDefault="true"/>
    <View
        android:id="@+id/checkboxesSeparator"
        android:background="@color/graphic_neutral"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/termsOfUseCheckbox"
        app:layout_constraintEnd_toEndOf="@+id/checkboxesFlow"
        app:layout_constraintStart_toStartOf="@+id/checkboxesFlow"/>
    <ru.ozon.uni.android.cell.selection.checkbox.CheckboxTitleSubtitleCellView
        android:id="@+id/adsCheckbox"
        android:nextFocusUp="@+id/termsOfUseCheckbox"
        android:nextFocusDown="@+id/completeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="9dp"/>
    <ru.ozon.uni.android.controls.button.ButtonView
        android:id="@+id/completeButton"
        android:nextFocusUp="@+id/checkboxesFlow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="40dp"
        android:layout_marginHorizontal="16dp"
        app:buttonsSize="size_600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checkboxesFlow"
        style="@style/Button.ActionPrimary"/>
</merge>
