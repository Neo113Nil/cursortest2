<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <spay.sdk.view.SPayTextView
        android:id="@+id/spay_slo_tv_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spay_4dp"
        app:layout_constraintEnd_toStartOf="@+id/spay_slo_tv_old_amount"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:spay_font="semibold"
        style="@style/SpayAmountTextStyle"/>
    <spay.sdk.view.SPayTextView
        android:id="@+id/spay_slo_tv_old_amount"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spay_6dp"
        app:layout_constraintBottom_toBottomOf="@+id/spay_slo_tv_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/spay_slo_tv_amount"
        app:spay_font="medium"
        style="@style/Spay.Payment.OldPrice"/>
</androidx.constraintlayout.widget.ConstraintLayout>
