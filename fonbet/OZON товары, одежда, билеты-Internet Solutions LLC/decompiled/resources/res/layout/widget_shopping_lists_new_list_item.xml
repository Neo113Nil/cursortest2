<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/layer_floor_1"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/bg_ripple_blue_rounded"
    android:paddingStart="@dimen/default_padding"
    android:paddingEnd="@dimen/default_padding">
    <View
        android:id="@+id/addImageBackgroundView"
        android:background="@drawable/bg_image_white_overlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/addImageOverlayView"
        android:background="@drawable/bg_image_overlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/addIv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="@dimen/margin_extra_small"
        app:layout_constraintBottom_toBottomOf="@+id/addImageOverlayView"
        app:layout_constraintEnd_toEndOf="@+id/addImageOverlayView"
        app:layout_constraintStart_toStartOf="@+id/addImageOverlayView"
        app:layout_constraintTop_toTopOf="@+id/addImageOverlayView"
        app:srcCompat="@drawable/ic_plus_blue"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Blue"
        android:id="@+id/addTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shopping_lists_new_list_android"
        android:layout_marginStart="@dimen/default_margin"
        app:layout_constraintBottom_toBottomOf="@+id/addImageOverlayView"
        app:layout_constraintStart_toEndOf="@+id/addImageOverlayView"
        app:layout_constraintTop_toTopOf="@+id/addImageOverlayView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
