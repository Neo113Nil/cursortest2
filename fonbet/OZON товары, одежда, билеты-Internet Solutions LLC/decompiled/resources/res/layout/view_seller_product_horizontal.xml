<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCl"
    android:background="?attr/layerFloor1"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/fg_sku_ripple">
    <ru.ozon.app.android.sellerproducts.sellerProducts.views.CsmaSkuImageWrapper
        android:id="@+id/adultIv"
        android:layout_width="112dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stateVal"
        app:layout_constraintVertical_bias="0"/>
    <ImageView
        android:id="@+id/overlayImage"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/adultIv"
        app:layout_constraintEnd_toEndOf="@+id/adultIv"
        app:layout_constraintStart_toStartOf="@+id/adultIv"
        app:layout_constraintTop_toTopOf="@+id/adultIv"/>
    <ru.ozon.app.android.product.common.overlaytitle.OverlayTitleView
        android:layout_gravity="bottom"
        android:id="@+id/overlayTitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/adultIv"
        app:layout_constraintEnd_toEndOf="@+id/adultIv"
        app:layout_constraintStart_toStartOf="@+id/adultIv"/>
    <ru.ozon.app.android.product.common.wave.WaveView
        android:id="@+id/waveView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/adultIv"
        app:layout_constraintEnd_toEndOf="@+id/adultIv"
        app:layout_constraintStart_toStartOf="@+id/adultIv"/>
    <ru.ozon.app.android.atoms.v3.containers.AtomBadgesLayout
        android:id="@+id/badgesContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/adultIv"
        app:layout_constraintEnd_toEndOf="@+id/adultIv"
        app:layout_constraintStart_toStartOf="@+id/adultIv"
        app:layout_constraintTop_toTopOf="@+id/adultIv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stateVal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toStartOf="@+id/favoriteButton"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/adultIv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginBottom="12dp"
        app:layout_goneMarginEnd="16dp"/>
    <ru.ozon.app.android.sellerproducts.sellerProducts.secondarybutton.UwButtonsContainerView
        android:id="@+id/buttonsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/adultIv"
        app:layout_constraintTop_toBottomOf="@+id/stateVal"
        app:layout_constraintVertical_bias="0"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/buttonV3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/adultIv"
        app:layout_constraintTop_toBottomOf="@+id/stateVal"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/buttonsBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="buttonsContainer, buttonV3"/>
    <ru.ozon.app.android.favorites.ui.favoritebutton.favoriteproduct.ui.buttonview.ProductFavoriteMoleculeButtonView
        android:id="@+id/favoriteButton"
        android:background="@drawable/bg_white_ripple_blue_round"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_m_fav_tiles_normal"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.uikit.view.atoms.texts.TextAtomWithIconView
        android:id="@+id/buttonSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/adultIv"
        app:layout_constraintTop_toBottomOf="@+id/buttonsBarrier"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:barrierMargin="12dp"
        app:constraint_referenced_ids="adultIv,stateVal,buttonsContainer,buttonV3,buttonSubtitle"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomBarrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
