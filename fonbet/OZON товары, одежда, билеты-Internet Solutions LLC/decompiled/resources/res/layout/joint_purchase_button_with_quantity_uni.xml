<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="32dp">
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
        android:id="@+id/atomButtonView"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:id="@+id/minusIconButtonAtom"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/minusFadeV"
        android:background="@color/oz_gray_90"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.6"
        app:layout_constraintBottom_toBottomOf="@+id/minusIconButtonAtom"
        app:layout_constraintEnd_toEndOf="@+id/minusIconButtonAtom"
        app:layout_constraintStart_toStartOf="@+id/minusIconButtonAtom"
        app:layout_constraintTop_toTopOf="@+id/minusIconButtonAtom"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:id="@+id/plusIconButtonAtom"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:id="@+id/plusFadeV"
        android:background="@color/oz_gray_90"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.6"
        app:layout_constraintBottom_toBottomOf="@+id/plusIconButtonAtom"
        app:layout_constraintEnd_toEndOf="@+id/plusIconButtonAtom"
        app:layout_constraintStart_toStartOf="@+id/plusIconButtonAtom"
        app:layout_constraintTop_toTopOf="@+id/plusIconButtonAtom"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Body.M.Black"
        android:gravity="center"
        android:id="@+id/quantityTav"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/plusIconButtonAtom"
        app:layout_constraintEnd_toStartOf="@+id/plusIconButtonAtom"
        app:layout_constraintStart_toEndOf="@+id/minusIconButtonAtom"
        app:layout_constraintTop_toTopOf="@+id/plusIconButtonAtom"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/addToCartCounterGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="plusIconButtonAtom,quantityTav,minusIconButtonAtom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
