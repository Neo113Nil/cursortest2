<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:id="@+id/sendCommentLl"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">
    <EditText
        android:textAppearance="@style/TextStyle.Body.L"
        android:id="@+id/sendCommentEt"
        android:background="@drawable/bg_comment_et"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:maxLines="5"
        android:maxLength="1000"
        android:layout_weight="1"
        android:inputType="textMultiLine"
        android:layout_marginEnd="16dp"/>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/sendCommentIv"
        android:padding="6dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:srcCompat="@drawable/ic_s_arrow_up"/>
</LinearLayout>
