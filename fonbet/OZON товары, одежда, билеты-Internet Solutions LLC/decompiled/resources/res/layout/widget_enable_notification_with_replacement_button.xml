<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:layout_gravity="center"
        android:id="@+id/notificationIconButton"
        android:tag="@string/commonwidgets_navbar_disable_color_filtering"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="3dp"
        style="@style/SmallIconButton.Transparent"/>
    <ru.ozon.app.android.checkoutcomposer.enableNotificationWithReplacementButton.presentation.DotWithCircleView
        android:layout_gravity="end|top"
        android:id="@+id/notificationDot"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="11dp"/>
</FrameLayout>
