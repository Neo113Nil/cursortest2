<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout
        android:id="@+id/nameTil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OzTextInput.Layout">
        <androidx.appcompat.widget.AppCompatEditText
            android:ellipsize="end"
            android:id="@+id/nameEt"
            android:background="@drawable/mobilization_bg_edit_text_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:maxLength="80"
            android:inputType="text"
            style="@style/OzTextInput.EditText"/>
    </ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Red"
        android:id="@+id/nameErrorTv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="@+id/nameTil"
        app:layout_constraintStart_toStartOf="@+id/nameTil"
        app:layout_constraintTop_toBottomOf="@+id/nameTil"/>
    <ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout
        android:id="@+id/phoneTil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nameErrorTv"
        app:mtil_hintPosition="top"
        style="@style/OzTextInput.Layout">
        <androidx.appcompat.widget.AppCompatEditText
            android:ellipsize="end"
            android:id="@+id/phoneEt"
            android:background="@drawable/mobilization_bg_edit_text_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:maxLength="16"
            android:inputType="phone"
            style="@style/OzTextInput.EditText"/>
    </ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Red"
        android:id="@+id/phoneErrorTv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="@+id/phoneTil"
        app:layout_constraintStart_toStartOf="@+id/phoneTil"
        app:layout_constraintTop_toBottomOf="@+id/phoneTil"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/saveBa"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phoneErrorTv"
        app:layout_constraintVertical_bias="0.333"/>
</androidx.constraintlayout.widget.ConstraintLayout>
