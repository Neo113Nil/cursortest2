<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:transitionName="payTransition">
    <spay.sdk.view.SPayTextView
        android:id="@+id/spay_slpn_actv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spay_60dp"
        android:text="@string/spay_enter_phone_number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SpayBottomSheet.MainTextStyle"/>
    <spay.sdk.view.PhoneNumberCompositeView
        android:id="@+id/spay_slpn_acet_phone_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spay_8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spay_slpn_actv_title"
        app:spay_font="semibold"
        style="@style/Spay.PhoneNumber"/>
    <spay.sdk.view.SPayTextView
        android:textColor="@color/spay_exception_color"
        android:gravity="center_horizontal"
        android:id="@+id/spay_slpn_actv_exception"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spay_8dp"
        android:text="@string/spay_enter_full_number"
        app:layout_constraintBottom_toTopOf="@+id/spay_slpn_stv_terms_of_service"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spay_slpn_acet_phone_number"
        app:layout_goneMarginBottom="@dimen/spay_40dp"
        style="@style/SpayBottomSheet.MainTextStyle"/>
    <spay.sdk.view.SPayTextView
        android:gravity="start"
        android:id="@+id/spay_slpn_stv_terms_of_service"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spay_8dp"
        android:layout_marginBottom="@dimen/spay_40dp"
        android:layout_marginHorizontal="@dimen/spay_16dp"
        app:layout_constraintBottom_toTopOf="@+id/spay_slpn_mb_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spay_slpn_actv_exception"
        app:spay_font="medium"
        style="@style/SpayNmtTermsOfService.TextStyle"/>
    <spay.sdk.view.SPayMaterialButton
        android:textColor="@color/spay_main_reversed_text_color"
        android:id="@+id/spay_slpn_mb_continue"
        android:layout_width="0dp"
        android:layout_marginBottom="@dimen/spay_8dp"
        android:text="@string/spay_btn_label_continue"
        android:layout_marginHorizontal="@dimen/spay_large_margin"
        app:backgroundTint="@color/spay_button_main_color"
        app:iconGravity="textEnd"
        app:iconPadding="@dimen/spay_8dp"
        app:iconTint="@color/spay_text_color_white"
        app:layout_constraintBottom_toTopOf="@+id/spay_slpn_acb_backward"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SpayGreenButton"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/spay_slpn_acb_backward"
        android:text="@string/spay_btn_label_back"
        android:layout_marginHorizontal="@dimen/spay_large_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SpayTransparentButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
