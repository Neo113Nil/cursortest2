<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tariffV2RootContainer"
    android:layout_width="240dp"
    android:layout_height="match_parent">
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/tariffV2BadgeView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/tariffV2CheckBox"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:button="@drawable/selector_travel_flight_check_tariff"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="16dp"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:id="@+id/tariffV2TitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tariffV2CheckBox"
        app:layout_constraintTop_toTopOf="@+id/tariffV2CheckBox"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/tariffV2PriceView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tariffV2DiscountTextView"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/tariffV2TitleTextView"
        app:layout_constraintTop_toBottomOf="@+id/tariffV2TitleTextView"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/tariffV2DiscountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tariffV2PriceView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tariffV2PriceView"
        app:layout_constraintTop_toTopOf="@+id/tariffV2PriceView"
        app:layout_constraintVertical_bias="0.72"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/tariffPremiumBadgeBV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@+id/tariffV2PriceView"
        app:layout_constraintTop_toBottomOf="@+id/tariffV2PriceView"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/tariffV2PriceLabelTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tariffPremiumBadgeBV"
        app:layout_constraintTop_toBottomOf="@+id/tariffV2PriceView"
        app:layout_goneMarginStart="0dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/tariffV2PriceBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tariffV2PriceView,tariffV2PriceLabelTextView, tariffPremiumBadgeBV"/>
    <View
        android:id="@+id/tariffV2Separator"
        android:background="?attr/graphicNeutral"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tariffV2PriceBarrier"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tariffV2DirectionRecyclerView"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:nestedScrollingEnabled="false"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tariffV2Separator"
        app:layout_constraintVertical_bias="0"/>
</merge>
