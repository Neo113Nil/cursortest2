<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimen_24">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/addEdoDescriptionTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/addEdoBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/addEdoAdditionalBtn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
