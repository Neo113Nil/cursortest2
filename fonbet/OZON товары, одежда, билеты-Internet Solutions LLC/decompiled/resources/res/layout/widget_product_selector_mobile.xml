<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/productSelectorFl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="?attr/oz_semantic_bg_secondary"
        app:cardCornerRadius="10dp"
        app:cardElevation="12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/productSelectorCl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="116dp"
            android:paddingStart="20dp">
            <TextView
                android:textAppearance="@style/TextStyle.Body.L.Bold"
                android:id="@+id/titleTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toTopOf="@+id/subtitleTv"
                app:layout_constraintEnd_toStartOf="@+id/selectorImageIv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="spread_inside"/>
            <TextView
                android:textAppearance="@style/TextStyle.Caption.Gray40"
                android:id="@+id/subtitleTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toTopOf="@+id/buttonsLl"
                app:layout_constraintEnd_toStartOf="@+id/selectorImageIv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titleTv"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/buttonsLl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toTopOf="@+id/tagsTitleTv"
                app:layout_constraintEnd_toStartOf="@+id/selectorImageIv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitleTv"
                app:layout_goneMarginBottom="16dp">
                <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
                    android:id="@+id/actionButtonView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
                    android:id="@+id/resetButtonView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/regular_margin_8"/>
            </LinearLayout>
            <TextView
                android:textAppearance="@style/TextStyle.Body.L"
                android:id="@+id/tagsTitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toTopOf="@+id/tagsFal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonsLl"/>
            <ru.ozon.uni.atoms.af.layout.HorizontalFlexAtomsLayout
                android:id="@+id/tagsFal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/selectorImageIv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tagsTitleTv"/>
            <ImageView
                android:id="@+id/selectorImageIv"
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:scaleType="fitEnd"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_max="116dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
