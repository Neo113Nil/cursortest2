<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="?attr/layerFloor2"
    app:cardCornerRadius="12dp"
    app:cardElevation="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp">
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/titleTav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/paypropsTav"
            app:layout_constraintEnd_toStartOf="@+id/removeSibv"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/paypropsTav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/addressTav"
            app:layout_constraintEnd_toStartOf="@+id/removeSibv"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleTav"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/addressTav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/removeSibv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/paypropsTav"/>
        <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
            android:id="@+id/removeSibv"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:tint="@color/graphic_neutral_on_light"
            android:paddingStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/clickableAreaSibv"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/removeSibv"
            app:layout_constraintEnd_toEndOf="@+id/removeSibv"
            app:layout_constraintStart_toStartOf="@+id/removeSibv"
            app:layout_constraintTop_toTopOf="@+id/removeSibv"/>
        <ru.ozon.app.android.atoms.af.layout.HorizontalAtomsLayout
            android:id="@+id/controlsAtom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/addressTav"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
