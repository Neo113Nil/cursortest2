<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/quantityCellTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/quantityCellMinusBtn"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/quantityCellSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/quantityCellMinusBtn"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quantityCellTitle"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:id="@+id/quantityCellMinusBtn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/ic_s_minus"
        android:tint="?attr/bgActionPrimary"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/quantityCellCounter"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SmallIconButton.Grey"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:gravity="center"
        android:id="@+id/quantityCellCounter"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/quantityCellPlusBtn"
        app:layout_constraintTop_toTopOf="@+id/quantityCellMinusBtn"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:id="@+id/quantityCellPlusBtn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_s_plus"
        android:tint="?attr/bgActionPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/quantityCellMinusBtn"
        style="@style/SmallIconButton.Grey"/>
</merge>
