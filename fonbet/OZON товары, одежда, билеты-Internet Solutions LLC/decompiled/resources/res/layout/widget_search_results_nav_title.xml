<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">
    <ru.ozon.app.android.travel.feature.general.booking.widgets.searchResultsNavTitle.v1.view.TravelSearchResultsNavTitleViewGroup
        android:id="@+id/travelSearchResultsNavTitleViewGroup"
        android:layout_width="0dp"
        android:layout_height="18dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/departureTav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:autoSizeMaxTextSize="26sp"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toStartOf="@+id/symbolBetween"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/symbolBetween"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/departureTav"
            app:layout_constraintEnd_toStartOf="@+id/arrivalTav"
            app:layout_constraintStart_toEndOf="@+id/departureTav"
            app:layout_constraintTop_toTopOf="@+id/departureTav"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/arrivalTav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:autoSizeMaxTextSize="26sp"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBaseline_toBaselineOf="@+id/departureTav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/symbolBetween"/>
    </ru.ozon.app.android.travel.feature.general.booking.widgets.searchResultsNavTitle.v1.view.TravelSearchResultsNavTitleViewGroup>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/subtitleTav"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:textAlignment="center"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelSearchResultsNavTitleViewGroup"/>
</androidx.constraintlayout.widget.ConstraintLayout>
