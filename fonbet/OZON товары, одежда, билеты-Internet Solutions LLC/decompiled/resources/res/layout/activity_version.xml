<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="?attr/oz_semantic_bg_secondary"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.MyApp.ToolBar"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/appVersionTil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Версия приложения"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/OzTextInput.Layout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/appVersionEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789.-"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            style="@style/OzTextInput.EditText"/>
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:textAppearance="@style/TextStyle.Body"
        android:id="@+id/appVersionHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Поддерживаемые форматы: 8.9-1070 или 8.9.1-246"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appVersionTil"/>
    <Button
        android:id="@+id/saveVersionBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Применить"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appVersionHint"
        style="@style/LargeButton.Primary"/>
    <Button
        android:id="@+id/clearVersionBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Сбросить на значение по умолчанию"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/saveVersionBtn"
        style="@style/SmallButton.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
