<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.image.Image
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:layout_marginEnd="@dimen/dimen_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/borderView"
        android:background="@drawable/bg_media_picker_empty_item"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <View
        android:id="@+id/badgeBackgroundView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-2dp"
        android:layout_marginBottom="-2dp"
        android:layout_marginStart="-2dp"
        android:layout_marginEnd="-2dp"
        app:layout_constraintBottom_toBottomOf="@+id/badgeView"
        app:layout_constraintEnd_toEndOf="@+id/badgeView"
        app:layout_constraintStart_toStartOf="@+id/badgeView"
        app:layout_constraintTop_toTopOf="@+id/badgeView"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/badgeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/badgeGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="badgeView,badgeBackgroundView"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/removeIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/centerIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/retryIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/cancelIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <ru.ozon.app.android.ugc.widgets.common.mediaPicker.presentation.views.CircularProgressBar
        android:id="@+id/progressView"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_36"
        android:layout_height="@dimen/dimen_36"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
