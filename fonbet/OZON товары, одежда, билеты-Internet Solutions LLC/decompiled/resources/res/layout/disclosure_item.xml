<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_icon"
        android:background="@drawable/background_rounded_semantic_ctrl_neutral_pale_100_12"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_m_settings_filled"
        android:scaleType="center"
        android:tint="@color/oz_blue"
        app:tint="@color/oz_blue"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/oz_semantic_text_primary"
        android:gravity="start"
        android:layout_gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fintech_disclosure_subtitle_2"
        android:layout_marginStart="16dp"
        android:lineHeight="20dp"
        style="@style/TextStyle.Body.L.Bold"/>
</merge>
