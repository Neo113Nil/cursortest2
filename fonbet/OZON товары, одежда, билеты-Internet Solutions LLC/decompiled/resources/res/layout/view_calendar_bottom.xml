<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/layerFloor1"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/clearButtonAPIV"
        android:background="@drawable/o2_button_danger"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_m_trash_bin"
        android:scaleType="center"
        android:tint="@color/o2_selector_color_text_for_button_danger"
        android:layout_marginEnd="8dp"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/calendarSelectDateButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/common_ready"
        android:textAllCaps="false"
        style="@style/OzButton.L.Blue"/>
</merge>
