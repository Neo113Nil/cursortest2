<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ru.ozon.fintech.ui.toolbar.FinToolbarView
            android:id="@+id/tool_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:elevation="0dp"
            app:elevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.MyApp.ToolBar"/>
        <TextView
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:id="@+id/scanner_mode_header"
            android:background="@color/oz_semantic_bg_primary"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fintech_preference_scanner_type_header_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tool_bar"/>
        <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
            android:id="@+id/qr_mode"
            android:background="@color/oz_semantic_bg_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scanner_mode_header"/>
        <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
            android:id="@+id/barcode_mode"
            android:background="@color/oz_semantic_bg_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qr_mode"/>
        <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
            android:id="@+id/mix_mode"
            android:background="@color/oz_semantic_bg_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barcode_mode"/>
        <TextView
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:id="@+id/qr_action_header1"
            android:background="@color/oz_semantic_bg_primary"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fintech_preference_qr_action_header_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mix_mode"/>
        <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
            android:id="@+id/frbv_try_to_go"
            android:background="@color/oz_semantic_bg_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qr_action_header1"/>
        <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
            android:id="@+id/frbv_return_value"
            android:background="@color/oz_semantic_bg_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/frbv_try_to_go"/>
        <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
            android:id="@+id/frbv_photo_value"
            android:background="@color/oz_semantic_bg_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/frbv_return_value"/>
        <TextView
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:id="@+id/qr_action_header2"
            android:background="@color/oz_semantic_bg_primary"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fintech_preference_confirm_header_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/frbv_photo_value"/>
        <Switch
            android:id="@+id/confirm_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/qr_action_header2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/qr_action_header2"/>
        <ru.ozon.fintech.ui.button.large.FinLargeButtonView
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/confirm_switch"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
