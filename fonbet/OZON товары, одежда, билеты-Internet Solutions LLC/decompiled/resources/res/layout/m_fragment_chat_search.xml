<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatListRootCl"
    android:background="?attr/layerFloor0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.ozon.android.messenger.blocks.common.SquircleLinearLayout
        android:orientation="vertical"
        android:id="@+id/headerContainerLl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:m_corner_bottom="true"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/searchContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainerLl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainerLl"/>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/middleContainerLl"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainerLl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainerLl"
        app:m_corner_bottom="true"/>
    <ru.ozon.android.messenger.blocks.common.SquircleLinearLayout
        android:orientation="vertical"
        android:id="@+id/bottomContainerLl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
