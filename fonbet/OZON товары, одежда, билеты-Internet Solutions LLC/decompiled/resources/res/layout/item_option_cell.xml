<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ripple_rect_bluewave"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">
    <ImageView
        android:id="@+id/disclosureIv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_disclosure_small"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageIv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/textPrimary"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Gray60"
        android:id="@+id/subtitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/disclosureIv"
        app:layout_constraintStart_toEndOf="@+id/imageIv"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"
        app:layout_goneMarginStart="0dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:ellipsize="end"
        android:id="@+id/titleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTv"
        app:layout_constraintEnd_toStartOf="@+id/badgesHAL"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/imageIv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"/>
    <ru.ozon.app.android.atoms.af.layout.HorizontalAtomsLayout
        android:id="@+id/badgesHAL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/numberPVZ"
        app:layout_constraintStart_toEndOf="@+id/titleTv"
        app:layout_constraintTop_toTopOf="@+id/titleTv"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/numberPVZ"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/disclosureIv"
        app:layout_constraintEnd_toStartOf="@+id/disclosureIv"
        app:layout_constraintTop_toTopOf="@+id/disclosureIv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
