<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ozonIdDebugPreferencesRoot"
    android:paddingTop="60dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ozonIdDebugPreferencesContent"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/ozonIdDebugPreferencesBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-16dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/preferencesBlockTitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Preferences"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/ozonIdDebugPreferencesBlock"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/preferences"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/copyPreferencesButton"
            app:layout_constraintTop_toBottomOf="@+id/preferencesBlockTitleTextView"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyPreferencesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Скопировать"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/ButtonDebug"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
