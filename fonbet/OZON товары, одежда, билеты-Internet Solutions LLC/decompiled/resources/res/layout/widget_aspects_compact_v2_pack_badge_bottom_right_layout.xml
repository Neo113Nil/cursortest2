<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.pdp.ui.configurators.aspectsCompactV2.VariantConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/infoFl"
        android:background="@drawable/bg_aspects_pack_selectable"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="104dp">
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:gravity="center"
            android:id="@+id/titleTav"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="256dp"
            app:layout_constrainedWidth="true"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:gravity="center"
            android:id="@+id/subtitleTav"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="256dp"
            app:layout_constrainedWidth="true"/>
    </LinearLayout>
    <FrameLayout
        android:background="@drawable/bg_aspects_v2_badge_bg"
        android:padding="@dimen/dimen_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:rotation="-6"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ru.ozon.uni.android.atom.badge.BadgeView
            android:layout_gravity="center"
            android:id="@+id/badgeV"
            android:layout_width="39dp"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</ru.ozon.app.android.pdp.ui.configurators.aspectsCompactV2.VariantConstraintLayout>
