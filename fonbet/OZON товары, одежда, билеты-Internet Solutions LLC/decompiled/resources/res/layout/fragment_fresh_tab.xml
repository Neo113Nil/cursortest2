<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentCl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/rootContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="ru.ozon.app.android.tabbar.ui.behavior.FragmentContainerBehavior"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/separatorForDarkTheme"
        android:background="@color/oz_semantic_separator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="@dimen/bottom_navigation_height"/>
    <ru.ozon.app.android.tabbar.ui.OzonBottomNavigationView
        android:theme="@style/BottomNavigationView"
        android:layout_gravity="bottom"
        android:id="@+id/bottomNavigation"
        android:background="?attr/layerFloor1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_navigation_height"
        app:itemIconTint="@color/bottomnavigation_fresh_icon_color"
        app:itemTextColor="@color/bottomnavigation_fresh_text_color"/>
    <ru.ozon.app.android.uikit.screenstate.ScreenStateViewWidget
        android:id="@+id/screenState"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
