<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:paddingTop="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:paddingHorizontal="16dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/productImageIV"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:backgroundTintMode="src_over"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:shapeAppearanceOverlay="@style/OverlayCornerSize6"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/promoIconView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/productImageIV"
        app:layout_constraintEnd_toEndOf="@+id/productImageIV"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/productImageIV"
        app:layout_constraintTop_toTopOf="@+id/productImageIV"
        app:layout_constraintVertical_bias="1"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/priceSA"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/productImageIV"
        app:layout_constraintTop_toTopOf="@+id/productImageIV"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/premiumPriceSA"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/productImageIV"
        app:layout_constraintTop_toBottomOf="@+id/priceSA"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/descriptionSA"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/productImageIV"
        app:layout_constraintTop_toBottomOf="@+id/premiumPriceSA"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/quantitySA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/productImageIV"
        app:layout_constraintTop_toBottomOf="@+id/descriptionSA"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/decreaseQuantityBtn"
        android:background="@drawable/bg_counter_button_selector"
        android:clickable="false"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/quantityEt"
        app:layout_constraintStart_toEndOf="@+id/productImageIV"
        app:layout_constraintTop_toTopOf="@+id/quantityEt"
        app:srcCompat="@drawable/ic_s_minus"
        app:tint="@color/tint_counter_button_selector"/>
    <ru.ozon.app.android.cart.ui.quantityInput.QuantityInput
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:gravity="center"
        android:id="@+id/quantityEt"
        android:background="@drawable/bg_quantity_input_selector"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:minWidth="42dp"
        android:selectAllOnFocus="false"
        android:maxLength="4"
        android:inputType="none"
        android:imeOptions="actionDone"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintStart_toEndOf="@+id/decreaseQuantityBtn"
        app:layout_constraintTop_toBottomOf="@+id/descriptionSA"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/increaseQuantityBtn"
        android:background="@drawable/bg_counter_button_selector"
        android:clickable="false"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/quantityEt"
        app:layout_constraintStart_toEndOf="@+id/quantityEt"
        app:layout_constraintTop_toTopOf="@+id/quantityEt"
        app:srcCompat="@drawable/ic_s_plus"
        app:tint="@color/tint_counter_button_selector"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/quantityBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="quantitySA,increaseQuantityBtn"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/pricePerItemSA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/quantityEt"
        app:layout_constraintStart_toEndOf="@+id/quantityBarrier"
        app:layout_constraintTop_toTopOf="@+id/quantityEt"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/annotationSA"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/productImageIV"
        app:layout_constraintTop_toBottomOf="@+id/quantitySA"/>
</androidx.constraintlayout.widget.ConstraintLayout>
