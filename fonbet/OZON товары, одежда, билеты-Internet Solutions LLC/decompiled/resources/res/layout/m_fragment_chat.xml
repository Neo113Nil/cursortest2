<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatContainerCl"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/headerContainerLl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.android.messenger.blocks.common.BottomArcView
        android:id="@+id/teethArch"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_24"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainerLl"/>
    <ru.ozon.android.messenger.blocks.common.SquircleLinearLayout
        android:id="@+id/pinContainerLl"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainerLl"
        app:m_background_fill_color="@color/bg_primary"
        app:m_concave_bottom="true"
        app:m_corner_top="true"/>
    <ru.ozon.android.messenger.framework.presentation.common.view.recycler.MessengerMetricsRecyclerView
        android:id="@+id/messagesRv"
        android:paddingBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainerLl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainerLl"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginBottom="0dp"
        app:layout_goneMarginTop="0dp"
        app:stackFromEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/actionButtonContainer"
        android:paddingBottom="@dimen/dimen_52"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainerLl"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ru.ozon.android.messenger.framework.presentation.chatdetail.view.ScrollToLastMessageButton
        android:id="@+id/scrollToLastMessageBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainerLl"
        app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/middleContainerLl"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxHeight="100dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainerLl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainerLl"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottomContainerLl"
        android:background="@color/layer_floor_1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/m_view_progressbar_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
