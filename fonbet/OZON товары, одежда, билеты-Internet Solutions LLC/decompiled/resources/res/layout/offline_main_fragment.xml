<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/layer_floor_1"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_view"
        android:background="@color/layer_floor_0"
        android:visibility="invisible"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:id="@+id/top_space"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ru.ozon.uni.android.atom.disclaimer.DisclaimerView
                android:id="@+id/offline_disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_space"/>
            <ru.ozon.fintech.features.offline.ui.accountcard.AccountCardView
                android:id="@+id/offline_main_account_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/offline_disclaimer"/>
            <View
                android:id="@+id/offline_v_background"
                android:background="@drawable/background_rounded_floor1_24_top_trans"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/offline_main_account_view"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_primary"
                android:id="@+id/offline_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/offline_v_background"
                style="@style/OzonTextAppearance.Headline.500medium"/>
            <ru.ozon.fintech.features.offline.ui.itemcard.IconTextCardView
                android:id="@+id/icon_text_card_call_center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:layout_marginVertical="16dp"
                app:layout_constraintEnd_toStartOf="@+id/icon_text_card_sbp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/offline_title"/>
            <ru.ozon.fintech.features.offline.ui.itemcard.IconTextCardView
                android:id="@+id/icon_text_card_sbp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginVertical="@dimen/dimen_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/icon_text_card_call_center"
                app:layout_constraintTop_toBottomOf="@+id/offline_title"/>
            <Space
                android:id="@+id/bottom_space"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/icon_text_card_call_center"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <ru.ozon.fintech.ui.toolbar.FinToolbarView
        android:id="@+id/tool_bar"
        android:background="@drawable/background_rounded_floor1_24_bottom_trans"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:elevation="0dp"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.MyApp.ToolBar"/>
    <View
        android:id="@+id/bottom_holder"
        android:background="@drawable/background_rounded_floor1_24_top_trans"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:minHeight="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/offline_button"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textAlignment="center"
        app:iconColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_holder"
        app:size="size_600"
        style="@style/Button.ActionPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
