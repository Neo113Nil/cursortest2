<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/close_screen_btn"
        android:padding="@dimen/dimen_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_16"
        android:src="@drawable/ic_s_cross_filled"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/screen_state_image"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toTopOf="@+id/screen_state_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/TextStyle.Head.L"
        android:textColor="@color/oz_semantic_text_primary"
        android:gravity="center"
        android:id="@+id/screen_state_title"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20"
        android:layout_marginBottom="@dimen/dimen_8"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toTopOf="@+id/screen_state_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="spread"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:textColor="@color/oz_semantic_text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/screen_state_description"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_20"
        android:minHeight="@dimen/dimen_40"
        android:maxLines="10"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toTopOf="@+id/screen_state_butt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="spread"/>
    <ru.ozon.fintech.ui.button.large.FinLargeButtonView
        android:id="@+id/screen_state_butt"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_24"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/screen_state_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FinProgressBarStyle"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/screen_state_progress_button"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/screen_state_butt"
        app:layout_constraintEnd_toEndOf="@+id/screen_state_butt"
        app:layout_constraintStart_toStartOf="@+id/screen_state_butt"
        app:layout_constraintTop_toTopOf="@+id/screen_state_butt"
        style="@style/FinProgressButtonStyle"/>
</merge>
