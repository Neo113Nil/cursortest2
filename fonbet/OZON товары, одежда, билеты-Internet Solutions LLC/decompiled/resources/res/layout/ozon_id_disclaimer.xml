<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/disclaimerLinearLayout"
    android:background="@drawable/bg_ozon_id_disclaimer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <ru.ozon.uni.android.cell.icon.IconTitleSubtitleCellView
        android:id="@+id/disclaimerBodyView"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.controls.button.UncontainedButtonView
        android:id="@+id/disclaimerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="52dp"
        style="@style/UncontainedButtonDefaultStyle"/>
</LinearLayout>
