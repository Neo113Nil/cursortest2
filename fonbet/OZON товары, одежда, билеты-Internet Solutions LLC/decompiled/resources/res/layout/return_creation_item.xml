<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/returnCreationProductCl"
    android:background="@color/layer_floor_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.controls.button.IconButtonView
        android:id="@+id/crossIconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.selectionControls.CheckBoxView
        android:id="@+id/checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/itemImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/checkbox"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_image"/>
    <View
        android:id="@+id/imageDisablingOverlay"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/itemImage"
        app:layout_constraintEnd_toEndOf="@+id/itemImage"
        app:layout_constraintStart_toStartOf="@+id/itemImage"
        app:layout_constraintTop_toTopOf="@+id/itemImage"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="vertical"
        android:id="@+id/imageBarrier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:barrierMargin="12dp"
        app:constraint_referenced_ids="itemImage"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/priceAndSealBadgeFlow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:constraint_referenced_ids="priceView, sealBadgeView"
        app:flow_horizontalBias="0"
        app:flow_horizontalGap="4dp"
        app:flow_horizontalStyle="packed"
        app:flow_wrapMode="chain"
        app:layout_constraintBottom_toTopOf="@+id/nameTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.atom.price.ui.PriceAtomView
        android:id="@+id/priceView"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/sealBadgeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/nameTv"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/descriptionTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/priceAndSealBadgeFlow"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/descriptionTv"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@+id/dueDateTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/nameTv"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/dueDateTv"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@+id/badgeBv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/descriptionTv"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/badgeBv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/buttonView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/dueDateTv"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/buttonView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/quantitySelector"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/badgeBv"/>
    <ru.ozon.app.android.returns.ui.molecules.quantitySelector.RmsQuantitySelectorView
        android:id="@+id/quantitySelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/buttonView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
