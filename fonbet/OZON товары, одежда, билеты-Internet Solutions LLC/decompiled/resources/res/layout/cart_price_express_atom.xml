<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clickable="true"
    android:layout_width="wrap_content">
    <ru.ozon.app.android.fresh.main.ui.atoms.cartPrice.PriceFlexboxView
        android:id="@+id/pricesFlexbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/toCartBtnView"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/toCartBtnView"
        android:background="@drawable/bg_cart_primary_ripple_rounded"
        android:padding="4dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_m_cart"
        android:scaleType="fitCenter"
        android:layout_marginVertical="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/oz_text_primary_negative"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/toCartBtnAndPriceGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="pricesFlexbox,toCartBtnView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/minusButtonIv"
        android:background="@drawable/bg_transp_ripple_rounded"
        android:layout_width="40dp"
        android:layout_height="42dp"
        android:contentDescription="@null"
        android:paddingStart="6dp"
        android:paddingEnd="10dp"
        android:paddingVertical="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/plusButtonIv"
        android:background="@drawable/bg_transp_ripple_rounded"
        android:layout_width="40dp"
        android:layout_height="42dp"
        android:contentDescription="@null"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingVertical="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:gravity="center"
        android:id="@+id/countLabelTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/pricePerUnitTv"
        app:layout_constraintEnd_toStartOf="@+id/plusButtonIv"
        app:layout_constraintStart_toEndOf="@+id/minusButtonIv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption"
        android:gravity="center"
        android:id="@+id/pricePerUnitTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/plusButtonIv"
        app:layout_constraintStart_toEndOf="@+id/minusButtonIv"
        app:layout_constraintTop_toBottomOf="@+id/countLabelTv"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/counterPriceGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="plusButtonIv,countLabelTv,pricePerUnitTv,minusButtonIv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
