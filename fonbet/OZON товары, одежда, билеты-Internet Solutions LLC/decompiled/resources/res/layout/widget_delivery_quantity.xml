<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerCl"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/deliveryTitleSAL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/deliveryIconSAL"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/deliveryIconSAL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/deliveryTitleSAL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/deliveryTitleSAL"/>
    <ru.ozon.app.android.checkoutcomposer.deliveryQuantity.presentation.DeliverySwitchButtonsLayout
        android:orientation="horizontal"
        android:id="@+id/deliverySelectorLL"
        android:padding="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toTopOf="@+id/deliveryMessageLL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deliveryTitleSAL"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/deliveryMessageLL"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deliverySelectorLL">
        <ImageView
            android:id="@+id/deliveryMessageIconIv"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            app:tint="?attr/textSecondary"/>
        <ru.ozon.uni.atoms.v3.containers.SingleAtom
            android:layout_gravity="center_vertical"
            android:id="@+id/deliveryMessageSAL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/deliveryMessageIconIv"
            app:layout_constraintStart_toEndOf="@+id/deliveryMessageIconIv"
            app:layout_constraintTop_toTopOf="@+id/deliveryMessageIconIv"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
