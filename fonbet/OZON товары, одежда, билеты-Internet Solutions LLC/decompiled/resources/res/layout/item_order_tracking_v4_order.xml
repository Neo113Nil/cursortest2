<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.ordertracking.v4.presentation.util.PercentageConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/orderCard"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="8dp"
    android:paddingEnd="16dp"
    android:paddingVertical="8dp">
    <ru.ozon.app.android.cscore.adultimage.DeliveryAdultImageView
        android:id="@+id/imageIV"
        android:background="?attr/layerFloor1"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cornerRoundRadius="8dp"
        app:iconViewSize="icon_900"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/countBV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageIV"
        app:layout_constraintStart_toStartOf="@+id/imageIV"/>
    <TextView
        android:id="@+id/titleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTav"
        app:layout_constraintEnd_toStartOf="@+id/timerTv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/imageBarrier"
        app:layout_constraintTop_toTopOf="@+id/imageIV"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="2dp"
        style="@style/OzonTextAppearance.HeadlineCompact.400small"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/OzonTextAppearance.HeadlineCompact.400small"
        android:id="@+id/timerTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFeatureSettings="tnum, lnum"
        app:layout_constraintBottom_toBottomOf="@+id/titleTav"
        app:layout_constraintEnd_toStartOf="@+id/titleIconIv"
        app:layout_constraintStart_toEndOf="@+id/titleTav"
        app:layout_constraintTop_toTopOf="@+id/titleTav"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/titleIconIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/titleTav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/timerTv"
        app:layout_constraintTop_toTopOf="@+id/titleTav"/>
    <TextView
        android:textAppearance="@style/OzonTextAppearance.Compact.400small"
        android:id="@+id/subtitleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="10dp"
        android:breakStrategy="high_quality"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/addressContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/titleTav"/>
    <FrameLayout
        android:id="@+id/addressContainer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/descriptionTav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTav">
        <ru.ozon.app.android.ordertracking.v4.presentation.view.OrderTrackingAddressView
            android:id="@+id/addressView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ru.ozon.app.android.ordertracking.v4.presentation.view.OrderTrackingMarqueeView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/marqueeAddressView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/OzonTextAppearance.Compact.400small"
        android:id="@+id/descriptionTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/actionButtonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/addressContainer"/>
    <FrameLayout
        android:id="@+id/actionButtonContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/imageIV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/descriptionTav"
        app:layout_constraintVertical_bias="0">
        <ru.ozon.uni.android.controls.button.ButtonView
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ru.ozon.uni.android.atom.badge.BadgeView
            android:id="@+id/actionBadge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/imageBarrier"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:barrierDirection="right"
        app:constraint_referenced_ids="imageIV"/>
</ru.ozon.app.android.ordertracking.v4.presentation.util.PercentageConstraintLayout>
