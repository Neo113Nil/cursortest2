<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.ugc.core.widgets.common.StatusableMediaPreviewView
        android:id="@+id/thumbnailPv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/thumbnailIconIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_l_gallery_play"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnailPv"
        app:layout_constraintEnd_toEndOf="@+id/thumbnailPv"
        app:layout_constraintStart_toStartOf="@+id/thumbnailPv"
        app:layout_constraintTop_toTopOf="@+id/thumbnailPv"
        app:tint="?attr/bgLightKey"/>
</androidx.constraintlayout.widget.ConstraintLayout>
