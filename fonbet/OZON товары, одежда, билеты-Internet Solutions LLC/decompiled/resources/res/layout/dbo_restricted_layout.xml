<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dbo_restricted_container"
    android:background="@color/oz_semantic_bg_secondary"
    android:visibility="gone"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_warning"
        android:layout_width="376dp"
        android:layout_height="368dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/dbo_lock"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <TextView
        android:textColor="@color/oz_semantic_text_primary"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/fintech_pinpad_dbo_blocked_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OzonTextAppearance.Headline.600large"/>
    <TextView
        android:textColor="@color/oz_semantic_text_secondary"
        android:gravity="center"
        android:id="@+id/tv_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/fintech_pinpad_dbo_blocked_description"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/continue_dbo_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OzonTextAppearance.Body.500small"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/continue_dbo_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:size="size_600"
        app:titleText="@string/fintech_pinpad_dbo_blocked_btn_title"
        style="@style/Button.ActionPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
