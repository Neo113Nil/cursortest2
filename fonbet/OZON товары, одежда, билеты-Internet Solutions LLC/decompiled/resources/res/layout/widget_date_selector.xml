<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dateLl"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:foreground="@drawable/selector_standard">
    <TextView
        android:textAppearance="@style/TextStyle.Body"
        android:gravity="center_vertical"
        android:id="@+id/dateTitleTv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/default_margin"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/separatorV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/dateIconIv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/default_margin"
        app:layout_constraintBottom_toBottomOf="@+id/dateTitleTv"
        app:layout_constraintEnd_toEndOf="@+id/dateTitleTv"
        app:layout_constraintTop_toTopOf="@+id/dateTitleTv"
        app:srcCompat="@drawable/ic_radio_checked"/>
    <View
        android:id="@+id/separatorV"
        android:background="?attr/graphicNeutral"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/default_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dateTitleTv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
