<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/sellerLa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:elevation="5dp"
        android:outlineProvider="none"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/otherSellerCv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/otherSellerCv"
        app:layout_goneMarginTop="12dp"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/otherSellerCv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:foreground="@drawable/bg_ripple_blue_rounded"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="4dp"
        app:cardBackgroundColor="?attr/layerFloor2"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sellerCl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
                android:id="@+id/sellerPricePa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toTopOf="@+id/sellerRb"
                app:layout_constraintEnd_toStartOf="@+id/legalInfoIv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_goneMarginBottom="12dp"/>
            <ImageView
                android:id="@+id/legalInfoIv"
                android:background="@drawable/bg_ripple_blue_rounded"
                android:padding="12dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/graphicActionPrimary"/>
            <ru.ozon.uni.android.uikit.view.atoms.rating.VectorRatingBar
                android:id="@+id/sellerRb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/separator"
                app:layout_constraintEnd_toStartOf="@+id/sellerRatingTv"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sellerPricePa"
                app:layout_goneMarginBottom="40dp"
                style="@style/RatingBarStyle.S"/>
            <TextView
                android:textAppearance="@style/TextStyle.Body.M.Gray60"
                android:id="@+id/sellerRatingTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/sellerRb"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/sellerRb"
                app:layout_constraintTop_toTopOf="@+id/sellerRb"/>
            <View
                android:id="@+id/separator"
                android:background="?attr/graphicNeutral"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintBottom_toTopOf="@+id/sellerNameTa"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sellerRb"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:id="@+id/sellerNameTa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/atomsVal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/separator"/>
            <ru.ozon.uni.atoms.af.layout.VerticalAtomsLayout
                android:id="@+id/atomsVal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toTopOf="@+id/addToCartTv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sellerNameTa"
                app:layout_goneMarginTop="12dp"/>
            <TextView
                android:textAppearance="@style/TextStyle.Body.M.Bold.White"
                android:gravity="center"
                android:id="@+id/addToCartTv"
                android:background="@drawable/bg_green_blue_ripple_selectable"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="@string/common_add_to_cart"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/favoriteIb"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/atomsVal"/>
            <ImageView
                android:id="@+id/favoriteIb"
                android:background="@drawable/ic_favorite_gray_bg"
                android:padding="8dp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_s_heart"
                android:contentDescription="@null"
                android:layout_marginStart="8dp"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="@+id/addToCartTv"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/addToCartTv"
                app:layout_constraintTop_toTopOf="@+id/addToCartTv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
