<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/oz_semantic_bg_secondary"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:gravity="center_vertical"
        android:id="@+id/summaryTAV"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginHorizontal="16dp"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.borderless.SmallBorderlessButtonView
        android:textAppearance="@style/TextStyle.Body.M"
        android:id="@+id/cancelOrderBtn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
