<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.travel.feature.avia.widgets.aviaSearchResult.legacy.view.v3.AviaSearchV3FlightInfoPlaceholderView
        android:id="@+id/skeletonFlightInfoGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.travel.feature.avia.widgets.aviaSearchResult.legacy.view.v3.AviaSearchV3FlightInfoPlaceholderView
        android:id="@+id/skeletonFlightInfoGroup2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonFlightInfoGroup"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonBaggageGroup1"
        android:layout_width="134dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonFlightInfoGroup2"
        app:spvCornerRadius="6dp"
        app:spvStyle="stroke"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/skeletonHandBaggage1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_m_baggage_cabin"
        android:tint="?attr/layerFloor0"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/skeletonBaggageInfo1"
        app:layout_constraintStart_toEndOf="@+id/skeletonBaggageInfo1"
        app:layout_constraintTop_toTopOf="@+id/skeletonBaggageInfo1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/skeletonBaggage1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_m_baggage_checked"
        android:tint="?attr/layerFloor0"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/skeletonHandBaggage1"
        app:layout_constraintStart_toEndOf="@+id/skeletonHandBaggage1"
        app:layout_constraintTop_toTopOf="@+id/skeletonHandBaggage1"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonBaggageInfo1"
        android:layout_width="64dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/skeletonBaggageGroup1"
        app:layout_constraintStart_toStartOf="@+id/skeletonBaggageGroup1"
        app:layout_constraintTop_toTopOf="@+id/skeletonBaggageGroup1"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonBaggageGroup2"
        android:layout_width="134dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/skeletonBaggageGroup1"
        app:layout_constraintTop_toBottomOf="@+id/skeletonFlightInfoGroup2"
        app:spvCornerRadius="6dp"
        app:spvStyle="stroke"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/skeletonHandBaggage2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_m_baggage_cabin"
        android:tint="?attr/layerFloor0"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/skeletonBaggageInfo2"
        app:layout_constraintStart_toEndOf="@+id/skeletonBaggageInfo2"
        app:layout_constraintTop_toTopOf="@+id/skeletonBaggageInfo2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/skeletonBaggage2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_m_baggage_checked"
        android:tint="?attr/layerFloor0"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/skeletonHandBaggage2"
        app:layout_constraintStart_toEndOf="@+id/skeletonHandBaggage2"
        app:layout_constraintTop_toTopOf="@+id/skeletonHandBaggage2"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonBaggageInfo2"
        android:layout_width="64dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/skeletonBaggageGroup2"
        app:layout_constraintStart_toStartOf="@+id/skeletonBaggageGroup2"
        app:layout_constraintTop_toTopOf="@+id/skeletonBaggageGroup2"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonPremiumBadge"
        android:layout_width="38dp"
        android:layout_height="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonBaggageGroup2"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonSmallButton"
        android:layout_width="81dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonPremiumBadge"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonPrice"
        android:layout_width="74dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonCrossedPrice"
        android:layout_width="54dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/skeletonPrice"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonDiscount"
        android:layout_width="27dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/skeletonCrossedPrice"/>
</merge>
