<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/TextStyle.Body.L"
            android:id="@+id/commonInputCheckboxTextTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/commonInputCheckboxView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/OzSwitch"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.M.Red"
        android:id="@+id/commonInputCheckboxErrorTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
</merge>
