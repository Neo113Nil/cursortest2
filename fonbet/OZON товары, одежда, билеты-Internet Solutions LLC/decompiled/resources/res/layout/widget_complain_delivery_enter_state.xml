<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/enterComplainStateContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:id="@+id/complainInputDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/enterComplainLayout"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        style="@style/OzTextInput.Layout">
        <com.google.android.material.textfield.TextInputEditText
            android:gravity="clip_vertical"
            android:id="@+id/complainInput"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="10"
            android:inputType="textMultiLine"
            android:isScrollContainer="true"
            android:overScrollMode="always"
            android:textAlignment="gravity"
            android:nestedScrollingEnabled="true"
            style="@style/OzTextInput.EditText"/>
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
