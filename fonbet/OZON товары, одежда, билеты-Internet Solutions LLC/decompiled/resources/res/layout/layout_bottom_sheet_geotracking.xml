<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/geolocationBtn"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_user_geolocation"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/topLine"/>
    <ImageView
        android:id="@+id/topLine"
        android:background="@drawable/bg_top_corners_bottom_line"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_express_top_line"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
