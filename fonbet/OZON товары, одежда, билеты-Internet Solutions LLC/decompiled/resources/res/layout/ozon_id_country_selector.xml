<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/country_selector_container"
    android:background="@drawable/bg_ozon_id_country_selector"
    android:layout_width="wrap_content"
    android:layout_height="56dp"
    android:minWidth="56dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/OzonTextAppearance.Body.500medium"
        android:id="@+id/codeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"/>
    <View
        android:id="@+id/icon"
        android:background="@drawable/ic_m_chevron_down"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/graphic_tertiary"/>
</androidx.appcompat.widget.LinearLayoutCompat>
