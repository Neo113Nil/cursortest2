<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/spay_cv_spasibo_root"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    style="@style/SpayCard.Style">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/spay_cl_selected_card"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/spay_iv_spasibo_logo"
            android:layout_width="@dimen/spay_card_icon_size"
            android:layout_height="@dimen/spay_card_icon_size"
            android:src="@drawable/spay_spasibo_bonuses_btn_logo"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <spay.sdk.view.SPayTextView
            android:id="@+id/spay_actv_spasibo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spay_cv_bnt_text_bottom_margin"
            android:text="@string/spay_spasibo_button_title"
            android:layout_marginStart="@dimen/spay_large_margin"
            app:layout_constraintBottom_toTopOf="@+id/spay_actv_spasibo_subtitle"
            app:layout_constraintStart_toEndOf="@+id/spay_iv_spasibo_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:spay_font="medium"
            style="@style/SpayCard.TitleTextStyle"/>
        <spay.sdk.view.SPayTextView
            android:id="@+id/spay_actv_spasibo_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spay_spasibo_off_button_subtitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/spay_actv_spasibo_title"
            app:layout_constraintTop_toBottomOf="@+id/spay_actv_spasibo_title"
            app:spay_font="medium"
            style="@style/Spay.Card.Content"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/spay_spasibo_switch"
            android:layout_width="@dimen/spay_40dp"
            android:layout_height="@dimen/spay_24dp"
            android:src="@drawable/spay_ic_switch_bnpl_off"
            app:layout_constraintBottom_toBottomOf="@+id/spay_actv_spasibo_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/spay_actv_spasibo_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
