<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/complexRouteDateBackgroundView"
        android:layout_width="94dp"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/complexRouteDateTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/complexRouteDayOfWeekTextView"
        app:layout_constraintEnd_toEndOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintStart_toStartOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintTop_toTopOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/complexRouteDayOfWeekTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintEnd_toEndOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintStart_toStartOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintTop_toBottomOf="@+id/complexRouteDateTextView"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/complexRouteDateErrorTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintStart_toStartOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintTop_toBottomOf="@+id/complexRouteDateBackgroundView"/>
    <View
        android:id="@+id/complexRouteLocationBackgroundView"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/complexRouteLocationFromClickAreaView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintEnd_toStartOf="@+id/complexRouteLocationIconView"
        app:layout_constraintStart_toStartOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintTop_toTopOf="@+id/complexRouteLocationBackgroundView"/>
    <View
        android:id="@+id/complexRouteLocationToClickAreaView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintEnd_toEndOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintStart_toEndOf="@+id/complexRouteLocationIconView"
        app:layout_constraintTop_toTopOf="@+id/complexRouteLocationBackgroundView"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/complexRouteLocationIconView"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintEnd_toEndOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintStart_toStartOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintTop_toTopOf="@+id/complexRouteLocationBackgroundView"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/complexRouteLocationFromCodeTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/complexRouteLocationFromCityTextView"
        app:layout_constraintEnd_toStartOf="@+id/complexRouteLocationIconView"
        app:layout_constraintStart_toStartOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintTop_toTopOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/complexRouteLocationFromCityTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintEnd_toStartOf="@+id/complexRouteLocationIconView"
        app:layout_constraintStart_toStartOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintTop_toBottomOf="@+id/complexRouteLocationFromCodeTextView"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/complexRouteLocationToCodeTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/complexRouteLocationToCityTextView"
        app:layout_constraintEnd_toEndOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintStart_toEndOf="@+id/complexRouteLocationIconView"
        app:layout_constraintTop_toTopOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/complexRouteLocationToCityTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintEnd_toEndOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintStart_toEndOf="@+id/complexRouteLocationIconView"
        app:layout_constraintTop_toBottomOf="@+id/complexRouteLocationToCodeTextView"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/complexRouteLocationErrorTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintStart_toStartOf="@+id/complexRouteLocationBackgroundView"
        app:layout_constraintTop_toBottomOf="@+id/complexRouteLocationBackgroundView"/>
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:id="@+id/complexRouteDeleteButton"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintStart_toEndOf="@+id/complexRouteDateBackgroundView"
        app:layout_constraintTop_toTopOf="@+id/complexRouteDateBackgroundView"/>
</merge>
