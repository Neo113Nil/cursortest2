<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/pbtTitle"
        android:layout_width="130dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rsvBackgroundTint="?attr/bgSecondary"
        app:rsvCornersRadius="6dp"/>
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/pbtAllButton"
        android:layout_width="42dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rsvBackgroundTint="?attr/bgSecondary"
        app:rsvCornersRadius="6dp"/>
    <View
        android:id="@+id/pbtView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pbtTitle"/>
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/pbtImage"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/pbtView"
        app:layout_constraintStart_toStartOf="@+id/pbtView"
        app:layout_constraintTop_toTopOf="@+id/pbtView"
        app:rsvBackgroundTint="?attr/layerOverlayParanja"
        app:rsvCornersRadius="8dp"/>
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/pbtPrice"
        android:layout_width="106dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/pbtDescription"
        app:layout_constraintStart_toEndOf="@+id/pbtImage"
        app:layout_constraintTop_toTopOf="@+id/pbtView"
        app:layout_constraintVertical_chainStyle="packed"
        app:rsvBackgroundTint="?attr/layerOverlayParanja"
        app:rsvCornersRadius="4dp"/>
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/pbtDescription"
        android:layout_width="152dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/pbtView"
        app:layout_constraintStart_toStartOf="@+id/pbtPrice"
        app:layout_constraintTop_toBottomOf="@+id/pbtPrice"
        app:rsvBackgroundTint="?attr/layerOverlayParanja"
        app:rsvCornersRadius="4dp"/>
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/pbtAddButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/pbtView"
        app:layout_constraintEnd_toEndOf="@+id/pbtView"
        app:layout_constraintTop_toTopOf="@+id/pbtView"
        app:rsvBackgroundTint="?attr/layerOverlayParanja"
        app:rsvCornersRadius="4dp"/>
</merge>
