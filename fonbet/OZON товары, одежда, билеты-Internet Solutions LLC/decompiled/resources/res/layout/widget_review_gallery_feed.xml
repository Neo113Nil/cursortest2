<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.image.Image
        android:id="@+id/reviewFeedImage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:aspectRatioImageAtom="ratio_3_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/reviewFeedIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginEnd="@dimen/dimen_8"
        app:layout_constraintEnd_toEndOf="@+id/reviewFeedImage"
        app:layout_constraintTop_toTopOf="@+id/reviewFeedImage"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/reviewFeedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_8"
        android:layout_marginEnd="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="@+id/reviewFeedImage"
        app:layout_constraintEnd_toEndOf="@+id/reviewFeedImage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
