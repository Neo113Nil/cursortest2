<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/suggestion_badge_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dimen_16">
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/suggestion_icon"
        android:layout_width="@dimen/dimen_44"
        android:layout_height="@dimen/dimen_44"
        android:src="@drawable/ic_m_express"
        android:layout_marginHorizontal="@dimen/dimen_12"
        android:layout_marginVertical="@dimen/dimen_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/OzonTextAppearance.Compact.500medium"
        android:ellipsize="end"
        android:id="@+id/suggestion_badge_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:maxLines="1"
        android:fontFamily="@font/onest_regular"
        android:layout_marginStart="@dimen/dimen_12"
        android:layout_marginEnd="@dimen/dimen_8"
        app:layout_constraintBottom_toTopOf="@+id/suggestion_badge_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/badgeView"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/suggestion_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="@dimen/dimen_16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/OzonTextAppearance.Body.400small"
        android:textColor="@color/text_secondary"
        android:ellipsize="end"
        android:id="@+id/suggestion_badge_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="20dp"
        android:maxLines="1"
        android:fontFamily="@font/onest_regular"
        android:layout_marginStart="@dimen/dimen_12"
        android:layout_marginEnd="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/badgeView"
        app:layout_constraintStart_toEndOf="@+id/suggestion_icon"
        app:layout_constraintTop_toBottomOf="@+id/suggestion_badge_title"
        app:layout_goneMarginEnd="@dimen/dimen_16"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/badgeView"
        android:background="@color/bg_fresh_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/suggestion_disclosure"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/suggestion_disclosure"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_m_chevron_right"
        android:layout_marginEnd="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/graphic_tertiary"/>
    <View
        android:id="@+id/suggestion_title_separator"
        android:background="@color/graphic_neutral"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/suggestion_badge_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
