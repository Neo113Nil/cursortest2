<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="60dp"
    android:layout_height="60dp">
    <ru.ozon.uni.android.atom.productMedia.ProductMediaView
        android:layout_gravity="start|bottom"
        android:id="@+id/attachmentPreview"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:layout_gravity="end|top"
        android:id="@+id/removePhotoBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/bgPrimaryInverted"/>
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:layout_gravity="center"
        android:id="@+id/cancelOrRefreshBtn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/attachmentPreview"
        app:layout_constraintEnd_toEndOf="@+id/attachmentPreview"
        app:layout_constraintStart_toStartOf="@+id/attachmentPreview"
        app:layout_constraintTop_toTopOf="@+id/attachmentPreview"
        app:tint="?attr/bgPrimaryInverted"/>
    <ru.ozon.uni.android.atom.loader.ui.LoaderView
        android:layout_gravity="center"
        android:id="@+id/loaderView"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:max="100"
        android:progress="25"
        android:indeterminate="false"
        android:backgroundTint="@color/bg_light_key"
        app:layout_constraintBottom_toBottomOf="@+id/attachmentPreview"
        app:layout_constraintEnd_toEndOf="@+id/attachmentPreview"
        app:layout_constraintStart_toStartOf="@+id/attachmentPreview"
        app:layout_constraintTop_toTopOf="@+id/attachmentPreview"/>
</androidx.constraintlayout.widget.ConstraintLayout>
