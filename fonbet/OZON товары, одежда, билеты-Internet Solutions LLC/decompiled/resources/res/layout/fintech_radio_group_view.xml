<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/oz_semantic_text_primary"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fintech_radio_group_margin_top_title"
        android:layout_marginHorizontal="@dimen/fintech_radio_group_margin_horizontal_title"
        app:layout_constraintBottom_toTopOf="@+id/frbv_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Head.M"/>
    <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
        android:id="@+id/frbv_light"
        android:background="@drawable/background_radio_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fintech_radio_group_margin_top_light"
        android:foreground="@drawable/fintech_ripple_rect_round_bluewave"
        android:layout_marginHorizontal="@dimen/radio_button_margin_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
        android:id="@+id/frbv_night"
        android:background="@drawable/background_radio_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fintech_radio_group_margin_top_night"
        android:foreground="@drawable/fintech_ripple_rect_round_bluewave"
        android:layout_marginHorizontal="@dimen/radio_button_margin_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frbv_light"/>
    <ru.ozon.fintech.ui.button.radio.FinRadioButtonView
        android:id="@+id/frbv_system"
        android:background="@drawable/background_radio_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fintech_radio_group_margin_top_system"
        android:foreground="@drawable/fintech_ripple_rect_round_bluewave"
        android:layout_marginHorizontal="@dimen/radio_button_margin_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frbv_night"/>
</merge>
