<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottomSheetPriceUp"
    android:background="@color/layer_floor_1"
    android:paddingBottom="@dimen/dimen_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="@string/ozon_bottom_sheet_behavior">
    <ru.ozon.uni.android.atom.image.Image
        android:layout_gravity="center"
        android:id="@+id/ivImage"
        android:layout_width="168dp"
        android:layout_height="168dp"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/titleTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/subtitleTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:layout_gravity="center"
        android:id="@+id/positiveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginHorizontal="@dimen/dimen_16"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:layout_gravity="center"
        android:id="@+id/negativeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginHorizontal="@dimen/dimen_16"/>
</LinearLayout>
