<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fileMessageRootCl"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Secondary"
        android:ellipsize="end"
        android:id="@+id/authorNameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/fileBackgroundCV"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="12dp"
        app:cardBackgroundColor="@color/bg_secondary"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:contentPadding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/authorNameTv"
        app:layout_goneMarginTop="4dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/m_ic_message_file"
            android:contentDescription="@null"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:textColor="@color/text_primary"
        android:id="@+id/fileNameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fileBackgroundCV"
        app:layout_constraintTop_toTopOf="@+id/fileBackgroundCV"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Secondary"
        android:textColor="@color/text_secondary"
        android:id="@+id/fileSizeTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sendTimeTv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fileBackgroundCV"
        app:layout_constraintTop_toBottomOf="@+id/fileNameTv"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption"
        android:textColor="@color/text_secondary"
        android:id="@+id/sendTimeTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/statusIv"
        app:layout_goneMarginEnd="12dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/statusIv"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_s_check"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/sendTimeTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sendTimeTv"
        app:tint="@color/text_secondary"/>
    <ProgressBar
        android:id="@+id/sendMessageLoaderPB"
        android:padding="4dp"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/m_send_message_loader"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/fileSizeTv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
