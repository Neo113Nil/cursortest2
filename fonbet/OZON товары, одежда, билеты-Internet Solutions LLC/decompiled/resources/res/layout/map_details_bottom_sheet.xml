<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/addressEditMapDetailsBottomSheetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="1dp">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/addressEditMapDetailsBottomSheetContainerContent"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/ozon_bottom_sheet_behavior">
            <View
                android:layout_gravity="top"
                android:background="@drawable/shadow_rounded_bottom_sheet"
                android:layout_width="match_parent"
                android:layout_height="18dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_bottom_sheet"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/checkout_sheet_top_shadow">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/titleContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <View
                        android:id="@+id/topPadding"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ru.ozon.uni.android.atom.text.TextAtomV2View
                        android:id="@+id/numberPVZ"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintEnd_toStartOf="@+id/actionDrawableIv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/topPadding"/>
                    <TextView
                        android:textAppearance="@style/TextStyle.Head.M"
                        android:ellipsize="end"
                        android:id="@+id/detailsSheetTitleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginStart="16dp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/badgesHAL"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/numberPVZ"
                        app:layout_constraintWidth_min="32dp"/>
                    <ru.ozon.app.android.atoms.af.layout.HorizontalAtomsLayout
                        android:id="@+id/badgesHAL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="4dp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="@+id/detailsSheetTitleTv"
                        app:layout_constraintEnd_toStartOf="@+id/actionDrawableIv"
                        app:layout_constraintStart_toEndOf="@+id/detailsSheetTitleTv"
                        app:layout_constraintTop_toTopOf="@+id/detailsSheetTitleTv"/>
                    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
                        android:id="@+id/actionDrawableIv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <FrameLayout
                    android:id="@+id/detailsFragmentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/detailsSheetLoadingFl"
                android:background="?attr/layerOverlayParanja"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/checkout_sheet_top_shadow"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ru.ozon.uni.android.atom.loader.ui.LoaderView
                    android:layout_gravity="top|center_horizontal"
                    android:id="@+id/progressSpinnerMpb"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:loaderSize="loader_500"/>
            </FrameLayout>
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <FrameLayout
        android:id="@+id/addressEditMapDetailsBottomSheetStickyContainer"
        android:background="?attr/layerFloor1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/addressEditMapDetailsBottomSheetStickyLinearContainer"
            android:background="?attr/layerFloor1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/addressEditMapDetailsBottomSheetStickyLoadingFl"
            android:background="?attr/layerOverlayParanja"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
