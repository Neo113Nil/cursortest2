<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.composer.ui.loader.snapshot.FullComposerSnapshotHolderCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/composerRootCl"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.ozon.composer.ui.view.refresh.ColoredSwipeRefreshLayout
        android:enabled="false"
        android:id="@+id/swipeRefreshLayout"
        android:fitsSystemWindows="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="0dp"
        app:layout_behavior="@string/composer_list_behavior">
        <ru.ozon.composer.ui.recycler.MetricsRecyclerView
            android:orientation="vertical"
            android:id="@+id/listRv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </ru.ozon.composer.ui.view.refresh.ColoredSwipeRefreshLayout>
    <ImageView
        android:id="@+id/snapshot"
        android:tag="@string/common_tag_require_reposition"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="matrix"
        android:adjustViewBounds="true"/>
    <FrameLayout
        android:id="@+id/stickyPlaceholder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        app:layout_behavior="@string/sticky_view_behavior"/>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:layout_behavior="@string/scrolling_view_behavior"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:layout_behavior="@string/bottom_border_behavior"/>
    <ImageView
        android:id="@+id/fullComposerSnapshot"
        android:tag="@string/common_tag_require_reposition"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="matrix"
        android:adjustViewBounds="true"/>
    <include
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/view_progressbar_bg"/>
    <ru.ozon.composer.ui.view.issue.PageIssueStateView
        android:id="@+id/screenStateView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/screen_state_behavior"/>
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarAbl"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingTl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:titleEnabled="false">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/expandedContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarTb"
                android:background="?attr/oz_semantic_bg_secondary"
                android:padding="0dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/composerToolbarHeightDefault"
                app:contentInsetLeft="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottomBorder"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/pageDebugInfoIv"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_8"
        android:src="@drawable/ic_m_info"
        app:tint="@color/oz_blue"/>
    <View
        android:id="@+id/statusBarBackground"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottomBarBackground"
        android:visibility="invisible"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
</ru.ozon.composer.ui.loader.snapshot.FullComposerSnapshotHolderCoordinatorLayout>
