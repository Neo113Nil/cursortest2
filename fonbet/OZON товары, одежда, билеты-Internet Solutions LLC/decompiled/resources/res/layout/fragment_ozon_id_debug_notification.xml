<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ozonIdDebugNotificationRoot"
        android:paddingTop="60dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/notificationDebugBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-16dp"
            app:layout_constraintBottom_toBottomOf="@+id/clearRootViewButton"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/notificationDebugBlockTitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Notification debug"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/notificationDebugBlock"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:gravity="top"
            android:id="@+id/notificationJsonEditText"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="100dp"
            android:inputType="textMultiLine"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/notificationDebugBlockTitleTextView"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/showNotificationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Show notification"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/notificationJsonEditText"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/setRootViewButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Set root view"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/showNotificationButton"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearRootViewButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear root view"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/setRootViewButton"
            style="@style/ButtonDebug"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/ozonIdDebugNotifierContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"/>
</FrameLayout>
