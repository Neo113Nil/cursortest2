<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.travel.utils.view.constraintLayoutWithBorder.ConstraintLayoutWithBorder xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="16dp"
    app:clwbBackgroundColor="?attr/layerFloor1"
    app:clwbCornerRadius="20dp">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/toursSearchResultGalleryRV"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="164dp"
        android:nestedScrollingEnabled="false"
        android:paddingHorizontal="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.tinkoff.scrollingpagerindicator.ScrollingPagerIndicator
        android:id="@+id/toursSearchResultDotsSPI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="7dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toursSearchResultGalleryRV"
        app:spi_dotColor="?attr/graphicTertiary"
        app:spi_dotSelectedColor="?attr/graphicPrimary"
        app:spi_dotSelectedSize="6dp"
        app:spi_dotSize="6dp"
        app:spi_dotSpacing="4dp"
        app:spi_visibleDotCount="5"/>
    <ru.ozon.uni.atoms.af.layout.HorizontalFlexAtomsLayout
        android:id="@+id/toursSearchResultBadgesHFAL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toursSearchResultDotsSPI"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/toursSearchResultTitleTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toursSearchResultBadgesHFAL"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/toursSearchResultDescriptionTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toursSearchResultTitleTAV"/>
    <ru.ozon.uni.atoms.af.layout.HorizontalFlexAtomsLayout
        android:id="@+id/toursSearchResultHotelFeaturesHFAL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toursSearchResultDescriptionTAV"/>
    <ru.ozon.app.android.travel.feature.tours.widgets.toursSearchResult.view.ToursSearchResultOptionsListView
        android:id="@+id/toursSearchResultVariantsTSRTVLV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toursSearchResultHotelFeaturesHFAL"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/toursSearchResultPriceTAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toursSearchResultVariantsTSRTVLV"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/toursSearchResultDatesTAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/toursSearchResultPriceTAV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/toursSearchResultPriceTAV"
        app:layout_constraintTop_toTopOf="@+id/toursSearchResultPriceTAV"/>
</ru.ozon.app.android.travel.utils.view.constraintLayoutWithBorder.ConstraintLayoutWithBorder>
