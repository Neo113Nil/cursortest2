<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/curtainGoalsIv"
        android:background="@drawable/bg_curtain_goals_parandja"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginHorizontal="@dimen/dimen_8"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/curtainGoalsSingleBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        app:layout_constraintStart_toStartOf="@+id/curtainGoalsTitle"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalsIv"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/curtainGoalsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalsSingleBadge"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/curtainGoalDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalsTitle"
        app:layout_goneMarginTop="0dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/curtainGoalsProgressBg"
        android:background="@drawable/bg_curtain_goals_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalDescription">
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/curtainGoalsProgressTa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            android:elevation="@dimen/dimen_1"
            app:layout_constraintEnd_toEndOf="@+id/curtainGoalsProgress"
            app:layout_constraintStart_toStartOf="@+id/curtainGoalsProgress"
            app:layout_constraintTop_toTopOf="@+id/curtainGoalsProgressBg"/>
        <ProgressBar
            android:id="@+id/curtainGoalsProgress"
            android:layout_width="0dp"
            android:layout_height="@dimen/dimen_4"
            android:layout_marginTop="@dimen/dimen_6"
            android:layout_marginBottom="@dimen/dimen_16"
            android:max="100"
            android:progressDrawable="@drawable/shape_curtain_goals_progress"
            android:layout_marginHorizontal="@dimen/dimen_16"
            app:layout_constraintBottom_toBottomOf="@+id/curtainGoalsProgressBg"
            app:layout_constraintEnd_toEndOf="@+id/curtainGoalsProgressBg"
            app:layout_constraintStart_toStartOf="@+id/curtainGoalsProgressBg"
            app:layout_constraintTop_toBottomOf="@+id/curtainGoalsProgressTa"
            style="?android:attr/progressBarStyleHorizontal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/curtainGoalsLargeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalsProgressBg"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/curtainGoalsTermButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12"
        android:layout_marginBottom="@dimen/dimen_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/curtainGoalsLargeButton"
        app:layout_constraintStart_toStartOf="@+id/curtainGoalsLargeButton"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalsLargeButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
