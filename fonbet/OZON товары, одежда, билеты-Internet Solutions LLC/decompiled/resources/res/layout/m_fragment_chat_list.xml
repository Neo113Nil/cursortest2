<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatListContent"
    android:background="?attr/layerFloor0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatListRootCl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:applyMotionScene="true"
        app:layoutDescription="@xml/m_collapsing_view">
        <androidx.constraintlayout.motion.widget.MotionLayout
            android:id="@+id/supportViewRoot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="-40dp"
            app:layoutDescription="@xml/m_collapsing_view"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerContainerLl">
            <ru.ozon.android.messenger.blocks.common.SquircleLinearLayout
                android:id="@+id/rootList"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="48dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:m_background_fill_color="?attr/layerFloor1"
                app:m_corner_top="true">
                <ru.ozon.android.messenger.framework.presentation.common.view.recycler.MessengerMetricsRecyclerView
                    android:orientation="vertical"
                    android:id="@+id/chatListRv"
                    android:background="@color/layer_floor_1"
                    android:paddingTop="32dp"
                    android:scrollbars="vertical"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="-24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/supportView"/>
            </ru.ozon.android.messenger.blocks.common.SquircleLinearLayout>
        </androidx.constraintlayout.motion.widget.MotionLayout>
        <ru.ozon.android.messenger.blocks.common.SquircleLinearLayout
            android:orientation="vertical"
            android:id="@+id/headerContainerLl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:m_corner_bottom="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/middleContainerLl"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomContainerLl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerContainerLl"
            app:m_corner_bottom="true"/>
        <ru.ozon.android.messenger.blocks.common.SquircleLinearLayout
            android:orientation="vertical"
            android:id="@+id/bottomContainerLl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <FrameLayout
            android:id="@+id/floatButtonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_32"
            android:layout_marginEnd="@dimen/dimen_16"
            app:layout_constraintBottom_toTopOf="@+id/bottomContainerLl"
            app:layout_constraintEnd_toEndOf="parent"/>
        <include
            android:id="@+id/progressBar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dimen_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerContainerLl"
            layout="@layout/m_view_progressbar_bg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
