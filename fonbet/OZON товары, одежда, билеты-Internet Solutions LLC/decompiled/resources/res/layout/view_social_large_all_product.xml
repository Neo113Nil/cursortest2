<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/socialLargeAllProducts"
    android:background="@drawable/ic_bg_product"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:textColor="@color/oz_semantic_text_primary_negative"
        android:layout_gravity="center"
        android:id="@+id/titleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="6dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption.Bold"
        android:textColor="@color/oz_semantic_text_primary_negative"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/countView"
        android:background="@drawable/ic_bg_product_count"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="14dp"/>
</LinearLayout>
