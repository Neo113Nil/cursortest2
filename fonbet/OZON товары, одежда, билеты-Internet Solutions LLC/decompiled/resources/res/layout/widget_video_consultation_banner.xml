<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="24dp"
        app:cardBackgroundColor="?attr/layerFloor1"
        app:cardCornerRadius="4dp"
        app:cardElevation="12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:textAppearance="@style/TextStyle.Body.L.Bold.Black"
                android:id="@+id/headerTAV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/productIv"
                android:layout_width="90dp"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:contentDescription="@null"
                app:layout_constraintStart_toStartOf="@+id/headerTAV"
                app:layout_constraintTop_toBottomOf="@+id/headerTAV"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:textAppearance="@style/TextStyle.Body.M.Gray40"
                android:id="@+id/bodyTAV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toTopOf="@+id/containerFl"
                app:layout_constraintEnd_toEndOf="@+id/headerTAV"
                app:layout_constraintStart_toEndOf="@+id/productIv"
                app:layout_constraintTop_toBottomOf="@+id/headerTAV"
                app:layout_constraintVertical_bias="0"/>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/containerFl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="84dp"
                android:layout_marginBottom="4dp"
                app:flexWrap="wrap"
                app:layout_constraintBottom_toTopOf="@+id/footerTAV"
                app:layout_constraintEnd_toEndOf="@+id/headerTAV"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toStartOf="@+id/bodyTAV"
                app:layout_constraintTop_toBottomOf="@+id/headerTAV"
                app:layout_goneMarginBottom="12dp">
                <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
                    android:id="@+id/mainActionBA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginEnd="12dp"
                    style="@style/SmallButton.Primary"/>
                <ru.ozon.uni.android.uikit.view.atoms.buttons.borderless.SmallBorderlessButtonView
                    android:id="@+id/secondaryActionBorderlessButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:height="32dp"
                    style="@style/SmallBorderlessButton"/>
            </com.google.android.flexbox.FlexboxLayout>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:textAppearance="@style/TextStyle.Body.M.Gray40"
                android:id="@+id/footerTAV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/headerTAV"
                app:layout_constraintStart_toStartOf="@+id/productIv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
