<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reviewSortsWidget"
    android:background="?attr/layerFloor1"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:maxLines="1"
        android:drawablePadding="12dp"
        android:paddingStart="16dp"
        android:layout_marginEnd="8dp"
        app:drawableStartCompat="@drawable/ic_m_sort"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/arrowIv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/arrowIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_s_disclosure"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/graphicNeutral"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/reviewSortsLayer"
        android:background="@drawable/bg_ripple_grey_rounded_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="titleTv, arrowIv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
