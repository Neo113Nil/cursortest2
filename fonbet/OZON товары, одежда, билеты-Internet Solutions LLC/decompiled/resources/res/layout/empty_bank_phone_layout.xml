<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/empty_bank_phone_container"
    android:background="@color/oz_semantic_bg_secondary"
    android:visibility="gone"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ic_close"
        android:background="@drawable/background_circle_bg_overlap"
        android:visibility="invisible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/ic_close_top_margin"
        android:src="@drawable/ic_s_cross_filled"
        android:scaleType="center"
        android:contentDescription="@string/pinpad_close_desc"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/graphic_tertiary"/>
    <ImageView
        android:id="@+id/iv_warning"
        android:layout_width="376dp"
        android:layout_height="368dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/empty_bank_phone"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="@color/oz_semantic_text_primary"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/pinpad_empty_bank_phone_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OzonTextAppearance.Headline.600large"/>
    <TextView
        android:textColor="@color/oz_semantic_text_secondary"
        android:gravity="center"
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/pinpad_empty_bank_phone_subtitle"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/continue_empty_bank_phone_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OzonTextAppearance.Body.500medium"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/continue_empty_bank_phone_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:size="size_600"
        app:titleText="@string/pinpad_empty_bank_phone_button_desc"
        style="@style/Button.ActionPrimary"/>
    <TextView
        android:textColor="@color/oz_semantic_text_secondary"
        android:gravity="center"
        android:id="@+id/tv_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/pinpad_empty_bank_phone_hint_desc"
        android:layout_marginHorizontal="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OzonTextAppearance.Body.400small"/>
</androidx.constraintlayout.widget.ConstraintLayout>
