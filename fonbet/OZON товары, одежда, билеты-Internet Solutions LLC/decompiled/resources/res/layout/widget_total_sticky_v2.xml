<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.android.composerCommonViewKit.islandSeparator.presentation.IslandSeparatorView
        android:id="@+id/islandSeparatorV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/totalStickyBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/totalStickyInfoBadge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/totalStickyBackground"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/totalStickyBackground"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spaceToTotalStickyPrice"
        app:layout_constraintVertical_bias="1"/>
    <Space
        android:id="@+id/spaceToTotalStickyPrice"
        android:layout_width="wrap_content"
        android:layout_height="8dp"
        app:layout_constraintBottom_toTopOf="@+id/totalStickyPrice"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/totalStickyPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/summaryInfoBarrier"
        app:layout_constraintEnd_toStartOf="@+id/totalStickyTextsBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/totalStickySecondPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/totalStickyPrice"
        app:layout_constraintEnd_toStartOf="@+id/totalStickyTextsBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/totalStickyPrice"
        app:layout_constraintTop_toTopOf="@+id/totalStickyPrice"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/summaryInfoBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="totalStickyInfoText, partnerBanksView"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/totalStickyInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomSpacer"
        app:layout_constraintEnd_toStartOf="@+id/totalStickyTextsBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TextStyle.Caption"/>
    <ru.ozon.app.android.partnerBanks.presentation.view.PartnerBanksView
        android:id="@+id/partnerBanksView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomSpacer"
        app:layout_constraintEnd_toStartOf="@+id/totalStickyTextsBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/fadeEndOfPartnerBanksView"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/partnerBanksView"
        app:layout_constraintEnd_toStartOf="@+id/totalStickyTextsBarrier"
        app:layout_constraintTop_toTopOf="@+id/partnerBanksView"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/totalStickyTextsBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:barrierMargin="-8dp"
        app:constraint_referenced_ids="totalStickyButton, totalStickyNewButton"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
        android:id="@+id/totalStickyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/totalStickyBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/totalStickyBackground"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/totalStickyNewButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/totalStickyBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/totalStickyBackground"/>
    <Space
        android:id="@+id/bottomSpacer"
        android:layout_width="wrap_content"
        android:layout_height="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ru.ozon.app.android.uikit.view.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerView"
        android:background="?attr/layerFloor1"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/totalStickyBackground"
        app:layout_constraintEnd_toEndOf="@+id/totalStickyBackground"
        app:layout_constraintStart_toStartOf="@+id/totalStickyBackground"
        app:layout_constraintTop_toTopOf="@+id/totalStickyBackground"
        app:shimmer_auto_start="false"
        app:shimmer_base_alpha="0.4"
        app:shimmer_duration="1000"
        app:shimmer_fixed_width="200dp"
        app:shimmer_highlight_alpha="0.9"
        app:shimmer_intensity="0.1"
        app:shimmer_repeat_delay="150"
        app:shimmer_repeat_mode="restart"
        app:shimmer_shape="linear"
        app:shimmer_tilt="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
