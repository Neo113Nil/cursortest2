<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.pdpvideomolecule.presentation.view.controlpanel.VideoMoleculeTimeBar
        android:layout_gravity="bottom"
        android:id="@+id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:bar_gravity="center"
        app:bar_height="2dp"
        app:buffered_color="@android:color/transparent"
        app:clip_to_outer_corners="true"
        app:outer_corner_radius="28dp"
        app:played_color="?attr/textLightKey"
        app:scrubbed_bar_height="4dp"
        app:scrubber_color="@color/transparent"
        app:scrubber_dragged_size="0dp"
        app:scrubber_enabled_size="0dp"
        app:touch_target_height="24dp"
        app:unplayed_color="?attr/clearLightKey600"/>
</merge>
