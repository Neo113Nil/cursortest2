<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/additionalServiceCard1RSV"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/additionalServiceCard2RSV"
        android:layout_width="218dp"
        android:layout_height="18dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/additionalServiceCard1RSV"
        app:layout_constraintTop_toTopOf="@+id/additionalServiceCard1RSV"
        app:rsvCornersRadius="4dp"/>
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/additionalServiceCard3RSV"
        android:layout_width="218dp"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/additionalServiceCard2RSV"
        app:layout_constraintTop_toBottomOf="@+id/additionalServiceCard2RSV"
        app:rsvCornersRadius="4dp"/>
    <View
        android:id="@+id/additionalServiceCardSeparatorV"
        android:background="?attr/graphicNeutral"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/additionalServiceCard3RSV"
        app:layout_constraintTop_toBottomOf="@+id/additionalServiceCard3RSV"/>
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/additionalServiceCard4RSV"
        android:layout_width="218dp"
        android:layout_height="18dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/additionalServiceCardSeparatorV"
        app:rsvCornersRadius="4dp"/>
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/additionalServiceCard5RSV"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/additionalServiceCard4RSV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/additionalServiceCard4RSV"
        app:rsvCornersRadius="4dp"/>
</merge>
