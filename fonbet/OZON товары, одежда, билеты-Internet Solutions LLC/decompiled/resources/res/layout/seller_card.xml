<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sellerCardContainer"
    android:background="@drawable/bg_white_ripple_blue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/logoFl"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="@dimen/default_margin"
        app:layout_constraintBottom_toTopOf="@+id/barrier"
        app:layout_constraintEnd_toStartOf="@+id/titleTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline3"
        app:layout_constraintVertical_bias="1">
        <ImageView
            android:layout_gravity="start|top"
            android:id="@+id/logoIv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
        <ru.ozon.uni.android.atom.icon.IconView
            android:layout_gravity="end|bottom"
            android:id="@+id/premiumIcon"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:ellipsize="end"
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTv"
        app:layout_constraintEnd_toStartOf="@+id/favoriteIv"
        app:layout_constraintStart_toEndOf="@+id/logoFl"
        app:layout_constraintTop_toTopOf="@+id/guideline3"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Black"
        android:ellipsize="end"
        android:id="@+id/subtitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/countTv"
        app:layout_constraintEnd_toStartOf="@+id/favoriteIv"
        app:layout_constraintStart_toEndOf="@+id/logoFl"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Gray60"
        android:ellipsize="end"
        android:id="@+id/countTv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/ratingBv"
        app:layout_constraintEnd_toStartOf="@+id/favoriteIv"
        app:layout_constraintStart_toEndOf="@+id/logoFl"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTv"/>
    <ru.ozon.app.android.uikit.view.atoms.ratingbadge.RatingBadgeView
        android:id="@+id/ratingBv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/barrier"
        app:layout_constraintEnd_toStartOf="@+id/favoriteIv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/logoFl"
        app:layout_constraintTop_toBottomOf="@+id/countTv"/>
    <ImageView
        android:id="@+id/favoriteIv"
        android:background="@drawable/bg_white_ripple_blue_round"
        android:padding="6dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_m_fav_tiles_normal"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/titleTv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="titleTv,subtitleTv,countTv,ratingBv"/>
    <ru.ozon.app.android.product.imagesswipeview.AdultImageView
        android:id="@+id/preview1Fiv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/preview2Fiv"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier"/>
    <ru.ozon.app.android.product.imagesswipeview.AdultImageView
        android:id="@+id/preview2Fiv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="2dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/preview3Fiv"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/preview1Fiv"
        app:layout_constraintTop_toBottomOf="@+id/barrier"/>
    <ru.ozon.app.android.product.imagesswipeview.AdultImageView
        android:id="@+id/preview3Fiv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/preview1Fiv"
        app:layout_constraintTop_toBottomOf="@+id/preview2Fiv"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption.Bold.White"
        android:gravity="center"
        android:id="@+id/price1Tv"
        android:background="@drawable/bg_seller_price"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:lines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview1Fiv"
        app:layout_constraintStart_toStartOf="@+id/preview1Fiv"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption.Bold.White"
        android:gravity="center"
        android:id="@+id/price2Tv"
        android:background="@drawable/bg_seller_price"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:lines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview2Fiv"
        app:layout_constraintStart_toStartOf="@+id/preview2Fiv"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption.Bold.White"
        android:gravity="center"
        android:id="@+id/price3Tv"
        android:background="@drawable/bg_seller_price"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:lines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview3Fiv"
        app:layout_constraintStart_toStartOf="@+id/preview3Fiv"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/default_margin"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
