<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCl"
    android:background="?attr/oz_semantic_bg_secondary"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/fg_sku_ripple"
    android:paddingStart="16dp">
    <ru.ozon.app.android.universalwidgets.widgets.uw.sku.SkuImageWrapper
        android:id="@+id/adultIv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintWidth_percent="0.4"/>
    <ImageView
        android:id="@+id/overlayImage"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="center"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintWidth_percent="0.4"/>
    <ru.ozon.app.android.product.common.overlaytitle.OverlayTitleView
        android:id="@+id/overlayTitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/adultIv"
        app:layout_constraintEnd_toEndOf="@+id/adultIv"
        app:layout_constraintStart_toStartOf="@+id/adultIv"/>
    <ru.ozon.app.android.product.common.wave.WaveView
        android:id="@+id/waveView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/adultIv"
        app:layout_constraintEnd_toEndOf="@+id/adultIv"
        app:layout_constraintStart_toStartOf="@+id/adultIv"/>
    <ru.ozon.app.android.universalwidgets.widgets.uw.badgescontainer.BadgesContainerView
        android:id="@+id/badgesContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/adultIv"
        app:layout_constraintLeft_toLeftOf="@+id/adultIv"
        app:layout_constraintRight_toRightOf="@+id/adultIv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/stateVal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toStartOf="@+id/topRightButtonsRV"
        app:layout_constraintStart_toEndOf="@+id/adultIv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"/>
    <View
        android:id="@+id/stateView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/stateVal"
        app:layout_constraintEnd_toEndOf="@+id/stateVal"
        app:layout_constraintStart_toStartOf="@+id/stateVal"
        app:layout_constraintTop_toTopOf="@+id/stateVal"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/topRightButtonsRV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/productSaContainer"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toStartOf="@+id/topRightButtonsRV"
        app:layout_constraintStart_toEndOf="@+id/adultIv"
        app:layout_constraintTop_toBottomOf="@+id/stateVal"
        app:layout_constraintVertical_bias="0">
        <ru.ozon.uni.atoms.v3.containers.SingleAtom
            android:id="@+id/productSa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <ru.ozon.app.android.uikit.view.atoms.texts.TextAtomWithIconView
        android:id="@+id/buttonSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/adultIv"
        app:layout_constraintTop_toBottomOf="@+id/productSaContainer"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:barrierMargin="8dp"
        app:constraint_referenced_ids="adultIv,productSaContainer,stateVal,buttonSubtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
