<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/socialLargeProduct"
    android:background="@drawable/ic_bg_product"
    android:layout_width="wrap_content"
    android:layout_height="52dp"
    android:paddingEnd="10dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:textColor="@color/oz_semantic_text_primary_negative"
        android:id="@+id/priceView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/imageView"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.appearance.text.StrikethroughTextView
        android:textAppearance="@style/TextStyle.Caption"
        android:textColor="@color/oz_semantic_text_primary_negative"
        android:id="@+id/priceOriginalView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/priceView"
        app:layout_constraintStart_toEndOf="@+id/priceView"/>
    <ru.ozon.app.android.storefront.core.socialAtoms.badge.SocialBadgeAtomView
        android:id="@+id/socialBadgeAtomView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/priceOriginalView"
        app:layout_constraintStart_toEndOf="@+id/priceOriginalView"
        app:layout_constraintTop_toTopOf="@+id/priceOriginalView"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iconView"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:tint="?attr/oz_semantic_text_primary_negative"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/priceOriginalView"
        app:layout_constraintStart_toEndOf="@+id/priceOriginalView"
        app:layout_constraintTop_toTopOf="@+id/priceOriginalView"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption"
        android:textColor="@color/oz_semantic_text_primary_negative"
        android:ellipsize="end"
        android:id="@+id/descriptionView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView"
        app:layout_constraintTop_toBottomOf="@+id/priceView"/>
</merge>
