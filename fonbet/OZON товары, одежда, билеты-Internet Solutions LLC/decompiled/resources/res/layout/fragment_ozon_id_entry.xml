<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/contentContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/logoImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_ozon_id_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/titleTextAtomV2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoImageView"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/subtitleTextAtomV2"
        android:nextFocusUp="@+id/closeFlowButton"
        android:nextFocusDown="@+id/credentialsTextField"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextAtomV2"/>
    <include
        android:id="@+id/countrySelector"
        android:visibility="gone"
        android:nextFocusRight="@+id/credentialsTextField"
        android:nextFocusUp="@+id/subtitleTextAtomV2"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/credentialsTextField"
        layout="@layout/ozon_id_country_selector"/>
    <ru.ozon.uni.android.cell.text.TextFieldCellView
        android:id="@+id/credentialsTextField"
        android:nextFocusLeft="@+id/countrySelector"
        android:nextFocusUp="@+id/subtitleTextAtomV2"
        android:nextFocusDown="@+id/errorButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/countrySelector"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTextAtomV2"
        app:layout_goneMarginStart="16dp"
        app:textFieldAddonTextAppearance="@style/OzonTextAppearance.Body.300xsmall"/>
    <TextView
        android:textAppearance="@style/OzonTextAppearance.Body.300xsmall"
        android:textColor="@color/link_text_color"
        android:id="@+id/errorButton"
        android:visibility="gone"
        android:nextFocusUp="@+id/inputEditText"
        android:nextFocusDown="@+id/submitButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/credentialsTextField"
        app:layout_constraintStart_toStartOf="@+id/credentialsTextField"
        app:layout_constraintTop_toBottomOf="@+id/credentialsTextField"/>
    <ru.ozon.uni.android.controls.button.ButtonView
        android:id="@+id/submitButton"
        android:nextFocusUp="@+id/errorButton"
        android:nextFocusDown="@+id/termsOfUseTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        app:buttonsSize="size_600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorButton"
        app:layout_goneMarginTop="16dp"
        style="@style/Button.ActionPrimary"/>
    <ru.ozon.id.nativeauth.credentials.views.BadgeOr
        android:gravity="center_horizontal"
        android:id="@+id/titleSocialButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/submitButton"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/containerSocialButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleSocialButtons"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/termsOfUseTextView"
        android:nextFocusUp="@+id/submitButton"
        android:nextFocusDown="@+id/disclaimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/containerSocialButtons"/>
    <include
        android:id="@+id/disclaimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/termsOfUseTextView"
        layout="@layout/ozon_id_disclaimer"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/hintButtonsLinearLayout"
        android:nextFocusUp="@+id/disclaimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disclaimer"
        app:layout_constraintVertical_bias="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
