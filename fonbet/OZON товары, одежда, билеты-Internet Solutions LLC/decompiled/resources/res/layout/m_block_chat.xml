<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blockChatRootCl"
        android:background="@drawable/m_bg_chat_ripple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/m_padding_medium"
        android:paddingVertical="@dimen/m_padding_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.Group
            android:id="@+id/sxExtendedInfoGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="conversationIdTv, statusBadgesContainer"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/statusBadgesContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextStyle.Caption.Bold"
            android:textColor="?attr/textSecondary"
            android:id="@+id/conversationIdTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/statusBadgesContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/statusBadgesContainer"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierChatTitleTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierAllowsGoneWidgets="false"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="statusBadgesContainer, conversationIdTv"/>
        <ru.ozon.uni.android.atom.icon.IconView
            android:id="@+id/avatarIv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:textAppearance="@style/TextStyle.Body.L.Bold"
            android:textColor="?attr/textPrimary"
            android:ellipsize="end"
            android:id="@+id/chatTitleTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            app:layout_constraintEnd_toStartOf="@+id/chatIconsLayout"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_weight="3"
            app:layout_constraintStart_toEndOf="@+id/avatarIv"
            app:layout_constraintTop_toBottomOf="@+id/barrierChatTitleTop"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_default="wrap"
            app:layout_goneMarginStart="0dp"
            app:layout_goneMarginTop="0dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/chatIconsLayout"
            android:paddingBottom="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/chatTitleTv"
            app:layout_constraintEnd_toStartOf="@+id/statusIv"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/chatTitleTv"
            app:layout_constraintTop_toTopOf="@+id/chatTitleTv"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_default="wrap"/>
        <FrameLayout
            android:id="@+id/previewContainerFl"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/chatUnreadCountIndicator"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/avatarIv"
            app:layout_constraintTop_toBottomOf="@+id/chatTitleTv"
            app:layout_goneMarginEnd="@dimen/m_margin_medium"
            app:layout_goneMarginStart="0dp">
            <TextView
                android:textAppearance="@style/TextStyle.Body.L.Secondary"
                android:textColor="?attr/textSecondary"
                android:ellipsize="end"
                android:id="@+id/chatPreviewTextTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
        </FrameLayout>
        <TextView
            android:textAppearance="@style/TextStyle.Body.M.Secondary"
            android:textColor="?attr/textSecondary"
            android:id="@+id/chatPreviewDateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/chatTitleTv"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/statusIv"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_s_check"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/chatPreviewDateTv"
            app:layout_constraintTop_toTopOf="@+id/chatPreviewDateTv"
            app:tint="?attr/textSecondary"/>
        <ru.ozon.uni.android.atom.indicator.ui.IndicatorView
            android:id="@+id/chatUnreadCountIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/menuItemsRv"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:minHeight="46dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
