<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <FrameLayout
        android:background="?attr/layerFloor1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentFl"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/productIv"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@null"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toTopOf="@+id/headerB"
                app:layout_constraintEnd_toStartOf="@+id/productTav"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:id="@+id/productTav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/headerB"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/productIv"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="16dp"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/headerB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="productIv,productTav"/>
            <View
                android:id="@+id/separatorV"
                android:background="?attr/graphicNeutral"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/headerB"/>
            <ImageView
                android:id="@+id/secondHeaderProductIv"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@null"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toTopOf="@+id/secondHeaderB"
                app:layout_constraintEnd_toStartOf="@+id/secondHeaderProductTav"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/separatorV"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:id="@+id/secondHeaderProductTav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/secondHeaderB"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/secondHeaderProductIv"
                app:layout_constraintTop_toTopOf="@+id/separatorV"
                app:layout_goneMarginStart="16dp"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/secondHeaderB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="secondHeaderProductIv,secondHeaderProductTav"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/secondHeaderGroup"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="secondHeaderB,secondHeaderProductIv,secondHeaderProductTav,separatorV"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputMtil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:boxStrokeWidth="@dimen/dimen_0"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/anonymousSa"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/secondHeaderB"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/OzTextInput.Layout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    style="@style/OzTextInput.EditText"/>
            </com.google.android.material.textfield.TextInputLayout>
            <ru.ozon.uni.atoms.v3.containers.SingleAtom
                android:id="@+id/anonymousSa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toTopOf="@+id/policyRulesSa"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/inputMtil"/>
            <ru.ozon.uni.atoms.v3.containers.SingleAtom
                android:id="@+id/policyRulesSa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/submitSa"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ru.ozon.uni.atoms.v3.containers.SingleAtom
                android:id="@+id/submitSa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.core.widget.ContentLoadingProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressPb"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            style="?android:attr/progressBarStyleInverse"/>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
