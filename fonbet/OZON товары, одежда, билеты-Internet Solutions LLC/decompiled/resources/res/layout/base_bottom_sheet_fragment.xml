<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/base_bottom_sheet_top"
    android:background="@drawable/background_top_rounded_corner"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="center"
        android:id="@+id/base_bottom_sheet_dragger"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:foreground="@drawable/bottom_sheet_drag_icon"
        android:foregroundGravity="center"/>
    <FrameLayout
        android:id="@+id/base_bottom_sheet_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="74dp"/>
    <FrameLayout
        android:id="@+id/base_bottom_sheet_main_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:id="@+id/base_bottom_sheet_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
