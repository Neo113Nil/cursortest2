<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <TextView
        android:textAppearance="@style/LiveActivityText.Title.Collapsed"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_toStartOf="@+id/progress_bg"
        android:layout_alignParentStart="true"/>
    <Chronometer
        android:textColor="@color/text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lines="1"
        android:includeFontPadding="false"
        android:layout_below="@+id/title"
        android:layout_marginEnd="6dp"
        android:layout_toStartOf="@+id/progress_bg"
        android:layout_alignParentStart="true"
        android:letterSpacing="0.025"/>
    <ImageView
        android:id="@+id/progress_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_alignStart="@+id/progress_bg"
        android:layout_alignEnd="@+id/progress_bg"
        android:elevation="2dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/target_progress_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/progress_bg"
        android:layout_alignBottom="@+id/progress_bg"
        android:layout_alignStart="@+id/progress_bg"
        android:layout_alignParentEnd="true">
        <TextView
            android:textAppearance="@style/LiveActivityText.Target.Title.Collapsed"
            android:gravity="center_horizontal"
            android:id="@+id/target_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/LiveActivityText.Target.Subtitle.Collapsed"
            android:gravity="center_horizontal"
            android:id="@+id/target_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/estimated_progress_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/progress_bg"
        android:layout_alignBottom="@+id/progress_bg"
        android:layout_alignStart="@+id/progress_bg"
        android:layout_alignParentEnd="true">
        <TextView
            android:textAppearance="@style/LiveActivityText.Estimated.Title.Collapsed"
            android:layout_gravity="center"
            android:id="@+id/estimated_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textAppearance="@style/LiveActivityText.Estimated.Subtitle.Collapsed"
            android:layout_gravity="center"
            android:id="@+id/estimated_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/progress_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_progress"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/progress_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/progress_bg"
        android:layout_alignParentTop="true"
        android:layout_alignStart="@+id/progress_bg"
        android:layout_alignParentEnd="true"
        android:elevation="1dp"/>
</RelativeLayout>
