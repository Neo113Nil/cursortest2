<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/messageItemRootLl"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.icon.IconView
        android:layout_gravity="end|bottom"
        android:id="@+id/avatarIv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"/>
    <ru.ozon.android.messenger.blocks.common.HighlightLinearLayout
        android:orientation="vertical"
        android:id="@+id/bubbleContainerLl"
        android:background="@drawable/m_bg_other_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        app:divider="@drawable/m_multiple_blocks_divider"
        app:showDividers="middle"/>
</androidx.appcompat.widget.LinearLayoutCompat>
