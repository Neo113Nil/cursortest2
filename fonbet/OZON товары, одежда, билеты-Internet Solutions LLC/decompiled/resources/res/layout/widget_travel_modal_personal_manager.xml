<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/modalPersonalManagerBackgroundView"
        android:background="@drawable/bg_rounded_primary_16"
        android:layout_width="0dp"
        android:layout_height="156dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/modalPersonalManagerLogoIV"
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/modalPersonalManagerBackgroundView"
        app:layout_constraintEnd_toEndOf="@+id/modalPersonalManagerBackgroundView"
        app:layout_constraintStart_toStartOf="@+id/modalPersonalManagerBackgroundView"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/modalPersonalManagerTitleTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/modalPersonalManagerBackgroundView"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/modalPersonalManagerContentListRV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/modalPersonalManagerTitleTAV"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/modalPersonalManagerNotificationTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/modalPersonalManagerContentListRV"/>
    <ru.ozon.uni.atoms.af.layout.VerticalAtomsLayout
        android:id="@+id/modalPersonalManagerButtonsVAL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/modalPersonalManagerNotificationTAV"/>
</androidx.constraintlayout.widget.ConstraintLayout>
