<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/background"
        android:layout_width="0dp"
        android:layout_height="199dp"
        android:backgroundTint="?attr/oz_semantic_ctrl_neutral_pale"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/backgroundImage"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/background"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background"
        app:shapeAppearance="@style/Rounded16Style"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/infoBlock"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="?attr/oz_semantic_bg_secondary"
        android:layout_marginHorizontal="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/goToCartButton"
        app:layout_constraintStart_toStartOf="@+id/infoBlock"
        app:layout_constraintTop_toTopOf="@+id/infoBlock"
        style="@style/TextStyle.Head.M"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/priceContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/infoBlock"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <ru.ozon.app.android.uikit.view.atoms.priceWithTitle.PriceWithTitleView
            android:id="@+id/priceWithTitleView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ru.ozon.uni.android.atom.badge.BadgeView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <ru.ozon.uni.android.controls.button.IconButtonView
        android:id="@+id/goToCartButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_m_check"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/infoBlock"
        app:layout_constraintEnd_toEndOf="@+id/infoBlock"
        app:layout_constraintTop_toTopOf="@+id/infoBlock"/>
    <ru.ozon.uni.android.controls.button.IconButtonView
        android:id="@+id/addToCartButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/infoBlock"
        app:layout_constraintEnd_toEndOf="@+id/infoBlock"
        app:layout_constraintTop_toTopOf="@+id/infoBlock"/>
    <ImageView
        android:id="@+id/info"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/ic_s_info_filled"
        android:layout_marginEnd="6dp"
        android:elevation="0.6dp"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background"
        app:tint="?attr/oz_semantic_separator"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="101dp"
        android:layout_marginHorizontal="38dp"
        android:layout_marginVertical="14dp"
        app:layout_constraintBottom_toTopOf="@+id/infoBlock"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/product1"
            android:background="@color/oz_white_1"
            android:visibility="visible"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:foreground="@drawable/bg_bundle_parandja"
            android:translationZ="0.4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"
            app:shapeAppearance="@style/Rounded16Style"
            app:srcCompat="@drawable/ic_m_cart"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/product2"
            android:background="@color/oz_white_1"
            android:visibility="visible"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_marginBottom="16dp"
            android:foreground="@drawable/bg_bundle_parandja"
            android:layout_marginStart="60dp"
            android:translationZ="0.3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/product1"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/Rounded16Style"
            app:srcCompat="@drawable/ic_m_cart"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/product3"
            android:background="@color/oz_white_1"
            android:visibility="visible"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:foreground="@drawable/bg_bundle_parandja"
            android:layout_marginStart="60dp"
            android:translationZ="0.2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/product2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"
            app:shapeAppearance="@style/Rounded16Style"
            app:srcCompat="@drawable/ic_m_cart"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/product4"
            android:background="@color/oz_white_1"
            android:visibility="visible"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_marginBottom="16dp"
            android:foreground="@drawable/bg_bundle_parandja"
            android:layout_marginStart="60dp"
            android:translationZ="0.1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/product3"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/Rounded16Style"
            app:srcCompat="@drawable/ic_m_cart"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
