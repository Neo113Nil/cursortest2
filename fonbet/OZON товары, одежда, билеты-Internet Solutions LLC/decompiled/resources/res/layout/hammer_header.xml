<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/headerContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/snackbarContainer"
        android:background="@drawable/snack_bar_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingVertical="10dp">
        <ImageView
            android:id="@+id/snackbarIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iconBarrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/iconBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="snackbarIcon"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/snackbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toTopOf="@+id/snackbarSubtitle"
            app:layout_constraintEnd_toStartOf="@+id/snackbarBarrier"
            app:layout_constraintStart_toEndOf="@+id/iconBarrier"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/snackbarSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/snackbarBarrier"
            app:layout_constraintStart_toEndOf="@+id/iconBarrier"
            app:layout_constraintTop_toBottomOf="@+id/snackbarTitle"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ru.ozon.app.android.atoms.v3.holders.switchingButton.SwitchingButtonView
            android:id="@+id/snackbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/snackbarBarrier"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="128dp"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/snackbarBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:barrierDirection="start"
            app:constraint_referenced_ids="snackbarButton"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
