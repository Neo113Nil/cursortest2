<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fin_qr_root"
    android:paddingTop="32dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <ImageView
        android:id="@+id/fin_qr_image_view"
        android:background="@drawable/background_rounded_semantic_bg_secondary_16"
        android:padding="12dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="@color/oz_semantic_text_secondary"
        android:gravity="center"
        android:id="@+id/fin_qr_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/fin_qr_image_view"
        style="@style/TextStyle.Body.L"/>
</androidx.constraintlayout.widget.ConstraintLayout>
