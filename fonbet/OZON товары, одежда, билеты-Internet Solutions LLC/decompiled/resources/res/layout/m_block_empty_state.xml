<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blockEmptyStateFl"
    android:background="?attr/layerFloor1"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/headerView"
        layout="@layout/m_chat_list_header_text"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/blockEmptyStateLl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/emptyStateIv"
            android:layout_width="144dp"
            android:layout_height="144dp"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/emptyStateTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="16dp"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:gravity="center"
            android:id="@+id/emptyStateDescriptionTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/m_margin_small"
            android:layout_marginHorizontal="44dp"/>
    </LinearLayout>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.LargeButtonView
        android:layout_gravity="bottom"
        android:id="@+id/emptyStateBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"
        style="@style/LargeButton.Primary"/>
</FrameLayout>
