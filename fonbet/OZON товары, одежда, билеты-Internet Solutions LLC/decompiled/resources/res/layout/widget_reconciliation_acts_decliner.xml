<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dimen_16">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <include
        android:id="@+id/clickableAreaAttachFile"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_56"
        layout="@layout/select_file_layout"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/textFieldsRV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/policy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/submitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
