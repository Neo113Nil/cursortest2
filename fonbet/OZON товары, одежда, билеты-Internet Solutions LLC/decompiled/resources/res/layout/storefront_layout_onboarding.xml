<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFl"
    android:background="@color/layer_overlay_dimming"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.storefront.domain.onboarding.presentation.dialog.OnboardingBannerView
        android:id="@+id/bannerObv"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"/>
    <ImageView
        android:id="@+id/triangleIv"
        android:visibility="invisible"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_rounded_triangle_onboarding"/>
    <ImageView
        android:id="@+id/cutDetailIv"
        android:focusable="true"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
