<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clickableAreaAttachFile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:id="@+id/attachFileButton"
        android:layout_width="@dimen/dimen_56"
        android:layout_height="@dimen/dimen_56"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.loader.ui.LoaderView
        android:id="@+id/loaderView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="@+id/attachFileButton"
        app:layout_constraintEnd_toEndOf="@+id/attachFileButton"
        app:layout_constraintStart_toStartOf="@+id/attachFileButton"
        app:layout_constraintTop_toTopOf="@+id/attachFileButton"
        app:loaderSize="loader_400"/>
    <TextView
        android:textColor="?attr/textPrimary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dimen_12"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/attachFileButton"
        app:layout_constraintTop_toTopOf="@+id/attachFileButton"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/OzonTextAppearance.Compact.500medium"/>
    <TextView
        android:textColor="@color/text_tertiary"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:layout_marginStart="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="@+id/attachFileButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/attachFileButton"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/OzonTextAppearance.Compact.300xsmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
