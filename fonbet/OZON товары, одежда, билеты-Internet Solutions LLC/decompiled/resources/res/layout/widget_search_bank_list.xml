<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:imeOptions="actionSearch"
        android:overScrollMode="always"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        app:iconifiedByDefault="false"
        app:layout="@layout/suggestions_search_view_layout"
        app:layout_constraintEnd_toStartOf="@+id/closeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:queryBackground="@null"
        app:searchIcon="@drawable/ic_s_search"
        app:theme="@style/AppSearchViewNew"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/closeButton"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="12dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_m_cross"
        app:tint="@android:color/black"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/searchBarBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="searchView, closeButton"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="?attr/textSecondary"
        android:id="@+id/sectionHeaderTextAtomView"
        android:background="?attr/layerFloor0"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchBarBarrier"
        style="@style/TextStyle.Caption.AC"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="?attr/textSecondary"
        android:id="@+id/emptyListPlaceholderTextAtomView"
        android:background="@android:color/transparent"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchBarBarrier"
        style="@style/TextStyle.Body.L"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="emptyListPlaceholderTextAtomView, sectionHeaderTextAtomView"/>
    <ru.ozon.app.android.atoms.v3.containers.VerticalRecyclerContainer
        android:id="@+id/banksVerticalRecyclerContainer"
        android:background="?attr/layerFloor1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBarrier"/>
    <FrameLayout
        android:id="@+id/layoutBackgroundProgressBar"
        android:background="?attr/layerOverlayParanja"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <me.zhanghai.android.materialprogressbar.MaterialProgressBar
            android:layout_gravity="center"
            style="@style/ProgressBarStyle"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
