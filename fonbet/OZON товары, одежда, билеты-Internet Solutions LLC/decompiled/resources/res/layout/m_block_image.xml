<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:id="@+id/blockImageRootFl"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_gravity="center"
        android:id="@+id/mainImageIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/m_image_max_height"/>
    <ru.ozon.android.messenger.framework.presentation.common.view.timestatus.TimeStatusView
        android:layout_gravity="end|bottom"
        android:id="@+id/timeStatusView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_6"
        android:layout_marginEnd="@dimen/dimen_6"/>
</FrameLayout>
