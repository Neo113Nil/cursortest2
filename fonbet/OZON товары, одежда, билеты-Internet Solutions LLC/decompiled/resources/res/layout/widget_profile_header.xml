<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileHeader"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/profileIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/leftCountBlockNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintBottom_toTopOf="@+id/leftCountBlockTitle"
        app:layout_constraintEnd_toStartOf="@+id/middleCountBlockNumber"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/profileIcon"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/leftCountBlockTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintBottom_toTopOf="@+id/subscribeButton"
        app:layout_constraintEnd_toStartOf="@+id/middleCountBlockTitle"
        app:layout_constraintStart_toEndOf="@+id/profileIcon"
        app:layout_constraintTop_toBottomOf="@+id/leftCountBlockNumber"/>
    <View
        android:id="@+id/leftClickArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/leftCountBlockTitle"
        app:layout_constraintEnd_toEndOf="@+id/leftCountBlockNumber"
        app:layout_constraintStart_toStartOf="@+id/leftCountBlockNumber"
        app:layout_constraintTop_toTopOf="@+id/leftCountBlockNumber"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/middleCountBlockNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="@+id/leftCountBlockNumber"
        app:layout_constraintEnd_toStartOf="@+id/rightCountBlockNumber"
        app:layout_constraintStart_toEndOf="@+id/leftCountBlockNumber"
        app:layout_constraintTop_toTopOf="@+id/leftCountBlockNumber"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/middleCountBlockTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="@+id/leftCountBlockTitle"
        app:layout_constraintEnd_toStartOf="@+id/rightCountBlockTitle"
        app:layout_constraintStart_toEndOf="@+id/leftCountBlockTitle"
        app:layout_constraintTop_toTopOf="@+id/leftCountBlockTitle"/>
    <View
        android:id="@+id/middleClickArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/middleCountBlockTitle"
        app:layout_constraintEnd_toEndOf="@+id/middleCountBlockNumber"
        app:layout_constraintStart_toStartOf="@+id/middleCountBlockNumber"
        app:layout_constraintTop_toTopOf="@+id/middleCountBlockNumber"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/rightCountBlockNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="@+id/leftCountBlockNumber"
        app:layout_constraintEnd_toStartOf="@+id/endGuideline"
        app:layout_constraintStart_toEndOf="@+id/middleCountBlockNumber"
        app:layout_constraintTop_toTopOf="@+id/leftCountBlockNumber"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/rightCountBlockTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="@+id/leftCountBlockTitle"
        app:layout_constraintEnd_toStartOf="@+id/endGuideline"
        app:layout_constraintStart_toEndOf="@+id/middleCountBlockTitle"
        app:layout_constraintTop_toTopOf="@+id/leftCountBlockTitle"/>
    <View
        android:id="@+id/rightClickArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/rightCountBlockTitle"
        app:layout_constraintEnd_toEndOf="@+id/rightCountBlockNumber"
        app:layout_constraintStart_toStartOf="@+id/rightCountBlockNumber"
        app:layout_constraintTop_toTopOf="@+id/rightCountBlockNumber"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/subscribeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/shareBtn"
        app:layout_constraintStart_toEndOf="@+id/profileIcon"
        app:layout_constraintTop_toBottomOf="@+id/leftCountBlockTitle"/>
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:id="@+id/shareBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="@+id/subscribeButton"
        app:layout_constraintEnd_toStartOf="@+id/settingsBtn"
        app:layout_constraintStart_toEndOf="@+id/subscribeButton"
        app:layout_constraintTop_toTopOf="@+id/subscribeButton"/>
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:id="@+id/settingsBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="@+id/subscribeButton"
        app:layout_constraintEnd_toStartOf="@+id/endGuideline"
        app:layout_constraintStart_toEndOf="@+id/shareBtn"
        app:layout_constraintTop_toTopOf="@+id/subscribeButton"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/endGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/dimen_16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
