<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCl"
    android:layout_width="96dp"
    android:layout_height="128dp">
    <View
        android:id="@+id/backgroundV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/iconBg"
        android:background="@drawable/circle_gray"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="@+id/backgroundV"
        app:layout_constraintTop_toTopOf="@+id/backgroundV"/>
    <ImageView
        android:id="@+id/iconIv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iconBg"
        app:layout_constraintEnd_toEndOf="@+id/iconBg"
        app:layout_constraintStart_toStartOf="@+id/iconBg"
        app:layout_constraintTop_toTopOf="@+id/iconBg"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:textAppearance="@style/TextStyle.Caption"
        android:ellipsize="end"
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:ellipsize="end"
        android:id="@+id/subtitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/actionFl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="12dp"/>
    <FrameLayout
        android:id="@+id/actionFl"
        android:background="@drawable/finance_action_rounded_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ru.ozon.uni.atoms.v3.containers.SingleAtom
            android:textAppearance="@style/TextStyle.Caption.AC.White"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/actionSAL"
            android:background="@drawable/finance_action_rounded_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAllCaps="true"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
