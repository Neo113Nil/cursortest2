<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp">
    <ImageView
        android:id="@+id/productIv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="1dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/soldBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rotation="340"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/productIv"
        app:layout_constraintEnd_toEndOf="@+id/productIv"
        app:layout_constraintStart_toStartOf="@+id/productIv"
        app:layout_constraintTop_toTopOf="@+id/productIv"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/advBadgeV2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="4dp"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="@+id/backgroundV"
        app:layout_constraintTop_toTopOf="@+id/backgroundV"/>
    <View
        android:id="@+id/backgroundV"
        android:background="@drawable/catalog_shelf_product_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/productIv"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/productTitleTv"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:maxLines="2"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBarrier"
        app:layout_constraintEnd_toEndOf="@+id/backgroundV"
        app:layout_constraintStart_toStartOf="@+id/backgroundV"
        app:layout_constraintTop_toBottomOf="@+id/productIv"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="productTitleTv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
