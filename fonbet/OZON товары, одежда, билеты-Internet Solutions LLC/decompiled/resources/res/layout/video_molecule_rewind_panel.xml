<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="?attr/oz_semantic_text_primary_negative"
        android:id="@+id/rewindTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="118dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/dot"
        style="@style/TextStyle.Head.XXL"/>
    <ImageView
        android:textColor="@color/oz_white_overlay_25"
        android:id="@+id/dot"
        android:layout_width="4dp"
        android:layout_height="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/rewindTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rewindTime"
        app:srcCompat="@drawable/video_molecule_rewind_time_delimiter"
        style="@style/TextStyle.Head.XXL"/>
    <TextView
        android:textColor="@color/oz_white_overlay_25"
        android:id="@+id/totalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="118dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dot"
        style="@style/TextStyle.Head.XXL"/>
</merge>
