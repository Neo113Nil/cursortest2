<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/iconView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.image.ImageFixed
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/pictureBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iconView,imageView"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Headline.700xlarge"
        android:textColor="@color/text_primary"
        android:id="@+id/titleTextAtomView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pictureBarrier"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Body.500medium"
        android:textColor="@color/text_secondary"
        android:id="@+id/subtitleTextAtomView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextAtomView"
        app:layout_goneMarginTop="20dp"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="48dp"
        android:layout_marginHorizontal="16dp"
        app:constraint_referenced_ids="submitButton, cancelButton"
        app:flow_verticalGap="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTextAtomView"/>
    <ru.ozon.uni.android.controls.button.ButtonView
        android:id="@+id/submitButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:buttonsSize="size_600"
        style="@style/Button.ActionPrimary"/>
    <ru.ozon.uni.android.controls.button.ButtonView
        android:id="@+id/cancelButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:buttonsSize="size_600"
        style="@style/Button.ActionSecondary"/>
    <include layout="@layout/ozon_id_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
