<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notificationContainerCl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/m_notification_block_min_width">
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/badgesFbl"
        android:paddingTop="@dimen/m_notification_flexbox_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/m_notification_flexbox_padding"
        android:paddingEnd="@dimen/m_notification_flexbox_padding"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toEndOf="@+id/blurIv"
        app:layout_constraintStart_toStartOf="@+id/blurIv"
        app:layout_constraintTop_toBottomOf="@+id/imageIv"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/contentLl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/m_notification_content_padding"
        android:paddingEnd="@dimen/m_notification_content_padding"
        app:layout_constraintEnd_toEndOf="@+id/blurIv"
        app:layout_constraintStart_toStartOf="@+id/blurIv"
        app:layout_constraintTop_toBottomOf="@+id/badgesFbl"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/buttonsFbl"
        android:padding="@dimen/m_notification_flexbox_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flexWrap="wrap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/blurIv"
        app:layout_constraintStart_toStartOf="@+id/blurIv"
        app:layout_constraintTop_toBottomOf="@+id/contentLl"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption"
        android:textColor="@color/text_secondary"
        android:id="@+id/sendTimeTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/m_notification_send_time_padding_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/blurIv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:maxHeight="@dimen/m_image_max_height"
        app:layout_constraintBottom_toBottomOf="@+id/imageIv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/m_image_max_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageIv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:maxHeight="@dimen/m_image_max_height"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/m_image_max_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
