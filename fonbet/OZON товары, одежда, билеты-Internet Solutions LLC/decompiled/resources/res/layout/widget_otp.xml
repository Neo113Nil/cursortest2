<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSv"
    android:background="?attr/oz_semantic_bg_secondary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/otpCl"
        android:background="?attr/oz_semantic_bg_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Group
            android:id="@+id/otpDefaultPageGroup"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="titleTv,subtitleTv,otpEt,retrySendCodeButton,hintButtonsContainer"/>
        <TextView
            android:textAppearance="@style/TextStyle.Head.XL"
            android:gravity="center_vertical"
            android:id="@+id/titleTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toTopOf="@+id/otpEt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:textAppearance="@style/OzonTextAppearance.Body.500medium"
            android:textColor="?attr/oz_semantic_text_secondary"
            android:gravity="center_vertical"
            android:id="@+id/subtitleTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleTv"/>
        <ru.ozon.uni.android.input.textinput.ui.OzonTextInputLayout
            android:id="@+id/otpEt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_margin"
            android:layout_marginHorizontal="@dimen/default_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitleTv"
            app:layout_goneMarginTop="36dp"/>
        <ru.ozon.uni.android.controls.button.ButtonView
            android:id="@+id/retrySendCodeButton"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20"
            android:layout_marginHorizontal="@dimen/default_margin"
            app:buttonsSize="size_600"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/otpEt"
            style="@style/Button.ActionPrimary"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hintButtonsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/default_margin"
            android:layout_marginHorizontal="@dimen/default_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/otpErrorPageGroup"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="otpErrorImageView,otpErrorTitleTextAtomView,otpErrorRetryButton"/>
        <ru.ozon.uni.android.atom.image.Image
            android:id="@+id/otpErrorImageView"
            android:layout_width="168dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@+id/otpErrorTitleTextAtomView"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:textAppearance="@style/OzonTextAppearance.Headline.700xlarge"
            android:gravity="center"
            android:id="@+id/otpErrorTitleTextAtomView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toTopOf="@+id/otpErrorRetryButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/otpErrorImageView"
            style="@style/OzonTextAppearance.Headline.700xlarge"/>
        <ru.ozon.uni.android.controls.button.ButtonView
            android:id="@+id/otpErrorRetryButton"
            android:nextFocusUp="@+id/inputEditText"
            android:nextFocusDown="@+id/disclaimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_marginTop="12dp"
            app:buttonsSize="size_600"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Button.ActionPrimary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
