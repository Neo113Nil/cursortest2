<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/Widget.AppCompat.Toolbar"
        android:id="@+id/toolbar"
        android:background="@color/oz_semantic_bg_secondary"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/pdfViewFl"
        android:background="@color/oz_white_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <ru.ozon.app.android.pdfviewer.presentation.PinchRecyclerView
            android:id="@+id/pdfView"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/progress"
            layout="@layout/view_progressbar_white_bg"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/pdfViewParanjaFl"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/pdfViewFl"
        app:layout_constraintEnd_toEndOf="@+id/pdfViewFl"
        app:layout_constraintStart_toStartOf="@+id/pdfViewFl"
        app:layout_constraintTop_toTopOf="@+id/pdfViewFl"/>
</androidx.constraintlayout.widget.ConstraintLayout>
