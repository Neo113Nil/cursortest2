<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/layerFloor1"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/publicationStatusTAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
    <ru.ozon.app.android.atoms.v3.molecules.DisclaimerContainer
        android:id="@+id/promoStatusDC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.borderless.LargeBorderlessButtonView
        android:id="@+id/buttonView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
