<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/contentLl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/titleTextAtom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20"
        android:layout_marginHorizontal="@dimen/dimen_16"
        style="@style/OzonTextAppearance.Headline.500medium"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:id="@+id/descriptionTextAtom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_16"
        android:layout_marginVertical="@dimen/dimen_8"
        style="@style/OzonTextAppearance.Body.500medium"/>
    <ru.ozon.uni.android.atom.labelRating.LabelRatingView
        android:id="@+id/ratingBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_40"
        android:layout_marginHorizontal="@dimen/dimen_16"
        android:layout_marginVertical="@dimen/dimen_16"
        style="@style/LabelRating.Default"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:id="@+id/rateQuestionTextAtom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_16"
        style="@style/OzonTextAppearance.Body.500medium"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/reasonsRecyclerView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_gravity="center"
        android:id="@+id/messageTextInputLayout"
        android:paddingBottom="@dimen/dimen_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20"
        android:minHeight="@dimen/dimen_48"
        android:layout_marginHorizontal="@dimen/dimen_16"
        style="@style/m_TexInputBoxStyle">
        <com.google.android.material.textfield.TextInputEditText
            android:textAppearance="@style/OzonTextAppearance.Compact.500medium"
            android:textColor="@color/text_primary"
            android:id="@+id/messageEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"/>
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
