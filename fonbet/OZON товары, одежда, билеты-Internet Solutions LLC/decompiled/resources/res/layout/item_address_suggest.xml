<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutSuggestionAddress"
    android:background="@drawable/ripple_rect_bluewave"
    android:paddingTop="8dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Gray60"
        android:ellipsize="end"
        android:id="@+id/numberPVZ"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/titleTv"
        app:layout_constraintEnd_toStartOf="@+id/disclosureIv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:textColor="?attr/oz_semantic_text_primary"
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/disclosureIv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/numberPVZ"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="8dp"/>
    <ImageView
        android:id="@+id/disclosureIv"
        android:layout_width="@dimen/ic_size_small"
        android:layout_height="@dimen/ic_size_small"
        android:layout_marginEnd="@dimen/margin_medium_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_disclosure_sm"
        app:tint="?attr/oz_semantic_text_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
