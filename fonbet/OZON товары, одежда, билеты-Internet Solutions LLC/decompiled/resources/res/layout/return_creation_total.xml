<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/returnCreationTotalLl"
    android:paddingTop="4dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/headerContainerLl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <include
            android:id="@+id/totalRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            layout="@layout/return_balance_total_row"/>
        <include
            android:id="@+id/expandRowsItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/return_balance_total_row"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowsRv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:nestedScrollingEnabled="false"
        android:layout_marginHorizontal="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/refundDetailsGroupLl"
        android:background="@drawable/bg_total_all_rounded"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="16dp">
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/refundDetailsTitleTav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/refundDetailsRowsRv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="6dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </LinearLayout>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/buttonBv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/descriptionTav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
