<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/videoMolecule"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.media3.ui.PlayerView
        android:id="@+id/videoMoleculePlayer"
        android:tag="@string/video_molecule_view_tag"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:hide_on_touch="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:resize_mode="fit"
        app:show_timeout="0"
        app:surface_type="texture_view"
        app:use_controller="false"/>
    <View
        android:id="@+id/touchArea"
        android:tag="@string/video_molecule_view_tag"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/videoMoleculeBottomContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/topGradient"
        android:tag="@string/video_molecule_view_tag"
        android:layout_width="0dp"
        android:layout_height="124dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottomGradient"
        android:tag="@string/video_molecule_view_tag"
        android:background="@drawable/video_molecule_bg_bottom_gradient"
        android:layout_width="0dp"
        android:layout_height="242dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.app.android.videomolecule.presentation.view.VideoMoleculeRewindView
        android:id="@+id/rewindContainer"
        android:tag="@string/video_molecule_view_tag"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ru.ozon.app.android.videomolecule.presentation.replay.VideoMoleculeReplayView
        android:id="@+id/replayContainer"
        android:tag="@string/video_molecule_view_tag"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/videoMoleculePlayPauseButtonContainer"
        android:tag="@string/video_molecule_view_tag"
        android:background="@drawable/video_molecule_button_bg"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ru.ozon.app.android.storefrontcommonwidgets.core.views.SwitchingImageView
            android:layout_gravity="center"
            android:id="@+id/videoMoleculePlayPauseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_m_pause_sign_filled"
            app:tint="@color/oz_white_1"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/videoMoleculeBottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/playerControlsView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.media3.ui.LegacyPlayerControlView
        android:id="@+id/playerControlsView"
        android:tag="@string/video_molecule_view_tag"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        app:controller_layout_id="@layout/video_molecule_control_pannel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:show_timeout="0"/>
</merge>
