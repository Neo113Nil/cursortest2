<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchResultGridItemCl"
    android:background="?attr/layerFloor1"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/selector_standard">
    <ru.ozon.app.android.search.views.galleryswipeview.GallerySwipeView
        android:id="@+id/gallerySwipeView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/search_tile_grid_padding"
        android:layout_marginStart="@dimen/search_tile_grid_padding"
        android:layout_marginEnd="@dimen/search_tile_grid_padding"
        app:layout_constraintBottom_toTopOf="@+id/contentElementsVAL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.app.android.search.catalog.components.searchresultv2.presentation.BadgesContainerView
        android:id="@+id/badgesContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/badges_container_bottom_margin"
        app:layout_constraintBottom_toBottomOf="@+id/gallerySwipeView"
        app:layout_constraintLeft_toLeftOf="@+id/gallerySwipeView"
        app:layout_constraintRight_toRightOf="@+id/gallerySwipeView"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contentElementsVAL"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="@dimen/search_tile_grid_padding"
        android:layout_marginEnd="@dimen/search_tile_grid_padding"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gallerySwipeView"
        app:layout_constraintWidth_default="wrap"/>
    <View
        android:id="@+id/contentElementView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/contentElementsVAL"
        app:layout_constraintEnd_toEndOf="@+id/contentElementsVAL"
        app:layout_constraintStart_toStartOf="@+id/contentElementsVAL"
        app:layout_constraintTop_toTopOf="@+id/contentElementsVAL"/>
    <ru.ozon.app.android.search.searchscreen.presentation.components.searchresults.common.presentation.multiButton.view.VerticalMultiButtonContainerView
        android:id="@+id/multiButtonItemContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/footerLabelTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="spread"
        app:layout_constraintHeight_min="32dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contentElementsVAL"
        app:layout_constraintVertical_bias="1"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Caption"
        android:ellipsize="end"
        android:id="@+id/footerLabelTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/search_tile_grid_padding"
        android:maxLines="3"
        android:layout_marginStart="@dimen/search_tile_grid_padding"
        android:layout_marginEnd="@dimen/search_tile_grid_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/topRightButtonsRV"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
