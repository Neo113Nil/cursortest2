<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blockTextRootCl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.M.Secondary"
        android:textColor="@color/text_secondary"
        android:ellipsize="end"
        android:id="@+id/authorNameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dimen_12"
        app:layout_constraintEnd_toStartOf="@+id/authorIcons"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/authorIcons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_2"
        android:layout_marginStart="@dimen/dimen_2"
        android:layout_marginEnd="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="@+id/authorNameTv"
        app:layout_constraintEnd_toStartOf="@+id/authorNameTv"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/authorNameTv"
        app:layout_constraintTop_toTopOf="@+id/authorNameTv"
        app:layout_constraintWidth_default="wrap"/>
    <ru.ozon.android.messenger.blocks.messagetext.TextViewWithSlaveLayout
        android:id="@+id/textWithSlaveLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/authorNameTv">
        <ru.ozon.android.messenger.utils.view.TightTextView
            android:textAppearance="@style/TextStyle.Body.L"
            android:textColor="@color/text_primary"
            android:layout_gravity="end|bottom"
            android:id="@+id/textTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ru.ozon.android.messenger.framework.presentation.common.view.timestatus.TimeStatusView
            android:id="@+id/timeStatusView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </ru.ozon.android.messenger.blocks.messagetext.TextViewWithSlaveLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
