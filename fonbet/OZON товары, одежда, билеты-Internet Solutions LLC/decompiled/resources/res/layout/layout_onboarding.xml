<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFl"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.composer.widgets.v2.onboarding.presentation.dialog.OnBoardingBannerView
        android:id="@+id/bannerObv"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"/>
    <ImageView
        android:id="@+id/triangleIv"
        android:visibility="invisible"
        android:layout_width="16dp"
        android:layout_height="10dp"
        android:src="@drawable/ic_triangle_onboarding"
        android:contentDescription="@null"/>
    <View
        android:id="@+id/tapOnboardingArea"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
