<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.fresh.main.widgets.orderTracking.presentation.SquircleConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/orderTrackingItemContainer"
    android:layout_width="match_parent"
    android:layout_height="86dp"
    android:layout_marginEnd="8dp">
    <ImageView
        android:id="@+id/orderTrackingIV"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/orderTrackingBadgeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/orderTrackingTitleTA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toStartOf="@+id/orderTrackingIV"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderTrackingBadgeView"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_2dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toStartOf="@+id/orderTrackingIV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderTrackingTitleTA">
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/orderTrackingSubtitleTA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/orderTrackingArrowIv"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_s_chevron_right"
            android:contentDescription="@null"
            android:backgroundTint="?attr/oz_semantic_text_quaternary"/>
    </LinearLayout>
</ru.ozon.app.android.fresh.main.widgets.orderTracking.presentation.SquircleConstraintLayout>
