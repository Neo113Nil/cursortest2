<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_height="wrap_content">
    <FrameLayout
        android:background="@drawable/background_rounded_white_8"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:backgroundTint="#655ac6"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#000"
        android:id="@+id/demo_message_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#4a4a4a"
        android:id="@+id/demo_message_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"/>
</merge>
