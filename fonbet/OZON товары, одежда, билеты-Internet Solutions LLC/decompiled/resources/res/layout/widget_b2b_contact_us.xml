<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="16dp">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/b2bContactUsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/b2bContactUsBannerRoot"
        android:background="@drawable/ripple_rect_white_bluewave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/b2bContactUsBannerLogo"
            android:layout_width="88dp"
            android:layout_height="86dp"
            android:layout_marginTop="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/b2bContactUsBannerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toTopOf="@+id/b2bContactUsBannerSubtitle"
            app:layout_constraintEnd_toStartOf="@+id/b2bContactUsBannerLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginBottom="16dp"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/b2bContactUsBannerSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/b2bContactUsBannerTitle"
            app:layout_constraintStart_toStartOf="@+id/b2bContactUsBannerTitle"
            app:layout_constraintTop_toBottomOf="@+id/b2bContactUsBannerTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ru.ozon.uni.atoms.af.layout.VerticalAtomsLayout
        android:id="@+id/b2bContactUsBannerCells"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</LinearLayout>
