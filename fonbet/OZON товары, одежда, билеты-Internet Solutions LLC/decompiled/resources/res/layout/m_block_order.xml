<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/orderRoot"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="288dp"
    android:layout_marginStart="@dimen/dimen_12"
    android:layout_marginEnd="@dimen/dimen_12">
    <ru.ozon.uni.android.atom.productMedia.ProductMediaView
        android:id="@+id/orderProductMedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:ellipsize="end"
        android:id="@+id/orderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/orderSubtitle"
        app:layout_constraintEnd_toStartOf="@+id/orderLabeledIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/orderProductMedia"
        app:layout_constraintTop_toTopOf="@+id/orderProductMedia"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/orderSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/orderProductMedia"
        app:layout_constraintEnd_toStartOf="@+id/orderSendTime"
        app:layout_constraintStart_toEndOf="@+id/orderProductMedia"
        app:layout_constraintTop_toBottomOf="@+id/orderTitle"/>
    <ru.ozon.android.messenger.utils.view.LabeledIconView
        android:id="@+id/orderLabeledIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/orderTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/orderTitle"
        app:layout_constraintTop_toTopOf="@+id/orderTitle"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption"
        android:textColor="@color/text_secondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/orderSendTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/orderStatus"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/orderStatus"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_s_check"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/text_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
