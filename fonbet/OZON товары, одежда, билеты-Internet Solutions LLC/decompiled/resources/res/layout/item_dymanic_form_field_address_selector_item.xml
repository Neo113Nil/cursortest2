<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:id="@+id/descriptionTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/addressRv"
        android:paddingTop="12dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="76dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <ru.tinkoff.scrollingpagerindicator.ScrollingPagerIndicator
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/dotsPiv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:spi_dotColor="@color/oz_semantic_bg_quaternary"
        app:spi_dotSelectedColor="@color/oz_semantic_text_secondary"
        app:spi_dotSelectedSize="8dp"
        app:spi_dotSize="6dp"/>
</LinearLayout>
