<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fin_icon_card_root"
        android:background="@drawable/fintech_ripple_rect_round_16_bluewave"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="-16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fin_icon_card_secondary_icon">
        <ImageView
            android:id="@+id/fin_icon_card_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="40dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:textColor="@color/oz_semantic_text_primary"
            android:ellipsize="none"
            android:gravity="center"
            android:id="@+id/fin_icon_card_text"
            android:fadingEdgeLength="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:requiresFadingEdge="horizontal"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fin_icon_card_icon"
            style="@style/TextStyle.Caption"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/fin_icon_card_secondary_icon"
        android:background="#f00"
        android:visibility="visible"
        android:layout_width="28dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_s_lock_closed_filled"
        android:scaleType="center"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
