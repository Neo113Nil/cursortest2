<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:gravity="center"
        android:id="@+id/calendarTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Head.M"
        android:gravity="center_vertical"
        android:id="@+id/calendarEmptyDateTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calendarTitleTv"/>
    <ru.ozon.app.android.travel.feature.general.main.widgets.calendar.v1.view.CalendarDateControlView
        android:id="@+id/calendarStartDateControl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:dateTypeLabel="@string/calendar_to_android"
        app:isForStartDate="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/calendarWeekRow"
        app:layout_constraintEnd_toStartOf="@+id/calendarReturnDateControl"
        app:layout_constraintHeight_min="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calendarTitleTv"/>
    <ru.ozon.app.android.travel.feature.general.main.widgets.calendar.v1.view.CalendarDateControlView
        android:id="@+id/calendarReturnDateControl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:dateTypeLabel="@string/calendar_return"
        app:isForStartDate="false"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/calendarWeekRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="48dp"
        app:layout_constraintStart_toEndOf="@+id/calendarStartDateControl"
        app:layout_constraintTop_toBottomOf="@+id/calendarTitleTv"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/calendarDateControlGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="calendarStartDateControl,calendarReturnDateControl"/>
    <ru.ozon.app.android.travel.feature.general.main.widgets.calendar.v1.view.CalendarDateControlView
        android:id="@+id/calendarTourStartDateControl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:dateTypeLabel="@string/calendar_to_android"
        app:isForStartDate="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/calendarWeekRow"
        app:layout_constraintEnd_toStartOf="@+id/calendarTourDaysRoundControl"
        app:layout_constraintHeight_min="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calendarTitleTv"/>
    <ru.ozon.app.android.travel.feature.general.main.widgets.calendar.v1.view.CalendarDaysRoundControlView
        android:id="@+id/calendarTourDaysRoundControl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/calendarWeekRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="48dp"
        app:layout_constraintStart_toEndOf="@+id/calendarTourStartDateControl"
        app:layout_constraintTop_toBottomOf="@+id/calendarTitleTv"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/calendarTourDateControlGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="calendarTourStartDateControl,calendarTourDaysRoundControl"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/calendarDateControlBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="calendarStartDateControl,calendarReturnDateControl,calendarEmptyDateTv,calendarTourStartDateControl,calendarTourDaysRoundControl"/>
    <ru.ozon.app.android.travel.feature.general.main.widgets.calendar.v1.view.WeekRowLayout
        android:id="@+id/calendarWeekRow"
        android:background="?attr/layerFloor0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calendarDateControlBottomBarrier"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/calendarDaysRv"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:nestedScrollingEnabled="false"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calendarWeekRow"/>
    <ru.ozon.app.android.travel.feature.general.main.widgets.calendar.v1.view.CalendarBottomView
        android:id="@+id/calendarBottomView"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
