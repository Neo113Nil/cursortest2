<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.pdp.ui.configurators.aspectsV2.image.RatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ratioGroup"
    android:background="@drawable/bg_aspects_image_selectable"
    android:layout_width="@dimen/dimen_56"
    android:layout_height="@dimen/dimen_56">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageView"
        android:background="@color/white"
        android:padding="@dimen/dimen_6"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shapeAppearanceOverlay="@style/roundedImageVariant"/>
    <ru.ozon.app.android.pdp.ui.configurators.aspectsCompactV2.SquareAspectColorVariantView
        android:layout_gravity="center"
        android:id="@+id/colorView"
        android:padding="@dimen/dimen_6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</ru.ozon.app.android.pdp.ui.configurators.aspectsV2.image.RatioFrameLayout>
