<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:layout_gravity="center_horizontal"
        android:id="@+id/luggageRequirementsV2TitleTAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/luggageRequirementsV2TabsTL"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="16dp"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="?attr/textPrimary"
        app:tabTextAppearance="@style/TextStyle.Caption.AC"
        app:tabTextColor="?attr/textSecondary"
        style="@style/TabLayout"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/luggageRequirementsV2RV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:nestedScrollingEnabled="false"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
