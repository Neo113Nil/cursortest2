<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">
    <ru.ozon.app.android.geo.mapPreview.presentation.MapPreviewView
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="351:235"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/centerInMapIbv"
        android:background="@drawable/bg_rounded_primary"
        android:padding="14dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:tint="?attr/graphicPrimary"
        android:backgroundTint="?attr/layerFloor1"
        app:layout_constraintBottom_toBottomOf="@+id/mapContainer"
        app:layout_constraintEnd_toEndOf="@+id/mapContainer"
        app:srcCompat="@drawable/ic_m_geo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
