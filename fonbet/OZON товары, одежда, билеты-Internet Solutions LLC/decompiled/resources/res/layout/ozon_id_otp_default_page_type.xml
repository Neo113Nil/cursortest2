<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/defaultPageTypeGroup"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="logoImageView,titleTextAtomV2,subtitleTextAtomV2,messengerOtpCell,flashCallGroup,otpTextField,getNewCodeButton,disclaimer,hintButtonsFlow,continueButton"/>
    <ImageView
        android:id="@+id/logoImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_ozon_id_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Headline.700xlarge"
        android:id="@+id/titleTextAtomV2"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoImageView"
        style="@style/OzonTextAppearance.Headline.700xlarge"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Body.500medium"
        android:textColor="@color/text_secondary"
        android:id="@+id/flashCallHintTextAtomV2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/flashCallAccentTextAtomV2"
        app:layout_constraintEnd_toStartOf="@+id/flashCallAccentTextAtomV2"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Headline.400small"
        android:textColor="@color/oz_text_fresh"
        android:id="@+id/flashCallAccentTextAtomV2"
        android:background="@drawable/bg_ozon_id_flash_call"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/flashCallHintTextAtomV2"
        app:layout_constraintTop_toBottomOf="@+id/titleTextAtomV2"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/subtitleTextAtomV2"
        android:nextFocusDown="@+id/messengerOtpCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flashCallAccentTextAtomV2"/>
    <ru.ozon.uni.android.cell.CellView
        android:id="@+id/messengerOtpCell"
        android:nextFocusDown="@+id/inputEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTextAtomV2"/>
    <ru.ozon.uni.android.cell.CellView
        android:id="@+id/callInCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTextAtomV2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/otpCallInCellsBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="callInCell,messengerOtpCell"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/flashCallGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="flashCallHintTextAtomV2,flashCallAccentTextAtomV2"/>
    <ru.ozon.uni.android.cell.text.TextFieldCellView
        android:id="@+id/otpTextField"
        android:nextFocusDown="@+id/getNewCodeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/otpCallInCellsBottomBarrier"
        app:textFieldAddonTextAppearance="@style/OzonTextAppearance.Body.300xsmall"/>
    <ru.ozon.uni.android.controls.button.ButtonView
        android:id="@+id/getNewCodeButton"
        android:nextFocusUp="@+id/inputEditText"
        android:nextFocusDown="@+id/disclaimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:buttonsSize="size_600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/otpTextField"
        style="@style/Button.ActionPrimary"/>
    <include
        android:id="@+id/disclaimer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/getNewCodeButton"
        layout="@layout/ozon_id_disclaimer"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/hintButtonsFlow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        app:constraint_referenced_ids="hintButtonsLinearLayout"
        app:flow_verticalGap="16dp"
        app:layout_constraintBottom_toTopOf="@+id/continueButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disclaimer"
        app:layout_constraintVertical_bias="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/hintButtonsLinearLayout"
        android:nextFocusUp="@+id/disclaimer"
        android:nextFocusDown="@+id/continueButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disclaimer"
        app:layout_constraintVertical_bias="1"/>
    <ru.ozon.uni.android.controls.button.ButtonView
        android:id="@+id/continueButton"
        android:nextFocusUp="@+id/hintButtonsFlow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        app:buttonsSize="size_600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Button.ActionPrimary"/>
</merge>
