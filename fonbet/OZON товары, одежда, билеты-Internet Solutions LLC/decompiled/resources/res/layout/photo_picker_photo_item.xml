<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:id="@+id/deletePhotoIbv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="@+id/photoIv"
        app:layout_constraintTop_toTopOf="@+id/photoIv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/photoIv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.loader.ui.LoaderView
        android:id="@+id/photoLoaderLv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/photoIv"
        app:layout_constraintEnd_toEndOf="@+id/photoIv"
        app:layout_constraintStart_toStartOf="@+id/photoIv"
        app:layout_constraintTop_toTopOf="@+id/photoIv"
        app:loaderSize="loader_400"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/retryLoadingIv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_m_reload"
        android:elevation="2dp"
        app:iconViewSize="icon_400"
        app:layout_constraintBottom_toBottomOf="@+id/photoIv"
        app:layout_constraintEnd_toEndOf="@+id/photoIv"
        app:layout_constraintStart_toStartOf="@+id/photoIv"
        app:layout_constraintTop_toTopOf="@+id/photoIv"
        app:tint="@color/graphic_secondary"/>
    <View
        android:id="@+id/overlayView"
        android:background="@color/graphic_secondary_inverted"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/photoIv"
        app:layout_constraintEnd_toEndOf="@+id/photoIv"
        app:layout_constraintStart_toStartOf="@+id/photoIv"
        app:layout_constraintTop_toTopOf="@+id/photoIv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
