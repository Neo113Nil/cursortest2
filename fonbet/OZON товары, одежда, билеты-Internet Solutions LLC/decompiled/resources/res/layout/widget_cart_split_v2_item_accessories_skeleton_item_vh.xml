<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="248dp"
    android:layout_height="72dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">
    <View
        android:id="@+id/imagePlaceHolder"
        android:background="?attr/layerSurface"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/line1PlaceHolder"
        android:background="?attr/layerSurface"
        android:layout_width="106dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintStart_toEndOf="@+id/imagePlaceHolder"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/line2PlaceHolder"
        android:background="?attr/layerSurface"
        android:layout_width="106dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintStart_toEndOf="@+id/imagePlaceHolder"
        app:layout_constraintTop_toBottomOf="@+id/line1PlaceHolder"/>
    <View
        android:id="@+id/line3PlaceHolder"
        android:background="?attr/layerSurface"
        android:layout_width="40dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintStart_toEndOf="@+id/imagePlaceHolder"
        app:layout_constraintTop_toBottomOf="@+id/line2PlaceHolder"/>
    <View
        android:id="@+id/buttonPlaceHolder"
        android:background="?attr/layerSurface"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
