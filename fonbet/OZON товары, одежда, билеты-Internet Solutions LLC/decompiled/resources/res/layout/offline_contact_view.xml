<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:gravity="center_vertical">
    <FrameLayout
        android:id="@+id/image_holder"
        android:background="@drawable/background_rounded_primary_12"
        android:layout_width="44dp"
        android:layout_height="44dp">
        <TextView
            android:textColor="@color/text_tertiary"
            android:gravity="center"
            android:id="@+id/big_letter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            style="@style/OzonTextAppearance.BodyControl.500medium"/>
        <ImageView
            android:id="@+id/image"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="center"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/name_holder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2323"
            android:singleLine="true"
            style="@style/OzonTextAppearance.Compact.500medium"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/text_secondary"
            android:ellipsize="end"
            android:id="@+id/number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="2323"
            android:singleLine="true"
            style="@style/OzonTextAppearance.Body.400small"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/chevron"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_s_chevron_right"
        android:scaleType="center"
        android:layout_marginStart="4dp"
        app:tint="@color/graphic_tertiary"/>
</merge>
