<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/paginationErrorLl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/m_pagination_error_block_top_margin">
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:textColor="@color/text_primary"
        android:layout_gravity="center"
        android:id="@+id/paginationErrorTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/messenger_chat_screen_pagination_error_on_bottom"
        android:layout_weight="1"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
        android:layout_gravity="center"
        android:id="@+id/paginationErrorBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/messenger_action_update"
        android:layout_weight="1"
        style="@style/SmallButton.Secondary"/>
</LinearLayout>
