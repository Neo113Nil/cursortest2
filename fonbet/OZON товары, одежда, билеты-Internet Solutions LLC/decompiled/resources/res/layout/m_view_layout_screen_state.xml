<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/errorLogoIv"
        android:visibility="visible"
        android:layout_width="@dimen/m_error_size_icon"
        android:layout_height="@dimen/m_error_size_icon"
        app:layout_constraintBottom_toTopOf="@+id/errorTitleTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:gravity="center"
        android:id="@+id/errorTitleTv"
        android:visibility="gone"
        android:layout_width="265dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="@dimen/m_margin_small"
        android:layout_marginEnd="@dimen/m_margin_small"
        app:layout_constraintBottom_toTopOf="@+id/errorDescTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorLogoIv"
        app:layout_constraintVertical_chainStyle="spread"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/errorDescTv"
        android:visibility="gone"
        android:layout_width="265dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="42dp"
        android:maxLines="10"
        android:layout_marginStart="@dimen/m_margin_small"
        android:layout_marginEnd="@dimen/m_margin_small"
        app:layout_constraintBottom_toTopOf="@+id/screenStateActionBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorTitleTv"
        app:layout_constraintVertical_chainStyle="spread"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
        android:id="@+id/screenStateActionBtn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/m_margin_medium"
        android:text="@string/messenger_action_update"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorDescTv"
        style="@style/SmallButton.Secondary"/>
    <me.zhanghai.android.materialprogressbar.MaterialProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/m_ProgressBarStyle"/>
</merge>
