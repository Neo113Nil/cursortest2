<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fin_icon_frame"
        android:visibility="visible"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/fin_image_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"/>
        <ru.ozon.fintech.ui.progress.circle.CircleProgressWithNumberView
            android:id="@+id/fin_circe_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="@color/oz_semantic_text_primary"
        android:id="@+id/fin_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/fin_horizontal"
        app:layout_constraintEnd_toStartOf="@+id/fin_right_items_frame"
        app:layout_constraintStart_toEndOf="@+id/fin_icon_frame"
        app:layout_constraintTop_toTopOf="@+id/fin_icon_frame"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="2dp"
        app:layout_goneMarginEnd="0dp"
        app:layout_goneMarginStart="0dp"
        style="@style/TextStyle.Body.L.Bold"/>
    <ru.ozon.fintech.ui.progress.horizontal.HorizontalProgressView
        android:id="@+id/fin_horizontal"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/fin_subtitle"
        app:layout_constraintEnd_toEndOf="@+id/fin_title"
        app:layout_constraintStart_toStartOf="@+id/fin_title"
        app:layout_constraintTop_toBottomOf="@+id/fin_title"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="@color/oz_semantic_text_secondary"
        android:id="@+id/fin_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/fin_icon_frame"
        app:layout_constraintEnd_toEndOf="@+id/fin_title"
        app:layout_constraintStart_toStartOf="@+id/fin_title"
        app:layout_constraintTop_toBottomOf="@+id/fin_horizontal"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TextStyle.Body.M"/>
    <FrameLayout
        android:id="@+id/fin_right_items_frame"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/fin_chevron_image_view"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_s_chevron_right"
            android:scaleType="center"/>
        <ru.ozon.fintech.ui.buttonatom.ButtonAtomWrapperView
            android:id="@+id/fin_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</merge>
