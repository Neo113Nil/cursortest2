<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/layerFloor1"
    android:paddingBottom="16dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:id="@+id/titleTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
    <ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout
        android:id="@+id/valueTil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <EditText
            android:textAppearance="@style/TextStyle.Body.L"
            android:id="@+id/valueEt"
            android:background="@drawable/mobilization_bg_edit_text_selector"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxLength="50"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/cursor"/>
    </ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout>
    <Button
        android:id="@+id/activationActionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="@style/MobilizationButton"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Gray40"
        android:id="@+id/descriptionTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
</LinearLayout>
