<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/curtainNavBarContainer"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <ImageView
        android:id="@+id/actionLeftIv"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/endBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Blue"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/actionLeftTv"
        android:background="@drawable/ripple_rect_bluewave"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/endBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/startBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="actionLeftTv,actionLeftIv"/>
    <ru.ozon.app.android.common.filterWidgets.curtain.CurtainNavBarLabelTextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:ellipsize="end"
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/subTitleTv"
        app:layout_constraintEnd_toStartOf="@+id/endBarrier"
        app:layout_constraintStart_toEndOf="@+id/startBarrier"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.app.android.common.filterWidgets.curtain.CurtainNavBarLabelTextView
        android:textAppearance="@style/TextStyle.Caption.Gray60"
        android:ellipsize="end"
        android:id="@+id/subTitleTv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/endBarrier"
        app:layout_constraintStart_toEndOf="@+id/startBarrier"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/endBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="actionRightTv,actionRightIv,actionDrawableIv"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Blue"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/actionRightTv"
        android:background="@drawable/ripple_rect_bluewave"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/startBarrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/actionRightIv"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/startBarrier"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="12dp"/>
    <ImageView
        android:id="@+id/actionDrawableIv"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_m_cross"
        android:scaleType="fitCenter"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/startBarrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.borderless.SmallBorderlessButtonWithIconView
        android:id="@+id/buttonLeftIv"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/endBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.borderless.SmallBorderlessButtonWithIconView
        android:id="@+id/buttonRightIv"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/startBarrier"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
