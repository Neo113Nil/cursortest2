<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/layer_floor_1"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/bg_ripple_blue_rounded"
    android:paddingStart="@dimen/default_padding"
    android:paddingEnd="8dp">
    <View
        android:id="@+id/listImageBackgroundView"
        android:background="@drawable/bg_image_white_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/listIv"
        app:layout_constraintEnd_toEndOf="@+id/listIv"
        app:layout_constraintStart_toStartOf="@+id/listIv"
        app:layout_constraintTop_toTopOf="@+id/listIv"/>
    <ImageView
        android:id="@+id/listIv"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/listImageOverlayView"
        android:background="@drawable/bg_image_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/listIv"
        app:layout_constraintEnd_toEndOf="@+id/listIv"
        app:layout_constraintStart_toStartOf="@+id/listIv"
        app:layout_constraintTop_toTopOf="@+id/listIv"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:id="@+id/optionsButtonHolder"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:ellipsize="end"
        android:id="@+id/titleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:drawablePadding="6dp"
        android:layout_marginStart="@dimen/default_margin"
        android:layout_marginEnd="@dimen/margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/optionsButtonHolder"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/listIv"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:textColor="@color/oz_semantic_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_extra_extra_small"
        android:maxLines="1"
        android:layout_marginStart="@dimen/default_margin"
        android:layout_marginEnd="@dimen/margin"
        app:layout_constraintEnd_toStartOf="@+id/optionsButtonHolder"
        app:layout_constraintStart_toEndOf="@+id/listIv"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
