<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/travelServiceBlockV4TitleTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/travelServiceBlockV4ChangeServiceSBV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
        android:id="@+id/travelServiceBlockV4ChangeServiceSBV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/travelServiceBlockV4TitleBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="travelServiceBlockV4TitleTAV,travelServiceBlockV4ChangeServiceSBV"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/travelServiceBlockV4DescriptionTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelServiceBlockV4TitleBarrier"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.borderless.SmallBorderlessButtonView
        android:id="@+id/moreActionSBBV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelServiceBlockV4DescriptionTAV"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/additionalListRV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moreActionSBBV"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/travelServiceBlockV4PricePV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/additionalListRV"
        app:layout_goneMarginTop="12dp"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/travelServiceBlockV4PriceSuffixTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/travelServiceBlockV4PricePV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/travelServiceBlockV4PricePV"
        app:layout_constraintTop_toTopOf="@+id/travelServiceBlockV4PricePV"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/travelServiceBlockV4PriceGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="travelServiceBlockV4PricePV,travelServiceBlockV4PriceSuffixTAV"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/travelServiceBlockV4PriceBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="travelServiceBlockV4PricePV,travelServiceBlockV4PriceSuffixTAV"/>
    <ru.ozon.app.android.travel.molecules.view.travelBadge.v2.TravelBadgeV2ListView
        android:orientation="horizontal"
        android:id="@+id/travelServiceBlockV4BadgeListView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelServiceBlockV4PriceBarrier"/>
</merge>
