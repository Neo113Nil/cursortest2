<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:id="@+id/titleTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Размер текста"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/globalSw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Вкл"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/OzSwitch"/>
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/borderSw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Рамки"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/OzSwitch"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:gravity="end"
        android:id="@+id/fontSizeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Размер текста"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:labelFor="@+id/fontSizeEt"/>
    <EditText
        android:gravity="end"
        android:id="@+id/fontSizeEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="10"
        android:hint="Размер текста"
        android:ems="10"
        android:inputType="number"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:gravity="end"
        android:id="@+id/fontColorLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Цвет текста"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:labelFor="@+id/fontColorEt"/>
    <EditText
        android:gravity="end"
        android:id="@+id/fontColorEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Цвет текста"
        android:ems="10"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:gravity="end"
        android:id="@+id/bubbleColorLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Цвет фона"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:labelFor="@+id/bubbleColorEt"/>
    <EditText
        android:gravity="end"
        android:id="@+id/bubbleColorEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Цвет фона"
        android:ems="10"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:gravity="end"
        android:id="@+id/borderColorLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Цвет рамок"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:labelFor="@+id/bubbleColorEt"/>
    <EditText
        android:gravity="end"
        android:id="@+id/borderColorEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Цвет рамок"
        android:ems="10"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:gravity="end"
        android:id="@+id/alphaLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Непрозрачность"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:labelFor="@+id/alphaEt"/>
    <EditText
        android:gravity="end"
        android:id="@+id/alphaEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Прозрачность"
        android:ems="10"
        android:inputType="number"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
