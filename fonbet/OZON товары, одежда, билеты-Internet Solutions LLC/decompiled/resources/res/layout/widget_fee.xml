<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_fee"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/titleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/copyTextTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTav"
        app:layout_constraintStart_toEndOf="@+id/titleTav"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/copyIconIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="2dp"
        app:iconViewSize="icon_300"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTav"
        app:layout_constraintStart_toEndOf="@+id/copyTextTav"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/copyTextClickArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/copyTextTav"
        app:layout_constraintEnd_toEndOf="@+id/copyIconIv"
        app:layout_constraintStart_toStartOf="@+id/copyTextTav"
        app:layout_constraintTop_toTopOf="@+id/copyTextTav"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/subtitleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/firstRowRv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.app.android.cscore.orderdetails.molecule.images.presentation.ImagesView
        android:id="@+id/firstRowRv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/secondRowRv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="16dp"/>
    <ru.ozon.app.android.cscore.orderdetails.molecule.images.presentation.ImagesView
        android:id="@+id/secondRowRv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/buttonV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
