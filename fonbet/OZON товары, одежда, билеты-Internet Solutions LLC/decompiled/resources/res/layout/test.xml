    android:background="#ff00ff00"
    android:layout_width="match_parent"
    android:layout_height="200dp">
    <FrameLayout
        android:background="#ff009999"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_weight="0.7"/>
