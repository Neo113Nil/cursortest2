<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.image.Image
        android:id="@+id/largeOrdersLiftingIV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/largeOrdersLiftingTitleTAV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/largeOrdersLiftingSubtitleTAV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.cell.text.TextFieldCellView
        android:id="@+id/largeOrdersLiftingTF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"/>
    <ru.ozon.uni.atoms.af.layout.VerticalAtomsLayout
        android:id="@+id/largeOrdersLiftingCellsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/largeOrdersLiftingConfirmBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/largeOrdersLiftingCancelBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
