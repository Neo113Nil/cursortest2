<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="276dp"
    android:layout_height="420dp"
    app:cardCornerRadius="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/layerFloor1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/productIv"
            android:background="@drawable/bg_rounded_corners"
            android:layout_width="0dp"
            android:layout_height="217dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/productImageOverlayV"
            android:background="@drawable/bg_image_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/productIv"
            app:layout_constraintEnd_toEndOf="@+id/productIv"
            app:layout_constraintStart_toStartOf="@+id/productIv"
            app:layout_constraintTop_toTopOf="@+id/productIv"/>
        <ru.ozon.uni.atoms.af.layout.HorizontalFlexAtomsLayout
            android:id="@+id/atomsHFAL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/productIv"
            app:layout_constraintEnd_toEndOf="@+id/productIv"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/productIv"
            app:layout_constraintTop_toTopOf="@+id/productIv"
            app:layout_constraintVertical_bias="1"/>
        <ImageView
            android:id="@+id/soldIv"
            android:visibility="gone"
            android:layout_width="142dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_sold"
            app:layout_constraintBottom_toBottomOf="@+id/productIv"
            app:layout_constraintEnd_toEndOf="@+id/productIv"
            app:layout_constraintStart_toStartOf="@+id/productIv"
            app:layout_constraintTop_toTopOf="@+id/productIv"/>
        <TextView
            android:id="@+id/hoursView"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/secondsView"
            app:layout_constraintEnd_toStartOf="@+id/minutesView"
            app:layout_constraintTop_toTopOf="@+id/secondsView"
            style="@style/FlashSaleTimerText"/>
        <TextView
            android:id="@+id/minutesView"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/secondsView"
            app:layout_constraintEnd_toStartOf="@+id/secondsView"
            app:layout_constraintTop_toTopOf="@+id/secondsView"
            style="@style/FlashSaleTimerText"/>
        <TextView
            android:id="@+id/secondsView"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FlashSaleTimerText"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/dateTAV"
            android:layout_width="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FlashSaleTimerText"/>
        <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
            android:id="@+id/productPricePV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/productIv"/>
        <ru.ozon.uni.android.uikit.view.atoms.rating.RatingView
            android:id="@+id/productRatingRV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/productPricePV"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/productsRV"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/productRatingRV"/>
        <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
            android:id="@+id/showAllSBV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"/>
        <ru.ozon.app.android.atoms.v3.holders.switchingButton.SwitchingButtonView
            android:id="@+id/notifySBV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
