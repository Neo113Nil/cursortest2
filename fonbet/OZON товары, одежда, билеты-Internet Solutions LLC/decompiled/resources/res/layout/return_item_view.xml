<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/returnCreationProductCl"
    android:background="@color/layer_floor_1"
    android:paddingTop="@dimen/dimen_10"
    android:paddingBottom="@dimen/dimen_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dimen_16">
    <ru.ozon.uni.android.atom.selectionControls.CheckBoxView
        android:id="@+id/checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/productIconView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/productIconView"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/productIconView"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintStart_toEndOf="@+id/checkbox"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/dimen_8"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/blurIconView"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/productIconView"
        app:layout_constraintEnd_toEndOf="@+id/productIconView"
        app:layout_constraintStart_toStartOf="@+id/productIconView"
        app:layout_constraintTop_toTopOf="@+id/productIconView"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/privateIconView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/blurIconView"
        app:layout_constraintEnd_toEndOf="@+id/blurIconView"
        app:layout_constraintStart_toStartOf="@+id/blurIconView"
        app:layout_constraintTop_toTopOf="@+id/blurIconView"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="vertical"
        android:id="@+id/imageBarrier"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:barrierMargin="@dimen/dimen_12"
        app:constraint_referenced_ids="productIconView, blurIconView"/>
    <ru.ozon.uni.android.atom.price.ui.PriceAtomView
        android:id="@+id/priceView"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toTopOf="@+id/productIconView"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/nameTv"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/priceView"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/badgeBv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/nameTv"/>
    <View
        android:id="@+id/checkBoxClickArea"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:id="@+id/quantityDecrease"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        app:layout_constraintStart_toStartOf="@+id/imageBarrier"
        app:layout_constraintTop_toBottomOf="@+id/badgeBv"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/quantityText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="@+id/quantityDecrease"
        app:layout_constraintStart_toEndOf="@+id/quantityDecrease"
        app:layout_constraintTop_toTopOf="@+id/quantityDecrease"/>
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:id="@+id/quantityIncrease"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="@+id/quantityDecrease"
        app:layout_constraintStart_toEndOf="@+id/quantityText"
        app:layout_constraintTop_toBottomOf="@+id/badgeBv"
        app:layout_constraintTop_toTopOf="@+id/quantityDecrease"/>
</androidx.constraintlayout.widget.ConstraintLayout>
