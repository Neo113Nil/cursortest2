<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:id="@+id/titleTv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rangeFromLl"
        android:background="@drawable/bg_atom_filter_range"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/rangeToLl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTv">
        <TextView
            android:textAppearance="@style/TextStyle.Body.L.Gray60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rangefilter_from_value_atom_range_filter"
            android:layout_marginEnd="4dp"/>
        <EditText
            android:textAppearance="@style/TextStyle.Body.L"
            android:id="@+id/rangeFromEt"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:imeOptions="actionDone"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.L.Gray60"
            android:id="@+id/rangeFromUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rangeToLl"
        android:background="@drawable/bg_atom_filter_range"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rangeFromLl"
        app:layout_constraintTop_toBottomOf="@+id/titleTv">
        <TextView
            android:textAppearance="@style/TextStyle.Body.L.Gray60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rangefilter_to_value_atom_range_filter"
            android:layout_marginEnd="4dp"/>
        <EditText
            android:textAppearance="@style/TextStyle.Body.L"
            android:id="@+id/rangeToEt"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:imeOptions="actionDone"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.L.Gray60"
            android:id="@+id/rangeToUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
        android:id="@+id/rangeSeekbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:bar_color="?attr/layerSurface"
        app:bar_highlight_color="?attr/bgActionSecondary"
        app:data_type="_integer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rangeFromLl"/>
</merge>
