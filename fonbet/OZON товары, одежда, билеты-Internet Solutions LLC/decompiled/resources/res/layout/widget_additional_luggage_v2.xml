<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/additionalLuggageV2FlightsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="top"
        android:id="@+id/additionalLuggageV2AppBarRoot"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@animator/elevation_animator"
        android:paddingHorizontal="16dp">
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/additionalLuggageV2TitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/additionalLuggageV2TabsRecyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/additionalLuggageV2TitleTextView"/>
        <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
            android:id="@+id/shimmer1"
            android:layout_width="0dp"
            android:layout_height="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rsvCornersRadius="6dp"/>
        <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
            android:id="@+id/shimmer2"
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shimmer1"
            app:rsvCornersRadius="6dp"/>
        <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
            android:id="@+id/shimmer3"
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/shimmer2"
            app:layout_constraintTop_toBottomOf="@+id/shimmer1"
            app:rsvCornersRadius="6dp"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/shimmerGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="shimmer1,shimmer2,shimmer3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/additionalLuggageV2ActionPaneRoot"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.LargeButtonView
            android:id="@+id/additionalLuggageV2SaveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/additionalLuggageV2LuggageLabelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
            android:id="@+id/additionalLuggageV2InfoButton"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/additionalLuggageV2SaveButton"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/additionalLuggageV2LuggageLabelTextView"
            app:layout_constraintTop_toTopOf="@+id/additionalLuggageV2LuggageLabelTextView"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/additionalLuggageV2Barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="additionalLuggageV2LuggageLabelTextView,additionalLuggageV2InfoButton"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/TextStyle.Body.XL.Bold"
            android:id="@+id/additionalLuggageV2LuggagePriceTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/additionalLuggageV2SaveButton"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/additionalLuggageV2Barrier"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
