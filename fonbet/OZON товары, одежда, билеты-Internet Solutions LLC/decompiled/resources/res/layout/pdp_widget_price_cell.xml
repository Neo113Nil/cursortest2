<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainerCl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp">
    <ImageView
        android:id="@+id/priceCellIconIv"
        android:background="@drawable/bg_pdp_cell_icon_background"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/priceCellTitleTav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/priceCellSubtitleTav"
        app:layout_constraintEnd_toStartOf="@+id/priceCounterBadge"
        app:layout_constraintStart_toEndOf="@+id/priceCellIconIv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="12dp"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/priceCellSubtitleTav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/priceCounterBadge"
        app:layout_constraintStart_toEndOf="@+id/priceCellIconIv"
        app:layout_constraintTop_toBottomOf="@+id/priceCellTitleTav"/>
    <ImageView
        android:id="@+id/priceCellDisclosureIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_s_chevron_right_filled"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/priceCounterBadgeLabelsBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="priceCellTitleTav,priceCellSubtitleTav"/>
    <ru.ozon.app.android.pdp.widgets.priceBlock.priceCell.presentation.PriceCounterBadgeView
        android:id="@+id/priceCounterBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/priceCellDisclosureIv"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/priceCounterBadgeLabelsBarrier"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="96dp"
        app:layout_goneMarginEnd="12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
