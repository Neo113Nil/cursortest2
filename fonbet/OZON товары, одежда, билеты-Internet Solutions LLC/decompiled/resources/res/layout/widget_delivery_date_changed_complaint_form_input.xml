<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout
        android:textColorHint="@color/text_secondary"
        android:id="@+id/commentTil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="24dp"
        app:hintTextAppearance="@style/OzonTextAppearance.Body.500medium"
        app:mtil_isMultiline="true">
        <com.google.android.material.textfield.TextInputEditText
            android:textAppearance="@style/OzonTextAppearance.Body.500medium"
            android:id="@+id/commentTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="77dp"
            android:maxLength="255"
            android:inputType="textMultiLine"
            style="@style/OzTextInput.EditText"/>
    </ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/OzonTextAppearance.Body.400small"
        android:textColor="@color/bg_accent_primary"
        android:id="@+id/commentErrorTv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="28dp"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/submitBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:layout_marginBottom="25dp"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
