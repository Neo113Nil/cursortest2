<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_vertical">
    <TextView
        android:textColor="?attr/oz_semantic_text_secondary"
        android:ellipsize="end"
        android:id="@+id/textTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        style="@style/TextStyle.Caption"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/multilineBadgeImage"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_weight="0"
        android:layout_marginEnd="12dp"/>
</merge>
