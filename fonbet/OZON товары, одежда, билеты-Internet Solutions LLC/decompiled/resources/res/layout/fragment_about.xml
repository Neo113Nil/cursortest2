<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/layerFloor1"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:orientation="vertical"
        android:id="@+id/toolbar"
        android:background="?attr/layerFloor1"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back_black"
        style="@style/Widget.MyApp.ToolBar"/>
    <ViewStub
        android:id="@+id/toolbarSelect"
        android:layout="@layout/view_stub_about_toolbar_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingEnd="@dimen/activity_horizontal_margin">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/about_logo_content_description_android"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.M"
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="76dp"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.M"
            android:id="@+id/userId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.M"
            android:gravity="center"
            android:id="@+id/copyrightRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.M"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/legalName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin"
            android:text="@string/about_company_legal_name_android"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.M"
            android:gravity="center"
            android:id="@+id/versionMoreInfo"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.M"
            android:gravity="center"
            android:id="@+id/commitHashTv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin"/>
        <Button
            android:layout_gravity="center_horizontal"
            android:id="@+id/license"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/about_button_open_license_android"
            android:textAllCaps="false"
            android:paddingStart="@dimen/default_padding"
            android:paddingEnd="@dimen/default_padding"
            style="@style/SmallBorderlessButton"/>
        <Button
            android:layout_gravity="center_horizontal"
            android:id="@+id/personalData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin"
            android:text="@string/about_button_open_personal_data_conditions_android"
            android:textAllCaps="false"
            android:paddingStart="@dimen/default_padding"
            android:paddingEnd="@dimen/default_padding"
            style="@style/SmallBorderlessButton"/>
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</androidx.appcompat.widget.LinearLayoutCompat>
