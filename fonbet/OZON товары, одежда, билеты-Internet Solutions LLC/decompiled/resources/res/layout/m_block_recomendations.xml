<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recommendationsContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dimen_12">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/recommendationTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/recommendationBadgeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/recommendationSubTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/recommendationBadgeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommendationTitle"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/recommendationBadgeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/recommendationTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/recommendationTitle"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/recommendationBadgeList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        app:dividerDrawableHorizontal="@drawable/m_chat_badge_divider_vertical"
        app:dividerDrawableVertical="@drawable/m_chat_badge_divider"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommendationSubTitle"
        app:showDividerHorizontal="middle"
        app:showDividerVertical="middle"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/productContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        app:divider="@drawable/m_inset_chats_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommendationBadgeList"
        app:showDividers="middle"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption"
        android:textColor="@color/text_secondary"
        android:id="@+id/sendTimeTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productContainer"
        app:layout_goneMarginEnd="12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
