<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.cell.CellView
        android:id="@+id/checkLegalInfoCompanyCell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/checkLegalInfoKppTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/checkLegalInfoKppDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.cell.text.TextFieldCellView
        android:id="@+id/checkLegalInfoKppInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_20"
        android:layout_marginHorizontal="@dimen/dimen_16"/>
    <include
        android:id="@+id/bannerEdoCompact"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_16"
        android:layout_marginHorizontal="@dimen/dimen_16"
        layout="@layout/banner_edo_compact"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/checkLegalInfoBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_16"
        android:layout_marginHorizontal="@dimen/dimen_16"/>
</LinearLayout>
