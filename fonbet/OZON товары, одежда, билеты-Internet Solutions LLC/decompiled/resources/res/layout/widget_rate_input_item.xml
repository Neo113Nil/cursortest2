<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.textfield.TextInputLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rateInputTil"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="28dp"
    android:minHeight="48dp"
    android:layout_marginHorizontal="16dp"
    app:boxStrokeErrorColor="?attr/bgAccentPrimary"
    app:boxStrokeWidth="0dp"
    app:counterEnabled="false"
    app:hintTextAppearance="@style/TextStyle.Caption"
    style="@style/OzTextInput.Layout">
    <com.google.android.material.textfield.TextInputEditText
        android:gravity="start|top"
        android:id="@+id/rateInputEt"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:scrollHorizontally="false"
        app:textInputLayoutFocusedRectEnabled="true"
        style="@style/OzTextInput.EditText"/>
</com.google.android.material.textfield.TextInputLayout>
