<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainIv"
    android:layout_width="@dimen/photo_widget_size"
    android:layout_height="@dimen/photo_widget_size">
    <ru.ozon.app.android.ugc.core.widgets.common.StatusableMediaPreviewView
        android:id="@+id/photoPv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/iconIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_l_gallery_play"
        app:tint="?attr/bgLightKey"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/TextStyle.Head.M"
        android:textColor="?attr/textLightKey"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/showMoreTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</FrameLayout>
