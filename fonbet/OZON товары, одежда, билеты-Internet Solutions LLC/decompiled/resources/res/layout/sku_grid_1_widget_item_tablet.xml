<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootLl"
    android:background="?attr/oz_semantic_bg_secondary"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/fg_sku_ripple"
    android:paddingStart="4dp"
    android:paddingEnd="36dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/skuGrid1Guildline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <ru.ozon.app.android.universalwidgets.widgets.uw.sku.SkuImageWrapper
            android:id="@+id/adultIv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/skuGrid1Guildline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/overlayImage"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="center"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintDimensionRatio="3:2"
            app:layout_constraintEnd_toStartOf="@+id/skuGrid1Guildline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.ozon.app.android.product.common.overlaytitle.OverlayTitleView
            android:id="@+id/overlayTitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/adultIv"
            app:layout_constraintEnd_toEndOf="@+id/adultIv"
            app:layout_constraintStart_toStartOf="@+id/adultIv"/>
        <ru.ozon.app.android.product.common.wave.WaveView
            android:id="@+id/waveView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/adultIv"
            app:layout_constraintEnd_toEndOf="@+id/adultIv"
            app:layout_constraintStart_toStartOf="@+id/adultIv"/>
        <ru.ozon.app.android.universalwidgets.widgets.uw.badgescontainer.BadgesContainerView
            android:id="@+id/badgesContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/adultIv"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintLeft_toLeftOf="@+id/adultIv"
            app:layout_constraintRight_toRightOf="@+id/adultIv"
            app:layout_constraintVertical_bias="0"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/topRightButtonsRV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toStartOf="@+id/skuGrid1Guildline"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/stateVal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/skuGrid1Guildline"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/stateVal"
            app:layout_constraintEnd_toEndOf="@+id/stateVal"
            app:layout_constraintStart_toStartOf="@+id/stateVal"
            app:layout_constraintTop_toTopOf="@+id/stateVal"
            app:layout_constraintWidth_default="wrap"/>
        <ru.ozon.uni.atoms.v3.containers.SingleAtom
            android:id="@+id/productSa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/skuGrid1Guildline"
            app:layout_constraintTop_toBottomOf="@+id/stateVal"/>
        <ru.ozon.app.android.uikit.view.atoms.texts.TextAtomWithIconView
            android:id="@+id/buttonSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/skuGrid1Guildline"
            app:layout_constraintTop_toBottomOf="@+id/productSa"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
