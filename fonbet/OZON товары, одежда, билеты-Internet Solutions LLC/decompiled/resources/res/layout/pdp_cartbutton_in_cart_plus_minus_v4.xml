<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/inCartLl"
    android:background="@drawable/bg_cartbutton_quantity"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginStart="8dp">
    <ImageButton
        android:id="@+id/minusIb"
        android:background="@null"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ic_m_minus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="?attr/bgActionPrimary"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/quantityTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="30dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/plusIb"
        app:layout_constraintStart_toEndOf="@+id/minusIb"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/plusIb"
        android:background="@null"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ic_m_plus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/quantityTav"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/bgActionPrimary"/>
</androidx.appcompat.widget.LinearLayoutCompat>
