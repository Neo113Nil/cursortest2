<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Head.M"
        android:gravity="center"
        android:id="@+id/titleTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:gravity="center"
        android:id="@+id/descriptionTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/logoIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/oz_semantic_bg_primary"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/TextStyle.Body.L.Bold"
            android:id="@+id/periodTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/maxValueTv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/TextStyle.Body.M"
            android:id="@+id/periodHintTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="@+id/periodTv"
            app:layout_constraintStart_toStartOf="@+id/periodTv"
            app:layout_constraintTop_toBottomOf="@+id/periodTv"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/TextStyle.Body.L.Bold"
            android:id="@+id/maxValueTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/periodTv"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/TextStyle.Body.M"
            android:id="@+id/maxValueHintTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="@+id/maxValueTv"
            app:layout_constraintStart_toStartOf="@+id/maxValueTv"
            app:layout_constraintTop_toBottomOf="@+id/maxValueTv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
