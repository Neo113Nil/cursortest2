<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fieldBackgroundFl"
        android:background="@drawable/fake_field_background_round_corners"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="@drawable/ripple_rect_bluewave"
        app:layout_constraintBottom_toBottomOf="@+id/errorSeparatorV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/startGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="12dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/endGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="12dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Secondary"
        android:textSize="12sp"
        android:id="@+id/hintTv"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/pickerIv"
        app:layout_constraintStart_toStartOf="@+id/startGuideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:ellipsize="end"
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/errorSeparatorV"
        app:layout_constraintEnd_toStartOf="@+id/pickerIv"
        app:layout_constraintStart_toStartOf="@+id/startGuideline"
        app:layout_constraintTop_toBottomOf="@+id/hintTv"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/pickerIv"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_picker"
        app:layout_constraintBottom_toTopOf="@+id/errorSeparatorV"
        app:layout_constraintEnd_toEndOf="@+id/endGuideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/errorSeparatorV"
        android:background="@color/oz_semantic_accent_alert"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/margin"
        app:layout_constraintBottom_toTopOf="@+id/errorTv"
        app:layout_constraintEnd_toEndOf="@+id/endGuideline"
        app:layout_constraintStart_toStartOf="@+id/startGuideline"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Red"
        android:ellipsize="end"
        android:layout_gravity="bottom"
        android:id="@+id/errorTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pickerIv"
        app:layout_constraintStart_toStartOf="@+id/startGuideline"
        app:layout_constraintTop_toBottomOf="@+id/errorSeparatorV"/>
</androidx.constraintlayout.widget.ConstraintLayout>
