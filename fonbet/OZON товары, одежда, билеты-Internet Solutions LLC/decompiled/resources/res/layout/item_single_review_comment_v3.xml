<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/commentCl"
        android:background="?attr/layerFloor1"
        android:paddingBottom="@dimen/dimen_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4">
        <View
            android:id="@+id/separatorView"
            android:background="@color/bg_overlap"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="@dimen/dimen_1"
            android:layout_marginHorizontal="@dimen/dimen_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ru.ozon.uni.android.cell.CellView
            android:id="@+id/socialHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/separatorView"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:textAppearance="@style/TextStyle.Body.M"
            android:id="@+id/commentTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/socialHeader"/>
        <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
            android:textAppearance="@style/TextStyle.Body.M.Blue"
            android:id="@+id/answerBtn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/commentTv"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:ellipsize="end"
            android:id="@+id/dateTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/dimen_8"
            app:layout_constraintBottom_toBottomOf="@+id/deleteBtn"
            app:layout_constraintEnd_toStartOf="@+id/deleteBtn"
            app:layout_constraintTop_toTopOf="@+id/deleteBtn"/>
        <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
            android:id="@+id/deleteBtn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/reportBtn"
            app:layout_constraintTop_toBottomOf="@+id/commentTv"/>
        <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
            android:id="@+id/reportBtn"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/reportedBtn"
            app:layout_constraintTop_toBottomOf="@+id/commentTv"/>
        <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
            android:id="@+id/reportedBtn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/commentTv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
