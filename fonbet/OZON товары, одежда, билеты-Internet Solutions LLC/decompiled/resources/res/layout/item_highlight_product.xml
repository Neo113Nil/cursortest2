<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/highlightProductContainer"
    android:layout_width="72dp"
    android:layout_height="72dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/highlightProductImage"
        android:padding="2dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:elevation="0dp"
        android:outlineProvider="background"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlayAppCornerSize"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/highlightIcon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="22dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@null"
        android:layout_marginEnd="4dp"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="end|top"
        android:id="@+id/highlightProductBadgeContainer"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:cardCornerRadius="12dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/highlightProductBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"/>
    </androidx.cardview.widget.CardView>
</FrameLayout>
