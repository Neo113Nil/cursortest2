<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/TextStyle.Head.XL"
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_40"
        android:layout_marginHorizontal="@dimen/default_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Body.500medium"
        android:textColor="?attr/textSecondary"
        android:gravity="center_vertical"
        android:id="@+id/subtitleTv"
        android:paddingBottom="@dimen/regular_margin_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginHorizontal="@dimen/default_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"/>
    <ru.ozon.uni.android.input.textinput.ui.OzonTextInputLayout
        android:id="@+id/hintIl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_margin"
        android:layout_marginStart="@dimen/default_margin"
        android:layout_marginEnd="@dimen/default_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTv"/>
    <TextView
        android:textColor="@color/text_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/captionTv"
        android:paddingBottom="@dimen/dimen_4"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:layout_marginStart="@dimen/default_margin"
        app:layout_constraintEnd_toEndOf="@+id/hintIl"
        app:layout_constraintStart_toStartOf="@+id/hintIl"
        app:layout_constraintTop_toBottomOf="@+id/hintIl"
        style="@style/OzonTextAppearance.Body.300xsmall"/>
    <TextView
        android:textColor="@color/oz_semantic_text_negative"
        android:gravity="start|center_vertical"
        android:id="@+id/errorTv"
        android:paddingBottom="@dimen/dimen_4"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:layout_marginStart="@dimen/default_margin"
        app:layout_constraintEnd_toEndOf="@+id/hintIl"
        app:layout_constraintStart_toStartOf="@+id/hintIl"
        app:layout_constraintTop_toBottomOf="@+id/hintIl"
        style="@style/OzonTextAppearance.Body.300xsmall"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomInputs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="hintIl, errorTv, subtitleTv, captionTv"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/confirmBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_margin"
        android:layout_marginHorizontal="@dimen/default_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomInputs"
        app:layout_goneMarginTop="@dimen/default_margin"
        style="@style/Button.ActionPrimary"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/secondaryBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginStart="@dimen/default_margin"
        android:layout_marginEnd="@dimen/default_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirmBtn"
        app:layout_goneMarginTop="32dp"
        style="@style/Button.AccentSecondary"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Blue"
        android:id="@+id/noAvailable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/default_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginTop="32dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
