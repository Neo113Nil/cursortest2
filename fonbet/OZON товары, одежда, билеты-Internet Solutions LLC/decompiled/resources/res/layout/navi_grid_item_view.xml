<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pairItemCL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/itemBgView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="@+id/itemImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/itemImage"/>
    <ru.ozon.uni.android.atom.image.Image
        android:id="@+id/itemImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/itemBgView"
        app:layout_constraintStart_toStartOf="@+id/itemBgView"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/itemTitleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6"
        app:layout_constraintEnd_toEndOf="@+id/itemBgView"
        app:layout_constraintStart_toStartOf="@+id/itemBgView"
        app:layout_constraintTop_toBottomOf="@+id/itemImage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
