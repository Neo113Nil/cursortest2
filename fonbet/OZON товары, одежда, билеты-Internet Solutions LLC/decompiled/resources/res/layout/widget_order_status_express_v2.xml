<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/oz_semantic_bg_secondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.uikit.view.atoms.buttons.borderless.SmallBorderlessButtonView
        android:id="@+id/orderNumberBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/paymentWarningGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="paymentWarningTopSpace, paymentWarningBackground,          warningIv, warningTitle, warningSubtitle, paymentWarningBottomSpace"/>
    <Space
        android:id="@+id/paymentWarningTopSpace"
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderNumberBtn"/>
    <View
        android:id="@+id/paymentWarningBackground"
        android:background="@drawable/bg_all_corners_rounded_notification_warning"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/default_margin"
        app:layout_constraintBottom_toBottomOf="@+id/paymentWarningBottomSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/paymentWarningTopSpace"/>
    <ImageView
        android:id="@+id/warningIv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_danger_red_express"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/paymentWarningBackground"
        app:layout_constraintTop_toBottomOf="@+id/paymentWarningTopSpace"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/warningTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/paymentWarningBackground"
        app:layout_constraintStart_toEndOf="@+id/warningIv"
        app:layout_constraintTop_toBottomOf="@+id/paymentWarningTopSpace"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/warningSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/paymentWarningBackground"
        app:layout_constraintStart_toStartOf="@+id/warningTitle"
        app:layout_constraintTop_toBottomOf="@+id/warningTitle"/>
    <Space
        android:id="@+id/paymentWarningBottomSpace"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/warningSubtitle"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/deliveryInfoText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="@dimen/default_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/paymentWarningBottomSpace"
        app:layout_goneMarginTop="8dp"
        style="@style/TextStyle.Head.M"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/deliveryInfoSubText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/default_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deliveryInfoText"
        style="@style/TextStyle.Head.M"/>
    <ImageView
        android:id="@+id/orderCreatedIv"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toStartOf="@+id/horizontalSeparator"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deliveryInfoSubText"/>
    <ImageView
        android:id="@+id/horizontalSeparator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_order_delivery_info_line"
        app:layout_constraintBottom_toBottomOf="@+id/orderCollectIv"
        app:layout_constraintEnd_toStartOf="@+id/orderCollectIv"
        app:layout_constraintStart_toEndOf="@+id/orderCreatedIv"
        app:layout_constraintTop_toTopOf="@+id/orderCreatedIv"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:id="@+id/orderCreatedTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="@+id/orderCreatedIv"
        app:layout_constraintStart_toStartOf="@+id/orderCreatedIv"
        app:layout_constraintTop_toBottomOf="@+id/orderCreatedIv"/>
    <ImageView
        android:id="@+id/orderCollectIv"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toStartOf="@+id/horizontalSeparator2"
        app:layout_constraintStart_toEndOf="@+id/horizontalSeparator"
        app:layout_constraintTop_toBottomOf="@+id/deliveryInfoSubText"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:id="@+id/orderCollectTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="@+id/orderCollectIv"
        app:layout_constraintStart_toStartOf="@+id/orderCollectIv"
        app:layout_constraintTop_toBottomOf="@+id/orderCollectIv"/>
    <ImageView
        android:id="@+id/horizontalSeparator2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_order_delivery_info_line"
        app:layout_constraintBottom_toBottomOf="@+id/orderCollectIv"
        app:layout_constraintEnd_toStartOf="@+id/orderOnWayIv"
        app:layout_constraintStart_toEndOf="@+id/orderCollectIv"
        app:layout_constraintTop_toTopOf="@+id/orderCreatedIv"/>
    <ImageView
        android:id="@+id/orderOnWayIv"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toStartOf="@+id/horizontalSeparator3"
        app:layout_constraintStart_toEndOf="@+id/horizontalSeparator2"
        app:layout_constraintTop_toBottomOf="@+id/deliveryInfoSubText"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:id="@+id/orderOnWayTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="@+id/orderOnWayIv"
        app:layout_constraintStart_toStartOf="@+id/orderOnWayIv"
        app:layout_constraintTop_toBottomOf="@+id/orderOnWayIv"/>
    <ImageView
        android:id="@+id/horizontalSeparator3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_order_delivery_info_line"
        app:layout_constraintBottom_toBottomOf="@+id/orderCollectIv"
        app:layout_constraintEnd_toStartOf="@+id/orderReceivedIv"
        app:layout_constraintStart_toEndOf="@+id/orderOnWayIv"
        app:layout_constraintTop_toTopOf="@+id/orderCreatedIv"/>
    <ImageView
        android:id="@+id/orderReceivedIv"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/horizontalSeparator3"
        app:layout_constraintTop_toBottomOf="@+id/deliveryInfoSubText"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:id="@+id/orderReceivedTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="@+id/orderReceivedIv"
        app:layout_constraintStart_toStartOf="@+id/orderReceivedIv"
        app:layout_constraintTop_toBottomOf="@+id/orderReceivedIv"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/orderStatusBadge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deliveryInfoSubText"/>
    <View
        android:id="@+id/courierWarningBackground"
        android:background="@drawable/bg_order_status_courier_warning"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/courierWarningBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/orderStatusesBarrier"/>
    <ImageView
        android:id="@+id/courierWarningIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/courierWarningBackground"
        app:layout_constraintTop_toTopOf="@+id/courierWarningText"
        app:srcCompat="@drawable/ic_m_bell"
        app:tint="?attr/oz_semantic_text_tetriary"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/courierWarningText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/courierWarningBackground"
        app:layout_constraintEnd_toEndOf="@+id/courierWarningBackground"
        app:layout_constraintStart_toEndOf="@+id/courierWarningIcon"
        app:layout_constraintTop_toTopOf="@+id/courierWarningBackground"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/courierWarningGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="courierWarningBackground,             courierWarningBarrier, courierWarningIcon, courierWarningText"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/courierWarningBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="courierWarningText"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/orderStatusGroup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="orderCreatedIv, horizontalSeparator, orderCollectIv,          horizontalSeparator2, orderOnWayIv, horizontalSeparator3, orderReceivedIv, orderReceivedIv"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/orderStatusesBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="orderReceivedTv, orderOnWayTv, orderCollectTv, orderCreatedTv, orderStatusBadge"/>
</androidx.constraintlayout.widget.ConstraintLayout>
