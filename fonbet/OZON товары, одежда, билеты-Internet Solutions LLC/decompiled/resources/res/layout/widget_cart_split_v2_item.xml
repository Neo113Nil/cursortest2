<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splitV2ItemRootCl"
    android:background="?attr/layerFloor1"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/checkboxContainerFL"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center"
            android:id="@+id/checkboxV"
            android:background="@drawable/selector_checkbox"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </FrameLayout>
    <include
        android:id="@+id/productInclude"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/checkboxContainerFL"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="12dp"
        layout="@layout/item_common_product"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dynamicElementsRv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productInclude"/>
    <ru.ozon.app.android.favorites.ui.favoritebutton.favoriteproduct.ui.buttonview.ProductFavoriteMoleculeButtonView
        android:id="@+id/favBtn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/margin_medium_small"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dynamicElementsRv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/removeButton"
        android:background="@drawable/bg_small_icon_button_parandja"
        android:padding="@dimen/dimen_8"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/margin_medium_small"
        android:src="@drawable/ic_s_trash_bin_filled"
        android:scaleType="center"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintStart_toEndOf="@+id/favBtn"
        app:layout_constraintTop_toBottomOf="@+id/dynamicElementsRv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/decreaseQuantityBtn"
        android:background="@drawable/o2_button_icon_small_secondary"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/quantityEt"
        app:layout_constraintTop_toTopOf="@+id/quantityEt"
        app:srcCompat="@drawable/ic_s_minus"
        app:tint="@color/o2_selector_color_text_for_button_tertiary"/>
    <ru.ozon.app.android.cart.ui.quantityInput.QuantityInput
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:gravity="center"
        android:id="@+id/quantityEt"
        android:background="@drawable/bg_quantity_input_selector"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minWidth="42dp"
        android:selectAllOnFocus="true"
        android:maxLength="4"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toStartOf="@+id/increaseQuantityBtn"
        app:layout_constraintTop_toTopOf="@+id/increaseQuantityBtn"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/increaseQuantityBtn"
        android:background="@drawable/o2_button_icon_small_secondary"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="@dimen/margin_medium_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dynamicElementsRv"
        app:srcCompat="@drawable/ic_s_plus"
        app:tint="@color/o2_selector_color_text_for_button_tertiary"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/quantityGroup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="decreaseQuantityBtn,quantityEt,increaseQuantityBtn"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="favBtn,removeButton,decreaseQuantityBtn,quantityEt,increaseQuantityBtn"/>
    <ViewStub
        android:id="@+id/accessoriesViewStub"
        android:layout="@layout/widget_cart_split_v2_item_accessories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomBarrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
