<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="1dp">
    <ImageView
        android:id="@+id/iconIv"
        android:layout_width="56dp"
        android:layout_height="106dp"
        android:scaleType="fitXY"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Head.M"
        android:textColor="@color/bg_light_key"
        android:gravity="center"
        android:id="@+id/clusterCountTv"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginBottom="24dp"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/badgeV"
        android:background="@drawable/pin_badge_shape"
        android:visibility="visible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toTopOf="@+id/badgeSpace"
        app:layout_constraintEnd_toStartOf="@+id/badgeSpace"
        app:layout_constraintStart_toStartOf="@+id/badgeSpace"
        app:layout_constraintTop_toBottomOf="@+id/badgeSpace"/>
    <Space
        android:id="@+id/badgeSpace"
        android:layout_width="7dp"
        android:layout_height="7dp"
        app:layout_constraintEnd_toEndOf="@+id/iconIv"
        app:layout_constraintTop_toTopOf="@+id/iconIv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
