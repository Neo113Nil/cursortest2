<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/containerCard"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <TextView
        android:textAppearance="@style/TextStyle.Caption.Bold"
        android:textColor="?attr/oz_semantic_text_secondary"
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:drawableEndCompat="@drawable/ic_s_chevron_right"
        app:drawableTint="?attr/oz_semantic_separator"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceWithPointsView
        android:id="@+id/priceWithPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
