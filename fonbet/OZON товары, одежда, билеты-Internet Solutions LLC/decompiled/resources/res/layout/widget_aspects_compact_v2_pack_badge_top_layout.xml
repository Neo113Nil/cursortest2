<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.pdp.ui.configurators.aspectsCompactV2.VariantConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/dimen_8">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/infoFl"
        android:background="@drawable/bg_aspects_pack_selectable"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="@dimen/dimen_56"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="@dimen/dimen_104">
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:gravity="center"
            android:id="@+id/titleTav"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="256dp"
            app:layout_constrainedWidth="true"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:gravity="center"
            android:id="@+id/subtitleTav"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="256dp"
            android:minWidth="72dp"
            app:layout_constrainedWidth="true"/>
    </LinearLayout>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/layer"
        android:background="@drawable/bg_aspects_v2_top_badge_bg"
        android:padding="@dimen/dimen_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="badgeV"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/badgeV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_2"
        android:layout_marginHorizontal="@dimen/dimen_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</ru.ozon.app.android.pdp.ui.configurators.aspectsCompactV2.VariantConstraintLayout>
