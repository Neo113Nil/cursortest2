<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonAviaLogo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:spvCornerRadius="12dp"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonDepartureHour"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/skeletonAviaLogo"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonArrivalHour"
        android:layout_width="100dp"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/skeletonDepartureHour"
        app:layout_constraintTop_toBottomOf="@+id/skeletonDepartureHour"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonDuration"
        android:layout_width="50dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/skeletonDepartureHour"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/skeletonTransfer"
        android:layout_width="50dp"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonDuration"/>
</merge>
