<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.image.Image
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/titleTav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"/>
    <ru.ozon.uni.atoms.af.layout.VerticalAtomsLayout
        android:id="@+id/atomsVal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ru.ozon.app.android.atoms.af.layout.HorizontalAtomsLayout
        android:id="@+id/buttonsHal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"/>
</LinearLayout>
