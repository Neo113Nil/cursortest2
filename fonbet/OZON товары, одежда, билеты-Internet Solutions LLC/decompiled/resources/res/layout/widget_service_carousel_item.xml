<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dimen_108"
    android:layout_height="@dimen/dimen_112"
    android:layout_marginStart="@dimen/dimen_4"
    android:layout_marginEnd="@dimen/dimen_4">
    <androidx.cardview.widget.CardView
        android:id="@+id/root"
        android:layout_width="@dimen/dimen_108"
        android:layout_height="@dimen/dimen_108"
        android:layout_marginTop="@dimen/dimen_4"
        app:cardBackgroundColor="?attr/oz_semantic_ctrl_neutral_pale"
        app:cardCornerRadius="@dimen/dimen_16"
        app:cardElevation="@dimen/dimen_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rippleColor="@android:color/transparent"/>
    <View
        android:id="@+id/imageBackground"
        android:background="@drawable/bg_rounded_both_12"
        android:layout_width="@dimen/dimen_40"
        android:layout_height="@dimen/dimen_40"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/root"/>
    <ImageView
        android:id="@+id/imageIv"
        android:background="@drawable/bg_rounded_both_12"
        android:layout_width="@dimen/dimen_40"
        android:layout_height="@dimen/dimen_40"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/root"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageIv"
        app:layout_constraintVertical_bias="0"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/root"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Caption.Bold"
        android:textColor="@color/text_action"
        android:id="@+id/tvNewBadge"
        android:background="@drawable/bg_service_carousel_new"
        android:paddingTop="@dimen/dimen_2"
        android:paddingBottom="@dimen/dimen_3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/service_carousel_item_new_text"
        android:paddingHorizontal="@dimen/dimen_8"
        app:layout_constraintEnd_toEndOf="@+id/root"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/root"
        app:layout_constraintTop_toTopOf="@+id/root"/>
</androidx.constraintlayout.widget.ConstraintLayout>
