<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/curtainGoalsIv"
        android:background="@drawable/bg_curtain_goals_parandja"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/curtainGoalsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="24dp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalsIv"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/curtainGoalsSingleBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalsTitle"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/curtainGoalDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalsSingleBadge"
        app:layout_goneMarginTop="0dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="curtainGoalsProgressBadge, curtainGoalsProgressTa"/>
    <View
        android:id="@+id/curtainGoalsProgressBg"
        android:background="@drawable/bg_curtain_goals_progress"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalDescription"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/curtainGoalsProgressTa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:elevation="1dp"
        app:layout_constraintStart_toStartOf="@+id/curtainGoalsProgressBg"
        app:layout_constraintTop_toTopOf="@+id/curtainGoalsProgressBg"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/curtainGoalsProgressBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/curtainGoalsProgressBg"
        app:layout_constraintTop_toTopOf="@+id/curtainGoalsProgressBg"/>
    <ProgressBar
        android:id="@+id/curtainGoalsProgress"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:max="100"
        android:progressDrawable="@drawable/shape_curtain_goals_progress"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/curtainGoalsProgressBg"
        app:layout_constraintEnd_toEndOf="@+id/curtainGoalsProgressBg"
        app:layout_constraintStart_toStartOf="@+id/curtainGoalsProgressBg"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.LargeButtonView
        android:id="@+id/curtainGoalsLargeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalsProgressBg"/>
    <ru.ozon.uni.android.controls.button.UncontainedButtonView
        android:id="@+id/curtainGoalsTermButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/curtainGoalsLargeButton"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/progressGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="curtainGoalsProgressTa, curtainGoalsProgressBadge, curtainGoalsProgress, curtainGoalsProgressBg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
