<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/spay_bottom_sheet_common_height"
    android:maxHeight="@dimen/spay_bottom_sheet_common_height"
    android:minHeight="@dimen/spay_bottom_sheet_common_height"
    android:transitionName="payTransition">
    <WebView
        android:id="@+id/spay_slpnavwv_wv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spay_4dp"
        android:layout_marginBottom="@dimen/spay_16dp"
        android:nestedScrollingEnabled="true"
        android:layout_marginHorizontal="@dimen/spay_12dp"
        app:layout_constraintBottom_toTopOf="@+id/spay_slpnavwv_mb_close_offer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/spay_slpnavpb_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="@+id/spay_slpnavwv_wv"
        app:layout_constraintEnd_toEndOf="@+id/spay_slpnavwv_wv"
        app:layout_constraintStart_toStartOf="@+id/spay_slpnavwv_wv"
        app:layout_constraintTop_toTopOf="@+id/spay_slpnavwv_wv"/>
    <spay.sdk.view.SPayTextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/spay_slpnavwv_actv_mock_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/spay_mock_web_auth"/>
    <spay.sdk.view.SPayMaterialButton
        android:id="@+id/spay_slpnavwv_mb_close_offer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/spay_56dp"
        android:layout_marginBottom="@dimen/spay_16dp"
        android:text="@string/spay_btn_label_back"
        android:layout_marginHorizontal="@dimen/spay_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="@dimen/spay_16dp"
        style="@style/SpayTransparentButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
