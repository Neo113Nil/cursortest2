<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userFinalRatingRoot"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <ru.ozon.uni.android.uikit.view.atoms.rating.VectorRatingBar
        android:id="@+id/usersFinalRatingRb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/usersGradesDividerDlv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rb_isIndicator="true"
        style="@style/RatingBarStyle.L"/>
    <ru.ozon.app.android.ugc.widgets.usersFinalRating.view.DashedLineView
        android:id="@+id/usersGradesDividerDlv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layerType="software"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/usersFinalRatingRb"
        app:layout_constraintEnd_toStartOf="@+id/usersFinalRatingIconSibv"
        app:layout_constraintStart_toEndOf="@+id/usersFinalRatingRb"
        app:layout_constraintTop_toTopOf="@+id/usersFinalRatingRb"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:id="@+id/usersFinalRatingIconSibv"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/usersFinalRatingRb"
        app:layout_constraintEnd_toStartOf="@+id/usersFinalRatingTitleTav"
        app:layout_constraintStart_toEndOf="@+id/usersGradesDividerDlv"
        app:layout_constraintTop_toTopOf="@+id/usersFinalRatingRb"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/usersFinalRatingTitleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/usersFinalRatingRb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/usersFinalRatingIconSibv"
        app:layout_constraintTop_toTopOf="@+id/usersFinalRatingRb"/>
</androidx.constraintlayout.widget.ConstraintLayout>
