<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.pdpvideomolecule.presentation.view.controlpanel.VideoMoleculeTimeBar
        android:id="@+id/exo_progress"
        android:paddingBottom="2dp"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:bar_gravity="bottom"
        app:bar_height="2dp"
        app:buffered_color="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:played_color="?attr/graphicLightKey"
        app:scrubbed_bar_height="4dp"
        app:scrubber_color="?attr/graphicLightKey"
        app:scrubber_dragged_size="8dp"
        app:scrubber_enabled_size="4dp"
        app:unplayed_color="?attr/textTertiaryOnDark"/>
    <FrameLayout
        android:id="@+id/pausePlayContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/exo_play"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_s_circle_play"
            app:tint="?attr/graphicLightKey"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/exo_pause"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_s_circle_pause"
            app:tint="?attr/graphicLightKey"/>
    </FrameLayout>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Body.300xsmall"
        android:textColor="?attr/graphicLightKey"
        android:id="@+id/exo_position"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/delimiter"
        app:layout_constraintEnd_toStartOf="@+id/delimiter"
        app:layout_constraintTop_toTopOf="@+id/delimiter"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Body.300xsmall"
        android:textColor="?attr/textTertiaryOnDark"
        android:id="@+id/delimiter"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:text="@string/pdp_video_molecule_control_panel_delimiter"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/pausePlayContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Body.300xsmall"
        android:textColor="?attr/textTertiaryOnDark"
        android:id="@+id/exo_duration"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/delimiter"
        app:layout_constraintStart_toEndOf="@+id/delimiter"
        app:layout_constraintTop_toTopOf="@+id/delimiter"/>
</androidx.constraintlayout.widget.ConstraintLayout>
