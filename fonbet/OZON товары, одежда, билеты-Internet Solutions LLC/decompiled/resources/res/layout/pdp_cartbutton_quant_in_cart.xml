<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.pdp.widgets.cartButtonQuant.button.CartButtonQuant
        android:id="@+id/mainBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/plusMinuSLl"
        android:background="@drawable/bg_cartbutton_quantity"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp">
        <ImageButton
            android:id="@+id/minusIb"
            android:background="@null"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_m_minus"
            app:tint="?attr/textAction"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/quantityTav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:maxLines="1"/>
        <ImageButton
            android:id="@+id/plusIb"
            android:background="@null"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_m_plus"
            app:tint="?attr/textAction"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</merge>
