<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.fresh.main.ui.SquircleConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="86dp"
    android:paddingStart="12dp"
    android:layout_marginEnd="8dp">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/titleTa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTa"
        app:layout_constraintEnd_toStartOf="@+id/imageIv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:ellipsize="end"
        android:id="@+id/subtitleTa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageIv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTa"/>
    <ImageView
        android:id="@+id/imageIv"
        android:layout_width="100dp"
        android:layout_height="86dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</ru.ozon.app.android.fresh.main.ui.SquircleConstraintLayout>
