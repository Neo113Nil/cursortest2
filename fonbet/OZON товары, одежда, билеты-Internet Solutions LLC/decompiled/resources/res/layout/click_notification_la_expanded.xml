<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/click_notification_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <ImageView
        android:id="@+id/notification_logo"
        android:layout_width="46dp"
        android:layout_height="24dp"
        android:src="@drawable/logo_ozon"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textAppearance="@style/LiveActivityText.Title.Expanded"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:layout_toLeftOf="@+id/image"
        android:layout_below="@+id/notification_logo"
        android:layout_alignParentLeft="true"/>
    <TextView
        android:textAppearance="@style/LiveActivityText.Click.Expanded.Subtitle"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/image"
        android:layout_below="@+id/title"
        android:layout_alignParentLeft="true"
        android:layout_marginEnd="12dp"/>
    <ImageView
        android:id="@+id/image"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:src="@drawable/click_image"
        android:scaleType="fitXY"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:elevation="1dp"/>
    <Button
        android:textAppearance="@style/LiveActivityText.Click.Expanded.Button"
        android:textColor="@color/notification_white_text"
        android:ellipsize="end"
        android:id="@+id/call_button"
        android:background="@drawable/bg__click_live_activity_call_button"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:layout_below="@+id/subtitle"
        android:layout_alignRight="@+id/spacer"
        android:layout_alignParentLeft="true"
        android:textAllCaps="false"
        android:outlineProvider="none"/>
    <TextView
        android:textAppearance="@style/LiveActivityText.Click.Expanded.Title"
        android:id="@+id/spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/subtitle"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textAppearance="@style/LiveActivityText.Click.Expanded.Button"
        android:textColor="@color/notification_blue"
        android:ellipsize="end"
        android:id="@+id/add_button"
        android:background="@drawable/bg__click_live_activity_add_button"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/subtitle"
        android:layout_alignLeft="@+id/spacer"
        android:layout_alignParentRight="true"
        android:textAllCaps="false"
        android:outlineProvider="none"/>
</RelativeLayout>
