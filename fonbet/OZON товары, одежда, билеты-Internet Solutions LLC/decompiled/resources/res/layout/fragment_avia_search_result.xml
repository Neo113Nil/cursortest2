<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aviaSearchResultRoot"
    android:background="?attr/layerFloor0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/aviaSearchResultComposerFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/aviaSearchResultQuickFiltersSkeleton"
        android:background="?attr/layerFloor1"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aviaSearchResultComposerFragmentContainer">
        <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
            android:layout_width="122dp"
            android:layout_height="32dp"
            app:spvCornerRadius="16dp"/>
        <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
            android:layout_width="122dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            app:spvCornerRadius="16dp"/>
    </LinearLayout>
    <ru.ozon.app.android.travel.molecules.view.searchPreloader.SearchPreloaderView
        android:id="@+id/aviaSearchResultProgressBarView"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aviaSearchResultQuickFiltersSkeleton"
        app:spvProgressLineColor="?attr/bgActionPrimary"
        app:spvTextColor="?attr/bgActionPrimary"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/aviaSearchResultRecyclerView"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aviaSearchResultProgressBarView"/>
    <ru.ozon.app.android.travel.feature.avia.widgets.aviaSearchResult.legacy.view.v3.AviaSearchV3ProgressView
        android:id="@+id/aviaSearchResultV3SkeletonView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aviaSearchResultProgressBarView"/>
    <ru.ozon.app.android.travel.molecules.view.errorState.ErrorStateView
        android:id="@+id/aviaSearchResultErrorStateView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aviaSearchResultComposerFragmentContainer"/>
    <ru.ozon.app.android.uikit.screenstate.ScreenStateViewWidget
        android:id="@+id/aviaSearchResultScreenStateView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="?android:attr/actionBarSize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/aviaSearchResultProgressView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/aviaSearchResultScreenStateView"
        app:layout_constraintEnd_toEndOf="@+id/aviaSearchResultScreenStateView"
        app:layout_constraintStart_toStartOf="@+id/aviaSearchResultScreenStateView"
        app:layout_constraintTop_toTopOf="@+id/aviaSearchResultScreenStateView"
        layout="@layout/view_progressbar_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
