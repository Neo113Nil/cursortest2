<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/aviaDetailedInfoV3AirlineLogoIV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/aviaDetailedInfoV3SegmentAirplaneTAV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/aviaDetailedInfoV3SubAirlineLogoIV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/aviaDetailedInfoV3AirlineLogoIV"
        app:layout_constraintEnd_toEndOf="@+id/aviaDetailedInfoV3AirlineLogoIV"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/aviaDetailedInfoV3BadgeVB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/aviaDetailedInfoV3SegmentAirplaneTAV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/aviaDetailedInfoV3AirlineTAV"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/aviaDetailedInfoV3AirlineTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/aviaDetailedInfoV3BadgeVB"
        app:layout_constraintStart_toEndOf="@+id/aviaDetailedInfoV3AirlineLogoIV"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/aviaDetailedInfoV3SegmentDurationTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="@+id/aviaDetailedInfoV3AirlineTAV"
        app:layout_constraintStart_toEndOf="@+id/aviaDetailedInfoV3AirlineLogoIV"
        app:layout_constraintTop_toBottomOf="@+id/aviaDetailedInfoV3AirlineTAV"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/aviaDetailedInfoV3SegmentAirplaneTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="@+id/aviaDetailedInfoV3AirlineTAV"
        app:layout_constraintStart_toEndOf="@+id/aviaDetailedInfoV3AirlineLogoIV"
        app:layout_constraintTop_toBottomOf="@+id/aviaDetailedInfoV3SegmentDurationTAV"/>
    <ru.ozon.app.android.travel.feature.avia.shared.flightDetails.FlightDetailsSegmentInfoView
        android:id="@+id/aviaDetailedInfoV3SegmentDeparture"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/aviaDetailedInfoV3AirlineLogoIV"
        app:layout_constraintTop_toBottomOf="@+id/aviaDetailedInfoV3SegmentAirplaneTAV"/>
    <ru.ozon.uni.atoms.af.layout.HorizontalFlexAtomsLayout
        android:id="@+id/aviaDetailedInfoV3LuggageBadgesHFAL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/aviaDetailedInfoV3AirlineLogoIV"
        app:layout_constraintTop_toBottomOf="@+id/aviaDetailedInfoV3SegmentDeparture"/>
    <ru.ozon.app.android.travel.feature.avia.shared.flightDetails.FlightDetailsSegmentInfoView
        android:id="@+id/aviaDetailedInfoV3SegmentArrival"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/aviaDetailedInfoV3AirlineLogoIV"
        app:layout_constraintTop_toBottomOf="@+id/aviaDetailedInfoV3LuggageBadgesHFAL"/>
</merge>
