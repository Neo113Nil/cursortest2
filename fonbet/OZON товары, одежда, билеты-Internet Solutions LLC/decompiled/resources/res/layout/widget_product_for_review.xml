<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="16dp">
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/badgesFl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageIv"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@null"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/badgesFl"
        app:layout_goneMarginTop="0dp"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/nameTav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/reviewRatingBar"
        app:layout_constraintEnd_toStartOf="@+id/hideCL"
        app:layout_constraintStart_toEndOf="@+id/imageIv"
        app:layout_constraintTop_toTopOf="@+id/imageIv"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <ru.ozon.uni.android.uikit.view.atoms.rating.VectorRatingBar
        android:id="@+id/reviewRatingBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="@+id/imageIv"
        app:layout_constraintStart_toStartOf="@+id/nameTav"
        app:layout_constraintTop_toBottomOf="@+id/nameTav"
        app:rb_stepSize="1"
        style="@style/RatingBarStyle.L"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/hideCL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:paddingStart="@dimen/dimen_12"
        android:paddingEnd="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="@+id/reviewRatingBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/nameTav">
        <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
            android:id="@+id/hideButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/hideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
