<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/backgroundIv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/titleTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/subtitleTv"
            app:layout_constraintEnd_toStartOf="@+id/hoursView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:id="@+id/subtitleTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="8dp"
            app:configuration="textMedium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/hoursView"
            app:layout_constraintStart_toStartOf="@+id/titleTv"
            app:layout_constraintTop_toBottomOf="@+id/titleTv"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:gravity="center"
            android:id="@+id/timerTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            app:configuration="textMedium"
            app:layout_constraintBottom_toTopOf="@+id/secondsView"
            app:layout_constraintEnd_toEndOf="@+id/secondsView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:id="@+id/hoursView"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/secondsView"
            app:layout_constraintEnd_toStartOf="@+id/minutesView"
            app:layout_constraintTop_toTopOf="@+id/secondsView"
            style="@style/FlashSaleTimerText"/>
        <TextView
            android:id="@+id/minutesView"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/secondsView"
            app:layout_constraintEnd_toStartOf="@+id/secondsView"
            app:layout_constraintTop_toTopOf="@+id/secondsView"
            style="@style/FlashSaleTimerText"/>
        <TextView
            android:id="@+id/secondsView"
            android:layout_marginBottom="6dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timerTitleTv"
            style="@style/FlashSaleTimerText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
