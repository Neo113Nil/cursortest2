<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/checkboxV"
        android:background="@drawable/selector_checkbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.image.Image
        android:id="@+id/imageIv"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/checkboxV"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/imageBadgeBv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageIv"
        app:layout_constraintStart_toStartOf="@+id/imageIv"/>
    <ru.ozon.uni.atoms.af.layout.HorizontalFlexAtomsLayout
        android:id="@+id/titleRowFlexAL"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginHorizontal="12dp"
        app:flexWrap="wrap"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageIv"
        app:layout_constraintTop_toTopOf="@+id/imageIv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:textColor="?attr/textSecondary"
        android:id="@+id/infoTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/titleRowFlexAL"
        app:layout_constraintStart_toStartOf="@+id/titleRowFlexAL"
        app:layout_constraintTop_toBottomOf="@+id/titleRowFlexAL"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:ellipsize="end"
        android:id="@+id/subtitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="@+id/titleRowFlexAL"
        app:layout_constraintStart_toStartOf="@+id/titleRowFlexAL"
        app:layout_constraintTop_toBottomOf="@+id/infoTv"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/priceUpTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@+id/titleRowFlexAL"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTv"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/priceUpIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/priceUpTv"
        app:layout_constraintStart_toEndOf="@+id/priceUpTv"
        app:layout_constraintTop_toTopOf="@+id/priceUpTv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
