<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.app.android.travel.utils.view.constraintLayoutWithBorder.ConstraintLayoutWithBorder xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple_rect_bluewave"
    android:paddingVertical="16dp"
    app:clwbBackgroundColor="?attr/layerFloor1"
    app:clwbCornerRadius="20dp">
    <ru.ozon.app.android.atoms.af.layout.HorizontalAtomsLayout
        android:id="@+id/aviaSearchResultBadgesHal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.travel.feature.avia.widgets.aviaSearchResult.legacy.view.RouteGroupLayout
        android:orientation="vertical"
        android:id="@+id/aviaSearchRouteGl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aviaSearchResultBadgesHal"
        app:layout_goneMarginTop="0dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/aviaSearchLuggageRv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aviaSearchRouteGl"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/aviaSearchPremiumBadgeSkeletonSpv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/aviaSearchPremiumBadgeBv"
        app:layout_constraintEnd_toEndOf="@+id/aviaSearchPremiumBadgeBv"
        app:layout_constraintStart_toStartOf="@+id/aviaSearchPremiumBadgeBv"
        app:layout_constraintTop_toTopOf="@+id/aviaSearchPremiumBadgeBv"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/aviaSearchPremiumBadgeBv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aviaSearchLuggageRv"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/aviaSearchPriceSkeletonSpv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/aviaSearchPricePv"
        app:layout_constraintEnd_toEndOf="@+id/aviaSearchPricePv"
        app:layout_constraintStart_toStartOf="@+id/aviaSearchPricePv"
        app:layout_constraintTop_toTopOf="@+id/aviaSearchPricePv"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/aviaSearchPricePv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/aviaSearchRemainingTicketsTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aviaSearchLuggageRv"
        app:layout_constraintVertical_bias="1"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/aviaSearchDiscountSkeletonSpv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/aviaSearchDiscountTav"
        app:layout_constraintEnd_toEndOf="@+id/aviaSearchDiscountTav"
        app:layout_constraintStart_toStartOf="@+id/aviaSearchDiscountTav"
        app:layout_constraintTop_toTopOf="@+id/aviaSearchDiscountTav"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/aviaSearchDiscountTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/aviaSearchPricePv"
        app:layout_constraintEnd_toStartOf="@+id/aviaSearchSmallButtonSbv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/aviaSearchPricePv"
        app:layout_constraintTop_toTopOf="@+id/aviaSearchPricePv"
        app:layout_constraintVertical_bias="0.72"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/aviaSearchRemainingTicketsTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/aviaSearchSmallButtonSbv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/aviaSearchSmallButtonSkeletonSpv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/aviaSearchSmallButtonSbv"
        app:layout_constraintEnd_toEndOf="@+id/aviaSearchSmallButtonSbv"
        app:layout_constraintStart_toStartOf="@+id/aviaSearchSmallButtonSbv"
        app:layout_constraintTop_toTopOf="@+id/aviaSearchSmallButtonSbv"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
        android:id="@+id/aviaSearchSmallButtonSbv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aviaSearchPremiumBadgeBv"
        app:layout_constraintVertical_bias="1"/>
</ru.ozon.app.android.travel.utils.view.constraintLayoutWithBorder.ConstraintLayoutWithBorder>
