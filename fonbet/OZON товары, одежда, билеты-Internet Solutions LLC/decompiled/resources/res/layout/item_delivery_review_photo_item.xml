<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_delivery_review_upload_photos_item"
    android:layout_width="56dp"
    android:layout_height="56dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="top|right"
        android:id="@+id/ivRemovePhoto"
        android:background="@drawable/circle_gray"
        android:padding="2dp"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_margin="4dp"
        android:backgroundTint="?attr/bgPrimary"
        app:srcCompat="@drawable/ic_s_cross_filled_compact"
        app:tint="?attr/graphicTertiary"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/retryBtnIv"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:srcCompat="@drawable/ic_m_reload"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/uploadingOverlayFl"
        android:background="@drawable/upload_photo_circle_dimming"
        android:layout_width="40dp"
        android:layout_height="40dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/cancelUploadingIv"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:srcCompat="@drawable/ic_s_cross"
            app:tint="@color/oz_white_1"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/spinnerPb"
            android:visibility="gone"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:max="100"
            android:progress="5"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bg_upload_photo_progress"
            style="?android:attr/progressBarStyleHorizontal"/>
    </FrameLayout>
</FrameLayout>
