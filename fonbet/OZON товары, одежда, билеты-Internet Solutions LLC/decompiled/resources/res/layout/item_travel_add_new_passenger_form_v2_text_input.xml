<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout
        android:id="@+id/passengerFormTextInputMtil"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        style="@style/OzTextInput.Layout">
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/passengerFormTextInputEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            style="@style/OzTextInput.EditText"/>
    </ru.ozon.app.android.uikit.view.input.MobilizationTextInputLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.M.Red"
        android:id="@+id/passengerFormTextInputErrorTv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
</LinearLayout>
