<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/additional_content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="2dp"
        android:paddingEnd="8dp"
        android:layout_marginHorizontal="8dp"
        android:paddingVertical="2dp">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/pin_image"
                android:padding="2dp"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_light_key"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/pins_count"
                android:layout_width="28dp"
                android:layout_height="28dp"
                style="@style/OzonTextAppearance.BodyControl.300xsmall"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/additional_content_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_s_star_filled_compact"
            android:tint="@color/graphic_rating"
            android:layout_marginStart="6dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/additional_content_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            style="@style/OzonTextAppearance.CompactControl.300xsmall"/>
    </LinearLayout>
    <ru.ozon.app.android.geo.map.presentation.mapicons.ElevationImageView
        android:id="@+id/pin_pointer"
        android:layout_width="21dp"
        android:layout_height="9dp"
        android:src="@drawable/pin_beak"/>
    <ru.ozon.app.android.geo.map.presentation.mapicons.ElevationImageView
        android:id="@+id/pin_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="4dp"/>
</LinearLayout>
