<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/previewGroup"
    android:background="@drawable/pdp_product_gallery_preview_selector"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_marginLeft="2dp"
    android:layout_marginRight="2dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/previewIv"
        android:background="?attr/layerActiveSurface"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/play"
        android:padding="12dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_s_play_sign_filled"
        app:tint="?attr/bgLightKey"/>
</FrameLayout>
