<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ozonIdDebugMainRoot"
    android:paddingTop="60dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ozonIdDebugMainContent"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/profileBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-16dp"
            app:layout_constraintBottom_toBottomOf="@+id/enableInstantLoginButton"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/profileBlockTitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Профиль"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/profileBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/userIdTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User ID:"
            android:layout_marginStart="16dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/userIdValueTextView"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.500medium"
            android:textColor="@color/ozon_id_debug_text_action"
            android:id="@+id/userIdValueTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ozonIdDebugProfileValuesBarrier"
            app:layout_constraintTop_toBottomOf="@+id/profileBlockTitleTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/sessionIdTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session ID:"
            android:layout_marginStart="16dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/sessionIdValueTextView"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.500medium"
            android:textColor="@color/ozon_id_debug_text_action"
            android:id="@+id/sessionIdValueTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ozonIdDebugProfileValuesBarrier"
            app:layout_constraintTop_toBottomOf="@+id/userIdValueTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/phoneNumberTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Телефон:"
            android:layout_marginStart="16dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/phoneNumberValueTextView"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.500medium"
            android:textColor="@color/ozon_id_debug_text_action"
            android:id="@+id/phoneNumberValueTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ozonIdDebugProfileValuesBarrier"
            app:layout_constraintTop_toBottomOf="@+id/sessionIdValueTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/userFullNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Имя:"
            android:layout_marginStart="16dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/userFullNameValueTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/phoneNumberTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.500medium"
            android:textColor="@color/ozon_id_debug_text_action"
            android:id="@+id/userFullNameValueTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ozonIdDebugProfileValuesBarrier"
            app:layout_constraintTop_toBottomOf="@+id/phoneNumberValueTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.400small"
            android:id="@+id/biometrySubtitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Вход по биометрии"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/userFullNameTextView"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/enableBiometryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Включить"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/disableBiometryButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/biometrySubtitleTextView"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/disableBiometryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Отключить"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/enableBiometryButton"
            app:layout_constraintTop_toBottomOf="@+id/biometrySubtitleTextView"
            style="@style/ButtonDebug"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.400small"
            android:id="@+id/instantLoginSubtitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Instant login (Smartlock)"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/enableBiometryButton"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/enableInstantLoginButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Включить"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/disableInstantLoginButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/instantLoginSubtitleTextView"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/disableInstantLoginButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Отключить"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/enableInstantLoginButton"
            app:layout_constraintTop_toBottomOf="@+id/instantLoginSubtitleTextView"
            style="@style/ButtonDebug"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/ozonIdDebugProfileValuesBarrier"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:barrierDirection="end"
            app:barrierMargin="8dp"
            app:constraint_referenced_ids="userIdTextView,sessionIdTextView,phoneNumberTextView,userFullNameTextView"/>
        <View
            android:id="@+id/authBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-16dp"
            app:layout_constraintBottom_toBottomOf="@+id/initAuthLogoutButtonWithReset"
            app:layout_constraintTop_toBottomOf="@+id/profileBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/authBlockTitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Авторизация"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/authBlock"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/signInButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Войти"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/authBlockTitleTextView"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Выйти"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/signInButton"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/forceLogoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Force Logout"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/logoutButton"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/forceLogoutButtonWithReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Force Logout &amp; resetCookies"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/forceLogoutButton"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/initAuthLogoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Init Auth Logout"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/forceLogoutButtonWithReset"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:id="@+id/initAuthLogoutButtonWithReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Init Auth Logout &amp; resetCookies"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/initAuthLogoutButton"
            style="@style/ButtonDebug"/>
        <View
            android:id="@+id/credentialsBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-8dp"
            app:layout_constraintBottom_toBottomOf="@+id/sharedCredentialsButton"
            app:layout_constraintTop_toBottomOf="@+id/authBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/credentialsBlockTitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Креды"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/credentialsBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:gravity="center_vertical"
            android:id="@+id/appCredentialsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:foreground="@drawable/ozon_id_debug_button_ripple"
            android:text="Креды приложения"
            android:singleLine="true"
            android:drawableEnd="@drawable/ic_m_chevron_right"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/credentialsBlockTitleTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:gravity="center_vertical"
            android:id="@+id/sharedCredentialsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:foreground="@drawable/ozon_id_debug_button_ripple"
            android:text="Креды шаренного стора"
            android:singleLine="true"
            android:drawableEnd="@drawable/ic_m_chevron_right"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/appCredentialsButton"/>
        <View
            android:id="@+id/settingsBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-16dp"
            app:layout_constraintBottom_toBottomOf="@+id/restartButton"
            app:layout_constraintTop_toBottomOf="@+id/credentialsBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/settingsBlockTitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Настройки"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/settingsBlock"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearCookiesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Удалить Cookies"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/settingsBlockTitleTextView"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearAllButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Очистить Account Manager &amp; Cookies"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/clearCookiesButton"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearOldAccountManagerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Очистить deprecated токены ШС"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/clearAllButton"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearFirstLaunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сбросить флаг первого запуска"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/clearOldAccountManagerButton"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearSharedStoreMigration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сбросить флаг миграции ШС"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/clearFirstLaunch"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearAutologinFlag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сбросить флаг автологина"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/clearSharedStoreMigration"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteSsoMobileConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Удалить ssoMobileConfig"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/clearAutologinFlag"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/restartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Перезапустить"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/deleteSsoMobileConfig"
            style="@style/ButtonDebug"/>
        <View
            android:id="@+id/preferencesBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-8dp"
            app:layout_constraintBottom_toBottomOf="@+id/sharedPrefsButton"
            app:layout_constraintTop_toBottomOf="@+id/settingsBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/preferencesBlockTitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Preferences"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/preferencesBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:gravity="center_vertical"
            android:id="@+id/dataStoreButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:foreground="@drawable/ozon_id_debug_button_ripple"
            android:text="DataStore Preferences (новые)"
            android:singleLine="true"
            android:drawableEnd="@drawable/ic_m_chevron_right"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/preferencesBlockTitleTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:gravity="center_vertical"
            android:id="@+id/sharedPrefsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:foreground="@drawable/ozon_id_debug_button_ripple"
            android:text="Shared Preferences (старые)"
            android:singleLine="true"
            android:drawableEnd="@drawable/ic_m_chevron_right"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/dataStoreButton"/>
        <View
            android:id="@+id/accountRecoveryBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-16dp"
            app:layout_constraintBottom_toBottomOf="@+id/authorizedAccountRecoveryStartButton"
            app:layout_constraintTop_toBottomOf="@+id/preferencesBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/accountRecoveryBlockTitleTextView"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Восстановление аккаунта"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/accountRecoveryBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/accountRecoveryUrlLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="URL:"
            android:layout_marginStart="16dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/accountRecoveryUrlEditText"
            app:layout_constraintEnd_toStartOf="@+id/accountRecoveryUrlEditText"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/accountRecoveryUrlEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="textMultiLine"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/accountRecoveryUrlLabel"
            app:layout_constraintTop_toBottomOf="@+id/accountRecoveryBlockTitleTextView"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/anonAccountRecoveryStartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Восстановить аккаунт Аноним"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/accountRecoveryUrlEditText"
            style="@style/ButtonDebug"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/authorizedAccountRecoveryStartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Восстановить аккаунт Зарег"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/anonAccountRecoveryStartButton"
            style="@style/ButtonDebug"/>
        <View
            android:id="@+id/notificationDebugBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/notificationDebugButton"
            app:layout_constraintTop_toBottomOf="@+id/accountRecoveryBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/notificationDebugBlockTitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Дебаг нотификаций"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/notificationDebugBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:gravity="center_vertical"
            android:id="@+id/notificationDebugButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:foreground="@drawable/ozon_id_debug_button_ripple"
            android:text="Открыть Notification debug"
            android:singleLine="true"
            android:drawableEnd="@drawable/ic_m_chevron_right"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/notificationDebugBlockTitleTextView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
