<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/in_app_update_blocking_activity_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dimen_16"
    android:paddingEnd="@dimen/dimen_16">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/updateRequiredContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ru.ozon.uni.android.atom.image.Image
                android:id="@+id/updateRequiredImage"
                android:layout_width="168dp"
                android:layout_height="168dp"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:id="@+id/updateRequiredTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:id="@+id/updateRequiredDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"/>
        </LinearLayout>
        <ru.ozon.uni.android.controls.button.ButtonView
            android:id="@+id/updateRequiredButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_14"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/downloadingContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ru.ozon.uni.android.atom.loader.ui.LoaderView
            android:id="@+id/downloadingLoader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/downloadingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16"
            android:textAlignment="center"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/installUpdateContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ru.ozon.uni.android.atom.image.Image
                android:id="@+id/installUpdateImage"
                android:layout_width="168dp"
                android:layout_height="168dp"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:id="@+id/installUpdateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:id="@+id/installUpdateDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"/>
        </LinearLayout>
        <ru.ozon.uni.android.controls.button.ButtonView
            android:id="@+id/installUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_14"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/errorContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ru.ozon.uni.android.atom.image.Image
                android:id="@+id/errorImage"
                android:layout_width="168dp"
                android:layout_height="168dp"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:id="@+id/errorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:id="@+id/errorDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"/>
        </LinearLayout>
        <ru.ozon.uni.android.controls.button.ButtonView
            android:id="@+id/errorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_14"/>
    </LinearLayout>
</FrameLayout>
