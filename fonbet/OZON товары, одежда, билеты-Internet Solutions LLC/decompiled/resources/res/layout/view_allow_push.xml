<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/decorRightIV"
        android:layout_width="104dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_bell"
        android:contentDescription="@null"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/decorRightIV"
        app:layout_constraintEnd_toEndOf="@+id/decorRightIV"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/decorRightIV"
        app:layout_constraintTop_toTopOf="@+id/decorRightIV"
        app:tint="?attr/bgActionPrimary"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/TextStyle.Body.M.Bold.White"
        android:id="@+id/titleTav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="@dimen/allow_push_label_margin_start"
        android:layout_marginEnd="@dimen/allow_push_label_margin_end"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTav"
        app:layout_constraintEnd_toStartOf="@+id/decorRightIV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/TextStyle.Caption.White"
        android:id="@+id/subtitleTav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/actionButton"
        app:layout_constraintEnd_toStartOf="@+id/decorRightIV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTav"
        app:layout_goneMarginBottom="16dp"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
        android:id="@+id/actionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTav"
        style="@style/SmallButton.Secondary"/>
    <ImageView
        android:id="@+id/closeIv"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_m_cross"
        android:contentDescription="@null"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
