<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLl"
    android:background="?attr/oz_semantic_bg_secondary"
    android:paddingBottom="12dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="140dp"
    android:layout_height="match_parent">
    <ru.ozon.app.android.product.imagesswipeview.AdultImageView
        android:id="@+id/imagesSwipeView"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.atoms.v3.containers.AtomBadgesLayout
        android:id="@+id/topBadgesContainer"
        android:layout_width="104dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/imagesSwipeView"
        app:layout_constraintLeft_toLeftOf="@+id/imagesSwipeView"
        app:layout_constraintTop_toTopOf="@+id/imagesSwipeView"/>
    <ru.ozon.app.android.atoms.v3.containers.AtomBadgesLayout
        android:id="@+id/bottomBadgesContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/imagesSwipeView"
        app:layout_constraintLeft_toLeftOf="@+id/imagesSwipeView"
        app:layout_constraintRight_toRightOf="@+id/imagesSwipeView"
        app:layout_constraintTop_toTopOf="@+id/imagesSwipeView"/>
    <ru.ozon.app.android.fresh.main.widgets.product.common.views.ProductFavoriteExpressMoleculeView
        android:id="@+id/productFavMoleculeButton"
        android:background="@drawable/bg_white_ripple_blue_round"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_m_fav_tiles_normal"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.atoms.af.layout.VerticalAtomsLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/stateVrc"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/barrier2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imagesSwipeView"
        app:layout_constraintVertical_bias="0"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/productSa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="productSa"/>
</androidx.constraintlayout.widget.ConstraintLayout>
