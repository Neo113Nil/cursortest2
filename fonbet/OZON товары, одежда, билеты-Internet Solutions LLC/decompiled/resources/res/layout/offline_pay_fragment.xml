<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_container"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/top_space"
                android:background="@color/layer_floor_0"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/from_container"
                android:background="@drawable/background_rounded_floor1_24"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/separator_between_from_and_to"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_space"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_secondary"
                android:id="@+id/from_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/offline_transfer_from_title_caps"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintTop_toTopOf="@+id/from_container"
                style="@style/OzonTextAppearance.BodyControl.400small"/>
            <View
                android:id="@+id/background_account"
                android:background="@drawable/background_rounded_bg_primary_16"
                android:layout_width="0dp"
                android:layout_height="98dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/from_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/from_title"/>
            <ImageView
                android:id="@+id/ic_account_currency"
                android:background="@drawable/background_rounded_floor1_12"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:src="@drawable/ic_m_rubles_filled"
                app:layout_constraintStart_toStartOf="@+id/background_account"
                app:layout_constraintTop_toTopOf="@+id/background_account"
                app:tint="@color/bg_action_primary"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_secondary"
                android:id="@+id/main_account_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/offline_main_account_title"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/ic_account_currency"
                app:layout_constraintTop_toTopOf="@+id/background_account"
                style="@style/OzonTextAppearance.Compact.400large"/>
            <ImageView
                android:id="@+id/ic_account_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:src="@drawable/ic_s_info_filled_compact"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/ic_account_currency"
                app:layout_constraintTop_toBottomOf="@+id/main_account_title"
                app:tint="@color/graphic_warning_primary"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_secondary"
                android:id="@+id/account_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/ic_account_warning"
                app:layout_constraintStart_toEndOf="@+id/ic_account_warning"
                app:layout_constraintTop_toTopOf="@+id/ic_account_warning"
                style="@style/OzonTextAppearance.BodyControl.500medium"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_secondary"
                android:id="@+id/account_balance_currency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ₽"
                app:layout_constraintBottom_toBottomOf="@+id/ic_account_warning"
                app:layout_constraintStart_toEndOf="@+id/account_balance"
                app:layout_constraintTop_toTopOf="@+id/ic_account_warning"
                style="@style/OzonTextAppearance.BodyControl.500medium"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_secondary"
                android:id="@+id/account_balance_relevance_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="@dimen/dimen_16"
                android:text="@string/offline_actually_without_postfix"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/background_account"
                app:layout_constraintStart_toEndOf="@+id/ic_account_currency"
                app:layout_constraintTop_toBottomOf="@+id/account_balance_currency"
                style="@style/OzonTextAppearance.Body.300xsmall"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_secondary"
                android:id="@+id/account_balance_relevance_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="@dimen/dimen_16"
                app:layout_constraintBottom_toBottomOf="@+id/background_account"
                app:layout_constraintStart_toEndOf="@+id/account_balance_relevance_prefix"
                app:layout_constraintTop_toBottomOf="@+id/account_balance_currency"
                style="@style/OzonTextAppearance.Body.300xsmall"/>
            <View
                android:id="@+id/separator_between_from_and_to"
                android:background="@color/layer_floor_0"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                app:layout_constraintTop_toBottomOf="@+id/from_container"/>
            <View
                android:id="@+id/to_container"
                android:background="@drawable/background_rounded_floor1_24"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/separator_between_to_and_sms_status"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/separator_between_from_and_to"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_secondary"
                android:id="@+id/to_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/offline_transfer_receiver_title_caps"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="@+id/to_container"
                app:layout_constraintTop_toTopOf="@+id/to_container"
                style="@style/OzonTextAppearance.BodyControl.400small"/>
            <View
                android:id="@+id/receiver_info_container"
                android:background="@drawable/background_rounded_bg_primary_16"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/bankImage"
                app:layout_constraintEnd_toEndOf="@+id/to_container"
                app:layout_constraintStart_toStartOf="@+id/to_container"
                app:layout_constraintTop_toBottomOf="@+id/to_title"/>
            <ImageView
                android:id="@+id/bankImage"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/dimen_16"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintStart_toStartOf="@+id/receiver_info_container"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"/>
            <ImageView
                android:id="@+id/ic_sbp"
                android:background="@drawable/background_circle_bg_primary"
                android:padding="2dp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/ic_m_multicolor_sbp"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="@+id/bankImage"
                app:layout_constraintTop_toTopOf="@+id/bankImage"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_primary"
                android:id="@+id/phone_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintStart_toEndOf="@+id/bankImage"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"
                style="@style/OzonTextAppearance.CompactControl.500medium"/>
            <ImageView
                android:id="@+id/ic_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_m_chevron_right_filled"
                android:layout_marginEnd="@dimen/dimen_16"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintEnd_toEndOf="@+id/receiver_info_container"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"
                app:tint="@color/graphic_quaternary"/>
            <ru.ozon.fintech.ui.input.InputView
                android:id="@+id/input"
                android:background="@drawable/background_rounded_floor1_16_top_transparent_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/to_container"
                app:layout_constraintTop_toBottomOf="@+id/receiver_info_container"/>
            <View
                android:id="@+id/separator_between_to_and_sms_status"
                android:background="@color/layer_floor_0"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                app:layout_constraintTop_toBottomOf="@+id/to_container"/>
            <View
                android:id="@+id/sms_status_container"
                android:background="@drawable/background_rounded_floor1_24_top"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/separator_between_to_and_sms_status"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_secondary"
                android:id="@+id/sms_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/offline_sms_status_title"
                android:layout_marginStart="@dimen/dimen_16"
                app:layout_constraintStart_toStartOf="@+id/sms_status_container"
                app:layout_constraintTop_toTopOf="@+id/sms_status_container"
                style="@style/OzonTextAppearance.BodyControl.400small"/>
            <ImageView
                android:id="@+id/ic_sms_status_warning"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_s_info_filled_compact"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/sms_status_title"
                app:layout_constraintStart_toEndOf="@+id/sms_status_title"
                app:layout_constraintTop_toTopOf="@+id/sms_status_title"
                app:tint="@color/graphic_quaternary"/>
            <View
                android:id="@+id/sms_status_container_cl"
                android:background="@drawable/background_rounded_bg_primary_16"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sms_status_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_primary"
                android:id="@+id/send_me_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/offline_send_me"
                android:layout_marginStart="@dimen/dimen_16"
                app:layout_constraintStart_toStartOf="@+id/sms_status_container_cl"
                app:layout_constraintTop_toTopOf="@+id/sms_status_container_cl"
                style="@style/OzonTextAppearance.Compact.400large"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_primary"
                android:id="@+id/sender_commission_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2"
                android:layout_marginBottom="@dimen/dimen_16"
                android:layout_marginStart="@dimen/dimen_16"
                app:layout_constraintBottom_toBottomOf="@+id/sms_status_container_cl"
                app:layout_constraintStart_toStartOf="@+id/sms_status_container_cl"
                app:layout_constraintTop_toBottomOf="@+id/send_me_title"
                style="@style/OzonTextAppearance.BodyControl.400small"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_primary"
                android:id="@+id/sender_commission_amount_currency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₽"
                app:layout_constraintStart_toEndOf="@+id/sender_commission_amount"
                app:layout_constraintTop_toTopOf="@+id/sender_commission_amount"
                style="@style/OzonTextAppearance.BodyControl.400small"/>
            <View
                android:id="@+id/premium_promo_container"
                android:background="@drawable/background_rounded_bg_secondary_6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dimen_2"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/ic_premium"
                app:layout_constraintEnd_toEndOf="@+id/ic_premium_info"
                app:layout_constraintStart_toEndOf="@+id/sender_commission_amount_currency"
                app:layout_constraintTop_toTopOf="@+id/ic_premium"/>
            <ImageView
                android:id="@+id/ic_premium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2"
                android:src="@drawable/ic_m_status_points_filled"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@+id/sender_commission_amount_currency"
                app:layout_constraintTop_toBottomOf="@+id/send_me_title"
                app:tint="@color/graphic_action_primary"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_primary"
                android:id="@+id/premium_promo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2"
                android:text="@string/offline_free_with_premium"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/ic_premium"
                app:layout_constraintStart_toEndOf="@+id/ic_premium"
                app:layout_constraintTop_toTopOf="@+id/ic_premium"
                style="@style/OzonTextAppearance.BodyControl.300xsmall"/>
            <ImageView
                android:id="@+id/ic_premium_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_m_chevron_right_filled"
                android:alpha="0.4"
                app:layout_constraintBottom_toBottomOf="@+id/premium_promo_container"
                app:layout_constraintStart_toEndOf="@+id/premium_promo_title"
                app:layout_constraintTop_toTopOf="@+id/premium_promo_container"
                app:tint="@color/graphic_tertiary"/>
            <ru.ozon.fintech.ui.toggleatom.ToggleAtomWrapperView
                android:id="@+id/sender_commission_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dimen_16"
                app:layout_constraintBottom_toBottomOf="@+id/sms_status_container_cl"
                app:layout_constraintEnd_toEndOf="@+id/sms_status_container_cl"
                app:layout_constraintTop_toTopOf="@+id/sms_status_container_cl"/>
            <View
                android:id="@+id/background_send_another"
                android:background="@drawable/background_rounded_bg_primary_16"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginTop="@dimen/dimen_8"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sms_status_container_cl"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_primary"
                android:id="@+id/send_another_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/offline_send_sms_to_receiver_title"
                android:layout_marginStart="@dimen/dimen_16"
                app:layout_constraintStart_toStartOf="@+id/background_send_another"
                app:layout_constraintTop_toTopOf="@+id/background_send_another"
                style="@style/OzonTextAppearance.Compact.400large"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_primary"
                android:id="@+id/receiver_commission_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="@dimen/dimen_16"
                android:layout_marginStart="@dimen/dimen_16"
                app:layout_constraintBottom_toBottomOf="@+id/background_send_another"
                app:layout_constraintStart_toStartOf="@+id/background_send_another"
                app:layout_constraintTop_toBottomOf="@+id/send_another_title"
                style="@style/OzonTextAppearance.BodyControl.400small"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₽"
                app:layout_constraintStart_toEndOf="@+id/receiver_commission_amount"
                app:layout_constraintTop_toTopOf="@+id/receiver_commission_amount"
                style="@style/OzonTextAppearance.BodyControl.400small"/>
            <ru.ozon.fintech.ui.toggleatom.ToggleAtomWrapperView
                android:id="@+id/receiver_commission_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dimen_16"
                app:layout_constraintBottom_toBottomOf="@+id/background_send_another"
                app:layout_constraintEnd_toEndOf="@+id/background_send_another"
                app:layout_constraintTop_toTopOf="@+id/background_send_another"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/oz_semantic_text_action"
                android:gravity="center_vertical"
                android:id="@+id/tariffs_and_limits_info"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_20"
                android:layout_marginTop="@dimen/dimen_16"
                android:text="@string/offline_tariffs_and_limits"
                android:drawableTint="@color/oz_semantic_text_action"
                android:layout_marginHorizontal="@dimen/dimen_16"
                app:drawableEndCompat="@drawable/ic_m_disclosure_filled"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/background_send_another"
                style="@style/OzonTextAppearance.BodyControl.400small"/>
            <View
                android:id="@+id/bottom_floor"
                android:background="@color/layer_floor_1"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tariffs_and_limits_info"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <View
        android:id="@+id/top_container"
        android:background="@drawable/background_rounded_floor1_24_bottom_transparent_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/badges"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.fintech.ui.toolbar.FinToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:elevation="0dp"
        app:buttonGravity=""
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.MyApp.ToolBar"/>
    <HorizontalScrollView
        android:id="@+id/badges"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">
            <ru.ozon.fintech.ui.badgekit.BadgeKitView
                android:id="@+id/left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"/>
            <ru.ozon.fintech.ui.badgekit.BadgeKitView
                android:id="@+id/right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <View
        android:id="@+id/bottom_container"
        android:background="@drawable/background_rounded_floor1_28_top_transparent_bg"
        android:layout_width="0dp"
        android:layout_height="140dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/continue_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/text_pay_sbp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_container"
        app:size="size_600"
        app:titleText="Продолжить"
        style="@style/Button.ActionPrimary"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/oz_semantic_text_secondary"
        android:gravity="center_vertical"
        android:id="@+id/text_pay_sbp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_20"
        android:layout_marginTop="@dimen/dimen_16"
        android:text="@string/offline_system_fast_pay"
        android:drawablePadding="8dp"
        app:drawableStartCompat="@drawable/ic_m_multicolor_sbp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/continue_button"
        style="@style/OzonTextAppearance.Body.400small"/>
</androidx.constraintlayout.widget.ConstraintLayout>
