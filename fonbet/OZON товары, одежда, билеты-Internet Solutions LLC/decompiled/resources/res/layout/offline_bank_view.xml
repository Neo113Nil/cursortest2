<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:gravity="center_vertical">
    <ImageView
        android:id="@+id/image"
        android:background="@drawable/background_rounded_primary_12"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="center"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/text_primary"
        android:ellipsize="end"
