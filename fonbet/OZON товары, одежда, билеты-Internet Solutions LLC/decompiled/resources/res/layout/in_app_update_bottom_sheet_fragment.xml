<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/dimen_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dimen_8">
            <ru.ozon.uni.android.atom.image.Image
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ru.ozon.uni.android.controls.button.IconButtonView
                android:layout_gravity="top|right"
                android:id="@+id/closeIconButtonView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dimen_8"/>
        </FrameLayout>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/descriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ru.ozon.uni.android.controls.button.ButtonView
            android:id="@+id/buttonView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16"
            android:layout_marginHorizontal="@dimen/dimen_16"/>
        <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
            android:id="@+id/remindMeLaterButtonView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            android:layout_marginHorizontal="@dimen/dimen_16"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
