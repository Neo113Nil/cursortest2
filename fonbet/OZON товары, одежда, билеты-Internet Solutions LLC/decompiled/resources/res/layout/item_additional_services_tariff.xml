<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.uni.android.atom.aspect.AspectView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/additionalServiceAspectAV"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="4dp">
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/additionalServiceTitleTAV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ru.ozon.uni.android.atom.text.TextAtomV2View
            android:id="@+id/additionalServiceSubtitleTAV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ru.ozon.uni.android.atom.aspect.AspectView>
