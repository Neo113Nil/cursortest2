<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.controls.button.IconButtonView
        android:id="@+id/iconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label"/>
    <ru.ozon.uni.android.atom.loader.ui.LoaderView
        android:id="@+id/loaderView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="@+id/iconButton"
        app:layout_constraintEnd_toEndOf="@+id/iconButton"
        app:layout_constraintStart_toStartOf="@+id/iconButton"
        app:layout_constraintTop_toTopOf="@+id/iconButton"
        app:loaderSize="loader_400"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textColor="?attr/textPrimary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dimen_12"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iconButton"
        app:layout_constraintTop_toBottomOf="@+id/label"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TextStyle.Body.L"/>
    <TextView
        android:textColor="@color/text_tertiary"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:lineSpacingMultiplier="1"
        android:layout_marginStart="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iconButton"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/TextStyle.Caption"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/clickableAreaF"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="title,description, iconButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label"/>
</androidx.constraintlayout.widget.ConstraintLayout>
