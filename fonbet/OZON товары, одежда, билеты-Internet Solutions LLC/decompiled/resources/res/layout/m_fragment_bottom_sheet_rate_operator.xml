<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/rateOperatorSv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:paddingHorizontal="16dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/sheetHandle"
                android:background="@drawable/m_bottom_sheet_handle"
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="@style/TextStyle.Head.M"
                android:textColor="@color/text_primary"
                android:id="@+id/rateOperatorTitleTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sheetHandle"/>
            <ru.ozon.uni.android.atom.labelRating.LabelRatingView
                android:id="@+id/rateOperatorRatingVrb"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rateOperatorTitleTv"
                style="@style/LabelRating.Default"/>
            <TextView
                android:textAppearance="@style/TextStyle.Body.M.Secondary"
                android:textColor="@color/text_secondary"
                android:id="@+id/rateDescriptionTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rateOperatorRatingVrb"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rateReasonsRv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rateDescriptionTv"/>
            <com.google.android.material.textfield.TextInputLayout
                android:textColorHint="@color/text_secondary"
                android:id="@+id/rate_comment_msg_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:inputType="textMultiLine"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rateReasonsRv"
                style="@style/m_TexInputBoxStyle">
                <ru.ozon.android.messenger.blocks.input.views.PastePlainTextInputEditText
                    android:textAppearance="@style/TextStyle.Body.L"
                    android:textColor="@color/text_primary"
                    android:id="@+id/rate_comment_msg_et"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/rateErrorCl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="76dp"
        android:layout_marginHorizontal="16dp"
        layout="@layout/m_block_alert"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.LargeButtonView
        android:layout_gravity="bottom"
        android:id="@+id/rateSendButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"/>
</FrameLayout>
