<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/atom_tag_height"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">
    <ImageView
        android:id="@+id/tagImage"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="4dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.BgSecondary"
        android:id="@+id/tagTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/crossCircleIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_s_cross_circle"
        android:layout_marginStart="12dp"
        android:tintMode="src_in"
        app:tint="@color/oz_white_overlay_2"/>
</merge>
