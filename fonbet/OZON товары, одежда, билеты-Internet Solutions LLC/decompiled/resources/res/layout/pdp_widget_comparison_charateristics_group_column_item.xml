<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/columnLL"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/textTV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextStyle.Body.M"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/atomSA"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/imageIV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/circle_gray"
        android:minWidth="24dp"
        android:minHeight="24dp"
        android:contentDescription="@null"/>
    <ru.ozon.app.android.pdp.ui.configurators.aspectsCompactV2.color.AspectColorVariantView
        android:id="@+id/colorACVV"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/circle_gray"/>
</LinearLayout>
