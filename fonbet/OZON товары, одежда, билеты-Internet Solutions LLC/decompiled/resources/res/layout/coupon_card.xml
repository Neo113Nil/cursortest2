<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coupon_card_view_pdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/layerFloor0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="@drawable/selector_standard">
        <ImageView
            android:id="@+id/couponImageIv"
            android:background="?attr/layerFloor0"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/pointsIv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/margin"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/couponImageIv"
            app:layout_constraintEnd_toStartOf="@+id/titleTv"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/titleTv"
            app:srcCompat="@drawable/ic_points"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.L.Bold"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/titleTv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/margin"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/couponImageIv"
            app:layout_constraintEnd_toEndOf="@+id/couponImageIv"
            app:layout_constraintStart_toEndOf="@+id/pointsIv"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="@dimen/margin"/>
        <ru.ozon.app.android.marketing.common.coupon.AdultProductPreview
            android:id="@+id/previewFirst"
            android:background="@drawable/coupon_product_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/previewSecond"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/couponImageIv"/>
        <ru.ozon.app.android.marketing.common.coupon.AdultProductPreview
            android:id="@+id/previewSecond"
            android:background="@drawable/coupon_product_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="2dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/previewThird"
            app:layout_constraintStart_toEndOf="@+id/previewFirst"
            app:layout_constraintTop_toBottomOf="@+id/couponImageIv"/>
        <ru.ozon.app.android.marketing.common.coupon.AdultProductPreview
            android:id="@+id/previewThird"
            android:background="@drawable/coupon_product_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="2dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/previewSecond"
            app:layout_constraintTop_toBottomOf="@+id/couponImageIv"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/productsBarrier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="previewFirst, previewSecond, previewThird"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.M"
            android:gravity="center_horizontal"
            android:id="@+id/descriptionTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lines="3"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/conditionsTv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/productsBarrier"/>
        <ImageView
            android:id="@+id/couponAppliedIv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/descriptionTv"
            app:layout_constraintEnd_toEndOf="@+id/descriptionTv"
            app:layout_constraintStart_toStartOf="@+id/descriptionTv"
            app:layout_constraintTop_toTopOf="@+id/descriptionTv"
            app:srcCompat="@drawable/ic_coupon_applied_small"/>
        <TextView
            android:textAppearance="@style/TextStyle.Caption"
            android:textColor="?attr/graphicSecondary"
            android:gravity="center_horizontal"
            android:id="@+id/conditionsTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/actionBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/descriptionTv"/>
        <TextView
            android:textAppearance="@style/TextStyle.Body.L.Bold"
            android:textColor="?attr/textAction"
            android:gravity="center"
            android:id="@+id/actionBtn"
            android:background="@drawable/selector_standard"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/conditionsTv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
