<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oz_semantic_bg_secondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/productIv"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="16dp"
        android:elevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/priceV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/checkboxIv"
        app:layout_constraintStart_toEndOf="@+id/productIv"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/checkboxIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/selector_checkbox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/titleTa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toStartOf="@+id/checkboxIv"
        app:layout_constraintStart_toEndOf="@+id/productIv"
        app:layout_constraintTop_toBottomOf="@+id/priceV"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/aspectsTa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toStartOf="@+id/minusBv"
        app:layout_constraintStart_toEndOf="@+id/productIv"
        app:layout_constraintTop_toBottomOf="@+id/titleTa"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:id="@+id/plusBv"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTa"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:gravity="center"
        android:id="@+id/itemCountTv"
        android:layout_width="28dp"
        android:layout_height="32dp"
        android:layout_marginHorizontal="4dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/plusBv"
        app:layout_constraintEnd_toStartOf="@+id/plusBv"
        app:layout_constraintTop_toTopOf="@+id/plusBv"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:id="@+id/minusBv"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/plusBv"
        app:layout_constraintEnd_toStartOf="@+id/itemCountTv"
        app:layout_constraintTop_toTopOf="@+id/plusBv"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/counterGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="itemCountTv, plusBv, minusBv"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="16dp"
        app:constraint_referenced_ids="productIv, aspectsTa, minusBv"/>
    <View
        android:id="@+id/separator"
        android:background="?attr/oz_semantic_separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/titleTa"
        app:layout_constraintTop_toBottomOf="@+id/bottomBarrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
