<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingVertical="8dp">
    <ImageView
        android:id="@+id/itemIv"
        android:background="@drawable/rect_round_white1"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/badgeV"
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/itemIv"
        app:layout_constraintEnd_toEndOf="@+id/itemIv"
        app:layout_constraintStart_toStartOf="@+id/itemIv"
        app:layout_constraintTop_toTopOf="@+id/itemIv"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Body.M.Bold"
        android:ellipsize="end"
        android:id="@+id/priceTAV"
        android:paddingTop="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toStartOf="@+id/favBtn"
        app:layout_constraintStart_toEndOf="@+id/itemIv"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Caption"
        android:ellipsize="end"
        android:id="@+id/priceDetailsTAV"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toStartOf="@+id/favBtn"
        app:layout_constraintStart_toEndOf="@+id/itemIv"
        app:layout_constraintTop_toBottomOf="@+id/priceTAV"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Caption"
        android:id="@+id/nameTAV"
        android:paddingTop="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toStartOf="@+id/favBtn"
        app:layout_constraintStart_toEndOf="@+id/itemIv"
        app:layout_constraintTop_toBottomOf="@+id/priceDetailsTAV"/>
    <ru.ozon.app.android.fresh.geo.ui.molecules.ProductFavoriteExpressMoleculeView
        android:id="@+id/favBtn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/orderItemBottomSeparator"
        android:background="?attr/oz_semantic_separator"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="6.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemIv"
        app:layout_constraintTop_toBottomOf="@+id/itemIv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
