    android:layout_gravity="start"
    android:orientation="horizontal"
    android:id="@+id/shelfRowLl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="3"
    android:minHeight="132dp"
    android:paddingHorizontal="12dp">
    <ru.ozon.app.android.fresh.main.widgets.catalogShelf.presentation.row.CatalogShelfItemView
        android:id="@+id/firstCategoryItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <ru.ozon.app.android.fresh.main.widgets.catalogShelf.presentation.row.CatalogShelfItemView
        android:id="@+id/secondCategoryItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <ru.ozon.app.android.fresh.main.widgets.catalogShelf.presentation.row.CatalogShelfItemView
        android:id="@+id/thirdCategoryItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
