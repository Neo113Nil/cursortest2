<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_activity_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/main_activity_hidden_holder"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_activity_host_fragment"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/main_activity_bottom_navigation_holder"
        android:fitsSystemWindows="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ru.ozon.fintech.ui.bottomnavigation.FintechBottomNavigationView
            android:id="@+id/main_activity_bottom_navigation"
            android:background="@color/oz_semantic_bg_secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:elevation="0dp"
            app:elevation="0dp"
            app:itemIconTint="@color/fintech_bottomnavigation_text_color"
            app:itemTextAppearanceActive="@style/TextStyle.Caption.Bold"
            app:itemTextAppearanceInactive="@style/TextStyle.Caption.Bold"
            app:itemTextColor="@color/fintech_bottomnavigation_text_color"/>
    </FrameLayout>
</merge>
