<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fin_menu_item_root"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/fin_menu_item_image_view"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="@color/oz_semantic_text_primary"
        android:id="@+id/fin_menu_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/fin_menu_item_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/fin_menu_item_chevron_image_view"
        app:layout_constraintStart_toEndOf="@+id/fin_menu_item_image_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"
        style="@style/TextStyle.Body.L.Bold"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="@color/oz_semantic_text_secondary"
        android:id="@+id/fin_menu_item_subtitle"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/fin_menu_item_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/fin_menu_item_title"
        app:layout_constraintTop_toBottomOf="@+id/fin_menu_item_title"
        style="@style/TextStyle.Body.M"/>
    <ImageView
        android:id="@+id/fin_menu_item_chevron_image_view"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_m_chevron_right"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/fin_menu_item_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fin_menu_item_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
