<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/characteristicsRv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/pdpTextDescriptionGradientV"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/pdpTextDescriptionExpandTav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/pdpTextDescriptionExpandTav"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pdpTextDescriptionExpandLeftAnchor"/>
    <Space
        android:id="@+id/pdpTextDescriptionExpandLeftAnchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/characteristicsRv"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/pdpTextDescriptionExpandLayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="pdpTextDescriptionExpandTav, pdpTextDescriptionGradientV"/>
</androidx.constraintlayout.widget.ConstraintLayout>
