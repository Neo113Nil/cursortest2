<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp"
    style="@style/ozon_logger_android_DebugMenuCardStyle">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/dateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/ozon_logger_android_DebugMenuTextStyle.Description"/>
        <TextView
            android:textColor="@color/ozon_logger_android_textSecondaryTransparent"
            android:id="@+id/localBadge"
            android:text="@string/ozon_logger_android_debug_history_local_badge"
            android:backgroundTint="@color/ozon_logger_android_bgSecondaryTransparent"
            style="@style/ozon_logger_android_DebugMenuBadgeStyle"/>
        <TextView
            android:id="@+id/levelBadge"
            android:layout_marginStart="4dp"
            style="@style/ozon_logger_android_DebugMenuBadgeStyle"/>
    </LinearLayout>
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/ozon_logger_android_DebugMenuTextStyle.Title"/>
    <TextView
        android:id="@+id/fieldsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/ozon_logger_android_DebugMenuTextStyle.Description"/>
</LinearLayout>
