<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fashionTabOnboardingRoot"
    android:background="?attr/layerOverlayDimming"
    android:focusable="true"
    android:visibility="invisible"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tooltipContainer"
        android:background="@drawable/bg_rounded_both_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="?attr/layerFloor1"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/fakeTabContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed">
        <TextView
            android:textAppearance="@style/TextStyle.Body.L.Bold"
            android:textColor="?attr/textPrimary"
            android:id="@+id/onBoardingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/onBoardingDescription"
            app:layout_constraintEnd_toStartOf="@+id/onBoardingImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextStyle.Caption"
            android:textColor="?attr/textSecondary"
            android:id="@+id/onBoardingDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/onBoardingImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/onBoardingTitle"/>
        <ImageView
            android:id="@+id/onBoardingImage"
            android:layout_width="108dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/onBoardingCloseIcon"
            android:background="@drawable/onboarding_cross_shape"
            android:padding="3dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="12dp"
            android:src="@drawable/ic_s_cross_compact"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/textLightKey"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fakeTabContainer"
        android:background="@drawable/bg_fake_fashion_tab"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/fashion_tab_width"
        android:layout_height="@dimen/fashion_tab_height"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tooltipContainer"
        app:layout_constraintVertical_chainStyle="packed">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/fakeFashionTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tint="?attr/textSecondary"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
