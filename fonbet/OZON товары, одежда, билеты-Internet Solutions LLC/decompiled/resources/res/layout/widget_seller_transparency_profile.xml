<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_seller_profile"
    android:paddingBottom="@dimen/dimen_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/sellerIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/subscriberCountTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintStart_toEndOf="@+id/sellerIv"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/subscriberCountLabelTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/subscriberCountTv"
        app:layout_constraintTop_toBottomOf="@+id/subscriberCountTv"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/reviewCountTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginStart="@dimen/dimen_24"
        app:layout_constraintStart_toEndOf="@+id/subscriberCountLabelTv"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/reviewCountLabelTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/reviewCountTv"
        app:layout_constraintTop_toBottomOf="@+id/reviewCountTv"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/subscribeBtn"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_32"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="@+id/sellerIv"
        app:layout_constraintEnd_toStartOf="@+id/shareBtn"
        app:layout_constraintStart_toEndOf="@+id/sellerIv"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/unsubscribeBtn"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_32"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="@+id/sellerIv"
        app:layout_constraintEnd_toStartOf="@+id/shareBtn"
        app:layout_constraintStart_toEndOf="@+id/sellerIv"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/shareBtn"
        android:layout_width="@dimen/dimen_32"
        android:layout_height="@dimen/dimen_32"
        android:layout_marginEnd="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="@+id/sellerIv"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:ellipsize="end"
        android:id="@+id/sellerNameTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sellerIv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trustFactorList"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sellerNameTv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
