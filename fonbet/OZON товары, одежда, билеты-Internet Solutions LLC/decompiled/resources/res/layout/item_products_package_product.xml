<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/productView"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/selector_standard">
    <ImageView
        android:id="@+id/itemIv"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:ellipsize="end"
        android:id="@+id/priceTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemIv"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:ellipsize="end"
        android:id="@+id/nameTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:maxLines="4"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemIv"
        app:layout_constraintTop_toBottomOf="@+id/priceTv"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:ellipsize="end"
        android:id="@+id/quantityTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:maxLines="4"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/itemIv"
        app:layout_constraintTop_toBottomOf="@+id/nameTv"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M.Gray60"
        android:ellipsize="end"
        android:id="@+id/pricePerItemTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:maxLines="4"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/quantityTv"
        app:layout_constraintTop_toBottomOf="@+id/nameTv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
