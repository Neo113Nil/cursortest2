<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/pdpRichContentRv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="false"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/pdpRichContentGradientAnchor"
        android:layout_width="0dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/pdpRichContentRv"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/pdpRichContentGradientV"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/pdpRichContentGradientAnchor"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/pdpRichContentExpandTav"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/pdpRichContentExpandIv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pdpRichContentGradientV"
        app:layout_goneMarginEnd="16dp"/>
    <ImageView
        android:id="@+id/pdpRichContentExpandIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/pdpRichContentExpandTav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/pdpRichContentExpandTav"
        app:layout_constraintTop_toTopOf="@+id/pdpRichContentExpandTav"/>
    <Space
        android:id="@+id/pdpRichContentExpandRightAnchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/pdpRichContentExpandTav"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/pdpRichContentExpandLayer"
        android:paddingTop="22dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        app:constraint_referenced_ids="pdpRichContentExpandTav,pdpRichContentExpandIv,pdpRichContentExpandRightAnchor"/>
</androidx.constraintlayout.widget.ConstraintLayout>
