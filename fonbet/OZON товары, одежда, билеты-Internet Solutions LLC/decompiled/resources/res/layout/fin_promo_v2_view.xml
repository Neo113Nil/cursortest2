<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fin_promo_v2_root"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fin_icon_digit_frame"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/fin_promo_v2_image_view"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="center"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:layout_gravity="center"
            android:id="@+id/fin_promo_v2_icon_digit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextStyle.Head.M"/>
    </FrameLayout>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="@color/oz_semantic_text_primary"
        android:id="@+id/fin_promo_v2_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/fin_promo_v2_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/fin_promo_v2_chevron_image_view"
        app:layout_constraintStart_toEndOf="@+id/fin_icon_digit_frame"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="4dp"
        style="@style/TextStyle.Body.L.Bold"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textColor="@color/oz_semantic_text_secondary"
        android:id="@+id/fin_promo_v2_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fin_promo_v2_chevron_image_view"
        app:layout_constraintStart_toEndOf="@+id/fin_icon_digit_frame"
        app:layout_constraintTop_toBottomOf="@+id/fin_promo_v2_title"
        style="@style/TextStyle.Body.M"/>
    <ImageView
        android:id="@+id/fin_promo_v2_chevron_image_view"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_s_chevron_right"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/fin_promo_v2_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fin_promo_v2_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
