<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ozonIdDebugSharedCredentialsRoot"
    android:paddingTop="60dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ozonIdDebugSharedCredentialsContent"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/sharedCredentialsBlock"
            android:background="@drawable/bg_ozon_id_debug_round"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="-16dp"
            app:layout_constraintBottom_toBottomOf="@+id/copyAccountDataButton"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.500medium"
            android:id="@+id/sharedCredentialsBlockTitleTextView"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Креды шаренного стора"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/sharedCredentialsBlock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.400small"
            android:id="@+id/sharedStoreMigrationFlagTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Shared store migration flag"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/sharedCredentialsBlockTitleTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/sharedStoreMigrationFlagLabelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Value:"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toStartOf="@+id/sharedStoreMigrationFlagValueTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sharedStoreMigrationFlagTitleTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/sharedStoreMigrationFlagValueTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/sharedStoreMigrationFlagLabelTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sharedStoreMigrationFlagLabelTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.400small"
            android:id="@+id/accountDataKeysTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Account Data(keys):"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/sharedStoreMigrationFlagValueTextView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/accountDataKeysValueTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/accountDataKeysTitleTextView"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyAccountDataKeysButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Скопировать"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/accountDataKeysValueTextView"
            style="@style/ButtonDebug"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Headline.400small"
            android:id="@+id/accountDataTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Account Data(Deprecated):"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/copyAccountDataKeysButton"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/OzonTextAppearance.Compact.400small"
            android:id="@+id/accountDataValueTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/accountDataTitleTextView"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyAccountDataButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Скопировать"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/accountDataValueTextView"
            style="@style/ButtonDebug"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
