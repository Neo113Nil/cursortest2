<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bridge_test_root"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.ozon.fintech.ui.toolbar.FinToolbarView
        android:id="@+id/tool_bar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:elevation="@dimen/dimen_0"
        app:elevation="@dimen/dimen_0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.MyApp.ToolBar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/oz_semantic_text_primary"
                android:id="@+id/tv_label_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fintech_testing_nativebridge_group"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <Spinner
                android:textColor="@color/oz_semantic_text_primary"
                android:id="@+id/spinner_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/btn_edit_group"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_label_group"/>
            <EditText
                android:textColor="@color/oz_semantic_text_primary"
                android:id="@+id/et_manual_group"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/fintech_testing_nativebridge_hint_group"
                android:inputType="text"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/btn_edit_group"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_label_group"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_edit_group"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:tint="@color/oz_semantic_text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_label_group"
                app:srcCompat="@drawable/ic_m_edit"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/group_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="spinner_group,et_manual_group"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/oz_semantic_text_primary"
                android:id="@+id/tv_label_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fintech_testing_nativebridge_interface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/group_barrier"/>
            <Spinner
                android:textColor="@color/oz_semantic_text_primary"
                android:id="@+id/spinner_method"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/btn_edit_method"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_label_method"/>
            <EditText
                android:textColor="@color/oz_semantic_text_primary"
                android:id="@+id/et_manual_method"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/fintech_testing_nativebridge_hint_method"
                android:inputType="text"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/btn_edit_method"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_label_method"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_edit_method"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:tint="@color/oz_semantic_text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_label_method"
                app:srcCompat="@drawable/ic_m_edit"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/method_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="spinner_method,et_manual_method"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/oz_semantic_text_primary"
                android:id="@+id/tv_label_preset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fintech_testing_nativebridge_preset"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/method_barrier"/>
            <Spinner
                android:textColor="@color/oz_semantic_text_primary"
                android:id="@+id/spinner_presets"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_label_preset"/>
            <ru.ozon.fintech.preferences.ui.nativebridge.JsonCodeEditorView
                android:id="@+id/json_editor_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/spinner_presets"/>
            <ru.ozon.fintech.preferences.ui.nativebridge.StatusResultView
                android:id="@+id/status_result_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/json_editor_view"
                app:layout_constraintVertical_bias="0"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_run"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:src="@drawable/ic_m_runner"
        app:backgroundTint="@color/blue_250"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_m_copy_compact"
        app:backgroundTint="@color/blue_200"
        app:layout_constraintBottom_toTopOf="@+id/fab_run"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
