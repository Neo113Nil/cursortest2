<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customBlockRoot"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_6"
    android:layout_marginBottom="@dimen/dimen_12"
    android:maxWidth="320dp"
    android:layout_marginStart="@dimen/dimen_12"
    android:layout_marginEnd="@dimen/dimen_12">
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:id="@+id/removeIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        app:layout_constraintEnd_toEndOf="@+id/customBlockRoot"
        app:layout_constraintTop_toTopOf="@+id/customBlockRoot"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/customBlockIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/dimen_6"
        android:layout_marginVertical="@dimen/dimen_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:ellipsize="end"
        android:id="@+id/customBlockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="252dp"
        android:layout_marginStart="@dimen/dimen_6"
        app:layout_constraintBottom_toTopOf="@+id/barrierH"
        app:layout_constraintEnd_toStartOf="@+id/labeledIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/customBlockIcon"
        app:layout_constraintTop_toTopOf="@+id/customBlockIcon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.android.messenger.utils.view.LabeledIconView
        android:id="@+id/labeledIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_4"
        android:layout_marginEnd="@dimen/dimen_24"
        app:layout_constraintBottom_toBottomOf="@+id/customBlockTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/customBlockTitle"
        app:layout_constraintTop_toTopOf="@+id/customBlockTitle"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierH"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="customBlockTitle"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/customBlockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_2"
        android:maxWidth="252dp"
        android:layout_marginStart="@dimen/dimen_6"
        android:layout_marginEnd="@dimen/dimen_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/customBlockIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/customBlockIcon"
        app:layout_constraintTop_toBottomOf="@+id/barrierH"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
