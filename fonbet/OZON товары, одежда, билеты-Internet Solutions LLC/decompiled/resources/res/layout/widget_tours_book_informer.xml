<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/toursBookInformerTitleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        android:layout_marginVertical="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/toursBookInformerIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/toursBookInformerIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/toursBookInformerTitleTav"
        app:layout_constraintEnd_toStartOf="@+id/tourBookInformerInfoButtonSibv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/toursBookInformerTitleTav"
        app:layout_constraintTop_toTopOf="@+id/toursBookInformerTitleTav"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.icons.SmallIconButtonView
        android:id="@+id/tourBookInformerInfoButtonSibv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/toursBookInformerTitleTav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toursBookInformerTitleTav"/>
</androidx.constraintlayout.widget.ConstraintLayout>
