<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/returnPolicyAccentPlaqLL"
        android:background="@drawable/bg_rounded_primary_12"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/returnPolicyIconTV"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/returnPolicyRouteTV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/returnPolicyRouteTV"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:layout_gravity="center_horizontal"
        android:id="@+id/returnPolicyRouteTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/returnPolicyIconTV"
        app:layout_constraintTop_toBottomOf="@+id/returnPolicyAccentPlaqLL"
        app:layout_goneMarginStart="0dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/returnPolicyPolicyTextLL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/returnPolicyRouteTV"/>
</merge>
