<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.media3.ui.PlayerView
        android:id="@+id/exoPlayerV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/playerControlsView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:resize_mode="fit"
        app:shutter_background_color="@color/transparent"
        app:surface_type="texture_view"
        app:use_controller="false"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/videoPreviewIv"
        android:background="?attr/graphicLightKey"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/exoPlayerV"
        app:layout_constraintEnd_toEndOf="@+id/exoPlayerV"
        app:layout_constraintStart_toStartOf="@+id/exoPlayerV"
        app:layout_constraintTop_toTopOf="@+id/exoPlayerV"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/playerControlsButtonIv"
        android:background="@drawable/bg_circle_layer_overlay_dimming"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_m_play_sign_filled"
        android:scaleType="fitCenter"
        android:tint="?attr/graphicLightKey"
        app:layout_constraintBottom_toBottomOf="@+id/exoPlayerV"
        app:layout_constraintEnd_toEndOf="@+id/exoPlayerV"
        app:layout_constraintStart_toStartOf="@+id/exoPlayerV"
        app:layout_constraintTop_toTopOf="@+id/exoPlayerV"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/soundControlIv"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="visible"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_l_volume_filled"
        app:layout_constraintEnd_toEndOf="@+id/exoPlayerV"
        app:layout_constraintTop_toTopOf="@+id/exoPlayerV"
        app:tint="?attr/graphicLightKey"/>
    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/playerPb"
        android:layout_width="46dp"
        android:layout_height="46dp"
        app:layout_constraintBottom_toBottomOf="@+id/exoPlayerV"
        app:layout_constraintEnd_toEndOf="@+id/exoPlayerV"
        app:layout_constraintStart_toStartOf="@+id/exoPlayerV"
        app:layout_constraintTop_toTopOf="@+id/exoPlayerV"
        style="?android:attr/progressBarStyleInverse"/>
    <androidx.media3.ui.LegacyPlayerControlView
        android:id="@+id/playerControlsView"
        android:paddingTop="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:paddingHorizontal="14dp"
        app:controller_layout_id="@layout/view_hotels_gallery_full_video_control_panel_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exoPlayerV"
        app:show_timeout="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
