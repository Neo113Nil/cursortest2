<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.image.Image
        android:id="@+id/additionalServicesImageI"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/additionalServicesSubtitleTAV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/additionalServicesTitleTAV"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/additionalServicesTitleTAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/additionalServicesTitleInfoButtonIBV"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/additionalServicesImageI"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.controls.buttonV3.IconButtonV3View
        android:id="@+id/additionalServicesTitleInfoButtonIBV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/additionalServicesTitleTAV"
        app:layout_constraintEnd_toStartOf="@+id/additionalServiceBarrierB"
        app:layout_constraintStart_toEndOf="@+id/additionalServicesTitleTAV"
        app:layout_constraintTop_toTopOf="@+id/additionalServicesTitleTAV"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/additionalServicesSubtitleTAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/additionalServiceBarrierB"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/additionalServicesTitleTAV"
        app:layout_constraintTop_toBottomOf="@+id/additionalServicesTitleTAV"/>
    <ru.ozon.app.android.travel.molecules.view.shimmer.RoundedShimmerView
        android:id="@+id/additionalServicesSubtitleSkeletonRSV"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/additionalServicesSubtitleTAV"
        app:layout_constraintEnd_toEndOf="@+id/additionalServicesSubtitleTAV"
        app:layout_constraintStart_toStartOf="@+id/additionalServicesSubtitleTAV"
        app:layout_constraintTop_toTopOf="@+id/additionalServicesSubtitleTAV"
        app:rsvBackgroundTint="?attr/bgSecondary"
        app:rsvCornersRadius="6dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/additionalServiceBarrierB"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:barrierMargin="-8dp"
        app:constraint_referenced_ids="additionalServicesButtonBV,additionalServicesToggleTV,additionalServicesCounterInputCIV"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/additionalServicesButtonBV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/additionalServicesImageI"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/additionalServiceBarrierB"
        app:layout_constraintTop_toTopOf="@+id/additionalServicesImageI"/>
    <ru.ozon.uni.android.atom.selectionControls.ToggleView
        android:id="@+id/additionalServicesToggleTV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/additionalServicesImageI"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/additionalServiceBarrierB"
        app:layout_constraintTop_toTopOf="@+id/additionalServicesImageI"/>
    <ru.ozon.app.android.travel.molecules.view.counterInput.v2.CounterInputV2View
        android:id="@+id/additionalServicesCounterInputCIV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/additionalServicesImageI"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/additionalServiceBarrierB"
        app:layout_constraintTop_toTopOf="@+id/additionalServicesImageI"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/additionalServicesTariffItemsRV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/additionalServicesSubtitleTAV"/>
    <Space
        android:id="@+id/additionalServicesBottomSpaceS"
        android:layout_width="0dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/additionalServicesTariffItemsRV"/>
    <View
        android:id="@+id/additionalServicesSeparatorV"
        android:background="?attr/graphicNeutral"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/additionalServicesTitleTAV"/>
</androidx.constraintlayout.widget.ConstraintLayout>
