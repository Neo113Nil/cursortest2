<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemCv"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/layer_floor_2"
    app:cardCornerRadius="6dp"
    app:cardElevation="12dp">
    <FrameLayout
        android:background="@drawable/ripple_rect_bluewave"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:textAppearance="@style/TextStyle.Body.M"
                android:layout_gravity="center_vertical"
                android:id="@+id/titleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:textAppearance="@style/TextStyle.Caption.Gray60"
                android:layout_gravity="center_vertical"
                android:id="@+id/subtitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
