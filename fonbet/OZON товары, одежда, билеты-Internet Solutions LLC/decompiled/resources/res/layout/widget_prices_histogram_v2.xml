<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/titlePricesHistogramV2TAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/selectedDatesPricesHistogramV2TAV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titlePricesHistogramV2TAV"/>
    <ru.ozon.uni.android.controls.chip.ChipView
        android:id="@+id/chipTherePricesHistogramV2CV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selectedDatesPricesHistogramV2TAV"/>
    <ru.ozon.uni.android.controls.chip.ChipView
        android:id="@+id/chipBackPricesHistogramV2CV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/chipTherePricesHistogramV2CV"
        app:layout_constraintTop_toBottomOf="@+id/selectedDatesPricesHistogramV2TAV"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/selectedPricesHistogramV2TAV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chipTherePricesHistogramV2CV"
        app:layout_goneMarginTop="18dp"/>
    <ImageView
        android:id="@+id/arrowIconPricesHistogramV2IV"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_s_down"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selectedPricesHistogramV2TAV"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/daysPricesHistogramV2RV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/arrowIconPricesHistogramV2IV"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/monthsPricesHistogramV2RV"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/daysPricesHistogramV2RV"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/leftMonthPricesHistogramV2TV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/monthsPricesHistogramV2RV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/monthsPricesHistogramV2RV"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/rightMonthPricesHistogramV2TV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/monthsPricesHistogramV2RV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/monthsPricesHistogramV2RV"/>
    <FrameLayout
        android:id="@+id/toggleWrapperPricesHistogramV2FL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/monthsPricesHistogramV2RV">
        <ru.ozon.uni.android.cell.selection.toggle.ToggleTitleSubtitleCellView
            android:id="@+id/togglePricesHistogramV2TTSCV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/findTicketsPricesHistogramV2BV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toggleWrapperPricesHistogramV2FL"/>
</androidx.constraintlayout.widget.ConstraintLayout>
