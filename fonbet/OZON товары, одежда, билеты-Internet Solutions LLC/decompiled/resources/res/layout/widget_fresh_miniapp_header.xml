<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniappHeaderRootContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimen_48"
    android:layout_marginEnd="@dimen/dimen_56">
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/miniappIcon"
        android:background="@color/graphic_dark_key"
        android:layout_width="@dimen/dimen_32"
        android:layout_height="@dimen/dimen_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/miniappTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8"
        app:layout_constraintStart_toEndOf="@+id/miniappIcon"
        app:layout_constraintTop_toTopOf="@+id/miniappIcon"/>
    <View
        android:id="@+id/dotView"
        android:background="@drawable/item_dot"
        android:layout_width="@dimen/dimen_4"
        android:layout_height="@dimen/dimen_4"
        android:layout_marginStart="@dimen/dimen_6"
        app:layout_constraintBottom_toBottomOf="@+id/miniappTitle"
        app:layout_constraintStart_toEndOf="@+id/miniappTitle"
        app:layout_constraintTop_toTopOf="@+id/miniappTitle"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/timeDeliveryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_6"
        android:layout_marginEnd="@dimen/dimen_16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/miniappTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/dotView"
        app:layout_constraintTop_toTopOf="@+id/miniappTitle"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/timeDeliveryIcon"
        android:layout_width="@dimen/dimen_16"
        android:layout_height="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/timeDeliveryTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/timeDeliveryTitle"
        app:layout_constraintTop_toTopOf="@+id/timeDeliveryTitle"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/addressTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/miniappTitle"
        app:layout_constraintTop_toBottomOf="@+id/miniappTitle"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/addressDownIcon"
        android:padding="@dimen/dimen_2"
        android:layout_width="@dimen/dimen_12"
        android:layout_height="@dimen/dimen_12"
        android:src="@drawable/ic_s_chevron_down"
        android:layout_marginEnd="@dimen/dimen_10"
        app:iconViewSize="icon_200"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/addressTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/addressTitle"
        app:layout_constraintTop_toTopOf="@+id/addressTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
