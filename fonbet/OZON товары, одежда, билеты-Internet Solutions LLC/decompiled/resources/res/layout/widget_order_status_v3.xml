<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="74dp">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/titleTextTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_3"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_4"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTextTvTv"
        app:layout_constraintEnd_toStartOf="@+id/circleProgressIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/subtitleTextTvTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_3"
        android:layout_marginEnd="@dimen/dimen_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/circleProgressIndicator"
        app:layout_constraintStart_toStartOf="@+id/titleTextTv"
        app:layout_constraintTop_toBottomOf="@+id/titleTextTv"/>
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/progressIcon"
        android:background="?attr/layerFloor0"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/circleProgressIndicator"
        app:layout_constraintEnd_toEndOf="@+id/circleProgressIndicator"
        app:layout_constraintStart_toStartOf="@+id/circleProgressIndicator"
        app:layout_constraintTop_toTopOf="@+id/circleProgressIndicator"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/minTitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_1"
        app:layout_constraintBottom_toTopOf="@+id/minSubtitle"
        app:layout_constraintEnd_toEndOf="@+id/circleProgressIndicator"
        app:layout_constraintStart_toStartOf="@+id/circleProgressIndicator"
        app:layout_constraintTop_toTopOf="@+id/circleProgressIndicator"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/minSubtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/circleProgressIndicator"
        app:layout_constraintStart_toStartOf="@+id/circleProgressIndicator"
        app:layout_constraintTop_toBottomOf="@+id/minTitle"/>
    <ru.ozon.app.android.fresh.geo.widgets.orderStatus.v3.presentation.SegmentedCircleProgressIndicator
        android:id="@+id/circleProgressIndicator"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_marginStart="@dimen/dimen_8"
        android:layout_marginEnd="@dimen/dimen_16"
        app:backgroundColor="?attr/graphicNeutral"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
