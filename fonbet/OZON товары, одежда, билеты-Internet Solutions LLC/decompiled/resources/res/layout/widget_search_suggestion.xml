<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_white_ripple_blue"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imageIv"
        android:padding="8dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_disclosure_gray"/>
    <ImageView
        android:id="@+id/productIv"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@null"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageIv"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/brandIv"
        android:layout_width="@dimen/category_icon"
        android:layout_height="@dimen/category_icon"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/typeImageIv"
        android:visibility="gone"
        android:layout_width="@dimen/type_icon"
        android:layout_height="@dimen/type_icon"
        android:contentDescription="@null"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L"
        android:ellipsize="marquee"
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollHorizontally="false"
        android:marqueeRepeatLimit="0"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/breadcrumbsTv"
        app:layout_constraintEnd_toStartOf="@+id/productIv"
        app:layout_constraintStart_toEndOf="@+id/brandIv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="12dp"
        app:layout_goneMarginStart="48dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption"
        android:textColor="@color/text_secondary"
        android:ellipsize="marquee"
        android:id="@+id/breadcrumbsTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollHorizontally="false"
        android:singleLine="true"
        android:marqueeRepeatLimit="0"
        app:layout_constraintBottom_toTopOf="@+id/priceTv"
        app:layout_constraintEnd_toEndOf="@+id/titleTv"
        app:layout_constraintStart_toStartOf="@+id/titleTv"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"
        app:layout_goneMarginBottom="12dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:textColor="@color/text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:scrollHorizontally="false"
        android:marqueeRepeatLimit="0"
        app:layout_constraintBottom_toTopOf="@+id/priceTv"
        app:layout_constraintEnd_toEndOf="@+id/titleTv"
        app:layout_constraintStart_toStartOf="@+id/titleTv"
        app:layout_constraintTop_toBottomOf="@+id/titleTv"
        app:layout_goneMarginBottom="8dp"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:textStyle="bold"
        android:ellipsize="marquee"
        android:id="@+id/priceTv"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollHorizontally="false"
        android:singleLine="true"
        android:marqueeRepeatLimit="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/titleTv"
        app:layout_constraintStart_toStartOf="@+id/titleTv"
        app:layout_constraintTop_toBottomOf="@+id/breadcrumbsTv"/>
    <View
        android:id="@+id/overlayView"
        android:background="@color/layer_overlay_paranja"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/rocketIv"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_rocket_wrapper"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/divider"
        android:background="?attr/layerSurface"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/dimen_48"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
