<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">
    <View
        android:id="@+id/premiumHeaderBgV"
        android:background="@drawable/shape_premium_block_header"
        android:layout_width="0dp"
        android:layout_height="117dp"
        android:layout_marginTop="23dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.M"
        android:textColor="@color/graphic_primary_on_light"
        android:id="@+id/badgeTv"
        android:background="@drawable/shape_premium_badge"
        android:paddingTop="7dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:translationY="-6dp"
        android:paddingStart="19dp"
        android:paddingEnd="19dp"
        app:layout_constraintBottom_toTopOf="@+id/premiumHeaderBgV"
        app:layout_constraintEnd_toEndOf="@+id/premiumHeaderBgV"
        app:layout_constraintStart_toStartOf="@+id/premiumHeaderBgV"
        app:layout_constraintTop_toTopOf="@+id/premiumHeaderBgV"/>
    <ImageView
        android:id="@+id/premiumLogoIv"
        android:layout_width="wrap_content"
        android:layout_height="66dp"
        android:layout_marginTop="18dp"
        android:scaleType="fitStart"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/premiumHeaderBgV"
        app:layout_constraintTop_toTopOf="@+id/premiumHeaderBgV"/>
    <ru.ozon.uni.atoms.af.layout.VerticalAtomsLayout
        android:id="@+id/subtitlesVAL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/premiumLogoIv"/>
    <View
        android:id="@+id/premiumBodyBgV"
        android:background="@drawable/shape_premium_block_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/buttonFAL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/premiumHeaderBgV"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/recurrentPriceFAL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/premiumHeaderBgV"/>
    <ru.ozon.uni.android.uikit.view.atoms.price.PriceView
        android:id="@+id/totalPriceFAL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recurrentPriceFAL"/>
    <ru.ozon.app.android.atoms.af.layout.FrameAtomsLayout
        android:id="@+id/benefitsFAL"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="56dp"
        app:childGravity="start|top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/totalPriceFAL"/>
    <ru.ozon.app.android.atoms.af.layout.FrameAtomsLayout
        android:id="@+id/buttonFAL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/premiumBodyBgV"
        app:layout_constraintStart_toStartOf="@+id/premiumBodyBgV"
        app:layout_constraintTop_toBottomOf="@+id/benefitsFAL"/>
</androidx.constraintlayout.widget.ConstraintLayout>
