<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="10dp">
    <FrameLayout
        android:id="@+id/banner"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/bannerIv"
            android:layout_width="83dp"
            android:layout_height="83dp"
            android:scaleType="fitCenter"
            android:elevation="4dp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/bg_banner_arrow"
        android:alpha="0"
        android:layout_marginStart="80dp"
        app:layout_constraintBottom_toBottomOf="@+id/banner"
        app:layout_constraintStart_toStartOf="@+id/banner"
        app:layout_constraintTop_toTopOf="@+id/banner"
        app:layout_constraintVertical_bias="0.43"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/OzonTextAppearance.CompactControl.300xsmall"
        android:textColor="@color/text_primary_on_dark"
        android:ellipsize="end"
        android:id="@+id/hintTv"
        android:background="@drawable/bg_banner_hint"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:alpha="0"
        android:textAlignment="center"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/arrow"
        app:layout_constraintStart_toStartOf="@+id/arrow"
        app:layout_constraintTop_toTopOf="@+id/arrow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
