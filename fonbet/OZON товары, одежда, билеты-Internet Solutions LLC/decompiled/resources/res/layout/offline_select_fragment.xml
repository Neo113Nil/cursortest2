<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/layer_floor_1"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.ozon.fintech.ui.toolbar.FinToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:elevation="0dp"
        app:buttonGravity=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.MyApp.ToolBar"/>
    <HorizontalScrollView
        android:id="@+id/badges"
        android:background="@drawable/background_rounded_floor1_24_bottom"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">
            <ru.ozon.fintech.ui.badgekit.BadgeKitView
                android:id="@+id/left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"/>
            <ru.ozon.fintech.ui.badgekit.BadgeKitView
                android:id="@+id/right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <View
        android:id="@+id/separator"
        android:background="@color/layer_floor_0"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/badges"/>
    <View
        android:id="@+id/input_holder"
        android:background="@drawable/background_rounded_floor1_16_top"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_80"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/separator"/>
    <ru.ozon.fintech.ui.input.InputView
        android:id="@+id/input_contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginBottom="@dimen/dimen_8"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="@+id/input_holder"
        app:layout_constraintEnd_toEndOf="@+id/input_holder"
        app:layout_constraintStart_toStartOf="@+id/input_holder"
        app:layout_constraintTop_toTopOf="@+id/input_holder"/>
    <ru.ozon.fintech.ui.input.InputView
        android:id="@+id/input_bank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginBottom="@dimen/dimen_8"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="@+id/input_holder"
        app:layout_constraintEnd_toEndOf="@+id/input_holder"
        app:layout_constraintStart_toStartOf="@+id/input_holder"
        app:layout_constraintTop_toTopOf="@+id/input_holder"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/oz_semantic_text_secondary"
        android:gravity="center_vertical"
        android:id="@+id/text_bank_sbp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_36"
        android:text="@string/offline_bank_sbp"
        android:drawablePadding="8dp"
        android:layout_marginStart="@dimen/dimen_16"
        app:drawableEndCompat="@drawable/ic_m_multicolor_sbp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_holder"
        style="@style/OzonTextAppearance.Body.500medium"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_bank_sbp"/>
    <ru.ozon.fintech.permissions.ui.PermissionsScreenStateView
        android:id="@+id/permissions_screen_state"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
