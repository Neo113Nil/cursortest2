<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/navbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/navbar_widget_nps"/>
    <View
        android:id="@+id/partialBackground"
        android:background="@drawable/bg_nps_rating_partial"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="32dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonNext"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navbar"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:letterSpacing="0"
        android:layout_marginHorizontal="36dp"
        app:layout_constraintLeft_toLeftOf="@+id/partialBackground"
        app:layout_constraintRight_toRightOf="@+id/partialBackground"
        app:layout_constraintTop_toTopOf="@+id/partialBackground"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:gravity="center"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:letterSpacing="0"
        android:layout_marginHorizontal="36dp"
        app:layout_constraintLeft_toLeftOf="@+id/partialBackground"
        app:layout_constraintRight_toRightOf="@+id/partialBackground"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ratingImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/leftSelectorDescription"
        app:layout_constraintLeft_toLeftOf="@+id/partialBackground"
        app:layout_constraintRight_toRightOf="@+id/partialBackground"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/leftSelectorDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:letterSpacing="0"
        app:layout_constraintBottom_toTopOf="@+id/selector"
        app:layout_constraintLeft_toLeftOf="@+id/selector"
        app:layout_constraintRight_toLeftOf="@+id/rightSelectorDescription"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:gravity="right"
        android:id="@+id/rightSelectorDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:letterSpacing="0"
        app:layout_constraintBottom_toTopOf="@+id/selector"
        app:layout_constraintLeft_toRightOf="@+id/leftSelectorDescription"
        app:layout_constraintRight_toRightOf="@+id/selector"/>
    <ru.ozon.app.android.storefront.widgets.feedback.npsRating.presentation.NpsRatingSelectorView
        android:id="@+id/selector"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/partialBackground"
        app:layout_constraintLeft_toLeftOf="@+id/partialBackground"
        app:layout_constraintRight_toRightOf="@+id/partialBackground"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.LargeButtonView
        android:id="@+id/buttonNext"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
