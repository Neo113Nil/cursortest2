<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_secondary"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/errorLogoIv"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@+id/errorTitleTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/errorTitleTv"
        android:layout_width="265dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/errorDescTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorLogoIv"
        app:layout_constraintVertical_chainStyle="spread"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/TextStyle.Body.M.Black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/errorDescTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:minHeight="42dp"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16"
        app:layout_constraintBottom_toTopOf="@+id/screenStateActionBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorTitleTv"
        app:layout_constraintVertical_chainStyle="spread"/>
    <ru.ozon.uni.android.controls.button.ButtonView
        android:id="@+id/screenStateActionBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/errorDescTv"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.SmallButtonView
        android:id="@+id/screenStateSecondaryActionBtn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:text="@string/ozonid_error_antibot_support_button"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/screenStateActionBtn"
        style="@style/SmallBorderlessButtonBold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/closeButton"
        android:background="@drawable/bg_ozon_id_navigation_close"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_s_cross"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/graphic_tertiary"/>
</merge>
