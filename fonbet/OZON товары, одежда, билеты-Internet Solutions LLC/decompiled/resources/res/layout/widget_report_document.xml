<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/reportDocumentTitleTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/reportDocumentTextTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reportDocumentTitleTAV"/>
    <ru.ozon.app.android.travel.molecules.view.commonInput.v1.view.CommonDateInputView
        android:id="@+id/reportDocumentFromDateCDIV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/reportDocumentSeparatorV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reportDocumentTextTAV"/>
    <View
        android:id="@+id/reportDocumentSeparatorV"
        android:background="@color/graphic_solid_neutral"
        android:layout_width="14dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/reportDocumentFromDateCDIV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/reportDocumentFromDateCDIV"/>
    <ru.ozon.app.android.travel.molecules.view.commonInput.v1.view.CommonDateInputView
        android:id="@+id/reportDocumentToDateCDIV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/reportDocumentSeparatorV"
        app:layout_constraintTop_toTopOf="@+id/reportDocumentFromDateCDIV"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/dateGroupG"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="reportDocumentFromDateCDIV, reportDocumentSeparatorV, reportDocumentToDateCDIV"/>
    <ru.ozon.app.android.travel.molecules.view.commonInput.v1.view.CommonTextInputView
        android:id="@+id/reportDocumentEmailCDIV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reportDocumentFromDateCDIV"
        app:layout_goneMarginTop="16dp"/>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.LargeButtonView
        android:id="@+id/reportDocumentButtonLBV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reportDocumentEmailCDIV"/>
</androidx.constraintlayout.widget.ConstraintLayout>
