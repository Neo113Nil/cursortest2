    android:background="?attr/layerFloor1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.storefront.core.atoms.views.openRangeFilter.OpenRangeFilterView
        android:id="@+id/openRangeFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>
    <View
        android:id="@+id/openRangeFilterSeparator"
        android:background="?attr/graphicNeutral"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"/>
</LinearLayout>
