<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/scrollToLastIv"
        android:background="@drawable/m_ripple_tetriary_circular"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/dimen_4"
        android:layout_marginBottom="@dimen/dimen_16"
        android:src="@drawable/m_ic_m_arrow_bottom"
        android:elevation="6dp"
        android:layout_marginHorizontal="@dimen/dimen_16"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Caption.Bold"
        android:textColor="?attr/textExpress"
        android:layout_gravity="center_horizontal"
        android:id="@+id/unreadCountTv"
        android:background="@drawable/m_bg_unread_counter"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:elevation="6dp"
        android:paddingHorizontal="4dp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@+id/scrollToLastIv"
        app:layout_constraintEnd_toEndOf="@+id/scrollToLastIv"
        app:layout_constraintStart_toStartOf="@+id/scrollToLastIv"
        app:layout_constraintTop_toTopOf="@+id/scrollToLastIv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
