<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/hotelsRoomsDetailsFullImagesRv"
        android:layout_width="0dp"
        android:layout_height="206dp"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.travel.molecules.view.indicator.DottedIndicatorView
        android:id="@+id/hotelsRoomsDetailsFullDotsDiv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:divDeafultDotColor="@color/bg_overlap"
        app:divDefaultDotRadius="2dp"
        app:divHighlightedDotColor="?attr/bgPrimary"
        app:divHighlightedDotLength="8dp"
        app:divSpacing="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/hotelsRoomsDetailsFullImagesRv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/hotelsRoomsDetailsFullPhotosGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="hotelsRoomsDetailsFullImagesRv,hotelsRoomsDetailsFullDotsDiv"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/hotelsRoomsDetailsFullTitleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/hotelsRoomsDetailsFullBadgeBv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hotelsRoomsDetailsFullImagesRv"
        app:layout_goneMarginEnd="16dp"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/hotelsRoomsDetailsFullBadgeBv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/hotelsRoomsDetailsFullTitleTav"
        app:layout_constraintTop_toTopOf="@+id/hotelsRoomsDetailsFullTitleTav"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/hotelsRoomsDetailsFullSubtitleTav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hotelsRoomsDetailsFullTitleTav"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/hotelsRoomsDetailsFullInfoCardsRv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hotelsRoomsDetailsFullSubtitleTav"/>
</androidx.constraintlayout.widget.ConstraintLayout>
