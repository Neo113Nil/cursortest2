<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mergeAccountOzonIdContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/logoImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_ozon_id_logo"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Headline.700xlarge"
        android:id="@+id/titleTextAtomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoImageView"/>
    <ru.ozon.uni.android.atom.image.Image
        android:id="@+id/userImage"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/dimen_20"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextAtomView"
        app:layout_goneMarginTop="@dimen/dimen_0"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/userName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/userPhone"
        app:layout_constraintStart_toStartOf="@+id/userPhone"
        app:layout_goneMarginTop="@dimen/dimen_0"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/userPhone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12"
        app:layout_constraintBottom_toBottomOf="@+id/userImage"
        app:layout_constraintStart_toEndOf="@+id/userImage"
        app:layout_constraintTop_toTopOf="@+id/userImage"
        app:layout_goneMarginTop="@dimen/dimen_0"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:id="@+id/userMail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/userPhone"
        app:layout_constraintTop_toBottomOf="@+id/userPhone"
        app:layout_goneMarginTop="@dimen/dimen_0"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomUserInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="userImage, userMail, userName, userPhone"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/OzonTextAppearance.Body.500medium"
        android:textColor="@color/text_secondary"
        android:id="@+id/descriptionTextAtomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomUserInfo"/>
    <ru.ozon.uni.android.controls.buttonV3.ButtonV3View
        android:id="@+id/submitButton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/descriptionTextAtomView"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textColor="@color/text_secondary"
        android:id="@+id/termOfUse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginHorizontal="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/submitButton"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/hintButtonsLinearLayout"
        android:nextFocusUp="@+id/disclaimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
