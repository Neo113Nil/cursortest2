<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginStart="36dp">
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/TextStyle.Body.L"
        android:id="@+id/deliveryTitleTav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/deliverySubtitleTav"
        app:layout_constraintEnd_toStartOf="@+id/disclosureIv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.uni.android.atom.text.TextAtomV2View
        android:textAppearance="@style/TextStyle.Body.M.Gray60"
        android:id="@+id/deliverySubtitleTav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/deliveryTitleTav"
        app:layout_constraintStart_toStartOf="@+id/deliveryTitleTav"
        app:layout_constraintTop_toBottomOf="@+id/deliveryTitleTav"/>
    <ImageView
        android:id="@+id/disclosureIv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_s_disclosure"
        android:contentDescription="@null"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/deliveryTitleTav"/>
</androidx.constraintlayout.widget.ConstraintLayout>
