<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatGroupRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="82dp">
    <ru.ozon.uni.android.atom.icon.IconView
        android:id="@+id/groupIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/dimen_8"
        android:layout_marginHorizontal="11dp"
        app:layout_constraintBottom_toTopOf="@+id/groupNameTv"
        app:layout_constraintEnd_toEndOf="@+id/groupNameTv"
        app:layout_constraintStart_toStartOf="@+id/groupNameTv"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/OzonTextAppearance.Body.300xsmall"
        android:textColor="?attr/textPrimary"
        android:id="@+id/groupNameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_8"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/groupIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ru.ozon.uni.android.atom.indicator.ui.IndicatorView
        android:id="@+id/groupUnreadCountIndicator"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_16"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:paddingHorizontal="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/groupIcon"
        app:layout_constraintTop_toTopOf="@+id/groupIcon"/>
    <View
        android:id="@+id/groupIndicator"
        android:background="@drawable/m_bg_chat_group_select"
        android:layout_width="@dimen/dimen_56"
        android:layout_height="4dp"
        android:layout_marginHorizontal="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
