<?xml version="1.0" encoding="utf-8"?>
<ru.ozon.android.messenger.utils.view.TripleBalancedCenterLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatListHeaderRoot"
    android:paddingTop="@dimen/dimen_4"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimen_56"
    android:layout_marginBottom="@dimen/dimen_2">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/backIv"
        android:background="@drawable/m_ripple_circle_white"
        android:padding="10dp"
        android:layout_width="@dimen/dimen_44"
        android:layout_height="@dimen/dimen_44"
        android:src="@drawable/ic_m_disclosure_back_filled"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/dimen_6"
        app:m_layout_role="left"
        app:tint="@color/graphic_tertiary"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/navbarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:m_layout_role="center"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/menuItemsContainer"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        app:m_layout_role="right"/>
</ru.ozon.android.messenger.utils.view.TripleBalancedCenterLayout>
