<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/characteristicsPickCL"
    android:background="?attr/layerFloor1"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/backIV"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_back_ozon_menu"
        android:tint="?attr/textPrimary"
        android:contentDescription="@null"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/titleTV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/titleTV"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Bold"
        android:gravity="center"
        android:id="@+id/titleTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextStyle.Body.L.Blue"
        android:id="@+id/clearTV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_clear_android"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/titleTV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/titleTV"/>
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchV"
        android:background="@drawable/bg_search_bottom_sheet_sv"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="19dp"
        android:paddingStart="-12dp"
        android:paddingEnd="-8dp"
        android:layout_marginHorizontal="16dp"
        app:closeIcon="@drawable/ic_clear_black"
        app:iconifiedByDefault="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTV"
        app:queryBackground="@android:color/transparent"
        app:queryHint="@string/pdp_comparison_search_hint_android"
        app:searchIcon="@drawable/ic_search_bar"
        app:theme="@style/AppSearchViewNew"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/characteristicsListRV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toTopOf="@+id/buttonSA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchV"
        app:layout_constraintVertical_bias="0"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:id="@+id/buttonSA"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="3dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/characteristicsListRV"/>
</androidx.constraintlayout.widget.ConstraintLayout>
