<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.travel.molecules.view.input.TravelTextInputLayout
        android:id="@+id/commonInputTextInputMtil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        app:ttil_isMultiline="true"
        style="@style/OzTextInput.Layout">
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/commonInputTextInputEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/OzTextInput.EditText"/>
    </ru.ozon.app.android.travel.molecules.view.input.TravelTextInputLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Body.M.Red"
        android:id="@+id/commonInputTextInputErrorTv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
</merge>
