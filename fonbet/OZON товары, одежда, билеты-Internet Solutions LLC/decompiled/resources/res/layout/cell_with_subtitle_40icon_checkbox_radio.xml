<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/iconIv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_m_asterisk"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Body.L"
        android:id="@+id/titleTav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTav"
        app:layout_constraintEnd_toStartOf="@+id/radioButtonView"
        app:layout_constraintStart_toEndOf="@+id/iconIv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="10dp"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:textAppearance="@style/TextStyle.Body.M.Gray60"
        android:id="@+id/subtitleTav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/titleTav"
        app:layout_constraintStart_toStartOf="@+id/titleTav"
        app:layout_constraintTop_toBottomOf="@+id/titleTav"/>
    <View
        android:id="@+id/radioButtonView"
        android:background="@drawable/selector_checkbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/titleTav"/>
    <View
        android:id="@+id/separator"
        android:background="@color/oz_semantic_separator"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/titleTav"/>
</merge>
