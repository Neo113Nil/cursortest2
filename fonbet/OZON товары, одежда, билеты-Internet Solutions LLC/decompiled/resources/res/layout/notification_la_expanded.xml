<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <ImageView
        android:id="@+id/notification_logo"
        android:layout_width="48dp"
        android:layout_height="24dp"
        android:src="@drawable/logo_fresh"/>
    <TextView
        android:textAppearance="@style/LiveActivityText.Title.Expanded"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/notification_logo"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@+id/progress_bg"
        android:layout_alignParentStart="true"/>
    <Chronometer
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/title"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@+id/progress_bg"
        android:layout_alignParentStart="true"
        android:letterSpacing="0.025"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/target_progress_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/progress_bg"
        android:layout_alignBottom="@+id/progress_bg"
        android:layout_alignStart="@+id/progress_bg"
        android:layout_alignParentEnd="true">
        <TextView
            android:textAppearance="@style/LiveActivityText.Target.Title.Expanded"
            android:gravity="center_horizontal"
            android:id="@+id/target_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"/>
        <TextView
            android:textAppearance="@style/LiveActivityText.Target.Subtitle.Expanded"
            android:gravity="center_horizontal"
            android:id="@+id/target_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/estimated_progress_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/progress_bg"
        android:layout_alignBottom="@+id/progress_bg"
        android:layout_alignStart="@+id/progress_bg"
        android:layout_alignParentEnd="true">
        <TextView
            android:textAppearance="@style/LiveActivityText.Estimated.Title.Expanded"
            android:gravity="center_horizontal"
            android:id="@+id/estimated_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/LiveActivityText.Estimated.Subtitle.Expanded"
            android:gravity="center_horizontal"
            android:id="@+id/estimated_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/progress_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        android:layout_alignTop="@+id/progress_bg"
        android:layout_alignBottom="@+id/progress_bg"
        android:layout_alignStart="@+id/progress_bg"
        android:layout_alignParentEnd="true"
        android:elevation="2dp"/>
    <ImageView
        android:id="@+id/progress_bg"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:src="@drawable/bg_progress"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/progress_value"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:elevation="1dp"/>
    <Button
        android:textColor="@color/notification_fresh"
        android:id="@+id/action_button"
        android:background="@drawable/bg_live_activity_button"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/subtitle"
        android:textAllCaps="false"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:outlineProvider="none"/>
    <Button
        android:textColor="@color/notification_fresh"
        android:id="@+id/bottom_button"
        android:background="@drawable/bg_live_activity_button"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/subtitle"
        android:textAllCaps="false"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:outlineProvider="none"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/rating_bar"
        android:background="@drawable/bg_live_activity_rating"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/subtitle"
        android:paddingVertical="6dp">
        <ImageView
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_star"
            android:layout_marginHorizontal="12dp"/>
        <ImageView
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_star"
            android:layout_marginHorizontal="12dp"/>
        <ImageView
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_star"
            android:layout_marginHorizontal="12dp"/>
        <ImageView
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_star"
            android:layout_marginHorizontal="12dp"/>
        <ImageView
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_star"
            android:layout_marginHorizontal="12dp"/>
    </LinearLayout>
</RelativeLayout>
