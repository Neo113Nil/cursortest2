<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/default_margin">
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/titleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:gravity="center"
        android:id="@+id/subtitleTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/postIndexTil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/default_margin"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        style="@style/OzTextInput.Layout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/postIndexTiet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            style="@style/OzTextInput.EditText"/>
    </com.google.android.material.textfield.TextInputLayout>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.LargeButtonView
        android:id="@+id/submitLBV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_large"/>
</LinearLayout>
