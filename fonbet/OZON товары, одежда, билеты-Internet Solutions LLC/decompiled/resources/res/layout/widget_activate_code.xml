<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/oz_semantic_bg_secondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/containerLl"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iconIv"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="4dp"/>
        <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
            android:gravity="center"
            android:id="@+id/titleTav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.google.android.material.textfield.TextInputEditText
            android:enabled="false"
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            style="@style/OzTextInput.EditText.Favorites"/>
        <ru.ozon.uni.android.uikit.view.atoms.buttons.usual.LargeButtonView
            android:id="@+id/activateButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>
    <ru.ozon.uni.android.uikit.view.atoms.buttons.borderless.SmallBorderlessButtonView
        android:layout_gravity="center"
        android:id="@+id/termsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"/>
</LinearLayout>
