<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLl"
    android:background="?attr/oz_semantic_bg_secondary"
    android:paddingTop="4dp"
    android:paddingBottom="12dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/fg_sku_ripple"
    android:paddingHorizontal="16dp">
    <ru.ozon.app.android.universalwidgets.widgets.uw.sku.SkuImageWrapper
        android:id="@+id/adultIv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/overlayImage"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="center"
        app:layout_constraintDimensionRatio="3:2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.product.common.overlaytitle.OverlayTitleView
        android:id="@+id/overlayTitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/adultIv"
        app:layout_constraintEnd_toEndOf="@+id/adultIv"
        app:layout_constraintStart_toStartOf="@+id/adultIv"/>
    <ru.ozon.app.android.product.common.wave.WaveView
        android:id="@+id/waveView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/adultIv"
        app:layout_constraintEnd_toEndOf="@+id/adultIv"
        app:layout_constraintStart_toStartOf="@+id/adultIv"/>
    <ru.ozon.app.android.universalwidgets.widgets.uw.badgescontainer.BadgesContainerView
        android:id="@+id/badgesContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/adultIv"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toLeftOf="@+id/adultIv"
        app:layout_constraintRight_toRightOf="@+id/adultIv"
        app:layout_constraintVertical_bias="0"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/topRightButtonsRV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="@+id/adultIv"
        app:layout_constraintTop_toTopOf="@+id/adultIv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/stateVal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/adultIv"/>
    <View
        android:id="@+id/stateView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/stateVal"
        app:layout_constraintEnd_toEndOf="@+id/stateVal"
        app:layout_constraintStart_toStartOf="@+id/stateVal"
        app:layout_constraintTop_toTopOf="@+id/stateVal"
        app:layout_constraintWidth_default="wrap"/>
    <ru.ozon.uni.atoms.v3.containers.SingleAtom
        android:orientation="horizontal"
        android:id="@+id/productSa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stateVal"/>
    <ru.ozon.app.android.uikit.view.atoms.texts.TextAtomWithIconView
        android:id="@+id/buttonSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productSa"/>
</androidx.constraintlayout.widget.ConstraintLayout>
