<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/videoMolecule"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/touchArea"
        android:tag="@string/pdp_video_molecule_view_tag"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/playerControlsView"/>
    <View
        android:id="@+id/topGradient"
        android:tag="@string/pdp_video_molecule_view_tag"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.pdpvideomolecule.presentation.replay.VideoMoleculeReplayView
        android:id="@+id/replayContainer"
        android:tag="@string/pdp_video_molecule_view_tag"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/videoMoleculePlayPauseButtonContainer"
        android:tag="@string/pdp_video_molecule_view_tag"
        android:background="@drawable/pdp_video_molecule_button_bg"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_centerInParent="true">
        <ru.ozon.app.android.pdpvideomolecule.presentation.switchingimage.SwitchingImageView
            android:layout_gravity="center"
            android:id="@+id/videoMoleculePlayPauseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_m_pause_sign_filled"
            app:tint="?attr/bgLightKey"/>
    </FrameLayout>
    <View
        android:id="@+id/bottomGradient"
        android:tag="@string/pdp_video_molecule_view_tag"
        android:background="@drawable/pdp_video_molecule_bg_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="242dp"
        android:layout_alignParentBottom="true"/>
    <androidx.media3.ui.LegacyPlayerControlView
        android:id="@+id/playerControlsView"
        android:tag="@string/pdp_video_molecule_view_tag"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="14dp"
        app:controller_layout_id="@layout/pdp_video_molecule_control_panel"
        app:show_timeout="0"/>
</merge>
