        android:layout_height="wrap_content"/>
    <ru.ozon.uni.android.cell.text.TextFieldCellView
        android:id="@+id/inputField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
</LinearLayout>
