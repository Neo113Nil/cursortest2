<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/blockEmptyStateFl"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.ozon.android.messenger.blocks.common.SquircleLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/blockEmptyStateLl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:m_corner_top="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ru.ozon.uni.android.atom.image.Image
                android:id="@+id/emptyStateIv"
                android:layout_width="@dimen/m_empty_state_image_width"
                android:layout_height="@dimen/m_empty_state_image_width"
                app:layout_constraintBottom_toTopOf="@+id/emptyStateTitleTv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:id="@+id/emptyStateTitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/emptyStateDescriptionTv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/emptyStateIv"/>
            <ru.ozon.uni.android.atom.text.TextAtomV2View
                android:gravity="center"
                android:id="@+id/emptyStateDescriptionTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/emptyStateButtons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/emptyStateTitleTv"/>
            <ru.ozon.android.messenger.blocks.emptystate.v2.presentation.EmptyStateV2ButtonsHorizontalView
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/emptyStateButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:divider="@drawable/m_horizontal_divider_8"
                android:showDividers="middle"
                app:layout_constraintBottom_toTopOf="@+id/emptyStateBottomButtons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/emptyStateDescriptionTv"/>
            <ru.ozon.android.messenger.blocks.emptystate.v2.presentation.EmptyStateV2ButtonsVerticalView
                android:orientation="horizontal"
                android:id="@+id/emptyStateBottomButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_16"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ru.ozon.android.messenger.blocks.common.SquircleLinearLayout>
</LinearLayout>
