<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_travel_luggage_tab"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp">
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/luggageTabPriceSkeletonSpv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/luggageTabPriceTav"
        app:layout_constraintEnd_toEndOf="@+id/luggageTabPriceTav"
        app:layout_constraintStart_toStartOf="@+id/luggageTabPriceTav"
        app:layout_constraintTop_toTopOf="@+id/luggageTabPriceTav"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:gravity="center"
        android:id="@+id/luggageTabPriceTav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="6dp"/>
    <ru.ozon.app.android.travel.molecules.view.textCenteredImageView.TextCenteredImageView
        android:id="@+id/handCarryIconIv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/luggageTabPriceTav"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.ozon.app.android.travel.molecules.view.textCenteredImageView.TextCenteredImageView
        android:id="@+id/luggageIconIv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/handCarryCountTav"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="2dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Caption.Bold"
        android:textSize="10sp"
        android:textColor="?attr/textPrimary"
        android:id="@+id/handCarryCountTav"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/handCarryIconIv"
        app:layout_constraintStart_toEndOf="@+id/handCarryIconIv"
        app:layout_constraintTop_toTopOf="@+id/handCarryIconIv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextStyle.Caption.Bold"
        android:textSize="10sp"
        android:textColor="?attr/textPrimary"
        android:id="@+id/luggageCountTav"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/luggageIconIv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/luggageIconIv"
        app:layout_constraintTop_toTopOf="@+id/luggageIconIv"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/handCarrySkeleton"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/handCarryIconIv"
        app:layout_constraintEnd_toEndOf="@+id/handCarryCountTav"
        app:layout_constraintStart_toStartOf="@+id/handCarryIconIv"
        app:layout_constraintTop_toTopOf="@+id/handCarryIconIv"/>
    <ru.ozon.app.android.uikit.view.skeleton.SkeletonPlaceholderView
        android:id="@+id/luggageSkeleton"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/luggageIconIv"
        app:layout_constraintEnd_toEndOf="@+id/luggageCountTav"
        app:layout_constraintStart_toStartOf="@+id/luggageIconIv"
        app:layout_constraintTop_toTopOf="@+id/luggageIconIv"/>
</merge>
