<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/additionalServicesOfferImageIV"
        android:background="?attr/layerOverlayParanja"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedCorners4ImageStyle"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/additionalServicesOfferTitleTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/additionalServicesOfferSubtitleTAV"
        app:layout_constraintEnd_toStartOf="@+id/additionalServicesOfferBadgeBV"
        app:layout_constraintStart_toEndOf="@+id/additionalServicesOfferImageIV"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="12dp"/>
    <ru.ozon.uni.android.uikit.view.atoms.texts.TextAtomView
        android:id="@+id/additionalServicesOfferSubtitleTAV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/additionalServicesOfferTitleTAV"
        app:layout_constraintStart_toStartOf="@+id/additionalServicesOfferTitleTAV"
        app:layout_constraintTop_toBottomOf="@+id/additionalServicesOfferTitleTAV"/>
    <ru.ozon.uni.android.atom.badge.BadgeView
        android:id="@+id/additionalServicesOfferBadgeBV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/additionalServicesOfferDirectIconIV"
        app:layout_constraintEnd_toStartOf="@+id/additionalServicesOfferDirectIconIV"
        app:layout_constraintTop_toTopOf="@+id/additionalServicesOfferDirectIconIV"
        app:layout_goneMarginEnd="20dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/additionalServicesOfferDirectIconIV"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
