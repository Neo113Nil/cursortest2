<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recShelfShimmerLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.ozon.app.android.uikit.view.shimmer.ShimmerView
        android:id="@+id/shimmerView1"
        android:layout_width="130dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/skeleton1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginBottom="@dimen/dimen_16"
        android:layout_marginStart="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerView1"
        layout="@layout/widget_rec_shelf_item"/>
    <include
        android:id="@+id/skeleton2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="@+id/skeleton1"
        app:layout_constraintStart_toEndOf="@+id/skeleton1"
        app:layout_constraintTop_toTopOf="@+id/skeleton1"
        layout="@layout/widget_rec_shelf_item"/>
</merge>
