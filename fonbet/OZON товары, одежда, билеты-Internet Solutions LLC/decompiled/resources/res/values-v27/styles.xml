        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="FreshActivityTheme" parent="@style/FreshBaseActivityTheme">
        <item name="android:navigationBarColor">@color/oz_semantic_bg_secondary</item>
