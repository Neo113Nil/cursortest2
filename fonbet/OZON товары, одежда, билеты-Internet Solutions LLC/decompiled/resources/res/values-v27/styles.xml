        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/layer_floor_1</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="bottomSheetStyle">@style/RoundedBottomSheetModalBehavior</item>
    </style>
    <style name="SentryHelper.DebugActivity" parent="@style/SentryHelper">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="SheetDialogAdjust" parent="@style/SheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/layerFloor1</item>
        <item name="android:windowLightNavigationBar">true</item>
