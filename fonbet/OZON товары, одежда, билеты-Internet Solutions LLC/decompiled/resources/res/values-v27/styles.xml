        <item name="android:navigationBarColor">@color/oz_semantic_bg_secondary</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="OzonSelectTheme" parent="@style/OzonSelectBaseTheme">
        <item name="android:navigationBarColor">@color/layer_floor_1</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="splashScreenIconSize">288dp</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_select</item>
        <item name="windowSplashScreenBackground">@color/select_splash_screen_background</item>
    </style>
    <style name="OzonTheme" parent="@style/OzonBaseTheme">
        <item name="android:navigationBarColor">@color/oz_semantic_bg_secondary</item>
        <item name="android:windowLightNavigationBar">true</item>
