<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/stickers_keyboard_navigation_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/onboarding_image"
            android:layout_width="245dp"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:scaleType="center"
            app:layout_constraintBottom_toTopOf="@+id/create_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/create_left_header"/>
        <TextView
            android:textSize="18sp"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/create_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:text="@string/stickers_ugc_create_text"
            android:fontFamily="@font/vk_sans_display_medium"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintBottom_toTopOf="@+id/create"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/onboarding_image"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.FootnoteCaps"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/create_left_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scaleType="center"
            android:text="@string/stickers_ugc"
            android:layout_marginStart="16dp"
            android:lineHeight="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/hide_page_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            android:text="@string/stickers_ugc_hide_page"
            android:layout_marginEnd="16dp"
            android:lineHeight="20sp"
            app:layout_constraintBottom_toBottomOf="@+id/create_left_header"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/create_left_header"/>
        <TextView
            android:textSize="15sp"
            android:id="@+id/create"
            android:background="@drawable/bg_keyboard_vmoji_create"
            android:paddingTop="7.5dp"
            android:paddingBottom="8.5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/stickers_ugc_create"
            android:lineSpacingExtra="2sp"
            android:fontFamily="@font/vk_roboto_medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:letterSpacing="0.01"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/create_title"
            app:layout_constraintVertical_bias="0"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
