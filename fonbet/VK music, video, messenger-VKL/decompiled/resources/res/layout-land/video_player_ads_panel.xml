<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="@dimen/post_side_padding"
    android:paddingRight="@dimen/post_side_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.links.LinkedTextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:id="@+id/ads_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/post_side_padding"
        android:maxLines="2"
        android:layout_toLeftOf="@+id/ads_button"
        android:layout_centerVertical="true"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.AdsButton
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ads_button"
        android:background="@drawable/ads_button_inactive"
        android:paddingLeft="12dp"
        android:paddingTop="5dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="12dp"
        android:maxWidth="230dp"
        android:minWidth="100dp"
        android:maxLines="1"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
