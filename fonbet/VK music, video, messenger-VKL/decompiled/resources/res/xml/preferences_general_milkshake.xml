<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        android:title="@string/sett_app_entrance"
        android:key="app_biometrics_lock_category"
        app:layout="@layout/item_preference_category">
        <Preference
            android:layout="@layout/item_preference_with_value_new"
            android:title="@string/sett_app_biometrics_lock_title"
            android:key="app_biometrics_lock"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/sett_app"
        android:key="app"
        app:layout="@layout/item_preference_category">
        <com.vk.prefui.views.SummaryListPreference
            android:entries="@array/sett_font_size_options"
            android:layout="@layout/item_preference_with_value"
            android:title="@string/sett_font_size"
            android:key="fontSize"
            android:defaultValue="0"
            android:dialogTitle="@string/sett_font_size"
            android:entryValues="@array/sett_font_size_values"/>
        <com.vk.prefui.views.SummaryListPreference
            android:layout="@layout/item_preference_with_value"
            android:title="@string/sett_locale"
            android:key="locale"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_send_by_enter"
            android:key="sendByEnter"
            android:summary="@string/sett_send_by_enter_summary"
            android:defaultValue="false"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_chrome_custom_tabs"
            android:key="useChromeCustomTabs"
            android:summary="@string/sett_chrome_custom_tabs_summary"
            android:defaultValue="true"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_mytracker_location_crap"
            android:key="mytrackerLocationCrapEnabled"
            android:summary="@string/sett_mytracker_location_crap_summary"
            android:defaultValue="true"/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/sett_ads_privacy_options"
            android:key="ads_privacy_options"
            android:summary="@string/sett_ads_privacy_options_summary"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_mytracker_apps"
            android:key="trackInstalledApps"
            android:summary="@string/sett_mytracker_location_crap_summary"
            android:defaultValue="true"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:visibility="gone"
            android:layout="@layout/item_preference"
            android:title="@string/sett_use_proxy"
            android:key="useProxyServer"
            android:defaultValue="false"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_roaming_state"
            android:key="isRoamingState"
            android:summary="@string/sett_roaming_state_submit"
            android:defaultValue="false"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_adaptive_feed_media"
            android:key="adaptive_feed_media"
            android:summary="@string/sett_adaptive_feed_media_description"
            android:defaultValue="false"/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/app_redirects_preference_title"
            android:key="app_redirects"
            android:summary="@string/app_redirects_preference_summary"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_double_tap_like_title"
            android:key="doubleTapPostLike"
            android:summary="@string/sett_double_tap_like_summary"
            android:defaultValue="true"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_button_enable_stories"
            android:key="stories_messenger_enabled"
            android:defaultValue="true"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/sett_media"
        android:key="multimedia"
        app:layout="@layout/item_preference_category">
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_compress_photos"
            android:key="compressPhotos"
            android:defaultValue="true"
            app:singleLine="false"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_compress_videos"
            android:key="compressVideos"
            android:defaultValue="true"
            app:singleLine="false"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_save_processed_image"
            android:key="saveProcessedImage"
            android:defaultValue="true"
            app:singleLine="false"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_show_music_suggestion_notification"
            android:key="showMusicSuggestNotification"
            android:defaultValue="true"
            app:singleLine="false"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/vkim_settings_prefetch_audiomsg"
            android:key="prefetchAudioMsg"
            android:defaultValue="true"
            app:singleLine="false"/>
        <ListPreference
            android:entries="@array/sett_media_autoplay_entries"
            android:layout="@layout/item_preference"
            android:title="@string/sett_media_autoplay_title"
            android:key="video_autoplay"
            android:summary="%s"
            android:defaultValue="always"
            android:entryValues="@array/sett_media_autoplay_entry_values"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_video_background_title"
            android:key="video_background"
            android:summary="@string/sett_video_background_title_summary"
            android:defaultValue="true"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_music_download_mode"
            android:key="music_mobile_network_download"
            android:summary="@string/sett_music_download_mode_summary"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/sett_misc"
        android:key="misc"
        app:layout="@layout/item_preference_category">
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/stickers"
            android:key="stickersSettings"
            android:summary=""/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/sett_obscene_text_filter"
            android:key="obsceneTextFilter"
            android:summary=""/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/sett_navigation"
        android:key="navigation"
        app:layout="@layout/item_preference_category">
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:key="smartTab"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/sett_cache"
        android:key="cache"
        app:layout="@layout/item_preference_category">
        <com.vk.prefui.views.MaterialSwitchPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_enable_audio_cache"
            android:key="enableAudioCache"
            android:defaultValue="true"/>
        <com.vk.prefui.views.SummaryListPreference
            android:layout="@layout/item_preference"
            android:title="@string/sett_cache_location"
            android:key="audioCacheLocation"
            android:defaultValue=""
            android:dialogTitle="@string/sett_cache_location"/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/cache_my_music"
            android:key="downloadAudio"/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/sett_clear_audio_cache"
            android:key="clearAudioCache"
            android:summary=""/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/sett_clear_cache"
            android:key="clearCache"
            android:summary=""/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/sett_clear_messages_cache"
            android:key="clearMessagesCache"
            android:summary=""/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/sett_option_clear_all_without_logout"
            android:key="clearAllWithoutLogout"
            android:summary=""/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/sett_option_clear_all_and_logout"
            android:key="clearAllAndLogout"
            android:summary=""/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/sync_contacts_btn"
            android:key="syncContacts"
            android:summary="@string/sync_contacts_btn_description"/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/vkim_settings_clear_contacts"
            android:key="resetContacts"
            android:summary=""/>
    </PreferenceCategory>
</PreferenceScreen>
