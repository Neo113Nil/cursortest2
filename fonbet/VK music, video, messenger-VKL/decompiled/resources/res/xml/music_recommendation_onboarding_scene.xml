<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="@integer/music_recommendation_finish_anim_artist_length_ms"
        motion:motionInterpolator="easeOut">
        <KeyFrameSet>
            <KeyPosition
                motion:motionTarget="@+id/music_recommendation_onboarding_process_text_finish"
                motion:percentY="-0.25"/>
        </KeyFrameSet>
    </Transition>
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/music_recommendation_onboarding_process_image"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:lottie_autoPlay="false"
            motion:lottie_loop="false"
            motion:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/music_recommendation_onboarding_process_image_finish"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:lottie_autoPlay="false"
            motion:lottie_loop="false"
            motion:visibilityMode="ignore"/>
        <Constraint
            android:textSize="26sp"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:id="@+id/music_recommendation_onboarding_process_text_finish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/music_recommendation_onboarding_process_finish_title"
            android:layout_marginHorizontal="32dp"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent">
            <PropertySet android:alpha="0"/>
            <Layout android:layout_marginTop="155dp"/>
        </Constraint>
        <Constraint
            android:id="@+id/music_recommendation_onboarding_wave_image"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="248dp"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent">
            <PropertySet android:alpha="0"/>
        </Constraint>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/music_recommendation_onboarding_process_image"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:lottie_autoPlay="false"
            motion:lottie_loop="false"
            motion:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/music_recommendation_onboarding_process_image_finish"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:lottie_autoPlay="false"
            motion:lottie_loop="false"
            motion:visibilityMode="ignore"/>
        <Constraint
            android:textSize="26sp"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:id="@+id/music_recommendation_onboarding_process_text_finish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/music_recommendation_onboarding_process_finish_title"
            android:layout_marginHorizontal="32dp"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent">
            <PropertySet android:alpha="1"/>
            <Layout android:layout_marginTop="124dp"/>
        </Constraint>
        <Constraint
            android:id="@+id/music_recommendation_onboarding_wave_image"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="248dp"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent">
            <PropertySet android:alpha="1"/>
        </Constraint>
    </ConstraintSet>
</MotionScene>
