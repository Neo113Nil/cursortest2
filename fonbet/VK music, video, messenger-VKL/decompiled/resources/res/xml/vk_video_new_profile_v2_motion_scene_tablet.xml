<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Transition
        app:constraintSetEnd="@+id/profile_expanded_set"
        app:constraintSetStart="@+id/profile_default_set"
        app:duration="100"
        app:layoutDuringTransition="callMeasure">
        <OnSwipe
            app:dragDirection="dragUp"
            app:touchAnchorId="@+id/video_profile_new_v2_sections_container_bottom"
            app:touchAnchorSide="top"/>
    </Transition>
    <Transition
        app:constraintSetEnd="@+id/profile_expanded_set"
        app:constraintSetStart="@+id/profile_default_set"
        app:duration="100"
        app:layoutDuringTransition="callMeasure">
        <OnSwipe
            app:dragDirection="dragUp"
            app:touchAnchorId="@+id/video_profile_new_v2_header_section"
            app:touchAnchorSide="top"/>
    </Transition>
    <Transition
        app:constraintSetEnd="@+id/profile_expanded_set"
        app:constraintSetStart="@+id/profile_default_set"
        app:duration="100"
        app:layoutDuringTransition="callMeasure">
        <OnSwipe
            app:dragDirection="dragUp"
            app:touchAnchorId="@+id/video_profile_new_v2_cover"
            app:touchAnchorSide="top"/>
    </Transition>
    <ConstraintSet android:id="@+id/profile_default_set">
        <Constraint
            android:orientation="horizontal"
            android:id="@+id/video_profile_new_v2_halfscreen_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.3"/>
        <Constraint
            android:id="@+id/video_profile_new_v2_cover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/video_profile_new_v2_halfscreen_guideline"
            app:layout_constraintDimensionRatio="H,6:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/video_profile_new_v2_toolbar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/video_profile_new_v2_appbar_guideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:visibilityMode="ignore">
            <CustomAttribute
                app:attributeName="progress"
                app:customFloatValue="0"/>
        </Constraint>
        <Constraint
            android:id="@+id/video_profile_new_v2_header_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/video_profile_new_v2_cover"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/video_profile_new_v2_sections_container_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/video_profile_new_v2_header_section"
            app:visibilityMode="ignore"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/profile_expanded_set"
        app:deriveConstraintsFrom="@+id/profile_default_set">
        <Constraint
            android:id="@+id/video_profile_new_v2_toolbar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/video_profile_new_v2_appbar_guideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:visibilityMode="ignore">
            <CustomAttribute
                app:attributeName="progress"
                app:customFloatValue="1"/>
        </Constraint>
        <Constraint
            android:id="@+id/video_profile_new_v2_header_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vk_video_profile_catalog_expanded_bottom_margin"
            app:layout_constraintBottom_toBottomOf="@+id/video_profile_new_v2_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/video_profile_new_v2_sections_container_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/video_profile_new_v2_header_section"
            app:visibilityMode="ignore"/>
    </ConstraintSet>
</MotionScene>
