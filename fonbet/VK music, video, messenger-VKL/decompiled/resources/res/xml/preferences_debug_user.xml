<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:key="preferences_debug_user">
    <PreferenceCategory
        android:title="Логирование"
        android:key="logging"
        app:layout="@layout/item_preference_category">
        <CheckBoxPreference
            android:layout="@layout/item_preference"
            android:title="Отладка VK Mini-apps (WebView)"
            android:key="__dbg_webview"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:layout="@layout/item_preference"
            android:title="Логирование API"
            android:key="__dbg_api"
            android:defaultValue="false"/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="Запись логов в файл"
            android:key="__dbg_log_to_file"
            android:summary="До полного перезапуска приложения"/>
        <CheckBoxPreference
            android:layout="@layout/item_preference"
            android:title="Дополнительные логи звонков"
            android:key="__dbg_voip_v2_side_log"
            android:defaultValue="false"/>
        <Preference
            android:title="Собрать данные по сессии создания клипа"
            android:key="__dbg_log_clip_create"
            app:isPreferenceVisible="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="Кеш"
        android:key="cache"
        app:layout="@layout/item_preference_category">
        <Preference
            android:layout="@layout/item_preference"
            android:title="Очистить кеш trusted hashes"
            android:key="clearTrustedHash"/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="Очистить кеш WebView"
            android:key="clearWebViewCache"/>
        <Preference
            android:layout="@layout/item_preference"
            android:title="Очистить кеш стикеров"
            android:key="clearStickersCache"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="Видео"
        android:key="video"
        app:layout="@layout/item_preference_category">
        <CheckBoxPreference
            android:layout="@layout/item_preference"
            android:title="Дебаг оверлей Video"
            android:key="__dbg_videoview"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="Другое"
        android:key="other"
        app:layout="@layout/item_preference_category">
        <CheckBoxPreference
            android:layout="@layout/item_preference"
            android:title="Маркер для WebView экранов"
            android:key="showWebViewMarker"
            android:defaultValue="false"/>
    </PreferenceCategory>
</PreferenceScreen>
