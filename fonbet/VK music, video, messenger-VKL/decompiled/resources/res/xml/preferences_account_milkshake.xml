<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        android:title="@string/group_info"
        app:layout="@layout/item_preference_category">
        <Preference
            android:persistent="false"
            android:layout="@layout/item_preference_with_value"
            android:title="@string/page_address"
            android:key="accountDomain"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/sett_purchases"
        app:layout="@layout/item_preference_category">
        <Preference
            android:persistent="false"
            android:layout="@layout/item_preference"
            android:title="@string/sett_restore_purchases"
            android:key="accountRestorePurchases"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/sett_posts"
        app:layout="@layout/item_preference_category">
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/sett_posts_default"
            android:key="accountOnlyMyPosts"/>
        <com.vk.prefui.views.MaterialSwitchPreference
            android:persistent="false"
            android:layout="@layout/item_preference"
            android:title="@string/sett_enable_comments"
            android:key="accountEnableComments"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/sett_home_tab"
        android:key="accountHomeTab"
        app:layout="@layout/item_preference_category">
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/sett_home_tab_newsfeed"
            android:key="accountNewsfeedSettings"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/community_comments_settings_block_title"
        app:layout="@layout/item_preference_category">
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/community_comments_settings_title_new"
            android:key="accountCommunityComments"
            android:summary=""/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/account_settings_comments"
        app:layout="@layout/item_preference_category">
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/account_settings_comment_order"
            android:key="accountCommentOrder"
            android:summary=""/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/sett_other"
        app:layout="@layout/item_preference_category">
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/settings_unread_messages_counter_title"
            android:key="unread_counter"
            android:summary="@string/settings_unread_messages_counter_value_all"
            app:isPreferenceVisible="false"/>
        <com.vk.prefui.views.SummaryListPreference
            android:entries="@array/sett_im_user_name_options"
            android:layout="@layout/item_preference"
            android:title="@string/sett_im_user_name"
            android:key="accountImUserNameType"
            android:defaultValue="vk"
            android:dialogTitle="@string/sett_im_user_name"
            android:entryValues="@array/sett_im_user_name_values"/>
    </PreferenceCategory>
</PreferenceScreen>
