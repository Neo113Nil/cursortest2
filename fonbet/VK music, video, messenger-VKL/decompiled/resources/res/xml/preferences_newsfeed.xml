<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <com.vk.prefui.views.VkSummaryListPreference
        android:entries="@array/newsfeed_settings_feed_type"
        android:title="@string/newsfeed_settings_order"
        android:key="newsfeed_order"
        android:defaultValue="order"
        android:dialogTitle="@string/newsfeed_settings_order"
        android:entryValues="@array/newsfeed_settings_feed_type_v"/>
    <com.vk.prefui.views.VkPreference
        android:title="@string/newsfeed_settings_new_posts"
        android:key="new_posts"
        android:summary="@string/newsfeed_settings_new_posts_hint"/>
    <com.vk.prefui.views.VkPreference
        android:title="@string/newsfeed_settings_hide_from_news"
        android:key="hide_from_news"
        android:summary="@string/newsfeed_settings_hide_from_news_hint"/>
    <com.vk.prefui.views.VkPreference
        android:title="@string/newsfeed_settings_hide_from_stories"
        android:key="hide_from_stories"
        android:summary="@string/newsfeed_settings_hide_from_stories_hint"/>
    <Preference
        android:layout="@layout/item_preference_vk_divider"
        android:key="divider"/>
    <com.vk.prefui.views.VkPreference
        android:title="@string/newsfeed_settings_face_recognition"
        android:key="face_recognition"/>
    <Preference
        android:layout="@layout/item_preference_vk_divider"
        android:key="discover_divider"/>
    <com.vk.prefui.views.VkGroupHeaderPreference
        android:title="@string/stories_discover_feed_title"
        android:selectable="false"
        android:key="discover_title"/>
    <com.vk.prefui.views.VkSwitchItemPreference
        android:persistent="false"
        android:title="@string/stories_settings_show_block"
        android:key="discover"/>
</PreferenceScreen>
