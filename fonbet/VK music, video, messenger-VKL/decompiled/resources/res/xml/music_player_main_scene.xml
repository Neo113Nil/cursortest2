<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Transition
        app:constraintSetEnd="@+id/lyrics_expanded"
        app:constraintSetStart="@+id/lyrics_collapsed"/>
    <Transition
        app:constraintSetEnd="@+id/lyrics_maximized"
        app:constraintSetStart="@+id/lyrics_expanded"/>
    <Transition
        app:constraintSetEnd="@+id/player_landscape"
        app:constraintSetStart="@+id/lyrics_collapsed"/>
    <Transition
        app:constraintSetEnd="@+id/player_landscape"
        app:constraintSetStart="@+id/lyrics_expanded"/>
    <Transition
        app:constraintSetEnd="@+id/player_landscape"
        app:constraintSetStart="@+id/lyrics_maximized"/>
    <ConstraintSet android:id="@+id/lyrics_collapsed">
        <Constraint
            android:id="@+id/block_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="54dp"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/title_compact_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/artist_compact"
            app:layout_constraintStart_toEndOf="@+id/block_image"
            app:layout_constraintTop_toTopOf="@+id/block_image"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/artist_compact"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/block_image"
            app:layout_constraintTop_toBottomOf="@+id/title_compact_container"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/lyrics_recycler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="parent"/>
        <Constraint
            android:id="@+id/switch_lyrics"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/artist"
            app:layout_constraintEnd_toStartOf="@+id/more"
            app:layout_constraintTop_toTopOf="@+id/title_container"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/block_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/block_image"/>
        <Constraint
            android:id="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            app:layout_constraintBottom_toTopOf="@+id/artist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/info"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/title_container_music_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="110dp"
            app:layout_constraintBottom_toTopOf="@+id/artist_music_track"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/info"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_container"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/artist_music_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="110dp"
            app:layout_constraintBottom_toBottomOf="@+id/info"
            app:layout_constraintStart_toStartOf="@+id/title_container_music_track"
            app:layout_constraintTop_toBottomOf="@+id/title_container_music_track"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/info"
            app:layout_constraintVertical_chainStyle="spread"/>
        <Constraint
            android:id="@+id/prev"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toStartOf="@+id/play_pause"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/next"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toEndOf="@+id/play_pause"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/add"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/downloading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/artist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title_container"/>
        <Constraint
            android:id="@+id/dislike"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/lyrics_expanded">
        <Constraint
            android:id="@+id/block_image"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="12dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/title_compact_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/artist_compact"
            app:layout_constraintEnd_toStartOf="@+id/switch_lyrics"
            app:layout_constraintStart_toEndOf="@+id/block_image"
            app:layout_constraintTop_toTopOf="@+id/block_image"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/artist_compact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/block_image"
            app:layout_constraintEnd_toStartOf="@+id/switch_lyrics"
            app:layout_constraintStart_toEndOf="@+id/block_image"
            app:layout_constraintTop_toBottomOf="@+id/title_compact_container"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/lyrics_recycler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/block_seekbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/block_image"/>
        <Constraint
            android:id="@+id/switch_lyrics"
            android:background="@drawable/bg_switch_lyrics"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/block_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/block_image"/>
        <Constraint
            android:id="@+id/block_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/play_pause"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            app:layout_constraintBottom_toTopOf="@+id/artist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/title_container_music_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            app:layout_constraintBottom_toTopOf="@+id/artist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_container"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/artist_music_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_container_music_track"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/prev"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toStartOf="@+id/play_pause"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/next"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toEndOf="@+id/play_pause"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/add"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/dislike"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/downloading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="parent"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/lyrics_maximized"
        app:deriveConstraintsFrom="@+id/lyrics_expanded">
        <Constraint
            android:id="@+id/lyrics_recycler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/block_image"/>
        <Constraint
            android:id="@+id/block_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"/>
        <Constraint
            android:id="@+id/play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/player_landscape">
        <Constraint
            android:id="@+id/block_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="42dp"
            android:layout_marginBottom="70dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/title_compact_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/artist_compact"
            app:layout_constraintEnd_toEndOf="@+id/block_image"
            app:layout_constraintTop_toTopOf="@+id/block_image"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/artist_compact"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/block_image"
            app:layout_constraintEnd_toEndOf="@+id/block_image"
            app:layout_constraintTop_toBottomOf="@+id/title_compact_container"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/lyrics_recycler"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="parent"/>
        <Constraint
            android:id="@+id/switch_lyrics"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/artist"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title_container"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/block_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="70dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/block_image"/>
        <Constraint
            android:id="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/block_image"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/title_container_music_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/block_image"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/block_image"
            app:layout_constraintTop_toBottomOf="@+id/title_container"/>
        <Constraint
            android:id="@+id/artist_music_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/block_image"
            app:layout_constraintTop_toBottomOf="@+id/title_container_music_track"/>
        <Constraint
            android:id="@+id/play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:layout_constraintBottom_toTopOf="@+id/block_seekbar"
            app:layout_constraintEnd_toEndOf="@+id/block_seekbar"
            app:layout_constraintStart_toStartOf="@+id/block_seekbar"
            app:layout_constraintTop_toBottomOf="@+id/artist"
            app:layout_constraintVertical_chainStyle="spread"/>
        <Constraint
            android:id="@+id/prev"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintEnd_toStartOf="@+id/play_pause"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/next"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintStart_toEndOf="@+id/play_pause"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/add"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintEnd_toEndOf="@+id/parent"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/dislike"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintStart_toStartOf="@+id/title_container"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/downloading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause"
            app:layout_constraintStart_toStartOf="@+id/title_container"
            app:layout_constraintTop_toTopOf="@+id/play_pause"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/artist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title_container"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/player_split_screen"
        app:deriveConstraintsFrom="@+id/player_landscape">
        <Constraint
            android:id="@+id/block_image"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/block_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="42dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/block_image"
            app:layout_constraintVertical_chainStyle="spread"/>
        <Constraint
            android:id="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/block_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"/>
        <Constraint
            android:id="@+id/play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:layout_constraintBottom_toTopOf="@+id/block_seekbar"
            app:layout_constraintEnd_toEndOf="@+id/block_seekbar"
            app:layout_constraintStart_toStartOf="@+id/block_seekbar"
            app:layout_constraintTop_toBottomOf="@+id/title_container"
            app:layout_constraintVertical_chainStyle="spread"/>
    </ConstraintSet>
</MotionScene>
