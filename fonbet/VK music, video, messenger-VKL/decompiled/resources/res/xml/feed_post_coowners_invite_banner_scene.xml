<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <ConstraintSet android:id="@+id/start"/>
    <ConstraintSet android:id="@+id/coownershipApproved">
        <Constraint
            android:id="@+id/feed_coauthors_coauthor_photo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="-20dp"
            motion:layout_constraintEnd_toEndOf="@+id/feed_coauthors_middle"
            motion:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/feed_coauthors_author_photo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            motion:layout_constraintEnd_toEndOf="@+id/feed_coauthors_coauthor_photo"
            motion:layout_constraintTop_toTopOf="@+id/feed_coauthors_coauthor_photo"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/coownershipRejected">
        <Constraint
            android:id="@+id/feed_coauthors_coauthor_photo"
            android:visibility="gone"/>
        <Constraint
            android:id="@+id/feed_coauthors_author_photo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"/>
    </ConstraintSet>
    <Transition
        motion:constraintSetEnd="@+id/coownershipApproved"
        motion:constraintSetStart="@+id/start"
        motion:motionInterpolator="bounce"/>
</MotionScene>
