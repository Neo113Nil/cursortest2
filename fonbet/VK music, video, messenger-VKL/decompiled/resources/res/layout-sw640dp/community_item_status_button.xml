<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/highlight_radius_8"
    android:paddingTop="22dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <view
        android:id="@+id/icon"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:layout_marginEnd="3dp"
        class="com.vk.profile.community.impl.ui.view.StatusButtonView$NotificationImageView"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        style="@style/VkUiTypography.FootnoteMedium"/>
</LinearLayout>
