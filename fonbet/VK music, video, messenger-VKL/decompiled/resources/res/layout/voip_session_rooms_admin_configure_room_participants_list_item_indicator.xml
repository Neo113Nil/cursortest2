<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/voip_session_rooms_admin_configure_rooms_dialog_configure"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/VoipSessionRoomList.Caption"
        android:layout_gravity="center_vertical"
        android:id="@+id/voip_participants_section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/voip_session_room_admin_room_participants"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VoipSessionRoomList.FootNote"
        android:textSize="13sp"
        android:layout_gravity="center_vertical"
        android:id="@+id/voip_participants_section_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/voip_participants_section_title"
        app:layout_constraintStart_toEndOf="@+id/voip_participants_section_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
