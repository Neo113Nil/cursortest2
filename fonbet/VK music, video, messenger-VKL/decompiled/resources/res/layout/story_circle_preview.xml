<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/click_handler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/fl_story_preview_wrapper"
        android:layout_width="@dimen/newsfeed_story_avatar_size"
        android:layout_height="@dimen/newsfeed_story_avatar_size"
        android:layout_marginTop="@dimen/story_preview_top_space">
        <com.vk.stories.design.view.avatar.StoryAvatarView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_story_image"
            android:layout_width="@dimen/newsfeed_story_avatar_size"
            android:layout_height="@dimen/newsfeed_story_avatar_size"
            app:contourOverlayEnabled="true"
            app:placeholderImage="@drawable/user_placeholder"
            app:vk_failBorderTint="?attr/vk_ui_background_negative"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/iv_story_bottom_badge"
            android:background="@drawable/bg_story_badge"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="4dp"/>
        <com.vk.stories.design.view.live.LiveShine
            android:layout_gravity="end|bottom"
            android:id="@+id/fl_story_live_shine"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="20dp"
            android:layout_marginBottom="4dp"
            android:foreground="@drawable/bg_story_badge_live"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/tv_first_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/story_author_title_top_space"
        android:singleLine="true"
        android:importantForAccessibility="no"
        style="@style/VkUiTypography.Caption1.Unscaled"/>
</merge>
