<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp"
        app:tint="?attr/vk_ui_icon_accent"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/VkLegacyTypography.Headline.Regular"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/VkLegacyTypography.Caption.Regular"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:lines="1"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.Caption.Regular"
        android:textSize="15sp"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="12dp"/>
    <ProgressBar
        android:layout_gravity="center_vertical"
        android:id="@+id/progress"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="12dp"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/open"
        android:layout_width="16dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:layout_marginStart="12dp"
        app:srcCompat="@drawable/vk_icon_chevron_24"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_gravity="center_vertical"
        android:id="@+id/switch_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</merge>
