<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/join_call_root_toolbar"
    android:padding="0dp"
    app:contentInsetStart="8dp"
    app:contentInsetStartWithNavigation="8dp"
    app:logo="@null"
    app:navigationContentDescription="@string/vkim_accessibility_toolbar_back_exit"
    app:navigationIcon="@drawable/ic_close_title_color"
    app:subtitle="@null"
    app:title="@null"
    app:titleMarginStart="0dp"
    style="@style/VkIm.Toolbar.Style">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:background="@drawable/bg_im_chat_header_ripple"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:ellipsize="end"
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/subtitle_text"
            app:layout_constraintEnd_toStartOf="@+id/ongoing_call_scan_device_qr_code_button"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/VkLegacyTypography.Headline.Regular"/>
        <TextView
            android:textAppearance="@style/VkLegacyTypography.FootnoteAppearance"
            android:textSize="13sp"
            android:id="@+id/subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:fontFamily="@string/font_family_regular"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/title_text"
            app:layout_constraintTop_toBottomOf="@+id/title_text"
            style="@style/VkIm.Toolbar.Subtitle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ongoing_call_scan_device_qr_code_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/vk_icon_qr_code_outline_28"
            android:scaleType="center"
            android:contentDescription="@string/voip_invite_by_qr_code"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:tint="?attr/vk_ui_icon_medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.Toolbar>
