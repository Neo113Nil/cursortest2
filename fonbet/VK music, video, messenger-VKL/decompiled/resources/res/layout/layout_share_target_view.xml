<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.vk.im.ui.views.avatars.AvatarView
        android:layout_gravity="center_horizontal"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="4dp"/>
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_accent_border_2"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="1dp"/>
    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/ic_casper_chat_icon_22"
        android:layout_marginStart="48dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
        android:textColor="@color/sharing_label_text"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="70dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="6dp"
        android:text="@string/sharing_action_button_label1"
        android:maxLines="2"/>
</merge>
