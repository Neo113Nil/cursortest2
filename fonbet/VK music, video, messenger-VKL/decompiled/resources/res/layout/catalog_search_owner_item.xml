<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/owner_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Headline1Normal"
        android:textColor="@color/vk_ui_text_title_color"
        android:ellipsize="end"
        android:id="@+id/owner_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/owner_description"
        app:layout_constraintEnd_toStartOf="@+id/owner_status"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/owner_image"
        app:layout_constraintTop_toTopOf="@+id/owner_image"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/owner_status"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/owner_name"
        app:layout_constraintEnd_toStartOf="@+id/owner_verified"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/owner_name"
        app:layout_constraintTop_toTopOf="@+id/owner_name"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/owner_verified"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/owner_name"
        app:layout_constraintEnd_toStartOf="@+id/subscribe_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/owner_status"
        app:layout_constraintTop_toTopOf="@+id/owner_name"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/owner_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:drawableTint="@color/vk_steel_gray_300"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/owner_image"
        app:layout_constraintEnd_toStartOf="@+id/subscribe_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/owner_image"
        app:layout_constraintTop_toBottomOf="@+id/owner_name"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/subscribe_barrier"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:barrierDirection="start"
        app:constraint_referenced_ids="subscribe_progress_bar,owner_subscribe_btn"/>
    <ProgressBar
        android:id="@+id/subscribe_progress_bar"
        android:padding="4dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/owner_subscribe_btn"
        android:background="@drawable/highlight_unbounded"
        android:padding="4dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/video_catalog_subscribe"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
