<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/story_stats_counters_layout"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/vk_ui_spacing_size2_xs"
    android:layout_marginVertical="12dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/story_stats_counters_content_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="@drawable/story_stats_divider"
        android:showDividers="middle"
        android:paddingHorizontal="@dimen/vk_ui_spacing_size_xl"
        android:paddingVertical="@dimen/vk_ui_spacing_size_xs">
        <com.vk.stories.design.view.viewer.StoryStat
            android:id="@+id/viewers_count_story_stat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:feedback_icon="viewers"/>
        <com.vk.stories.design.view.viewer.StoryStat
            android:id="@+id/likes_count_story_stat"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:feedback_icon="likes"/>
        <com.vk.stories.design.view.viewer.StoryStat
            android:id="@+id/answers_count_story_stat"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:feedback_icon="answers"/>
    </LinearLayout>
</FrameLayout>
