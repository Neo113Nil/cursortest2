<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.disableable.DisableableRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.MaxHeightSaveFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true">
        <com.vk.core.view.fresco.VKEnhancedImageView
            android:id="@+id/dialog_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:imageScaleType="center_crop"/>
    </com.vk.core.view.MaxHeightSaveFrameLayout>
    <ViewStub
        android:id="@+id/dialog_header_container_stub"
        android:layout="@layout/vkim_include_dialog_header_old"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <ViewStub
        android:id="@+id/channel_pinned_msgs"
        android:layout="@layout/vkim_include_channel_pinned_msgs_old"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@+id/dialog_header_container"/>
    <FrameLayout
        android:id="@+id/messages_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/channel_footer_container"
        android:layout_below="@+id/channel_pinned_msgs"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/dialog_shadow"
        android:layout_below="@+id/channel_pinned_msgs"
        style="@style/VkIm.AppBarShadowView"/>
    <FrameLayout
        android:id="@+id/channel_footer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <ViewStub
            android:id="@+id/channel_footer_stub"
            android:inflatedId="@+id/channel_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/channel_msg_send_stub"
            android:inflatedId="@+id/channel_msg_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <ViewStub
        android:id="@+id/deactivated_container_stub"
        android:layout="@layout/im_channel_deactivated_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <View
        android:id="@+id/divider"
        android:background="?attr/vk_ui_separator_secondary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_above="@+id/channel_footer_container"/>
</com.vk.core.view.disableable.DisableableRelativeLayout>
