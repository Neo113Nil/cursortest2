<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/write_bar_comments_layout_viewstub"
        android:layout="@layout/write_bar_comments_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ViewStub
        android:id="@+id/write_bar_reply_layout_viewstub"
        android:layout="@layout/write_bar_reply_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ViewStub
        android:id="@+id/write_bar_attach_editor_layout_viewstub"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout="@layout/write_bar_attach_editor_layout"
        android:layout_width="match_parent"
        android:layout_height="91dp"/>
    <View
        android:id="@+id/write_bar_attach_divider"
        android:background="?attr/vk_ui_separator_secondary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"/>
    <FrameLayout
        android:id="@+id/write_bar_edit_area_container"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">
        <ViewStub
            android:gravity="center_vertical"
            android:id="@+id/writebar_audio_area_viewstub"
            android:layout="@layout/write_bar_audio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/writebar_audio_area_height"
            android:layout_marginRight="50dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/writebar_record_tip"
            android:visibility="invisible"
            android:text="@string/video_message_click_to_record"
            android:paddingStart="@dimen/voice_rec_tip_left_padding_max"
            android:paddingEnd="@dimen/voice_rec_tip_right_padding"
            style="@style/WriteBarRecordTipStyle"/>
        <FrameLayout
            android:id="@+id/writebar_text_and_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no">
            <View
                android:id="@+id/divider_top_writebar"
                android:background="?attr/vk_ui_separator_primary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/writebar_text_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp">
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/writebar_left_button_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/writebar_attach"
                        android:background="@drawable/highlight_icon"
                        android:padding="8dp"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:src="?attr/im_ic_attach"
                        android:scaleType="center"
                        android:contentDescription="@string/accessibility_msg_send_attach"
                        app:tint="?attr/vk_ui_icon_secondary"/>
                    <ImageView
                        android:layout_gravity="end|top"
                        android:id="@+id/writebar_attach_new"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:src="@drawable/ic_new_badge"
                        android:contentDescription="@string/accessibility_msg_send_attach"
                        android:layout_marginEnd="12dp"
                        app:tint="?attr/vk_ui_accent_red"/>
                    <com.vk.core.view.components.avatar.VkAvatar
                        android:layout_gravity="end|top"
                        android:id="@+id/writebar_channel_avatar"
                        android:visibility="gone"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/accessibility_msg_select_author_for_comments"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginVertical="8dp"
                        app:borderStrokeWidth="3dp"
                        app:placeholderImage="@drawable/user_placeholder"
                        style="@style/UserSmallPhoto"/>
                </FrameLayout>
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/writebar_fullscreen_scroll_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.vk.im.ui.views.RichEditText
                            android:textColor="?attr/vk_ui_text_primary"
                            android:textColorHint="?attr/vk_ui_text_secondary"
                            android:id="@+id/writebar_edit"
                            android:hint="@string/msg_hint"
                            style="@style/WriteBarEditTextStyle"/>
                        <View
                            android:id="@+id/writebar_bottom_offset"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"/>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
                <ImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/writebar_bot_keyboard"
                    android:background="@drawable/highlight_icon"
                    android:visibility="gone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:src="?attr/im_ic_bot_keyboard"
                    android:scaleType="center"
                    android:contentDescription="@string/accessibility_msg_bot_keyboard"
                    app:tint="?attr/vk_ui_icon_secondary"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/writebar_fullscreen_button"
                    android:background="@drawable/highlight_icon"
                    android:visibility="gone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/vk_icon_fullscreen_outline_28"
                    android:scaleType="center"
                    android:contentDescription="@string/accessibility_msg_full_screen"
                    app:tint="?attr/vk_ui_icon_secondary"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/writebar_settings"
                    android:background="@drawable/highlight_icon"
                    android:visibility="gone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/vk_icon_settings_outline_28"
                    android:scaleType="center"
                    android:contentDescription="@string/accessibility_msg_settings"
                    app:tint="?attr/vk_ui_icon_secondary"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/writebar_templates"
                    android:background="@drawable/highlight_icon"
                    android:visibility="gone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/vk_icon_pen_stack_outline_28"
                    android:scaleType="center"
                    android:contentDescription="@string/accessibility_msg_templates"
                    app:tint="?attr/vk_ui_icon_secondary"/>
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/writebar_emoji"
                        android:background="@drawable/highlight_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:src="?attr/im_ic_emoji"
                        android:scaleType="center"
                        android:contentDescription="@string/accessibility_msg_send_stickers"
                        app:tint="?attr/vk_ui_icon_secondary"/>
                    <ImageView
                        android:layout_gravity="end|top"
                        android:id="@+id/writebar_pack_new"
                        android:background="@drawable/ic_sticker_new_style_badge_composite"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:contentDescription="@string/accessibility_msg_send_stickers"
                        android:layout_marginEnd="10dp"/>
                    <ImageView
                        android:layout_gravity="end|top"
                        android:id="@+id/writebar_emoji_new"
                        android:background="@drawable/ic_sticker_new_badge_composite_full"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:contentDescription="@string/accessibility_msg_send_stickers"
                        android:layout_marginEnd="10dp"/>
                </FrameLayout>
                <ImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/writebar_record_video"
                    android:background="@drawable/highlight_icon"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:src="?attr/im_ic_record_video"
                    android:scaleType="center"
                    android:contentDescription="@string/accessibility_msg_record_videomsg"
                    app:tint="?attr/vk_ui_icon_secondary"/>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="end|bottom"
                android:id="@+id/writebar_action"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginEnd="4dp">
                <ImageView
                    android:id="@+id/writebar_send"
                    android:background="@drawable/highlight_icon"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="center"
                    android:contentDescription="@string/accessibility_msg_send_msg"/>
                <ImageView
                    android:id="@+id/writebar_record_audio"
                    android:background="@drawable/highlight_icon"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="?attr/im_ic_microphone"
                    android:scaleType="center"
                    android:soundEffectsEnabled="false"
                    android:hapticFeedbackEnabled="false"
                    android:contentDescription="@string/accessibility_msg_record_audiomsg"
                    app:tint="?attr/vk_ui_icon_secondary"/>
                <com.vk.core.view.ProgressView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/cancelable_progress"
                    android:background="@drawable/highlight_icon"
                    android:visibility="gone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/accessibility_cancel"
                    app:upload_cancelIcon="@drawable/vk_icon_cancel_16"
                    app:upload_cancelIconSize="16dp"
                    app:upload_cancelIconTintColor="?attr/vk_ui_text_accent"
                    app:upload_cancelIconVisible="true"
                    app:upload_layerColor="@color/vk_clear"
                    app:upload_lineColor="?attr/vk_ui_text_accent"
                    app:upload_lineDownScaleThreshold="22dp"
                    app:upload_lineRounded="true"
                    app:upload_lineWidth="2dp"
                    app:upload_progressInverse="true"
                    app:upload_progressMax="100"
                    app:upload_progressMin="0"
                    app:upload_progressMovement="false"
                    app:upload_progressRadius="22dp"
                    app:upload_progressValue="0"/>
            </FrameLayout>
        </FrameLayout>
        <ViewStub
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/writebar_fullscreen_buttons_bubble_viewstub"
            android:layout="@layout/write_bar_fullscreen_buttons_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
    </FrameLayout>
</merge>
