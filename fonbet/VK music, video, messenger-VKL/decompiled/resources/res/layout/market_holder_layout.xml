<?xml version="1.0" encoding="utf-8"?>
<com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/attachment_market_container"
    android:paddingLeft="@dimen/post_side_padding"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/post_side_padding"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:overlayDrawable="@drawable/highlight_radius_8"
    app:padOverlay="true">
    <FrameLayout
        android:id="@+id/image"
        android:background="@drawable/market_holder_bg_left"
        android:layout_width="112dp"
        android:layout_height="match_parent">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/snippet_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="0.5dp"
            android:minHeight="95dp"
            app:actualImageScaleType="centerCrop"
            app:emptyImagePlaceholder="@drawable/ic_market_outline_96_placeholder"
            app:placeholderImage="@drawable/default_placeholder"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_link_state"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="12dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/vk_icon_linked_24"
            app:tint="@color/fave_snippet_dark_gray"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/info"
        android:background="@drawable/market_holder_bg_right"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:layout_marginStart="112dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2Normal"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/attach_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="5dp"
            android:layout_marginEnd="35dp"/>
        <LinearLayout
            android:id="@+id/attach_subtitle_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="35dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.SubheadMedium"
                android:textColor="?attr/vk_ui_text_muted"
                android:ellipsize="end"
                android:id="@+id/attach_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <com.vk.core.view.RatingView
                android:id="@+id/attach_rating"
                android:layout_width="88dp"
                android:layout_height="19dp"
                android:paddingStart="7dp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_muted"
                android:ellipsize="end"
                android:id="@+id/attach_review_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:paddingStart="7dp"/>
        </LinearLayout>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/attach_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/vkim_msg_list_market_button"
            app:buttonAppearance="neutral"
            app:buttonMode="secondary"
            app:buttonSizeType="small"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/attach_snippet_remove_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:src="@drawable/vk_icon_deprecated_ic_close_attach_36"
        android:contentDescription="@string/delete"
        android:layout_marginEnd="@dimen/post_side_padding_negative"/>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/snippet_toggle_fave"
            android:background="@drawable/highlight_circle_white"
            android:visibility="visible"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/bookmark_activated_24dp"
            android:scaleType="center"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/snippet_actions"
            android:background="@drawable/highlight_unlimited"
            android:visibility="visible"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:scaleType="center"
            app:srcCompat="@drawable/vk_icon_more_vertical_24"
            app:tint="@color/black_opacity_15"/>
    </LinearLayout>
</com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout>
