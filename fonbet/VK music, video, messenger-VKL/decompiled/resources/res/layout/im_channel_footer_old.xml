<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/channel_footer"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <com.pnikosis.materialishprogress.ProgressWheel
        android:layout_gravity="center"
        android:id="@+id/footer_progress"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:matProg_barColor="?attr/vk_ui_text_contrast_themed"
        app:matProg_barWidth="2dp"
        app:matProg_progressIndeterminate="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.Headline1Medium"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/footer_button"
        android:background="@drawable/ripple"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:lines="1"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:layout_gravity="center"
        android:id="@+id/postponed_post_button"
        android:background="@drawable/ripple_8dp"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:layout_margin="4dp"
        android:src="@drawable/vk_icon_history_forward_outline_28"
        android:contentDescription="@string/vkim_accessibility_deferred_posts"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/ban_msg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/ban_reason_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="16dp"
            app:buttonMode="secondary"
            app:text="@string/vkim_channel_ban_info_more"/>
    </LinearLayout>
</FrameLayout>
