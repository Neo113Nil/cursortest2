<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_classifieds_geo_location_rounded_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:minHeight="64dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@drawable/vk_icon_location_outline_28"
        android:contentDescription="@string/classifieds_accessibility_location"
        android:layout_marginStart="12dp"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/classified_geo_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/classifieds_geo_location_item_title"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="16dp"
        style="@style/VkUiTypography.Paragraph"/>
</FrameLayout>
