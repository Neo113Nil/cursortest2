<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/vkl_action_link_product_full"
        android:background="@drawable/vkl_bg_action_link_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground">
        <include
            android:id="@+id/vkl_action_link_product_landscape"
            layout="@layout/vkl_action_product_landscape"/>
        <include
            android:id="@+id/vkl_action_link_product_portrait"
            layout="@layout/vkl_action_product_portrait"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/vkl_action_link_product_short"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_market_outline_24"
            android:importantForAccessibility="no"
            app:tint="@color/vk_white"/>
        <TextView
            android:textColor="@color/vk_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vkl_action_link_single_product"
            android:layout_marginStart="4dp"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_chevron_16"
            android:importantForAccessibility="no"
            android:layout_marginStart="2dp"
            app:tint="@color/vk_white"/>
    </LinearLayout>
</merge>
