<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/feed_discover_top_bar_content"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <FrameLayout
        android:id="@+id/feed_discover_top_bar_back"
        android:background="@drawable/vk_ripple_circle_highlight"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/feed_discover_top_bar_back_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:tint="?attr/vk_ui_icon_primary"/>
    </FrameLayout>
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/feed_discover_top_bar_avatar"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"/>
    <com.vk.core.view.components.search.VkSearchView
        android:id="@+id/feed_discover_top_bar_search"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
