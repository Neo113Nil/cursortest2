<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/vk_error_modal_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:srcCompat="@drawable/vk_icon_phone_down_outline_56"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Title2Medium"
        android:textColor="?attr/vk_ui_text_muted"
        android:layout_gravity="center_horizontal"
        android:id="@+id/vk_error_modal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center"
        android:id="@+id/vk_error_modal_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/vk_error_modal_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:text="@string/accessibility_close"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"/>
</LinearLayout>
