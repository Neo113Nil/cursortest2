<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <com.vk.lists.RecyclerPaginatedView
        android:id="@+id/collection_items_add_wall_fragment_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.clips.design.view.actionlinks.holders.tip.ItemTipView
        android:layout_gravity="center"
        android:id="@+id/collection_items_add_wall_fragment_tip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
