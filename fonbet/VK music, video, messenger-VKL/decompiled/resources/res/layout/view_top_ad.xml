<?xml version="1.0" encoding="utf-8"?>
<com.my.target.nativeads.views.NativeAdContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nativeads_ad_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.my.target.nativeads.views.IconAdView
            android:id="@+id/nativeads_icon"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:maxWidth="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/nativeads_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/nativeads_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Caption1"
            android:textColor="?attr/vk_ui_text_primary_alpha"
            android:ellipsize="end"
            android:id="@+id/nativeads_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/nativeads_title"
            app:layout_constraintTop_toBottomOf="@+id/nativeads_title"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/nativeads_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/nativeads_title"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Caption3"
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/nativeads_advertising"
            android:layout_width="@dimen/top_ad_banner_content_height"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.my.target.nativeads.views.NativeAdContainer>
