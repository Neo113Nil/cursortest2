<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/im_ui_placeholder_root"
    android:background="@drawable/im_ui_internal_background_contrast_20dp"
    android:padding="@dimen/vk_ui_spacing_size2_xl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/im_ui_top_content_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_m">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/im_ui_top_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.ui.themes.VKReplacerView
            android:layout_gravity="center"
            android:id="@+id/im_ui_avatar_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.ui.themes.VKReplacerView
            android:layout_gravity="center"
            android:id="@+id/im_ui_picture_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/im_ui_middle_content_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vk_ui_spacing_size_m"
            android:textAlignment="center"
            style="@style/VkUiTypography.Title2"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vk_ui_spacing_size_xl"
            android:textAlignment="center"
            style="@style/VkUiTypography.Text"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/im_ui_middle_extra_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vk_ui_spacing_size3_xl">
            <ImageView
                android:id="@+id/im_ui_middle_extra_before"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="@dimen/vk_ui_spacing_size_xs"
                android:importantForAccessibility="no"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/extra_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/VkUiTypography.Footnote"/>
        </LinearLayout>
        <com.vk.core.view.components.userstack.VkUserStack
            android:id="@+id/im_ui_middle_user_stack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vk_ui_spacing_size3_xl"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/im_ui_cell_group_wrapper"
        android:background="@drawable/im_ui_internal_background_tertiary_8dp"
        android:padding="@dimen/vk_ui_spacing_size_m"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/im_ui_button_group_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
