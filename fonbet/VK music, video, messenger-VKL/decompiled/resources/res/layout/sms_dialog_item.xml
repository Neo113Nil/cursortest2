<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/libverify_activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/libverify_activity_sms_dialogs_margin_left"
    android:paddingEnd="@dimen/libverify_activity_sms_dialogs_margin_right">
    <ImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/libverify_dialog_margin_top"
        android:src="@drawable/libverify_ic_account_circle_white"
        android:layout_alignParentTop="true"
        android:importantForAccessibility="no"
        android:layout_alignParentStart="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/libverify_font_subhead"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/libverify_activity_horizontal_margin"
        android:layout_marginTop="@dimen/libverify_dialog_margin_top"
        android:layout_marginRight="@dimen/libverify_activity_horizontal_margin"
        android:textIsSelectable="false"
        android:layout_toEndOf="@+id/image"
        android:layout_alignParentEnd="true"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/libverify_font_body1"
        android:ellipsize="end"
        android:id="@+id/lastText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_below="@+id/name"
        android:textIsSelectable="false"
        android:layout_marginStart="@dimen/libverify_activity_horizontal_margin"
        android:layout_toEndOf="@+id/image"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <TextView
        android:textAppearance="@style/libverify_font_caption"
        android:id="@+id/lastTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lastText"
        android:textIsSelectable="false"
        android:layout_marginStart="@dimen/libverify_activity_horizontal_margin"
        android:layout_toEndOf="@+id/image"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toBottomOf="@+id/lastText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
