<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/gratitude"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/vk_icon_check_circle_outline_56"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:importantForAccessibility="no"
        android:backgroundTint="?attr/vk_ui_background_accent"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:gravity="center_horizontal"
        android:id="@+id/gratitude_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        style="@style/VkUiTypography.Title2Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center_horizontal"
        android:id="@+id/gratitude_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        style="@style/VkUiTypography.Paragraph"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/gratitude_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
</LinearLayout>
