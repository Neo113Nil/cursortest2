<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_modal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.spinner.VkSpinner
        android:layout_gravity="center"
        android:id="@+id/translations_loader"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size2_xl"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/translation_container"
        android:background="@drawable/translation_container_milkshake_background"
        android:padding="@dimen/vk_ui_spacing_size2_xl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_xl">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/original_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Title3"
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/original_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"/>
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/recognized_automatically"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"/>
            <com.vk.core.view.components.text.expandable.VkExpandableText
                android:textAppearance="@style/VkUiTypography.Paragraph"
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/original_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"/>
        </LinearLayout>
        <com.vk.core.view.components.divider.VkSeparator
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/vk_ui_spacing_size_xl"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/translation_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Title3"
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/translation_language"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginEnd="@dimen/vk_ui_spacing_size_xl"
                app:layout_constraintEnd_toStartOf="@+id/btn_audio_translate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.vk.core.view.components.picture.VkImage
                android:id="@+id/btn_audio_translate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/vk_icon_play_circle_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/vk_ui_icon_accent"/>
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Paragraph"
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/translated_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/translation_language"/>
            <com.vk.core.view.components.skeleton.VkSkeleton
                android:id="@+id/translated_text_skeleton"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/translation_language"
                app:skeletonType="block"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/translation_container_lego"
        android:background="@drawable/translation_container_lego_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_m"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl"
        android:paddingVertical="@dimen/vk_ui_spacing_size_m">
        <com.vk.core.view.components.cell.VkCell
            android:id="@+id/lego_cell_original"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.cell.VkCellSkeleton
            android:id="@+id/lego_translation_skeleton"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size_xs"/>
        <com.vk.core.view.components.cell.VkCell
            android:id="@+id/lego_cell_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size_xs"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/actions_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/vk_ui_spacing_size_m"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/actions_container_lego"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/vk_ui_spacing_size_xl"
        android:paddingHorizontal="@dimen/vk_ui_spacing_size2_xl"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/translation_failed_placeholder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
