<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/qr_code_auth_account_row"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">
    <com.vk.core.ui.themes.VKReplacerView
        android:id="@+id/qr_code_auth_account_avatar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/qr_code_auth_account_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="220dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        style="?attr/vk_ui_typography_paragraph"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/qr_code_auth_account_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="4dp"
        app:srcCompat="@drawable/vk_icon_dropdown_16"
        app:tint="?attr/vk_ui_icon_medium"/>
</LinearLayout>
