<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/catalog_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:orientation="vertical"
        android:id="@+id/loader_root"
        android:background="?attr/vk_ui_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/VKAppBar">
            <com.vk.core.view.components.topbar.VkTopBar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_scrollFlags="snap|enterAlways|scroll"/>
        </com.google.android.material.appbar.AppBarLayout>
        <com.vk.superapp.catalog.impl.v2.catalog.view.CatalogRecyclerPaginatedRedesignView
            android:id="@+id/catalog_list"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stub_recycler"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <com.vk.core.view.AppBarShadowView
            android:id="@+id/shadow"
            style="@style/AppBarShadow"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/something_new_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:drawablePadding="2dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:drawableStartCompat="@drawable/vk_icon_stars_outline_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
