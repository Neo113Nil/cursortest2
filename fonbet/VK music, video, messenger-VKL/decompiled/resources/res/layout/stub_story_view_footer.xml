<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.stories.design.view.sticker.TemplateButton
        android:id="@+id/template_button_new"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_action"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_vertical"
        android:id="@+id/tv_action"
        android:background="@drawable/bg_story_action_rounded_20"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/stories_replies_reply"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="14dp"
        style="@style/VkUiTypography.ParagraphNormal"/>
    <ImageView
        android:id="@+id/iv_like"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_like_outline_shadow_medium_48"
        android:layout_marginStart="16dp"
        app:tint="@color/vk_white"/>
    <ImageView
        android:id="@+id/iv_action"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/vk_icon_share_outline_shadow_28"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="14dp"
        app:tint="@color/vk_white"/>
</LinearLayout>
