<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/snippet_track_thumb"
        android:layout_width="@dimen/music_snippet_track_thumb_size"
        android:layout_height="@dimen/music_snippet_track_thumb_size"
        android:layout_marginTop="@dimen/music_snippet_track_margin"
        android:layout_marginStart="@dimen/music_snippet_track_margin"
        android:layout_marginEnd="@dimen/music_snippet_track_margin"
        android:elevation="7dp"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="16dp"
        app:tiv_background_image="?attr/vk_ui_background_content"
        app:tiv_border_color="@android:color/transparent"
        app:tiv_empty_resource="@drawable/vk_icon_song_outline_56"
        app:tiv_empty_tint="?attr/vk_ui_icon_tertiary"
        app:viewAspectRatio="1"/>
    <com.vk.music.view.MusicRoundPlayView
        android:id="@+id/play_view"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/snippet_track_thumb"
        app:layout_constraintEnd_toEndOf="@+id/snippet_track_thumb"
        app:layout_constraintStart_toStartOf="@+id/snippet_track_thumb"
        app:layout_constraintTop_toTopOf="@+id/snippet_track_thumb"
        app:mrp_background_alpha="0.6"
        app:mrp_background_tint="@color/vk_gray_850"
        app:mrp_show_buffering="true"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/track_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/music_talkback_snippet_track"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/add_track"
        app:layout_constraintStart_toStartOf="@+id/snippet_track_thumb"
        app:layout_constraintTop_toBottomOf="@+id/snippet_track_thumb">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline1Normal"
            android:textColor="@color/vk_white"
            android:id="@+id/track_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/image_explicit"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/track_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:alpha="0.72"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/track_name"/>
        <ImageView
            android:id="@+id/image_explicit"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@string/music_talkback_explicit"
            android:alpha="0.48"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/track_name"
            app:layout_constraintEnd_toStartOf="@+id/track_arrow"
            app:layout_constraintStart_toEndOf="@+id/track_name"
            app:layout_constraintTop_toTopOf="@+id/track_name"
            app:layout_goneMarginStart="0dp"
            app:srcCompat="@drawable/vk_icon_explicit_12"
            app:tint="@color/vk_white"/>
        <ImageView
            android:id="@+id/track_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:src="@drawable/vk_icon_chevron_16"
            android:contentDescription="@string/music_talkback_add_audio"
            android:alpha="0.48"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="8dp"
            app:barrierDirection="end"
            app:layout_constraintBottom_toBottomOf="@+id/track_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_explicit"
            app:layout_constraintTop_toTopOf="@+id/track_name"
            app:tint="@color/vk_white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/add_track"
        android:background="@drawable/bg_white_circle_alpha_20"
        android:padding="6dp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/vk_icon_add_16"
        android:contentDescription="@string/music_talkback_add_audio"
        app:layout_constraintBottom_toBottomOf="@+id/track_area"
        app:layout_constraintEnd_toEndOf="@+id/snippet_track_thumb"
        app:layout_constraintTop_toTopOf="@+id/track_area"
        app:tint="@color/vk_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
