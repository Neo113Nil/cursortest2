<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/music_selectable_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="60dp">
    <com.vk.music.view.ThumbsImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/audio_image"
        android:layout_width="@dimen/music_track_image"
        android:layout_height="@dimen/music_track_image"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/music_image_rounding_corners"
        app:tiv_background_image="?attr/vk_ui_image_placeholder"
        app:tiv_border_width="0.5dp"
        app:tiv_empty_resource="@drawable/vk_icon_song_outline_28"
        app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
    <ImageView
        android:id="@+id/audio_playing_indicator"
        android:background="@drawable/music_dark_round_rect"
        android:visibility="gone"
        android:layout_width="@dimen/music_track_image"
        android:layout_height="@dimen/music_track_image"
        app:layout_constraintBottom_toBottomOf="@+id/audio_image"
        app:layout_constraintEnd_toEndOf="@+id/audio_image"
        app:layout_constraintStart_toStartOf="@+id/audio_image"
        app:layout_constraintTop_toTopOf="@+id/audio_image"/>
    <TextView
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:id="@+id/audio_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:minWidth="34dp"
        android:minHeight="20dp"
        android:maxLines="1"
        android:textAlignment="center"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toTopOf="@+id/audio_chart_indicator"
        app:layout_constraintStart_toEndOf="@+id/audio_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginBottom="11dp"
        style="@style/VkUiTypography.TextMedium"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/audio_chart_indicator"
        android:visibility="gone"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/audio_number"
        app:layout_constraintStart_toStartOf="@+id/audio_number"
        app:layout_constraintTop_toBottomOf="@+id/audio_number"/>
    <TextView
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="end"
        android:id="@+id/audio_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:minHeight="20dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="11dp"
        app:layout_constraintBottom_toTopOf="@+id/audio_artist"
        app:layout_constraintEnd_toStartOf="@+id/audio_duration"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/audio_number"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"
        style="@style/VkUiTypography.TextNormal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/audio_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="11dp"
        android:minHeight="16dp"
        android:maxLines="1"
        android:layout_marginEnd="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/audio_duration"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/audio_title"
        app:layout_constraintTop_toBottomOf="@+id/audio_title"
        app:layout_constraintWidth_default="wrap"
        style="@style/VkUiTypography.SubheadNormal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/audio_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:drawablePadding="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/audio_menu"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/audio_menu"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_actions_small_24"
        android:scaleType="center"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ActionButton.More"/>
</androidx.constraintlayout.widget.ConstraintLayout>
