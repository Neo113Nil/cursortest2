<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.SubheadSemiBold"
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/discover_grid_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.FootnoteNormal"
        android:textColor="?attr/vk_ui_text_contrast"
