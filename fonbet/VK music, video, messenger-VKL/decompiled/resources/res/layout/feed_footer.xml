<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.FluidHorizontalLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/likes_panel_actions_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/likes"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/post_side_padding"
        app:vk_layout_isFluid="true">
        <com.vk.feed.tool.view.newsfeed.FooterButton
            android:id="@+id/likes_wrapper"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:duplicateParentState="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/hover_radius_32"
            android:minHeight="32dp"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:stateListAnimator="@animator/feed_button_state"
            android:foregroundTintMode="multiply">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/iv_likes"
                android:duplicateParentState="true"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerInside"
                android:importantForAccessibility="no"
                app:actualImageScaleType="centerInside"
                app:placeholderImage="@drawable/user_placeholder"/>
            <com.vk.feed.design.view.newsfeed.reaction.FeedAnimatedView
                android:id="@+id/footer_reaction"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                app:layout_contentHeight="24dp"
                app:layout_contentWidth="24dp"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="@color/post_counters"
                android:id="@+id/tv_likes"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="4dp"
                style="?attr/vk_ui_typography_subhead_medium"/>
        </com.vk.feed.tool.view.newsfeed.FooterButton>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/comments_wrapper"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.vk.feed.tool.view.newsfeed.FooterButton
            android:id="@+id/fb_comments"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/hover_radius_32"
            android:minHeight="32dp"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:stateListAnimator="@animator/feed_button_state"
            android:foregroundTintMode="multiply">
            <ImageView
                android:id="@+id/iv_comments"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/vk_icon_comment_outline_24"
                app:tint="?attr/vk_ui_icon_secondary"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/comments"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="4dp"
                style="?attr/vk_ui_typography_subhead_medium"/>
        </com.vk.feed.tool.view.newsfeed.FooterButton>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/shares_wrapper"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.vk.feed.tool.view.newsfeed.FooterButton
            android:id="@+id/fb_shares"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/hover_radius_32"
            android:minHeight="32dp"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:stateListAnimator="@animator/feed_button_state"
            android:foregroundTintMode="multiply">
            <ImageView
                android:id="@+id/shares_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/vk_icon_share_outline_24"
                app:tint="?attr/vk_ui_icon_secondary"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/shares"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="4dp"
                style="?attr/vk_ui_typography_subhead_medium"/>
        </com.vk.feed.tool.view.newsfeed.FooterButton>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/donut_reaction_wrapper"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.vk.donut.design.view.reaction.DonutReactionButtonView
            android:id="@+id/donut_reaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/date_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/post_side_padding">
        <com.vk.feed.tool.view.newsfeed.FooterButton
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="start|center_vertical"
                android:id="@+id/date"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:singleLine="true"
                android:layout_marginStart="4dp"
                style="?attr/vk_ui_typography_footnote"/>
        </com.vk.feed.tool.view.newsfeed.FooterButton>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/views_wrapper"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/post_side_padding">
        <com.vk.feed.tool.view.newsfeed.FooterButton
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">
            <ImageView
                android:id="@+id/iv_views"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="centerInside"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/vk_icon_view_12"
                app:tint="?attr/vk_ui_icon_tertiary"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_tertiary"
                android:gravity="start|center_vertical"
                android:id="@+id/views"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:singleLine="true"
                android:layout_marginStart="4dp"
                style="?attr/vk_ui_typography_footnote"/>
        </com.vk.feed.tool.view.newsfeed.FooterButton>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/add_wrapper"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.vk.feed.tool.view.newsfeed.FooterButton
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/hover_radius_32"
            android:minHeight="32dp"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:stateListAnimator="@animator/feed_button_state"
            android:foregroundTintMode="multiply">
            <ImageView
                android:id="@+id/add"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_add_check_selectable_24"
                app:tint="?attr/vk_ui_icon_secondary"/>
        </com.vk.feed.tool.view.newsfeed.FooterButton>
    </FrameLayout>
</com.vk.core.tool.view.FluidHorizontalLayout>
