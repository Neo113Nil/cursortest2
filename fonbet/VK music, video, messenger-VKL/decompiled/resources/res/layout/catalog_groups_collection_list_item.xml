<?xml version="1.0" encoding="utf-8"?>
<com.vk.catalog2.common.ui.holders.group.GroupsCollectionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/catalog_bg_group_event_item"
    android:layout_width="@dimen/catalog_event_cover_width"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/cover_iv"
        android:layout_width="match_parent"
        android:layout_height="131dp"
        android:foreground="@drawable/highlight_radius_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle4"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="135dp"
        app:layout_constraintEnd_toEndOf="@+id/cover_iv"
        app:layout_constraintStart_toStartOf="@+id/cover_iv"
        app:layout_constraintTop_toTopOf="@+id/cover_iv"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/subtitle_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="135dp"
        app:layout_constraintEnd_toEndOf="@+id/cover_iv"
        app:layout_constraintStart_toStartOf="@+id/cover_iv"
        app:layout_constraintTop_toBottomOf="@+id/title_tv"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/view_all_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxLines="1"
        android:drawablePadding="6dp"
        android:paddingStart="4dp"
        android:layout_marginStart="8dp"
        android:paddingVertical="5dp"
        app:drawableEndCompat="@drawable/vk_icon_chevron_16"
        app:drawableTint="?attr/vk_ui_icon_contrast"
        app:layout_constraintBottom_toBottomOf="@+id/cover_iv"
        app:layout_constraintStart_toStartOf="@+id/cover_iv"/>
    <include
        android:id="@+id/group_item_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toStartOf="@+id/group_item_4"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cover_iv"
        layout="@layout/catalog_group_list_item"/>
    <include
        android:id="@+id/group_item_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/group_item_5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/group_item_1"
        layout="@layout/catalog_group_list_item"/>
    <include
        android:id="@+id/group_item_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/group_item_6"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/group_item_2"
        layout="@layout/catalog_group_list_item"/>
    <include
        android:id="@+id/group_item_4"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/group_item_1"
        app:layout_constraintTop_toBottomOf="@+id/cover_iv"
        layout="@layout/catalog_group_list_item"/>
    <include
        android:id="@+id/group_item_5"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/group_item_2"
        app:layout_constraintTop_toBottomOf="@+id/group_item_4"
        layout="@layout/catalog_group_list_item"/>
    <include
        android:id="@+id/group_item_6"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/group_item_3"
        app:layout_constraintTop_toBottomOf="@+id/group_item_5"
        layout="@layout/catalog_group_list_item"/>
</com.vk.catalog2.common.ui.holders.group.GroupsCollectionLayout>
