<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteCapsMedium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12sp"/>
    <ImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_style_selector"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/story_vmoji_stickers_header"
        android:layout_marginStart="7dp"
        app:srcCompat="@drawable/vk_icon_gear_outline_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
</LinearLayout>
