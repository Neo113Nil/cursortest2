<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_content_tint_rounded_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.PhotoStackView
        android:id="@+id/posting_visibility_friends_hint"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/newsfeed_newpost_choose_best_friends_title"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        style="@style/VkUiTypography.Headline1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/newsfeed_newpost_choose_best_friends_subtitle"
        android:textAlignment="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/posting_visibility_choose_friends"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/newsfeed_newpost_choose_best_friends_choose"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
</LinearLayout>
