<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clips_entry_point_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/clips_entry_point_toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/entry_points_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/toolbar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/entry_points_tab_view"
        android:background="@drawable/bottom_bar_background"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tab_button_height"
        android:layout_marginBottom="16dp"
        app:constraint_referenced_ids="clips_gallery_tab, clips_drafts_tab, clips_templates_tab, clips_trends_tab"
        app:flow_horizontalStyle="spread_inside"
        app:flow_wrapMode="aligned"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/entry_points_tab_photos_view"
        android:background="@drawable/clips_entry_point_photos_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_vertical"
            android:id="@+id/entry_points_photos_recycler"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="48dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:requiresFadingEdge="horizontal"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="96dp"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/entry_points_photos_go"
            android:layout_width="76dp"
            android:layout_height="36dp"
            android:contentDescription="@string/clips_entry_point_gallery_next"
            android:layout_marginEnd="16dp"
            app:buttonAppearance="overlay"
            app:buttonMode="primary"
            app:buttonSizeType="medium"
            app:text="@string/clips_entry_point_gallery_next"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/color_tab_buttons"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/clips_gallery_tab"
        android:padding="12dp"
        android:layout_width="@dimen/tab_button_width"
        android:layout_height="@dimen/tab_button_height"
        android:text="@string/clips_entry_point_gallery"
        android:drawablePadding="4dp"
        android:textAlignment="gravity"
        app:drawableTint="@color/color_tab_buttons"
        app:drawableTopCompat="@drawable/vk_icon_picture_outline_28"
        style="@style/VkUiTypography.Caption2Normal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/color_tab_buttons"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/clips_drafts_tab"
        android:padding="12dp"
        android:layout_width="@dimen/tab_button_width"
        android:layout_height="@dimen/tab_button_height"
        android:text="@string/clips_entry_point_drafts"
        android:drawablePadding="4dp"
        android:textAlignment="gravity"
        app:drawableTint="@color/color_tab_buttons"
        app:drawableTopCompat="@drawable/vk_icon_pen_stack_outline_28"
        style="@style/VkUiTypography.Caption2Normal"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/entry_points_drafts_counter"
        android:background="@drawable/bottom_navigation_counter_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="8dp"
        android:minWidth="18dp"
        android:singleLine="true"
        android:layout_marginStart="28dp"
        app:layout_constraintEnd_toEndOf="@+id/clips_drafts_tab"
        app:layout_constraintStart_toStartOf="@+id/clips_drafts_tab"
        app:layout_constraintTop_toTopOf="@+id/clips_drafts_tab"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/color_tab_buttons"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/clips_templates_tab"
        android:padding="12dp"
        android:layout_width="@dimen/tab_button_width"
        android:layout_height="@dimen/tab_button_height"
        android:text="@string/clips_entry_point_templates"
        android:drawablePadding="4dp"
        android:textAlignment="gravity"
        app:drawableTint="@color/color_tab_buttons"
        app:drawableTopCompat="@drawable/vk_icon_cards_2_outline_28"
        style="@style/VkUiTypography.Caption2Normal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/color_tab_buttons"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/clips_trends_tab"
        android:padding="12dp"
        android:layout_width="@dimen/tab_button_width"
        android:layout_height="@dimen/tab_button_height"
        android:text="@string/clips_entry_point_trends"
        android:drawablePadding="4dp"
        android:textAlignment="gravity"
        app:drawableTint="@color/color_tab_buttons"
        app:drawableTopCompat="@drawable/vk_icon_flash_outline_28"
        style="@style/VkUiTypography.Caption2Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
