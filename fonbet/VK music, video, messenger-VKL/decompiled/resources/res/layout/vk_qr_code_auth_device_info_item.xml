<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/qr_code_auth_device_info_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/vk_icon_computer_outline_24"
        app:tint="?attr/vk_connect_accent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/qr_code_auth_device_info_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        style="?attr/vk_ui_typography_headline1_normal"/>
</LinearLayout>
