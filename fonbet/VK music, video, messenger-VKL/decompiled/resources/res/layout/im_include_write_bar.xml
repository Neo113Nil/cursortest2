<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.writebar.WriteBar
        android:id="@+id/write_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:audio_msg_allowed="true"/>
    <com.vk.im.ui.views.WriteBarDisabled
        android:id="@+id/write_bar_disabled"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"/>
    <ViewStub
        android:id="@+id/write_bar_disabled_max_stub"
        android:visibility="gone"
        android:layout="@layout/im_include_write_bar_disabled_max"
        android:inflatedId="@+id/write_bar_disabled_max"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"/>
    <ViewStub
        android:id="@+id/write_bar_disabled_cell_stub"
        android:layout="@layout/im_include_write_bar_disabled_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
