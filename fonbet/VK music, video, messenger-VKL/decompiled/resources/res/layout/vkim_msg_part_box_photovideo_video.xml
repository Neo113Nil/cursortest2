<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.fresco.FrescoImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/vkim_accessibility_video"
        app:vkim_scaleType="center_crop"/>
    <com.vk.core.view.ProgressView
        android:layout_gravity="center"
        android:id="@+id/upload"
        android:importantForAccessibility="no"
        style="@style/VkIm.MsgPart.UploadIndicator.Default"/>
    <com.vk.core.widget.AutoFitTextView
        android:textAppearance="@style/VkIm.MsgPart.Label.TextContrast"
        android:gravity="center_vertical"
        android:layout_gravity="top|left"
        android:id="@+id/label"
        android:background="@drawable/vkim_bg_video_mosaic_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:lines="1"
        android:importantForAccessibility="noHideDescendants"
        app:maxTextSize="12sp"
        app:minTextSize="8sp"/>
    <com.vk.libvideo.design.view.movika.InteractiveDurationView
        android:textAppearance="@style/VkIm.MsgPart.Label.TextContrast"
        android:gravity="center_vertical"
        android:layout_gravity="top|left"
        android:id="@+id/interactive_duration"
        android:background="@drawable/bg_interactiv_video_duration_label_rounded_12"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:lines="1"
        android:importantForAccessibility="noHideDescendants"
        app:maxTextSize="12sp"
        app:minTextSize="8sp"/>
    <FrameLayout
        android:id="@+id/vkim_restriction_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
