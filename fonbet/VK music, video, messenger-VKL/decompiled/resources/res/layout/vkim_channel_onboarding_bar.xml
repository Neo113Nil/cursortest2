<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/channels_onboarding_banner_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/gradient_bg"
        android:background="@drawable/bg_onboarding_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/vk_white"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vkim_channels_onboarding_title_1"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        android:letterSpacing="0.01"
        android:layout_marginVertical="14dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_bg"
        app:layout_constraintLeft_toLeftOf="@+id/gradient_bg"
        app:layout_constraintRight_toLeftOf="@+id/description"
        app:layout_constraintTop_toTopOf="@+id/gradient_bg"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/vk_white"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vkim_channel_onboarding_try"
        android:fontFamily="@font/vk_roboto_regular"
        android:layout_marginEnd="4dp"
        android:letterSpacing="0.02"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_bg"
        app:layout_constraintLeft_toRightOf="@+id/title"
        app:layout_constraintRight_toLeftOf="@+id/chevron"
        app:layout_constraintTop_toTopOf="@+id/gradient_bg"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="22dp"
        android:tint="@color/vk_white"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_bg"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toRightOf="@+id/title"
        app:layout_constraintRight_toRightOf="@+id/gradient_bg"
        app:layout_constraintTop_toTopOf="@+id/gradient_bg"
        app:placeholderImage="@drawable/vk_icon_chevron_right_24"/>
</androidx.constraintlayout.widget.ConstraintLayout>
