<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/header_btn"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <com.vk.voip.ui.avatars.VoipAvatarViewContainer
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="@string/voip_participant_settings_avatar_content_description"
        android:layout_marginStart="16dp"
        app:borderStrokeWidth="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:roundAvatarSize="48dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/full_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toStartOf="@+id/raised_hand_indicator"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        style="@style/VkUiTypography.Headline1Normal"/>
    <ImageView
        android:id="@+id/raised_hand_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_hand_16"
        android:contentDescription="@string/voip_participant_settings_raised_hand_indicator_content_description"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toStartOf="@+id/open_profile_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/full_name"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        app:tint="?attr/vk_ui_icon_accent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/open_profile_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        app:srcCompat="@drawable/vk_icon_chevron_compact_right_24"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <ImageView
        android:id="@+id/lower_hand_btn"
        android:layout_marginTop="12dp"
        android:src="@drawable/vk_icon_hand_slash_outline_28"
        android:contentDescription="@string/voip_participant_settings_lower_hand_content_description"
        app:layout_constraintEnd_toStartOf="@+id/first_divider"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/avatar"
        app:layout_constraintTop_toBottomOf="@+id/avatar"
        style="@style/VoipParticipantSettingToolbarButton"/>
    <View
        android:id="@+id/first_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="0.5dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="14dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/lower_hand_btn"
        app:layout_constraintEnd_toStartOf="@+id/mute_microphone_btn"
        app:layout_constraintStart_toEndOf="@+id/lower_hand_btn"
        app:layout_constraintTop_toTopOf="@+id/lower_hand_btn"/>
    <ImageView
        android:id="@+id/mute_microphone_btn"
        android:src="@drawable/vk_icon_microphone_slash_outline_28"
        android:contentDescription="@string/voip_participant_settings_mute_microphone_content_description"
        app:layout_constraintBottom_toBottomOf="@+id/lower_hand_btn"
        app:layout_constraintEnd_toStartOf="@+id/turn_off_camera_btn"
        app:layout_constraintStart_toEndOf="@+id/first_divider"
        app:layout_constraintTop_toTopOf="@+id/lower_hand_btn"
        style="@style/VoipParticipantSettingToolbarButton"/>
    <ImageView
        android:id="@+id/turn_off_camera_btn"
        android:src="@drawable/vk_icon_videocam_slash_outline_28"
        android:contentDescription="@string/voip_participant_settings_turn_off_camera_content_description"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/lower_hand_btn"
        app:layout_constraintEnd_toStartOf="@+id/access_rights_btn"
        app:layout_constraintStart_toEndOf="@+id/mute_microphone_btn"
        app:layout_constraintTop_toTopOf="@+id/lower_hand_btn"
        style="@style/VoipParticipantSettingToolbarButton"/>
    <ImageView
        android:id="@+id/access_rights_btn"
        android:src="@drawable/vk_icon_sliders_outline_28"
        android:contentDescription="@string/voip_participant_settings_access_rights_content_description"
        android:layout_marginStart="8dp"
        android:backgroundTint="?attr/vk_ui_background_tertiary_alpha"
        app:layout_constraintBottom_toBottomOf="@+id/lower_hand_btn"
        app:layout_constraintEnd_toEndOf="@+id/open_profile_icon"
        app:layout_constraintStart_toEndOf="@+id/turn_off_camera_btn"
        app:layout_constraintTop_toTopOf="@+id/lower_hand_btn"
        app:tint="?attr/vk_ui_icon_accent_themed"
        style="@style/VoipParticipantSettingToolbarButton"/>
    <TextView
        android:id="@+id/pin_btn"
        android:layout_marginTop="14dp"
        android:text="@string/voip_participant_settings_pin"
        app:drawableStartCompat="@drawable/vk_icon_pin_dot_outline_28"
        app:layout_constraintTop_toBottomOf="@+id/lower_hand_btn"
        style="@style/VoipParticipantSettingsButton"/>
    <TextView
        android:id="@+id/request_attention_btn"
        android:text="@string/voip_participant_settings_request_attention"
        app:drawableStartCompat="@drawable/vk_icon_megaphone_outline_28"
        app:layout_constraintTop_toBottomOf="@+id/pin_btn"
        style="@style/VoipParticipantSettingsButton"/>
    <View
        android:id="@+id/second_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="4dp"
        app:layout_constraintBottom_toTopOf="@+id/grant_admin_btn"
        app:layout_constraintTop_toBottomOf="@+id/request_attention_btn"/>
    <TextView
        android:id="@+id/grant_admin_btn"
        android:text="@string/voip_participant_settings_grant_admin"
        app:drawableStartCompat="@drawable/vk_icon_user_star_outline_28"
        app:layout_constraintBottom_toTopOf="@+id/grant_admin_btn"
        app:layout_constraintTop_toBottomOf="@+id/second_divider"
        style="@style/VoipParticipantSettingsButton"/>
    <TextView
        android:id="@+id/move_to_waiting_room_btn"
        android:text="@string/voip_participant_settings_move_to_waiting_room"
        app:drawableStartCompat="@drawable/vk_icon_door_arrow_left_outline_28"
        app:layout_constraintTop_toBottomOf="@+id/grant_admin_btn"
        style="@style/VoipParticipantSettingsButton"/>
    <TextView
        android:id="@+id/rename_btn"
        android:text="@string/voip_participant_settings_rename"
        app:drawableStartCompat="@drawable/vk_icon_user_pen_outline_28"
        app:layout_constraintTop_toBottomOf="@+id/move_to_waiting_room_btn"
        style="@style/VoipParticipantSettingsButton"/>
    <View
        android:id="@+id/third_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="4dp"
        app:layout_constraintBottom_toTopOf="@+id/exclude_btn"
        app:layout_constraintTop_toBottomOf="@+id/rename_btn"/>
    <TextView
        android:id="@+id/exclude_btn"
        android:text="@string/voip_participant_settings_exclude"
        app:drawableStartCompat="@drawable/vk_icon_user_slash_outline_28"
        app:drawableTint="?attr/vk_ui_icon_negative"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/third_divider"
        style="@style/VoipParticipantSettingsButton"/>
    <FrameLayout
        android:id="@+id/states_layout"
        android:background="?attr/vk_ui_background_modal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_min="wrap"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.ColorProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:color="?attr/vk_ui_text_accent"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/error"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VkIm.Error.LargeText"/>
            <Button
                android:id="@+id/error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/vkim_retry"
                style="@style/VkIm.Error.LargeButton"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
