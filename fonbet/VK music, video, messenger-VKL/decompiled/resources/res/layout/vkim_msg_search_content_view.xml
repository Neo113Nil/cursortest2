<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.ui.AppBarLayoutWithDrawingOrderCallback
        android:id="@+id/vkim_search_app_bar"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:elevation="0dp">
        <FrameLayout
            android:id="@+id/vkim_search_box"
            android:background="?attr/vk_ui_header_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.components.search.VkSearchView
                android:id="@+id/vkim_search_view"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                style="?attr/im_toolbar_search_style"/>
        </FrameLayout>
        <com.vk.core.view.VKTabLayout
            android:id="@+id/vkim_tabs"
            android:background="?attr/vk_ui_header_background"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:tabGravity="fill"
            app:tabIndicator="?attr/tabBarIndicator"
            app:tabIndicatorColor="?attr/vk_ui_text_accent_themed"
            app:tabMode="fixed"
            app:tabPaddingEnd="16dp"
            app:tabPaddingStart="16dp"
            app:tabSelectedTextColor="?attr/vk_ui_text_primary"
            app:tabTextAppearance="@style/TabBarTheme.TabTextAppearance"
            app:tabTextColor="?attr/vk_ui_text_tertiary"/>
    </com.vk.core.ui.AppBarLayoutWithDrawingOrderCallback>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vkim_viewpager"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        app:vk_appbar_forceMode="none"
        style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
