<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_cover"
        android:layout_width="0dp"
        android:layout_height="@dimen/community_header_cover_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_block"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:layout_marginTop="@dimen/community_header_cover_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_avatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/v_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_block"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_name"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_avatar"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_info_2"
        android:layout_width="156dp"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_name"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_info_3"
        android:layout_width="156dp"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_info_2"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_buttons"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_info_3"/>
</merge>
