<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.spinner.VkScreenSpinner
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:spinnerMode="dialog"
        app:spinnerSize="large"/>
    <com.vk.clips.design.view.preview.ClipsVideoAndPhotoView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/choose_preview_from_gallery"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/choose_preview_from_gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="@string/clips_choose_preview_from_gallery"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toTopOf="@+id/timeline_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center_horizontal"
        android:id="@+id/timeline_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/clips_choose_preview_timeline_hint"
        android:textAlignment="center"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/timeline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/photo_thumb"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="56dp"
        android:foreground="@drawable/bg_choose_preview"
        android:scaleType="centerCrop"
        android:contentDescription="@string/clips_choose_preview_description"
        android:layout_marginEnd="8dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/timeline"
        app:layout_constraintEnd_toStartOf="@+id/timeline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/timeline"/>
    <com.vk.clips.design.view.timeline.MultiVideoTimelineView
        android:id="@+id/timeline"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginBottom="18dp"
        android:foreground="@drawable/bg_choose_preview_timeline"
        app:layout_constraintBottom_toTopOf="@+id/actions_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/photo_thumb"
        app:vtv_corner_radius="8dp"
        app:vtv_custom_bounds="true"
        app:vtv_frame_height="56dp"
        app:vtv_outbound_frames_color="@color/vk_black_alpha35"
        app:vtv_selector_drawable="@drawable/timeline_video_selector"
        app:vtv_selector_height="80dp"
        app:vtv_selector_width="2dp"
        app:vtv_timeline_height="56dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/actions_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="48dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/clips_choose_preview_cancel"
        app:buttonAppearance="overlay"
        app:buttonMode="tertiary"
        app:buttonSizeType="medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/actions_guideline"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/clips_choose_preview_done"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/actions_guideline"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/content_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="preview,choose_preview_from_gallery,             timeline_hint,timeline,cancel,done"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/error_placeholder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</merge>
