<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.VKTabLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/tab_layout"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:tabIndicator="@drawable/bg_posting_picker_article_tab_indicator"
        app:tabIndicatorColor="?attr/vk_ui_background_accent"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="?attr/vk_ui_text_primary"
        app:tabTextAppearance="@style/TabBarTheme.TabTextAppearance"
        app:tabTextColor="?attr/vk_ui_text_secondary"
        style="@style/TabBarTheme"/>
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/separator_height"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:background="?attr/vk_ui_background_content"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
