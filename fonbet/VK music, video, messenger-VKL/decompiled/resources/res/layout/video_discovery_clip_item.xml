<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Vk.Theme.VkApp.space_gray_generated"
    android:background="@drawable/bg_clip_card_rounded_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/clip_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:fadeDuration="150"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/clip_gradient"
        android:background="@drawable/video_clip_card_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/clip_owner_title"/>
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/clip_owner_avatar"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/clip_owner_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/clip_owner_title"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/clip_owner_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="textStart"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toTopOf="@+id/clip_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/clip_owner_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/clip_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textAlignment="textStart"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintBottom_toTopOf="@+id/clip_views"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clip_owner_title"
        style="@style/VkUiTypography.SubheadMedium.Unscaled"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:id="@+id/clip_views"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:maxLines="1"
        android:textAlignment="textStart"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clip_description"
        style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
</androidx.constraintlayout.widget.ConstraintLayout>
