<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/clip_feed_seekbar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/clip_feed_seekbar_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/clip_seekbar_view"/>
    <View
        android:id="@+id/clip_feed_seekbar_background"
        android:background="@color/vk_black"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="10dp"
        app:layout_constraintBottom_toTopOf="@+id/clip_feed_bottom_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/clip_feed_bottom_background"
        android:background="@color/vk_black"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/clip_feed_statistic_button"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        android:layout_marginVertical="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="@+id/clip_feed_bottom_background"
        app:layout_constraintEnd_toStartOf="@+id/clip_feed_promotion_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/clip_feed_bottom_background"
        app:layout_constraintTop_toTopOf="@+id/clip_feed_bottom_background"
        app:layout_goneMarginEnd="16dp"
        app:text="@string/clip_feed_statistic"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/clip_feed_promotion_button"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="@+id/clip_feed_bottom_background"
        app:layout_constraintEnd_toEndOf="@+id/clip_feed_bottom_background"
        app:layout_constraintStart_toEndOf="@+id/clip_feed_statistic_button"
        app:layout_constraintTop_toTopOf="@+id/clip_feed_bottom_background"
        app:text="@string/clip_feed_promoted"/>
    <FrameLayout
        android:gravity="start|top"
        android:id="@+id/upload_badge_container"
        android:layout_width="@dimen/clips_upload_badge_width"
        android:layout_height="@dimen/clips_upload_badge_height"
        android:layout_marginTop="@dimen/clips_upload_badge_margin_top_nps"
        android:layout_marginStart="@dimen/clips_upload_badge_margin_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:gravity="start|top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clips_upload_badge_margin_top_nps"
        android:layout_marginHorizontal="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/clips_nps_survey_popup"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:id="@+id/clip_feed_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clips_wrapper_top_bar"
        style="@style/VkUiTypography.SubheadMedium"/>
    <ViewStub
        android:id="@+id/clip_feed_download_progress_stub"
        android:layout="@layout/clips_wrapper_fragment_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/clip_feed_camera_anchor"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="48dp"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/clips_accessibility_make_clip"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <include layout="@layout/clips_wrapper_fragment_bottom_bar"/>
</merge>
