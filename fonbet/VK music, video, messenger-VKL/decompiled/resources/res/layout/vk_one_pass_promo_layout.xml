<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/base_auth_scrollable_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/one_pass_promo_lottie"
                android:layout_width="160dp"
                android:layout_height="144dp"
                android:layout_marginTop="70dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/vk_one_pass_promo"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center"
                android:id="@+id/one_pass_promo_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/vk_one_pass_promo_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/one_pass_promo_lottie"
                style="@style/VkUiTypography.Title2Medium"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/one_pass_promo_first_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/vk_one_pass_promo_first_subtitle"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/one_pass_promo_first_subtitle_icon"
                app:layout_constraintTop_toBottomOf="@+id/one_pass_promo_title"
                style="@style/VkUiTypography.Headline1Normal"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/one_pass_promo_first_subtext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/vk_one_pass_promo_first_subtext"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/one_pass_promo_first_subtitle_icon"
                app:layout_constraintTop_toBottomOf="@+id/one_pass_promo_first_subtitle"
                style="@style/VkUiTypography.FootnoteNormal"/>
            <ImageView
                android:id="@+id/one_pass_promo_first_subtitle_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="@+id/one_pass_promo_first_subtext"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/one_pass_promo_first_subtitle"
                app:srcCompat="@drawable/vk_icon_flash_outline_28"
                app:tint="?attr/vk_ui_text_accent_themed"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/one_pass_promo_second_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/vk_one_pass_promo_second_subtitle"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/one_pass_promo_second_subtitle_icon"
                app:layout_constraintTop_toBottomOf="@+id/one_pass_promo_first_subtext"
                style="@style/VkUiTypography.Headline1Normal"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/one_pass_promo_second_subtext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/vk_one_pass_promo_second_subtext"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/one_pass_promo_second_subtitle_icon"
                app:layout_constraintTop_toBottomOf="@+id/one_pass_promo_second_subtitle"
                style="@style/VkUiTypography.FootnoteNormal"/>
            <ImageView
                android:id="@+id/one_pass_promo_second_subtitle_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="@+id/one_pass_promo_second_subtext"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/one_pass_promo_second_subtitle"
                app:srcCompat="@drawable/vk_icon_lock_outline_28"
                app:tint="?attr/vk_ui_text_accent_themed"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/one_pass_promo_third_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/vk_one_pass_promo_third_subtitle"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/one_pass_promo_third_subtitle_icon"
                app:layout_constraintTop_toBottomOf="@+id/one_pass_promo_second_subtext"
                style="@style/VkUiTypography.Headline1Normal"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/one_pass_promo_third_subtext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/vk_one_pass_promo_third_subtext"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toTopOf="@+id/enable_one_pass_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/one_pass_promo_third_subtitle_icon"
                app:layout_constraintTop_toBottomOf="@+id/one_pass_promo_third_subtitle"
                app:layout_constraintVertical_chainStyle="spread_inside"
                style="@style/VkUiTypography.FootnoteNormal"/>
            <ImageView
                android:id="@+id/one_pass_promo_third_subtitle_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="@+id/one_pass_promo_third_subtext"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/one_pass_promo_third_subtitle"
                app:srcCompat="@drawable/vk_icon_check_shield_outline_28"
                app:tint="?attr/vk_ui_text_accent_themed"/>
            <com.vk.core.view.components.button.VkSimpleButton
                android:textColor="?attr/vk_ui_text_contrast_themed"
                android:id="@+id/enable_one_pass_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginBottom="12dp"
                android:text="@string/vk_one_pass_promo_enable_button"
                app:buttonAppearance="accent"
                app:buttonMode="primary"
                app:buttonSizeType="large"
                app:layout_constraintBottom_toTopOf="@+id/later_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/one_pass_promo_third_subtext"/>
            <com.vk.core.view.components.button.VkSimpleButton
                android:textColor="?attr/vk_ui_text_accent_themed"
                android:id="@+id/later_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/vk_one_pass_promo_later_button"
                android:paddingHorizontal="@dimen/vk_ui_button_padding_horizontal"
                app:buttonAppearance="accent"
                app:buttonMode="secondary"
                app:buttonSizeType="large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.appbar.AppBarLayout
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <com.vk.superapp.ui.toolbar.VkAuthToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationContentDescription="@string/vk_auth_accessibility_close"
            app:navigationIcon="@drawable/vk_icon_dismiss_24"/>
    </com.google.android.material.appbar.AppBarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
