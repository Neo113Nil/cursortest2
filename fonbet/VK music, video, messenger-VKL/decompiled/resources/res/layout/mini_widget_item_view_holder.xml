<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="96dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:minHeight="80dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background_view"
        android:background="@drawable/vk_mini_widget_bg_16dp"
        android:layout_width="92dp"
        android:layout_height="60dp"
        android:layout_marginTop="1dp"
        android:elevation="1dp"
        android:backgroundTint="?attr/vk_ui_background_tertiary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/stub1_view"
            android:background="@drawable/vk_superapp_content_tint_radius_6"
            android:layout_width="36dp"
            android:layout_height="8dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="?attr/vk_ui_skeleton_to"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/stub2_view"
            android:background="@drawable/vk_superapp_content_tint_radius_6"
            android:layout_width="26dp"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="?attr/vk_ui_skeleton_to"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stub1_view"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/top_icon_view"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginBottom="22dp"
            android:layout_marginStart="54dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/bottom_icon_view"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="22dp"
            android:layout_marginStart="54dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/disabled_view"
        android:background="@drawable/vk_mini_widget_bg_16dp"
        android:visibility="gone"
        android:layout_width="92dp"
        android:layout_height="60dp"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:elevation="1dp"
        android:backgroundTint="?attr/vk_ui_background_tertiary"
        android:outlineProvider="none"
        app:layout_constraintBottom_toBottomOf="@+id/background_view"
        app:layout_constraintEnd_toEndOf="@+id/background_view"
        app:layout_constraintStart_toStartOf="@+id/background_view"
        app:layout_constraintTop_toTopOf="@+id/background_view"/>
    <ImageView
        android:id="@+id/disabled_image_view"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/disabled_view"
        app:layout_constraintEnd_toEndOf="@+id/disabled_view"
        app:layout_constraintStart_toStartOf="@+id/disabled_view"
        app:layout_constraintTop_toTopOf="@+id/disabled_view"
        app:srcCompat="@drawable/vk_icon_info_circle_16"
        app:tint="?attr/vk_ui_icon_medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/background_view"
        style="@style/VkUiTypography.Footnote"/>
</androidx.constraintlayout.widget.ConstraintLayout>
