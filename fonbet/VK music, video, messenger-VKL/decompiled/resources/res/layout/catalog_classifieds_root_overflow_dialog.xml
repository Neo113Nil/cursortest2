<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_modal"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/geo_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <com.vk.core.view.components.divider.VkDivider
        android:id="@+id/geo_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"/>
    <com.vk.core.view.components.group.header.VkGroupHeader
        android:id="@+id/products_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/order_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/wishlist_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/all_reviews_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
