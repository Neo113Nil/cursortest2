<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hashtag_select_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.vk.core.ui.bottomsheet.internal.VkBottomSheetBehavior">
    <FrameLayout
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clip_bottomsheet_separator_height">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_hashtag_list"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <View
        android:id="@+id/v_select_shadow"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clip_bottomsheet_separator_height"/>
</FrameLayout>
