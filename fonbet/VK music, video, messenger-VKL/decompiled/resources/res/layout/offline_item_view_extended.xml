<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/offline_view_item"
    android:background="@drawable/highlight"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/photo_container"
        android:layout_width="142dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:actualImageScaleType="centerCrop"
            app:emptyImagePlaceholder="@drawable/ic_videos_placeholder"
            app:placeholderImage="@drawable/default_placeholder_8"/>
        <com.vk.libvideo.design.view.overlay.VideoOverlayView
            android:id="@+id/overlay_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foregroundGravity="center"
            app:vov_force_redesign="true"
            app:vov_size="small"/>
        <View
            android:id="@+id/video_not_playable_overlay"
            android:background="?attr/vk_ui_overlay_primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_gravity="bottom"
            android:id="@+id/video_progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="false"
            app:indicatorColor="@color/vk_azure_A100"
            app:layout_constraintBottom_toTopOf="@+id/image_barrier"
            app:trackColor="@color/vk_black_alpha45"
            app:trackCornerRadius="2dp"/>
    </androidx.cardview.widget.CardView>
    <ImageButton
        android:id="@+id/retry_button"
        android:background="@drawable/video_offline_retry_button_bg"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/vk_icon_replay_outline_24"
        android:contentDescription="@string/video_error_retry"
        app:layout_constraintBottom_toBottomOf="@+id/photo_container"
        app:layout_constraintEnd_toEndOf="@+id/photo_container"
        app:layout_constraintStart_toStartOf="@+id/photo_container"
        app:layout_constraintTop_toTopOf="@+id/photo_container"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.libvideo.design.view.duration.DurationView
        android:id="@+id/duration"
        android:background="@drawable/bg_video_duration_label_old"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/photo_container"
        app:layout_constraintEnd_toEndOf="@+id/photo_container"/>
    <ImageView
        android:id="@+id/options"
        android:background="@drawable/highlight_circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_actions_small_24"
        android:scaleType="centerInside"
        android:contentDescription="@string/menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_medium"/>
    <ImageView
        android:id="@+id/audio_only_indicator"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_cam_slash_16"
        android:contentDescription="@string/quality_audio_only"
        app:layout_constraintBottom_toBottomOf="@+id/photo_container"
        app:layout_constraintStart_toStartOf="@+id/photo_container"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lines="@null"
        android:singleLine="false"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/downloading_extended_state_view"
        app:layout_constraintEnd_toStartOf="@+id/options"
        app:layout_constraintStart_toEndOf="@+id/photo_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.libvideo.offline.ui.VideoOfflineExtendedStateView
        android:id="@+id/downloading_extended_state_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toTopOf="@+id/size"
        app:layout_constraintEnd_toStartOf="@+id/options"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:drawablePadding="4dp"
        app:drawableTint="?attr/vk_ui_icon_secondary"
        app:layout_constraintBottom_toTopOf="@+id/donut_chip"
        app:layout_constraintEnd_toStartOf="@+id/options"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/downloading_extended_state_view"
        style="@style/VkUiTypography.Caption1Normal"/>
    <com.vk.core.view.components.text.links.VkLinkedText
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/donut_chip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/options"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/size"
        style="?attr/vk_ui_typography_caption1_normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
