<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/live_chat_comments_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.clips.design.view.live.chat.ChatChangeVisibilityView
                android:id="@+id/live_chat_change_visibility"
                android:paddingTop="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                style="@style/VkUiTypography.Caption1Medium"/>
            <com.vk.libvideo.live.impl.views.chat.LiveRecycleView
                android:id="@+id/liveChatRecycle"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:dividerHeight="0dp"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/liveChatNewComments"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginBottom="16dp"
            android:foreground="?attr/selectableItemBackground"
            android:alpha="0"
            android:elevation="4dp">
            <TextView
                android:textColor="@color/live_new_messages_text"
                android:gravity="center"
                android:id="@+id/liveChatNewCommentsTextLight"
                android:background="@drawable/bg_live_new_messages"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/unread_messages"
                android:drawablePadding="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="13dp"
                app:drawableStartCompat="@drawable/ic_arrow_newmessage"
                style="@style/VkUiTypography.Caption1Medium"/>
            <TextView
                android:textColor="@color/vk_gray_800"
                android:gravity="center"
                android:id="@+id/liveChatNewCommentsTextDark"
                android:background="@drawable/bg_live_new_messages"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/unread_messages"
                android:drawablePadding="5dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="10dp"
                app:drawableStartCompat="@drawable/vk_icon_down_16"
                app:drawableTint="@color/vk_gray_800"
                style="@style/VkUiTypography.Caption1Medium"/>
        </FrameLayout>
    </FrameLayout>
    <com.vk.libvideo.live.impl.views.chat.elements.Comment
        android:id="@+id/live_pinned_comment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/liveChatActionLinkHolder"
        android:paddingLeft="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
