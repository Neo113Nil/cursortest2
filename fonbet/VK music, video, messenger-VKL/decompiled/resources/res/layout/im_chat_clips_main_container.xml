<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/im_chat_clips_main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/im_chat_clips_write_area"
        android:background="?attr/vk_ui_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/im_chat_clips_writebar_clickable_area"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="48dp"/>
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/im_chat_clips_reactions_container"
        android:background="?attr/vk_ui_background"
        android:clipChildren="false"
        android:layout_width="146dp"
        android:layout_height="48dp"/>
    <View
        android:id="@+id/im_chat_clips_touch_area_above_writebar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="48dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/im_chat_clips_exterior_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"/>
</FrameLayout>
