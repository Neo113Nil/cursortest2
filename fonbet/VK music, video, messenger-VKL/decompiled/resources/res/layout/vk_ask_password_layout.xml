<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.auth.ui.VkAuthTextView
        android:textAppearance="@style/VkUiTypography.SubheadNormal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vk_connect_ask_password_vkid"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.ui.themes.VKReplacerView
        android:id="@+id/profile_avatar_view"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"/>
    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/phone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/not_my_account"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/profile_avatar_view"
        app:layout_constraintTop_toTopOf="@+id/profile_avatar_view"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="40dp"
        style="@style/VkAuth.ExchangeUserNameText"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadNormal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/profile_avatar_view"
        app:layout_constraintEnd_toStartOf="@+id/not_my_account"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:layout_gravity="center_horizontal"
        android:id="@+id/not_my_account"
        android:background="@drawable/vk_auth_bg_landing_tertiary_btn_small"
        android:paddingTop="5.5dp"
        android:paddingBottom="6.5dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vk_auth_existing_profile_not_me"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/profile_avatar_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/profile_avatar_view"
        app:layout_goneMarginBottom="0dp"/>
    <com.vk.auth.ui.VkAuthPasswordView
        android:id="@+id/password_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_avatar_view"
        app:vk_action_button_content_description="@string/vk_auth_forgot_pass"
        app:vk_action_button_id="@+id/forgot_password"
        app:vk_action_button_src="@drawable/vk_icon_help_outline_24"
        app:vk_edit_text_background="@drawable/vk_auth_bg_landing_edittext"
        app:vk_edit_text_hint="@string/vk_auth_password"
        app:vk_edit_text_layout="@layout/vk_auth_landing_password_edittext"
        app:vk_toggle_button_content_description="@string/vk_auth_show_pass"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/user_group"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="profile_avatar_view,phone,name"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadNormal"
        android:textColor="?attr/vk_ui_background_negative"
        android:gravity="start"
        android:id="@+id/error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@+id/password_container"/>
    <com.vk.auth.ui.VkLoadingButton
        android:id="@+id/next"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:text="@string/vk_connect_ask_password_confirm"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_view"
        style="@style/VkAuth.Button.Primary"/>
</merge>
