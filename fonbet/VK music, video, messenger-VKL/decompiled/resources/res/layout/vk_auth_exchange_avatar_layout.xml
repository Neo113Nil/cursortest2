<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.ui.themes.VKReplacerView
        android:id="@+id/exchange_user_avatar_view"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1Medium"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/notifications_counter"
        android:background="@drawable/vk_auth_bg_exchange_notifications_oval"
        android:visibility="gone"
        android:layout_width="20sp"
        android:layout_height="20sp"
        android:minWidth="20sp"
        android:importantForAccessibility="no"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/selected_icon"
        android:background="@drawable/vk_auth_bg_exchange_selected_user"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="center"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/vk_icon_done_16"
        app:tint="?attr/vk_ui_icon_contrast_themed"/>
    <ImageView
        android:layout_gravity="start|top"
        android:id="@+id/delete_icon"
        android:background="@drawable/vk_auth_bg_exchange_delete_user"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="center"
        android:contentDescription="@string/vk_auth_accessibility_clear_data_account"
        app:srcCompat="@drawable/vk_icon_cancel_16"
        app:tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_primary"/>
</merge>
