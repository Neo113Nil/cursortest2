<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/enter_pip"
        android:background="@drawable/one_video_highlight_circle_white"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:contentDescription="@string/one_video_accessibility_picture_in_picture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/one_video_icon_chevron_24"
        app:tint="@color/one_video_white"/>
    <one.video.controls.views.AutoPlaySwitchView
        android:id="@+id/autoplay_switch"
        android:layout_width="38dp"
        android:layout_height="14dp"
        android:layout_marginEnd="16dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/more"
        app:layout_constraintEnd_toStartOf="@+id/more"
        app:layout_constraintTop_toTopOf="@+id/more"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/more"
        android:background="@drawable/one_video_highlight_circle_white"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/one_video_icon_more_24"
        android:scaleType="center"
        android:contentDescription="@string/one_video_accessibility_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/one_video_white"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="enter_pip,more"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/one_video_white"
        android:gravity="center"
        android:id="@+id/autoplay_mode_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vk_roboto_regular"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/barrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
