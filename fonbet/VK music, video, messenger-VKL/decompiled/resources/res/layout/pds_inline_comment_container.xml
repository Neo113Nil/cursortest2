<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/container_inline_comment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/pds_avatar_inline_comment"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="16dp"/>
    <com.vk.feed.design.view.newsfeed.inline.VkFeedInlineCommentView
        android:id="@+id/pds_inline_comment_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
