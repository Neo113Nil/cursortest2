<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/clips_timer_dialog_space_horizontal"
    android:paddingVertical="@dimen/clips_timer_dialog_space_vertical">
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/clips_timer_dialog_countdown"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.segmented.control.VkSegmentedControl
        android:id="@+id/count_down_selector_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.clips.design.view.camera.ClipsTimerTimeSelectorWrap
        android:id="@+id/clips_timer_selector_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/clips_timer_reset_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="@string/clips_timer_dialog_reset"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:buttonMode="secondary"
            app:buttonSizeType="large"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/clips_timer_set_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="@string/clips_timer_dialog_set"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </LinearLayout>
</LinearLayout>
