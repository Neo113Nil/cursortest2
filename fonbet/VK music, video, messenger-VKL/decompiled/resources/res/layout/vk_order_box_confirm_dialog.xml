<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_modal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="68dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/description_container"
                android:background="@drawable/vk_scrim_bottom"
                android:paddingBottom="20dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:backgroundTint="?attr/vk_ui_background_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <FrameLayout
                    android:id="@+id/mini_app_icon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Title2Medium"
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center"
                    android:id="@+id/order_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/vk_confirm_payment_order_description"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mini_app_icon"
                    app:layout_goneMarginTop="6dp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Subhead"
                    android:textColor="?attr/vk_ui_text_subhead"
                    android:gravity="center"
                    android:id="@+id/your_balance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/vk_confirm_payment_your_balance"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/order_description"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/auto_buy_check_container"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/description_container"
                app:layout_goneMarginTop="0dp">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/auto_buy_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_marginStart="11dp"
                    app:layout_constraintBottom_toBottomOf="@+id/settings_description"
                    app:layout_constraintBottom_toTopOf="@+id/settings_description"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/settings_title"/>
                <TextView
                    android:textColor="@color/vk_ui_text_title_color"
                    android:id="@+id/settings_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/vk_not_confirm_order"
                    android:singleLine="true"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/auto_buy_checkbox"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/VkUiTypography.Headline1Normal"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/settings_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/vk_not_confirm_order_description"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/auto_buy_checkbox"
                    app:layout_constraintTop_toBottomOf="@+id/settings_title"
                    style="@style/VkUiTypography.Footnote"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/dismiss_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/vk_confirm_payment_dismiss"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="6dp"
        android:stateListAnimator="@null"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buy_button"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/buy_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/vk_confirm_payment_buy"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        android:stateListAnimator="@null"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="@+id/dismiss_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dismiss_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
