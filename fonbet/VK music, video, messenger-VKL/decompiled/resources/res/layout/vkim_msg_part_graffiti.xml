<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.fresco.VKEnhancedImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="320dp"
        android:maxHeight="320dp"
        android:minWidth="96dp"
        android:minHeight="144dp"
        android:contentDescription="@string/vkim_accessibility_graffiti"
        app:imageScaleType="fit_start"/>
    <com.vk.core.view.ProgressView
        android:layout_gravity="center"
        android:id="@+id/upload"
        style="@style/VkIm.MsgPart.UploadIndicator.Default"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextContrast"
        android:layout_gravity="bottom|right"
        android:id="@+id/timeAndStatus"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:importantForAccessibility="no"/>
</FrameLayout>
