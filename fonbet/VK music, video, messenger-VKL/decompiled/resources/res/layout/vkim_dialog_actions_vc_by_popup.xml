<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_actions_list_container"
    android:background="@drawable/vkim_bg_overlay"
    android:padding="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:backgroundTint="?attr/vk_ui_background_modal"
    android:backgroundTintMode="multiply">
    <com.vk.im.ui.views.dialog_actions.DialogActionsListView
        android:id="@+id/dialog_actions_list_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:fadingEdge="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:vklib_alv_dividerColor="?attr/vk_ui_separator_primary_alpha"
        app:vklib_alv_dividerHeight="16dp"
        app:vklib_alv_dividerSize="0.5dp"
        app:vklib_alv_optionBackground="@drawable/vkim_ripple_dark"
        app:vklib_alv_optionIconLabelSpace="18dp"
        app:vklib_alv_optionIconTint="?attr/vk_ui_icon_accent_themed"
        app:vklib_alv_optionLabelTextColor="?attr/vk_ui_text_primary"
        app:vklib_alv_optionLabelTextSize="16sp"
        app:vklib_alv_optionPaddingEnd="16dp"
        app:vklib_alv_optionPaddingStart="18dp"/>
</LinearLayout>
