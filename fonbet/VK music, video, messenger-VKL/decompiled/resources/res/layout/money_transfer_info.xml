<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_send"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_money_transfer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/vk_icon_money_transfer_outline_56"
            app:tint="?attr/vk_legacy_accent"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/money_transfer_send_money_to_friend_desc_title"
            style="@style/VkLegacyTypography.Title1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="@string/money_transfer_send_money_to_friend_desc_subtitle"
            android:lineSpacingExtra="1sp"
            android:fontFamily="@string/font_family_regular"
            android:letterSpacing="0.01"/>
        <TextView
            android:textSize="15sp"
            android:id="@+id/tv_read_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/money_transfer_read_more"
            android:lineSpacingExtra="5sp"
            android:letterSpacing="0.01"
            style="@style/VkLegacyButton.Tertiary"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_friends_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">
            <com.vk.im.ui.views.avatars.StackAvatarView
                android:id="@+id/friends_photos2"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                app:vkim_drawingOrder="usual"
                app:vkim_extraColor="?attr/vk_legacy_icon_secondary"
                app:vkim_iconOffset="-6dp"
                app:vkim_iconSize="32dp"
                app:vkim_strokeColor="?attr/vk_legacy_modal_card_background"
                app:vkim_strokeWidth="2dp"
                app:vkim_useExtraView="true"/>
            <com.vk.money.ui.avatar.MoneyAvatarView
                android:id="@+id/friend_photo"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/vk_legacy_text_subhead"
                android:gravity="center"
                android:id="@+id/friends_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@string/font_family_regular"
                android:letterSpacing="0.02"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:id="@+id/btn_send"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/money_transfer_send_money_to_friend"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_link"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/primary_button"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/btn_link"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="24dp"
        android:text="@string/money_transfer_link"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/secondary_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
