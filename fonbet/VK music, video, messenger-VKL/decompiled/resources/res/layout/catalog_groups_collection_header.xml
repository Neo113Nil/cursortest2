<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_bar_layout"
    android:background="?attr/vk_ui_header_background"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:id="@+id/collapsing_layout"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:collapsedTitleTextAppearance="@style/Catalog.GroupsCollection.ToolbarTitle"
        app:contentScrim="?attr/vk_ui_header_background"
        app:expandedTitleGravity="start|top"
        app:expandedTitleMarginStart="16dp"
        app:expandedTitleTextAppearance="@style/Catalog.GroupsCollection.ToolbarTitle.Expanded"
        app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
        app:scrimVisibleHeightTrigger="173dp"
        app:statusBarScrim="@android:color/transparent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:fitsSystemWindows="true"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_collapseMode="parallax">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/block_cover"
                android:background="?attr/vk_ui_image_placeholder"
                android:layout_width="match_parent"
                android:layout_height="208dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@drawable/catalog_bg_groups_collection_header"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/block_cover"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_subhead"
                android:id="@+id/block_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/block_cover"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_collapseMode="pin"/>
    </com.google.android.material.appbar.CollapsingToolbarLayout>
</com.google.android.material.appbar.AppBarLayout>
