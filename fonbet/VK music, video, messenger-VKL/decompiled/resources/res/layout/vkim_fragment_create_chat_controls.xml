<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/im_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/im_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/chat_params_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/chat_params_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vkim_create_chat_controls_presets_margin_top">
                <com.vk.core.view.components.cell.VkCell
                    android:id="@+id/default_chat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.vk.core.view.components.cell.VkCell
                    android:id="@+id/closed_chat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.vk.core.view.components.cell.VkCell
                    android:id="@+id/customs_chat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.vk.core.view.components.group.header.VkGroupHeader
                    android:id="@+id/params_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
