<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/sv_mt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.VKTabLayout
                android:id="@+id/tabs_request"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                style="?attr/tabBarTheme"/>
            <com.vk.money.createtransfer.input.TransferInputFieldView
                android:id="@+id/transfer_input_field"
                android:layout_width="match_parent"
                android:layout_height="216dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                app:vk_max_height="216dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_chat_request_controls"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:animateLayoutChanges="true">
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/vk_legacy_text_subhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/money_transfer_recommended_amount"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/vk_roboto_regular"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_recommended_container"
                    android:background="@drawable/bg_money_chat_request"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <com.vk.common.view.EditText
                        android:textSize="16sp"
                        android:textColor="?attr/vk_legacy_text_primary"
                        android:textColorHint="?attr/vk_legacy_text_tertiary"
                        android:id="@+id/et_recommended_input"
                        android:background="@android:color/transparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="1dp"
                        android:hint="0"
                        android:maxLength="6"
                        android:inputType="number"
                        android:layout_marginStart="12dp"
                        app:editTextTypeface="Regular"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="?attr/vk_legacy_text_primary"
                        android:id="@+id/currency_sign_recommended"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="?attr/vk_legacy_text_subhead"
                    android:id="@+id/ll_recommended_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/money_transfer_will_be_offered_to_each_sender"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/vk_roboto_regular"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="24dp"/>
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textSize="16sp"
                    android:textColor="?attr/vk_legacy_text_muted"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/cb_participate_in_collecting"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:checked="true"
                    android:text="@string/money_transfer_request_participate_in_collecting"
                    android:maxLines="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="16dp"
                    style="@style/VkCheckBoxTheme"/>
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textSize="16sp"
                    android:textColor="?attr/vk_legacy_text_muted"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/cb_pin_msg"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:checked="true"
                    android:text="@string/money_transfer_request_pinned_msg"
                    android:maxLines="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="16dp"
                    style="@style/VkCheckBoxTheme"/>
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textSize="16sp"
                    android:textColor="?attr/vk_legacy_text_muted"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/cb_auto_card"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/money_transfer_request_use_card"
                    android:maxLines="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="16dp"
                    style="@style/Widget.AppCompat.CompoundButton.CheckBox"/>
                <com.vk.core.view.TintTextView
                    android:textSize="16sp"
                    android:textColor="?attr/vk_legacy_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_card_title"
                    android:background="@drawable/money_transfer_selectable_field"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:includeFontPadding="false"
                    android:drawablePadding="8dp"
                    android:lineSpacingExtra="4sp"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:drawableEndCompat="@drawable/vk_icon_dropdown_24"
                    app:drawableRightTint="?attr/vk_legacy_overlay_status_icon"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="16sp"
        android:layout_gravity="bottom"
        android:id="@+id/positive"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/money_transfer_proceed_next"
        style="@style/primary_button"/>
</LinearLayout>
