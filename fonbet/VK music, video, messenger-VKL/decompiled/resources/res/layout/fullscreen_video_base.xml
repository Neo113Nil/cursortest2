<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.core.tool.view.vkblur.VkBlurContentView
        android:id="@+id/fullscreen_video_base_blur_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.tool.view.RatioFrameLayout
            android:layout_gravity="center"
            android:id="@+id/fullscreen_video_base_video_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:orientation="vertical">
            <com.vk.core.view.components.picture.VkPicture
                android:id="@+id/fullscreen_video_base_preview"
                android:background="@color/vk_black"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:actualImageScaleType="centerCrop"/>
        </com.vk.core.tool.view.RatioFrameLayout>
    </com.vk.core.tool.view.vkblur.VkBlurContentView>
    <com.vk.core.ui.themes.VKReplacerView
        android:id="@+id/fullscreen_video_base_restriction_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="bottom"
        android:id="@+id/fullscreen_video_base_loader"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:indeterminate="true"
        android:indeterminateTintMode="src_in"
        style="?android:attr/progressBarStyleHorizontal"/>
</merge>
