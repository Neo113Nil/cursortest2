<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/liveSpectatorsImage"
        android:background="@drawable/highlight_circle_white"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:borderWidth="0dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/liveSpectatorsContainer1"
        android:paddingLeft="44dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.vk.core.view.links.LinkedTextView
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/liveSpectatorsName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:maxLines="1"
            android:shadowColor="#52000000"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:layout_weight="1"
            android:breakStrategy="simple"
            style="@style/VkUiTypography.SubheadMedium"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/liveSpectatorsVerified"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/liveSpectatorsContainer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">
        <FrameLayout
            android:id="@+id/liveSpectatorsLiveBadgeNew"
            android:layout_width="24dp"
            android:layout_height="12dp"
            android:layout_marginLeft="44dp"
            android:layout_marginRight="2dp"/>
        <ImageView
            android:id="@+id/liveSpectatorsBalanceIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/vk_icon_deprecated_ic_live_donation"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/liveSpectatorsBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:text=" "
            android:maxLines="1"
            android:shadowColor="#52000000"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:breakStrategy="simple"/>
        <ImageView
            android:id="@+id/liveSpectatorsViewersIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_live_spectators"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/liveSpectatorsViewers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:maxLines="1"
            android:shadowColor="#52000000"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:breakStrategy="simple"/>
        <ImageView
            android:id="@+id/liveSpectatorsTimeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="3dp"
            android:src="@drawable/vk_icon_deprecated_ic_time_24"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/liveSpectatorsTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:maxLines="1"
            android:shadowColor="#52000000"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:breakStrategy="simple"/>
    </LinearLayout>
</merge>
