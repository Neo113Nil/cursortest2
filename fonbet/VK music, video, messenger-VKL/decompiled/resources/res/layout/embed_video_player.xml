<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_content_wrap"
    android:background="@color/vk_black"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.tool.view.RatioFrameLayout
        android:layout_gravity="center"
        android:id="@+id/video_cointainer"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/video_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <WebView
            android:layout_gravity="center"
            android:id="@+id/webview_video_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.vk.core.tool.view.RatioFrameLayout>
    <com.vk.core.view.components.spinner.VkSpinnerContent
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:spinnerSize="large"/>
    <com.vk.libvideo.design.view.panel.VideoBottomPanelView
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.libvideo.design.view.toolbar.VideoToolbarView
        android:id="@+id/video_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
