<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/offline_view_item"
    android:background="@drawable/highlight"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp">
    <FrameLayout
        android:id="@+id/video_image_container"
        android:layout_width="142dp"
        android:layout_height="80dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/text_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:actualImageScaleType="centerCrop"
            app:emptyImagePlaceholder="@drawable/ic_videos_placeholder"
            app:placeholderImage="@drawable/default_placeholder_8"
            app:roundedCornerRadius="8dp"/>
        <com.vk.libvideo.design.view.progress.VideoProgressView
            android:layout_gravity="center"
            android:id="@+id/download_view"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/options"
        android:background="@drawable/highlight_circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_actions_small_24"
        android:scaleType="centerInside"
        android:contentDescription="@string/menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_medium"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/options"
        app:layout_constraintStart_toEndOf="@+id/video_image_container"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="@color/vk_ui_text_title_color"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lines="@null"
            android:singleLine="false"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:singleLine="false"
            style="@style/VkUiTypography.Footnote"/>
        <TextView
            android:textColor="?attr/vk_ui_background_negative"
            android:ellipsize="end"
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/exo_download_failed"
            android:singleLine="true"
            style="@style/VkUiTypography.Footnote"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="6dp"
            app:drawableTint="?attr/vk_ui_icon_secondary"
            style="@style/VkUiTypography.Footnote"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
