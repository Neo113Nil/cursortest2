<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="start|center_vertical"
    android:id="@+id/badges_wrapper"
    android:paddingTop="6dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/badges_send_text_view"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/newsfeed_send_badge"
        android:drawablePadding="7dp"
        android:layout_marginEnd="8dp"
        app:drawableLeftCompat="@drawable/vk_icon_gift_outline_20"
        app:drawableTint="?attr/vk_ui_icon_secondary"
        style="?attr/vk_ui_typography_footnote"/>
    <LinearLayout
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/badges_counter_wrapper"
        android:background="@drawable/highlight_radius_6"
        android:visibility="gone"
        android:clipChildren="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp">
        <com.vk.core.view.PhotoStackView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/badges_stack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_icon_medium"
            android:ellipsize="end"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/badges_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="?attr/vk_ui_typography_footnote"/>
    </LinearLayout>
</FrameLayout>
