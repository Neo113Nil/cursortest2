<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/story_dialog_root_layout"
    android:background="@color/story_dialog_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.stories.tool.view.NoOverlappingRenderingTextView
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/story_dialog_done"
        android:background="@drawable/white_ripple_unbounded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:minWidth="80dp"
        android:minHeight="44dp"
        android:text="@string/done"
        android:contentDescription="@string/story_hashtag_content_desc_done_bn"
        android:layout_marginEnd="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Title3SemiBold"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/story_question_dialog_question_layout"
        android:background="@drawable/bg_story_question"
        android:paddingLeft="@dimen/story_question_sticker_content_left_right_space"
        android:paddingTop="@dimen/story_question_sticker_content_top_space"
        android:paddingRight="@dimen/story_question_sticker_content_left_right_space"
        android:paddingBottom="@dimen/story_question_sticker_content_bottom_space"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:minHeight="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.formitem.VkInputSelect
            android:textColorHint="@color/vk_black_alpha35"
            android:layout_gravity="center"
            android:id="@+id/story_question_dialog_question_edit_text"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLength="65"
            android:textAlignment="textStart"
            style="@style/VkUiTypography.DisplayTitle4"/>
        <FrameLayout
            android:id="@+id/story_question_input_sample_wrapper"
            android:background="@drawable/bg_story_input_sample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/story_question_button_outer_top_space_new"
            android:minHeight="@dimen/story_question_sticker_input_field_height">
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="start"
                android:id="@+id/story_question_input_sample"
                android:background="@null"
                android:paddingLeft="12dp"
                android:paddingTop="13dp"
                android:paddingRight="12dp"
                android:paddingBottom="13dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/story_question_input_field_hint"
                style="@style/VkUiTypography.Subhead"/>
        </FrameLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center"
        android:id="@+id/story_question_dialog_colors_recycler"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/story_question_colors_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
