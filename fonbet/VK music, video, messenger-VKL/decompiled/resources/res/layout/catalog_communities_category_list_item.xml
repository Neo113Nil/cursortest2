<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="start"
        android:id="@+id/category_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        app:actualImageScaleType="fitCenter"
        app:roundedCornerRadius="10dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.33dp"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:layout_gravity="center_vertical"
        android:id="@+id/category_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        style="@style/VkUiTypography.Headline1Normal"/>
</LinearLayout>
