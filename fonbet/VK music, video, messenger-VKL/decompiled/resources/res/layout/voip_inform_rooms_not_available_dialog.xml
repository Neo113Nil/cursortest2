<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_bg_card_elevation_8_cropped_full"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/session_room_inform_dialog_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="26dp"
        android:src="@drawable/vk_icon_user_square_on_square_slash_outline_56"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/session_room_inform_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/voip_session_room_rooms_not_available_title"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/session_room_inform_dialog_icon"
        style="@style/VkLegacyTypography.Title2.Medium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/session_room_inform_dialog_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voip_session_room_rooms_not_available_description"
        android:maxLines="2"
        android:lines="2"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/session_room_inform_dialog_title"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
    <TextView
        android:id="@+id/close_inform_dialog_button"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:text="@string/close"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/session_room_inform_dialog_description"
        style="@style/VkLegacyButton.Primary.Big"/>
</androidx.constraintlayout.widget.ConstraintLayout>
