<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <com.vk.stickers.views.VKStickerImageView
        android:layout_gravity="center"
        android:id="@+id/preview"
        android:layout_width="184dp"
        android:layout_height="184dp"
        android:layout_marginTop="24dp"
        app:actualImageScaleType="fitCenter"
        app:roundedCornerRadius="48dp"
        app:roundingBorderColor="@color/vk_black_alpha8"
        app:roundingBorderWidth="0.33dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/stickers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.vk.stickers.views.VKStickerImageView
            android:id="@+id/sticker1"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:layout_weight="1"
            app:actualImageScaleType="fitCenter"/>
        <com.vk.stickers.views.VKStickerImageView
            android:id="@+id/sticker2"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            app:actualImageScaleType="fitCenter"/>
        <com.vk.stickers.views.VKStickerImageView
            android:id="@+id/sticker3"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            app:actualImageScaleType="fitCenter"/>
    </LinearLayout>
    <com.vk.core.view.components.button.VkSimpleButton
        android:orientation="horizontal"
        android:id="@+id/buy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        app:buttonAppearance="positive"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</LinearLayout>
