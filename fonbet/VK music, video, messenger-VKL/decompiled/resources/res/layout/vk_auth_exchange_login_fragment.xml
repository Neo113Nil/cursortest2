<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.superapp.ui.toolbar.VkAuthToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/logo"
        android:layout_width="@dimen/vk_auth_logo_size_mini"
        android:layout_height="@dimen/vk_auth_logo_size_mini"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/user_carousel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/vk_auth_logo"/>
    <com.vk.auth.ui.carousel.UserCarouselView
        android:gravity="center_horizontal"
        android:id="@+id/user_carousel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/continue_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.auth.ui.VkLoadingButton
        android:id="@+id/continue_btn"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/vk_auth_account_continue"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/settings"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_carousel"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkAuth.Button.Landing.Exchange.Primary"/>
    <ImageButton
        android:id="@+id/settings"
        android:layout_width="48dp"
        android:layout_height="44dp"
        android:contentDescription="@string/vk_auth_exchange_settings"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/continue_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/continue_btn"
        app:layout_constraintTop_toTopOf="@+id/continue_btn"
        app:srcCompat="@drawable/vk_icon_settings_24"
        app:tint="?attr/vk_ui_icon_accent_themed"
        style="@style/VkAuth.Button.Landing.Secondary"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/use_another_account"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:text="@string/vk_auth_use_another_account"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/register"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/register"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:text="@string/vk_auth_register"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/help_buttons_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="8dp"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/help_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toTopOf="@+id/exchange_login_legal_notes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ViewStub
            android:gravity="center"
            android:id="@+id/content_info_button"
            android:visibility="gone"
            android:inflatedId="@+id/content_info_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/help_button"
            app:layout_constraintEnd_toStartOf="@+id/help_button"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/help_button"/>
        <com.vk.auth.ui.VkAuthTextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/help_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_auth_help_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/content_info_button"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Subhead"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/disabled_settings_buttons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="use_another_account,register,continue_btn,settings,help_buttons_container"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/settings_done"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:text="@string/vk_auth_exchange_users_done"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_tertiary"
        android:gravity="center"
        android:id="@+id/exchange_login_legal_notes"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
