<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_fwd_channel_msg_unavailable"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/channel_msg_fwd_unavailable_illustration"
        android:layout_width="56dp"
        android:layout_height="56dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/channel_msg_fwd_unavailable_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/channel_msg_fwd_unavailable_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/channel_msg_fwd_unavailable_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
</LinearLayout>
