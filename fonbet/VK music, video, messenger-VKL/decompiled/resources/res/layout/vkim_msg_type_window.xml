<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/popup_btn_container"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.TintTextView
            android:id="@+id/mute_msg_btn"
            android:text="@string/vkim_mute_msg_send"
            android:elevation="4dp"
            app:drawableStartCompat="@drawable/vk_icon_mute_outline_28"
            app:drawableTint="?attr/vk_legacy_accent"
            style="@style/VkIm.PopupButton"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/disappeared_msg_container"
            android:background="@drawable/vkim_bg_modul_btn_full"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="4dp">
            <TextView
                android:ellipsize="end"
                android:id="@+id/disappeared_msg_btn"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_marginBottom="0dp"
                android:text="@string/vkim_disappear_msg_send"
                android:lines="1"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:drawableStartCompat="@drawable/vk_icon_bomb_outline_28"
                app:drawableTint="?attr/vk_legacy_accent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/VkIm.PopupButton"/>
            <TextView
                android:textSize="15sp"
                android:textColor="?attr/vk_legacy_text_secondary"
                android:gravity="center"
                android:id="@+id/duration_btn"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="88dp"
                android:layout_height="48dp"
                android:fontFamily="@string/font_family_regular"
                android:layout_marginEnd="12dp"
                app:drawableEndCompat="@drawable/ic_dropdown_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/divider"
                android:background="?attr/vk_legacy_separator_alternate"
                android:layout_width="0.5dp"
                android:layout_height="48dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/duration_btn"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
