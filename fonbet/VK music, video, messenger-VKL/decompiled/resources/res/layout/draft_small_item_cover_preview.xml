<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/draft_cover_preview"
        android:layout_width="@dimen/clip_draft_cover_size"
        android:layout_height="@dimen/clip_draft_cover_size"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="6dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <View
        android:id="@+id/draft_template_icon"
        android:background="@drawable/vk_icon_cards_2_shadow_24"
        android:layout_width="@dimen/clip_draft_cover_template_icon_size"
        android:layout_height="@dimen/clip_draft_cover_template_icon_size"
        android:layout_marginTop="2dp"
        android:layout_marginStart="2dp"
        android:backgroundTint="@color/vk_white"
        app:layout_constraintStart_toStartOf="@+id/draft_cover_preview"
        app:layout_constraintTop_toTopOf="@+id/draft_cover_preview"/>
</androidx.constraintlayout.widget.ConstraintLayout>
