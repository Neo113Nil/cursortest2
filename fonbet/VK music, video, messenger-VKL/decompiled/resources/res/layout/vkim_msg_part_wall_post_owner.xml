<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/repost_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_repost_16"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/coauthors_avatar"
        android:layout_width="@dimen/vkim_wall_post_sender_icon_container_size"
        android:layout_height="@dimen/vkim_wall_post_sender_icon_container_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/avatar_barrier_end"
        app:layout_constraintStart_toStartOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkIm.AvatarView"/>
    <com.vk.im.ui.views.avatars.ImAvatarView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="@dimen/vkim_wall_post_sender_icon_container_size"
        android:layout_height="@dimen/vkim_wall_post_sender_icon_container_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/repost_icon"
        app:layout_constraintRight_toLeftOf="@+id/avatar_barrier_end"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkIm.AvatarView"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/avatar_barrier_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="coauthors_avatar,avatar"/>
    <com.vk.im.design.view.CoauthorsNamesView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/coauthors_names"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/barrier_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/avatar_barrier_end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        style="@style/VkUiTypography.SubheadMedium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/barrier_vertical"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="@+id/avatar_barrier_end"
        app:layout_constraintRight_toLeftOf="@+id/verified_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        style="@style/VkUiTypography.SubheadMedium"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="coauthors_names,title"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatar_barrier_end"
        app:layout_constraintTop_toBottomOf="@+id/barrier_vertical"
        style="@style/VkUiTypography.Caption1"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/verified_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="6dp"
        app:layout_constraintLeft_toRightOf="@+id/title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_verified_16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
