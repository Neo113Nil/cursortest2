<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@string/font_family_regular"
        android:layout_marginStart="16dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_accent"
        android:ellipsize="end"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/open"
        android:background="@drawable/vkim_ripple_dark"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vkim_business_notify_open"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@string/font_family_regular"
        android:layout_marginEnd="44dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/hide"
        android:background="@drawable/vkim_ripple_dark_borderless"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_hide"
        app:srcCompat="@drawable/vk_icon_cancel_24"
        app:tint="?attr/vk_legacy_icon_secondary"/>
</FrameLayout>
