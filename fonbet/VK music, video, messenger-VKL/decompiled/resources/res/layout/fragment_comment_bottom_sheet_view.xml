<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.MaxHeightSaveFrameLayout
        android:id="@+id/comment_bottom_sheet_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.newsfeed.impl.views.NoSwipePaginatedView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/rpb_list"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/jump_to_end"
        android:background="@drawable/comments_scroll_to_bottom"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/comments_ripple_scroll_to_bottom"
        android:minHeight="56dp"
        android:contentDescription="@string/accessibility_scroll_to_bottom_comments"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_behavior="com.vk.newsfeed.impl.replybar.ReplyBarGravityBehavior"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_navigation_shadow"
        android:background="@drawable/picker_bg_attach_bottom_toolbar_shadow"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_behavior="com.vk.newsfeed.impl.replybar.ReplyBarGravityBehavior"/>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/bottom_sheet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="96dp"
        app:layout_behavior="com.vk.newsfeed.impl.replybar.ReplyBarGravityBehavior"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
