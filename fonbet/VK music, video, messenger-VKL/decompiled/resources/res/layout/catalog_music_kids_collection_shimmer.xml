<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <GridLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:useDefaultMargins="true"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="8dp">
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_columnWeight="1"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="0dp"
            app:background="@drawable/vk_bg_skeleton_10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"/>
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_columnWeight="1"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="0dp"
            app:background="@drawable/vk_bg_skeleton_10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/wide_horizontal_shimmer_view"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="1"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="0dp"
            app:background="@drawable/vk_bg_skeleton_10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"/>
    </GridLayout>
</com.vk.core.view.shimmer.ShimmerFrameLayout>
