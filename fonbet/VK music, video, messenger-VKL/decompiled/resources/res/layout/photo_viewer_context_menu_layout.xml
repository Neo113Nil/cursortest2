<?xml version="1.0" encoding="utf-8"?>
<com.vk.photoviewer.ContextMenuLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/pv_context_menu_bg"
    android:scrollbars="none"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="4dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/menu_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/proxy_edit_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:inputType="textMultiLine"/>
    </LinearLayout>
</com.vk.photoviewer.ContextMenuLayout>
