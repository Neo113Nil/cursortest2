<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_container"
    android:layout_width="212dp"
    android:layout_height="212dp">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/photo"
            android:background="@drawable/vk_bg_skeleton_image_12dp"
            android:layout_width="212dp"
            android:layout_height="212dp"
            android:backgroundTint="?attr/vk_ui_skeleton_from"/>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/playlist_skeleton_compact_title"
        android:background="@drawable/bg_rounded_4"
        android:layout_width="150dp"
        android:layout_height="12dp"
        android:layout_marginTop="28dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:backgroundTint="?attr/vk_ui_background_content"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/playlist_skeleton_compact_subtitle"
        android:background="@drawable/bg_rounded_4"
        android:layout_width="100dp"
        android:layout_height="8dp"
        android:layout_marginTop="51dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:backgroundTint="?attr/vk_ui_background_content"/>
    <View
        android:layout_gravity="end|bottom"
        android:id="@+id/playlist_skeleton_compact_play_button"
        android:background="@drawable/bg_circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:backgroundTint="?attr/vk_ui_background_content"/>
</FrameLayout>
