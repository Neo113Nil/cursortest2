<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/skeleton_shimmer"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.content.design.view.photo.flow.PhotoFlowHeaderSkeletonView
                android:id="@+id/photo_flow_header_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.photos.root.photoflow.presentation.views.skeleton.PhotoFlowGridSkeletonView
                android:id="@+id/photo_flow_grid_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
</merge>
