<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/video_similar_content_item_width"
    android:layout_height="@dimen/video_similar_content_big_item_height">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"
        app:fadeDuration="100"
        app:roundingBorderColor="@color/vk_white_alpha12"
        app:roundingBorderWidth="0.5dp"/>
    <ProgressBar
        android:layout_gravity="bottom"
        android:id="@+id/video_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progressDrawable="@drawable/video_progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <LinearLayout
        android:layout_gravity="end|bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">
        <com.vk.libvideo.design.view.duration.DurationView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </LinearLayout>
    <com.vk.donut.design.view.badge.DonutBadge
        android:layout_gravity="start|bottom"
        android:id="@+id/donut_price_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"/>
    <com.vk.libvideo.design.view.movika.InteractiveDurationView
        android:textAppearance="@style/VkUiTypography.HeadlineMedium"
        android:layout_gravity="end|bottom"
        android:id="@+id/interactive_duration"
        android:background="@drawable/bg_interactiv_video_duration_label_rounded_4"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:vov_size="medium"/>
</merge>
