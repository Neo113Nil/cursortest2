<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="vertical"
            android:id="@+id/stack"
            android:paddingTop="13dp"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/post_side_padding"
            android:layout_marginEnd="@dimen/post_side_padding"
            app:vk_layout_isFluid="true">
            <com.vk.feed.design.view.newsfeed.news.VkFeedStreamlinedTextView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/digest_title"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="22dp"/>
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/subtitle"
                android:focusableInTouchMode="false"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:minHeight="16dp"
                android:singleLine="true"/>
        </LinearLayout>
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.5dp"
            android:layout_marginEnd="16dp"
            app:buttonAppearance="accent"
            app:buttonMode="link"
            app:buttonSizeType="medium"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="end|center_vertical"
            android:id="@+id/dismiss_icon_button"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="4dp"
            app:srcCompat="@drawable/vk_icon_dismiss_24"
            app:tint="?attr/vk_ui_icon_medium"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</FrameLayout>
