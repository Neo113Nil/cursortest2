<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/title_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="play_button,title"/>
    <com.vk.music.view.MusicRoundPlayView
        android:id="@+id/play_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:mrp_background_alpha="0"
        app:mrp_background_tint="@null"
        app:mrp_compact_progess_bar="true"
        app:mrp_pause_icon="@drawable/vk_icon_pause_36"
        app:mrp_play_icon="@drawable/vk_icon_play_36"
        app:mrp_play_icon_tint="?attr/vk_ui_text_primary"
        app:mrp_scale_buffering="true"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle2"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:maxLines="2"
        android:layout_marginHorizontal="34dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkUiTypography.ParagraphNormal"/>
    <View
        android:id="@+id/overlap_separator"
        android:background="@drawable/bg_rounded_top_corners_20"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
