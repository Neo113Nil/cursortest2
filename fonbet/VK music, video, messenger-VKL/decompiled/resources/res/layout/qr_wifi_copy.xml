<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/vkui_bg_edittext"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/password_text"
        android:padding="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/password_copy"
        android:background="@drawable/ripple_8dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_copy_wifi_password"
        app:srcCompat="@drawable/vk_icon_copy_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
</LinearLayout>
