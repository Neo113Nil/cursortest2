<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/background"
        android:background="@drawable/music_snippet_progress_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/snippet_seekbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/snippet_seekbar"/>
    <com.vk.core.view.SeekBarSamsungFixed
        android:enabled="false"
        android:id="@+id/snippet_seekbar"
        android:background="@null"
        android:focusable="false"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progressDrawable="@drawable/music_snippet_progress"
        android:thumb="@null"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:splitTrack="false"
        android:thumbTint="@null"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/border_start"
        android:background="@drawable/music_snippet_border"
        android:visibility="invisible"
        android:layout_width="@dimen/music_snippet_progress_border_width"
        android:layout_height="@dimen/music_snippet_progress_border_height"
        app:layout_constraintBottom_toBottomOf="@+id/snippet_seekbar"
        app:layout_constraintEnd_toStartOf="@+id/snippet_seekbar"
        app:layout_constraintStart_toStartOf="@+id/snippet_seekbar"
        app:layout_constraintTop_toTopOf="@+id/snippet_seekbar"/>
    <View
        android:id="@+id/border_end"
        android:background="@drawable/music_snippet_border"
        android:visibility="invisible"
        android:layout_width="@dimen/music_snippet_progress_border_width"
        android:layout_height="@dimen/music_snippet_progress_border_height"
        app:layout_constraintBottom_toBottomOf="@+id/snippet_seekbar"
        app:layout_constraintEnd_toEndOf="@+id/snippet_seekbar"
        app:layout_constraintStart_toEndOf="@+id/snippet_seekbar"
        app:layout_constraintTop_toTopOf="@+id/snippet_seekbar"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toBottomOf="@+id/snippet_seekbar"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintTop_toBottomOf="@+id/snippet_seekbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
