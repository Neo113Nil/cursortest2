<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteCapsMedium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/story_vmoji_create_title"
        android:layout_marginStart="12dp"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/onboarding_image"
            android:layout_width="320dp"
            android:layout_height="190dp"
            android:scaleType="center"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.ParagraphMedium"
            android:textColor="@color/vk_gray_800"
            android:layout_gravity="center"
            android:id="@+id/create"
            android:background="@drawable/bg_story_vmoji_create"
            android:paddingTop="7.5dp"
            android:paddingBottom="8.5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/story_vmoji_create"
            android:lineSpacingExtra="2sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
</FrameLayout>
