<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingHorizontal="16dp">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/post_situation_suggest_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/post_situation_suggest_open"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Headline2Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/post_situation_suggest_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/post_situation_suggest_open"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/post_situation_suggest_title"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/post_situation_suggest_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:text="@string/open"/>
</androidx.constraintlayout.widget.ConstraintLayout>
