<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nspk_chooser_container"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:translationX="-16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/vk_icon_cancel_outline_28"
        app:title="@string/nspk_chooser_title"
        style="@style/VkIm.Toolbar.Style.LargeWithBack"/>
    <View
        android:id="@+id/top_divider"
        android:background="?attr/vk_legacy_separator_common"
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:text="@string/nspk_chooser_sum_total"
        android:fontFamily="@font/vk_sans_text_medium"
        android:letterSpacing="0.01"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/total_sum"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_divider"
        style="@style/VkLegacyTypography.Title2.Regular"/>
    <TextView
        android:textSize="60sp"
        android:id="@+id/total_sum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/vk_sans_display_regular"
        android:letterSpacing="0.02"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/sbp_top_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkLegacyTypography.Title2.Regular"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/sum_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="title,total_sum"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/sbp_top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="sbp_icon,sbp_info"/>
    <ImageView
        android:id="@+id/sbp_icon"
        android:background="@drawable/circle_with_outline"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/vk_icon_logo_sbpbank_color_24"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/sbp_info"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/sbp_info"
        app:layout_constraintTop_toTopOf="@+id/sbp_info"/>
    <TextView
        android:id="@+id/sbp_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="@string/nspk_sbp_info"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/sbp_bottom_barrier"
        app:layout_constraintLeft_toRightOf="@+id/sbp_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sbp_top_barrier"
        style="@style/VkLegacyTypography.Caption.Regular"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/sbp_bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="sbp_icon,sbp_info"/>
    <View
        android:id="@+id/bottom_divider"
        android:background="?attr/vk_legacy_separator_common"
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/list_header"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sbp_bottom_barrier"/>
    <TextView
        android:textSize="16dp"
        android:id="@+id/list_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/nspk_bank_list_header"
        android:fontFamily="@font/vk_sans_text_medium"
        android:letterSpacing="0.01"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/recycler"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_divider"
        style="@style/VkLegacyTypography.Title2.Regular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/list_header"/>
</androidx.constraintlayout.widget.ConstraintLayout>
