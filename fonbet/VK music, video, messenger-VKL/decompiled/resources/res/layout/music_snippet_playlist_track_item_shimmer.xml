<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_tracks"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/snippet_track_thumb"
            android:background="@drawable/music_snippet_skeleton_10dp"
            android:layout_width="@dimen/music_snippet_track_thumb_size"
            android:layout_height="@dimen/music_snippet_track_thumb_size"
            android:layout_marginTop="@dimen/music_snippet_track_margin"
            android:layout_marginStart="@dimen/music_snippet_track_margin"
            android:layout_marginEnd="@dimen/music_snippet_track_margin"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/track_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/add_track"
            app:layout_constraintStart_toStartOf="@+id/snippet_track_thumb"
            app:layout_constraintTop_toBottomOf="@+id/snippet_track_thumb">
            <View
                android:id="@+id/track_name"
                android:background="@drawable/music_snippet_skeleton_10dp"
                android:layout_width="0dp"
                android:layout_height="16dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.86"/>
            <View
                android:id="@+id/track_artist"
                android:background="@drawable/music_snippet_skeleton_10dp"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/track_name"
                app:layout_constraintWidth_percent="0.2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/add_track"
            android:background="@drawable/vk_bg_skeleton_round"
            android:padding="6dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/music_talkback_add_audio"
            android:backgroundTint="@color/vk_white_alpha12"
            app:layout_constraintBottom_toBottomOf="@+id/track_area"
            app:layout_constraintEnd_toEndOf="@+id/snippet_track_thumb"
            app:layout_constraintTop_toTopOf="@+id/track_area"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.core.view.shimmer.ShimmerFrameLayout>
