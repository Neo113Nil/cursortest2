<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/voip_movie_controls_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="24dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_play_button"
        app:layout_constraintBottom_toBottomOf="@+id/voip_movie_controls_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_movie_controls_guideline"
        app:srcCompat="@drawable/vk_icon_play_16"
        style="@style/VoipMovieButton"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_movie_sound_control"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/voip_movie_controls_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_movie_controls_guideline"
        app:srcCompat="@drawable/vk_icon_volume_outline_28"
        style="@style/VoipMovieButton"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/voip_player_control_group"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="voip_play_button,voip_movie_sound_control"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/voip_movie_current_time"
        app:layout_constraintBottom_toBottomOf="@+id/voip_movie_controls_guideline"
        app:layout_constraintStart_toEndOf="@+id/voip_play_button"
        app:layout_constraintTop_toTopOf="@+id/voip_movie_controls_guideline"
        app:layout_goneMarginStart="16dp"
        style="@style/VoipMovieTimeText"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/voip_movie_full_time"
        app:layout_constraintBottom_toBottomOf="@+id/voip_movie_controls_guideline"
        app:layout_constraintEnd_toStartOf="@+id/voip_movie_sound_control"
        app:layout_constraintTop_toTopOf="@+id/voip_movie_controls_guideline"
        app:layout_goneMarginRight="16dp"
        style="@style/VoipMovieTimeText"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/voip_movie_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="100"
        app:haloRadius="0dp"
        app:labelBehavior="gone"
        app:layout_constraintBottom_toBottomOf="@+id/voip_movie_controls_guideline"
        app:layout_constraintEnd_toStartOf="@+id/voip_movie_full_time"
        app:layout_constraintStart_toEndOf="@+id/voip_movie_current_time"
        app:layout_constraintTop_toTopOf="@+id/voip_movie_controls_guideline"
        app:layout_goneMarginStart="4dp"
        app:thumbRadius="0dp"
        style="@style/VoipMovieSlider"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.Text.Regular"
        android:ellipsize="end"
        android:id="@+id/voip_movie_title"
        android:paddingTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="28dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/voip_movie_progress"
        app:layout_constraintEnd_toEndOf="@+id/voip_movie_sound_control"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginEnd="16dp"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/voip_movie_labels_group"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="voip_movie_full_time,voip_movie_progress,voip_movie_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_movie_sound_control_icon"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_volume_outline_28"
        style="@style/VoipMovieButton"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/voip_volume_slider"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="100"
        android:layout_marginStart="-8dp"
        android:layout_marginEnd="20dp"
        app:labelBehavior="gone"
        app:layout_constraintBottom_toBottomOf="@+id/voip_movie_sound_control_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/voip_movie_sound_control_icon"
        app:layout_constraintTop_toTopOf="@+id/voip_movie_sound_control_icon"
        style="@style/VoipMovieSlider"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/voip_movie_sound_regulation_group"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="voip_movie_sound_control_icon,voip_volume_slider"/>
</merge>
