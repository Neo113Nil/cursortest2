<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/vk_ui_base_padding_horizontal"
    android:paddingVertical="@dimen/vk_ui_spacing_size_xs">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sc_middle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/vk_ui_spacing_size_xl"
        android:layout_marginVertical="@dimen/vk_ui_spacing_size_xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sc_switch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.tool.view.onboarding.highlighter.VkOnboardingHighlighter
            android:id="@+id/sc_title_highlighter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:autoHighlight="false"
            app:highlighterColor="lime"
            app:highlighterType="type1">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/VkUiTypography.TextNormal"/>
        </com.vk.core.tool.view.onboarding.highlighter.VkOnboardingHighlighter>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
            style="@style/VkUiTypography.Footnote"/>
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sc_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sc_middle"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
