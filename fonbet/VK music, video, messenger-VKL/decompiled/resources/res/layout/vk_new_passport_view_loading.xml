<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vk_passport_view_shimmer_frame"
    android:background="@drawable/vk_profile_dashboard_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
        android:id="@+id/vk_passport_view_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/vk_passport_loading_avatar"
                    android:background="@drawable/vk_bg_skeleton_round"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/vk_passport_loading_texts_container"
                    android:paddingTop="13dp"
                    android:paddingBottom="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <View
                        android:id="@+id/vk_passport_loading_title"
                        android:background="@drawable/vk_bg_skeleton_4dp"
                        android:layout_width="140dp"
                        android:layout_height="15sp"/>
                    <View
                        android:id="@+id/vk_passport_loading_subtitle"
                        android:background="@drawable/vk_bg_skeleton_4dp"
                        android:layout_width="84dp"
                        android:layout_height="12sp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                    <View
                        android:id="@+id/vk_passport_loading_action"
                        android:background="@drawable/vk_bg_skeleton_4dp"
                        android:layout_width="152dp"
                        android:layout_height="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/vk_passport_loading_end_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="12dp"
                    app:srcCompat="@drawable/vk_icon_chevron_right_outline_20"
                    app:tint="?attr/vk_ui_icon_secondary"/>
            </LinearLayout>
            <View
                android:id="@+id/vk_passport_loading_vkpay_separator"
                android:background="?attr/vk_ui_separator_primary"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/vk_passport_loading_vkpay"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <View
                    android:background="@drawable/vk_bg_skeleton_4dp"
                    android:layout_width="60dp"
                    android:layout_height="12sp"/>
                <View
                    android:background="@drawable/vk_bg_skeleton_4dp"
                    android:layout_width="83dp"
                    android:layout_height="14sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
</FrameLayout>
