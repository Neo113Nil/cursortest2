<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.disableable.DisableableRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionGroup="true">
    <com.vk.core.view.MaxHeightSaveFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true">
        <com.vk.core.view.fresco.VKEnhancedImageView
            android:id="@+id/dialog_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:imageScaleType="center_crop"/>
    </com.vk.core.view.MaxHeightSaveFrameLayout>
    <ViewStub
        android:id="@+id/dialog_header_container_stub"
        android:layout="@layout/vkim_include_dialog_header_old"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <FrameLayout
        android:id="@+id/messages_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/edu_schedule_viewstub"
        android:layout_below="@+id/dialog_header_container"/>
    <ViewStub
        android:id="@+id/edu_schedule_viewstub"
        android:layout="@layout/vkim_edu_schedule_badge"
        android:inflatedId="@+id/edu_schedule_viewstub"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="12dp"
        android:layout_above="@+id/sticker_bar_container"/>
    <ViewStub
        android:id="@+id/max_transition_viewstub"
        android:layout="@layout/vkim_edu_max_transition_banner"
        android:inflatedId="@+id/max_transition_viewstub"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_above="@+id/sticker_bar_container"/>
    <FrameLayout
        android:id="@+id/bottom_sheet_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/sticker_bar_container"
        android:layout_below="@+id/dialog_header_container"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/dialog_shadow"
        android:layout_below="@+id/dialog_header_container"
        style="@style/VkIm.AppBarShadowView"/>
    <ViewStub
        android:id="@+id/banner_container_stub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/dialog_header_container"/>
    <ViewStub
        android:id="@+id/max_members_banner_stub"
        android:layout="@layout/vkim_edu_max_members_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="24dp"
        android:layout_above="@+id/divider"
        android:layout_below="@+id/dialog_header_container"/>
    <View
        android:id="@+id/banner_container_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/banner_container"/>
    <ViewStub
        android:id="@+id/bot_action_stub"
        android:layout="@layout/vkim_bot_snackbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/dialog_header_container"/>
    <ViewStub
        android:id="@+id/mentions_container_stub"
        android:layout="@layout/vkim_mentions_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/divider"
        android:layout_below="@+id/dialog_header_container"/>
    <FrameLayout
        android:id="@+id/sticker_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_panel_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_panel_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:importantForAccessibility="no">
        <FrameLayout
            android:id="@+id/write_area"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/write_popup_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <FrameLayout
            android:id="@+id/write_popup_container"
            android:background="?attr/vk_ui_vkontakte_color_background_keyboard"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ViewStub
            android:id="@+id/dialog_preview_quick_actions_stub"
            android:layout="@layout/vkim_dialog_preview_quick_actions"
            android:inflatedId="@+id/dialog_preview_quick_actions_inflated"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ViewStub
            android:id="@+id/dialog_footer_actions_container_stub"
            android:layout="@layout/vkim_dialog_footer_actions_old"
            android:inflatedId="@+id/dialog_footer_actions_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/divider"
        android:background="?attr/vk_ui_separator_secondary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_above="@+id/bottom_panel_container"/>
    <ViewStub
        android:id="@+id/install_vk_me_btn_stub"
        android:layout="@layout/vkim_install_vkme_btn_container"
        android:inflatedId="@+id/install_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <FrameLayout
        android:id="@+id/dialog_audio_msg_recorder_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/banner_container_bottom"
        android:importantForAccessibility="no"/>
    <ViewStub
        android:id="@+id/dialog_actions_stub"
        android:layout="@layout/vkim_dialog_actions_vc_by_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/dialog_header_container"/>
    <ViewStub
        android:id="@+id/dialogs_chat_message_request_stub"
        android:layout="@layout/vkim_dialogs_chat_message_request"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/keyboard_background"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"/>
</com.vk.core.tool.view.disableable.DisableableRelativeLayout>
