<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/friend_request_notification_photo"
        android:background="@drawable/user_placeholder_system_theme"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"/>
    <LinearLayout
        android:layout_gravity="start"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="44dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="normal"
            android:ellipsize="end"
            android:layout_gravity="start"
            android:id="@+id/friend_request_notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"
            android:textDirection="locale"
            style="@style/TextAppearance.Compat.Notification.Title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/friend_request_notification_subhead"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/friend_request_notification_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"
            android:textDirection="locale"/>
    </LinearLayout>
</FrameLayout>
