<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <com.vk.imageloader.view.VKCircleImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/user_photo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="10dp"
        app:placeholderImage="@drawable/user_placeholder"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/profile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="16dp"
            style="@style/VkUiTypography.Footnote"/>
        <com.vk.core.view.links.LinkedTextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="16dp"
            style="@style/VkUiTypography.Caption1"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/share_btn"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        app:srcCompat="@drawable/vk_icon_share_24"
        app:tint="?attr/vk_ui_icon_contrast"/>
</LinearLayout>
