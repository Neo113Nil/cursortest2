<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/catalog_banner_image_container"
        android:background="@drawable/catalog_bg_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="152dp">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/catalog_banner_background_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="10dp"/>
        <FrameLayout
            android:id="@+id/images_container"
            android:visibility="gone"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/catalog_banner_image_big"
                android:layout_width="96dp"
                android:layout_height="96dp"
                app:roundedCornerRadius="8dp"
                app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
                app:roundingBorderWidth="0.5dp"/>
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/catalog_banner_image_small"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                app:roundedCornerRadius="4dp"
                app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
                app:roundingBorderWidth="0.5dp"/>
            <com.vk.imageloader.view.VKCircleImageView
                android:id="@+id/catalog_banner_image_round_big"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:placeholderImage="@drawable/user_placeholder"
                app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
                app:roundingBorderWidth="0.5dp"/>
            <com.vk.imageloader.view.VKCircleImageView
                android:id="@+id/catalog_banner_image_round_small"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:placeholderImage="@drawable/user_placeholder"
                app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
                app:roundingBorderWidth="0.5dp"/>
        </FrameLayout>
        <View
            android:id="@+id/catalog_banner_block_button"
            android:background="@drawable/catalog_banner_pressed_drawable"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/catalog_banner_button_close"
            android:background="?attr/actionBarItemBackground"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/stickers_accessibility_close_notification"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_cancel_24"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textAppearance="?attr/vk_ui_typography_text_medium"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/catalog_banner_title"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/catalog_banner_image_container"/>
    <com.vk.core.view.links.LinkedTextView
        android:textAppearance="?attr/vk_ui_typography_subhead_normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/catalog_banner_message"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/catalog_banner_title"
        app:layout_constraintStart_toStartOf="@+id/catalog_banner_title"
        app:layout_constraintTop_toBottomOf="@+id/catalog_banner_title"
        app:layout_goneMarginBottom="12dp"/>
    <TextView
        android:textAppearance="?attr/vk_ui_typography_footnote_normal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/catalog_banner_subtext"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/catalog_banner_message"
        app:layout_constraintStart_toStartOf="@+id/catalog_banner_message"
        app:layout_constraintTop_toBottomOf="@+id/catalog_banner_message"/>
</androidx.constraintlayout.widget.ConstraintLayout>
