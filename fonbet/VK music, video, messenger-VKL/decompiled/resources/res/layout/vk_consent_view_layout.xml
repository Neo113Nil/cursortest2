<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.auth.ui.WrapRelativeLayout
            android:id="@+id/consent_container"
            android:background="@drawable/vk_scrim_bottom"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/vk_ui_background_secondary"
            android:backgroundTintMode="src_in">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/logo_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">
                <com.vk.core.ui.themes.VKReplacerView
                    android:id="@+id/consent_view_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"/>
                <include
                    android:id="@+id/left_connector"
                    layout="@layout/vk_consent_connector_view"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/connector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/vk_icon_check_circle_on_24"
                    app:tint="@color/vk_green"/>
                <include
                    android:id="@+id/right_connector"
                    layout="@layout/vk_consent_connector_view"/>
                <com.vk.core.ui.themes.VKReplacerView
                    android:id="@+id/app_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"/>
            </LinearLayout>
            <TextView
                android:textAppearance="@style/VkUiTypography.TextNormal"
                android:textColor="?attr/vk_ui_text_subhead"
                android:gravity="center"
                android:id="@+id/consent_description"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="@string/vk_connect_consent_description"
                android:layout_below="@+id/logo_container"
                android:textAlignment="center"/>
        </com.vk.auth.ui.WrapRelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/consent_apps"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:id="@+id/consent_sub_app_description"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vk_connect_consent_send_data"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/VkUiTypography.Headline2Normal"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/consent_items"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress"
                android:visibility="visible"
                android:layout_width="32dp"
                android:layout_height="176dp"
                android:indeterminate="true"
                android:indeterminateTint="?attr/vk_ui_icon_secondary"/>
            <include
                android:visibility="gone"
                layout="@layout/vk_auth_error_retry_layout"/>
        </FrameLayout>
        <View
            android:id="@+id/consent_legal_terms_separator"
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <RelativeLayout
            android:id="@+id/consent_legal_terms_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <com.vk.core.ui.themes.VKReplacerView
                android:id="@+id/app_icon_terms"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>
            <com.vk.auth.ui.consent.VkConsentTermsContainer
                android:id="@+id/client_terms_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@+id/app_icon_terms"/>
        </RelativeLayout>
        <com.vk.auth.ui.WrapRelativeLayout
            android:id="@+id/terms_container"
            android:background="@drawable/vk_scrim_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/vk_ui_background_secondary">
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption2"
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/vkc_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
        </com.vk.auth.ui.WrapRelativeLayout>
    </LinearLayout>
</merge>
