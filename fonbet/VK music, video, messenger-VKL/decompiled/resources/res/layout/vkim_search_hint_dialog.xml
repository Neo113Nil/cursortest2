<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:layout_width="80dp"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.ImAvatarView
        android:layout_gravity="center_horizontal"
        android:id="@+id/vkim_avatar"
        android:layout_width="@dimen/vkim_dialog_search_hint_avatar_container_size"
        android:layout_height="@dimen/vkim_dialog_search_hint_avatar_container_size"
        android:contentDescription="@string/vkim_accessibility_avatar"
        style="@style/VkIm.AvatarView"/>
    <ImageView
        android:layout_gravity="start|top"
        android:id="@+id/vkim_verified"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="48dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:layout_marginStart="52dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/vkim_name"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:breakStrategy="simple"
        app:autoSizeMinTextSize="11sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"/>
</FrameLayout>
