<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.stories.design.view.sticker.TemplateButton
        android:id="@+id/template_button_new"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_action"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/iv_reaction_menu_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_smile_outline_shadow_medium_48"
        app:layout_constraintBottom_toBottomOf="@+id/iv_like"
        app:layout_constraintEnd_toStartOf="@+id/iv_like"
        app:layout_constraintTop_toTopOf="@+id/iv_like"/>
    <ImageView
        android:id="@+id/iv_like"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="4dp"
        android:src="@drawable/vk_icon_like_outline_shadow_medium_48"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/iv_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_action"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/vk_icon_share_outline_24"
        android:importantForAccessibility="no"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_like"
        app:tint="@color/vk_white"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_vertical"
        android:id="@+id/tv_action"
        android:background="@drawable/bg_story_action_rounded_20"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:minHeight="36dp"
        android:text="@string/stories_replies_reply"
        android:paddingStart="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_action"
        app:layout_constraintEnd_toStartOf="@+id/iv_action"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_action"
        style="@style/VkUiTypography.ParagraphNormal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
