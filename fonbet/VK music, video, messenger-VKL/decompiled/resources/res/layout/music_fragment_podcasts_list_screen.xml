<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.lists.RecyclerPaginatedView
        android:id="@+id/rpb_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"/>
    <com.vk.core.view.VKAppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/toolbar"
            android:background="?attr/vk_ui_header_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:elevation="0dp"
            android:outlineProvider="none"
            style="@style/Toolbar">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/back_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/music_talkback_go_back"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/vk_icon_arrow_left_outline_28"
                style="@style/ActionButton.White"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/toolbar_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="40dp">
                <com.vk.imageloader.view.VKImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/user_logo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:actualImageScaleType="centerCrop"
                    app:backgroundImage="@color/music_placeholder_bg"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:placeholderImage="@drawable/user_placeholder"
                    app:roundAsCircle="true"
                    app:roundingBorderColor="@color/vk_black_alpha8"
                    app:roundingBorderWidth="0.5dp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Headline"
                    android:textColor="?attr/vk_ui_text_primary"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/subtitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/user_logo"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.SubheadMedium"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/subtitle"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/user_logo"
                    app:layout_constraintTop_toBottomOf="@+id/title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.vk.core.view.VKAppBarLayout>
    <com.vk.core.view.AppBarShadowView style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
