<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/interest_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="@color/vk_gray_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/interest_icon"
        android:background="@drawable/bg_interests_animate_selector"
        android:layout_width="@dimen/interest_icon_size"
        android:layout_height="@dimen/interest_icon_size"
        style="VkUiTypography.Title1Medium.Unscaled"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/interest_name"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:paddingHorizontal="4dp"
        style="@style/VkUiTypography.Caption1Normal"/>
</LinearLayout>
