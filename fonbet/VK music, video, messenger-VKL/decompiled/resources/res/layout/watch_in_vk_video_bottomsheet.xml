<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_rounded_10"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="?attr/vk_ui_background_contrast_inverse">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/vk_video_logo"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/vk_icon_logo_vk_video_color_56"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation_view"
            android:visibility="gone"
            android:layout_width="108dp"
            android:layout_height="64dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/btn_action"
        android:background="@drawable/bg_rounded_8"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_subtitle">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/market_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_logo_google_play_28"/>
        <TextView
            android:textColor="@color/vk_black"
            android:layout_gravity="center"
            android:id="@+id/market_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_downloand_from_google_market"
            android:layout_marginStart="10dp"
            style="@style/VkUiTypography.Text"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/vk_gray_100"
        android:gravity="center"
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_container"
        style="@style/VkUiTypography.Title2Medium"/>
    <TextView
        android:textColor="@color/vk_white_alpha40"
        android:gravity="center"
        android:id="@+id/text_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:lines="@null"
        app:layout_constraintEnd_toEndOf="@+id/text_title"
        app:layout_constraintStart_toStartOf="@+id/text_title"
        app:layout_constraintTop_toBottomOf="@+id/text_title"
        style="@style/VkUiTypography.Subhead"/>
    <FrameLayout
        android:id="@+id/icon_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="-17dp"
        android:layout_marginEnd="-17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:srcCompat="@drawable/vk_icon_cancel_outline_24"
            app:tint="?attr/vk_ui_icon_secondary"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
