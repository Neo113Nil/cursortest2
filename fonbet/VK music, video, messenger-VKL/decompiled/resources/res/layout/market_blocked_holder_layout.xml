<?xml version="1.0" encoding="utf-8"?>
<com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/attachment_market_container"
    android:paddingLeft="@dimen/post_side_padding"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/post_side_padding"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:padOverlay="true">
    <com.vk.ecomm.moderation.ui.ModerationItemBlockedView
        android:id="@+id/blockedView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cornerRadius="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout>
