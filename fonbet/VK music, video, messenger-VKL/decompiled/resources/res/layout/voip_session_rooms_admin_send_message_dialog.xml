<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/vk_bg_card_elevation_8_cropped_full"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.Title2.Regular"
        android:gravity="center"
        android:id="@+id/session_room_send_message_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/voip_session_room_admin_send_message_dialog_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/session_room_send_message_dialog_close_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/vk_icon_cancel_20"
        android:contentDescription="@string/accessibility_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <com.vk.common.view.EditText
        android:textColorHint="?attr/vk_ui_text_secondary"
        android:id="@+id/session_room_message_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/voip_session_room_admin_send_message_dialog_hint"
        android:minLines="3"
        android:maxLength="150"
        android:inputType="textMultiLine"
        android:imeOptions="actionSend"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/session_room_send_message_dialog_title"
        style="@style/VKUIEditText"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:enabled="false"
        android:id="@+id/session_room_send_message_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/voip_session_room_admin_send_message_dialog_send_all"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/session_room_message_input"
        style="@style/VkLegacyButton.Primary.Big"/>
</androidx.constraintlayout.widget.ConstraintLayout>
