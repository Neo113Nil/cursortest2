<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/small_video_item_root"
    android:paddingTop="4dp"
    android:paddingBottom="8dp"
    android:layout_width="244dp"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight_radius_4"
    android:minHeight="205dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/preview"
        android:layout_width="@dimen/video_catalog_small_slider_content_item_width"
        android:layout_height="@dimen/video_catalog_small_slider_content_item_height"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="6dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="false"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:indicatorColor="@color/vk_azure_A100"
        app:layout_constraintBottom_toTopOf="@+id/image_barrier"
        app:trackColor="@color/vk_black_alpha45"
        app:trackCornerRadius="2dp"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/overlay_view"
        android:layout_width="@dimen/video_catalog_small_slider_content_item_width"
        android:layout_height="@dimen/video_catalog_small_slider_content_item_height"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vov_corner_radius="6dp"
        app:vov_size="medium"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/image_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="overlay_view,preview"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/video_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_live_badge_20"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.libvideo.design.view.duration.DurationView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.libvideo.ui.UpcomingIndicatorView
        android:textAppearance="@style/VkUiTypography.Caption1Medium"
        android:gravity="center"
        android:id="@+id/video_upcoming_indicator"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        android:lineHeight="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/preview"
        app:layout_constraintStart_toStartOf="@+id/preview"/>
    <com.vk.donut.design.view.badge.DonutBadge
        android:id="@+id/donut_price_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.libvideo.design.view.movika.InteractiveDurationView
        android:id="@+id/interactive_duration"
        android:background="@drawable/bg_interactiv_video_duration_label_rounded_4"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_barrier"
        app:layout_goneMarginEnd="6dp"
        style="@style/VkUiTypography.SubheadMedium"/>
    <com.vk.core.view.components.text.links.VkLinkedText
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/subtitle_views"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_goneMarginEnd="6dp"/>
    <ImageView
        android:id="@+id/menu"
        android:background="@drawable/highlight_unlimited"
        android:layout_width="24dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/menu"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle_views"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
