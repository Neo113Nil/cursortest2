<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/poll_result_root_container"
    android:background="?attr/vk_ui_background_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.Paragraph.Unscaled"
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_gravity="center"
        android:id="@+id/poll_answer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/poll_rate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
        android:textColor="?attr/vk_ui_text_muted"
        android:layout_gravity="center"
        android:id="@+id/poll_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:drawablePadding="2dp"
        app:layout_constraintBottom_toTopOf="@+id/poll_visual_result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poll_answer"/>
    <View
        android:id="@+id/poll_visual_result"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/poll_answer"/>
    <com.vk.core.view.PhotoStripView
        android:id="@+id/poll_strip_view"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/poll_visual_result"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_gravity="center"
        android:id="@+id/poll_votes_count"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="20dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/poll_strip_view"
        app:layout_constraintStart_toEndOf="@+id/poll_strip_view"
        app:layout_constraintTop_toTopOf="@+id/poll_strip_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
