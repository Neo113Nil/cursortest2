<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/edu_max_members_badge"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:translationZ="1px"
        android:paddingHorizontal="12dp">
        <com.vk.core.view.components.userstack.VkUserStack
            android:id="@+id/edu_max_members_user_stack"
            android:layout_width="wrap_content"
            android:layout_height="28dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/edu_max_members_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            style="@style/VkUiTypography.Headline2Normal"/>
        <ImageView
            android:id="@+id/edu_max_members_chevron"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:srcCompat="@drawable/vk_icon_chevron_down_24"
            app:tint="?attr/vk_ui_icon_tertiary"/>
    </LinearLayout>
</FrameLayout>
