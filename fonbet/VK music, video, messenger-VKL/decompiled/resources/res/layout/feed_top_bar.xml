<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <FrameLayout
        android:id="@+id/feed_top_bar_before"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp">
        <com.vk.core.view.components.avatar.VkAvatar
            android:id="@+id/feed_top_bar_before_avatar"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/feed_top_bar_before_back"
            android:background="@drawable/vk_ripple_circle_highlight"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:tint="?attr/vk_ui_icon_primary"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/feed_top_bar_middle"
        android:paddingTop="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.vk.core.view.components.text.VkText
            android:textAppearance="?attr/vk_ui_typography_title1_bold"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/feed_top_bar_middle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/feed_top_bar_middle_title_dropdown"
            android:paddingBottom="@dimen/vk_ui_spacing_size2_xs"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="26dp"
            android:src="@drawable/vk_icon_lego_chevron_down_24"
            android:tint="?attr/vk_ui_icon_primary"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/feed_top_bar_after"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp">
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/feed_top_bar_after_second_extra_icon"
            android:background="@drawable/vk_ripple_circle_highlight"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:tint="?attr/vk_ui_icon_primary"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/feed_top_bar_after_extra_icon"
            android:background="@drawable/vk_ripple_circle_highlight"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            app:tint="?attr/vk_ui_icon_primary"/>
        <FrameLayout
            android:id="@+id/feed_top_bar_after_main_icon_wrapper"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp">
            <com.vk.core.view.components.picture.VkImageSimple
                android:id="@+id/feed_top_bar_after_main_icon"
                android:background="@drawable/vk_ripple_circle_highlight"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:tint="?attr/vk_ui_icon_primary"/>
            <com.vk.core.view.components.counter.VkCounter
                android:layout_gravity="start|bottom"
                android:id="@+id/feed_top_bar_after_main_icon_counter"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="20dp"
                app:counterAppearance="negative"
                app:counterMode="primary"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
