<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/title_text_view"
        android:paddingLeft="4dp"
        android:paddingTop="8dp"
        android:paddingRight="4dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:textColor="?attr/vk_ui_text_negative"
        android:id="@+id/delete_text_view"
        android:paddingLeft="4dp"
        android:paddingTop="15dp"
        android:paddingRight="4dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/community_market_album_delete_album"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_negative"
        android:id="@+id/delete_with_goods_text_view"
        android:paddingLeft="4dp"
        android:paddingTop="14dp"
        android:paddingRight="4dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/community_market_delete_album_with_goods"
        style="@style/VkUiTypography.Headline1Normal"/>
</LinearLayout>
