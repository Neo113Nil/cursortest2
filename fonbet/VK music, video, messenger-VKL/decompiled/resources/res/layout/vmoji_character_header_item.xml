<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="148dp"
        android:layout_height="148dp">
        <ImageView
            android:id="@+id/icon_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"/>
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="40dp"
            app:roundingBorderColor="@color/vk_black_alpha8"
            app:roundingBorderWidth="0.33dp"/>
    </FrameLayout>
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/vk_legacy_header_text"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/vk_sans_display_demibold"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:layout_gravity="center_horizontal"
        android:id="@+id/deactivated_subtitle"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/vmoji_deactivated_subhead"
        android:fontFamily="@font/vk_roboto_regular"/>
    <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/shimmer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/edit"
            android:background="@drawable/vk_highlight"
            android:paddingTop="5.5dp"
            android:paddingBottom="6.5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/vmoji_edit_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/vk_icon_brush_outline_24"
                app:tint="?attr/vk_ui_icon_accent_themed"/>
            <TextView
                android:textSize="15sp"
                android:textColor="?attr/vk_ui_icon_accent_themed"
                android:layout_gravity="center_vertical"
                android:id="@+id/vmoji_edit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vmoji_character_edit"
                android:lineSpacingExtra="2sp"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.01"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/promo_counter"
                android:background="@drawable/sticker_store_icon_badge"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:lines="1"
                android:fontFamily="@string/font_family_medium"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
    <RelativeLayout
        android:id="@+id/create_vmoji"
        android:background="@drawable/shape_create_vmoji_button"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <ImageView
            android:id="@+id/create_vmoji_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_vmoji_outline_28"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:layout_alignParentStart="true"
            app:tint="?attr/vk_legacy_accent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vmoji_character_create"
            android:layout_toLeftOf="@+id/create_vmoji_chevron"
            android:layout_toRightOf="@+id/create_vmoji_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:letterSpacing="0.01"/>
        <ImageView
            android:id="@+id/create_vmoji_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_chevron_compact_right_24"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"
            app:tint="?attr/vk_legacy_icon_tertiary"/>
    </RelativeLayout>
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_legacy_separator_common"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="11dp"/>
</LinearLayout>
