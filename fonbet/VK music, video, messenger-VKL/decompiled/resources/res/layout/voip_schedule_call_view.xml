<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Vk.Theme.Appbar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_scrollFlags="noScroll"
            app:navigationContentDescription="@string/accessibility_toolbar_back"
            app:navigationIcon="@drawable/vk_icon_back_24"
            app:popupTheme="?attr/actionBarPopupTheme"
            app:theme="?attr/actionBarTheme"
            style="@style/VkIm.Toolbar.Style.LargeWithBack">
            <TextView
                android:id="@+id/voip_schedule_call_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voip_schedule_call_title"
                style="@style/ToolbarTitle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <ViewFlipper
        android:id="@+id/voip_schedule_call_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/vk_toolbar_behavior_scrolling">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/voip_schedule_call_loading"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminateTint="?attr/vk_ui_icon_tertiary"
            android:indeterminateTintMode="src_in"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/voip_schedule_call_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.core.view.NestedScrollableRecyclerView
                android:id="@+id/voip_schedule_call_recycler"
                android:paddingBottom="16dp"
                android:clipToPadding="false"
                android:descendantFocusability="beforeDescendants"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toTopOf="@+id/voip_schedule_call_button_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/voip_schedule_call_button_divider"
                android:background="?attr/vk_ui_separator_primary"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toTopOf="@+id/voip_schedule_call_button_schedule_call"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:layout_gravity="center"
                android:id="@+id/voip_schedule_call_button_schedule_call"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/voip_schedule_call_schedule_call"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/VkLegacyButton.Primary.Big"/>
            <FrameLayout
                android:id="@+id/voip_schedule_call_content_overlay_loading"
                android:background="@color/vk_white_alpha15"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ProgressBar
                    android:layout_gravity="center"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:indeterminateTint="?attr/vk_ui_icon_tertiary"
                    android:indeterminateTintMode="src_in"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/error"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:id="@+id/error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="3"
                style="@style/VkLegacyTypography.Headline.Regular"/>
            <Button
                android:textColor="?attr/vk_ui_text_accent_themed"
                android:id="@+id/error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/retry"
                style="@style/VkLegacyButton.Tertiary.Rounded"/>
        </LinearLayout>
    </ViewFlipper>
    <com.vk.core.view.AppBarShadowView style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
