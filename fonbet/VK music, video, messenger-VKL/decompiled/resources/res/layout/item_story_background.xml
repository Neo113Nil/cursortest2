<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_selected"
        android:background="@drawable/bg_story_background_editor_selected"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/cv_container"
        android:layout_width="@dimen/story_background_editor_items_height"
        android:layout_height="@dimen/story_background_editor_items_height"
        android:layout_margin="@dimen/story_background_editor_items_margin"
        app:cardCornerRadius="13dp"
        app:cardElevation="0dp"
        app:contentPadding="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="center"
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"/>
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="center"
            android:id="@+id/preview_dot"
            android:background="@drawable/bg_white_circle"
            android:layout_width="8dp"
            android:layout_height="8dp"/>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/iv_animated"
        android:background="@drawable/bg_animated_background_indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="7dp"
        android:src="@drawable/vk_icon_play_12"
        android:backgroundTint="@color/vk_black_alpha12"
        app:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/vk_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
