<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/fwd_channel_msg_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toTopOf="@+id/donut_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/fwd_channel_msg_from_channel_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vkim_fwd_channel_message_from_channel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/fwd_channel_message_channel_name"
        app:layout_constraintEnd_toStartOf="@+id/fwd_channel_message_forward_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fwd_channel_msg_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/fwd_channel_message_channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/donut_text"
        app:layout_constraintEnd_toStartOf="@+id/fwd_channel_message_verified_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/fwd_channel_msg_avatar"
        app:layout_constraintTop_toBottomOf="@+id/fwd_channel_msg_from_channel_label"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginEnd="4dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/fwd_channel_message_verified_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/fwd_channel_message_channel_name"
        app:layout_constraintEnd_toStartOf="@+id/fwd_channel_message_forward_icon"
        app:layout_constraintStart_toEndOf="@+id/fwd_channel_message_channel_name"
        app:layout_constraintTop_toTopOf="@+id/fwd_channel_message_channel_name"
        app:srcCompat="@drawable/vk_icon_check_outline_16"
        app:tint="?attr/vk_ui_icon_accent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/fwd_channel_message_forward_icon"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/vkim_accessability_go_to_channel"
        app:layout_constraintBottom_toTopOf="@+id/donut_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_message_forward_outline_16"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:textAppearance="@style/VkIm.MsgPart.WallPost.AuthorTitle"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/donut_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vkim_channels_post_donut_mark"
        android:singleLine="true"
        android:drawablePadding="4dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fwd_channel_msg_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
