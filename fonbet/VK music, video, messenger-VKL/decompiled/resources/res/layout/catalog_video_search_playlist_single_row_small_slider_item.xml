<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="5dp"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:paddingEnd="5dp">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/preview_bg"
        android:visibility="gone"
        android:layout_width="@dimen/video_catalog_playlist_item_width"
        android:layout_height="@dimen/video_catalog_playlist_item_height"
        android:foreground="@drawable/catalog_bg_video_playlist_cover_item"
        android:layout_marginEnd="12dp"
        app:actualImageScaleType="centerCrop"
        app:emptyImagePlaceholder="@drawable/catalog_album_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="6dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/preview"
        android:layout_width="@dimen/video_catalog_playlist_item_width"
        android:layout_height="@dimen/video_catalog_playlist_item_height"
        android:foreground="@drawable/catalog_playlist_label"
        android:foregroundGravity="center"
        app:emptyImagePlaceholder="@drawable/catalog_album_placeholder"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="8dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/vo_overlay"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="@drawable/catalog_album_label"
        android:foregroundGravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/preview"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        app:layout_constraintStart_toStartOf="@+id/preview"
        app:layout_constraintTop_toTopOf="@+id/preview"
        app:vov_corner_radius="6dp"
        app:vov_force_redesign="true"
        app:vov_size="small"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preview"
        style="@style/VkUiTypography.SubheadMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/followers_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_goneMarginEnd="16dp"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/new_videos_indicator"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="20dp"
        android:translationX="5dp"
        android:translationY="13dp"
        app:layout_constraintBottom_toTopOf="@+id/preview"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        app:srcCompat="@drawable/ic_online_composite_20"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:id="@+id/badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/vk_ui_spacing_size_m"
        app:contentBadgeAppearance="overlay"
        app:contentBadgeMode="primary"
        app:contentBadgeSize="medium"
        app:icon="@drawable/vk_icon_list_play_outline_12"
        app:layout_constraintBottom_toBottomOf="@+id/preview"
        app:layout_constraintEnd_toEndOf="@+id/preview"/>
</androidx.constraintlayout.widget.ConstraintLayout>
