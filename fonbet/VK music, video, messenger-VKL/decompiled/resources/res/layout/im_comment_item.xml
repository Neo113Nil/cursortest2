<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/im_comment_author_avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.im.ui.views.avatars.ImAvatarView
            android:id="@+id/im_comment_author_avatar_big"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"/>
        <com.vk.im.ui.views.avatars.ImAvatarView
            android:id="@+id/im_comment_author_avatar_small"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="54dp"/>
    </FrameLayout>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/im_comment_author_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/im_comment_author_avatar_container"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="@style/VkUiTypography.FootnoteMedium"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/im_comment_author_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:vk_layout_isFluid="true"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/im_reply_to_user_name"
            android:background="@drawable/ripple_4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="2dp"
            android:paddingHorizontal="2dp"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <com.vk.core.view.links.LinkedTextView
        android:textAppearance="@style/VkUiTypography.Paragraph"
        android:textColor="?attr/vk_ui_text_primary"
        android:linksClickable="false"
        android:id="@+id/im_comment_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textDirection="locale"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        android:hyphenationFrequency="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/im_comment_author_avatar_container"
        app:layout_constraintTop_toBottomOf="@+id/im_comment_author_header"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/im_attachments_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/im_comment_author_avatar_container"
        app:layout_constraintTop_toBottomOf="@+id/im_comment_text"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/im_comment_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/im_comment_author_avatar_container"
        app:layout_constraintTop_toBottomOf="@+id/im_attachments_list"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/im_comment_edited_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vkim_channel_comments_edited_label"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/im_comment_date"
        app:layout_constraintTop_toTopOf="@+id/im_comment_date"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteMedium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/im_reply_to_comment"
        android:background="@drawable/ripple_4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:text="@string/vkim_channel_comments_reply"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toEndOf="@+id/im_comment_edited_label"
        app:layout_constraintTop_toTopOf="@+id/im_comment_date"/>
    <LinearLayout
        android:id="@+id/im_comment_reaction_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:animateLayoutChanges="true"
        android:layout_marginEnd="10dp"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/im_comment_reaction_icon"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_like_outline_16"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.FootnoteMedium"
            android:layout_gravity="center_vertical"
            android:id="@+id/im_comment_reaction_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
