<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="40dp"
        android:maxLines="1"
        style="@style/VkUiTypography.DisplayTitle2Medium.Unscaled"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="right"
        android:id="@+id/hide_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitXY"
        android:translationZ="10dp"
        android:layout_marginHorizontal="12dp"
        app:srcCompat="@drawable/vk_icon_dismiss_24"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/card_container"
        android:background="@drawable/vk_bg_video_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:layout_marginHorizontal="16dp">
        <FrameLayout
            android:id="@+id/video_content"
            android:layout_width="match_parent"
            android:layout_height="218dp"
            android:layout_marginTop="0.5dp"
            android:layout_marginHorizontal="0.5dp">
            <one.video.view.OneVideoPlayerView
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/video_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/bottom_content"
            android:layout_width="match_parent"
            android:layout_height="62dp">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/bottom_title_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="11dp"
                android:maxLines="1"
                android:paddingEnd="125dp"
                style="@style/VkUiTypography.Title3.Unscaled"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:id="@+id/bottom_subtitle_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="33dp"
                android:maxLines="1"
                android:paddingEnd="125dp"
                style="@style/VkUiTypography.Footnote.Unscaled"/>
            <include
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="33dp"
                android:paddingEnd="125dp"
                layout="@layout/vk_super_app_video_banner_content_user_stack"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/bottom_action_button_view"
                android:clipToPadding="false"
                android:layout_width="99dp"
                android:layout_height="wrap_content"
                android:foreground="@drawable/vk_bg_button_highlight_10"
                android:minHeight="30dp"
                android:layout_marginEnd="12dp"
                android:paddingHorizontal="6dp">
                <com.vk.imageloader.view.VKImageView
                    android:id="@+id/button_icon"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="6dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/vk_ui_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/button_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/VkUiTypography.SubheadMedium.Unscaled"/>
                <com.vk.imageloader.view.VKImageView
                    android:id="@+id/button_icon_right"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
