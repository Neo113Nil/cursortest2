<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/im_dialogs_list_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/dialogs_list"
        android:paddingTop="?attr/vkim_dialogs_list_padding"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:cacheColorHint="@android:color/transparent"
        android:overScrollMode="never"
        android:requiresFadingEdge="none"/>
    <com.vk.im.ui.views.dialogs.DialogSkeletonView
        android:layout_gravity="center"
        android:id="@+id/dialog_skeleton_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/dialogs_empty_all"
        android:layout="@layout/vkim_dialogs_list_empty_main"
        android:inflatedId="@+id/dialogs_empty_all"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/dialogs_empty_all_edu"
        android:layout="@layout/vkim_dialogs_list_empty_edu_main"
        android:inflatedId="@+id/dialogs_empty_all_edu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/dialogs_empty_requests"
        android:layout="@layout/vkim_dialogs_list_empty_requests"
        android:inflatedId="@+id/dialogs_empty_requests"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vkim_toolbar_height_half_inverse"/>
    <ViewStub
        android:id="@+id/dialogs_empty_chats"
        android:layout="@layout/vkim_dialogs_list_empty_chats"
        android:inflatedId="@+id/dialogs_empty_chats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/dialogs_empty_archive"
        android:layout="@layout/vkim_dialogs_list_empty_archive"
        android:inflatedId="@+id/dialogs_empty_archive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/dialogs_empty_shared_chats"
        android:layout="@layout/vkim_dialogs_list_empty_shared_chats"
        android:inflatedId="@+id/dialogs_empty_chats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/vkim_toolbar_height_inverse"/>
</FrameLayout>
