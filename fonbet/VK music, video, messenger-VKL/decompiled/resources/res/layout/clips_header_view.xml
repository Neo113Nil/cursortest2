<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:id="@+id/clips_header_content"
    android:paddingTop="@dimen/clips_header_padding"
    android:paddingBottom="@dimen/clips_header_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clips_header_content_height">
    <FrameLayout
        android:id="@+id/clips_header_before"
        android:visibility="gone"
        android:layout_width="@dimen/clips_header_before_size"
        android:layout_height="@dimen/clips_header_before_size"/>
    <Space
        android:layout_width="@dimen/clips_header_before_tab_gap"
        android:layout_height="0dp"/>
    <HorizontalScrollView
        android:id="@+id/clips_header_tabs_container"
        android:visibility="gone"
        android:scrollbars="none"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="24dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:requiresFadingEdge="horizontal">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/clips_header_tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/clips_header_tab_padding_horizontal"/>
    </HorizontalScrollView>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.DisplayTitle3SemiBold"
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="start|center_vertical"
        android:id="@+id/clips_header_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/clips_header_after"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</LinearLayout>
