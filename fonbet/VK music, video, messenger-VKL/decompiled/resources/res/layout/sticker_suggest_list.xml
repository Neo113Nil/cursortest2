<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/background"
        android:background="?attr/vk_ui_header_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/toolbar"
        android:layout_alignBottom="@+id/toolbar"
        android:layout_alignStart="@+id/toolbar"
        android:layout_alignEnd="@+id/toolbar"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/close"
            android:background="@drawable/music_selectable_bg"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_cancel_outline_28"
            android:layout_marginStart="4dp"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.DisplayTitle1"
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sticker_details_overlay_suggests"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"
        android:layout_below="@+id/toolbar"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_alignParentBottom="true"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow_view"
        android:layout_below="@+id/toolbar"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        app:vk_appbar_forceMode="shadow"
        style="@style/AppBarShadow"/>
</RelativeLayout>
