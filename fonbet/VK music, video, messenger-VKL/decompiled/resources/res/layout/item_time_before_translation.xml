<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/live_pending_background">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/live_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/live_time_left_label"
            android:maxLines="2"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            style="@style/VkUiTypography.Headline1Normal"/>
        <com.vk.clips.design.view.timer.TimerView
            android:id="@+id/live_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/live_description"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:id="@+id/subscribe_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:drawablePadding="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="@color/white_alpha30"
            app:drawableStartCompat="@drawable/vk_icon_notification_outline_24"
            app:drawableTint="@color/vk_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/live_timer"
            app:layout_constraintVertical_bias="0.5"
            style="@style/VkUiTypography.ParagraphMedium"/>
        <com.vk.core.view.components.spinner.VkScreenSpinner
            android:layout_gravity="center"
            android:id="@+id/notification_loader"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/subscribe_button"
            app:layout_constraintEnd_toEndOf="@+id/subscribe_button"
            app:layout_constraintStart_toStartOf="@+id/subscribe_button"
            app:layout_constraintTop_toTopOf="@+id/subscribe_button"
            app:spinnerMode="dropdown"
            app:spinnerSize="medium"
            app:spinnerState="loading"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
