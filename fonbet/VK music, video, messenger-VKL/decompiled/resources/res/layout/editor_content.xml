<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_editor_root"
    android:background="?attr/editorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/editor_workspace_content_size_notifier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_editor_bottom_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_editor_top_root">
        <FrameLayout
            android:id="@+id/layout_editor_content_touches"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_editor_workspace_root"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.photo.editor.views.DispatchTouchFrameLayout
            android:id="@+id/layout_editor_workspace_content"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.vk.photo.editor.views.zoom.ZoomRootLayout
                android:id="@+id/layout_editor_workspace_zoom_root"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.vk.photo.editor.views.zoom.ZoomContentLayout
                    android:id="@+id/layout_editor_workspace_zoom_content"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:animateLayoutChanges="false">
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/layout_editor_media_underlay"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/layout_editor_media_content_wrapper"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:id="@+id/layout_editor_media_content"
                            android:clipChildren="false"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/layout_editor_media_overlay"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:animateLayoutChanges="false"/>
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/layout_editor_media_tools_overlay"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </com.vk.photo.editor.views.zoom.ZoomContentLayout>
            </com.vk.photo.editor.views.zoom.ZoomRootLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/layout_editor_workspace_overlay"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animateLayoutChanges="false"/>
        </com.vk.photo.editor.views.DispatchTouchFrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/editor_loader"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/editor_gray40"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_editor_top_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/system_status_bar"
            android:background="?attr/editorBackground"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <FrameLayout
            android:id="@+id/layout_editor_top_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp">
            <include
                android:id="@+id/editor_top_panel"
                layout="@layout/editor_top_panel"/>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/layout_editor_bottom_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editor_workspace_content_size_notifier">
        <FrameLayout
            android:id="@+id/editor_bottom_bar"
            android:background="?attr/editorBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <HorizontalScrollView
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/layout_editor_tools_panel"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/paddingXS"
                        android:splitMotionEvents="false"/>
                </HorizontalScrollView>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/editor_white"
                        android:id="@+id/button_editor_cancel"
                        android:background="@drawable/ripple_50dp"
                        android:paddingLeft="16dp"
                        android:paddingTop="12dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/editor_cancel"
                        style="?attr/editorButtonStyle"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/editor_white"
                        android:id="@+id/button_editor_complete"
                        android:background="@drawable/ripple_50dp"
                        android:paddingTop="12dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/editor_done"
                        style="?attr/editorButtonPrimaryStyle"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:textAppearance="?android:attr/textAppearance"
        android:textSize="15sp"
        android:id="@+id/top_toast"
        android:background="?attr/editorTopToastBackground"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAlignment="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_editor_top_root"/>
    <FrameLayout
        android:id="@+id/layout_over_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_editor_bottom_panel"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
