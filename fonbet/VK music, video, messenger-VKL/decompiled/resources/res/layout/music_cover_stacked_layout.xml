<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/main_image"
        android:layout_width="@dimen/music_stacked_image_default_size"
        android:layout_height="@dimen/music_stacked_image_default_size"
        android:layout_margin="8dp"
        android:scaleType="centerCrop"
        android:rotation="-8"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginBottom="10dp"
        app:roundedCornerRadius="@dimen/music_image_corners_4"
        app:tiv_border_color="?attr/vk_ui_background_secondary"
        app:tiv_border_width="1dp"
        app:tiv_empty_tint="?attr/vk_ui_image_placeholder_alpha"
        app:tiv_scale_inside_borders="true"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/placeholder_icon"
        android:layout_width="@dimen/music_stacked_image_placeholder_icon_size"
        android:layout_height="@dimen/music_stacked_image_placeholder_icon_size"
        android:rotation="-8"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/main_image"
        app:layout_constraintEnd_toEndOf="@+id/main_image"
        app:layout_constraintStart_toStartOf="@+id/main_image"
        app:layout_constraintTop_toTopOf="@+id/main_image"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/secondary_image"
        android:layout_width="@dimen/music_stacked_image_default_size"
        android:layout_height="@dimen/music_stacked_image_default_size"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:scaleType="centerCrop"
        android:rotation="-8"
        android:importantForAccessibility="no"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/main_image"
        app:layout_constraintTop_toTopOf="@+id/main_image"
        app:roundedCornerRadius="@dimen/music_image_corners_4"
        app:tiv_border_color="?attr/vk_ui_background_secondary"
        app:tiv_border_width="1dp"
        app:tiv_empty_tint="?attr/vk_ui_image_placeholder_alpha"
        app:tiv_scale_inside_borders="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
