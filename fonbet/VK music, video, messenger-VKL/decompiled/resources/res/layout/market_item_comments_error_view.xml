<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/error_layout"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/error_iv"
        android:layout_width="56dp"
        android:layout_height="56dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/error_text"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/market_item_comments_error_title"
        android:freezesText="true"
        style="@style/VkUiTypography.TextNormal"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/error_retry"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vk_common_retry"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"/>
</LinearLayout>
