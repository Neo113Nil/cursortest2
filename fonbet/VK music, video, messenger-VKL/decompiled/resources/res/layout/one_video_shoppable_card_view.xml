<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/background"
        android:background="@drawable/one_video_background_rounded_8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:backgroundTint="@color/one_video_black_alpha60"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/picture_view"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="4dp"
        android:scaleType="centerInside"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toTopOf="@+id/title_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/one_video_white"
        android:id="@+id/label_view"
        android:background="@drawable/one_video_background_rounded_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:fontFamily="@font/vk_sans_text_demibold"
        android:layout_marginStart="-8dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toStartOf="@+id/picture_view"
        app:layout_constraintTop_toTopOf="@+id/picture_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/one_video_white"
        android:ellipsize="end"
        android:id="@+id/price_view"
        android:background="@drawable/one_video_background_rounded_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:fontFamily="@font/vk_sans_text_demibold"
        android:layout_marginStart="2dp"
        android:backgroundTint="@color/one_video_black_alpha60"
        android:paddingHorizontal="4dp"
        android:paddingVertical="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/picture_view"
        app:layout_constraintEnd_toEndOf="@+id/picture_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/picture_view"
        app:layout_constraintWidth_default="wrap"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/one_video_white"
        android:ellipsize="end"
        android:id="@+id/title_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:lines="2"
        android:fontFamily="@font/vk_sans_text_demibold"
        android:layout_marginVertical="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/picture_view"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="@+id/picture_view"
        app:layout_constraintTop_toBottomOf="@+id/picture_view"/>
</merge>
