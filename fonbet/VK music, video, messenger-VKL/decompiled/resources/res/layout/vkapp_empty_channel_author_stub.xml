<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:id="@+id/channel_onboarding_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_empty_community_channel_banner"
        android:padding="12dp"
        android:layout_width="336dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp">
        <com.vk.core.view.components.placeholder.main.VkPlaceholder
            android:id="@+id/vk_app_channel_onboarding_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>
        <com.vk.core.view.components.card.VkCard
            android:id="@+id/vk_app_channel_onboarding_first_post_card"
            android:background="?attr/vk_ui_background_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:foreground="?attr/selectableItemBackground">
            <com.vk.core.view.components.cell.VkCell
                android:id="@+id/vk_app_channel_onboarding_first_post_cell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"/>
        </com.vk.core.view.components.card.VkCard>
        <com.vk.core.view.components.card.VkCard
            android:id="@+id/vk_app_channel_onboarding_tg_migration_card"
            android:background="?attr/vk_ui_background_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:foreground="?attr/selectableItemBackground">
            <com.vk.core.view.components.cell.VkCell
                android:id="@+id/vk_app_channel_onboarding_tg_migration_cell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"/>
        </com.vk.core.view.components.card.VkCard>
        <com.vk.core.view.components.card.VkCard
            android:id="@+id/vk_app_channel_onboarding_monetization_card"
            android:background="?attr/vk_ui_background_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:foreground="?attr/selectableItemBackground">
            <com.vk.core.view.components.cell.VkCell
                android:id="@+id/vk_app_channel_onboarding_monetization_cell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"/>
        </com.vk.core.view.components.card.VkCard>
    </LinearLayout>
</ScrollView>
