<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.disableable.DisableableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/archived_comment_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.cell.rich.VkRichCell
        android:id="@+id/comment_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/actions_container"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.vk.core.tool.view.disableable.DisableableLinearLayout>
