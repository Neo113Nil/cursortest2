<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/news_community_restriction_grid_item_container"
    android:background="?attr/vk_ui_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/news_community_discover_grid_item_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"/>
    <View
        android:id="@+id/news_community_discover_grid_item_fade"
        android:background="@color/vk_black_alpha20"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="center"
        android:id="@+id/news_community_discover_grid_item_restriction_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="center"
        android:contentDescription="@null"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/news_community_discover_grid_item_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scaleType="center"
        android:contentDescription="@null"
        android:layout_marginEnd="4dp"
        app:tint="?attr/vk_ui_icon_contrast"/>
</FrameLayout>
