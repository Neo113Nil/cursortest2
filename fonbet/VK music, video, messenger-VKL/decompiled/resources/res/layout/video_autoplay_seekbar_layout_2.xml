<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <one.video.controls.view.seekpreview.SeekPreviewImageView
        android:id="@+id/seek_bar_preview"
        android:background="@color/vk_black"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/seek_bar_gradient"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/video_autoplay_seekbar_gradient_height"
        app:layout_constraintBottom_toBottomOf="@+id/seek_bar_preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/seek_episode_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textAlignment="center"
        android:elevation="@dimen/vk_ui_elevation_two"
        android:paddingHorizontal="@dimen/video_autoplay_seekbar_episode_title_paddings"
        app:layout_constraintBottom_toTopOf="@+id/seek_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/seek_time"
        android:background="@drawable/video_autoplay_seekbar_bgr"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/seek_bar_preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkUiTypography.FootnoteMedium.Unscaled"/>
    <com.vk.libvideo.design.view.autoplay.seekbar.VideoAutoPlaySeekBarView2
        android:layout_gravity="bottom"
        android:id="@+id/seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="1000"
        android:min="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seek_bar_preview"/>
</merge>
