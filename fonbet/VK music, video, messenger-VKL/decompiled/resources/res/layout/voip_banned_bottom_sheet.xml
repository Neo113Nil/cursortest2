<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.AvatarView
        android:layout_gravity="center"
        android:id="@+id/banned_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/banned_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/voip_you_are_trying_to_add_banned_user"
        android:maxLines="5"
        android:lineSpacingExtra="0sp"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        style="@style/VkLegacyTypography.Title1"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/banned_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/vk_roboto_regular"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        style="@style/VkLegacyTypography.Subhead2"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/banned_white_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        style="@style/VkLegacyButton.Primary"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/banned_black_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        style="@style/VkLegacyButton.Secondary"/>
</LinearLayout>
