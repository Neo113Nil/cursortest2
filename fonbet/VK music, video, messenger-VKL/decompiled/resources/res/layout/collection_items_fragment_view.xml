<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collection_items_fragment_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.search.VkSearchView
        android:id="@+id/item_search_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.clips.design.view.actionlinks.holders.tip.ItemTipView
        android:layout_gravity="top"
        android:id="@+id/collection_items_fragment_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_search_view"/>
    <com.vk.lists.RecyclerPaginatedView
        android:id="@+id/collection_items_fragment_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_search_view"/>
    <com.vkontakte.android.actionlinks.views.holders.link.ItemLinkView
        android:id="@+id/collection_items_fragment_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_search_view"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/collection_items_fragment_validation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_search_view"
        style="@style/VkUiTypography.Text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
