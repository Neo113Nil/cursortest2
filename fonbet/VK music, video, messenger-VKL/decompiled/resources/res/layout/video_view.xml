<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.libvideo.tool.view.ViewDrawCacherLayout
        android:id="@+id/video_blur_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/video_ad_background"
            android:background="@color/vk_gray_900"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.libvideo.design.view.videotexture.VideoTextureView
            android:id="@+id/video_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.libvideo.design.view.preview.PreviewImageView
            android:id="@+id/video_cover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <view
            android:layout_gravity="center"
            android:id="@+id/video_scrim_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            class="com.vk.libvideo.ui.ScrimInsetsView"/>
        <com.vk.libvideo.design.view.video.VideoBackgroundView
            android:id="@+id/video_background_view"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
    </com.vk.libvideo.tool.view.ViewDrawCacherLayout>
    <TextView
        android:textColor="@color/vk_white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/fast_speed_hint"
        android:background="@drawable/one_video_hint_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/one_video_2x_speed"
        android:drawablePadding="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingVertical="6dp"
        app:drawableEndCompat="@drawable/one_video_skip_next_16"
        style="@style/VkUiTypography.HeadlineSemiBold"/>
    <com.vk.libvideo.design.view.ad.VideoAdLayout
        android:id="@+id/video_ad_bottom_panel_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:layout_gravity="start|bottom"
        android:id="@+id/products_badge_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:capsule="false"
        app:contentBadgeAppearance="overlay"
        app:contentBadgeMode="primary"
        app:contentBadgeSize="large"
        app:icon="@drawable/vk_icon_market_16"/>
    <com.vk.media.player.subtitles.NoStyleSubtitleView
        android:id="@+id/video_subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <view
        android:layout_gravity="center"
        android:id="@+id/video_fast_seek_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        class="com.vk.libvideo.design.view.seek.VideoFastSeekView"/>
    <me.zhanghai.android.materialprogressbar.MaterialProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress_view"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        app:mpb_indeterminateTint="@color/vk_white"
        app:mpb_progressStyle="circular"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1Normal"
        android:textColor="@color/vk_white"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/zoom_rate"
        android:background="@drawable/video_zoom_info_old"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"/>
    <one.video.controls.views.preview.FullSeekPreviewLayout
        android:id="@+id/fullscreen_preview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <one.video.controls.views.PlayerControlsView
        android:id="@+id/player_control"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.libvideo.ui.video2.skippablepart.VideoSkippablePartView
        android:id="@+id/skippable_parts"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.vk.donut.design.view.badge.DonutBadge
        android:layout_gravity="start|bottom"
        android:id="@+id/donut_chip_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"/>
    <com.vk.libvideo.design.view.endview.VideoEndView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/video_end_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="110dp"
        android:alpha="0"/>
    <com.vk.libvideo.ui.VideoEndViewClipRecommend
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/video_end_view_clip_recommend"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"/>
    <com.vk.libvideo.design.view.error.VideoErrorView
        android:id="@+id/video_error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <com.vk.libvideo.design.view.actionlink.ActionLinkView
        android:layout_gravity="start|bottom"
        android:id="@+id/video_action_link_view"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        style="@style/VideoActionLink"/>
    <com.vk.core.view.VideoRestrictionView
        android:id="@+id/media_deprecated_restriction_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/media_overlay_view"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:vov_always_show_button="true"
        app:vov_force_redesign="true"
        app:vov_mode="dark"
        app:vov_size="undefined"/>
    <View
        android:id="@+id/sound_control"
        android:background="@drawable/ic_sound_off_shadow_48"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/video_sound_off"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <one.video.controls.view.CastTextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/cast_text_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
