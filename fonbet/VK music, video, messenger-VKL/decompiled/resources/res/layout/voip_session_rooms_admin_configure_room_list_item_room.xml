<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintHeight="true">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_gray_100"
        android:id="@+id/room_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="3"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="56dp"
        app:layout_constraintBottom_toTopOf="@+id/room_participants"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VoipSessionRoomList.Caption"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_gray_500"
        android:ellipsize="end"
        android:id="@+id/room_participants"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:lines="1"
        android:drawablePadding="6dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/room_name"
        style="@style/VoipSessionRoomList.FootNote"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_room_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="20dp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/voip_accessibility_edit_room_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
