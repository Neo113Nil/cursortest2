<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/qr_image"
            android:background="@drawable/bg_white_rounded20"
            android:padding="16dp"
            android:layout_width="254dp"
            android:layout_height="254dp"
            android:layout_marginTop="16dp"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Text"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/my_qr_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/qr_share_explain"
            android:layout_marginHorizontal="32dp"
            app:drawableTint="?attr/vk_ui_icon_secondary"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="52dp"
            android:layout_marginHorizontal="32dp">
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/share"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/share"
                app:buttonAppearance="neutral"
                app:buttonMode="primary"
                app:buttonSizeType="medium"
                app:icon="@drawable/vk_icon_share_outline_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/space_between"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <Space
                android:id="@+id/space_between"
                android:layout_width="8dp"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/save"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/save"
                app:buttonAppearance="neutral"
                app:buttonMode="primary"
                app:buttonSizeType="medium"
                app:icon="@drawable/vk_icon_download_outline_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/space_between"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</merge>
