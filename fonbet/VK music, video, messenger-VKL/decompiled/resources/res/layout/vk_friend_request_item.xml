<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/rounded_list_selector"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:paddingStart="@dimen/post_side_padding_avatar"
    android:paddingEnd="16dp">
    <FrameLayout
        android:layout_gravity="top"
        android:layout_width="84dp"
        android:layout_height="84dp">
        <com.vk.avatar.api.VKAvatarView
            android:id="@+id/photo"
            android:layout_width="84dp"
            android:layout_height="84dp"/>
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:layout_marginEnd="9dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="?attr/vk_legacy_text_primary"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:drawablePadding="10dp"
                android:fontFamily="@string/font_family_medium"
                app:vk_layout_isFluid="true"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:layout_marginStart="4dp"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:id="@+id/subtitle2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:ellipsize="end"
            android:id="@+id/user_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <com.vk.core.view.PhotoStackView
                android:layout_gravity="center_vertical"
                android:id="@+id/users"
                android:layout_width="wrap_content"
                android:layout_height="24dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/vk_legacy_text_tertiary"
                android:layout_gravity="center_vertical"
                android:id="@+id/info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.vk.core.view.ProgressButton
                android:textColor="?attr/vk_legacy_button_primary_foreground"
                android:id="@+id/positive"
                android:background="@drawable/vkui_bg_button_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/friends_add"
                android:contentDescription="@string/accessibility_add_friend"
                android:indeterminateTint="?attr/vk_legacy_button_primary_foreground"/>
            <com.vk.core.view.ProgressButton
                android:textColor="?attr/vk_legacy_button_secondary_foreground"
                android:id="@+id/negative"
                android:background="@drawable/vkui_bg_button_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/friends_recommended_hide"
                android:layout_marginStart="8dp"
                android:indeterminateTint="?attr/vk_legacy_button_secondary_foreground"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/request_check_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="8dp"
                app:srcCompat="@drawable/vk_icon_check_20"
                app:tint="?attr/vk_legacy_text_secondary"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/vk_legacy_text_secondary"
                android:gravity="center_vertical"
                android:id="@+id/message"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="0dp"
                android:layout_marginRight="2dp"
                android:singleLine="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/vk_legacy_text_secondary"
                android:gravity="center_vertical"
                android:id="@+id/divider_message_secondary_action"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text=" · "/>
            <TextView
                android:textSize="14sp"
                android:gravity="center_vertical"
                android:id="@+id/secondary_action"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingBottom="7dp"
                android:visibility="gone"
                android:singleLine="true"
                style="@style/tertiary_button"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
