<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_container"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="title,text"/>
    <com.vk.core.view.fresco.FrescoImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/vkim_info_bar_icon_size"
        android:layout_height="@dimen/vkim_info_bar_icon_size"
        android:contentDescription="@null"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_barrier"
        app:vkim_scaleType="fit_xy"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/hide"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Headline1"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="6"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/buttons"
        app:layout_constraintEnd_toStartOf="@+id/hide"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.vk.im.ui.views.InfoBarButtonsView
        android:id="@+id/buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/text"
        app:vkim_divider_size="8dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hide"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_hide"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_barrier"
        app:srcCompat="@drawable/vk_icon_cancel_28"
        app:tint="?attr/vk_ui_icon_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
