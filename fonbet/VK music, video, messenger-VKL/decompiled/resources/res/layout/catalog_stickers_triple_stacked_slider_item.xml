<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_sticker_pack_item_bg"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="328dp"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="16dp">
    <com.vk.vas.design.view.VKStickerPackView
        android:id="@+id/pack_image"
        android:layout_width="@dimen/stickers_catalog_triple_stacked_slider_image_bg_size"
        android:layout_height="@dimen/stickers_catalog_triple_stacked_slider_image_bg_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="?attr/vk_ui_typography_caption2_bold"
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/badge"
        android:background="@drawable/shape_sticker_pack_badge"
        android:paddingTop="0.5dp"
        android:paddingBottom="0.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.5dp"
        android:translationX="-4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintStart_toStartOf="@+id/pack_image"
        app:layout_constraintTop_toTopOf="@+id/pack_image"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="?attr/vk_ui_typography_headline1"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/pack_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/pack_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/title_barrier"
        app:layout_constraintStart_toEndOf="@+id/pack_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="?attr/vk_ui_typography_footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/pack_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/pack_title"
        app:layout_constraintStart_toStartOf="@+id/pack_title"
        app:layout_constraintTop_toBottomOf="@+id/pack_title"/>
    <com.vk.vas.design.view.VkDiscountTextView
        android:id="@+id/pack_buy"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:minWidth="62dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vk_discountButtonStyle="commerce"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/pack_added"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_done_outline_28"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/title_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="pack_buy,pack_added"/>
</androidx.constraintlayout.widget.ConstraintLayout>
