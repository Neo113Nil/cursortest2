<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_secondary_rounded_10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/vk_icon_check_circle_outline_56"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle3SemiBold"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lead_form_contact_fields_top_margin"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/paddingS"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadNormal"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/paddingS"
        app:layout_constraintBottom_toTopOf="@+id/promocode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/promocode"
        android:background="@drawable/bg_lead_form_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="@dimen/post_side_padding"
        app:drawableEndCompat="@drawable/vk_icon_copy_outline_20"
        app:drawableTint="?attr/vk_ui_icon_secondary"
        app:layout_constraintBottom_toTopOf="@+id/button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"
        style="@style/VkUiTypography.TextNormal"/>
    <com.vk.core.view.components.button.VkButton
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/paddingXXS"
        android:layout_marginBottom="@dimen/post_side_padding"
        android:minHeight="@dimen/lead_ads_button_min_height"
        android:backgroundTint="?attr/vk_ui_background_tertiary_alpha"
        android:backgroundTintMode="src_atop"
        android:layout_marginHorizontal="@dimen/post_side_padding"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_external_link_outline_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
</androidx.constraintlayout.widget.ConstraintLayout>
