<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/title_cl"
    android:background="@drawable/market_all_reviews_offers_view_holder_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/top_separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/view_holder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/market_all_reviews_offers_view_holder_title"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/items_for_review_view"
        app:layout_constraintEnd_toStartOf="@+id/view_holder_count"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_separator"
        style="@style/VkUiTypography.Headline1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/view_holder_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/view_holder_title"
        app:layout_constraintBottom_toBottomOf="@+id/view_holder_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view_holder_title"
        app:layout_constraintTop_toTopOf="@+id/view_holder_title"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.ecomm.reviews.impl.marketitem.itemsforreview.view.MarketItemsForReviewView
        android:id="@+id/items_for_review_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_holder_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
