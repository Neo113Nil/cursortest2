<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/default_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:background="@drawable/vk_bg_skeleton_v2_16dp"
            android:padding="4dp"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:elevation="2dp"
            android:backgroundTint="?attr/vk_ui_background_content"
            app:srcCompat="@drawable/vk_bg_skeleton_image_12dp"/>
        <View
            android:id="@+id/title_text_view"
            android:background="@drawable/vk_bg_skeleton_v3_4dp"
            android:layout_width="80dp"
            android:layout_height="12dp"
            android:layout_marginTop="132dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="?attr/vk_ui_background_secondary"/>
        <View
            android:id="@+id/subtitle_text"
            android:background="@drawable/vk_bg_skeleton_v3_4dp"
            android:layout_width="64dp"
            android:layout_height="12dp"
            android:layout_marginTop="152dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="?attr/vk_ui_background_secondary"/>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/action_button"
        android:background="@drawable/vk_tile_button_background"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="176dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:elevation="1dp"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle_text">
        <com.vk.core.view.shimmer.ShimmerFrameLayout
            android:id="@+id/bottom_shimmer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/button_icon"
                android:background="@drawable/vk_bg_skeleton_round_v3"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"/>
            <View
                android:id="@+id/button_text"
                android:background="@drawable/vk_bg_skeleton_v3_2dp"
                android:layout_width="60dp"
                android:layout_height="10dp"
                android:layout_marginStart="20dp"/>
        </com.vk.core.view.shimmer.ShimmerFrameLayout>
    </LinearLayout>
</FrameLayout>
