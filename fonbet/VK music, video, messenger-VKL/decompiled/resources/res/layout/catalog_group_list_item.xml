<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight">
    <com.vk.catalog2.common.ui.holders.group.avatar.GroupAvatarViewContainer
        android:id="@+id/avatar"
        android:layout_width="@dimen/catalog_link_small_content_item_size_nft"
        android:layout_height="@dimen/catalog_link_small_content_item_size_nft"
        android:layout_marginStart="12dp"
        app:contourOverlayEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:originalAvatarPadding="4dp"
        app:originalAvatarSize="@dimen/catalog_link_small_content_item_width"/>
    <ImageView
        android:id="@+id/icon_meta"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/linearLayout"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:layout_constraintVertical_bias="0.5"/>
    <com.vk.catalog2.common.ui.core.view.CorrectlyMeasuringTextView
        android:textAppearance="@string/font_family_regular"
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:singleLine="true"
        android:lineSpacingExtra="4sp"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/icon_meta"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginEnd="4dp"/>
    <com.vk.catalog2.common.ui.core.view.CorrectlyMeasuringTextView
        android:textAppearance="@string/font_family_regular"
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="4sp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vk_pay_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginEnd="16dp"/>
    <ImageView
        android:id="@+id/vk_pay_icon"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="14dp"
        android:layout_marginTop="2dp"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/linearLayout"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/subtitle"
        app:layout_constraintTop_toTopOf="@+id/subtitle"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@drawable/vk_icon_badge_vk_pay_14"
        app:tint="?attr/vk_legacy_icon_secondary"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/subscribe_action"
            android:background="@drawable/highlight_unlimited"
            android:padding="10dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/vk_icon_user_add_outline_28"
            app:tint="?attr/colorPrimary"/>
        <ImageView
            android:id="@+id/hide_action"
            android:background="@drawable/highlight_unlimited"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_newsfeed_banner_dismiss_24"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
