<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/vkim_fwd_divider"
        android:background="@drawable/bg_rounded_corners_10"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:alpha="0.4"
        android:layout_marginEnd="8dp"
        android:backgroundTint="?attr/vk_legacy_im_forward_line_tint"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:textColorLink="?attr/vk_legacy_link_alternate"
        android:id="@+id/transcript_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2sp"
        android:fontFamily="@font/vk_roboto_regular"/>
</LinearLayout>
