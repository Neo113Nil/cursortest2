<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/product_preview_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_container"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_preview_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/product_preview_error_compose_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.vk.core.view.components.spinner.VkSpinner
                android:layout_gravity="center"
                android:id="@+id/product_preview_loading_spinner"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminateTint="?attr/vk_ui_icon_secondary"
                app:spinnerSize="medium"/>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
