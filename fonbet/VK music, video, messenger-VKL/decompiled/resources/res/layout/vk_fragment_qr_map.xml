<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/vk_qr_map_view_start_padding"
    android:paddingEnd="@dimen/vk_qr_map_view_end_padding">
    <com.vk.superapp.ui.toolbar.VkAuthToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="-2dp"
        app:vk_titlePriority="picture"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="20dp">
                <com.vk.core.ui.themes.VKReplacerView
                    android:layout_gravity="center"
                    android:id="@+id/qr_map"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vk_qr_map_view_height"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/qr_map_loading_progress"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/vk_ui_icon_secondary"
                    android:indeterminateTintMode="src_in"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/qr_map_loading_error_container"
                    android:padding="20dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="?attr/vk_ui_text_secondary"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/vk_qr_map_not_loaded"
                        style="@style/VkUiTypography.Headline1Normal"/>
                    <com.vk.core.view.components.button.VkSimpleButton
                        android:layout_gravity="center"
                        android:id="@+id/qr_map_loading_reload_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vk_common_retry"
                        app:buttonAppearance="accent"
                        app:buttonMode="tertiary"/>
                </LinearLayout>
            </FrameLayout>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/divider"
                android:background="?attr/vk_ui_separator_primary_alpha"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <include
                android:id="@+id/qr_map_place_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                layout="@layout/vk_qr_map_info_item"/>
            <include
                android:id="@+id/qr_map_ip_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                layout="@layout/vk_qr_map_info_item"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
