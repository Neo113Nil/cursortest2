<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteCapsMedium"
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/pack_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pack_style_settings_btn"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/pack_style_settings_btn"
        android:background="@drawable/rounded_list_selector"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/context_user_avatar"
        app:layout_constraintStart_toEndOf="@+id/pack_name"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_gear_outline_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <ImageView
        android:id="@+id/pack_style_indicator"
        android:background="@drawable/ic_stickers_new_style_badge_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/pack_style_settings_btn"
        app:layout_constraintTop_toTopOf="@+id/pack_style_settings_btn"/>
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/context_user_avatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gift_button"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <ImageView
        android:id="@+id/context_user_check"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/stickers_context_user_check_keyboard"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="@+id/context_user_avatar"
        app:layout_constraintTop_toTopOf="@+id/context_user_avatar"
        app:tintMode="?attr/vk_ui_icon_secondary"/>
    <ImageButton
        android:id="@+id/gift_button"
        android:background="@drawable/rounded_list_selector"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_gift_outline_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
