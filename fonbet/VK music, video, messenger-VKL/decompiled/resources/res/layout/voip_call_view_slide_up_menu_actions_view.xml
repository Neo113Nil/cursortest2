<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/actions_root"
        android:background="?attr/vk_ui_background_content"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.voip.ui.onboarding.ui.CallOnboardingView
            android:id="@+id/onboarding_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <HorizontalScrollView
            android:id="@+id/broadcast_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <com.vk.voip.ui.view.VoipActionButtonsLine
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:voip_abl_mode="spread">
                <com.vk.voip.ui.view.VoipActionVerticalButtonView
                    android:id="@+id/audiodump"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:voip_abv_icon="@drawable/vk_icon_sound_wave_outline_28"
                    app:voip_abv_title="@string/voip_local_dump_record_start"
                    app:voip_abv_title_lines="2"
                    style="@style/VoipActionVerticalButtonView"/>
                <com.vk.voip.ui.view.VoipActionVerticalButtonView
                    android:id="@+id/screencast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:voip_abv_icon="@drawable/vk_icon_arrow_up_rectangle_outline_28"
                    app:voip_abv_title="@string/voip_call_menu_actions_screencast_start"
                    app:voip_abv_title_lines="2"
                    style="@style/VoipActionVerticalButtonView"/>
                <com.vk.voip.ui.view.VoipActionVerticalButtonView
                    android:id="@+id/watch_movie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:voip_abv_icon="@drawable/vk_icon_logo_vk_video_outline_28"
                    app:voip_abv_title="@string/voip_call_menu_actions_record"
                    app:voip_abv_title_lines="2"
                    style="@style/VoipActionVerticalButtonView"/>
                <com.vk.voip.ui.view.VoipActionVerticalButtonView
                    android:id="@+id/record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:voip_abv_icon="@drawable/vk_icon_recorder_tape_outline_28"
                    app:voip_abv_title="@string/voip_call_menu_actions_record"
                    app:voip_abv_title_lines="2"
                    style="@style/VoipActionVerticalButtonView"/>
                <com.vk.voip.ui.view.VoipActionVerticalButtonView
                    android:id="@+id/broadcast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:voip_abv_icon="@drawable/vk_icon_live_outline_28"
                    app:voip_abv_title="@string/voip_call_menu_actions_broadcast"
                    app:voip_abv_title_lines="2"
                    style="@style/VoipActionVerticalButtonView"/>
            </com.vk.voip.ui.view.VoipActionButtonsLine>
        </HorizontalScrollView>
        <com.vk.voip.ui.view.VoipActionSectionPlaceholder
            android:id="@+id/video_audio_section_error_placeholder"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:voip_asp_button="@string/voip_call_actions_video_audio_section_error_retry"
            app:voip_asp_description="@string/voip_call_menu_actions_no_visual_effects_description"/>
        <HorizontalScrollView
            android:id="@+id/effects_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp">
            <com.vk.voip.ui.view.VoipActionButtonsLine
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:voip_abl_mode="fill">
                <com.vk.voip.ui.view.VoipActionHorizontalButtonView
                    android:id="@+id/vmoji"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:voip_abv_icon="@drawable/vk_icon_vmoji_outline_28"
                    app:voip_abv_title="@string/voip_call_actions_vmoji_title"/>
                <com.vk.voip.ui.view.VoipActionHorizontalButtonView
                    android:id="@+id/mask"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:voip_abv_icon="@drawable/vk_icon_smile_outline_28"
                    app:voip_abv_title="@string/voip_call_menu_actions_mask"/>
                <com.vk.voip.ui.view.VoipActionHorizontalButtonView
                    android:id="@+id/virtual_background"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:voip_abv_icon="@drawable/vk_icon_user_background_outline_28"
                    app:voip_abv_title="@string/voip_call_menu_actions_background"/>
            </com.vk.voip.ui.view.VoipActionButtonsLine>
        </HorizontalScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/session_room_section"
            android:background="@drawable/bg_slide_up_menu_action_corner14"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <com.vk.voip.ui.view.VoipActionSingleLineViewLight
                android:id="@+id/action_create_session_rooms"
                android:visibility="gone"
                android:minHeight="48dp"
                app:voip_aslvl_icon="@drawable/vk_icon_user_square_on_square_outline_28"
                app:voip_aslvl_title="@string/voip_session_room_admin_create_rooms_header"
                style="@style/VoipActionSingleLineView"/>
            <com.vk.voip.ui.view.VoipActionSingleLineViewLight
                android:id="@+id/action_write_message_to_session_rooms"
                android:visibility="gone"
                android:minHeight="48dp"
                app:voip_aslvl_icon="@drawable/vk_icon_message_outline_24"
                app:voip_aslvl_title="@string/voip_session_room_admin_write_message_header"
                style="@style/VoipActionSingleLineView"/>
            <com.vk.voip.ui.view.VoipActionSingleLineViewLight
                android:id="@+id/action_join_session_room"
                android:visibility="gone"
                android:minHeight="48dp"
                app:voip_aslvl_icon="@drawable/vk_icon_user_square_on_square_outline_28"
                app:voip_aslvl_title="@string/voip_call_menu_actions_join_session_room"
                style="@style/VoipActionSingleLineView"/>
            <com.vk.voip.ui.view.VoipActionMultiLineViewLight
                android:id="@+id/action_request_room_admin_attention"
                android:visibility="gone"
                android:layout_height="wrap_content"
                app:voip_amlvl_icon="@drawable/vk_icon_help_circle_outline_28"
                app:voip_amlvl_subtitle="@string/voip_call_menu_actions_request_admin_attention_subtitle"
                app:voip_amlvl_subtitle_max_lines="1"
                app:voip_amlvl_title="@string/voip_call_menu_actions_request_admin_attention_title"
                style="@style/VoipActionMultiLineView"/>
            <com.vk.voip.ui.view.VoipActionMultiLineViewLight
                android:id="@+id/action_leave_room"
                android:layout_height="wrap_content"
                app:voip_amlvl_icon="@drawable/vk_icon_door_arrow_right_outline_28"
                app:voip_amlvl_subtitle_max_lines="1"
                app:voip_amlvl_title="@string/voip_call_menu_actions_leave_room_title"
                style="@style/VoipActionMultiLineView"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/admin_section"
            android:background="@drawable/bg_slide_up_menu_action_corner14"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <com.vk.voip.ui.view.VoipActionSingleLineViewLight
                android:id="@+id/participant_permissions"
                android:visibility="gone"
                android:minHeight="48dp"
                app:voip_aslvl_icon="@drawable/vk_icon_user_star_badge_outline_28"
                app:voip_aslvl_title="@string/voip_call_menu_actions_participant_permissions"
                style="@style/VoipActionMultiLineView"/>
            <com.vk.voip.ui.view.VoipActionMultiLineViewLight
                android:id="@+id/media_request_attention"
                android:visibility="gone"
                android:layout_height="wrap_content"
                app:voip_amlvl_icon="@drawable/vk_icon_megaphone_outline_28"
                app:voip_amlvl_title="@string/voip_call_actions_media_request_attention_title"
                app:voip_amlvl_title_max_lines="2"
                style="@style/VoipActionMultiLineView"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/participant_section"
            android:background="@drawable/bg_slide_up_menu_action_corner14"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <com.vk.voip.ui.view.VoipActionSingleLineViewLight
                android:id="@+id/request_asr_record"
                android:visibility="gone"
                android:minHeight="48dp"
                app:voip_aslvl_icon="@drawable/vk_icon_articles_outline_20"
                app:voip_aslvl_title="@string/voip_asr_menu_start"
                style="@style/VoipActionSingleLineView"/>
            <com.vk.voip.ui.view.VoipActionMultiLineViewLight
                android:id="@+id/request_asr_online"
                android:visibility="gone"
                android:minHeight="48dp"
                app:voip_amlvl_icon="@drawable/vk_icon_subtitles_outline_28"
                app:voip_amlvl_subtitle="@string/voip_asr_online_menu_start_subtitle_disabled"
                app:voip_amlvl_title="@string/voip_asr_online_menu_start_title"
                style="@style/VoipActionSingleLineView"/>
            <com.vk.voip.ui.view.VoipActionSingleLineView
                android:id="@+id/request_holiday_interaction"
                android:visibility="gone"
                android:layout_height="48dp"
                style="@style/VoipActionSingleLineView"/>
            <com.vk.voip.ui.view.VoipActionMultiLineViewLight
                android:id="@+id/change_speaker_mode"
                android:visibility="gone"
                android:layout_height="wrap_content"
                app:voip_amlvl_icon="@drawable/vk_icon_headphones_outline_28"
                app:voip_amlvl_subtitle_max_lines="1"
                app:voip_amlvl_title="@string/voip_call_menu_actions_speaker_mode"
                style="@style/VoipActionMultiLineView"/>
            <com.vk.voip.ui.view.VoipActionSingleLineViewLight
                android:id="@+id/settings"
                android:layout_height="48dp"
                app:voip_aslvl_icon="@drawable/vk_icon_settings_outline_28"
                app:voip_aslvl_title="@string/voip_call_actions"
                style="@style/VoipActionSingleLineView"/>
            <com.vk.voip.ui.view.VoipActionSingleLineViewLight
                android:id="@+id/share_link"
                android:visibility="gone"
                android:layout_height="48dp"
                app:voip_aslvl_icon="@drawable/vk_icon_share_outline_28"
                app:voip_aslvl_title="@string/voip_system_share_call_link"
                style="@style/VoipActionSingleLineView"/>
            <com.vk.voip.ui.view.VoipActionSingleLineViewLight
                android:id="@+id/send_logs"
                android:visibility="gone"
                android:layout_height="48dp"
                app:voip_aslvl_icon="@drawable/vk_icon_send_28"
                app:voip_aslvl_title="@string/voip_settings_send_debug_logs"
                style="@style/VoipActionSingleLineView"/>
            <com.vk.voip.ui.view.VoipActionSingleLineViewLight
                android:id="@+id/debug_menu"
                android:visibility="gone"
                android:layout_height="48dp"
                app:voip_aslvl_icon="@drawable/vk_icon_settings_28"
                app:voip_aslvl_title="@string/voip_debug_menu"
                style="@style/VoipActionSingleLineView"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
