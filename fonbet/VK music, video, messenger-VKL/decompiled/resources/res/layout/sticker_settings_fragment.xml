<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/vk_app_bar"
        android:background="@drawable/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        app:layout_behavior="com.vk.core.view.FixAppBarLayoutBehavior"
        style="@style/VKAppBar">
        <RelativeLayout
            android:id="@+id/toolbar"
            android:paddingTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/back_button"
                android:background="@drawable/vk_highlight_circle"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/vk_icon_arrow_left_outline_28"
                android:layout_centerVertical="true"
                android:contentDescription="@string/accessibility_back"
                android:layout_marginStart="4dp"
                android:layout_alignParentStart="true"
                app:tint="?attr/vk_ui_icon_accent_themed"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.DisplayTitle1"
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sticker_settings_title"
                android:singleLine="true"
                android:layout_toRightOf="@+id/back_button"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow_view"
        android:elevation="10dp"
        app:vk_appbar_allowSeparator="false"
        style="@style/AppBarShadow"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/content_recycler"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_alignParentBottom="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.ui.CircularProgressView
        android:layout_gravity="center"
        android:id="@+id/circular_progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cpv_animAutostart="true"
        app:cpv_color="?attr/vk_ui_background_secondary_alpha"
        app:cpv_indeterminate="true"
        app:cpv_thickness="4dp"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
