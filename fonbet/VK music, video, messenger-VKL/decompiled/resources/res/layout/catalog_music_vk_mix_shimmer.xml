<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shimmer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/vk_bg_round_oval"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="80dp"/>
        <View
            android:background="@drawable/vk_bg_skeleton_8dp"
            android:layout_width="178dp"
            android:layout_height="20dp"
            android:layout_marginTop="16dp"/>
        <View
            android:background="@drawable/vk_bg_skeleton_6dp"
            android:layout_width="260dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"/>
        <View
            android:background="@drawable/vk_bg_skeleton_12dp"
            android:layout_width="114dp"
            android:layout_height="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="80dp"/>
        <View
            android:background="@drawable/vk_bg_skeleton_6dp"
            android:layout_width="280dp"
            android:layout_height="12dp"
            android:layout_marginBottom="44dp"/>
    </LinearLayout>
</com.vk.core.view.shimmer.ShimmerFrameLayout>
