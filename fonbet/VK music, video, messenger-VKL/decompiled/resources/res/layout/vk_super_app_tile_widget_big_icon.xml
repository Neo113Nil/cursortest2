<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.components.card.VkCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile_root_view"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="220dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/icon"
            android:background="@drawable/vk_tile_image_background_16dp"
            android:padding="4dp"
            android:clipToPadding="false"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/vk_accessibility_tile_image"
            android:layout_marginStart="12dp"
            android:elevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_verified"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="56dp"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:layout_marginStart="56dp"
            android:translationZ="10dp"
            app:layout_constraintStart_toStartOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/VkUiTypography.Headline1SemiBold.Unscaled"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:id="@+id/image_subicon_text"
            android:background="@drawable/vk_superapp_counter_bg_12"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minWidth="24dp"
            android:importantForAccessibility="no"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toEndOf="@+id/icon"/>
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/icon_blur"
            android:layout_width="174dp"
            android:layout_height="174dp"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.badge.VkContentBadge
            android:id="@+id/badge_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:elevation="2dp"
            app:contentBadgeSize="small"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
        <include
            android:id="@+id/bottom_content_container"
            android:layout_width="match_parent"
            android:layout_height="174dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/vk_super_app_bottom_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.core.view.components.card.VkCard>
