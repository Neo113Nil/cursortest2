<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/review_action_button"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"/>
    <TextView
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="end"
        android:id="@+id/user_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/yclients_badge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.SubheadMedium"/>
    <ImageView
        android:id="@+id/yclients_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:src="@drawable/vk_icon_logo_yclients_color_16"
        android:contentDescription="@string/review_from_yclients"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_name_tv"
        app:layout_constraintEnd_toStartOf="@+id/review_action_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/user_name_tv"
        app:layout_constraintTop_toTopOf="@+id/user_name_tv"/>
    <ImageView
        android:id="@+id/pin_iv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_pin_outline_16"
        android:contentDescription="@string/pinned_review"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/user_name_tv"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/is_friend_mark_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/community_reviews_is_friend_mark"
        android:singleLine="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_name_tv"
        style="@style/VkUiTypography.Footnote"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/name_is_friend_mark_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="is_friend_mark_tv, user_name_tv"/>
    <com.vk.core.view.components.rating.VkStaticRatingBar
        android:id="@+id/rating_bar"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="yes"
        app:layout_constraintStart_toStartOf="@+id/user_name_tv"
        app:layout_constraintTop_toBottomOf="@+id/name_is_friend_mark_barrier"
        app:layout_goneMarginTop="6dp"
        app:rating_size="small"/>
    <TextView
        android:textColor="?attr/vk_ui_text_tertiary"
        android:id="@+id/rating_description_tv"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.8"
        android:paddingStart="1dp"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/rating_bar"
        app:layout_constraintStart_toEndOf="@+id/rating_bar"
        app:layout_constraintTop_toTopOf="@+id/rating_bar"
        style="@style/VkUiTypography.Footnote"/>
</androidx.constraintlayout.widget.ConstraintLayout>
