<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.spinner.VkSpinner
        android:layout_gravity="center"
        android:id="@+id/lives_settings_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:spinnerSize="medium"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/settings_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.clips.design.view.camera.settings.ModalSettingsRowView
            android:id="@+id/who_can_see_lives_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hint="@string/story_setting_camera_how_can_see_my_live"
            app:title="@string/story_setting_camera_how_can_see_my_live"/>
        <com.vk.clips.design.view.camera.settings.ModalSettingsRowView
            android:id="@+id/who_can_comment_lives_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.cell.VkCell
            android:id="@+id/post_lives_on_wall_container"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.cell.VkCell
            android:id="@+id/save_lives_in_stories_container"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
