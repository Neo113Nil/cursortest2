<?xml version="1.0" encoding="utf-8"?>
<com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    app:overlayDrawable="@drawable/highlight_radius_4"
    app:padOverlay="true">
    <FrameLayout
        android:background="@drawable/attach_fb_4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp">
            <com.vk.imageloader.view.VKCircleImageView
                android:id="@+id/photo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="2dp"
                android:layout_marginEnd="2dp"/>
            <View
                android:layout_gravity="end|bottom"
                android:background="@drawable/event_place_28"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="72dp"
            android:layout_marginStart="96dp"
            android:layout_marginEnd="12dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption2CapsMedium"
                android:textStyle="normal"
                android:textColor="?attr/vk_ui_text_accent"
                android:ellipsize="end"
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4.5dp"
                android:singleLine="true"/>
            <com.vk.core.tool.view.FluidHorizontalLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3.5dp">
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/lock"
                    android:background="@drawable/ic_post_friends_only"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="1.5dp"
                    android:layout_marginStart="-2dp"
                    android:backgroundTint="?attr/vk_ui_icon_secondary"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Headline2"
                    android:textStyle="normal"
                    android:textColor="?attr/vk_ui_text_muted"
                    android:ellipsize="end"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    app:vk_layout_isFluid="true"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/verified"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="9dp"/>
            </com.vk.core.tool.view.FluidHorizontalLayout>
            <TextView
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textStyle="normal"
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:id="@+id/description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="end|top"
                android:id="@+id/attach_snippet_bg_remove_button"
                android:background="@drawable/ic_cancel_oval_24"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/toggle_fave"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:scaleType="center"
                android:contentDescription="@string/favorites_add"
                android:layout_marginEnd="12dp"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/actions"
                android:background="@drawable/highlight_unlimited"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:scaleType="center"
                android:contentDescription="@string/common_actions"
                app:srcCompat="@drawable/vk_icon_more_vertical_24"
                app:tint="?attr/vk_ui_icon_tertiary"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/footer_wrapper"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="96sp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <View
                android:background="?attr/vk_ui_separator_primary_alpha"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <com.vk.core.tool.view.FluidHorizontalLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp">
                <com.vk.core.view.PhotoStripView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/photos"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Footnote"
                    android:textStyle="normal"
                    android:textColor="?attr/vk_ui_text_subhead"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/text"
                    android:paddingBottom="0.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:maxLines="2"
                    app:vk_layout_isFluid="true"/>
                <FrameLayout
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <com.vk.core.view.components.button.VkSimpleButton
                        android:layout_gravity="center_vertical"
                        android:id="@+id/button"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="160dp"
                        android:layout_marginStart="8dp"
                        app:buttonAppearance="accent"
                        app:buttonMode="primary"
                        app:buttonSizeType="medium"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:id="@+id/done_button"
                        android:background="@drawable/vk_icon_done_24"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/event_change_decision"
                        android:layout_marginStart="57dp"
                        android:backgroundTint="?attr/vk_ui_icon_secondary"/>
                </FrameLayout>
            </com.vk.core.tool.view.FluidHorizontalLayout>
            <TextView
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_subhead"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/privacy_message"
                android:paddingBottom="0.5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:text="@string/event_private_description"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"/>
        </FrameLayout>
    </FrameLayout>
</com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout>
