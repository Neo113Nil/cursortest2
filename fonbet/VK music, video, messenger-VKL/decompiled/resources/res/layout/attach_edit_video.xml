<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="96dp"
    android:layout_height="72dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/attach_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundedCornerRadius="2dp"/>
    <ProgressBar
        android:id="@+id/attach_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:layout_centerVertical="true"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2Normal.Unscaled"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/attach_error"
        android:background="?attr/vk_ui_text_secondary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/error"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/attach_edit_video_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fresco:vov_corner_radius="2dp"
        fresco:vov_size="small"/>
    <ImageView
        android:id="@+id/attach_remove"
        android:paddingLeft="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8.5dp"
        android:layout_marginRight="-8.5dp"
        android:src="@drawable/vk_icon_deprecated_ic_deattach_28"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/vkim_accessibility_remove_attachment"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1Medium.Unscaled"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/attach_video_duration"
        android:background="@drawable/bg_video_duration_label_old"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <com.vk.libvideo.design.view.movika.InteractiveDurationView
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/attach_interactive_video_duration"
        android:background="@drawable/bg_interactiv_video_duration_label_rounded_4"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
