<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sticker_bar_cl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="top"
        android:id="@+id/separator"
        android:background="?attr/vk_legacy_separator_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <com.vk.stickers.views.LongtapRecyclerView
        android:id="@+id/stickers_recycler_view"
        android:background="?attr/vk_legacy_modal_card_background"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"/>
</merge>
