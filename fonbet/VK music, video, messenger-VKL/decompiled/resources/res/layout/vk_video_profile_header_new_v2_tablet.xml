<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_profile_header_new_v2_default_layout"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/vk_video_profile_header_v2_guideline_tablet"
    android:paddingEnd="@dimen/vk_video_profile_header_v2_guideline_tablet">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/video_profile_header_new_v2_verified_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="video_profile_header_new_v2_verified_image_bg, video_profile_header_new_v2_verified_image_bg_blue, video_profile_header_new_v2_verified_image"/>
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/video_profile_header_new_v2_image_container"
        android:layout_width="@dimen/vk_video_profile_header_v2_avatar_size_tablet"
        android:layout_height="@dimen/vk_video_profile_header_v2_avatar_size_tablet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_background_secondary"
        app:roundingBorderWidth="0.5dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_profile_header_new_v2_verified_image_bg"
        android:layout_width="@dimen/vk_video_profile_header_v2_verification_icon_bg_size_tablet"
        android:layout_height="@dimen/vk_video_profile_header_v2_verification_icon_bg_size_tablet"
        app:layout_constraintBottom_toBottomOf="@+id/video_profile_header_new_v2_verified_image_bg_blue"
        app:layout_constraintEnd_toEndOf="@+id/video_profile_header_new_v2_verified_image_bg_blue"
        app:layout_constraintStart_toStartOf="@+id/video_profile_header_new_v2_verified_image_bg_blue"
        app:layout_constraintTop_toTopOf="@+id/video_profile_header_new_v2_verified_image_bg_blue"
        app:srcCompat="@drawable/vk_video_verified_background"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_profile_header_new_v2_verified_image_bg_blue"
        android:background="@drawable/vk_video_profile_azure300_oval"
        android:layout_width="@dimen/vk_video_profile_header_v2_verification_icon_size_tablet"
        android:layout_height="@dimen/vk_video_profile_header_v2_verification_icon_size_tablet"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_profile_header_new_v2_image_container"
        app:layout_constraintEnd_toEndOf="@+id/video_profile_header_new_v2_image_container"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/video_profile_header_new_v2_verified_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/vk_white"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_profile_header_new_v2_verified_image_bg_blue"
        app:layout_constraintStart_toStartOf="@+id/video_profile_header_new_v2_verified_image_bg_blue"
        app:layout_constraintTop_toTopOf="@+id/video_profile_header_new_v2_verified_image_bg_blue"
        app:srcCompat="@drawable/vk_icon_verified_16"/>
    <FrameLayout
        android:id="@+id/video_profile_header_new_v2_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toTopOf="@+id/video_profile_header_new_v2_intertitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/video_profile_header_new_v2_image_container"
        app:layout_constraintTop_toTopOf="@+id/video_profile_header_new_v2_image_container"
        app:layout_constraintVertical_chainStyle="packed">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/video_profile_header_new_v2_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/VkUiTypography.DisplayTitle3"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/title_with_badges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/video_profile_header_new_v2_change_owner_icon"
        android:background="@drawable/vk_icon_chevron_down_24"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:backgroundTint="?attr/vk_ui_icon_accent"
        app:layout_constraintBottom_toBottomOf="@+id/video_profile_header_new_v2_title_container"
        app:layout_constraintStart_toEndOf="@+id/video_profile_header_new_v2_title_container"
        app:layout_constraintTop_toTopOf="@+id/video_profile_header_new_v2_title_container"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/video_profile_header_new_v2_intertitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toTopOf="@+id/video_profile_header_new_v2_subtitle"
        app:layout_constraintStart_toStartOf="@+id/video_profile_header_new_v2_title_container"
        app:layout_constraintTop_toBottomOf="@+id/video_profile_header_new_v2_title_container"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.video.profile.presentation.views.VideoProfileSubtitleView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/video_profile_header_new_v2_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/video_profile_header_new_v2_subscribe_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/video_profile_header_new_v2_title_container"
        app:layout_constraintTop_toBottomOf="@+id/video_profile_header_new_v2_intertitle"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/video_profile_header_new_v2_subscribe_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_profile_header_new_v2_image_container"
        app:layout_constraintStart_toStartOf="@+id/video_profile_header_new_v2_title_container"
        app:layout_constraintTop_toBottomOf="@+id/video_profile_header_new_v2_subtitle"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/video_profile_header_new_v2_donut_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:layout_marginStart="8dp"
        app:iconSize="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_profile_header_new_v2_subscribe_button"
        app:layout_constraintStart_toEndOf="@+id/video_profile_header_new_v2_subscribe_button"
        app:layout_constraintTop_toTopOf="@+id/video_profile_header_new_v2_subscribe_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
