<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <one.video.controls.views.preview.VideoPreview
        android:id="@+id/preview"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/preview_interval_title"
        app:layout_constraintHorizontal_bias="0"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/preview_interval_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/preview_progress"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        app:layout_constraintStart_toStartOf="@+id/preview"
        style="@style/OneVideoText.Shadow"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/preview_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/seek_bar_guideline_top"
        style="@style/OneVideoText.Shadow"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/seek_bar_guideline_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_end="40dp"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/current_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/seek_bar_guideline_top"
        app:layout_constraintEnd_toStartOf="@+id/current_interval_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OneVideoText"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/seek_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxHeight="@dimen/one_video_seek_default_seek_size"
        android:progressDrawable="@drawable/one_video_progress_video"
        android:minHeight="@dimen/one_video_seek_default_seek_size"
        android:thumb="@drawable/one_video_progress_thumb_24"
        android:contentDescription="@string/one_video_accessibility_rewinding"
        android:splitTrack="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seek_bar_guideline_top"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/current_interval_title"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/current_progress"
        app:layout_constraintEnd_toStartOf="@+id/interval_counter"
        app:layout_constraintStart_toEndOf="@+id/current_progress"
        app:layout_constraintTop_toTopOf="@+id/current_progress"
        app:layout_constraintWidth_default="wrap"
        style="@style/OneVideoText"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/one_video_white_alpha60"
        android:gravity="center"
        android:id="@+id/interval_counter"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:drawablePadding="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        app:drawableEndCompat="@drawable/one_video_icon_chevron_16"
        app:drawableTint="@color/one_video_white_alpha60"
        app:layout_constraintBottom_toBottomOf="@+id/current_interval_title"
        app:layout_constraintEnd_toStartOf="@+id/video_buttons_view"
        app:layout_constraintStart_toEndOf="@+id/current_interval_title"
        app:layout_constraintTop_toTopOf="@+id/current_interval_title"
        style="@style/OneVideoText"/>
    <one.video.controls.views.VideoButtonsView
        android:id="@+id/video_buttons_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/one_video_ui_button_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</merge>
