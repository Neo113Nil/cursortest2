<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/vk_fullscreen_fastlogin_swipe_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/vk_auth_fullscreen_error_title_text_size"
                android:gravity="center"
                android:id="@+id/fullscreen_error_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="@dimen/vk_auth_fullscreen_error_text_horizontal_margin"
                app:layout_constraintBottom_toTopOf="@+id/fullscreen_error_message"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fullscreen_error_icon"
                style="@style/VkAuth.Title.Primary"/>
            <ImageView
                android:id="@+id/fullscreen_error_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/vk_auth_fullscreen_error_icon_size"
                android:minHeight="@dimen/vk_auth_fullscreen_error_icon_size"
                app:layout_constraintBottom_toTopOf="@+id/fullscreen_error_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:layout_constraintVertical_chainStyle="packed"
                app:srcCompat="@drawable/vk_icon_globe_cross_outline_56"
                app:tint="?attr/vk_ui_icon_secondary"/>
            <TextView
                android:textSize="@dimen/vk_auth_fullscreen_error_secondary_text_size"
                android:gravity="center"
                android:id="@+id/fullscreen_error_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="@dimen/vk_auth_fullscreen_error_text_horizontal_margin"
                app:layout_constraintBottom_toTopOf="@+id/fullscreen_error_try_again_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fullscreen_error_title"
                style="@style/VkAuth.Title.Secondary"/>
            <Button
                android:textSize="@dimen/vk_auth_fullscreen_error_secondary_text_size"
                android:id="@+id/fullscreen_error_try_again_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/vk_auth_try_again_button_text"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fullscreen_error_message"
                style="@style/VkLegacyButton.Primary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</merge>
