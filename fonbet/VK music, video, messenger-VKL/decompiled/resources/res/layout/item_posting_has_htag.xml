<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/posting_hash_tag_background"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/vk_icon_hashtag_16"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        app:tint="?attr/vk_ui_text_primary"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/hashtag_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        style="@style/VkUiTypography.Headline2"/>
</LinearLayout>
