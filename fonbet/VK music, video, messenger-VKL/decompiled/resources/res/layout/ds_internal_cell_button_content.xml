<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingHorizontal="16dp">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/icon_background"
        android:layout_width="48dp"
        android:layout_height="48dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <View
        android:id="@+id/gap_icon_main"
        android:visibility="gone"
        android:layout_width="@dimen/vk_ui_spacing_size_xl"
        android:layout_height="0dp"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/middle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingVertical="5dp">
        <TextView
            android:textAppearance="?attr/vk_ui_typography_text_normal"
            android:textColor="?attr/vk_ui_text_accent"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textAppearance="?attr/vk_ui_typography_footnote_normal"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
