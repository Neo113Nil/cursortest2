<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.Title2Medium"
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stickers_buy_confirm_title"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/stickers_buy_confirm_description"
        android:textAlignment="center"/>
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="40dp"/>
    <CheckBox
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/enable_bonus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/stickers_buy_confirm_enable_bonus"/>
    <com.vk.core.view.links.LinkedTextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/stickers_bonus_catalog_points_join_help"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp">
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="44dp"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="large"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/buy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="44dp"
            android:text="@string/stickers_buy_confirm_buy"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:buttonAppearance="positive"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </LinearLayout>
</LinearLayout>
