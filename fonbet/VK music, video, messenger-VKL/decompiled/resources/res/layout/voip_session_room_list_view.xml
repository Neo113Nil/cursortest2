<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:background="@drawable/bg_dark_top_rounded_corners_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="14dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/accessibility_back"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"
        app:srcCompat="@drawable/vk_icon_cancel_outline_28"
        app:tint="@color/vk_gray_100"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/voip_session_room_select_room_title"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:titleTextColor="@color/vk_gray_100"/>
    <View
        android:id="@+id/tool_bar_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/session_rooms"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:cacheColorHint="@android:color/transparent"
        android:requiresFadingEdge="none"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/join_room_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tool_bar_divider"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/join_room_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/voip_session_room_select_room_to_join_title"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkLegacyButton.Primary.Big"/>
</androidx.constraintlayout.widget.ConstraintLayout>
