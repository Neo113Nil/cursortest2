<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/im_appbar"
        style="@style/Vk.Theme.Appbar">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                style="@style/VkIm.Toolbar.Style.LargeWithBack"/>
            <com.vk.core.view.components.topbar.VkTopBar
                android:id="@+id/toolbar_new"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_scrollFlags="snap|enterAlways|scroll"/>
            <com.vk.core.view.components.search.VkSearchView
                android:id="@+id/vkim_search"
                android:background="?attr/vk_ui_header_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                style="?attr/im_toolbar_search_style"/>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@+id/vkim_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        style="@style/AppBarShadow"/>
    <View
        android:id="@+id/vkim_search_shadow"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        style="?attr/im_toolbar_shadow_style_thick"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/vkim_description_container"
            android:background="?attr/vk_ui_background_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="68dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/vkim_description_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/vkim_description_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="5"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
            <ImageView
                android:id="@+id/vkim_description_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cancel_24_in_circle_bg_transparent"/>
        </LinearLayout>
        <View
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/vkim_confirm_button_container"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="68dp">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/vkim_confirm_vkui_button"
            android:background="?attr/vk_ui_background_content"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp"
            app:bcb_cancel_text="@string/cancel"
            style="@style/VkIm.BottomButton"/>
    </FrameLayout>
    <com.vk.core.view.components.bottombar.VkBottomBar
        android:layout_gravity="bottom"
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.BottomConfirmButton
        android:id="@+id/vkim_confirm_btn"
        app:bcb_cancel_text="@string/cancel"
        style="@style/VkIm.BottomButton"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
