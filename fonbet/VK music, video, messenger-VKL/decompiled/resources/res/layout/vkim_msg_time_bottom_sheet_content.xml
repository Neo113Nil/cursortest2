<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/modal_window"
    android:background="@drawable/vkim_bg_modul_bottom_sheet"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="@string/vkim_delete_delay"
        android:layout_alignParentTop="true"
        android:fontFamily="@string/font_family_medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <NumberPicker
        android:id="@+id/number_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title"/>
    <TextView
        android:id="@+id/send_with_expiration_btn"
        android:background="@drawable/vkim_ripple_bg_highlighted"
        android:text="@string/vkim_accessibility_send"
        android:layout_below="@+id/number_picker"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"
        style="@style/VkIm.AccentButton"/>
    <TextView
        android:id="@+id/cancel_btn"
        android:background="@drawable/vkim_ripple_bg_highlighted"
        android:text="@string/cancel"
        android:layout_below="@+id/number_picker"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/send_with_expiration_btn"
        style="@style/VkIm.AccentButton"/>
</RelativeLayout>
