<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_sharing_footer_actions_container"
    android:background="?attr/vk_ui_background_secondary"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.sharing.core.view.SharingActionsView
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/sharing_actions_container"
        android:padding="@dimen/sharing_actions_padding"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/sharing_apps_list_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/sharing_apps_list"
        android:padding="@dimen/sharing_actions_padding"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
