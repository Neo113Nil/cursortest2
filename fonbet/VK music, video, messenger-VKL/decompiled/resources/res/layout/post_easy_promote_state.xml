<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:addStatesFromChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/content"
        android:background="@drawable/highlight"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/post_side_padding"
        android:paddingEnd="@dimen/post_side_padding">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1"
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="32dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            app:srcCompat="@drawable/vk_icon_chevron_24"
            app:tint="?attr/vk_ui_icon_tertiary"/>
    </FrameLayout>
</FrameLayout>
