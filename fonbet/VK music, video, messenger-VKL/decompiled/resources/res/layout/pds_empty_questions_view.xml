<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_question_outline_56"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/questions_empty_title"
        android:layout_marginHorizontal="16dp"
        style="@style/VkUiTypography.Title2Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/questions_empty_body"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        style="@style/VkUiTypography.Text"/>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/questions_empty_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:text="@string/questions_empty_share"/>
</LinearLayout>
