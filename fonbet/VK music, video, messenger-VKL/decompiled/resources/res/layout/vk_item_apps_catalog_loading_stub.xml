<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/vk_app_catalog_stub_horizontal_padding"
    android:paddingEnd="@dimen/vk_app_catalog_stub_horizontal_padding">
    <Space
        android:id="@+id/stub_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
        android:id="@+id/stub_items_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stub_items_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
    </com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
    <Space
        android:id="@+id/stub_indicator"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
</LinearLayout>
