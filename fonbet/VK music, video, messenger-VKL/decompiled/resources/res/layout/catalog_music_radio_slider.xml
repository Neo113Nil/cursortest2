<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/music_catalog_radio_bg"
    android:layout_width="120dp"
    android:layout_height="164dp"
    app:cardBackgroundColor="?attr/vk_ui_background_modal"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/bg_gradient"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.music.view.ThumbsImageView
            android:id="@+id/radio_logo"
            android:layout_width="@dimen/music_playlist_image"
            android:layout_height="@dimen/music_playlist_image"
            android:layout_marginTop="24dp"
            android:elevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="10dp"
            app:tiv_border_color="?attr/vk_ui_separator_primary_alpha"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_radiowaves_around_outline_28"
            app:tiv_empty_tint="?attr/vk_ui_icon_accent"/>
        <ImageView
            android:id="@+id/audio_playing_indicator"
            android:background="@drawable/music_dark_round_rect_10dp"
            android:visibility="gone"
            android:layout_width="@dimen/music_playlist_image"
            android:layout_height="@dimen/music_playlist_image"
            android:importantForAccessibility="no"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/radio_logo"
            app:layout_constraintEnd_toEndOf="@+id/radio_logo"
            app:layout_constraintStart_toStartOf="@+id/radio_logo"
            app:layout_constraintTop_toTopOf="@+id/radio_logo"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center_horizontal"
            android:id="@+id/radio_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:maxLines="2"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/radio_logo"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
