<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/reviews_ll"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/star_iv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/vk_icon_favorite_16"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <TextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/tv_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/dot_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="·"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="4dp"
        style="@style/VkUiTypography.Title2Normal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/tv_review_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/VkUiTypography.Headline1Normal"/>
</LinearLayout>
