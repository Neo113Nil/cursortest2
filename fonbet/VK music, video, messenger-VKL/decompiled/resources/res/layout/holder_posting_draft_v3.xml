<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/posting_draft_layout"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="86dp"
    android:foreground="@drawable/highlight_post">
    <View
        android:id="@+id/background"
        android:background="@drawable/bg_rounded_corners_sitpost_btn_12"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="?attr/vk_ui_background_secondary"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="4dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="start"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:scaleType="center"
        android:layout_marginStart="24dp"
        app:srcCompat="@drawable/vk_icon_pen_outline_24"
        app:tint="?attr/vk_ui_icon_primary"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="@string/newsfeed_draft_title"
        android:singleLine="true"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        style="@style/VkUiTypography.SubheadMedium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/publish_suggest_action_text"
        android:background="@drawable/bg_rounded_corners_sitpost_btn_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="43dp"
        android:layout_marginBottom="12dp"
        android:text="@string/newsfeed_draft_subtitle_v2"
        android:singleLine="true"
        android:lineSpacingExtra="6dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="56dp"
        android:backgroundTint="?attr/vk_ui_background_contrast_themed"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        style="@style/VkUiTypography.SubheadMedium"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/draft_remove"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:scaleType="center"
        android:contentDescription="@string/newsfeed_draft_delete"
        android:layout_marginEnd="12dp"
        app:srcCompat="@drawable/vk_icon_cancel_20"
        app:tint="?attr/vk_ui_icon_secondary"/>
</FrameLayout>
