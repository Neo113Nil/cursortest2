<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/highlight_radius_8"
    android:layout_width="100dp"
    android:layout_height="141dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/game_icon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="9dp"
        app:emptyImagePlaceholder="@drawable/placeholder_game_rounded"
        app:placeholderImage="@drawable/default_placeholder_10"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="10dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_legacy_text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/game_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="2"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
</LinearLayout>
