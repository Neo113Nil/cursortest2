<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.community.design.view.cover.CommunityStaticCover
        android:id="@+id/community_profile_static_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/community_profile_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.profile.core.tabs.ui.view.NestedVerticalRecyclerViewContainer
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/community_profile_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.vk.profile.core.tabs.ui.view.NestedVerticalRecyclerViewContainer>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <com.vk.core.view.components.spinner.VkScreenSpinner
        android:layout_gravity="center"
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/actionBarSize"
        app:spinnerMode="dialog"
        app:spinnerSize="large"
        app:spinnerState="loading"/>
    <FrameLayout
        android:id="@+id/community_profile_search_fragment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/community_profile_blocked_view"
        android:visibility="gone"
        android:layout="@layout/community_profile_blocked_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.community.design.view.skeleton.community.CommunityProfileSkeleton
        android:id="@+id/community_profile_skeleton"
        android:background="?attr/vk_ui_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.community.design.compose.topbar.PassthroughThemedComposeView
        android:id="@+id/community_profile_top_bar_compose_view"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/community_profile_statusbar_bg"
        android:background="?attr/vk_ui_header_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:translationZ="2dp"
        android:elevation="0dp"
        android:outlineProvider="none"
        app:theme="?attr/actionBarTheme"/>
    <androidx.compose.ui.platform.ComposeView
        android:layout_gravity="center"
        android:id="@+id/community_profile_item_content_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
