<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/reviews_ll"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/tv_review_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/VkUiTypography.Subhead"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/dot_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="·"
        android:layout_marginHorizontal="4dp"
        style="@style/VkUiTypography.Subhead"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/star_iv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/vk_icon_favorite_16"
        android:importantForAccessibility="no"
        android:layout_marginEnd="6dp"
        app:tint="?attr/vk_ui_accent_orange_peach"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/tv_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        style="@style/VkUiTypography.ParagraphMedium"/>
    <ImageView
        android:id="@+id/arrow_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_chevron_compact_right_24"
        android:scaleType="centerInside"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</LinearLayout>
