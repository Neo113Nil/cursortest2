<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/catalog_kids_collection_default_cover_height"
    android:layout_marginHorizontal="4dp">
    <androidx.cardview.widget.CardView
        android:layout_gravity="bottom"
        android:id="@+id/root_container"
        android:background="?attr/vk_ui_background_contrast_themed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:backgroundTint="?attr/vk_ui_background_contrast_themed"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/catalog_kids_collection_container_height">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_marginStart="@dimen/catalog_kids_collection_margin_end_for_text_fields"
                app:layout_constraintBottom_toTopOf="@+id/subtitle"
                app:layout_constraintEnd_toStartOf="@+id/stacked_cover"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_goneMarginEnd="@dimen/catalog_kids_collection_default_cover_width_with_padding"
                style="@style/VkUiTypography.Headline1Normal"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:alpha="0.72"
                android:layout_marginStart="@dimen/catalog_kids_collection_margin_end_for_text_fields"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/stacked_cover"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"
                app:layout_goneMarginEnd="@dimen/catalog_kids_collection_default_cover_width_with_padding"
                style="@style/VkUiTypography.Footnote"/>
            <com.vk.music.view.MusicKidsCoverStackedView
                android:id="@+id/stacked_cover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="-20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/default_cover"
        android:layout_width="@dimen/catalog_kids_collection_default_cover_width"
        android:layout_height="@dimen/catalog_kids_collection_default_cover_height"
        android:layout_marginEnd="6dp"
        android:elevation="7dp"
        app:actualImageScaleType="fitCenter"/>
</FrameLayout>
