<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.SimpleRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/white_ripple"
    android:minHeight="184dp"
    app:orientation="horizontal"
    app:ratio="0.64">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@color/vk_black_alpha05"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/vk_gradient_bottom_72_alpha48"
        android:layout_width="match_parent"
        android:layout_height="72dp"/>
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="start|top"
        android:id="@+id/photo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="8dp"/>
    <com.vk.core.view.avatars.StoryBorderView
        android:id="@+id/border"
        android:padding="1dp"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="6dp"
        app:vkim_borderColor="@color/vk_sky_300"
        app:vkim_borderGradientEndColor="@color/live_gradient_end"
        app:vkim_borderGradientStartColor="@color/live_gradient_start"
        app:vkim_borderWidth="2dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/live_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="6dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption2CapsMedium"
            android:textColor="@color/vk_white"
            android:id="@+id/badge"
            android:background="@drawable/bg_badge_live_light"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="live"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1Medium"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="3"/>
    </LinearLayout>
</com.vk.core.tool.view.SimpleRatioFrameLayout>
