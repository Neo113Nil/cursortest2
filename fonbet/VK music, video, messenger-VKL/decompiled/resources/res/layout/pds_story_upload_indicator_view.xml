<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_view_bottom_btn_height">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/fl_uploading_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.vk.stories.design.view.viewer.StoryUploadProgressView
                android:layout_gravity="center_vertical"
                android:id="@+id/pv_progress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                app:cpv_animAutostart="true"
                app:cpv_animSwoopDuration="0"
                app:cpv_color="@color/vk_gray_100"
                app:cpv_maxProgress="1"
                app:cpv_thickness="2dp"/>
            <TextView
                android:textColor="@color/vk_gray_100"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_upload_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/story_publishing_progress"
                android:maxLines="1"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="16dp"
                style="@style/VkUiTypography.FootnoteNormal"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/fl_upload_failure"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/vk_gray_100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/story_publishing_error"
                android:singleLine="true"
                android:paddingHorizontal="10dp"
                style="@style/VkUiTypography.FootnoteNormal"/>
            <TextView
                android:textColor="@color/vk_gray_100"
                android:id="@+id/tv_upload_retry"
                android:background="@drawable/white_ripple_bounded_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/story_publishing_retry"
                android:paddingHorizontal="10dp"
                style="@style/VkUiTypography.FootnoteMedium"/>
        </LinearLayout>
    </FrameLayout>
</merge>
