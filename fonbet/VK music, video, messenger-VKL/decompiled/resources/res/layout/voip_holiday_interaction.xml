<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/voip_holiday_interaction_request_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <FrameLayout
            android:id="@+id/voip_holiday_interaction_hint_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/vk_gray_800"
                android:id="@+id/voip_holiday_interaction_hint_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:fontFamily="@font/vk_roboto_medium"/>
            <TextView
                android:textColor="@color/vk_gray_800"
                android:id="@+id/voip_holiday_interaction_hint_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="3.5dp"/>
        </FrameLayout>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/voip_holiday_interaction_request_button"
            android:background="@drawable/voip_holiday_event_request_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:letterSpacing="-0.01"
            android:layout_marginHorizontal="14dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/vk_white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/voip_holiday_interaction_hide_request_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18.5dp"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>
    <View
        android:id="@+id/voip_holiday_interaction_overlay_view"
        android:background="@color/vk_black_alpha35"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/voip_holiday_interaction_message"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_holiday_interaction_cancel_button"
        android:background="@drawable/bg_voip_primary_button"
        android:padding="20.25dp"
        android:visibility="gone"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginBottom="10dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/cancel"
        app:layout_constraintBottom_toTopOf="@+id/button_labels_barrier"
        app:layout_constraintEnd_toEndOf="@+id/voip_holiday_interaction_cancel_text_view"
        app:layout_constraintStart_toStartOf="@+id/voip_holiday_interaction_cancel_text_view"
        app:srcCompat="@drawable/vk_icon_cancel_16"
        app:tint="@color/vk_white"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/voip_holiday_interaction_cancel_text_view"
        android:visibility="gone"
        android:layout_width="148dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="46dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/voip_holiday_interaction_accept_button"
        android:background="@drawable/voip_holiday_event_accept_button"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginBottom="10dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/voip_accept"
        app:layout_constraintBottom_toTopOf="@+id/button_labels_barrier"
        app:layout_constraintEnd_toEndOf="@+id/voip_holiday_interaction_accept_text_view"
        app:layout_constraintStart_toStartOf="@+id/voip_holiday_interaction_accept_text_view"
        app:tint="@color/vk_white"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/voip_holiday_interaction_accept_text_view"
        android:visibility="gone"
        android:layout_width="148dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="46dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/button_labels_barrier"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:barrierDirection="top"
        app:constraint_referenced_ids="voip_holiday_interaction_accept_text_view,voip_holiday_interaction_cancel_text_view"/>
</merge>
