<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_wall_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:id="@+id/profile_wall_post_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="15dp"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="24dp"
        android:letterSpacing="0.01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/profile_wall_post_counter_separator"
        android:background="?attr/vk_legacy_separator_common"
        android:layout_width="0dp"
        android:layout_height="@dimen/separator_height"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <HorizontalScrollView
        android:id="@+id/profile_wall_selector_scrollview"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/fl_icon_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/profile_wall_selector_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:divider="@drawable/divider_invisible_8dp"
            android:showDividers="middle">
            <com.vk.profile.core.content.ContentTabView
                android:gravity="center"
                android:id="@+id/profile_wall_all_posts"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wall_all_posts"
                android:includeFontPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"/>
            <com.vk.profile.core.content.ContentTabView
                android:gravity="center"
                android:id="@+id/profile_wall_owner_posts"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingHorizontal="4dp"/>
            <com.vk.profile.core.content.ContentTabView
                android:gravity="center"
                android:id="@+id/profile_wall_archived_posts"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wall_tab_archived_posts"
                android:includeFontPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="16dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/fl_icon_container"
        android:paddingTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/profile_wall_selector_scrollview"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/profile_wall_post_btn"
            android:background="@drawable/highlight_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="center"
            android:contentDescription="@string/accessibility_search_by_user"
            app:srcCompat="@drawable/vk_icon_search_20"
            app:tint="?attr/vk_legacy_icon_outline_secondary"/>
    </FrameLayout>
</merge>
