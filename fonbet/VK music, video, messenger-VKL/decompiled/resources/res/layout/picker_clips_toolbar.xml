<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="@dimen/picker_toolbar_height">
    <ImageView
        android:id="@+id/clips_entry_point_toolbar_close_button"
        android:background="@drawable/vk_ripple_circle_highlight"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/vk_icon_cancel_outline_28"
        android:scaleType="centerInside"
        android:contentDescription="@string/close"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <com.vk.attachpicker.widget.CustomSpinner
        android:id="@+id/clips_entry_point_toolbar_spinner"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:spinnerMode="dropdown"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:layout_gravity="center_vertical"
        android:id="@+id/clips_entry_point_toolbar_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/picker_cancel"
        android:layout_marginEnd="16dp"
        style="@style/VkUiTypography.Headline2Normal"/>
</LinearLayout>
