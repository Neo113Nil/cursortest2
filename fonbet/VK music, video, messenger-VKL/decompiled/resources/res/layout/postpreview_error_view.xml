<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/error_layout"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_error_triangle_outline_56"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/error_text"
        android:paddingTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/postpreview_error_text"
        android:freezesText="true"
        android:paddingHorizontal="32dp"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/error_retry"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:text="@string/vk_common_retry"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="small"/>
</LinearLayout>
