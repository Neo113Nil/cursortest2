<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/preview"
        android:layout_width="@dimen/video_similar_content_item_width"
        android:layout_height="@dimen/video_similar_content_item_height"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"
        app:fadeDuration="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/video_similar_corner_radius"
        app:roundingBorderColor="@color/vk_white_alpha12"
        app:roundingBorderWidth="0.5dp"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/overlay"
        android:layout_width="@dimen/video_similar_content_item_width"
        android:layout_height="@dimen/video_similar_content_item_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vov_corner_radius="6dp"
        app:vov_size="medium"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/image_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="overlay,preview"/>
    <com.vk.libvideo.design.view.duration.DurationView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_barrier"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.libvideo.design.view.movika.InteractiveDurationView
        android:textAppearance="@style/VkUiTypography.HeadlineMedium"
        android:id="@+id/interactive_duration"
        android:background="@drawable/bg_interactiv_video_duration_label_rounded_4"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_barrier"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
