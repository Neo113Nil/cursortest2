<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/story_music_dialog_root"
    android:background="?attr/vk_ui_overlay_primary"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.stories.tool.view.NoOverlappingRenderingImageView
        android:id="@+id/story_music_track_close"
        android:background="@drawable/white_ripple_unbounded"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="4dp"
        android:src="@drawable/vk_icon_cancel_outline_shadow_large_48_close"
        android:contentDescription="@string/close"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.stories.tool.view.NoOverlappingRenderingImageView
        android:id="@+id/story_dialog_done"
        android:background="@drawable/white_ripple_unbounded"
        android:layout_width="@dimen/story_done_btn_size"
        android:layout_height="@dimen/story_done_btn_size"
        android:layout_marginTop="4dp"
        android:src="@drawable/vk_icon_done_shadow_medium_48"
        android:contentDescription="@string/story_hashtag_content_desc_done_bn"
        android:layout_marginEnd="4dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.stories.design.view.stickers.music.MusicStickerStyleSwitchingView
        android:id="@+id/music_sticker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/story_music_dialog_range_waveform"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/story_dialog_done"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/onboarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_sticker"
        app:layout_constraintLeft_toLeftOf="@+id/music_sticker"
        app:layout_constraintRight_toRightOf="@+id/music_sticker"
        app:layout_constraintTop_toTopOf="@+id/music_sticker">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/onboarding_animation"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="fitCenter"
            app:lottie_autoPlay="false"
            app:lottie_fileName="tap_fill.json"
            app:lottie_loop="false"/>
        <TextView
            android:textColor="@color/vk_white"
            android:gravity="top|center_horizontal"
            android:layout_gravity="center"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/music_sticker_onboarding"
            android:textAlignment="center"
            style="@style/VkUiTypography.Caption1"/>
    </LinearLayout>
    <com.vk.stories.design.view.editor.SelectRangeWaveFormView
        android:layout_gravity="bottom"
        android:id="@+id/story_music_dialog_range_waveform"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_music_range_selector_height"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.vk.core.view.ColorProgressBar
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/story_music_progress_bar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="24dp"
        android:color="@color/vk_white"
        app:layout_constraintBottom_toBottomOf="@+id/story_music_dialog_range_waveform"
        app:layout_constraintLeft_toLeftOf="@+id/story_music_dialog_range_waveform"
        app:layout_constraintRight_toRightOf="@+id/story_music_dialog_range_waveform"
        app:layout_constraintTop_toTopOf="@+id/story_music_dialog_range_waveform"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/bottom_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_change_track"
            android:background="@drawable/white_ripple_unbounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/vk_icon_arrow_2_squarepath_outline_24"
                app:tint="@color/vk_white"/>
            <TextView
                android:textColor="@color/vk_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/story_music_change_track"
                style="@style/VkUiTypography.Caption2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_delete_track"
            android:background="@drawable/white_ripple_unbounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:paddingHorizontal="4dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/vk_icon_delete_outline_24"
                app:tint="@color/vk_white"/>
            <TextView
                android:textColor="@color/vk_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/delete"
                style="@style/VkUiTypography.Caption2"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
