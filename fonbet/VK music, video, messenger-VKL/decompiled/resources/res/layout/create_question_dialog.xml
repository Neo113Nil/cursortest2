<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_muted"
        android:gravity="center"
        android:id="@+id/create_question_tv_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/create_question_hint"
        android:alpha="0.3"
        app:layout_constraintStart_toStartOf="@+id/create_question_et_text"
        app:layout_constraintTop_toTopOf="@+id/create_question_et_text"
        style="@style/VkUiTypography.Title1SemiBold"/>
    <com.vk.core.view.components.formitem.VkInputSelect
        android:textColor="?attr/vk_ui_text_muted"
        android:textColorHint="@color/vk_clear"
        android:gravity="start"
        android:id="@+id/create_question_et_text"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="@string/create_question_hint"
        android:maxLength="@integer/questions_max_length"
        android:inputType="textMultiLine"
        android:textCursorDrawable="@drawable/vkui_edittext_cursor"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toTopOf="@+id/create_question_tv_submit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        style="@style/VkUiTypography.Title1SemiBold"/>
    <TextView
        android:textColor="?attr/vk_ui_text_tertiary"
        android:id="@+id/create_question_tv_error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/create_question_text_limit_error"
        android:textAlignment="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/create_question_et_text"
        style="@style/VkUiTypography.Text"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/question_type_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/create_question_public"
        app:buttonAppearance="neutral"
        app:buttonMode="link"
        app:buttonSizeType="small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:trailingIcon="@drawable/vk_icon_dropdown_16"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/create_question_tv_submit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/create_question_submit"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
