<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.AvatarView
        android:id="@+id/scheduled_call_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/scheduled_call_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:lines="@null"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/scheduled_call_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/scheduled_call_primary_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/scheduled_call_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <ImageView
        android:id="@+id/scheduled_call_recurring_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/vk_icon_switch_12"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/scheduled_call_subtitle"
        app:layout_constraintStart_toEndOf="@+id/scheduled_call_avatar"
        app:layout_constraintTop_toTopOf="@+id/scheduled_call_subtitle"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/scheduled_call_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/scheduled_call_primary_button"
        app:layout_constraintStart_toEndOf="@+id/scheduled_call_recurring_icon"
        app:layout_constraintTop_toBottomOf="@+id/scheduled_call_title"
        app:layout_goneMarginStart="12dp"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
    <TextView
        android:id="@+id/scheduled_call_primary_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_call_list_scheduled_call_join"
        app:layout_constraintBottom_toBottomOf="@+id/scheduled_call_avatar"
        app:layout_constraintEnd_toStartOf="@+id/scheduled_call_menu"
        app:layout_constraintTop_toTopOf="@+id/scheduled_call_avatar"
        style="@style/VkLegacyButton.Secondary"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/scheduled_call_menu"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/voip_call_list_scheduled_call_more_content_description"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/scheduled_call_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/scheduled_call_avatar"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_accent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
