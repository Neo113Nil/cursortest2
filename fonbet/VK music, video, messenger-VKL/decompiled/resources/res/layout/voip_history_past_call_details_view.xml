<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.voip.ui.avatars.VoipAvatarViewContainer
        android:id="@+id/past_call_details_header_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/accessibility_profile_photo"
        android:layout_marginStart="8dp"
        app:borderStrokeWidth="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAvatarSize="48dp"/>
    <com.vk.im.ui.views.online.OnlineView
        android:id="@+id/past_call_details_header_online"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/past_call_details_header_avatar"
        app:layout_constraintCircle="@+id/past_call_details_header_avatar"
        app:layout_constraintCircleAngle="135"
        app:layout_constraintCircleRadius="24dp"
        app:layout_constraintEnd_toEndOf="@+id/past_call_details_header_avatar"
        app:layout_constraintStart_toStartOf="@+id/past_call_details_header_avatar"
        app:layout_constraintTop_toTopOf="@+id/past_call_details_header_avatar"/>
    <TextView
        android:id="@+id/past_call_details_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/past_call_details_header_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/past_call_details_header_avatar"
        app:layout_constraintTop_toTopOf="@+id/past_call_details_header_avatar"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/past_call_details_calls_block_recycler"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:overScrollMode="never"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/past_call_details_actions_flow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/past_call_details_header_avatar"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/past_call_details_actions_flow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
