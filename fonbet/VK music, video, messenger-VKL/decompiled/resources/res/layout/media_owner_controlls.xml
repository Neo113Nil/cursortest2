<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/owner_container"
        android:background="#b8000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.im.ui.views.avatars.AvatarView
            android:layout_gravity="center_vertical"
            android:id="@+id/vkim_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/accessibility_profile_user_photo"
            android:layout_marginStart="16dp"
            style="@style/VkIm.AvatarView"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/vkim_name_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="112dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.SubheadMedium"
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:id="@+id/vkim_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption1"
                android:textColor="@color/vk_white_alpha60"
                android:ellipsize="end"
                android:id="@+id/vkim_date"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/to_msg_btn"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/vkim_accessibility_go_to_msg"
            android:layout_marginEnd="@dimen/go_to_msg_btn_margin_end"
            app:srcCompat="@drawable/vk_icon_message_arrow_right_outline_24"
            app:tint="@color/vk_white"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/vkim_share_btn"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/vkim_share"
            android:layout_marginEnd="@dimen/share_btn_margin_end"
            app:srcCompat="@drawable/vk_icon_share_outline_24"
            app:tint="@color/vk_white"/>
    </FrameLayout>
</FrameLayout>
