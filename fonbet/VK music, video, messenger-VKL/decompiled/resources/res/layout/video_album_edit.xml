<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:elevation="0dp">
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/vae_vk_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/scroll_container"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <com.vk.core.view.components.formitem.VkFormField
                android:id="@+id/form_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="21dp"
                app:label="@string/create_album_title">
                <com.vk.core.view.components.formitem.VkInputSelect
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:hint="@string/create_album_title_hint"
                    android:lines="1"
                    android:maxLength="128"
                    android:inputType="textCapSentences"
                    style="@style/VkInput"/>
            </com.vk.core.view.components.formitem.VkFormField>
            <com.vk.core.view.components.divider.VkSeparator
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_muted"
                android:id="@+id/privacy_container_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/create_album_settings"
                style="@style/VkUiTypography.Headline1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/privacy"
                android:background="@drawable/highlight"
                android:paddingTop="14dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.core.view.components.text.VkText
                    android:textColor="?attr/vk_ui_text_muted"
                    android:id="@+id/privacy_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/create_album_privacy"
                    app:layout_constraintBottom_toTopOf="@+id/privacy_subtitle"
                    app:layout_constraintEnd_toStartOf="@+id/chevron"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/VkUiTypography.HeadlineNormal"/>
                <com.vk.core.view.components.text.VkText
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/privacy_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0.5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/chevron"
                    app:layout_constraintStart_toStartOf="@+id/privacy_title"
                    app:layout_constraintTop_toBottomOf="@+id/privacy_title"
                    style="@style/VkUiTypography.Subhead"/>
                <com.vk.core.view.components.picture.VkImage
                    android:id="@+id/chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="?attr/vk_ui_icon_tertiary"
                    app:layout_constraintBottom_toBottomOf="@+id/privacy_subtitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/privacy_subtitle"
                    app:layout_constraintTop_toTopOf="@+id/privacy_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
