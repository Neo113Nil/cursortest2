<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.disableable.DisableableFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlight"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="36dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteMedium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/im_thread_show_more_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="58dp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="7dp"
        app:vk_layout_isFluid="true"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/im_thread_show_more_progress"
        android:visibility="invisible"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:indeterminateTint="?attr/vk_ui_icon_secondary"
        android:indeterminateTintMode="src_in"/>
</com.vk.core.view.disableable.DisableableFrameLayout>
