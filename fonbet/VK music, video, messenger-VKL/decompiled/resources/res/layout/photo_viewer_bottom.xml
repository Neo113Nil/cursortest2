<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:vk="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/photo_viewer_container"
        android:background="@drawable/scrim_bottom_opaque"
        android:paddingTop="112dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.links.LinkedTextView
            android:textAppearance="?attr/vk_ui_typography_subhead"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/photo_viewer_descr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/post_side_padding"
            android:layout_marginRight="@dimen/post_side_padding"
            android:layout_marginBottom="12dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/products_management_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.components.badge.VkContentBadge
                android:id="@+id/show_more_shops_button"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:scaleX="0"
                android:scaleY="0"
                android:layout_marginStart="12dp"
                android:layout_marginVertical="8dp"
                vk:contentBadgeMode="primary"
                vk:contentBadgeSize="medium"
                vk:icon="@drawable/vk_icon_shops_12"
                vk:layout_constraintBottom_toBottomOf="parent"
                vk:layout_constraintStart_toStartOf="parent"
                vk:layout_constraintTop_toTopOf="parent"/>
            <com.vk.core.view.components.badge.VkContentBadge
                android:id="@+id/show_attached_products_button"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginVertical="8dp"
                vk:contentBadgeMode="primary"
                vk:contentBadgeSize="medium"
                vk:layout_constraintBottom_toBottomOf="parent"
                vk:layout_constraintStart_toStartOf="parent"
                vk:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/show_product_pin_button_layout"
                android:visibility="visible"
                android:layout_width="48dp"
                android:layout_height="48dp"
                vk:layout_constraintBottom_toBottomOf="parent"
                vk:layout_constraintEnd_toEndOf="parent"
                vk:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/show_product_pin_image_view"
                    android:background="@drawable/vk_bg_radius_12"
                    android:padding="6dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/vk_icon_market_12"
                    android:importantForAccessibility="no"
                    android:backgroundTint="@color/vk_black"
                    vk:tint="@color/vk_white"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.vk.core.view.TintTextView
            android:textAppearance="?attr/vk_ui_typography_subhead"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/photo_viewer_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/post_side_padding"
            android:layout_marginTop="4dp"
            android:layout_marginRight="@dimen/post_side_padding"
            android:singleLine="true"
            android:drawablePadding="8dp"
            vk:drawableStartCompat="@drawable/vk_icon_place_16"
            vk:drawableStartTint="@color/music_tab_text_normal"/>
        <View
            android:id="@+id/bottom_divider"
            android:background="@color/vk_white_alpha20"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="@dimen/post_side_padding"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/post_side_padding"/>
        <LinearLayout
            android:id="@+id/photo_viewer_bottom_panel"
            android:background="@color/vk_black_alpha75"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/likes"
                android:background="@drawable/highlight_post"
                android:focusable="true"
                android:clickable="true"
                android:duplicateParentState="false"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_like">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_likes"
                    android:duplicateParentState="true"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/btn_nice_like"
                    android:importantForAccessibility="no"
                    vk:tint="@color/feed_like_icon_tint"/>
                <TextView
                    android:textAppearance="?attr/vk_ui_typography_paragraph"
                    android:textColor="@color/photo_viewer_counters"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_likes"
                    android:focusable="true"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <com.vk.core.view.OverlayTextView
                android:textAppearance="?attr/vk_ui_typography_paragraph"
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:id="@+id/photo_viewer_comments"
                android:duplicateParentState="false"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_comments"
                vk:colors="@color/likes_panel_icon_color"
                vk:overlayDrawable="@drawable/highlight_post"
                vk:src="@drawable/vk_icon_comment_outline_24"/>
            <com.vk.core.view.OverlayTextView
                android:textAppearance="?attr/vk_ui_typography_paragraph"
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:id="@+id/photo_viewer_save_docs"
                android:duplicateParentState="false"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/save_to_documents"
                vk:colors="@color/likes_panel_icon_color"
                vk:overlayDrawable="@drawable/highlight_post"
                vk:src="@drawable/vk_icon_add_24"/>
            <com.vk.core.view.OverlayTextView
                android:textAppearance="?attr/vk_ui_typography_paragraph"
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:id="@+id/photo_viewer_reposts"
                android:duplicateParentState="false"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_share"
                vk:colors="@color/likes_panel_icon_color"
                vk:overlayDrawable="@drawable/highlight_post"
                vk:src="@drawable/vk_icon_share_outline_24"/>
            <com.vk.core.view.OverlayTextView
                android:textAppearance="?attr/vk_ui_typography_paragraph"
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:id="@+id/photo_viewer_tags"
                android:duplicateParentState="false"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_tags"
                vk:colors="@color/likes_panel_icon_color"
                vk:overlayDrawable="@drawable/highlight_post"
                vk:src="@drawable/vk_icon_user_outline_24"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
