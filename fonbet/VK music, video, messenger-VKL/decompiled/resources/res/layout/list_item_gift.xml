<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/profile_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.stickers.views.gift.GiftView
        android:id="@+id/gift_view"
        android:layout_width="@dimen/gift_size"
        android:layout_height="@dimen/gift_size"
        android:layout_marginTop="12dp"
        app:animationType="primary"
        app:layout_constraintEnd_toStartOf="@+id/votes_plus_icon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_cell"/>
    <ImageView
        android:id="@+id/votes_plus_icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/vk_icon_add_alt_20"
        android:layout_marginHorizontal="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_view"
        app:layout_constraintEnd_toStartOf="@+id/votes_container"
        app:layout_constraintStart_toEndOf="@+id/gift_view"
        app:layout_constraintTop_toTopOf="@+id/gift_view"
        app:tint="?attr/vk_ui_icon_secondary_alpha"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/votes_container"
        android:visibility="gone"
        android:layout_width="@dimen/gift_votes_size"
        android:layout_height="@dimen/gift_votes_size"
        app:layout_constraintBottom_toBottomOf="@+id/gift_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/votes_plus_icon"
        app:layout_constraintTop_toTopOf="@+id/gift_view">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/votes_image"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="14dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Title3SemiBold"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/votes_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_secondary_alpha"
        android:gravity="center"
        android:id="@+id/gift_type_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/profile_gifts_gift"
        android:drawablePadding="6dp"
        app:drawableTint="?attr/vk_ui_icon_secondary_alpha"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_view"/>
    <com.vk.core.view.links.LinkedTextView
        android:textAppearance="@style/VkUiTypography.Headline2Normal.Unscaled"
        android:textColor="?attr/vk_ui_text_muted"
        android:gravity="center"
        android:id="@+id/gift_message_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_type_title"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/privacy_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/gifts_owner_privacy"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_message_text"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/action_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginHorizontal="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privacy_text"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/reply_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/profile_gifts_action_long"
        android:layout_marginHorizontal="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_gift_outline_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
