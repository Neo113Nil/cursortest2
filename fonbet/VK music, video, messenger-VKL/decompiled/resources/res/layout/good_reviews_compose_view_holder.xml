<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/good_reviews_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/reviews_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/reviews_header">
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/rating_container_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/feedback_container_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="16dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reviews_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/bottom_container_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/product_card_reviews_empty_user"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/reviews_header">
        <com.vk.core.view.components.placeholder.main.VkPlaceholder
            android:id="@+id/product_card_reviews_empty_placeholder_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/product_card_reviews_empty_button_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/good_review_item_write_feedback"
            android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
            android:layout_marginVertical="@dimen/vk_ui_spacing_size_xl"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/product_card_reviews_empty_hint_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size_s"
            android:layout_marginBottom="@dimen/vk_ui_spacing_size_xl"
            android:text="@string/good_reviews_block_empty_description"
            android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
            style="@style/VkUiTypography.Subhead"/>
    </LinearLayout>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/empty_reviews_admin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/reviews_header"/>
</androidx.constraintlayout.widget.ConstraintLayout>
