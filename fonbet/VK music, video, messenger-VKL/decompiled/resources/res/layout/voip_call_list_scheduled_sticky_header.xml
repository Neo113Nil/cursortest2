<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <View
        android:id="@+id/voip_call_list_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/scheduled_call_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/voip_scheduled_calls_header_title"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_call_list_divider"
        style="@style/VkLegacyTypography.Headline.Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent"
        android:id="@+id/scheduled_call_header_selector_button"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:layout_marginHorizontal="8dp"
        app:drawableEndCompat="@drawable/vk_icon_dropdown_outline_16"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/scheduled_call_title"
        app:layout_constraintTop_toBottomOf="@+id/voip_call_list_divider"
        style="@style/VkLegacyButton.Tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
