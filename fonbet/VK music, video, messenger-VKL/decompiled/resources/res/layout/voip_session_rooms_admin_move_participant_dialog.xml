<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_bg_card_elevation_8_cropped_full"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/VoipSessionRoomList.Subhead"
        android:textSize="13sp"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/voip_participant_name"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:lines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VoipSessionRoomList.Caption"
        android:gravity="center_vertical"
        android:id="@+id/voip_move_participant_to_call"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/voip_session_room_admin_participant_move_participant_to_main_call"
        android:drawablePadding="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:drawableStartCompat="@drawable/vk_icon_arrow_left_outline_28"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_participant_name"
        app:textColor="?attr/vk_ui_text_primary"/>
    <TextView
        android:textAppearance="@style/VoipSessionRoomList.Caption"
        android:gravity="center_vertical"
        android:id="@+id/voip_move_participant_to_room"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:text="@string/voip_session_room_admin_participant_move_participant"
        android:drawablePadding="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:drawableStartCompat="@drawable/vk_icon_arrow_uturn_right_outline_28"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_move_participant_to_call"
        app:textColor="?attr/vk_ui_text_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
