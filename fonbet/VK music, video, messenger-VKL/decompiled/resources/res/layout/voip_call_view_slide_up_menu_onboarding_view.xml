<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_black_alpha60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/voip_call_view_slide_up_onboarding_screen"
        android:background="@drawable/bg_slide_up_menu_onboarding"
        android:paddingTop="97dp"
        android:layout_width="64dp"
        android:layout_height="110dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"
        app:layout_constraintVertical_chainStyle="packed">
        <View
            android:background="@drawable/bg_slide_up_menu_onboarding_curtain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/animated_box"
        android:layout_width="104dp"
        android:layout_height="140dp"
        android:layout_marginTop="0dp"
        app:layout_constraintStart_toStartOf="@+id/voip_call_view_slide_up_onboarding_screen"
        app:layout_constraintTop_toTopOf="@+id/voip_call_view_slide_up_onboarding_screen">
        <View
            android:id="@+id/slider_geometry"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="96dp"
            android:layout_marginBottom="32dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/slider_handle"
            android:background="@drawable/bg_swipe_indicator"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            app:layout_constraintEnd_toEndOf="@+id/slider_geometry"
            app:layout_constraintStart_toStartOf="@+id/slider_geometry"
            app:layout_constraintTop_toTopOf="@+id/slider_geometry"/>
        <View
            android:id="@+id/slider_scroll"
            android:background="@drawable/bg_swipe_indicator"
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="-8dp"
            android:alpha="0.32"
            app:layout_constraintBottom_toTopOf="@+id/slider_geometry"
            app:layout_constraintEnd_toEndOf="@+id/slider_geometry"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/voip_call_view_slide_up_onboarding_pointer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:src="@drawable/ic_hand_poiner_46"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/slider_handle"
            app:layout_constraintTop_toTopOf="@+id/slider_scroll"
            app:tint="@color/vk_white"/> /&gt; 
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/vk_white"
        android:id="@+id/voip_call_view_slide_up_onboarding_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/voip_slide_up_menu_onboarding_explanation"
        android:lines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_call_view_slide_up_onboarding_screen"
        style="@style/VkLegacyTypography.Headline.Regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
