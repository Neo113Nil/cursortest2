<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/market_all_reviews_offers_view_holder_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/top_separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/view_holder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/market_all_reviews_offers_view_holder_title"
        android:layout_marginStart="16dp"
        style="@style/VkUiTypography.Headline1"/>
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/market_all_reviews_shimmer_view"
        android:layout_width="match_parent"
        android:layout_height="370dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/offer_review_view_placeholder"
            android:background="@drawable/market_item_reviews_offer_background_shape"
            android:paddingTop="28dp"
            android:paddingBottom="28dp"
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp">
            <ImageView
                android:id="@+id/shimmer_iv"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="128dp"
                android:layout_height="152dp"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toTopOf="@+id/shimmer_title_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:gravity="center"
                android:id="@+id/shimmer_title_tv"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="216dp"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/shimmer_description_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shimmer_iv"/>
            <View
                android:gravity="center"
                android:id="@+id/shimmer_description_tv"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="176dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/shimmer_view_set"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shimmer_title_tv"/>
            <com.vk.core.view.components.rating.VkRatingBarSkeleton
                android:layout_gravity="center"
                android:id="@+id/shimmer_view_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:drawable="@drawable/oval_skeleton_28"
                app:emptyColor="?attr/vk_ui_skeleton_from"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shimmer_description_tv"
                app:paddingBetween="16dp"
                app:ratingCount="5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
</LinearLayout>
