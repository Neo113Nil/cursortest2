<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:splitMotionEvents="true">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/paddingXXS"
        android:layout_marginBottom="@dimen/paddingXXS"
        android:layout_marginEnd="@dimen/paddingXXS"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/btnDelete"
            android:background="@drawable/ripple_50dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_trash"
            android:contentDescription="@string/editor_accessibility_collage_remove_photo"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
