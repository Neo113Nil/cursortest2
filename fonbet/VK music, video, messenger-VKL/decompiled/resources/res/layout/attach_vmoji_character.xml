<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/snippet_background_8dp_corner"
    android:layout_width="match_parent"
    android:layout_height="216dp"
    android:layout_margin="8dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/vmoji_character_image"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundedCornerRadius="8dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/vmoji_snippet_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/vmoji_snippet_caption"
        app:layout_constraintEnd_toStartOf="@+id/open_vmoji_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vmoji_character_image"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Headline2.Unscaled"/>
    <com.vk.core.view.TextViewEllipsizeEnd
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/vmoji_snippet_caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/open_vmoji_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vmoji_snippet_title"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:layout_gravity="center_vertical"
        android:id="@+id/open_vmoji_button"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp"
        android:maxWidth="160dp"
        android:layout_marginEnd="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vmoji_character_image"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="end|top"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/attach_snippet_remove_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_deprecated_ic_close_attach_36"
            android:contentDescription="@string/delete"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/snippet_toggle_fave"
            android:background="@drawable/highlight_circle_white"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/fave_start_button"
            android:scaleType="center"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
