<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlight"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/page_full_photo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="2dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="2dp"
        app:borderStrokeWidth="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_page_action"
        android:background="@drawable/highlight_unlimited"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:contentDescription="@string/common_actions"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/page_full_online_status"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:translationX="-6dp"
        android:translationY="-6dp"
        app:layout_constraintBottom_toBottomOf="@+id/page_full_photo"
        app:layout_constraintEnd_toEndOf="@+id/page_full_photo"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:ellipsize="end"
        android:id="@+id/page_full_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/page_full_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/verified"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/page_full_photo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Headline1Normal"/>
    <ImageView
        android:id="@+id/verified"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/page_full_title"
        app:layout_constraintEnd_toStartOf="@+id/iv_page_action"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/page_full_title"
        app:layout_constraintTop_toTopOf="@+id/page_full_title"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/page_full_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:lines="1"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/page_full_tag_group"
        app:layout_constraintEnd_toStartOf="@+id/iv_page_action"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/page_full_title"
        app:layout_constraintTop_toBottomOf="@+id/page_full_title"/>
    <com.vk.core.ui.fave.FaveTagViewGroup
        android:id="@+id/page_full_tag_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:horizontalSpacing="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_page_action"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/page_full_subtitle"
        app:layout_constraintTop_toBottomOf="@+id/page_full_subtitle"
        app:separatorTextColor="@color/vk_gray_400"
        app:singleLineMode="true"
        app:tagFontFamily="@string/font_family_regular"
        app:tagHorizontalPadding="2dp"
        app:tagLineSpacingExtra="4sp"
        app:tagTextColor="@color/vk_gray_400"
        app:tagTextSize="14sp"
        app:tagVerticalPadding="1dp"
        app:verticalSpacing="0dp"/>
    <ImageView
        android:id="@+id/iv_tag_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/page_full_tag_group"
        app:layout_constraintStart_toEndOf="@+id/page_full_photo"
        app:layout_constraintTop_toTopOf="@+id/page_full_tag_group"
        app:srcCompat="@drawable/vk_icon_tag_12"
        app:tint="@color/vk_gray_300"/>
</androidx.constraintlayout.widget.ConstraintLayout>
