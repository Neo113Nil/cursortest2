<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="160dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2Normal"
        android:textStyle="bold"
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/poll_result_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:maxLines="10"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="@color/vk_blue_300"
        android:gravity="center"
        android:id="@+id/poll_result_author_name"
        android:background="@drawable/highlight_radius_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/poll_result_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="41dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
</LinearLayout>
