<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/vk_black">
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/timeline_editing_cancel"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:text="@string/clip_timeline_action_cancel"
        android:contentDescription="@string/clip_timeline_action_cancel"
        android:layout_marginStart="12dp"
        android:stateListAnimator="@null"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/timeline_editing_done"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:text="@string/clip_timeline_action_done"
        android:contentDescription="@string/clip_timeline_action_done"
        android:layout_marginEnd="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
