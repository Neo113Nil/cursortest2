<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="274dp"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/image_header_background"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary_invariably"
        android:id="@+id/tag_on_banner"
        android:background="@drawable/extended_podcast_tag_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toStartOf="@+id/image_header_background"
        app:layout_constraintTop_toTopOf="@+id/image_header_background"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/image_podcast_background_cover"
        android:layout_width="103dp"
        android:layout_height="103dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/image_header_background"
        app:layout_constraintStart_toStartOf="@+id/image_header_background"
        app:layout_constraintTop_toTopOf="@+id/image_header_background"
        app:layout_constraintVertical_bias="0.45"/>
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/image_podcast_cover"
        android:layout_width="88dp"
        android:layout_height="88dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_podcast_background_cover"
        app:layout_constraintEnd_toEndOf="@+id/image_podcast_background_cover"
        app:layout_constraintStart_toStartOf="@+id/image_podcast_background_cover"
        app:layout_constraintTop_toTopOf="@+id/image_podcast_background_cover"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/footer_background"
        android:background="@drawable/extended_podcast_footer_background"
        android:layout_width="match_parent"
        android:layout_height="91dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_header_background">
        <TextView
            android:ellipsize="end"
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.DisplayTitle4"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/text_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:maxLines="3"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_title"
            style="@style/VkUiTypography.Footnote"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
