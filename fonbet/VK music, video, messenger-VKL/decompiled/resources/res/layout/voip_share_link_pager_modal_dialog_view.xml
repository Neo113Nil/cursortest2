<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp">
        <ImageView
            android:id="@+id/close_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_cancel_28"
            android:contentDescription="@string/voip_close"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voip_share_link_page_modal_dialog_title"
            android:layout_marginStart="12dp"
            style="@style/VkUiTypography.DisplayTitle2"/>
    </LinearLayout>
    <com.vk.voip.ui.share.link.pager.view.VoipShareLinkPagerView
        android:id="@+id/share_link_view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="12dp"/>
</LinearLayout>
