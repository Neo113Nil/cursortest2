<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="47dp">
    <View
        android:layout_gravity="top"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="@dimen/post_side_padding"
        android:layout_marginEnd="@dimen/post_side_padding"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="5dp"
        android:text="@string/video_downloaded_title"
        android:layout_marginStart="@dimen/post_side_padding"
        android:layout_marginEnd="@dimen/post_side_padding"
        style="@style/VkUiTypography.Headline1"/>
</FrameLayout>
