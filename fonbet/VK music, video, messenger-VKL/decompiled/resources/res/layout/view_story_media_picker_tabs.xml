<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/story_media_tab_view"
        android:background="@drawable/bottom_bar_background"
        android:layout_width="wrap_content"
        android:layout_height="68dp">
        <FrameLayout
            android:gravity="center"
            android:id="@+id/story_gallery_tab_container"
            android:layout_width="@dimen/tab_button_width"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/story_gallery_indicator"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="@color/color_tab_buttons"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/story_gallery_tab"
                android:layout_width="@dimen/tab_button_width"
                android:layout_height="wrap_content"
                android:text="@string/gallery"
                android:drawablePadding="3dp"
                android:textAlignment="center"
                app:drawableTint="@color/color_tab_buttons"
                app:drawableTopCompat="@drawable/vk_icon_picture_outline_28"
                style="@style/VkUiTypography.Caption2Normal"/>
        </FrameLayout>
        <FrameLayout
            android:gravity="center"
            android:id="@+id/story_placeholder_tab_container"
            android:layout_width="@dimen/tab_button_width"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/story_template_indicator"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="@color/color_tab_buttons"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/story_template_tab"
                android:layout_width="@dimen/tab_button_width"
                android:layout_height="wrap_content"
                android:text="@string/story_ideas"
                android:drawablePadding="3dp"
                android:textAlignment="center"
                app:drawableTint="@color/color_tab_buttons"
                app:drawableTopCompat="@drawable/vk_icon_stories_ideas_outline_28"
                style="@style/VkUiTypography.Caption2Normal"/>
            <com.vk.core.view.components.counter.VkCounter
                android:layout_gravity="end|top"
                android:id="@+id/story_template_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="22dp"
                app:counterMode="primary"
                app:counterSize="small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/icon_right"
                app:layout_constraintStart_toEndOf="@+id/label"
                app:layout_constraintTop_toTopOf="parent"/>
        </FrameLayout>
    </LinearLayout>
</merge>
