<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/past_broadcasts_root_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VKAppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/past_broadcasts_root_toolbar"
            app:layout_scrollFlags="noScroll"
            app:title="@string/vkim_settings_past_broadcast"
            style="@style/VkIm.Toolbar.Style.LargeWithBack"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.vk.lists.CustomSwipeRefreshLayout
        android:id="@+id/past_broadcasts_recycler_swipe_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/vk_toolbar_behavior_scrolling">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/past_broadcasts_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.vk.lists.CustomSwipeRefreshLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/past_broadcasts_error_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/past_broadcasts_error_state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="2"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            style="@style/VkLegacyTypography.Headline.Regular"/>
        <TextView
            android:textColor="?attr/vk_ui_text_accent_themed"
            android:id="@+id/past_broadcasts_error_state_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry"
            style="@style/VkLegacyButton.Tertiary.Rounded"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/past_broadcasts_loading_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/past_broadcasts_loading_state_progress"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminateTint="?attr/vk_ui_icon_tertiary"
            android:indeterminateTintMode="src_in"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/past_broadcasts_empty_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/past_broadcasts_root_app_bar">
        <ImageView
            android:id="@+id/past_broadcasts_empty_state_logo"
            android:background="@drawable/highlight_circle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/retry"
            app:srcCompat="@drawable/vk_icon_phone_outline_56"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <TextView
            android:id="@+id/past_broadcasts_empty_state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/voip_past_broadcasts_empty_list_title"
            android:paddingHorizontal="32dp"
            style="@style/VkLegacyTypography.Title2.Medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/past_broadcasts_empty_state_description"
            android:paddingTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voip_past_broadcasts_empty_list_description"
            android:layout_marginHorizontal="16dp"
            style="@style/VkLegacyTypography.Headline.Roboto.Regular"/>
        <TextView
            android:textSize="15sp"
            android:id="@+id/past_broadcasts_empty_state_action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="200dp"
            android:minHeight="44dp"
            android:text="@string/voip_past_broadcasts_empty_list_action_call"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkLegacyButton.Primary"/>
    </LinearLayout>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
