<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/files_anim"
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:layout_marginTop="20dp"
        app:lottie_autoPlay="false"
        app:lottie_loop="true"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/progress_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:maxLines="1"
        android:fontFamily="@string/font_family_medium"
        style="@style/VkUiTypography.Title2Medium"/>
    <com.vk.im.ui.views.ProgressLineView
        android:id="@+id/download_progress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="12dp"
        app:vkim_colorPrimary="?attr/vk_ui_stroke_accent"
        app:vkim_colorSecondary="?attr/vk_ui_track_background"
        app:vkim_cornerRadius="1dp"
        app:vkim_divider_size="0dp"
        app:vkim_max="100"
        app:vkim_min="0"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAlignment="center"
        style="@style/VkUiTypography.SubheadNormal"/>
    <com.vk.im.ui.views.buttons.VkButtonWithSmallScreenSupport
        android:id="@+id/cancel_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:text="@string/vkim_popup_download_attaches_cancel"
        style="@style/VkLegacyButton.Secondary.Big"/>
</LinearLayout>
