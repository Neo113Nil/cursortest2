<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.components.card.VkCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="@dimen/user_profile_gift_size"
    android:layout_height="@dimen/user_profile_gift_size"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginVertical="4dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:srcCompat="@drawable/vk_icon_gift_outline_32"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_icon_accent_themed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/item_birthday_gift_more"
            style="@style/VkUiTypography.Headline1Medium"/>
    </LinearLayout>
</com.vk.core.view.components.card.VkCard>
