<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/control_container"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="12dp">
    <FrameLayout
        android:id="@+id/feed_carousel_products_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/feed_carousel_product_sound_control"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.tool.view.vkblur.VkBlurView
        android:id="@+id/feed_carousel_product_market_control_blur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/feed_carousel_product_market_control"
        app:layout_constraintEnd_toEndOf="@+id/feed_carousel_product_market_control"
        app:layout_constraintStart_toStartOf="@+id/feed_carousel_product_market_control"
        app:layout_constraintTop_toTopOf="@+id/feed_carousel_product_market_control"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:state_selected="true"
        android:id="@+id/feed_carousel_product_market_control"
        android:background="@drawable/bg_newsfeed_clip_control"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:src="@drawable/newsfeed_items_control_image"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_clips_show_items_control"
        app:layout_constraintBottom_toTopOf="@+id/feed_carousel_product_sound_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/newsfeed_clips_control_tint"/>
    <com.vk.core.tool.view.vkblur.VkBlurView
        android:id="@+id/feed_carousel_product_sound_control_blur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/feed_carousel_product_sound_control"
        app:layout_constraintEnd_toEndOf="@+id/feed_carousel_product_sound_control"
        app:layout_constraintStart_toStartOf="@+id/feed_carousel_product_sound_control"
        app:layout_constraintTop_toTopOf="@+id/feed_carousel_product_sound_control"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/feed_carousel_product_sound_control"
        android:background="@drawable/bg_newsfeed_clip_control"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/vk_icon_volume_16"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/vk_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
