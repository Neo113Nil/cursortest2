<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/vk_icon_phone_outline_56"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/voip_join_by_password_modal_dialog_title"
        style="@style/VkUiTypography.Title2"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/voip_bg_corner_top8bottom16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:backgroundTint="?attr/vk_ui_field_background"
        android:layout_marginHorizontal="16dp">
        <EditText
            android:textColor="?attr/vk_ui_text_primary"
            android:textColorHint="?attr/vk_ui_text_secondary"
            android:id="@+id/input_link"
            android:background="@drawable/voip_bg_field_background_corner8_field_border_alpha_stroke05"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="@string/voip_join_by_password_modal_dialog_link_hint"
            android:lines="1"
            android:inputType="text"
            android:paddingStart="12dp"
            style="@style/VkUiTypography.Text"/>
        <EditText
            android:textColorHint="?attr/vk_ui_text_secondary"
            android:id="@+id/input_password"
            android:background="@drawable/voip_bg_background_content_corner8_field_border_alpha_stroke05"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_margin="16dp"
            android:hint="@string/voip_join_by_password_modal_dialog_password_hint"
            android:lines="1"
            android:drawablePadding="10dp"
            android:inputType="text"
            android:drawableStart="@drawable/vk_icon_lock_outline_24"
            android:paddingStart="10dp"
            android:drawableTint="?attr/vk_ui_icon_secondary"
            style="@style/VkUiTypography.Text"/>
    </LinearLayout>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/join_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:text="@string/voip_join_by_password_modal_dialog_join_btn"/>
</LinearLayout>
