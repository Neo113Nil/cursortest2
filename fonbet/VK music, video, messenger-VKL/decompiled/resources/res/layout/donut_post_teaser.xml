<?xml version="1.0" encoding="utf-8"?>
<com.vk.feed.tool.view.newsfeed.attach.PrimaryAttachmentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.AspectRatioFrameLayout
        android:layout_gravity="center"
        android:id="@+id/aspect_ratio_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/teaser_blurred_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:emptyImagePlaceholder="@drawable/default_placeholder"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="40dp"
            android:paddingVertical="40dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.Text"
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:id="@+id/teaser_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:textAlignment="center"/>
            <com.vk.core.view.components.button.VkButton
                android:layout_gravity="center_horizontal"
                android:id="@+id/teaser_donate_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:buttonAppearance="overlay"
                app:buttonMode="primary"
                app:buttonSizeType="small"/>
        </LinearLayout>
    </com.vk.core.tool.view.AspectRatioFrameLayout>
</com.vk.feed.tool.view.newsfeed.attach.PrimaryAttachmentLayout>
