<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#535659"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="1px"
        android:layout_height="1px"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/avatar_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.voip.ui.view.VideoView
        android:id="@+id/speaker_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/scrim"
        android:background="@drawable/scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0.48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.voip.ui.avatars.VoipAvatarViewContainer
        android:id="@+id/avatar_image"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:contentDescription="@null"
        app:emptyImagePlaceholder="@drawable/ic_user_260"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:roundAvatarSize="56dp"/>
    <ImageView
        android:id="@+id/avatar_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_call_badge_26"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/avatar_image"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Михаил"
        android:singleLine="true"
        android:shadowColor="#3d000000"
        android:shadowRadius="12"
        android:fontFamily="@font/vk_roboto_regular"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_image"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/vk_white"
        android:ellipsize="middle"
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="00:56"
        android:singleLine="true"
        android:shadowColor="#3d000000"
        android:shadowRadius="12"
        android:alpha="0.8"
        android:fontFamily="@font/vk_roboto_medium"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:letterSpacing="0.01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ImageView
        android:id="@+id/live"
        android:layout_width="34dp"
        android:layout_height="16dp"
        android:layout_margin="6dp"
        android:src="@drawable/ic_live"
        android:scaleType="center"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.voip.ui.view.VideoView
        android:id="@+id/myself_video"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:elevation="8dp"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.3"/>
    <ImageView
        android:id="@+id/expand"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_fullscreen_outline_shadow_medium_48"
        android:contentDescription="@string/voip_accessibility_full_screen_call"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/reject"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_reject_call_48"
        android:contentDescription="@string/voip_accessibility_reject_call"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
