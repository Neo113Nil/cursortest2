<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_chat_profile_adapter_simple_item__icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_chat_profile_adapter_simple_item__title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_weight="1"
        android:fontFamily="@string/font_family_regular"
        android:layout_marginStart="16dp"/>
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_chat_profile_adapter_simple_item_hint_icon_right"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="24dp"
        app:tint="?attr/vk_ui_accent_blue"/>
</LinearLayout>
