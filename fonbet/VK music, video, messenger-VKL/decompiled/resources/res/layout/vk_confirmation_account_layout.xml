<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/VkIdBottomSheetTheme"
    android:orientation="vertical"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStartWithNavigation="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/vk_auth_accessibility_close"
        app:navigationIcon="@drawable/vk_icon_cancel_outline_28"
        app:titleMarginStart="8dp"/>
    <FrameLayout
        android:id="@+id/verification_account_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/verification_account_primary_button"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <ScrollView
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/verification_account_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center"
                    android:id="@+id/verification_account_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="32dp"
                    app:layout_constraintTop_toBottomOf="@+id/verification_account_icon"
                    style="@style/VkUiTypography.Title2Medium"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:gravity="center"
                    android:id="@+id/verification_account_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="32dp"
                    app:layout_constraintTop_toBottomOf="@+id/verification_account_title"
                    style="@style/VkUiTypography.Headline1Normal"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/verification_account_recycler_view"
                    android:paddingBottom="12dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/verification_account_subtitle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </FrameLayout>
    <Button
        android:textAppearance="@style/VkUiTypography.Headline1"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:id="@+id/verification_account_primary_button"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/verification_account_secondary_button"
        app:layout_goneMarginBottom="16dp"
        style="@style/VKID.View.Button.Primary"/>
    <Button
        android:textAppearance="@style/VkUiTypography.Headline1"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/verification_account_secondary_button"
        android:layout_width="match_parent"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/VKID.View.Button.Secondary"/>
    <FrameLayout
        android:id="@+id/verification_account_progress_bar"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <ProgressBar
            android:layout_gravity="center"
            android:visibility="visible"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/vk_ui_icon_secondary"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
