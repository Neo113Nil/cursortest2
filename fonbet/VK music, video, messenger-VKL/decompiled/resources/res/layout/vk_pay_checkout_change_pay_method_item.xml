<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        layout="@layout/vk_pay_checkout_item_pay_method"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_accent"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/pay_method_confirmation_form_change_method"
        android:text="@string/vk_pay_checkout_method_confirmation_change"
        android:fontFamily="@font/vk_roboto_regular"
        style="@style/VkLegacyButton.Tertiary"/>
</LinearLayout>
