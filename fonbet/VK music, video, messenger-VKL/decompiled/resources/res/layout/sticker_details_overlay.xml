<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/background"
        android:background="?attr/vk_ui_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/sticker_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.vk.stickers.longtap.utils.WrapContentViewPager
                        android:id="@+id/stickers_pager"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:overScrollMode="never"
                        android:importantForAccessibility="no"/>
                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/suggests"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/sticker_details_overlay_accessibility_suggest"
                        android:layout_marginStart="@dimen/sticker_suggest_horizontal_padding"
                        android:layout_marginEnd="@dimen/sticker_suggest_horizontal_padding"
                        app:dividerDrawable="@drawable/shape_suggest_divider"
                        app:flexWrap="wrap"
                        app:justifyContent="center"
                        app:maxLine="2"
                        app:showDivider="middle"/>
                </LinearLayout>
            </FrameLayout>
            <RelativeLayout
                android:id="@+id/similar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <View
                    android:background="?attr/vk_ui_separator_primary"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.FootnoteCapsMedium"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sticker_details_overlay_similar"
                    android:layout_toLeftOf="@+id/similar_show_all"
                    android:layout_alignBaseline="@+id/similar_show_all"
                    android:layout_marginStart="16dp"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="?attr/vk_ui_text_accent"
                    android:id="@+id/similar_show_all"
                    android:background="@drawable/music_selectable_bg"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sticker_details_overlay_similar_show_all"
                    android:layout_marginEnd="4dp"
                    android:layout_alignParentEnd="true"
                    android:letterSpacing="0.01"/>
                <com.vk.lists.RecyclerPaginatedView
                    android:id="@+id/similar_list"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_below="@+id/similar_show_all"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/stickers_longtap_menu"/>
</RelativeLayout>
