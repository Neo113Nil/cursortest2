<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:paddingBottom="48dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/friends_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/vk_icon_illustration_three_people_64h"/>
    <com.vk.im.ui.views.avatars.StackAvatarView
        android:layout_gravity="center"
        android:id="@+id/friends_list"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:contentDescription="@string/vkim_onboarding_friends_list_hint"
        app:vkim_drawingOrder="usual"
        app:vkim_iconOffset="-10dp"
        app:vkim_iconSize="56dp"
        app:vkim_strokeColor="?attr/vk_legacy_background_content"
        app:vkim_strokeWidth="3dp"/>
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vkim_onboarding_friends_title"
        android:fontFamily="@font/vk_roboto_bold"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vkim_onboarding_friends_subtitle"
        android:fontFamily="@font/vk_roboto_regular"
        android:letterSpacing="0.01"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/primary_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/vkim_onboarding_friends_sync_contacts"
        android:fontFamily="@font/vk_roboto_medium"
        style="@style/VkLegacyButton.Primary"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/secondary_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vkim_onboarding_friends_find_friends"
        android:fontFamily="@font/vk_roboto_medium"
        style="@style/VkLegacyButton.Tertiary"/>
</LinearLayout>
