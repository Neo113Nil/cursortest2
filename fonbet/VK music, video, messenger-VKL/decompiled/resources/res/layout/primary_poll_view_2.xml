<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:paddingBottom="8dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/poll_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:roundedCornerRadius="8dp"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/poll_actions"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_actions"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"/>
    <com.vk.feed.design.view.newsfeed.adaptive_discrete_text.VkFeedAdaptiveDiscreteTextView
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/poll_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:maxLines="3"
        android:textAlignment="gravity"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/VkUiTypography.Title2Medium"/>
    <com.vk.core.view.links.LinkedTextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/poll_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:minHeight="18dp"
        android:maxLines="3"
        android:textAlignment="gravity"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <com.vk.newsfeed.common.views.FadingStackLayout
        android:orientation="vertical"
        android:id="@+id/options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/poll_show_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
    <FrameLayout
        android:id="@+id/poll_footer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp">
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="center"
            android:id="@+id/poll_multiple_vote_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp"
            app:buttonAppearance="neutral"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"
            app:text="@string/poll_vote"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/poll_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <com.vk.core.view.components.userstack.VkUserStack
                android:id="@+id/photo_strip_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:id="@+id/votes_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/multiple_progress"
            android:visibility="invisible"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </FrameLayout>
</merge>
