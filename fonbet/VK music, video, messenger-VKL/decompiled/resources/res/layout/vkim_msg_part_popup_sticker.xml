<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.stickers.views.sticker.ImStickerView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/msg_sticker_max_height"
        android:contentDescription="@string/vkim_accessibility_sticker"
        android:layout_marginEnd="36dp"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextContrast"
        android:layout_gravity="end|bottom"
        android:id="@+id/timeAndStatus"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="36dp"/>
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/popupStickerIconContainer"
        android:paddingTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">
        <ImageView
            android:id="@+id/popupStickerIcon"
            android:background="?attr/im_msg_part_time_contrast_bg"
            android:padding="4dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/vk_icon_play_12"
            android:contentDescription="@string/sticker_accessibility_popup_play_button"
            android:importantForAccessibility="no"
            app:tint="@color/vk_white"/>
        <ProgressBar
            android:id="@+id/loader"
            android:background="?attr/im_msg_part_time_contrast_bg"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="4dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/vk_white"
            android:indeterminateTintMode="src_in"
            style="?android:attr/progressBarStyle"/>
    </FrameLayout>
</FrameLayout>
