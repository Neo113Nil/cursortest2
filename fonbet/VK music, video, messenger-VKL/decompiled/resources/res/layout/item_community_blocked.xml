<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_width"
        android:layout_marginHorizontal="16dp"/>
    <com.vk.core.view.components.text.links.VkLinkedText
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="top|center_horizontal"
        android:id="@+id/community_blocked_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:text="@string/community_blocked_text"
        android:paddingHorizontal="32dp"
        style="@style/VkUiTypography.Headline1Normal"/>
</LinearLayout>
