<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/voip_video_preview"
        android:layout_width="136dp"
        android:layout_height="76dp"
        android:layout_marginEnd="12dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="6dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Headline.Regular"
        android:textSize="12sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/voip_video_preview_unavailable_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_watch_together_video_unavailable"
        android:maxLines="3"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/voip_video_preview"
        app:layout_constraintEnd_toEndOf="@+id/voip_video_preview"
        app:layout_constraintStart_toStartOf="@+id/voip_video_preview"
        app:layout_constraintTop_toTopOf="@+id/voip_video_preview"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/voip_unavailable_preview_bg"
        android:layout_width="136dp"
        android:layout_height="76dp"
        android:src="@drawable/voip_unavailable_video_bg"
        app:layout_constraintBottom_toBottomOf="@+id/voip_video_preview"
        app:layout_constraintEnd_toEndOf="@+id/voip_video_preview"
        app:layout_constraintStart_toStartOf="@+id/voip_video_preview"
        app:layout_constraintTop_toTopOf="@+id/voip_video_preview"/>
    <TextView
        android:textColor="@color/vk_gray_100"
        android:id="@+id/voip_video_preview_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/voip_video_preview"
        app:layout_constraintEnd_toEndOf="@+id/voip_video_preview"
        style="@style/VkLegacyTypography.Caption2.Medium"/>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Headline.Regular"
        android:textSize="16sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/voip_video_preview_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/voip_video_preview"
        app:layout_constraintTop_toTopOf="@+id/voip_video_preview"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Caption1.Regular"
        android:textSize="13sp"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/voip_video_preview_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="3sp"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/voip_video_preview_author_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/voip_video_preview"
        app:layout_constraintTop_toBottomOf="@+id/voip_video_preview_title"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/voip_video_preview_author_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="3sp"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/voip_video_preview"
        app:layout_constraintTop_toBottomOf="@+id/voip_video_preview_subtitle"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
