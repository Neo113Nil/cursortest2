<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/user_profile_gift_size"
    android:layout_height="@dimen/user_profile_gift_size">
    <com.vk.stickers.views.gift.GiftView
        android:id="@+id/gift_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/user_profile_accessibility_gift"
        android:layout_marginEnd="4dp"
        app:animationType="secondary"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/votes_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/vk_icon_votes_circle_fill_blue_20"
        android:contentDescription="@null"/>
</FrameLayout>
