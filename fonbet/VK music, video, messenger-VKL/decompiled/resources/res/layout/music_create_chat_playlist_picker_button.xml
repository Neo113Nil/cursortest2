<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight_post"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.music.view.ThumbsImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/tiv_image"
            android:layout_width="@dimen/music_track_image"
            android:layout_height="@dimen/music_track_image"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:roundedCornerRadius="@dimen/music_image_rounding_corners"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_list_add_outline_28"
            app:tiv_empty_tint="?attr/vk_ui_icon_accent"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Text"
            android:textStyle="normal"
            android:textColor="?attr/vk_ui_text_accent"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/music_create_chat_playlist_btn_title"
            android:maxLines="1"
            android:layout_marginStart="13dp"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_marginStart="@dimen/post_side_padding"
        android:layout_marginEnd="@dimen/post_side_padding"/>
</FrameLayout>
