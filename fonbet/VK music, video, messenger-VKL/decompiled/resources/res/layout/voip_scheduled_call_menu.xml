<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:id="@+id/voip_scheduled_menu_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxLines="2"
        android:maxEms="80"
        android:textAllCaps="false"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Caption.Caps.Medium"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_scheduled_menu_time_interval"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:drawablePadding="4dp"
        android:layout_marginHorizontal="20dp"
        app:drawableTint="?attr/vk_ui_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_scheduled_menu_title"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_scheduled_menu_begin_call_item"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voip_scheduled_menu_begin_call"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:drawableStartCompat="@drawable/vk_icon_phone_outline_28"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_scheduled_menu_time_interval"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_scheduled_menu_copy_invite_item"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/voip_scheduled_menu_copy_invate"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:drawableStartCompat="@drawable/vk_icon_article_outline_28"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_scheduled_menu_begin_call_item"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_scheduled_menu_share_item"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/voip_broadcast_share_short"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:drawableStartCompat="@drawable/vk_icon_share_outline_28"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_scheduled_menu_copy_invite_item"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_scheduled_menu_share_qr_item"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/voip_broadcast_share_qr"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:drawableStartCompat="@drawable/vk_icon_qr_code_outline_28"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_scheduled_menu_share_item"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_scheduled_menu_edit_item"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/edit"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:drawableStartCompat="@drawable/vk_icon_edit_outline_28"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_scheduled_menu_share_qr_item"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_scheduled_menu_open_chat_item"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/voip_scheduled_menu_open_chat"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:drawableStartCompat="@drawable/vk_icon_message_arrow_right_outline_28"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_scheduled_menu_edit_item"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_background_negative"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_scheduled_menu_remove_item"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/voip_scheduled_menu_delete"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:drawableStartCompat="@drawable/vk_icon_delete_outline_28"
        app:drawableTint="?attr/vk_ui_background_negative"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_scheduled_menu_open_chat_item"
        style="@style/VkLegacyTypography.Headline.Regular"/>
</merge>
