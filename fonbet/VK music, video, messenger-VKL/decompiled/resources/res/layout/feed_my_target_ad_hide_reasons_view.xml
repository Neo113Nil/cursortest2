<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/hide_reason_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingVertical="24dp">
            <com.vk.core.view.components.placeholder.main.VkPlaceholder
                android:id="@+id/item_ignored_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hide_reasons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/item_ignored_cancel"
            android:paddingLeft="@dimen/vk_ui_button_padding_left"
            android:paddingTop="@dimen/vk_ui_button_padding_top"
            android:paddingRight="@dimen/vk_ui_button_padding_right"
            android:paddingBottom="@dimen/vk_ui_button_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:minHeight="36dp"
            android:singleLine="true"
            android:textAlignment="gravity"
            style="@style/VkUiTypography.Headline2Medium"/>
    </LinearLayout>
</merge>
