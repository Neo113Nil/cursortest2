<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="73dp"
    android:layout_height="73dp"
    android:foreground="@drawable/vk_highlight"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/icon"
        android:layout_width="73dp"
        android:layout_height="73dp"
        android:layout_marginEnd="12dp"
        app:actualImageScaleType="centerCrop"
        app:roundedCornerRadius="12dp"
        app:roundingBorderColor="@color/vk_black_alpha8"
        app:roundingBorderWidth="0.33dp"/>
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/vk_white"
        android:id="@+id/badge"
        android:background="@drawable/shape_vmoji_sticker_pack_badge"
        android:paddingBottom="0.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.5dp"
        android:translationX="-4dp"
        android:fontFamily="sans-serif"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/state"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_margin="6dp"
        android:src="@drawable/vk_icon_crown_16"
        android:contentDescription="@null"
        app:tint="?attr/vk_legacy_dynamic_purple"/>
</FrameLayout>
