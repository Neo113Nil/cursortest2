<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraint_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_vertical"
        android:id="@+id/mark_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineHeight="58sp"
        app:layout_constraintEnd_toEndOf="@+id/rating_view"
        app:layout_constraintStart_toStartOf="@+id/rating_view"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1Normal"/>
    <com.vk.core.view.components.rating.VkStaticRatingBar
        android:layout_gravity="center"
        android:id="@+id/rating_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/mark_description_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mark_tv"
        app:rating_size="small"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/mark_description_tv"
        android:paddingTop="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/rating_view"
        app:layout_constraintStart_toStartOf="@+id/rating_view"
        app:layout_constraintTop_toBottomOf="@+id/rating_view"
        style="@style/VkUiTypography.Footnote"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/dividing_marks_list_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mark_list_r_v"
        android:paddingTop="3dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="2dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/dividing_marks_list_line"
        app:layout_constraintStart_toEndOf="@+id/rating_view"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
