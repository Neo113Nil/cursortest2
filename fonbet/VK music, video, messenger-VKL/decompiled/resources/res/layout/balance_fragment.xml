<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/vk_toolbar_behavior_scrolling">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/votes_about"
                    android:layout_marginStart="@dimen/post_side_padding"
                    android:layout_marginEnd="@dimen/post_side_padding"
                    style="@style/VkUiTypography.Footnote"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/post_side_padding">
                    <TextView
                        android:textColor="@color/vk_ui_text_title_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/votes_your_balance"
                        style="@style/VkUiTypography.Headline1Normal"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <ProgressBar
                        android:id="@+id/progress"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="@dimen/post_side_padding"/>
                    <ImageView
                        android:id="@+id/retry_button"
                        android:background="@drawable/highlight_circle"
                        android:visibility="gone"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerInside"
                        android:layout_marginEnd="@dimen/post_side_padding_small"
                        app:srcCompat="@drawable/vk_icon_refresh_outline_28"
                        app:tint="?attr/vk_ui_icon_accent"/>
                    <TextView
                        android:textColor="?attr/vk_ui_text_secondary"
                        android:id="@+id/balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/post_side_padding"
                        style="@style/VkUiTypography.Headline1Normal"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/buy_btn"
                    android:background="@drawable/highlight"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/post_side_padding"
                    android:paddingEnd="@dimen/post_side_padding">
                    <TextView
                        android:textColor="?attr/vk_ui_text_accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/votes_fill_balance"
                        style="@style/VkUiTypography.Headline1Normal"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/promo_btn"
                    android:background="@drawable/highlight"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/post_side_padding"
                    android:paddingEnd="@dimen/post_side_padding">
                    <TextView
                        android:textColor="?attr/vk_ui_text_accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/votes_activate_code"
                        style="@style/VkUiTypography.Headline1Normal"/>
                </FrameLayout>
                <View
                    android:id="@+id/separator_settings"
                    android:background="?attr/vk_ui_separator_primary"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="9dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/auto_buy_settings_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14.5dp"
                    android:text="@string/vk_balance_settings"
                    android:layout_marginStart="16dp"
                    style="@style/VkUiTypography.FootnoteCapsMedium"/>
                <include
                    android:id="@+id/games_auto_buy_switch_container"
                    layout="@layout/view_settings_switch_with_description"/>
                <include
                    android:id="@+id/mini_apps_auto_buy_switch_container"
                    layout="@layout/view_settings_switch_with_description"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
