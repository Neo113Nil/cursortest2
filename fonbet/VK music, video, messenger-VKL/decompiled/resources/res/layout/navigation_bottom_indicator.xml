<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/indicator_container"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/vk_bottom_navigation_counter_height_outer"
    android:minWidth="@dimen/vk_bottom_navigation_counter_height_outer"
    android:minHeight="@dimen/vk_bottom_navigation_counter_height_outer"
    android:layout_marginStart="2dp">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/dot"
        android:background="@drawable/bottom_navigation_dot_corner"
        android:visibility="gone"
        android:layout_width="@dimen/vk_bottom_navigation_dot_height"
        android:layout_height="@dimen/vk_bottom_navigation_dot_height"
        android:backgroundTint="?attr/vk_ui_accent_red"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:id="@+id/counter"
        android:background="@drawable/bottom_navigation_counter_bg"
        android:paddingLeft="@dimen/vk_bottom_navigation_counter_padding"
        android:paddingRight="@dimen/vk_bottom_navigation_counter_padding"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vk_bottom_navigation_counter_height_outer"
        android:minWidth="@dimen/vk_bottom_navigation_counter_height_outer"
        android:minHeight="@dimen/vk_bottom_navigation_counter_height_outer"
        android:singleLine="true"
        android:backgroundTint="?attr/vk_ui_accent_red"/>
</FrameLayout>
