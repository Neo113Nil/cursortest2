<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1Medium"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vk_auth_create_email_title"
        android:lineSpacingExtra="1sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.ParagraphNormal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vk_auth_create_email_subtitle"
        android:lineSpacingExtra="2sp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/vk_create_email_fragment_input_container"
        android:background="@drawable/vk_auth_bg_edittext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <EditText
            android:id="@+id/vk_create_email_fragment_username"
            android:background="@null"
            android:paddingTop="10.5dp"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/vk_auth_create_email_hint"
            android:lines="1"
            android:layout_weight="1"
            android:inputType="textNoSuggestions"
            android:textCursorDrawable="@drawable/vk_auth_edittext_cursor"
            android:paddingStart="11.5dp"
            android:paddingEnd="11.5dp"
            style="@style/VkAuth.EnterPhoneFragmentField"/>
        <View
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:layout_marginTop="9.5dp"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:id="@+id/vk_create_email_fragment_domain"
            android:paddingTop="10.5dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            style="@style/VkAuth.EnterPhoneFragmentField"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_background_negative"
        android:id="@+id/vk_create_email_fragment_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vk_create_email_fragment_suggests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
</LinearLayout>
