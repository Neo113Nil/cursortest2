<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.RatioFrameLayout
        android:layout_gravity="center"
        android:id="@+id/video_wrap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:orientation="horizontal">
        <com.vk.feed.tool.view.newsfeed.image.FeedFrescoImageView
            android:layout_gravity="center"
            android:id="@+id/video_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/accessibility_video"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/video_play_icon"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.libvideo.design.view.duration.DurationView
            android:layout_gravity="end|bottom"
            android:id="@+id/duration_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"/>
        <com.vk.libvideo.design.view.movika.InteractiveDurationView
            android:layout_gravity="end|bottom"
            android:id="@+id/interactive_duration"
            android:background="@drawable/bg_interactiv_video_duration_label_rounded_4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"/>
        <com.vk.core.view.VideoRestrictionView
            android:id="@+id/media_deprecated_restriction_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.libvideo.design.view.overlay.VideoOverlayView
            android:id="@+id/attach_video_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:vov_size="undefined"/>
        <com.vk.community.design.view.donut.teaser.DonutTeaserView
            android:id="@+id/attach_video_donut_teaser"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.vk.core.tool.view.RatioFrameLayout>
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="5dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="end"
        android:id="@+id/attach_title"
        android:paddingLeft="?attr/attach_left_right_padding"
        android:paddingRight="?attr/attach_left_right_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/post_side_padding"
        android:layout_marginRight="@dimen/post_side_padding"
        android:maxLines="1"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/attach_subtitle"
        android:paddingLeft="?attr/attach_left_right_padding"
        android:paddingRight="?attr/attach_left_right_padding"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/post_side_padding"
        android:layout_marginRight="@dimen/post_side_padding"
        android:maxLines="1"/>
</LinearLayout>
