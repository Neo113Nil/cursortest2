<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/story_service_dialog_root"
    android:background="?attr/vk_ui_overlay_primary"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.stories.tool.view.NoOverlappingRenderingImageView
        android:id="@+id/story_dialog_close"
        android:background="@drawable/white_ripple_unbounded"
        android:padding="9dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="11dp"
        android:src="@drawable/vk_icon_cancel_36"
        android:tint="?attr/vk_ui_icon_accent_themed"
        android:contentDescription="@string/accessibility_close"
        android:layout_marginStart="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.stories.tool.view.NoOverlappingRenderingImageView
        android:id="@+id/story_dialog_done"
        android:background="@drawable/white_ripple_unbounded"
        android:padding="11dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="11dp"
        android:src="@drawable/vk_icon_done_36"
        android:tint="?attr/vk_ui_icon_accent_themed"
        android:contentDescription="@string/accessibility_done"
        android:layout_marginEnd="4dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.stories.design.view.stickers.market.ServiceStickerStyleSwitchingView
        android:id="@+id/service_sticker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="188dp"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/story_dialog_done"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/onboarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/service_sticker"
        app:layout_constraintEnd_toEndOf="@+id/service_sticker"
        app:layout_constraintStart_toStartOf="@+id/service_sticker"
        app:layout_constraintTop_toTopOf="@+id/service_sticker">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/onboarding_animation"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="fitCenter"
            app:lottie_autoPlay="false"
            app:lottie_fileName="tap_fill.json"
            app:lottie_loop="false"/>
        <TextView
            android:textColor="@color/vk_white"
            android:gravity="top|center_horizontal"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/story_service_sticker_switch_onboarding"
            android:textAlignment="center"
            style="@style/VkUiTypography.Caption1"/>
    </LinearLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center_horizontal"
        android:id="@+id/cta_onboarding_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="82dp"
        android:text="@string/story_service_sticker_without_cta_onboarding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkUiTypography.Subhead"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cta_buttons_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textColor="@color/vk_black"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/cta_button"
            android:background="@drawable/bg_rounded_corners_20"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/story_service_sticker_booking_button"
            android:maxLines="1"
            android:layout_weight="1"
            android:backgroundTint="@color/vk_white"
            android:paddingHorizontal="10dp"
            style="@style/VkUiTypography.Headline2"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_message"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/vk_icon_message_outline_24"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="2dp"
            app:tint="@color/vk_white_alpha40"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_share"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/vk_icon_share_outline_24"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="16dp"
            app:tint="@color/vk_white_alpha40"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/bottom_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_change_service"
            android:background="@drawable/white_ripple_unbounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/vk_icon_arrow_2_squarepath_outline_24"
                app:tint="@color/vk_white"/>
            <TextView
                android:textColor="@color/vk_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/story_sticker_change_service"
                style="@style/VkUiTypography.Caption2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_delete_service"
            android:background="@drawable/white_ripple_unbounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:paddingHorizontal="4dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/vk_icon_delete_outline_24"
                app:tint="@color/vk_white"/>
            <TextView
                android:textColor="@color/vk_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/story_delete_service_sticker"
                style="@style/VkUiTypography.Caption2"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
