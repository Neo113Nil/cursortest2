<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/camera_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/vk_ui_spacing_size_xs">
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/camera_photo_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/ds_camera_button_photo_text"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_xs"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="large"
        app:icon="@drawable/vk_icon_camera_outline_24"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/camera_video_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/ds_camera_button_video_text"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="large"
        app:icon="@drawable/vk_icon_videocam_outline_24"/>
</LinearLayout>
