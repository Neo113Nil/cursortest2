<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/vk_ui_background_content"
    app:cardCornerRadius="14dp">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/music_track_menu_tongue"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"/>
    <FrameLayout
        android:id="@+id/progress_container"
        android:layout_width="match_parent"
        android:layout_height="514dp">
        <ProgressBar
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="40dp"
            android:progressTint="@color/vk_ui_icon_medium_tint"
            style="?android:attr/progressBarStyle"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/error_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vkmix_settings_modal_error"
            style="@style/VkUiTypography.Headline1Normal"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="center"
            android:id="@+id/button_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"
            app:text="@string/refresh"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/content_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center"
                android:id="@+id/text_title"
                android:paddingTop="36dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/VkUiTypography.DisplayTitle2"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:id="@+id/text_subtitle"
                android:paddingTop="2dp"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/text_title"
                style="@style/VkUiTypography.FootnoteNormal"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/rv_settings"
                android:paddingTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="32dp"
                app:layoutManager="LinearLayoutManager"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_subtitle"/>
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/button_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="6dp"
                app:buttonAppearance="neutral"
                app:buttonMode="tertiary"
                app:buttonSizeType="large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/button_accept"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_settings"
                app:text="@string/mix_settings_reset"
                app:textColorful="false"/>
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/button_accept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="16dp"
                app:buttonAppearance="neutral"
                app:buttonMode="primary"
                app:buttonSizeType="large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/button_cancel"
                app:layout_constraintTop_toBottomOf="@+id/rv_settings"
                app:text="@string/mix_settings_apply"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
