<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/community_profile_live_cover_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">
    <com.vk.core.tool.view.AspectRatioFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:as_aspect_ratio="0.8">
        <FrameLayout
            android:id="@+id/community_live_cover_pager_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="225dp"
            android:src="@drawable/fg_community_live_cover_scrim"
            android:alpha="0.32"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/community_live_cover_info_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vk_ui_spacing_size2_xl">
            <include
                android:id="@+id/community_avatar_layout"
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toTopOf="@+id/community_live_cover_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                layout="@layout/layout_community_header_avatar"/>
            <com.vk.profile.design.view.ProfileTitleText
                android:textColor="@color/vk_white"
                android:ellipsize="marquee"
                android:id="@+id/community_live_cover_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="2"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="58dp"
                app:layout_constraintBottom_toTopOf="@+id/community_government_verification_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/community_avatar_layout"
                style="@style/VkUiTypography.DisplayTitle2"/>
            <com.vk.profile.community.impl.ui.view.CommunityHeaderContentItemView
                android:id="@+id/community_government_verification_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:layout_constraintBottom_toTopOf="@+id/reviews_ll"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/community_live_cover_title"/>
            <include
                android:id="@+id/reviews_ll"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toTopOf="@+id/liveCoverVerifyBcs"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/community_government_verification_title"
                layout="@layout/layout_community_live_header_reviews"/>
            <include
                android:id="@+id/liveCoverVerifyBcs"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toTopOf="@+id/community_live_cover_action_buttons"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/reviews_ll"
                layout="@layout/layout_community_live_header_verify_bcs"/>
            <include
                android:id="@+id/community_live_cover_action_buttons"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/liveCoverVerifyBcs"
                layout="@layout/item_community_header_action_buttons_view"/>
            <com.vk.core.view.components.badge.VkContentBadge
                android:id="@+id/community_header_age_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginEnd="6dp"
                app:contentBadgeAppearance="overlay"
                app:contentBadgeMode="secondary"
                app:contentBadgeSize="small"
                app:layout_constraintBottom_toBottomOf="@+id/community_avatar_layout"
                app:layout_constraintEnd_toStartOf="@+id/community_header_a_plus"
                app:layout_goneMarginEnd="12dp"/>
            <com.vk.core.view.components.badge.VkContentBadge
                android:id="@+id/community_header_a_plus"
                android:focusable="true"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/profile_aplus_details_title"
                android:layout_marginEnd="12dp"
                app:contentBadgeAppearance="overlay"
                app:contentBadgeMode="secondary"
                app:contentBadgeSize="small"
                app:layout_constraintBottom_toBottomOf="@+id/community_avatar_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:text="@string/profile_a_plus_mark"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.vk.core.tool.view.AspectRatioFrameLayout>
</androidx.cardview.widget.CardView>
