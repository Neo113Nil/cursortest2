<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/vkim_chat_profile_chat_members__rv"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/vkim_chat_profile_chat_members__error_container"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/vkim_chat_profile_chat_members__error_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vk_roboto_regular"
            style="@style/VkIm.Error.LargeText"/>
        <Button
            android:layout_gravity="center_horizontal"
            android:id="@+id/vkim_chat_profile_chat_members__error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vkim_retry"
            style="@style/VkIm.Error.LargeButton"/>
    </LinearLayout>
    <com.pnikosis.materialishprogress.ProgressWheel
        android:layout_gravity="center"
        android:id="@+id/vkim_chat_profile_chat_members__progress"
        android:visibility="visible"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:matProg_barColor="@color/vk_blue_300"
        app:matProg_progressIndeterminate="true"/>
</FrameLayout>
