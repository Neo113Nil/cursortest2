<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/section_poster_layout"
    android:paddingTop="12dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            style="@style/VkUiTypography.Title2Medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/step_ahead_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:layout_marginStart="12dp"
            android:translationZ="10dp"/>
    </LinearLayout>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/poster_image"
        android:background="@drawable/vk_bg_tile_radius_12"
        android:padding="0.33dp"
        android:layout_width="match_parent"
        android:layout_height="454dp"
        android:layout_marginTop="10dp"/>
    <FrameLayout
        android:id="@+id/bottom_content_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
