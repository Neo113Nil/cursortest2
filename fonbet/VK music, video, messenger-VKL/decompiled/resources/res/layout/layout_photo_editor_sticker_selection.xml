<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_peekHeight="@dimen/editor_selection_peek_height"
        app:layout_behavior="com.vk.attachpicker.stickers.selection.PhotoEditorSelectionBottomSheetBehavior">
        <FrameLayout
            android:id="@+id/main_content"
            android:background="@drawable/bg_editor_selection_content"
            android:paddingTop="@dimen/editor_selection_main_content_top_padding"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0">
            <FrameLayout
                android:id="@+id/list_container"
                android:paddingBottom="@dimen/picker_tabs_container_height"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/editor_selection_list_content_top_padding">
                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/vp_pager"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.vk.lists.RecyclerPaginatedView
                    android:id="@+id/rv_search"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nestedScrollingEnabled="true"/>
            </FrameLayout>
            <com.vk.core.view.components.search.VkSearchView
                android:id="@+id/search_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/editor_selection_search_view_height"
                android:layout_marginVertical="@dimen/editor_selection_search_vertical_margin"/>
        </FrameLayout>
        <View
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/view_header_handle"
            android:background="@drawable/bg_editor_selection_handle"
            android:layout_width="@dimen/editor_selection_handle_width"
            android:layout_height="@dimen/editor_selection_handle_height"
            android:layout_marginTop="@dimen/editor_selection_handle_top_margin"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fl_tabs_container"
        android:background="@drawable/bg_editor_selection_tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/picker_tabs_container_height"
        android:layout_marginHorizontal="@dimen/editor_selection_tabs_horizontal_margin"/>
</merge>
