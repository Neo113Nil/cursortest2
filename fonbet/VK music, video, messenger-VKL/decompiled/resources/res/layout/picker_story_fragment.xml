<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_legacy_background_content"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/growing_circle"
        android:background="@drawable/picker_btn_light_blue_circle"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/steady_circle"
        android:background="@drawable/picker_btn_blue_circle"
        android:padding="18dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/picker_take_story"
        app:srcCompat="@drawable/vk_icon_story_28"
        app:tint="@color/vk_white"/>
</FrameLayout>
