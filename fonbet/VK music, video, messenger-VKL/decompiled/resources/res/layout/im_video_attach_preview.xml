<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="136dp"
    android:layout_height="76dp">
    <com.vk.core.view.image.VkEnhancedImageView
        android:id="@+id/image"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:ev_emptyPlaceholder="@drawable/ic_videos_placeholder"
        app:ev_imageScaleType="center_crop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholder="@drawable/default_placeholder_2"/>
    <FrameLayout
        android:id="@+id/history_attach_video_restriction_container"
        android:layout_width="136dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/image_barrier"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:barrierDirection="end"
        app:constraint_referenced_ids="image,history_attach_video_restriction_container"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/duration"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_barrier"
        app:layout_constraintEnd_toStartOf="@+id/image_barrier"/>
    <com.vk.libvideo.design.view.movika.InteractiveDurationView
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/interactive_duration"
        android:background="@drawable/bg_video_duration_label_rounded_4"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_barrier"
        app:layout_constraintEnd_toStartOf="@+id/image_barrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
