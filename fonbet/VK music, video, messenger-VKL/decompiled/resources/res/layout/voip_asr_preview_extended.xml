<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/content"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/asr_stop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/avatar_border"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_live_border_active_32"
                android:importantForAccessibility="no"/>
            <com.vk.core.view.ColorProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress_icon"
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminate="true"
                android:color="@color/vk_white"
                android:importantForAccessibility="no"/>
            <com.vk.im.ui.views.avatars.AvatarView
                android:layout_gravity="center"
                android:id="@+id/avatar_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
        </FrameLayout>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/asr_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            style="@style/VoipRunningTaskLabel.Title"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_gray_100"
        android:gravity="center"
        android:id="@+id/asr_stop"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/voip_asr_preview_stop"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkRobotoRegularStyle.Title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
