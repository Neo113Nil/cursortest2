<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="16dp"
    android:layout_width="315dp"
    android:layout_height="120dp"
    android:paddingHorizontal="16dp">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/catalog_placeholder_view_title"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Headline1Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/catalog_placeholder_view_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="4"
        android:letterSpacing="-0.007"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/catalog_placeholder_view_title"
        style="@style/VkUiTypography.ParagraphNormal"/>
    <ImageView
        android:id="@+id/dismiss_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="11dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_hide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_24"
        app:tint="@color/vk_ui_icon_medium_tint"/>
</androidx.constraintlayout.widget.ConstraintLayout>
