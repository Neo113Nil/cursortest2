<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/post_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size2_xl"
        android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
        app:buttonMode="secondary"/>
    <LinearLayout
        android:id="@+id/redesign_counters_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size2_xl"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/first_counter_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/second_counter_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"/>
    </LinearLayout>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/unpublished_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_xl"
        android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"/>
</LinearLayout>
