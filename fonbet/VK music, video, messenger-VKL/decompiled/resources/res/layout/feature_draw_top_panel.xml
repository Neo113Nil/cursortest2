<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="?attr/editorBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:animateLayoutChanges="true">
    <ImageButton
        android:id="@+id/button_draw_undo"
        android:background="@drawable/ripple_50dp"
        android:clickable="false"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_arrow_uturn_left"
        android:contentDescription="@string/editor_undo"
        app:layout_constraintBottom_toBottomOf="parent"
        style="?attr/editorButtonPrimaryStyle"/>
    <ImageButton
        android:id="@+id/button_draw_redo"
        android:background="@drawable/ripple_50dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_arrow_uturn_right"
        android:contentDescription="@string/editor_redo"
        style="?attr/editorButtonPrimaryStyle"/>
</LinearLayout>
