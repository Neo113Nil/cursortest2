<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerInfo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.music.view.ThumbsImageView
            android:id="@+id/snippet_playlist_thumb"
            android:background="@drawable/music_snippet_skeleton_10dp"
            android:layout_width="@dimen/music_snippet_playlist_thumb_size"
            android:layout_height="@dimen/music_snippet_playlist_thumb_size"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/snippet_playlist_name"
            android:background="@drawable/music_snippet_skeleton_10dp"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/snippet_playlist_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/snippet_playlist_thumb"
            app:layout_constraintTop_toTopOf="@+id/snippet_playlist_thumb"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:layout_constraintWidth_percent="0.53"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/snippet_playlist_description"
            android:background="@drawable/music_snippet_skeleton_10dp"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/snippet_playlist_thumb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/snippet_playlist_name"
            app:layout_constraintTop_toBottomOf="@+id/snippet_playlist_name"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintWidth_percent="0.1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.core.view.shimmer.ShimmerFrameLayout>
