<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:foreground="@drawable/geo_map_foreground"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <com.vk.core.view.StaticMapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            app:smv_cornerRadius="4dp"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
            android:textColor="@color/vk_gray_800"
            android:gravity="start|center_vertical"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/distance"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:singleLine="true"
            android:drawablePadding="3dp"
            android:paddingStart="20dp"
            android:paddingEnd="28dp"
            app:drawableStartCompat="@drawable/vk_icon_deprecated_ic_directions_walk_24"
            app:drawableTint="@color/vk_gray_800"/>
    </FrameLayout>
    <com.vk.core.view.components.cell.VkMiniInfoCell
        android:id="@+id/address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
</LinearLayout>
