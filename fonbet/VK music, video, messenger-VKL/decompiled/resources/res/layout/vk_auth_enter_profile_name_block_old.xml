<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/name_and_avatar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="24dp"
    android:layout_marginRight="16dp">
    <com.vk.core.ui.themes.VKReplacerView
        android:id="@+id/avatar"
        android:background="@drawable/vk_auth_bg_choose_avatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/vk_auth_accessibility_avatar_choose"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/layout_first_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.auth.ui.VkAuthExtendedEditText
        android:id="@+id/layout_first_name"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="-0.25dp"
        android:hint="@string/vk_auth_sign_up_first_name"
        android:layout_weight="1"
        app:is_clearable="true"
        app:layout_constraintBottom_toTopOf="@+id/layout_last_name"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:vk_error_stated_edit_text_id="@+id/first_name"
        style="@style/VkAuth.EditText.Combined.Top"/>
    <com.vk.auth.ui.VkAuthExtendedEditText
        android:id="@+id/layout_last_name"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="-0.25dp"
        android:hint="@string/vk_auth_sign_up_last_name"
        android:layout_weight="1"
        app:is_clearable="true"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_first_name"
        app:vk_error_stated_edit_text_id="@+id/last_name"
        style="@style/VkAuth.EditText.Combined.Bottom"/>
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/layout_last_name"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_first_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
