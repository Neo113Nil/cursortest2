<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/snippet_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/snippet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/snippet_sign"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/snippet_sign"
        style="@style/VkUiTypography.DisplayTitle1SemiBold"/>
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/snippet_sign"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/android_4_fix"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/snippet_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/snippet_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/snippet_title"
        app:layout_constraintTop_toBottomOf="@+id/snippet_sign"
        style="@style/VkUiTypography.TextNormal"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="0dp"
        android:layout_height="172dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/vk_ui_background_tertiary"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/snippet_subtitle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.music.view.ThumbsImageView
                android:id="@+id/center_album_cover"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginBottom="-12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:roundedCornerRadius="@dimen/music_image_corners_12"
                app:tiv_background_image="?attr/vk_ui_image_placeholder"
                app:tiv_border_width="0.38dp"
                app:tiv_empty_resource="@drawable/vk_icon_song_outline_56"
                app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
            <com.vk.music.view.ThumbsImageView
                android:id="@+id/right_album_cover"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="-12dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/center_album_cover"
                app:roundedCornerRadius="@dimen/music_image_corners_12"
                app:tiv_background_image="?attr/vk_ui_image_placeholder"
                app:tiv_border_width="0.38dp"
                app:tiv_empty_resource="@drawable/vk_icon_song_outline_56"
                app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
            <com.vk.music.view.ThumbsImageView
                android:id="@+id/left_album_cover"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="-12dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/center_album_cover"
                app:roundedCornerRadius="@dimen/music_image_corners_12"
                app:tiv_background_image="?attr/vk_ui_image_placeholder"
                app:tiv_border_width="0.38dp"
                app:tiv_empty_resource="@drawable/vk_icon_song_outline_56"
                app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
            <ImageView
                android:id="@+id/bg_snippet_gradient"
                android:layout_width="match_parent"
                android:layout_height="61dp"
                android:importantForAccessibility="no"
                android:elevation="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/listen_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/vk_run_music_play"
                android:elevation="3dp"
                app:buttonAppearance="overlay"
                app:buttonMode="primary"
                app:buttonSizeType="medium"
                app:icon="@drawable/vk_icon_play_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
