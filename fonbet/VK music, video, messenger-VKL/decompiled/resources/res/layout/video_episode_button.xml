<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/vk_white_alpha60"
        android:ellipsize="end"
        android:id="@+id/episode_name"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/episode_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:textColor="@color/vk_white_alpha40"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/episode_count"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:drawablePadding="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        app:drawableEndCompat="@drawable/vk_icon_chevron_right_20"
        app:drawableTint="@color/vk_white_alpha40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/episode_name"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Footnote"/>
</merge>
