<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/story_dialog_background"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/done_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/sticker_creation_done_button"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="overlay"
        app:buttonMode="link"
        app:buttonSizeType="large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle4"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/edit_text_container"
        android:background="@drawable/sticker_dark_bg_rounded_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/hashtag_icon"
            android:layout_width="@dimen/sticker_icon_size"
            android:layout_height="@dimen/sticker_icon_size"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/sticker_icon_margin_start"
            app:srcCompat="@drawable/vk_icon_hashtag_16"
            app:tint="?attr/vk_ui_icon_contrast"/>
        <com.vk.camera.drawing.gradient.StoryEditText
            android:textColor="?attr/vk_ui_text_contrast_themed"
            android:ellipsize="end"
            android:id="@+id/hashtag_edit_view"
            android:background="@null"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="5dp"
            android:hint="@string/sticker_hashtag_hint"
            android:maxLines="1"
            android:lines="1"
            android:maxLength="50"
            android:lineSpacingExtra="3sp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:alpha="0.4"
            android:paddingStart="1dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="14dp"
            style="@style/VkUiTypography.DisplayTitle4SemiBold"/>
    </LinearLayout>
    <com.vk.stories.design.view.HashtagHintsView
        android:id="@+id/hashtags_hints_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.vk.stories.design.view.PrivacyHintView
        android:id="@+id/hashtag_dialog_privacy_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
