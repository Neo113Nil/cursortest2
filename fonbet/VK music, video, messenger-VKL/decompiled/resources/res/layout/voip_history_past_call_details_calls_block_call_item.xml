<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_highlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/past_call_details_calls_block_call_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/past_call_details_calls_block_call_state"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/past_call_details_calls_block_call_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:maxLines="1"
        android:layout_marginStart="78dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/past_call_details_calls_block_call_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Subhead1.Medium"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/past_call_details_calls_block_call_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:constraint_referenced_ids="past_call_details_calls_block_call_duration,past_call_details_calls_block_call_chevron"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/past_call_details_calls_block_call_duration"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
    <ImageView
        android:id="@+id/past_call_details_calls_block_call_chevron"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="16dp"
        android:src="@drawable/vk_icon_chevron_16"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
