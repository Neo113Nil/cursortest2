<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/dismiss_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/vk_icon_dismiss_dark_24"
        android:contentDescription="@string/accessibility_dismiss"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/collapsed_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <include layout="@layout/offline_mode_message"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:gravity="center"
            android:id="@+id/collapsed_primary_button"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/video_open_catalog_short"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"
            app:buttonSizeType="large"/>
    </LinearLayout>
    <include
        android:id="@+id/expanded_container"
        layout="@layout/offline_placeholder_view"/>
</FrameLayout>
