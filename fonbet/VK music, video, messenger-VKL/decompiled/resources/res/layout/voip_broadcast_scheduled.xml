<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/vk_icon_cancel_outline_28"
        app:title="@string/voip_broadcast_scheduled_title"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:titleTextColor="?attr/vk_ui_text_primary"/>
    <View
        android:id="@+id/actions_section_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/description"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voip_broadcast_scheduled_description"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:letterSpacing="0.02"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actions_section_divider"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/close_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:layout_constraintVertical_bias="0"/>
    <FrameLayout
        android:id="@+id/close_container"
        android:background="?attr/vk_ui_background_modal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <Button
            android:textSize="16sp"
            android:textColor="@color/vk_gray_800"
            android:gravity="center"
            android:id="@+id/close"
            android:background="@drawable/bg_rounded_8"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/save"
            android:includeFontPadding="false"
            android:fontFamily="@font/vk_roboto_medium"
            android:backgroundTint="@color/vk_white"
            android:letterSpacing="0.01"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
