<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <FrameLayout
        android:id="@+id/top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/top_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.ui.themes.VKReplacerView
            android:layout_gravity="center"
            android:id="@+id/top_picture_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.ui.themes.VKReplacerView
            android:layout_gravity="center"
            android:id="@+id/top_avatar_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.ui.themes.VKReplacerView
            android:layout_gravity="center"
            android:id="@+id/top_image_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/vk_ui_spacing_size2_xl">
        <TextView
            android:textAppearance="?attr/vk_ui_typography_title2_medium"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/main_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"/>
        <TextView
            android:textAppearance="?attr/vk_ui_typography_paragraph"
            android:textColor="?attr/vk_ui_text_subhead"
            android:id="@+id/main_description"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/bottom_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttons"
        android:paddingTop="@dimen/vk_ui_spacing_size3_xl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/button_first"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/button_second"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
