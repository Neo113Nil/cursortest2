<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/outer_header_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_scrollFlags="snap|enterAlways|scroll">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/background_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/catalog_video_header_height"
        android:paddingStart="@dimen/catalog_video_header_padding"
        android:paddingEnd="@dimen/catalog_video_header_padding">
        <ImageView
            android:id="@+id/navigation_icon"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/logo"
            android:background="@drawable/highlight_unbounded"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/title"
            app:layout_constraintStart_toEndOf="@+id/navigation_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="10dp"
            app:srcCompat="@drawable/vk_icon_logo_vk_video_color_28"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/video_catalog_header"
            android:textDirection="locale"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cast_button"
            app:layout_constraintStart_toEndOf="@+id/logo"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.DisplayTitle2"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/cast_button"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/video_start_video_cast"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/first_button"
            app:layout_constraintStart_toEndOf="@+id/title"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/first_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/search_button"
            app:layout_constraintStart_toEndOf="@+id/cast_button"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/add_button"
                android:background="@drawable/highlight_unbounded"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/add"
                app:srcCompat="@drawable/vk_icon_add_outline_28"
                app:tint="?attr/vk_ui_icon_accent_themed"/>
            <include
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/catalog_vk_video_notifications_container"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/search_button"
            android:background="@drawable/highlight_unbounded"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/settings_button"
            app:layout_constraintStart_toEndOf="@+id/add_button"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_search_outline_28"/>
        <ImageView
            android:id="@+id/settings_button"
            android:background="@drawable/highlight_unbounded"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/accessibility_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_settings_outline_28"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
