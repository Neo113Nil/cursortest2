<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="52dp"
    android:layout_height="52dp">
    <View
        android:layout_gravity="center"
        android:id="@+id/accent_color_item_selected_stroke"
        android:background="@drawable/accent_color_item_selected_stroke"
        android:layout_width="48dp"
        android:layout_height="48dp"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/accent_color_item_selected_outline"
        android:background="@drawable/accent_color_item_selected_outline"
        android:layout_width="44dp"
        android:layout_height="44dp"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/accent_color_item"
        android:background="@drawable/accent_color_item"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
</FrameLayout>
