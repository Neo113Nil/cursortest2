<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/photoflow_modal_background_12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.content.design.view.photo.flow.PhotoFlowToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"/>
    <ScrollView
        android:id="@+id/linear_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/VkUiTypography.Subhead"
                    android:textColor="?attr/vk_ui_text_subhead"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/create_album_title"
                    android:layout_weight="1"
                    android:translationY="-0.8sp"
                    app:lineHeight="18sp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Footnote"
                    android:textColor="?attr/vk_ui_text_tertiary"
                    android:gravity="top"
                    android:id="@+id/title_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:translationY="-0.38sp"
                    app:lineHeight="16sp"/>
            </LinearLayout>
            <com.vk.core.view.components.formitem.VkInputSelect
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/create_album_name_hint"
                android:maxLength="128"
                android:inputType="textCapSentences"
                style="@style/VkInput"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/description_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp">
                    <TextView
                        android:textColor="?attr/vk_ui_text_subhead"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/create_album_description"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2sp"
                        android:translationY="-0.8sp"
                        style="@style/VkUiTypography.SubheadNormal"/>
                    <TextView
                        android:textColor="?attr/vk_ui_text_tertiary"
                        android:gravity="top"
                        android:id="@+id/description_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="1sp"
                        android:translationY="-0.38sp"
                        style="@style/VkUiTypography.SubheadNormal"/>
                </LinearLayout>
                <com.vk.core.view.components.formitem.VkInputSelect
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/create_album_description_hint"
                    android:minLines="2"
                    android:maxLength="512"
                    app:inputSize="textArea"
                    style="@style/VkInput"/>
            </LinearLayout>
            <TextView
                android:textAppearance="@style/VkUiTypography.HeadlineSemiBold"
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="@string/create_album_privacy_group"
                android:translationY="-0.62sp"
                app:lineHeight="20sp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/album_privacy"
                android:background="@drawable/highlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="26dp">
                    <TextView
                        android:textAppearance="@style/VkUiTypography.HeadlineNormal"
                        android:textColor="?attr/vk_ui_text_primary"
                        android:gravity="top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/create_album_privacy"
                        android:translationY="-0.62sp"
                        app:lineHeight="20sp"/>
                    <TextView
                        android:textAppearance="@style/VkUiTypography.Footnote"
                        android:textColor="?attr/vk_ui_text_secondary"
                        android:gravity="top"
                        android:id="@+id/album_privacy_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/privacy_all"
                        android:translationY="-0.25sp"
                        app:lineHeight="16sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/vk_icon_chevron_compact_right_24"
                    android:contentDescription="@null"
                    app:tint="?attr/vk_ui_icon_tertiary"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/album_privacy_comment"
                android:background="@drawable/highlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="26dp">
                    <TextView
                        android:textAppearance="@style/VkUiTypography.HeadlineNormal"
                        android:textColor="?attr/vk_ui_text_primary"
                        android:gravity="top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/create_album_privacy_comments"
                        android:translationY="-0.62sp"
                        app:lineHeight="20sp"/>
                    <TextView
                        android:textColor="?attr/vk_ui_text_secondary"
                        android:gravity="top"
                        android:id="@+id/album_privacy_comment_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/privacy_all"
                        android:lineSpacingExtra="1sp"
                        android:translationY="-0.25sp"
                        style="@style/VkUiTypography.FootnoteNormal"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/vk_icon_chevron_compact_right_24"
                    android:contentDescription="@null"
                    app:tint="?attr/vk_ui_icon_tertiary"/>
            </LinearLayout>
            <TextView
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/create_album_privacy_note"
                android:translationY="-0.38sp"
                app:lineHeight="16sp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.HeadlineNormal"
                android:textColor="?attr/vk_ui_text_negative"
                android:id="@+id/remove_album"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="38dp"
                android:text="@string/delete_album"
                android:translationY="-0.62sp"
                app:lineHeight="20sp"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_loading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/vk_ui_icon_tertiary"
            android:indeterminateTintMode="src_in"/>
    </FrameLayout>
</LinearLayout>
