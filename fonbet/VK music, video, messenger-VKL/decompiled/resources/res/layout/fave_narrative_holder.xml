<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="84dp">
    <com.vk.narratives.core.NarrativeCoverView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/cover"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="100dp"
        android:layout_marginEnd="40dp">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:singleLine="true"
            style="@style/VkUiTypography.Headline1Normal.Unscaled"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/owner_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/tag_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="5dp"
                app:srcCompat="@drawable/vk_icon_tag_12"
                app:tint="@color/vk_gray_300"/>
            <com.vk.core.ui.fave.FaveTagViewGroup
                android:id="@+id/ft_tag_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginStart="2dp"
                app:horizontalSpacing="0dp"
                app:separatorTextColor="?attr/vk_ui_text_secondary"
                app:singleLineMode="true"
                app:tagFontFamily="@string/font_family_regular"
                app:tagHorizontalPadding="2dp"
                app:tagLineSpacingExtra="5dp"
                app:tagTextColor="?attr/vk_ui_text_secondary"
                app:tagTextSize="13dp"
                app:tagVerticalPadding="1dp"
                app:verticalSpacing="0dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/iv_actions"
        android:background="@drawable/highlight_unlimited"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_actions"
        android:layout_marginEnd="4dp"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="@color/fave_action_gray"/>
</FrameLayout>
