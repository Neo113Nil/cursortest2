<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/loading_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <View
        android:id="@+id/overlay"
        android:background="@color/vk_black_alpha24"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_gravity="center"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="48dp"
            android:indeterminate="true"
            app:indicatorColor="?attr/vk_ui_icon_tertiary_alpha"
            app:indicatorSize="48dp"
            app:trackCornerRadius="3dp"
            app:trackThickness="3dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/loading_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/story_verticalization_loading_title_1"
            android:layout_marginHorizontal="16dp"
            style="@style/VkUiTypography.Title2Medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary_alpha"
            android:gravity="center"
            android:id="@+id/loading_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/story_verticalization_loading_subtitle"
            android:layout_marginHorizontal="32dp"
            style="@style/VkUiTypography.Headline1Normal"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="center"
            android:id="@+id/loading_button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="48dp"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"
            app:buttonSizeType="medium"
            app:text="@string/story_verticalization_loading_button_cancel"/>
    </LinearLayout>
</merge>
