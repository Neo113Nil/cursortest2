<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="2dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingEnd="12dp">
    <com.vk.im.ui.views.avatars.ImAvatarView
        android:id="@+id/vkim_avatar"
        android:layout_width="@dimen/vkim_msg_search_avatar_container_size"
        android:layout_height="@dimen/vkim_msg_search_avatar_container_size"
        android:contentDescription="@string/vkim_accessibility_avatar_chat"
        style="@style/VkIm.AvatarView"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="72dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="17sp"
                android:textColor="?attr/vk_legacy_text_primary"
                android:ellipsize="end"
                android:id="@+id/vkim_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:lines="1"
                android:layout_weight="1"
                android:fontFamily="@font/vk_roboto_medium"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/casper_icon"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginStart="4dp"
                app:srcCompat="@drawable/vk_icon_ghost_16"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/vk_legacy_text_subhead"
                android:gravity="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/vkim_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/vk_legacy_text_placeholder"
            android:id="@+id/vkim_fwd_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:lines="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/vkim_fwd_divider"
                android:background="@drawable/vkim_fwd_divider"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="?attr/vk_legacy_text_primary"
                android:ellipsize="end"
                android:id="@+id/vkim_msg_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
