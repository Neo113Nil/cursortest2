<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight">
    <TextView
        android:id="@+id/voip_active_video_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_watch_video_title_playing_now"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Headline.Medium"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/voip_video_preview"
        android:layout_width="136dp"
        android:layout_height="76dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_active_video_title"
        app:layout_goneMarginTop="4dp"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="6dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <TextView
        android:id="@+id/voip_video_preview_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/voip_video_preview"
        app:layout_constraintEnd_toEndOf="@+id/voip_video_preview"
        style="@style/VkLegacyTypography.Caption2.Medium"/>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Headline.Regular"
        android:ellipsize="end"
        android:id="@+id/voip_video_preview_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_video_preview_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/voip_video_preview"
        app:layout_constraintTop_toTopOf="@+id/voip_video_preview"
        app:layout_constraintVertical_chainStyle="spread"/>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Caption1.Regular"
        android:ellipsize="end"
        android:id="@+id/voip_video_preview_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_video_preview_author_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/voip_video_preview"
        app:layout_constraintTop_toBottomOf="@+id/voip_video_preview_title"
        app:layout_constraintVertical_chainStyle="spread"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/voip_video_preview_author_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/voip_video_preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/voip_video_preview"
        app:layout_constraintTop_toBottomOf="@+id/voip_video_preview_subtitle"
        app:layout_constraintVertical_chainStyle="spread"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
    <TextView
        android:id="@+id/voip_active_video_stop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="44dp"
        android:text="@string/voip_watch_video_action_stop"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_video_preview"
        style="@style/VkLegacyButton.Primary.Big"/>
</merge>
