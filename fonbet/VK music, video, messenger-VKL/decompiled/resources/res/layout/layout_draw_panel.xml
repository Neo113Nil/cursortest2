<?xml version="1.0" encoding="utf-8"?>
<com.vk.stories.tool.view.NoOverlappingRenderingFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/fl_draw_panel"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="130dp">
    <com.vk.stories.tool.view.NoOverlappingRenderingFrameLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="96dp">
        <com.vk.attachpicker.widget.ColorSelectorView
            android:layout_gravity="end|top"
            android:id="@+id/ccv_drawing_color_selector"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            app:innerMarginLeft="48dp"
            app:whiteBorder="true"/>
        <ImageView
            android:layout_gravity="start|top"
            android:id="@+id/iv_drawing_width"
            android:background="@drawable/white_ripple_unbounded"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/vk_icon_lines_shadow_large_48"
            android:scaleType="centerInside"
            android:contentDescription="@string/story_accessibility_drawing_width"
            app:tint="@color/vk_white"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/fl_draw_nav_panel"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/iv_cancel"
                android:background="@drawable/white_ripple_unbounded"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/accessibility_close"
                android:layout_marginStart="8dp"
                app:srcCompat="@drawable/vk_icon_cancel_outline_28"
                app:tint="?attr/vk_ui_icon_medium"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/iv_apply"
                android:background="@drawable/white_ripple_unbounded"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/accessibility_done"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/vk_icon_done_outline_28"
                app:tint="?attr/vk_ui_icon_accent"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <com.vk.camera.editor.stories.impl.view.BrushSelectorView
                    android:id="@+id/bsv_pen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/story_accessibility_pen"
                    app:brush_bottomDrawable="@drawable/pen_round_chrome_48"
                    app:brush_topDrawable="@drawable/pen_round_color_48"
                    app:brush_topWhiteDrawable="@drawable/pen_round_color_white_48"/>
                <com.vk.camera.editor.stories.impl.view.BrushSelectorView
                    android:id="@+id/bsv_marker"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/story_accessibility_marker"
                    app:brush_bottomDrawable="@drawable/pen_marker_chrome_48"
                    app:brush_topDrawable="@drawable/pen_marker_color_48"
                    app:brush_topWhiteDrawable="@drawable/pen_marker_color_white_48"/>
                <com.vk.camera.editor.stories.impl.view.BrushSelectorView
                    android:id="@+id/bsv_neon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/story_accessibility_neon"
                    app:brush_bottomDrawable="@drawable/vk_icon_deprecated_pen_glow_chrome_48"
                    app:brush_topDrawable="@drawable/pen_glow_color_48"
                    app:brush_topWhiteDrawable="@drawable/pen_glow_color_white_48"/>
            </LinearLayout>
        </FrameLayout>
    </com.vk.stories.tool.view.NoOverlappingRenderingFrameLayout>
</com.vk.stories.tool.view.NoOverlappingRenderingFrameLayout>
