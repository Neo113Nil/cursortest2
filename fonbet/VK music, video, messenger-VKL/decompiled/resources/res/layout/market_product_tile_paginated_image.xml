<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/ecomm_ds_internal_bg_tile">
    <com.vk.core.view.components.picture.VkPicture
        android:id="@+id/iv_main_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backgroundImage="?attr/vk_ui_image_placeholder"
        app:placeholderImage="@drawable/vk_icon_gallery_outline_56"
        app:placeholderImageScaleType="centerInside"
        app:viewAspectRatio="0.8317"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@+id/iv_moderation_icon"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/vk_icon_hide_outline_shadow_medium_48"/>
</FrameLayout>
