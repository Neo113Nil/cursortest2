<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:background="?attr/vk_ui_background_content"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:paddingHorizontal="16dp">
    <View
        android:id="@+id/clips_trending_hashtags_landing_separator"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <com.vk.core.view.components.text.links.VkLinkedText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/clips_trending_hashtags_landing_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="5dp"
        style="@style/VkUiTypography.Footnote"/>
</FrameLayout>
