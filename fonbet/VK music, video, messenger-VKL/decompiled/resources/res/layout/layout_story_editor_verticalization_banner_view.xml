<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/gradient_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="300dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/banner"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/story_verticalization_banner_text_first"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Headline1Normal"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/banner_button_accept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="4dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="small"
            app:layout_constraintEnd_toStartOf="@+id/banner_button_dismiss"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/banner_title"
            app:text="@string/story_verticalization_banner_button_accept_first"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/banner_button_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="4dp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/banner_button_accept"
            app:layout_constraintTop_toBottomOf="@+id/banner_title"
            app:text="@string/story_verticalization_banner_button_dismiss"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
