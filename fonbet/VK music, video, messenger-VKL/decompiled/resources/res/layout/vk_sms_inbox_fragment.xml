<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:id="@+id/vk_sms_inbox_total_progress"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/vk_ui_icon_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/vk_sms_inbox_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/vk_sms_inbox_send_sms_title"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle2SemiBold"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/vk_sms_inbox_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vk_sms_inbox_send_sms_subtitle"
        android:layout_marginHorizontal="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_sms_inbox_title"
        style="@style/VkUiTypography.TextNormal"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:id="@+id/vk_sms_inbox_send_sms_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_sms_inbox_send_sms_button"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toTopOf="@+id/vk_sms_inbox_confirm_another_way_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="16dp"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/vk_sms_inbox_confirm_another_way_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_sms_inbox_confirm_another_way_button"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toTopOf="@+id/vk_sms_inbox_pricing_warning"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_tertiary"
        android:gravity="center"
        android:id="@+id/vk_sms_inbox_pricing_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/vk_sms_inbox_pricing_warning"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkUiTypography.Caption2Normal"/>
    <com.vk.core.view.components.spinner.VkSpinner
        android:layout_gravity="center"
        android:id="@+id/vk_sms_inbox_spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="?attr/vk_ui_icon_medium"
        app:layout_constraintBottom_toTopOf="@+id/vk_sms_inbox_progress_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35"
        app:layout_constraintVertical_chainStyle="packed"
        app:spinnerSize="large"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/vk_sms_inbox_progress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vk_sms_inbox_progress_title"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/vk_sms_inbox_progress_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_sms_inbox_spinner"
        style="@style/VkUiTypography.DisplayTitle2SemiBold"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/vk_sms_inbox_progress_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vk_sms_inbox_progress_subtitle"
        android:layout_marginHorizontal="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_sms_inbox_progress_title"
        style="@style/VkUiTypography.TextNormal"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/vk_sms_inbox_error_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_error_outline_56"
        app:tint="?attr/vk_ui_icon_negative"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/vk_sms_inbox_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_sms_inbox_error_title"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_sms_inbox_error_icon"
        style="@style/VkUiTypography.DisplayTitle2SemiBold"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/vk_sms_inbox_error_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_sms_inbox_error_title"
        style="@style/VkUiTypography.TextNormal"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/vk_sms_inbox_progress_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="vk_sms_inbox_progress_title, vk_sms_inbox_progress_subtitle, vk_sms_inbox_spinner"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/vk_sms_inbox_send_sms_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="vk_sms_inbox_title, vk_sms_inbox_subtitle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/vk_sms_inbox_error_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="vk_sms_inbox_error_icon, vk_sms_inbox_error_title, vk_sms_inbox_error_subtitle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/vk_sms_inbox_buttons_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="vk_sms_inbox_send_sms_button, vk_sms_inbox_pricing_warning"/>
</androidx.constraintlayout.widget.ConstraintLayout>
