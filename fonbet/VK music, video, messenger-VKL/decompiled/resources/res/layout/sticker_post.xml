<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="32dp"
    android:layout_marginVertical="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/post_sticker_full_info_container"
        android:background="@drawable/bg_post_sticker"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="6dp">
        <include
            android:id="@+id/post_sticker_header"
            layout="@layout/sticker_post_header"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/post_sticker_text"
            android:paddingTop="0.5dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2sp"
            android:paddingHorizontal="12dp"
            style="@style/VkUiTypography.ParagraphNormal"/>
        <include
            android:id="@+id/post_sticker_repost"
            layout="@layout/sticker_post_repost"/>
        <FrameLayout
            android:id="@+id/post_sticker_attachment_container"
            android:padding="4dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/post_sticker_additional_attachments_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/post_sticker_bottom_separator"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
    </LinearLayout>
</FrameLayout>
