<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/vk_ui_spacing_size_xl"
    android:paddingBottom="@dimen/vk_ui_spacing_size_xs"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/vk_ui_base_padding_horizontal">
    <com.vk.core.view.components.picture.VkPicture
        android:id="@+id/product_preview_picture"
        android:layout_width="135dp"
        android:layout_height="162dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:viewAspectRatio="0.83"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/product_preview_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/product_preview_picture"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/product_preview_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
        app:layout_constraintStart_toStartOf="@+id/product_preview_title"
        app:layout_constraintTop_toBottomOf="@+id/product_preview_title"
        style="@style/VkUiTypography.DisplayTitle4SemiBold"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/product_preview_old_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        app:layout_constraintBottom_toBottomOf="@+id/product_preview_price"
        app:layout_constraintStart_toEndOf="@+id/product_preview_price"
        app:layout_constraintTop_toTopOf="@+id/product_preview_price"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.ecomm.design.view.badge.MarketDiscountBadge
        android:id="@+id/product_preview_discount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/product_preview_price"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/product_preview_old_price"
        app:layout_constraintTop_toTopOf="@+id/product_preview_price"
        app:marketBadge_style="accent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/product_preview_rating_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
        android:paddingVertical="@dimen/vk_ui_spacing_size2_xs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/product_preview_price"
        app:layout_constraintTop_toBottomOf="@+id/product_preview_price">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/product_preview_rating_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vk_ui_spacing_size_xs"
            style="@style/VkUiTypography.FootnoteMedium"/>
        <View
            android:id="@+id/product_preview_rating_star_view"
            android:background="@drawable/vk_icon_favorite_20"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="@dimen/vk_ui_spacing_size_s"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="end"
            android:id="@+id/product_preview_rating_reviews_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/VkUiTypography.Footnote"/>
    </LinearLayout>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/product_preview_description"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/product_preview_show_more_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/product_preview_rating_container"
        app:layout_constraintTop_toBottomOf="@+id/product_preview_rating_container"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_accent"
        android:ellipsize="end"
        android:id="@+id/product_preview_show_more_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/good_review_item_expand_button_text"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/product_preview_description"
        style="@style/VkUiTypography.SubheadMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
