<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/digest_list_item"
    android:background="@drawable/highlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <com.vk.core.view.components.divider.VkDivider
        android:layout_gravity="bottom"
        android:id="@+id/digest_separator"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="0.5dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/digest_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="11.5dp"
        android:layout_marginEnd="70dp">
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/digest_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2.5dp"
            android:maxLines="2"/>
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:gravity="center_vertical"
            android:id="@+id/digest_name_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="3dp">
            <com.vk.core.view.components.picture.VkImage
                android:id="@+id/digest_photo"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/digest_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:singleLine="true"
                android:layout_marginStart="4dp"
                app:vk_layout_isFluid="true"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/digest_icon"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"/>
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/digest_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:layout_marginStart="2dp"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/digest_container"
        android:layout_width="60dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp">
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="center"
            android:id="@+id/digest_attach_thumb"
            android:layout_width="60dp"
            android:layout_height="44dp"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/digest_overlay"
            android:layout_width="60dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            app:srcCompat="@drawable/vk_icon_play_28"/>
    </FrameLayout>
</FrameLayout>
