<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.libvideo.design.view.videotexture.VideoTextureView
        android:id="@+id/video_texture"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:id="@+id/zoom_value"
        android:background="@drawable/video_zoom_info_old"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Headline1Normal"/>
    <view
        android:layout_gravity="center"
        android:id="@+id/video_fast_seek_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        class="com.vk.libvideo.design.view.seek.VideoFastSeekView"/>
    <View
        android:id="@+id/extend_seek_bar_overlay"
        android:background="@color/vk_black_alpha45"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/interactive_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/interactive_state_container"
        android:visibility="invisible"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKCircleImageView
            android:id="@+id/interactive_state_indicator"
            android:background="@drawable/interactive_state_background"
            android:padding="4dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:tint="@color/vk_azure_A100"
            android:layout_centerInParent="true"
            app:emptyImagePlaceholder="@drawable/vk_icon_hand_point_up_24"
            app:placeholderImage="@drawable/vk_icon_hand_point_up_24"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/interactive_state_animator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/circle_anim"/>
    </RelativeLayout>
    <one.video.controls.view.seekpreview.SeekPreviewImageView
        android:id="@+id/seek_full_preview_image"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/can_be_hidden_controls"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/gradient_view_top"
            android:background="@drawable/player_gradient_top"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:alpha="0.64"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/gradient_view_bottom"
            android:background="@drawable/player_bar_gradient_bottom"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:alpha="0.64"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/adjustable_controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/playback_controls"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.vk.core.view.components.picture.VkImageSimple
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/seek_to_previous"
                    android:background="@drawable/playback_control_background"
                    android:padding="10dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/vk_icon_skip_previous_24"
                    android:tint="@color/vk_white"
                    android:contentDescription="@string/interactive_videos_talkback_rewind_control"
                    android:layout_marginStart="12dp"/>
                <com.vk.core.view.components.picture.VkImageSimple
                    android:layout_gravity="center"
                    android:id="@+id/play_pause"
                    android:padding="16dp"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/vk_icon_pause_button_64"
                    android:contentDescription="@string/interactive_videos_talkback_pause_control"/>
                <com.vk.core.view.components.picture.VkImageSimple
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/skip_to_event"
                    android:background="@drawable/playback_control_background"
                    android:padding="10dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/vk_icon_skip_to_action_24"
                    android:tint="@color/vk_white"
                    android:contentDescription="@string/interactive_videos_talkback_skip_control"
                    android:layout_marginEnd="12dp"/>
            </FrameLayout>
            <com.vk.core.view.components.text.VkText
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:id="@+id/seek_beyond_not_available_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/can_not_seek_beyond_interaction"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/VkUiTypography.Caption1"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="@color/vk_white"
                android:id="@+id/seek_full_additional_text"
                android:background="@drawable/seek_full_additional_text_background"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/interactive_videos_seek_not_available"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                app:layout_constraintBottom_toTopOf="@+id/seek_bar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/VkUiTypography.Caption1"/>
            <com.vk.movika.tools.controls.seekbar.DefaultSeekBarView
                android:id="@+id/seek_bar"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/interactive_videos_talkback_timeline_control"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <FrameLayout
                android:id="@+id/labels_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/seek_bar"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/player_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:layout_constraintBottom_toTopOf="@+id/seek_bar">
                <com.vk.core.view.components.picture.VkImageSimple
                    android:id="@+id/replay"
                    android:padding="4dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/vk_icon_replay_24"
                    android:tint="@color/vk_white"
                    android:contentDescription="@string/interactive_videos_talkback_replay_control"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.vk.core.view.components.picture.VkImageSimple
                    android:id="@+id/fullscreen_button"
                    android:padding="4dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:tint="@color/vk_white"
                    android:contentDescription="@string/one_video_accessibility_full_screen_mode"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/one_video_icon_fullscreen_24"/>
                <com.vk.core.view.components.picture.VkImageSimple
                    android:id="@+id/quality_settings"
                    android:padding="4dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:tint="@color/vk_white"
                    android:contentDescription="@string/one_video_accessibility_settings"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/fullscreen_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/one_video_icon_gear_outline_24"/>
                <com.vk.core.view.components.picture.VkImageSimple
                    android:id="@+id/resize"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:tint="@color/vk_white"
                    android:contentDescription="@string/one_video_accessibility_resize"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/quality_settings"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/one_video_icon_video_fill_24"/>
                <com.vk.core.view.components.picture.VkImageSimple
                    android:id="@+id/report_problem"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:tint="@color/vk_white"
                    android:contentDescription="@string/video_tech_bugreport"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/resize"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/one_video_icon_bugreport_outline_24"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/seek_preview_layout"
                android:visibility="gone"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                app:layout_constraintBottom_toTopOf="@+id/seek_bar"
                app:layout_constraintStart_toStartOf="@+id/seek_bar">
                <one.video.controls.view.seekpreview.SeekPreviewImageView
                    android:id="@+id/seek_preview_image"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"/>
                <com.vk.core.view.components.text.VkText
                    android:textColor="@color/vk_white"
                    android:layout_gravity="center"
                    android:id="@+id/seek_not_available_text"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/interactive_videos_seek_not_available"
                    style="@style/VkUiTypography.Caption1"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.movika.tools.controls.seekbar.DefaultSeekBarView
        android:id="@+id/seek_bar_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/interactive_videos_talkback_timeline_control"
        android:translationY="@dimen/interactive_seek_bar_translation_y"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <LinearLayout
        android:id="@+id/fast_speed"
        android:background="@drawable/fast_speed_background"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/interactive_fast_speed"
            style="@style/VkUiTypography.FootnoteSemiBold"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="0.5dp"
            android:src="@drawable/vk_icon_skip_next_24"
            android:tint="@color/vk_white"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <com.vk.movika.impl.view.full.extend_seekbar.InteractiveExtendSeekBarView
        android:id="@+id/extend_seek_bar"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="@dimen/interactive_extend_seek_view_size"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="@+id/seek_bar_new"
        app:layout_constraintStart_toStartOf="@+id/seek_bar_new"
        app:layout_constraintTop_toBottomOf="@+id/seek_bar_new"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/cancel_extend_seek_bar"
        android:background="@drawable/highlight_circle_white"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/vk_icon_cancel_24"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vk_white"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:id="@+id/extend_seek_bar_hint"
        android:background="@drawable/interactive_extend_seek_bar_hint_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/interactive_extend_seek_bar_hint"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Caption1"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/extend_seek_bar_play"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/vk_icon_play_button_64"
        android:contentDescription="@string/interactive_videos_talkback_pause_control"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.spinner.VkSpinner
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/cover_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/end_view_container"
        android:background="@color/vk_black_alpha35"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.libvideo.design.view.endview.VideoEndView
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/end_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.vk.movika.impl.view.full.tooltip.TooltipOverlay
        android:id="@+id/tooltip_overlay"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/load_error_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/load_error_layout"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/overlay_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
