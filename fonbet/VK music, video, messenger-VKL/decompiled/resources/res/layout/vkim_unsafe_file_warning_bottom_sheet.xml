<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_modal_background_with_round_corner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/vk_icon_error_triangle_outline_56"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vkim_unsafe_file_warning_title"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        style="@style/VkLegacyTypography.Title2.Regular"/>
    <TextView
        android:id="@+id/unsafe_file_warning_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        style="@style/VkLegacyTypography.Subhead2"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_marginHorizontal="24dp">
        <Button
            android:textSize="16sp"
            android:id="@+id/negative_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/vkim_cancel"
            android:layout_weight="1"
            android:stateListAnimator="@null"
            style="@style/VkLegacyButton.Secondary"/>
        <View
            android:layout_width="12dp"
            android:layout_height="0dp"/>
        <Button
            android:textSize="16sp"
            android:id="@+id/positive_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/vkim_continue"
            android:layout_weight="1"
            android:stateListAnimator="@null"
            style="@style/VkLegacyButton.Primary"/>
    </LinearLayout>
</LinearLayout>
