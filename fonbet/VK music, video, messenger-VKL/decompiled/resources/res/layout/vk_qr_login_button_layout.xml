<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/qr_login_btn_content"
        android:background="@drawable/vk_auth_btn_azure"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vk_qr_map_auth_button_height">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/qr_login_btn_vk_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="11dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_new_logo_vk_56"
            app:tint="@color/vk_white"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/qr_login_btn_lines_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/qr_btn_end_icon"
            app:layout_constraintStart_toEndOf="@+id/qr_login_btn_vk_icon"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textAppearance="@style/VkUiTypography.Headline1Medium"
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:id="@+id/qr_login_btn_first_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:id="@+id/qr_login_btn_second_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="2dp"
                android:singleLine="true"
                android:alpha="0.7"
                style="@style/VkUiTypography.Caption1"/>
        </LinearLayout>
        <com.vk.core.ui.themes.VKReplacerView
            android:id="@+id/qr_btn_end_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.pnikosis.materialishprogress.ProgressWheel
            android:id="@+id/qr_btn_progress_wheel"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/qr_btn_end_icon"
            app:layout_constraintEnd_toEndOf="@+id/qr_btn_end_icon"
            app:layout_constraintStart_toStartOf="@+id/qr_btn_end_icon"
            app:layout_constraintTop_toTopOf="@+id/qr_btn_end_icon"
            app:matProg_barColor="@color/vk_white"
            app:matProg_barWidth="2dp"
            app:matProg_progressIndeterminate="true"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
