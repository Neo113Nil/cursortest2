<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attach_doc_thumb_frame_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.feed.tool.view.newsfeed.image.FixedSizeFrescoImageViewLegacy
        android:id="@+id/att_doc_thumb"
        android:layout_width="120dp"
        android:layout_height="80dp"
        app:vkim_cornerRadius="4dp"
        app:vkim_scaleType="center_crop"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption2"
        android:textColor="@color/vk_white"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:layout_gravity="end|bottom"
        android:id="@+id/att_doc_title"
        android:background="@drawable/bg_thumb_size"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:singleLine="true"
        android:drawablePadding="2dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"/>
</FrameLayout>
