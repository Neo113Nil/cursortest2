<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/vk_ui_base_padding_horizontal"
    android:paddingVertical="@dimen/vk_ui_spacing_size_xl">
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/product_preview_write_to_seller_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/write_to_the_good_owner"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_xl"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintEnd_toStartOf="@+id/product_preview_add_to_bookmarks_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/product_preview_add_to_bookmarks_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_bookmark_add_outline_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/product_preview_add_to_cart_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
        android:text="@string/market_cart_add"
        android:contentDescription="@string/fave_market_button_add_to_cart"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_preview_add_to_bookmarks_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
