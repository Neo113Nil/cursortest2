<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_container"
    android:layout_width="144dp"
    android:layout_height="259dp"
    android:foreground="@drawable/highlight_radius_8">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/photo"
        android:layout_width="144dp"
        android:layout_height="144dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_width="match_parent"
        android:layout_height="73dp"
        android:layout_marginTop="144dp">
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:layout_gravity="center_horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.FootnoteMedium.Unscaled"
                android:textStyle="normal"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:vk_layout_isFluid="true"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/friends_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <com.vk.core.view.PhotoStackView
                android:id="@+id/photo_strip"
                android:layout_width="wrap_content"
                android:layout_height="16dp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/subtitle2"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:drawablePadding="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/button_hide"
        android:background="@drawable/vk_ripple_circle_highlight"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_dismiss_dark_24"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_hide"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="217dp"
        android:layout_marginRight="12dp"
        android:minHeight="30dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/done"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="217dp"
        android:layout_marginRight="12dp"
        android:scaleType="center"
        android:singleLine="true"/>
</FrameLayout>
