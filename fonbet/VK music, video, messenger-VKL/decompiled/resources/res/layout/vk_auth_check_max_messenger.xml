<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/max_messenger_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="32dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/max_messenger_sheet_top_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:srcCompat="@drawable/vk_auth_illustration_max_promo_foreground"/>
    <View
        android:id="@+id/max_messenger_fake_bottom_sheet"
        android:background="@drawable/vk_auth_max_messenger_fake_bottom_sheet_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/max_messenger_sheet_top_space"/>
    <Space
        android:id="@+id/max_messenger_sheet_top_space"
        android:layout_width="0dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toTopOf="@+id/max_messenger_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/max_messenger_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_auth_max_messenger_check_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/max_messenger_first_subtitle_cell"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkUiTypography.DisplayTitle1SemiBold"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/max_messenger_first_subtitle_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/max_messenger_second_subtitle_cell"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/max_messenger_second_subtitle_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/max_messenger_third_subtitle_cell"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/max_messenger_third_subtitle_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/max_messenger_open_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:id="@+id/max_messenger_open_button"
        android:background="@drawable/vk_auth_max_messenger_background"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_auth_max_messenger_check_button"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkUiTypography.Headline1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
