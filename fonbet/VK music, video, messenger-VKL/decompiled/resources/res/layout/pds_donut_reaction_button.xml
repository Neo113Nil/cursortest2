<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@+id/donut_reaction_button_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_donut_small_color_20"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_accent_orange"
        android:layout_gravity="center"
        android:id="@+id/donut_reaction_button_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        style="?attr/vk_ui_typography_subhead_medium"/>
</merge>
