<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_container"
    android:layout_width="@dimen/recomm_carousel_item_width"
    android:layout_height="wrap_content">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/bg_rounded_corners_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="?attr/vk_ui_skeleton_from"/>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
    <View
        android:id="@+id/img"
        android:background="@drawable/bg_border_rounded_12"
        android:layout_width="@dimen/recomm_carousel_item_width"
        android:layout_height="@dimen/recomm_carousel_item_width"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/line1"
        android:layout_width="wrap_content"
        android:layout_height="18.75sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        app:layout_constraintHeight_min="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img">
        <View
            android:gravity="start|center_vertical"
            android:background="@drawable/bg_rounded_4"
            android:layout_width="150dp"
            android:layout_height="12sp"
            android:layout_marginTop="4dp"
            android:backgroundTint="?attr/vk_ui_background_content"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/line2"
        android:layout_width="wrap_content"
        android:layout_height="16sp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line1">
        <View
            android:gravity="start|center_vertical"
            android:background="@drawable/bg_rounded_2"
            android:layout_width="100dp"
            android:layout_height="8sp"
            android:layout_marginTop="5dp"
            android:backgroundTint="?attr/vk_ui_background_content"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line2">
        <View
            android:id="@+id/icon"
            android:background="@drawable/bg_rounded_8"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="?attr/vk_ui_background_content"/>
        <View
            android:id="@+id/button_title"
            android:background="@drawable/bg_rounded_2"
            android:layout_width="60dp"
            android:layout_height="8sp"
            android:backgroundTint="?attr/vk_ui_background_content"
            android:layout_marginVertical="5.25sp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
