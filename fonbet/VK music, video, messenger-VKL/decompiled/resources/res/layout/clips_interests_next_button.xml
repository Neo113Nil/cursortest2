<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_gray_800"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/clips_interests_next_button"
        android:background="@drawable/bg_action_button"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="200dp"
        android:minHeight="52dp"
        android:singleLine="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/VkUiTypography.DisplayTitle4Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_ui_text_title_color"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/clips_interests_skip_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minWidth="200dp"
        android:minHeight="52dp"
        android:text="@string/clips_interests_skip_button"
        android:singleLine="true"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        style="@style/VkUiTypography.DisplayTitle4Medium"/>
</merge>
