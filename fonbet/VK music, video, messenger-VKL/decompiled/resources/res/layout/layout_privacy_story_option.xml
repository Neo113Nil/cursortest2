<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.cell.rich.VkRichCell
        android:id="@+id/cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/banner_container"
        android:background="@drawable/bg_story_label"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp">
        <com.vk.core.view.components.text.VkText
            android:textAppearance="?attr/vk_ui_typography_footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/banner_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
