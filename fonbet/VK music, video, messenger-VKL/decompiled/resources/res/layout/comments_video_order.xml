<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.FluidHorizontalLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">
    <com.google.android.material.chip.ChipGroup
        android:layout_gravity="center_vertical"
        android:id="@+id/chipGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">
        <com.google.android.material.chip.Chip
            android:id="@+id/interest"
            android:tag="interest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_popular"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:chipMinHeight="26dp"
            style="@style/Video.Chip.Choice"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/desc"
            android:tag="desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/tab_new"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:chipMinHeight="26dp"
            style="@style/Video.Chip.Choice"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/asc"
            android:tag="asc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_old"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:chipMinHeight="26dp"
            style="@style/Video.Chip.Choice"/>
    </com.google.android.material.chip.ChipGroup>
</com.vk.core.tool.view.FluidHorizontalLayout>
