<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.imageloader.blur.view.BlurBubbleView
        android:id="@+id/blurred_background"
        android:layout_width="0dp"
        android:layout_height="340dp"
        app:bv_background_color="?attr/vk_ui_background_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/scrim_bottom"
        android:background="@drawable/scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:layout_constraintBottom_toBottomOf="@+id/blurred_background"/>
    <ImageView
        android:id="@+id/random_pack_image"
        android:background="@drawable/bg_random_ic_rounded"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_random_sticker_icon"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/title_random"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle1SemiBold"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/title_random"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/random_pack"
        android:lineSpacingExtra="4sp"
        android:layout_marginStart="88dp"
        android:layout_marginEnd="88dp"
        app:layout_constraintBottom_toBottomOf="@+id/blurred_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/random_pack_image"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:textStyle="normal"
        android:gravity="center_horizontal"
        android:id="@+id/available_packs"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/show_available_packs"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_random"/>
    <ImageView
        android:id="@+id/roulette_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_deprecated_ic_roulette_arrow"
        app:layout_constraintBottom_toTopOf="@+id/roulette_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/congrats_anim"
        android:layout_width="0dp"
        android:layout_height="600dp"
        app:layout_constraintBottom_toBottomOf="@+id/stab_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stab_view"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"/>
    <com.vk.stickers.roulette.roulett_view.RouletteView
        android:id="@+id/roulette_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/balance_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/available_packs"/>
    <View
        android:id="@+id/scrim_left"
        android:background="@drawable/horizontal_scrim_left"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:layout_constraintBottom_toBottomOf="@+id/roulette_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/roulette_view"/>
    <View
        android:id="@+id/scrim_right"
        android:background="@drawable/horizontal_scrim_right"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:layout_constraintBottom_toBottomOf="@+id/roulette_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/roulette_view"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center_horizontal"
        android:id="@+id/balance_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/roulette_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:gravity="center"
        android:id="@+id/roulette_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:text="@string/try_your_luck"
        android:layout_marginStart="20dp"
        app:buttonAppearance="positive"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toTopOf="@+id/roulette_agreement"
        app:layout_constraintEnd_toStartOf="@+id/gift_button_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/gift_button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/roulette_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/roulette_button"
        app:layout_constraintTop_toTopOf="@+id/roulette_button">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/gift_button"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:contentDescription="@string/roulette_accessibility_send_random_pack"
            android:layout_marginStart="8dp"
            app:buttonAppearance="positive"
            app:buttonMode="primary"
            app:icon="@drawable/vk_icon_gift_outline_24"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:textColorHighlight="?attr/vk_ui_transparent_active"
        android:textColorLink="?attr/vk_ui_text_secondary"
        android:gravity="center_horizontal"
        android:id="@+id/roulette_agreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/error_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toTopOf="@+id/error_message_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blurred_background"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/vk_icon_error_circle_outline_32"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadNormal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/error_message_tv"
        android:padding="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/default_network_error"
        app:layout_constraintBottom_toTopOf="@+id/retry_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_icon"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadNormal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/random_stickers_not_allowed_tv"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/random_stickers_not_allowed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blurred_background"/>
    <com.vk.auth.ui.VkAuthTextView
        android:layout_gravity="center"
        android:id="@+id/retry_button"
        android:layout_width="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_retry"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_message_tv"
        style="@style/VkAuth.Button.Primary"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="176dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/vk_ui_icon_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blurred_background"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:collapseIcon="@drawable/vk_legacy_ic_back_collapse_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/accessibility_back"/>
    <ImageButton
        android:id="@+id/sound_button"
        android:background="@drawable/highlight_circle"
        android:layout_width="?attr/actionBarSize"
        android:layout_height="?attr/actionBarSize"
        android:src="@drawable/sound_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/header"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="title_random,blurred_background,scrim_bottom"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/roulette_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="available_packs,roulette_view,scrim_left,roulette_arrow,scrim_right"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/bottom_content_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="balance_tv,roulette_button,roulette_agreement,gift_button_container"/>
    <View
        android:id="@+id/stab_view"
        android:layout_width="0dp"
        android:layout_height="102dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/roulette_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
