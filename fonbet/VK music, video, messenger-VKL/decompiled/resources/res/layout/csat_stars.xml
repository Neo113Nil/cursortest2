<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/background"
        android:background="@drawable/bg_rounded_corners_12"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:backgroundTint="?attr/vk_ui_background_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tip"/>
    <ImageView
        android:id="@+id/tip"
        android:layout_width="20dp"
        android:layout_height="8dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/csat_feedback_tip"
        app:tint="?attr/vk_ui_background_secondary"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/tv_question"
        android:paddingTop="1dp"
        android:paddingBottom="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/notify_csat_stars_title"
        android:textAlignment="gravity"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.SubheadMedium"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/starsWrapper"
        android:layout_width="232dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSubmit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_question">
        <com.vk.ecomm.market.ui.view.ratingview.DynamicRatingView
            android:id="@+id/rating"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawable="@drawable/vk_icon_favorite_outline_36"
            app:emptyColor="?attr/vk_ui_icon_secondary"
            app:filledColor="?attr/vk_ui_accent_orange_peach"
            app:filledDrawable="@drawable/vk_icon_favorite_36"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:paddingBetween="13dp"
            app:rating="0"
            app:ratingCount="5"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/not_interesting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="16dp"
            android:text="@string/notify_csat_stars_not_interesting"
            android:textAlignment="gravity"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rating"
            style="@style/VkUiTypography.Footnote"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/interesting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="16dp"
            android:text="@string/notify_csat_stars_interesting"
            android:textAlignment="gravity"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rating"
            style="@style/VkUiTypography.Footnote"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/btnSubmit"
        android:layout_width="103dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.6"
        android:elevation="0dp"
        app:buttonAppearance="overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/starsWrapper"
        app:text="@string/notify_csat_stars_submit"/>
    <ImageView
        android:id="@+id/hide_button"
        android:background="@drawable/highlight_circle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_notify_csat_hide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_20"
        app:tint="?attr/vk_ui_icon_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
