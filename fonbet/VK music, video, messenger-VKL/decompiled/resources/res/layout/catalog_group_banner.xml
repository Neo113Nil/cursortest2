<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/group_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="@dimen/post_side_padding"
        app:layout_constraintBottom_toTopOf="@+id/group_button"
        app:layout_constraintEnd_toStartOf="@+id/group_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_link"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/group_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/grop_open_button"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_roboto_regular"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_marginStart="@dimen/post_side_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/group_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/group_title"
        app:layout_constraintWidth_default="wrap"
        style="@style/VkLegacyButton.Tertiary"/>
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/group_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="15.5dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
