<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:paddingEnd="12dp">
    <FrameLayout
        android:id="@+id/likes"
        android:background="@drawable/highlight_video_player_bottom"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:contentDescription="@string/accessibility_like"
        android:paddingStart="4dp"
        android:layout_marginStart="8dp">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/iv_likes"
            android:duplicateParentState="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/vk_icon_like_outline_24"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.ParagraphMedium.Unscaled"
            android:textColor="@color/video_post_counters"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/tv_likes"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="28dp"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.ParagraphMedium.Unscaled"
        android:textColor="@color/video_post_counters"
        android:gravity="center"
        android:id="@+id/comments"
        android:background="@drawable/highlight_video_player_bottom"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:drawablePadding="4dp"
        android:contentDescription="@string/accessibility_comments"
        app:drawableLeftCompat="@drawable/vk_icon_comment_outline_24"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.ParagraphMedium.Unscaled"
        android:textColor="@color/video_post_counters"
        android:gravity="center"
        android:id="@+id/shares"
        android:background="@drawable/highlight_video_player_bottom"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:drawablePadding="4dp"
        android:contentDescription="@string/accessibility_share"
        app:drawableLeftCompat="@drawable/vk_icon_share_outline_24"/>
    <android.widget.Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="48dp"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/add_video"
        android:background="@drawable/highlight_video_player_bottom"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:contentDescription="@string/video_accessibility_add_video"
        app:srcCompat="@drawable/vk_icon_add_24"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@+id/watch_video_later"
        android:background="@drawable/highlight_video_player_bottom"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:contentDescription="@string/video_accessibility_watch_later_video"
        app:srcCompat="@drawable/vk_icon_clock_outline_24"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@+id/show_playlist"
        android:background="@drawable/highlight_video_player_bottom"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:contentDescription="@string/show_playlist"
        android:layout_marginHorizontal="16dp"
        app:srcCompat="@drawable/vk_icon_list_play_outline_28"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@+id/show_more"
        android:background="@drawable/highlight_video_player_bottom"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:contentDescription="@string/menu"
        android:layout_marginHorizontal="16dp"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"/>
</merge>
