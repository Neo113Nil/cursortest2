<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="1"
    android:minHeight="44dp">
    <com.vk.community.tool.view.donut.feedactionbutton.FadeOutText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/donut_snippet_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        app:gradientColor="?attr/vk_ui_background_secondary"
        app:gradientWidth="36dp"
        style="@style/VkUiTypography.Paragraph"/>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="center_vertical"
        android:id="@+id/donut_snippet_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:layout_marginEnd="12dp"
        app:buttonAppearance="overlay"
        app:buttonBackgroundCornerRadius="@dimen/vk_ui_border_radius"
        app:buttonMode="primary"
        app:buttonSizeType="small"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center_vertical"
        android:id="@+id/donut_snippet_chevron"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:importantForAccessibility="no"
        android:layout_marginEnd="12dp"
        app:srcCompat="@drawable/vk_icon_chevron_right_20"
        app:tint="?attr/vk_ui_icon_secondary"/>
</merge>
