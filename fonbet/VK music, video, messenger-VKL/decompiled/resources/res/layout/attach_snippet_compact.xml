<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.components.card.VkCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attachment_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    android:minHeight="120dp"
    android:layout_marginHorizontal="8dp">
    <FrameLayout
        android:gravity="center"
        android:id="@+id/image_container"
        android:background="@drawable/attach_snippet_compact_image_bg"
        android:layout_width="120dp"
        android:layout_height="120dp">
        <com.vk.core.view.fresco.VKEnhancedImageView
            android:id="@+id/attach_photo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="132dp"
        android:layout_marginEnd="12dp">
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.ParagraphMedium"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/attach_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:maxLines="2"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center_vertical"
            android:id="@+id/media_restriction_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:singleLine="true"/>
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:gravity="center_vertical"
            android:id="@+id/description_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center_vertical"
                android:id="@+id/attach_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:singleLine="true"
                app:vk_layout_isFluid="true"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
    </LinearLayout>
    <com.vk.core.view.components.button.VkButton
        android:textAppearance="@style/VkUiTypography.Caption1CapsMedium"
        android:ellipsize="end"
        android:layout_gravity="bottom"
        android:id="@+id/attach_main_button"
        android:background="?attr/vk_ui_background_secondary_alpha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:minHeight="26dp"
        android:singleLine="true"
        android:drawablePadding="6dp"
        android:layout_marginStart="132dp"
        android:layout_marginEnd="12dp"
        android:paddingHorizontal="12dp"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="small"/>
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="end"
        android:id="@+id/attach_favorite_button"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="12dp"/>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/attach_remove_button"
        android:background="@drawable/vk_icon_deprecated_ic_close_attach_36"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/delete"/>
</com.vk.core.view.components.card.VkCard>
