<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary2x"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"/>
    <FrameLayout
        android:id="@+id/bls_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.view.components.placeholder.main.VkPlaceholder
            android:layout_gravity="center"
            android:id="@+id/finished_placeholder"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Title3"
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="start"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"/>
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="start"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_question_subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="16dp"/>
            <com.vk.core.view.components.picture.VkImage
                android:id="@+id/question_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="@drawable/bg_rounded_8_stroke_05"
                android:layout_marginHorizontal="16dp"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/answers_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"/>
        </LinearLayout>
    </FrameLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.vk.feed.design.view.newsfeed.ads_mytarget.bls.MyTargetAdSurveyButtonsView
        android:layout_gravity="bottom"
        android:id="@+id/buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
