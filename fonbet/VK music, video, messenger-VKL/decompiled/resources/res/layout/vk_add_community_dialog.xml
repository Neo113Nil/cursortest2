<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="10dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/vk_ui_background_modal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/header"
            android:background="?attr/vk_ui_background_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:srcCompat="@drawable/vk_icon_users_3_outline_56"
                app:tint="?attr/vk_ui_icon_accent"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Title2Medium"
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center"
                android:id="@+id/community_text"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="18dp"
                android:text="@string/vk_add_mini_app_to_community"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header">
            <CheckBox
                android:layout_gravity="center"
                android:id="@+id/push_check_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginStart="16dp"
                app:buttonCompat="@drawable/vk_app_push_checkbox"
                app:buttonTint="@color/vk_light_gray_2"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/vk_notify_about_notification"
                android:paddingStart="12dp"
                app:layout_constraintLeft_toRightOf="@+id/push_check_box"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/vk_notification_description"
                android:paddingStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/push_check_box"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttons_container"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content">
            <com.vk.core.view.components.button.VkSimpleButton
                android:id="@+id/negative_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/vk_apps_cancel_request"
                android:layout_weight="0.5"
                app:buttonAppearance="accent"
                app:buttonMode="secondary"
                app:buttonSizeType="medium"/>
            <View
                android:id="@+id/buttons_divider"
                android:layout_width="12dp"
                android:layout_height="0dp"/>
            <com.vk.core.view.components.button.VkSimpleButton
                android:id="@+id/positive_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/vk_apps_add"
                android:layout_weight="0.5"
                app:buttonAppearance="accent"
                app:buttonMode="primary"
                app:buttonSizeType="medium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
