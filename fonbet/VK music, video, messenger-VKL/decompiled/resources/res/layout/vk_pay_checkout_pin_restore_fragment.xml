<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="284dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:transitionName="checkoutTransition">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/vk_pay_checkout_ll_code_request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/vk_legacy_text_secondary"
            android:gravity="center"
            android:id="@+id/vk_pay_checkout_restore_sms_send_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/VkLegacyTypography.Headline"/>
        <Button
            android:textSize="15sp"
            android:id="@+id/vk_pay_checkout_restore_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="24dp"
            android:text="@string/vk_pay_checkout_restore_get_code"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/VkLegacyButton.Primary"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/vk_pay_checkout_ll_code_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="?attr/vk_legacy_separator_common"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="22dp"
            android:text="@string/vk_pay_checkout_restore_input_code_reason"
            style="@style/VkLegacyTypography.Subhead1"/>
        <com.vk.superapp.ui.VkTextFieldView
            android:id="@+id/vk_pay_checkout_code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:vk_caption="@string/vk_pay_checkout_code_from_sms"
            app:vk_caption_style="@style/VkLegacyTypography.Subhead2"
            app:vk_hint="0000"
            app:vk_input_type="number"
            app:vk_max_length="4"/>
        <TextView
            android:id="@+id/vk_pay_checkout_timer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_pay_checkout_code_send_timer"
            style="@style/VkLegacyTypography.Subhead2"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/vk_legacy_text_link"
            android:id="@+id/vk_pay_checkout_resend_code"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_pay_checkout_send_code_again"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/vk_pay_checkout_ll_pin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/vk_pay_checkout_new_pin_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="72dp"
            android:text="@string/vk_pay_checkout_enter_new_pin"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_pin_dots"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.pin.views.dots.PinDotsView
            android:id="@+id/vk_pay_checkout_pin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_restore_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vk_pay_checkout_new_pin_title"
            app:vk_dotsCount="4"
            app:vk_dotsFactory="com.vk.superapp.vkpay.checkout.feature.verification.keyboard.dots.CheckoutDotsFactory"/>
        <TextView
            android:id="@+id/vk_pay_checkout_restore_hint"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_pin_keyboard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vk_pay_checkout_pin_dots"
            style="@style/VkLegacyTypography.Subhead2"/>
        <com.vk.pin.views.keyboard.PinKeyboardView
            android:textStyle="bold"
            android:id="@+id/vk_pay_checkout_pin_keyboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:backgroundDrawable="@drawable/pin_button_transparent"
            app:keyboardFactory="com.vk.superapp.vkpay.checkout.feature.pin.CheckoutPinNoBiometricKeyboardFactory"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:marginBottom="4dp"
            app:marginEnd="12dp"
            app:marginStart="12dp"
            app:marginTop="4dp"/>
        <com.vk.superapp.vkpay.checkout.feature.pin.success.PinSuccessView
            android:id="@+id/vk_pay_checkout_pin_success"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:vk_text="@string/vk_pay_checkout_pin_change_success"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
