<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/header_sort_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/video_catalog_filters_sort"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Subhead"/>
    <View
        android:id="@+id/sort_type_view"
        android:background="@drawable/vkui_spinner_default_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_sort_type"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/sort_type_subtitle"
        android:paddingLeft="28dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/sort_type_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sort_type_view"
        style="@style/VkUiTypography.Text"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/header_type_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/video_filters_type_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_type_view"
        style="@style/VkUiTypography.Subhead"/>
    <View
        android:id="@+id/type_content_view"
        android:background="@drawable/vkui_spinner_default_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_type_content"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/sort_type_content_subtitle"
        android:paddingLeft="28dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/type_content_view"
        app:layout_constraintTop_toTopOf="@+id/type_content_view"
        style="@style/VkUiTypography.Text"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/header_length_sort_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/video_catalog_filters_length"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/type_content_view"
        style="@style/VkUiTypography.Subhead"/>
    <View
        android:id="@+id/sort_length_type_view"
        android:background="@drawable/vkui_spinner_default_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_length_sort_type"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/length_sort_type_subtitle"
        android:paddingLeft="28dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/sort_length_type_view"
        app:layout_constraintTop_toTopOf="@+id/sort_length_type_view"
        style="@style/VkUiTypography.Text"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/header_date_sort_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/video_catalog_filters_date"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_length_type_view"
        style="@style/VkUiTypography.Subhead"/>
    <View
        android:id="@+id/sort_date_type_view"
        android:background="@drawable/vkui_spinner_default_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_date_sort_type"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/date_sort_type_subtitle"
        android:paddingLeft="28dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/sort_date_type_view"
        app:layout_constraintTop_toTopOf="@+id/sort_date_type_view"
        style="@style/VkUiTypography.Text"/>
    <com.vk.core.view.components.checkbox.VkCheckboxItem
        android:id="@+id/filter_high_quality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_date_type_view"
        app:title="@string/video_catalog_filters_high_quality"/>
    <com.vk.core.view.components.checkbox.VkCheckboxItem
        android:id="@+id/filter_authors"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:checkboxType="square"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/filter_high_quality"
        app:title="@string/video_filters_authors"/>
</merge>
