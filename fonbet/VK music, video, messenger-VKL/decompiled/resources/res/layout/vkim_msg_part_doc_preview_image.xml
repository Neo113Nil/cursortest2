<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.FrameLayoutSameSize xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.fresco.VKEnhancedImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/msg_bubble_max_width"
        android:maxHeight="@dimen/msg_content_max_height"
        android:minWidth="128dp"
        android:minHeight="128dp"
        android:contentDescription="@string/vkim_accessibility_doc_preview"
        app:imageScaleType="center_crop"/>
    <View
        android:id="@+id/selection_mask"
        android:background="@color/vkim_msg_part_selection_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_same_size_as="@+id/image"/>
    <TextView
        android:textAppearance="@style/VkIm.MsgPart.Label.TextContrast"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="top|left"
        android:id="@+id/label_default"
        android:background="?attr/im_msg_part_label_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:lines="1"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextContrast"
        android:layout_gravity="bottom|right"
        android:id="@+id/timeAndStatus"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:importantForAccessibility="noHideDescendants"/>
    <com.vk.core.view.ProgressView
        android:layout_gravity="center"
        android:id="@+id/upload"
        style="@style/VkIm.MsgPart.UploadIndicator.Default"/>
</com.vk.core.tool.view.FrameLayoutSameSize>
