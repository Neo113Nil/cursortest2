<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/live_now_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_vertical"
        android:id="@+id/live_now_recycler"
        android:background="#00000000"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="30dp"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginRight="32dp"
        android:importantForAccessibility="no"/>
    <com.vk.core.view.components.picture.VkPicture
        android:layout_gravity="center"
        android:id="@+id/live_now_button"
        android:background="@drawable/bg_live_spectators_rounded"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_browser_back_24"/>
</FrameLayout>
