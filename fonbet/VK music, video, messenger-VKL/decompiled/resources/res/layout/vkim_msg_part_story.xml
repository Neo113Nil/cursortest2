<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.FluidHorizontalLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.FrameLayoutSameSize
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="36dp">
        <com.vk.im.ui.views.msg.MsgPartExpiredStorySnippet
            android:id="@+id/expired_story_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:minHeight="28dp"/>
        <com.vk.core.view.fresco.VKEnhancedImageView
            android:id="@+id/image"
            android:layout_width="124dp"
            android:layout_height="220dp"
            android:contentDescription="@string/vkim_accessibility_photo"
            app:imageScaleType="center_crop"/>
        <ImageView
            android:id="@+id/image_gradient"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/vkim_msg_part_story_gradient"
            android:importantForAccessibility="no"
            app:layout_same_size_as="@+id/image"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ic_one_time"
            android:background="@drawable/bg_black_alpha35_circle"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/vk_icon_bomb_outline_28"
            app:tint="@color/vk_white"/>
        <com.vk.core.view.ProgressView
            android:layout_gravity="center"
            android:id="@+id/loader"
            style="@style/VkIm.MsgPart.UploadIndicator.Default"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="@color/vk_white_alpha60"
            android:id="@+id/story_title"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <com.vk.core.view.components.button.VkButton
            android:ellipsize="end"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/add_to_story_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:maxWidth="188dp"
            android:text="@string/vkim_msg_story_add_to_story"
            app:buttonAppearance="overlay"
            app:buttonMode="primary"
            app:buttonSizeType="small"/>
        <com.vk.im.ui.views.msg.TimeAndStatusView
            android:textAppearance="@style/VkIm.MsgPart.Time.TextContrast"
            android:layout_gravity="bottom|right"
            android:id="@+id/timeAndStatus"
            android:background="?attr/im_msg_part_time_contrast_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:importantForAccessibility="no"/>
    </com.vk.core.tool.view.FrameLayoutSameSize>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/story_info_container"
        android:background="@drawable/vkim_msg_part_transparent_black_bg"
        android:visibility="gone"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp">
        <View
            android:layout_gravity="start"
            android:id="@+id/story_info_image"
            android:background="@drawable/vk_icon_deprecated_ic_archive_20"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="@color/vk_white"
            android:layout_gravity="bottom"
            android:id="@+id/story_info_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="8dp"
            android:text="@string/vkim_story_visible_only_for_you"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
    </FrameLayout>
</com.vk.core.tool.view.FluidHorizontalLayout>
