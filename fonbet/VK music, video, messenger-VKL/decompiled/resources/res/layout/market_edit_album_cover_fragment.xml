<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/appkit_loader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/market_edit_album_cover_top_bar_compose_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.ColorProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress_bar"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:color="?attr/vk_ui_icon_secondary"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:textColor="?attr/vk_ui_text_subhead"
                        android:id="@+id/album_name_header_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/market_edit_album_name_header"
                        android:maxLines="1"
                        android:labelFor="@+id/album_name_edit_text"
                        style="@style/VkUiTypography.Subhead"/>
                    <TextView
                        android:textColor="@color/vk_red"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        style="@style/VkUiTypography.Subhead"/>
                    <TextView
                        android:textColor="?attr/vk_ui_text_subhead"
                        android:id="@+id/counter_current_value_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/VkUiTypography.Subhead"/>
                    <TextView
                        android:textColor="?attr/vk_ui_text_subhead"
                        android:id="@+id/counter_max_value_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/VkUiTypography.Subhead"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/album_name_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/market_edit_album_name_header_hint"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:importantForAutofill="no"
                    style="@style/VKUIEditText"/>
                <TextView
                    android:textColor="@color/vk_red"
                    android:id="@+id/album_name_error_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/market_album_empty_name_error"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    style="@style/VkUiTypography.Caption1"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_subhead"
                    android:id="@+id/album_image_header_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="@string/market_edit_album_image_header"
                    android:maxLines="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:labelFor="@+id/album_name_edit_text"
                    style="@style/VkUiTypography.Subhead"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_subhead"
                    android:id="@+id/album_image_description_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="18dp"
                    android:text="@string/market_edit_album_image_description"
                    android:maxLines="2"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:labelFor="@+id/album_name_edit_text"
                    style="@style/VkUiTypography.Caption2"/>
                <com.vk.ecomm.market.album.MarketAlbumImagePickerView
                    android:id="@+id/album_image_picker"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp">
                    <CheckBox
                        android:id="@+id/album_is_main_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        style="@style/VKUICheckBoxTheme"/>
                    <TextView
                        android:textColor="?attr/vk_ui_text_primary"
                        android:id="@+id/album_is_main_header_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/market_edit_album_is_main_header"
                        android:paddingStart="6dp"
                        style="@style/VkUiTypography.Headline1Normal"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp">
                    <CheckBox
                        android:id="@+id/album_is_hidden_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        style="@style/VKUICheckBoxTheme"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:textColor="?attr/vk_ui_text_primary"
                            android:id="@+id/album_is_hidden_header_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/market_edit_album_is_hidden_header"
                            android:paddingStart="6dp"
                            style="@style/VkUiTypography.Headline1Normal"/>
                        <TextView
                            android:textColor="?attr/vk_ui_text_secondary"
                            android:id="@+id/album_is_hidden_description_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/market_edit_album_is_hidden_description"
                            android:paddingStart="6dp"
                            style="@style/VkUiTypography.Caption1"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/album_next_button_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/market_edit_album_next_button"
            android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
            android:layout_marginVertical="@dimen/vk_ui_spacing_size_xl"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </FrameLayout>
</LinearLayout>
