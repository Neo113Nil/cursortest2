<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/voip_tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:lineSpacingExtra="5dp"
        android:fontFamily="@font/vk_roboto_regular"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_tv_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/voip_icon_selected"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Title2"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/voip_tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:lines="1"
        android:lineSpacingExtra="3dp"
        android:fontFamily="@font/vk_roboto_regular"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voip_icon_selected"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_tv_title"
        style="@style/VkLegacyTypography.Title2"/>
    <ImageView
        android:id="@+id/voip_icon_selected"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/voip_accessibility_icon_timezone_picked"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_check_circle_on_24"/>
</androidx.constraintlayout.widget.ConstraintLayout>
