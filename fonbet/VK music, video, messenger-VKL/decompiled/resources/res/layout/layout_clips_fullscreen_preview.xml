<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fullscreen_editor_overlay_view"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/clip_editor_fullscreen_area_accessibility"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/video_fullscreen_collapse_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">
        <com.vk.clips.design.view.stikers.ClipsStickerDeleteAreaView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/video_fullscreen_stickers_delete_area"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="18dp"/>
    </FrameLayout>
    <com.vk.clips.design.view.editor.TransformOverlayView
        android:id="@+id/video_transform_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.button.tool.VkToolButton
        android:gravity="center_vertical"
        android:id="@+id/video_fullscreen_collapse_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:contentDescription="@string/clip_editor_fullscreen_collapse"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:text="@string/clip_editor_fullscreen_collapse"
        app:toolButtonAppearance="accent"
        app:toolButtonMode="tertiary"
        app:toolButtonTextPosition="right"/>
    <com.vk.clips.design.view.editor.FrameLayoutDisabledTouches
        android:id="@+id/clips_editor_preview_overlay"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen_editor_overlay_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/fullscreen_editor_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="@string/clip_editor_fullscreen_title"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/show_preview_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/show_preview_image"
        style="@style/VkUiTypography.DisplayTitle1"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/show_preview_image"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/clip_editor_fullscreen_hide_controls_accessibility"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vk_white"/>
    <com.vk.clips.design.view.seek.ClipsSeekBar
        android:id="@+id/clips_editor_seek_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen_editor_overlay_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullscreen_editor_overlay_view"
        app:lineThickness="3dp"
        app:thumbSize="12dp"
        app:unselectedColor="@color/vk_white_alpha40"/>
</androidx.constraintlayout.widget.ConstraintLayout>
