<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlistCollapsedViewContainer"
    android:background="@drawable/bg_rounded_dark_8"
    android:focusable="true"
    android:visibility="invisible"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iconPlaylist"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:tint="@color/vk_gray_100"
        android:layout_marginStart="12dp"
        android:layout_marginVertical="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_list_play_outline_28"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.Headline2Normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/playlistCollapsedContainerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/playlistCollapsedContainerSubtitle"
        app:layout_constraintEnd_toStartOf="@+id/playlistCollapsedContainerIcon"
        app:layout_constraintStart_toEndOf="@+id/iconPlaylist"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/playlistCollapsedContainerSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="13dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playlistCollapsedContainerIcon"
        app:layout_constraintStart_toEndOf="@+id/iconPlaylist"
        app:layout_constraintTop_toBottomOf="@+id/playlistCollapsedContainerTitle"/>
    <ImageButton
        android:id="@+id/playlistCollapsedContainerIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:layout_marginVertical="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_chevron_up_20"
        app:tint="?attr/vk_ui_icon_medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
