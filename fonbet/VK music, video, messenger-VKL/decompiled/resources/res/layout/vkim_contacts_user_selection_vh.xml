<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="76dp"
    android:layout_height="80dp">
    <com.vk.im.ui.views.avatars.ImAvatarView
        android:id="@+id/vkim_avatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/vkim_accessibility_avatar"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        style="@style/VkIm.AvatarView"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/vkim_close_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/ic_cancel_24_in_circle_bg_opaque"
        android:contentDescription="@string/accessibility_cancel"
        android:layout_marginEnd="3dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/vkim_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"/>
</FrameLayout>
