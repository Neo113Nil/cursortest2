<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/video_next_stop"
        android:background="@drawable/highlight_circle_white"
        android:layout_width="48dp"
        android:layout_height="48dp">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/video_next_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="false"
            android:indeterminateOnly="false"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/videoNextViewIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/vk_icon_deprecated_ic_videodiscover_timer_stop"
            android:scaleType="center"
            app:tint="?attr/vk_ui_icon_contrast"/>
    </FrameLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:layout_gravity="center_vertical"
        android:id="@+id/videoNextViewText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:text="@string/video_next"
        style="@style/VkUiTypography.Caption1"/>
</merge>
