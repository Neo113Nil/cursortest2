<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.stories.design.view.avatar.StoryAvatarView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_profile_main_info_avatar"
        android:layout_width="@dimen/user_profile_avatar_size"
        android:layout_height="@dimen/user_profile_avatar_size"
        android:importantForAccessibility="no"
        android:layout_marginVertical="2dp"
        app:solidFillAroundAvatarEnabled="true"/>
    <com.vk.stories.design.view.live.LiveShine
        android:layout_gravity="bottom"
        android:id="@+id/live_badge"
        android:background="@drawable/profile_avatar_live_badge"
        android:visibility="visible"
        android:layout_width="48dp"
        android:layout_height="26dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/vk_icon_live_badge_20"
        android:importantForAccessibility="no"
        android:layout_marginStart="86dp"
        app:src_margin="3dp"/>
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="bottom"
        android:id="@+id/iv_error"
        android:background="@drawable/profile_avatar_background"
        android:padding="2.5dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginBottom="7.5dp"
        android:src="@drawable/vk_icon_error_circle_fill_16"
        android:importantForAccessibility="no"
        android:layout_marginStart="104dp"/>
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="bottom"
        android:id="@+id/profile_online"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginBottom="17dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginStart="106dp"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption3Medium.Unscaled"
        android:textColor="@color/vk_white"
        android:layout_gravity="bottom"
        android:id="@+id/profile_offline"
        android:background="@drawable/profile_avatar_offline_badge_background"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:textAlignment="center"
        android:layout_marginStart="104dp"
        android:paddingHorizontal="5dp"
        android:paddingVertical="4dp"/>
</merge>
