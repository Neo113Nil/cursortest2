<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/actionContent"
    android:background="?attr/selectableItemBackground"
    android:layout_width="260dp"
    android:layout_height="44dp">
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="start|center_vertical"
        android:id="@+id/action_icon"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/action_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:lines="1"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="end|center_vertical"
        android:id="@+id/action_check_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginEnd="20dp"
        app:srcCompat="@drawable/vk_icon_done_24"/>
</LinearLayout>
