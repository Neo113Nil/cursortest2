<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:animateLayoutChanges="true">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.FootnoteCapsMedium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vkim_communities_recommendations"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/collapse_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.ParagraphNormal"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/collapse_button"
        android:background="@drawable/ripple_8dp"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/header_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/header_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
