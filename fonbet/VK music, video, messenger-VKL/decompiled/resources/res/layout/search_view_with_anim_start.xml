<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/v_back_btn"
        android:background="@drawable/vkim_ripple_circle_highlight"
        android:visibility="visible"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_back"
        android:alpha="0"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:srcCompat="@drawable/vk_icon_arrow_left_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_search_container"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/fl_bg_left_part"
            android:background="@drawable/vk_bg_card_elevation2_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12.5dp"
            android:backgroundTint="?attr/vk_ui_search_field_background">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/iv_icon_search"
                android:background="@drawable/highlight_unlimited"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="centerInside"
                android:layout_marginStart="12dp"
                app:srcCompat="@drawable/vk_icon_search_outline_16"
                app:tint="?attr/vk_ui_icon_medium"/>
        </FrameLayout>
        <View
            android:id="@+id/fl_bg_right_part"
            android:background="@drawable/vk_bg_card_elevation2_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="14dp"
            android:backgroundTint="?attr/vk_ui_search_field_background"/>
    </LinearLayout>
    <com.vk.internal.core.ui.edittext.PlainEditText
        android:textSize="16sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:textColorHint="?attr/vk_ui_vkontakte_color_search_bar_field_tint"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/etv_search"
        android:background="@null"
        android:paddingBottom="1dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/search"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:lineSpacingExtra="4sp"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionSearch"
        android:fontFamily="sans-serif"
        android:paddingStart="53dp"
        android:paddingEnd="40dp"
        android:layout_marginEnd="14dp"
        android:letterSpacing="0.01"/>
    <LinearLayout
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="20dp">
        <ImageView
            android:id="@+id/iv_icon_params"
            android:background="@drawable/vkim_ripple_circle_highlight"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/talkback_ic_search_params"
            app:srcCompat="@drawable/vk_icon_filter_24"
            app:tint="?attr/vk_ui_icon_medium"/>
        <FrameLayout
            android:id="@+id/v_icon_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp">
            <ImageView
                android:id="@+id/iv_icon_voice"
                android:background="@drawable/vkim_ripple_circle_highlight"
                android:visibility="visible"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/talkback_ic_voice"
                app:srcCompat="@drawable/vk_icon_voice_outline_24"
                app:tint="?attr/vk_ui_icon_medium"/>
            <ImageView
                android:id="@+id/iv_icon_cancel"
                android:background="@drawable/vkim_ripple_circle_highlight"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/talkback_ic_cancel"
                android:alpha="0"
                app:srcCompat="@drawable/vk_icon_cancel_24"
                app:tint="?attr/vk_ui_icon_medium"/>
        </FrameLayout>
    </LinearLayout>
</merge>
