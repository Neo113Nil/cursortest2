<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.vkblur.VkBlurView
        android:layout_gravity="center"
        android:id="@+id/content_badge_blur_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toEndOf="@+id/content"
        app:layout_constraintStart_toStartOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/content_badge_blur_stroke"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toEndOf="@+id/content"
        app:layout_constraintStart_toStartOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/before"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.vk.core.ui.themes.VKReplacerView
                android:layout_gravity="center"
                android:id="@+id/left_picture_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.vk.core.ui.themes.VKReplacerView
                android:layout_gravity="center"
                android:id="@+id/left_avatar_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/left_icon_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <View
            android:id="@+id/gap_icon_title"
            android:layout_width="wrap_content"
            android:layout_height="0dp"/>
        <com.vk.core.view.components.text.VkFadeText
            android:textAppearance="?attr/vk_ui_typography_footnote_medium"
            android:textColor="?attr/vk_ui_text_contrast"
            android:ellipsize="none"
            android:layout_gravity="center"
            android:id="@+id/badge_title_fade"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_weight="1"
            app:layout_constraintWidth_default="wrap"/>
        <TextView
            android:textAppearance="?attr/vk_ui_typography_footnote_medium"
            android:textColor="?attr/vk_ui_text_contrast"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/badge_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            app:layout_constraintWidth_default="wrap"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/gap_title_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="0dp"/>
        <TextView
            android:textAppearance="?attr/vk_ui_typography_footnote_bold"
            android:textColor="?attr/vk_ui_text_contrast"
            android:layout_gravity="center"
            android:id="@+id/badge_subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintWidth_default="wrap"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/gap_title_trailing_icon"
            android:layout_width="wrap_content"
            android:layout_height="0dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/trailing_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
