<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.ProgressView
        android:layout_gravity="center"
        android:id="@+id/progress_view"
        android:layout_width="@dimen/post_attach_common_icon_size"
        android:layout_height="@dimen/post_attach_common_icon_size"
        app:upload_cancelIcon="@drawable/vk_icon_cancel_24"
        app:upload_cancelIconTintColor="@color/vk_white"
        app:upload_cancelIconVisible="true"
        app:upload_layerColor="@color/vkim_background_dim"
        app:upload_lineColor="@color/vk_white"
        app:upload_lineWidth="2dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/error_view"
        android:background="@drawable/gray_oval"
        android:padding="4dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/post_attach_common_icon_size"
        android:layout_height="@dimen/post_attach_common_icon_size"
        android:foreground="@drawable/highlight_radius_14"
        android:src="@drawable/vk_icon_replay_36"
        android:contentDescription="@string/retry"
        android:backgroundTint="@color/vkim_background_dim"
        app:tint="@color/vk_white"/>
</FrameLayout>
