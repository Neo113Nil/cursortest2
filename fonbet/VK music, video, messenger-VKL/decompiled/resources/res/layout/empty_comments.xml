<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.TintTextView
        android:textAppearance="@style/VkUiTypography.Headline"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/empty_comments_tv"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/comments_empty_title"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:drawableTint="?attr/vk_ui_icon_secondary"/>
</FrameLayout>
