<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:id="@+id/vk_form_item_layout_label"
            android:paddingTop="@dimen/vk_ui_spacing_size2_xs"
            android:focusable="true"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            style="?attr/vk_ui_typography_subhead_normal"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/vk_form_item_layout_after_text"
            android:paddingTop="@dimen/vk_ui_spacing_size2_xs"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="-1sp"
            android:importantForAccessibility="no"
            style="?attr/vk_ui_typography_footnote"/>
    </LinearLayout>
    <FrameLayout
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/vk_form_item_layout_container"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size_m">
            <ImageButton
                android:layout_gravity="end|center_vertical"
                android:id="@+id/vk_form_item_layout_end_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/vk_ui_form_item_padding_vertical"
                android:elevation="1dp"
                app:tint="?attr/vk_ui_icon_secondary"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/vk_form_item_layout_right_extra_icon_button"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:scaleType="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </FrameLayout>
    <TextView
        android:textColor="@color/ds_internal_form_item_caption"
        android:id="@+id/vk_form_item_layout_caption"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
        style="?attr/vk_ui_typography_footnote"/>
</merge>
