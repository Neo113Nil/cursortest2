<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <FrameLayout
        android:id="@+id/music_line_link_1"
        android:layout_width="@dimen/music_catalog_link_item_width"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/music_line_link_2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/catalog_link"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/music_line_link_2"
        android:layout_width="@dimen/music_catalog_link_item_width"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/music_line_link_3"
        app:layout_constraintStart_toEndOf="@+id/music_line_link_1"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/catalog_link"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/music_line_link_3"
        android:layout_width="@dimen/music_catalog_link_item_width"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/music_line_link_4"
        app:layout_constraintStart_toEndOf="@+id/music_line_link_2"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/catalog_link"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/music_line_link_4"
        android:layout_width="@dimen/music_catalog_link_item_width"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/music_line_link_3"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/catalog_link"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
