<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/liveCommentUserPic"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="centerCrop"
        app:avatarImageSize="34dp"/>
    <View
        android:id="@+id/liveCommentAuthorBadge"
        android:background="@drawable/vk_icon_star_circle_fill_blue_16"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp">
        <com.vk.core.view.components.text.links.VkLinkedText
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/liveCommentUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:text=""
            android:singleLine="true"
            android:drawablePadding="4dp"
            android:layout_marginEnd="20dp"
            style="@style/VkUiTypography.SubheadMedium.Unscaled"/>
        <com.vk.core.view.components.text.links.VkLinkedText
            android:textColor="@color/vk_white"
            android:gravity="left"
            android:id="@+id/liveCommentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginEnd="20dp"
            style="@style/VkUiTypography.Subhead.Unscaled"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="bottom|right"
        android:id="@+id/liveCommentLike"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:src="@drawable/vk_icon_like_16"
        app:tint="@color/vk_red_nice"/>
</merge>
