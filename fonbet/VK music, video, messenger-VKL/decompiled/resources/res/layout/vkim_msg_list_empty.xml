<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/msg_list_container"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:layout_marginBottom="34dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:layout_marginStart="54dp"
        android:layout_marginEnd="54dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:minWidth="56dp"
            android:minHeight="56dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/vk_icon_ghost_outline_56"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Text"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vkim_msg_list_empty"/>
        <com.vk.superapp.ui.FixTextView
            android:textAppearance="@style/VkUiTypography.Text"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vkim_msg_list_empty_subtitle"/>
        <com.vk.im.ui.views.avatars.AvatarView
            android:layout_gravity="center_horizontal"
            android:id="@+id/avatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Title2"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/name_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_tertiary"
            android:gravity="center"
            android:id="@+id/name_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"/>
        <com.vk.superapp.ui.FixTextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:gravity="center"
            android:id="@+id/motivation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/VkUiTypography.Text"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/hint_container"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <ImageView
                android:id="@+id/hint_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:tint="?attr/vk_ui_icon_secondary"/>
            <com.vk.im.ui.views.avatars.StackAvatarView
                android:layout_gravity="center"
                android:id="@+id/hint_avatars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:layout_marginBottom="-2dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginEnd="-2dp"
                app:vkim_drawingOrder="reversed"
                app:vkim_iconOffset="-6dp"
                app:vkim_iconSize="24dp"
                app:vkim_strokeColor="?attr/vk_ui_background_content"
                app:vkim_strokeWidth="2dp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Paragraph"
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="center"
            android:id="@+id/friends_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="4dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="small"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="center"
            android:id="@+id/open_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vkim_msg_list_empty_open_profile"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"
            app:buttonSizeType="small"/>
    </LinearLayout>
    <com.vk.im.design.view.placeholder.ImPlaceholder
        android:layout_gravity="center"
        android:id="@+id/msg_list_container_redesign"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_xl"/>
    <include
        android:id="@+id/empty_channel_root"
        android:visibility="gone"
        layout="@layout/vkim_empty_channel_author_stub"/>
    <include
        android:id="@+id/empty_vk_app_channel_root"
        android:visibility="gone"
        layout="@layout/vkapp_empty_channel_author_stub"/>
    <com.vk.im.design.view.placeholder.ImChipPlaceholder
        android:layout_gravity="center"
        android:id="@+id/chip_placeholder"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_xl"/>
</FrameLayout>
