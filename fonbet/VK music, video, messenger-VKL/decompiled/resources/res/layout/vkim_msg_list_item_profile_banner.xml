<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_rounded_corners_12"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="275dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.im.ui.views.avatars.AvatarView
            android:id="@+id/edu_conversation_member_avatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_centerVertical="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkIm.AvatarView"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/edu_conversation_member_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edu_conversation_member_avatar"
            style="@style/VkLegacyTypography.Title1"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_subhead"
            android:gravity="center"
            android:id="@+id/edu_conversation_member_organization"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edu_conversation_member_name"
            style="@style/VkUiTypography.FootnoteNormal"/>
        <View
            android:id="@+id/edu_conversation_content_separator"
            android:background="@drawable/separator_gradient_gray"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edu_conversation_member_organization"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/vk_legacy_text_subhead"
            android:gravity="center"
            android:id="@+id/edu_conversation_request_state_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edu_conversation_content_separator"
            style="@style/VkLegacyTypography.Subhead1"/>
        <Button
            android:textColor="?attr/vk_ui_text_negative"
            android:id="@+id/edu_conversation_btn_first"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="16dp"
            app:layout_constraintEnd_toStartOf="@+id/edu_conversation_btn_second"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edu_conversation_request_state_info"
            style="@style/VkLegacyButton.Secondary"/>
        <Button
            android:id="@+id/edu_conversation_btn_second"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginVertical="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/edu_conversation_btn_first"
            app:layout_constraintTop_toBottomOf="@+id/edu_conversation_request_state_info"
            style="@style/VkLegacyButton.Secondary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
