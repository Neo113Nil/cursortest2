<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:paddingHorizontal="16dp">
    <FrameLayout
        android:id="@+id/icon_wrap"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/reaction_icon"
            android:background="@drawable/bg_reaction"
            android:padding="4dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="false"
            app:lottie_progress="1"/>
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="end|top"
            android:id="@+id/reaction_badge"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/reaction_cancel"
            android:background="@drawable/circle_gray_background"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:tint="@color/vk_white"
            android:translationZ="1dp"
            android:backgroundTint="?attr/vk_ui_avatar_overlay"
            android:clipToOutline="true"
            app:srcCompat="@drawable/vk_icon_cancel_16"/>
    </FrameLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="start"
        android:id="@+id/reaction_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        app:layout_constraintBottom_toTopOf="@+id/reaction_description"
        app:layout_constraintLeft_toRightOf="@+id/icon_wrap"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/icon_wrap"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.TextNormal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary_alpha"
        android:gravity="start"
        android:id="@+id/reaction_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="13dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon_wrap"
        app:layout_constraintLeft_toRightOf="@+id/icon_wrap"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reaction_text"
        style="@style/VkUiTypography.FootnoteNormal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
