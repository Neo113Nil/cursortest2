<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/clip_empty_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/vk_icon_logo_clips_outline_56"
        app:tint="@color/vk_gray_400"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/clip_empty_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/my_clips_empty_stub_title"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        style="@style/VkUiTypography.Title2Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_gray_300"
        android:gravity="center_horizontal"
        android:id="@+id/clip_empty_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/clip_feed_empty_stub_title"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/create_clip"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/clip_grid_record_own_clip"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</LinearLayout>
