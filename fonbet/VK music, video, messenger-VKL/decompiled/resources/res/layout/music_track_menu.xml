<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center"
        android:background="@drawable/music_track_menu_tongue"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/audio_bottom_sheet_header_remaining_time"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="47dp"
        style="@style/VkUiTypography.Footnote"/>
    <View
        android:id="@+id/top_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.music.view.ThumbsImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/audio_image"
            android:layout_width="@dimen/music_track_image"
            android:layout_height="@dimen/music_track_image"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toTopOf="@+id/foreign_agent_notice_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="@dimen/music_image_rounding_corners"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_song_outline_28"
            app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
        <ImageView
            android:id="@+id/audio_playing_indicator"
            android:background="@drawable/music_dark_round_rect"
            android:visibility="gone"
            android:layout_width="@dimen/music_track_image"
            android:layout_height="@dimen/music_track_image"
            app:layout_constraintBottom_toBottomOf="@+id/audio_image"
            app:layout_constraintEnd_toEndOf="@+id/audio_image"
            app:layout_constraintStart_toStartOf="@+id/audio_image"
            app:layout_constraintTop_toTopOf="@+id/audio_image"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Text"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/audio_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:maxLines="1"
            android:drawablePadding="3dp"
            android:layout_marginStart="9dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/iv_explicit"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/audio_image"
            app:layout_constraintTop_toTopOf="@+id/audio_image"
            app:layout_goneMarginEnd="16dp"/>
        <ImageView
            android:id="@+id/iv_explicit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="@dimen/android_4_fix"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/audio_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/audio_title"
            app:layout_goneMarginEnd="16dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/audio_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="16dp"
            android:maxLines="1"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/audio_title"
            app:layout_constraintTop_toBottomOf="@+id/audio_title"
            app:layout_goneMarginEnd="16dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/adult_content_tv"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/music_track_age_restriction"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/audio_title"
            app:layout_constraintTop_toBottomOf="@+id/audio_artist"
            style="@style/VkUiTypography.Footnote"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/foreign_agent_notice_tv"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:text="@string/music_track_foreign_agent"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/audio_image"
            app:layout_constraintTop_toBottomOf="@+id/adult_content_tv"
            style="@style/VkUiTypography.FootnoteNormal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/actions_block"
        android:layout_width="match_parent"
        android:layout_height="67dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/music_action_toggle_download"
            android:background="@drawable/music_selectable_bg"
            android:layout_width="0dp"
            android:layout_height="67dp"
            android:layout_weight="1">
            <com.vk.music.design.view.download.DownloadingView
                android:id="@+id/downloading"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:tint="?attr/vk_ui_icon_accent"
                app:downloaded_icon="@drawable/vk_icon_download_check_outline_24"
                app:loading_width="2dp"
                app:not_loaded_icon="@drawable/vk_icon_download_outline_24"
                app:pending_icon="@drawable/vk_icon_download_outline_24"
                app:pending_tint="?attr/vk_ui_icon_accent"
                app:show_not_loaded="true"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption2Medium"
                android:textColor="?attr/vk_ui_text_accent"
                android:id="@+id/label_downloading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/music_track_menu_download"/>
        </LinearLayout>
        <View
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/music_action_broadcast"
            android:background="@drawable/music_selectable_bg"
            android:layout_width="0dp"
            android:layout_height="67dp"
            android:layout_weight="1"
            android:contentDescription="@string/music_talkback_broadcast">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                app:srcCompat="@drawable/vk_icon_similar_24"
                app:tint="?attr/vk_ui_icon_accent"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption2Medium"
                android:textColor="?attr/vk_ui_text_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/music_track_menu_broadcast"/>
        </LinearLayout>
        <View
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/music_action_share"
            android:background="@drawable/music_selectable_bg"
            android:layout_width="0dp"
            android:layout_height="67dp"
            android:layout_weight="1"
            android:contentDescription="@string/music_talkback_share">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                app:srcCompat="@drawable/vk_icon_share_outline_28"
                app:tint="?attr/vk_ui_icon_accent"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption2Medium"
                android:textColor="?attr/vk_ui_text_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/music_track_menu_share"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</LinearLayout>
