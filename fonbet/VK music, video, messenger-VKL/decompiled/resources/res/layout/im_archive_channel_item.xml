<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.AvatarView
        android:id="@+id/channelAvatarView"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Title3Medium"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/channelTitleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/channelDescriptionView"
        app:layout_constraintEnd_toStartOf="@+id/archiveButton"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/channelAvatarView"
        app:layout_constraintTop_toTopOf="@+id/channelAvatarView"
        app:layout_goneMarginEnd="48dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Paragraph"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/channelDescriptionView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/channelAvatarView"
        app:layout_constraintEnd_toStartOf="@+id/archiveButton"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/channelAvatarView"
        app:layout_constraintTop_toBottomOf="@+id/channelTitleView"
        app:layout_goneMarginEnd="48dp"/>
    <ImageView
        android:id="@+id/archiveButton"
        android:padding="4dp"
        android:visibility="invisible"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/vk_icon_unarchive_outline_28"
        android:scaleType="center"
        android:contentDescription="@string/vkim_dialog_unarchive"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/channelAvatarView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/channelAvatarView"
        app:tint="?attr/vk_ui_icon_accent"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:gravity="center"
        android:id="@+id/radioButton"
        android:focusable="false"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/channelAvatarView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/channelAvatarView"
        style="@style/VkCircleCheckBox"/>
</androidx.constraintlayout.widget.ConstraintLayout>
