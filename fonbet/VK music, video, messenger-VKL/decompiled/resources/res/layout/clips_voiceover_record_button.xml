<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/clips_editor_voiceover_view_button_idle"
        android:background="@drawable/clips_editor_voiceover_button_idle_background"
        android:visibility="visible"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/accessibility_timeline_voiceover_start_record"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/clips_editor_voiceover_button_img"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            app:tint="@color/vk_white"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/clips_editor_voiceover_view_button_record"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/accessibility_timeline_voiceover_stop_record"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center"
            android:id="@+id/clips_editor_voiceover_view_button_record_shape"
            android:background="@drawable/clips_editor_voiceover_button_record_background"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:alpha="0.25"
            android:importantForAccessibility="no"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/clips_editor_voiceover_view_button_record_center_shape"
            android:background="@drawable/clips_editor_voiceover_button_record_background_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"/>
    </FrameLayout>
</merge>
