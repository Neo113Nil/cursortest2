<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_editor_rounded_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false">
    <RelativeLayout
        android:id="@+id/collageMainWrapper"
        android:background="@drawable/bg_editor_rounded_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.photo.editor.features.collage.gl.GLCollageView
            android:id="@+id/glCollageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/gridWrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.photo.editor.features.collage.view.CollageBorderView
            android:id="@+id/borderView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <View
        android:id="@+id/selection"
        android:background="@drawable/bg_slot_selected"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
