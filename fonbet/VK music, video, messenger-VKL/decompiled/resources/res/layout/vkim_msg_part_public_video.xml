<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.BlurredFrameLayout
        android:id="@+id/video_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.libvideo.design.view.videotexture.VideoTextureView
            android:layout_gravity="center_horizontal"
            android:id="@+id/video_display"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxHeight="@dimen/im_public_video_max_video_wrapper_width"
            android:contentDescription="@string/vkim_accessibility_video"/>
        <com.vk.core.view.fresco.VKEnhancedImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/preview"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxHeight="@dimen/im_public_video_max_video_wrapper_width"
            android:contentDescription="@string/vkim_accessibility_video"
            app:imageScaleType="center_crop_upscale"/>
        <com.vk.libvideo.design.view.overlay.VideoOverlayView
            android:id="@+id/overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:vov_size="medium"/>
        <com.vk.im.ui.views.msg.TimeAndStatusView
            android:textAppearance="@style/VkIm.MsgPart.Time.TextContrast"
            android:layout_gravity="end|bottom"
            android:id="@+id/timeAndStatus"
            android:background="?attr/im_msg_part_time_contrast_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:importantForAccessibility="noHideDescendants"/>
    </com.vk.im.ui.views.BlurredFrameLayout>
    <View
        android:id="@+id/selection_mask"
        android:background="@color/vkim_msg_part_selection_mask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/video_wrapper"
        app:layout_constraintEnd_toEndOf="@+id/video_wrapper"
        app:layout_constraintStart_toStartOf="@+id/video_wrapper"
        app:layout_constraintTop_toTopOf="@+id/video_wrapper"/>
    <ImageView
        android:id="@+id/play_button"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/vk_icon_play_button_56"
        app:layout_constraintBottom_toBottomOf="@+id/video_wrapper"
        app:layout_constraintEnd_toEndOf="@+id/video_wrapper"
        app:layout_constraintStart_toStartOf="@+id/video_wrapper"
        app:layout_constraintTop_toTopOf="@+id/video_wrapper"/>
    <com.vk.libvideo.design.view.play.PlayButton
        android:id="@+id/replay"
        android:background="@drawable/highlight_video_play"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_wrapper"
        app:layout_constraintEnd_toEndOf="@+id/video_wrapper"
        app:layout_constraintStart_toStartOf="@+id/video_wrapper"
        app:layout_constraintTop_toTopOf="@+id/video_wrapper"
        app:srcCompat="@drawable/vk_icon_replay_36"
        app:tint="@color/vk_white"/>
    <View
        android:id="@+id/sound_control"
        android:background="@drawable/ic_sound_off_shadow_48"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/duration_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.libvideo.design.view.duration.DurationView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:font_family="regular"
            app:font_size="11"/>
        <com.vk.libvideo.design.view.spectators.SpectatorsCounterView
            android:id="@+id/spectators"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:backgroundResId="@drawable/bg_live_inline_spectators_rounded_redesign"/>
    </LinearLayout>
    <com.vk.libvideo.design.view.error.VideoErrorView
        android:gravity="center"
        android:id="@+id/error"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_wrapper"
        app:layout_constraintEnd_toEndOf="@+id/video_wrapper"
        app:layout_constraintStart_toStartOf="@+id/video_wrapper"
        app:layout_constraintTop_toTopOf="@+id/video_wrapper"/>
    <FrameLayout
        android:id="@+id/video_inline_live_holder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_wrapper"
        app:layout_constraintEnd_toEndOf="@+id/video_wrapper"
        app:layout_constraintStart_toStartOf="@+id/video_wrapper"
        app:layout_constraintTop_toTopOf="@+id/video_wrapper"/>
    <com.vk.core.widget.AutoFitTextView
        android:textAppearance="@style/VkIm.MsgPart.Label.TextContrast"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/label"
        android:background="@drawable/vkim_bg_video_mosaic_duration"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:lines="1"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:maxTextSize="12sp"
        app:minTextSize="8sp"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_wrapper"
        style="@style/VkUiTypography.Paragraph"/>
    <com.vk.im.ui.views.msg.video.AdaptiveTimeAndStatusLayout
        android:id="@+id/subtitle_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/owner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/verification_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/VkUiTypography.Footnote"/>
        <ImageView
            android:id="@+id/verification_icon"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/vk_icon_check_12"
            android:importantForAccessibility="no"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/subtitle"
            app:layout_constraintStart_toEndOf="@+id/owner"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/verification_icon"
            style="@style/VkUiTypography.Footnote"/>
    </com.vk.im.ui.views.msg.video.AdaptiveTimeAndStatusLayout>
    <com.vk.libvideo.design.view.actionlink.ActionLinkView
        android:id="@+id/video_action_link_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_marginStart="8dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="@+id/video_wrapper"
        app:layout_constraintHeight_min="30dp"
        app:layout_constraintStart_toStartOf="@+id/video_wrapper"/>
</androidx.constraintlayout.widget.ConstraintLayout>
