<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Title 1"
        style="@style/VkLegacyTypography.Title1"/>
    <TextView
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Title 2"
        style="@style/VkLegacyTypography.Title2"/>
    <TextView
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Headline"
        style="@style/VkLegacyTypography.Headline"/>
    <TextView
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Text"
        style="@style/VkLegacyTypography.Text"/>
    <TextView
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subhead 1"
        style="@style/VkLegacyTypography.Subhead1"/>
    <TextView
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subhead 2"
        style="@style/VkLegacyTypography.Subhead2"/>
    <TextView
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caption 1"
        style="@style/VkLegacyTypography.Caption1"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caption 2"
        style="@style/VkLegacyTypography.Caption2"/>
</LinearLayout>
