<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/vk_black_alpha20">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/author_image"
        android:layout_width="@dimen/live_upcoming_author_image_size_nft"
        android:layout_height="@dimen/live_upcoming_author_image_size_nft"
        android:layout_marginTop="@dimen/live_upcoming_author_image_margin_top_nft"
        app:borderWidth="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/live_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/live_upcoming_title_margin_top_nft"
        android:maxLines="1"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/author_image"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/live_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/live_time_left_label"
        android:maxLines="1"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_title"
        app:layout_goneMarginTop="8dp"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <com.vk.clips.design.view.timer.TimerView
        android:id="@+id/live_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_description"/>
    <com.vk.core.view.components.spinner.VkScreenSpinner
        android:layout_gravity="center"
        android:id="@+id/subscribe_loader"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/subscribe_button"
        app:layout_constraintEnd_toEndOf="@+id/subscribe_button"
        app:layout_constraintStart_toStartOf="@+id/subscribe_button"
        app:layout_constraintTop_toTopOf="@+id/subscribe_button"
        app:spinnerMode="dropdown"
        app:spinnerSize="medium"
        app:spinnerState="loading"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/subscribe_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_timer"/>
    <com.vk.core.view.components.spinner.VkScreenSpinner
        android:layout_gravity="center"
        android:id="@+id/notification_loader"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/notification_button"
        app:layout_constraintEnd_toEndOf="@+id/notification_button"
        app:layout_constraintStart_toStartOf="@+id/notification_button"
        app:layout_constraintTop_toTopOf="@+id/notification_button"
        app:spinnerMode="dropdown"
        app:spinnerSize="medium"
        app:spinnerState="loading"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/notification_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:buttonAppearance="overlay"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subscribe_button"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/recommended_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="recommended_watch_next,recommended,recommended_divider"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/recommended_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.7"/>
    <View
        android:id="@+id/recommended_divider"
        android:background="@color/vk_gray_750"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/recommended_watch_next"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/recommended_watch_next"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/live_watch_next"
        app:layout_constraintBottom_toTopOf="@+id/recommended"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <com.vk.libvideo.design.view.recommended.RecommendedView
        android:id="@+id/recommended"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommended_guideline"/>
</merge>
