<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="2dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.Title2Medium"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stickers_suggest_add_dialog_title"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="@string/stickers_suggest_add_dialog_subtitle"/>
    <EditText
        android:id="@+id/edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="5dp"
        android:hint="@string/stickers_suggest_add_dialog_hint"
        android:maxLines="1"
        android:lines="1"
        android:inputType="text"
        android:imeOptions="flagNoExtractUi"
        android:importantForAutofill="no"
        style="@style/VKUIEditText"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:text="@string/stickers_suggest_add_dialog_min"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="7dp"
        android:maxHeight="44dp"
        android:text="@string/save"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</LinearLayout>
