<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/image_container"
        android:background="@drawable/bg_story_post_video_attach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/restriction_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@+id/restriction_text"
        app:layout_constraintEnd_toEndOf="@+id/image_container"
        app:layout_constraintStart_toStartOf="@+id/image_container"
        app:layout_constraintTop_toTopOf="@+id/image_container"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="@color/vk_steel_gray_400"/>
    <TextView
        android:textColor="@color/vk_steel_gray_400"
        android:id="@+id/restriction_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lines="2"
        android:textAlignment="center"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_container"
        app:layout_constraintEnd_toEndOf="@+id/restriction_icon"
        app:layout_constraintStart_toStartOf="@+id/restriction_icon"
        app:layout_constraintTop_toBottomOf="@+id/restriction_icon"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Headline1Normal"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/duration"
        android:background="@drawable/bg_video_duration"
        android:paddingTop="1dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_container"
        app:layout_constraintEnd_toEndOf="@+id/image_container">
        <ImageView
            android:id="@+id/play_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="1dp"
            android:importantForAccessibility="no"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1Medium"
            android:textColor="@color/vk_white"
            android:id="@+id/duration_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
