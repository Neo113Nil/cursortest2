<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/video_profile_new_v2_motion_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutDescription="@xml/vk_video_new_profile_v2_motion_scene_tablet">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/video_profile_new_v2_appbar_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/video_profile_new_v2_halfscreen_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/video_profile_new_v2_cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/video_profile_new_v2_cover_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <include
                android:id="@+id/video_profile_new_v2_cover_stub"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/vk_video_profile_cover_stub_view"/>
            <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
                android:id="@+id/video_profile_new_v2_cover_shimmer"
                android:background="?attr/vk_ui_background_secondary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:id="@+id/video_profile_new_v2_cover_shadow"
                android:background="@drawable/vk_scrim_top"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:alpha="0.3"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <com.vk.video.profile.presentation.views.VideoNewProfileHeaderViewV2
            android:id="@+id/video_profile_new_v2_header_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/video_profile_new_v2_sections_container_bottom"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/video_profile_new_v2_list_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <include
                android:id="@+id/video_profile_new_v2_anonymous_hint"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/vk_video_profile_anonymous_hint_v2_tablet"/>
            <com.vk.core.view.components.placeholder.VkPlaceholder
                android:layout_gravity="center"
                android:id="@+id/video_profile_new_v2_connection_error_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.video.profile.presentation.views.VideoProfileCatalogSkeletonView
                android:id="@+id/video_profile_new_v2_catalog_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/video_profile_new_v2_root_error_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vk_video_loading_error_text"
                style="@style/VkUiTypography.Title1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/video_profile_new_v2_root_reload_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vk_video_loading_retry"
                style="@style/VkUiTypography.Subhead"/>
        </LinearLayout>
        <com.vk.video.profile.presentation.views.VideoNewProfileToolbarV2
            android:id="@+id/video_profile_new_v2_toolbar"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
    </androidx.constraintlayout.motion.widget.MotionLayout>
</merge>
