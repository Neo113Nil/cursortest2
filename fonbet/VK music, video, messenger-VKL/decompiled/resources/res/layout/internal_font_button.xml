<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:layout_width="50dp"
    android:layout_height="40dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_outside_border"
        android:layout_width="44dp"
        android:layout_height="34dp"
        android:src="@drawable/bg_color_button_border_outside"
        android:importantForAccessibility="no"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_selected_outside_border"
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:src="@drawable/bg_color_button_border_outside_selected"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="44dp"
        android:layout_height="34dp">
        <ImageView
            android:id="@+id/image_inside_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_color_button_border_inside"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_selected_inside_border"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_color_button_border_inside_selected"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="18dp"
        android:textColor="#ffe1e3e6"
        android:layout_gravity="center"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aa"
        android:importantForAccessibility="no"/>
</FrameLayout>
