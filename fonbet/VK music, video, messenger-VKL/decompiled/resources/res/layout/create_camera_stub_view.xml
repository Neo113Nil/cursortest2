<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.media.ok.recording.RecognitionView
        android:id="@+id/gesture_recognition_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.cameraui.widgets.ClipsProgressView
        android:id="@+id/camera_clips_progress_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/top_right_button"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:layout_margin="@dimen/camera_icon_margin"
        android:foreground="@drawable/white_ripple_circle"
        android:src="@drawable/vk_icon_cancel_outline_shadow_large_48_close"
        android:contentDescription="@string/story_accessibility_return_to_newsfeed"/>
    <com.vk.clips.design.view.recording.StopwatchView
        android:layout_gravity="center"
        android:id="@+id/recording_timer_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="left"
        android:id="@+id/top_left_button"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:layout_margin="@dimen/camera_icon_margin"
        android:foreground="@drawable/bg_btn_white_selector"
        android:src="@drawable/vk_icon_settings_outline_shadow_large_48"
        android:contentDescription="@string/story_accessibility_settings"/>
    <ImageView
        android:id="@+id/clips_close_btn"
        android:visibility="gone"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:layout_margin="@dimen/camera_icon_margin"
        android:foreground="@drawable/white_ripple_unbounded"
        android:src="@drawable/vk_icon_cancel_outline_shadow_large_48_close"
        android:contentDescription="@string/accessibility_close"/>
    <ImageView
        android:id="@+id/sharing_icon"
        android:visibility="gone"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:layout_marginTop="@dimen/camera_icon_margin"
        android:foreground="@drawable/white_ripple_unbounded"
        android:src="@drawable/ic_story_repost_48"
        android:layout_marginStart="52dp"/>
    <com.vk.content.design.view.camera.AttachWithCounterView
        android:id="@+id/collection_button"
        android:visibility="gone"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:layout_marginTop="@dimen/camera_icon_margin"
        android:layout_marginStart="56dp"/>
    <HorizontalScrollView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/camera_ui_previews_wrapper"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="70dp"
        android:alpha="0">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/camera_ui_previews_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:divider="@drawable/divider_camera_preview_item"
            android:animateLayoutChanges="true"
            android:showDividers="end|middle"/>
    </HorizontalScrollView>
    <com.vk.content.design.view.camera.ShutterButton
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/shutter"
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_shutter_tabs_height"
        android:layout_marginLeft="@dimen/story_shutter_horizontal_margin"
        android:layout_marginRight="@dimen/story_shutter_horizontal_margin"
        android:layout_marginBottom="@dimen/story_shutter_bottom_margin"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Paragraph"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/vmoji_capture_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/camera_vmoji_capture_tip_margin"
        android:text="@string/camera_ui_vmoji_capture_tip"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/camera_tabs_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="bottom"
            android:id="@+id/camera_tabs_bottom_gradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.clips.design.view.camera.widgets.TabsRecycler
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tabs"
            android:paddingTop="24dp"
            android:layout_width="4000dp"
            android:layout_height="68dp"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/camera_clips_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/current_masks_button"
            android:background="@drawable/bg_rounded_10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/vk_black_alpha60"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/camera_clips_next_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="0dp">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/current_masks_button_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/circle_gray_placeholder"
                app:roundAsCircle="true"
                app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
                app:roundingBorderWidth="0.33dp"/>
            <TextView
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:id="@+id/current_masks_button_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.5dp"
                android:lines="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/current_masks_button_divider"
                app:layout_constraintStart_toEndOf="@+id/current_masks_button_avatar"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/VkUiTypography.Paragraph"/>
            <View
                android:id="@+id/current_masks_button_divider"
                android:background="@color/vk_white_alpha60"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/current_masks_button_close"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/current_masks_button_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/vk_icon_cancel_circle_16"
                android:contentDescription="@string/accessibility_close"
                android:paddingStart="11dp"
                android:paddingEnd="13dp"
                android:paddingVertical="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/vk_white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/camera_clips_next_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/camera_ui_next"
            app:buttonSizeType="medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/gallery_button_top"
        android:background="?attr/vk_ui_overlay_secondary"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/story_accessibility_choose_media_from_gallery"
        android:paddingHorizontal="12dp">
        <com.vk.core.view.components.picture.VkPicture
            android:layout_gravity="center"
            android:id="@+id/photos_button_thumb_top"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:placeholderImage="@color/vk_gray_50"
            app:roundedCornerRadius="4dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_scan_from_photo"
            android:layout_marginStart="8dp"
            style="@style/VkUiTypography.Headline2"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.clips.design.view.camera.controls.ClipsControlsView
            android:id="@+id/clips_controls_view"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/left_holder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/left_holder"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="@dimen/camera_icon_size"
            android:layout_marginBottom="@dimen/camera_bottom_buttons_margin_bottom"
            android:layout_weight="1"
            android:layout_marginEnd="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/right_holder"
            app:layout_constraintStart_toStartOf="parent">
            <FrameLayout
                android:layout_gravity="start"
                android:id="@+id/gallery_button_bottom"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="@dimen/camera_icon_size"
                android:layout_height="@dimen/camera_icon_size"
                android:foreground="@drawable/white_ripple_unbounded"
                android:contentDescription="@string/story_accessibility_choose_media_from_gallery"
                android:layout_marginStart="16dp">
                <com.vk.core.view.components.picture.VkPicture
                    android:layout_gravity="center"
                    android:id="@+id/photos_button_thumb_bottom"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:placeholderImage="@color/vk_gray_50"
                    app:roundedCornerRadius="8dp"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/photos_button_roll_bottom"
                    android:layout_width="@dimen/camera_icon_size"
                    android:layout_height="@dimen/camera_icon_size"/>
            </FrameLayout>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/camera_clips_delete_btn"
                android:visibility="gone"
                android:layout_width="@dimen/camera_icon_size"
                android:layout_height="@dimen/camera_icon_size"
                android:src="@drawable/vk_icon_backspace_shadow_large_48"
                android:contentDescription="@string/story_accessibility_remove_last_fragment"
                android:layout_marginStart="16dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/flash_button"
                android:layout_width="@dimen/camera_icon_size"
                android:layout_height="@dimen/camera_icon_size"
                android:foreground="@drawable/white_ripple_unbounded"
                android:src="@drawable/vk_icon_flash_off_outline_shadow_large_48"
                android:contentDescription="@string/story_accessibility_turn_on_flash"
                android:layout_marginEnd="-32dp"/>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/switch_button_live"
                android:layout_width="@dimen/camera_icon_size"
                android:layout_height="@dimen/camera_icon_size"
                android:foreground="@drawable/white_ripple_unbounded"
                android:src="@drawable/vk_icon_switch_editor_outline_shadow_large_48"
                android:contentDescription="@string/story_accessibility_change_camera"
                android:layout_marginStart="16dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/right_holder"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/camera_bottom_buttons_margin_bottom"
            android:layout_weight="1"
            android:layout_marginStart="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/left_holder">
            <FrameLayout
                android:layout_gravity="end"
                android:id="@+id/masks_button"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="@dimen/camera_icon_size"
                android:layout_height="wrap_content"
                android:foreground="@drawable/white_ripple_unbounded"
                android:contentDescription="@string/story_accessibility_masks"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:id="@+id/masks_button_image"
                    android:layout_width="@dimen/camera_icon_size"
                    android:layout_height="@dimen/camera_icon_size"
                    android:src="@drawable/vk_icon_masks_off_outline_shadow_large_48"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Caption1Medium.Unscaled"
                    android:textColor="@color/vk_white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/masks_button_new_badge"
                    android:background="@drawable/bg_masks_new_badge_big"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginTop="-11dp"
                    android:minWidth="18dp"
                    android:text="2"
                    android:singleLine="true"
                    android:layout_marginEnd="-11dp"/>
                <ImageView
                    android:layout_gravity="end|top"
                    android:id="@+id/masks_button_new_badge_dot"
                    android:visibility="gone"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/ic_camera_red_circle"
                    android:layout_marginEnd="8dp"/>
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/masks_button_sync_badge"
                    android:background="@drawable/vk_icon_clock_circle_fill_16"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginBottom="-11dp"
                    android:minWidth="18dp"
                    android:layout_marginEnd="-11dp"/>
                <ProgressBar
                    android:layout_gravity="bottom"
                    android:id="@+id/camera_masks_progress"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="-2dp"
                    android:layout_marginRight="8dp"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/create_camera_clips_model_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"/>
            </FrameLayout>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/switch_button"
                android:layout_width="@dimen/camera_icon_size"
                android:layout_height="@dimen/camera_icon_size"
                android:foreground="@drawable/white_ripple_unbounded"
                android:src="@drawable/vk_icon_switch_editor_outline_shadow_large_48"
                android:contentDescription="@string/story_accessibility_change_camera"
                android:layout_marginStart="-32dp"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/loader"
        android:background="#24000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/camera_ui_processing_now"
        android:shadowColor="#52000000"
        android:shadowDy="2"
        android:shadowRadius="12"
        android:alpha="0"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/duration_switch"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="135dp"
        app:capsule="true"
        app:contentBadgeAppearance="overlay"
        app:contentBadgeMode="primary"
        app:contentBadgeSize="large"/>
    <com.vk.cameraui.widgets.VideoRecordingTimerView
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/recording_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:singleLine="true"
        android:shadowColor="@color/vk_black_alpha12"
        android:shadowDy="2"
        android:shadowRadius="8"
        style="@style/VkUiTypography.Headline1"/>
    <FrameLayout
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/camera_clips_authors_choose_view"
        android:background="@drawable/white_ripple_bounded_8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"/>
    <com.vk.core.view.components.spinner.VkScreenSpinner
        android:layout_gravity="center"
        android:id="@+id/circular_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:spinnerMode="dialog"
        app:spinnerSize="large"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/media_picker_fragment_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</merge>
