<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dzen_article_item_width"
    android:layout_height="wrap_content">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_dzen_article_skeleton"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/bg_rounded_corners_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="?attr/vk_ui_skeleton_from"/>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
    <View
        android:id="@+id/image_dzen_article_skeleton"
        android:background="@drawable/bg_border_rounded_12_4"
        android:layout_width="0dp"
        android:layout_height="@dimen/dzen_article_image_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/skeleton_dzen_article_line_1"
        android:background="@drawable/bg_rounded_4"
        android:layout_width="150dp"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_dzen_article_skeleton"/>
    <View
        android:id="@+id/skeleton_dzen_article_line_2"
        android:background="@drawable/bg_rounded_2"
        android:layout_width="100dp"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeleton_dzen_article_line_1"/>
    <View
        android:id="@+id/skeleton_dzen_article_button"
        android:background="@drawable/bg_rounded_8"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="?attr/vk_ui_background_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeleton_dzen_article_line_2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
