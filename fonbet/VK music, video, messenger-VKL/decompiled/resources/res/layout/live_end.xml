<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/liveEndViewBack"
        android:background="@color/vk_black_alpha15"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/liveEndViewLinear"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/liveEndViewContainer1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/liveEndViewTopLinearHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.vk.core.view.components.avatar.VkAvatar
                    android:id="@+id/liveEndUserImage"
                    android:layout_width="64dp"
                    android:layout_height="64dp"/>
                <com.vk.core.view.components.text.links.VkLinkedText
                    android:textAppearance="@style/VkUiTypography.HeadlineBold"
                    android:textColor="@color/vk_white"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/liveEndUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="2"
                    android:elevation="@dimen/vk_ui_elevation_two"/>
                <com.vk.core.view.components.text.VkText
                    android:textAppearance="@style/VkUiTypography.HeadlineNormal"
                    android:textColor="@color/vk_white"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/liveEndText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_video_ended"
                    android:maxLines="1"
                    android:elevation="@dimen/vk_ui_elevation_two"/>
                <com.vk.libvideo.live.impl.views.addbutton.AddButtonView
                    android:id="@+id/liveEndAddButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.AppCompat.Button.Colored"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/liveEndViewContainer2"
            android:background="@drawable/bg_live_recommended_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.4">
            <View
                android:id="@+id/liveEndDelimiter"
                android:background="#18ffffff"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.TextMedium"
                android:textColor="@color/vk_white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/liveEndWatchNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="18dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:text="@string/live_watch_next"
                android:elevation="@dimen/vk_ui_elevation_two"/>
            <com.vk.libvideo.design.view.recommended.RecommendedView
                android:id="@+id/liveEndRecommended"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="56dp"/>
        </FrameLayout>
    </LinearLayout>
    <com.vk.libvideo.live.impl.views.addbutton.AddImgButtonView
        android:layout_gravity="top|right"
        android:id="@+id/liveEndAddImgButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="48dp"/>
</merge>
