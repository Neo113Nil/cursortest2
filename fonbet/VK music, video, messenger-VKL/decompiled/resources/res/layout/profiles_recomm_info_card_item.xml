<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/friend_recomm_item_bg"
    android:layout_width="138dp"
    android:layout_height="246dp"
    android:foreground="@drawable/highlight">
    <com.vk.core.ui.VKSnippetImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/photo"
        android:layout_width="138dp"
        android:layout_height="138dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_marginTop="138dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.FootnoteMedium.Unscaled"
            android:textStyle="normal"
            android:textColor="@color/vk_gray_800"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
            android:textColor="@color/vk_gray_400"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@android:id/text1"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
            android:textColor="@color/vk_gray_400"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@android:id/text2"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <com.vk.core.view.components.button.VkSimpleButton
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="204dp"
        android:layout_marginRight="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="small"/>
</FrameLayout>
