<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/review_cl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp">
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/photo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.ecomm.reviews.ui.reviewheader.ReviewHeaderView
        android:id="@+id/review_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/photo"
        app:layout_constraintTop_toTopOf="@+id/photo"/>
    <com.vk.ecomm.reviews.ui.reviewbody.ReviewBodyView
        android:id="@+id/review_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/review_header"
        app:layout_constraintTop_toBottomOf="@+id/review_header"/>
</androidx.constraintlayout.widget.ConstraintLayout>
