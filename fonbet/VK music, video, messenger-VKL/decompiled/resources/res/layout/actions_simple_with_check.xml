<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/vk_icon_cancel_24"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:layout_marginStart="8dp"
        style="@style/VkUiTypography.HeadlineNormal"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/checked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_check_circle_on_24"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_icon_accent"/>
</LinearLayout>
