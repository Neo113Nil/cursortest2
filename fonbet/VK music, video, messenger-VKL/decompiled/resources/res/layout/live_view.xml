<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/liveTextureHolder"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.libvideo.design.view.videotexture.VideoTextureView
            android:id="@+id/liveTexture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/liveViewBackContainer"
            android:background="@color/one_video_black"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.libvideo.design.view.preview.PreviewImageView
                android:id="@+id/liveViewBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:id="@+id/previewOverlay"
                android:background="@color/one_video_black_alpha60"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </FrameLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/liveViewFadeUp"
        android:background="@drawable/scrim_top"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:alpha="0.48"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/liveViewFadeBottom"
        android:background="@drawable/bg_live_fade_bottom"
        android:layout_width="match_parent"
        android:layout_height="1000dp"
        android:layout_marginBottom="-936dp"
        android:alpha="1"/>
    <com.vk.libvideo.design.view.ad.VideoAdLayout
        android:layout_gravity="bottom"
        android:id="@+id/videoAdBottomPanelView"
        android:visibility="gone"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/liveViewMainHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/bottom_sheet_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/bottom_sheet_gradient_view"
            android:background="@drawable/bg_live_bottom_sheet_gradient"
            android:layout_width="match_parent"
            android:layout_height="90dp"/>
    </FrameLayout>
    <com.vk.libvideo.live.impl.views.error.ErrorView
        android:id="@+id/liveViewError"
        android:background="@color/live_error_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.spinner.VkSpinner
        android:layout_gravity="center"
        android:id="@+id/liveViewProgress"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:spinnerSize="large"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/liveOverlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:vov_force_redesign="true"
        app:vov_mode="dark"
        app:vov_size="undefined"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/liveViewTopHolder"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:alpha="1">
            <com.vk.core.view.components.picture.VkImageSimple
                android:id="@+id/liveViewClose"
                android:background="@drawable/vkim_ripple_light_borderless"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/vk_icon_cancel_shadow_medium_48"
                android:layout_weight="0"
                android:contentDescription="@string/close"/>
        </LinearLayout>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:id="@+id/liveSubtitleName"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            style="@style/VkUiTypography.Subhead"/>
    </LinearLayout>
</merge>
