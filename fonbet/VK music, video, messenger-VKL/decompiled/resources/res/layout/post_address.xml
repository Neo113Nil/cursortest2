<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingLeft="@dimen/post_side_padding"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/post_side_padding"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.TintTextView
        android:textAppearance="@style/VkUiTypography.Headline2"
        android:textColor="?attr/vk_ui_text_link_themed"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/attach_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:drawablePadding="8dp"
        app:drawableStartCompat="@drawable/vk_icon_place_24"
        app:drawableTint="?attr/vk_ui_vkontakte_color_icon_name"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/attach_common_remove_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:contentDescription="@string/delete"
        app:srcCompat="@drawable/vk_icon_cancel_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
</FrameLayout>
