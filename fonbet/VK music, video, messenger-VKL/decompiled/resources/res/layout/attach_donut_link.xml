<?xml version="1.0" encoding="utf-8"?>
<com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    app:overlayDrawable="@drawable/highlight_radius_8"
    app:padOverlay="true">
    <FrameLayout
        android:background="@drawable/attach_fb_8dp"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="start|top"
            android:id="@+id/photo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="0.5dp"/>
        <View
            android:layout_gravity="start"
            android:id="@+id/badge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="26dp"
            android:layout_marginStart="26dp"
            android:elevation="2dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="52dp">
            <com.vk.core.tool.view.FluidHorizontalLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp">
                <TextView
                    android:textColor="?attr/vk_ui_text_muted"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="18dp"
                    app:vk_layout_isFluid="true"
                    style="@style/VkUiTypography.SubheadMedium"/>
                <View
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="-1dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@color/cornflower_blue"/>
            </com.vk.core.tool.view.FluidHorizontalLayout>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="18dp"
                style="@style/VkUiTypography.Subhead"/>
            <com.vk.core.tool.view.FluidHorizontalLayout
                android:id="@+id/info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="18dp"
                    app:vk_layout_isFluid="true"
                    style="@style/VkUiTypography.Subhead"/>
                <com.vk.core.view.PhotoStackView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/photos"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginTop="-1.5dp"
                    android:layout_marginStart="6dp"/>
            </com.vk.core.tool.view.FluidHorizontalLayout>
            <com.vk.core.view.components.button.VkSimpleButton
                android:id="@+id/button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                app:buttonAppearance="accent"
                app:buttonMode="outline"
                app:buttonSizeType="small"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/attach_snippet_bg_remove_button"
        android:background="@drawable/ic_cancel_oval_24"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"/>
</com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout>
