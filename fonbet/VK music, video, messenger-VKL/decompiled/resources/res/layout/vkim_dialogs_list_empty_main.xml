<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.im.ui.views.EmptyViewForList
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon_size="@dimen/vkim_list_empty_icon_size"
        app:text="@string/vkim_dialogs_list_empty"
        app:text_color="?attr/vk_legacy_text_placeholder"
        app:text_size="16sp"/>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_accent"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/business_notify_count"
            android:background="@drawable/vkim_ripple_dark"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="@string/font_family_regular"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <com.vk.im.ui.views.msg.MsgRequestCountLabelView
            android:id="@+id/msg_request_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            style="@style/VkIm.MsgRequest.LabelCount"/>
    </LinearLayout>
</FrameLayout>
