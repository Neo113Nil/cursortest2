<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_service_sticker_horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="150dp"
    android:paddingVertical="13dp">
    <LinearLayout
        android:orientation="vertical"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp">
        <TextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:ellipsize="none"
            android:id="@+id/tv_title"
            android:fadingEdgeLength="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:maxLines="1"
            android:singleLine="true"
            android:drawablePadding="12dp"
            android:requiresFadingEdge="horizontal"
            style="@style/VkUiTypography.Headline1Normal"/>
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="none"
            android:id="@+id/tv_subtitle"
            android:fadingEdgeLength="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:requiresFadingEdge="horizontal"
            style="@style/VkUiTypography.Subhead"/>
    </LinearLayout>
</LinearLayout>
