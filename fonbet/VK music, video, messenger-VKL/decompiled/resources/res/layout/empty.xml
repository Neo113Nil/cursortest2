<?xml version="1.0" encoding="utf-8"?>
<com.vkontakte.android.ui.EmptyView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/VkUiTypography.Text.Unscaled"
        android:textColor="@color/vk_gray_300"
        android:gravity="center"
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="@string/empty_list"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Title2Normal.Unscaled"
        android:textStyle="italic"
        android:textColor="@color/btn_link"
        android:id="@+id/empty_button"
        android:background="@drawable/bg_btn_link"
        android:paddingLeft="10dp"
        android:paddingTop="3dp"
        android:paddingRight="10dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/err_try_again"/>
</com.vkontakte.android.ui.EmptyView>
