<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkPicture
        android:id="@+id/live_broadcast_settings_stream_image"
        android:layout_width="@dimen/live_settings_stream_cover_width"
        android:layout_height="@dimen/live_settings_stream_cover_height"
        android:scaleType="center"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/live_broadcast_settings_stream_image_badge_soon"
        android:background="@drawable/bg_video_duration_label_old"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/live_broadcast_settings_stream_soon"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_broadcast_settings_stream_image"
        app:layout_constraintEnd_toEndOf="@+id/live_broadcast_settings_stream_image"
        style="@style/VkUiTypography.Caption2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
