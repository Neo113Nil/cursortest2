<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="152dp">
    <com.vk.imageloader.view.VKOverlayImageView
        android:id="@+id/catalog_banner_background_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:overlayDrawable="@drawable/catalog_group_banner_overlay"
        app:roundedCornerRadius="12dp"/>
    <View
        android:background="@drawable/catalog_group_banner_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/catalog_banner_background_image"
        app:layout_constraintEnd_toEndOf="@+id/catalog_banner_background_image"
        app:layout_constraintStart_toStartOf="@+id/catalog_banner_background_image"
        app:layout_constraintTop_toTopOf="@+id/catalog_banner_background_image"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/catalog_banner_subtext"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/catalog_banner_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle2"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/catalog_banner_title"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/catalog_banner_subtext"/>
</androidx.constraintlayout.widget.ConstraintLayout>
