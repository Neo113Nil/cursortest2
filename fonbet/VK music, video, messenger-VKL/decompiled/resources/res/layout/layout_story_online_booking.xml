<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_story_lifetime_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/story_online_booking"
        android:textAlignment="center"
        android:layout_marginStart="16dp"
        style="@style/VkUiTypography.DisplayTitle2"/>
    <View
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="16dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="24dp"
        android:text="@string/story_online_booking_desc"
        android:textAlignment="textStart"
        android:paddingStart="16dp"
        android:paddingEnd="32dp"
        style="@style/VkUiTypography.Paragraph"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingVertical="4dp">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/share_switch_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/story_online_booking"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            style="@style/VkUiTypography.Headline1Normal"/>
        <androidx.appcompat.widget.SwitchCompat
            android:layout_gravity="center_vertical"
            android:id="@+id/share_switch_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingHorizontal="4dp"/>
    </LinearLayout>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/save_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/save"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</LinearLayout>
