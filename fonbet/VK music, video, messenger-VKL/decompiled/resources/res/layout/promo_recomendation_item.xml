<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.OverlayLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/product_carousel_promo_item_background"
    android:layout_width="192dp"
    android:layout_height="match_parent"
    app:overlayDrawable="@drawable/highlight_radius_8"
    app:padOverlay="true">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="3"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        style="@style/VkUiTypography.Caption1"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/action_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:textAlignment="center"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"/>
</com.vk.core.tool.view.OverlayLinearLayout>
