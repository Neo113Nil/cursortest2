<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/EditorControlsDarkTheme"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/donate_cell"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.photo.editor.views.ToolBottomView
        android:id="@+id/tool_bottom_view"
        android:paddingBottom="@dimen/paddingXS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:toolName="@string/editor_tool_button_spoiler"/>
</LinearLayout>
