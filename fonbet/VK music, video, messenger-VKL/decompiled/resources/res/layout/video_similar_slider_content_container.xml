<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/similar_slider"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.subnavigation.VkSubnavigationBar
        android:id="@+id/slider_tabs"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_discovery_catalog_tabs_height"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/video_discovery_catalog_tabs_height"
        android:paddingHorizontal="0dp"
        app:subnavigationBarAppearance="accent"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/close_similar_slider_btn_tabs"
        android:background="@drawable/vk_ripple_circle_highlight"
        android:padding="18dp"
        android:visibility="gone"
        android:layout_width="@dimen/video_discovery_catalog_tabs_height"
        android:layout_height="@dimen/video_discovery_catalog_tabs_height"
        android:layout_marginEnd="6dp"
        app:srcCompat="@drawable/vk_icon_chevron_down_24"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/similar_video_items_recyclerview_stub"
        android:layout="@layout/video_similar_horizontal_recycler"
        android:inflatedId="@+id/similar_video_items_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
