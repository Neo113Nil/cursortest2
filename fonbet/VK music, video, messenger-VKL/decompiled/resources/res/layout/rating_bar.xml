<?xml version="1.0" encoding="utf-8"?>
<com.vk.inappreview.impl.fake.RatingBar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:id="@+id/rating_bar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:count="5"
    app:iconGap="29dp"
    app:iconSelectedTint="@color/accent"
    app:iconSize="32dp"
    app:iconUnselectedTint="?attr/ratingUnselectedColor"
    app:offIcon="@drawable/rating_star_off"
    app:onIcon="@drawable/rating_star_on"/>
