<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/background"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/toolbar"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:elevation="10dp">
        <ImageView
            android:id="@+id/back"
            android:background="@drawable/vk_highlight_circle"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_cancel_24"
            android:layout_centerVertical="true"
            android:contentDescription="@string/accessibility_back"
            android:layout_marginStart="4dp"
            android:layout_alignParentStart="true"
            app:tint="?attr/vk_legacy_header_tint"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/title_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/share"
            android:layout_toRightOf="@+id/back"
            android:layout_centerVertical="true"
            android:layout_alignWithParentIfMissing="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true">
            <TextView
                android:textColor="?attr/vk_legacy_header_text"
                android:layout_gravity="start"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="@font/vk_sans_display_demibold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="?attr/vk_legacy_text_subhead"
                android:layout_gravity="start"
                android:id="@+id/deactivated_subtitle"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/vmoji_deactivated_subhead"
                android:fontFamily="@font/vk_roboto_regular"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/share"
            android:background="@drawable/vk_highlight_circle"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_share_outline_28"
            android:layout_toLeftOf="@+id/more"
            android:layout_centerVertical="true"
            android:layout_alignWithParentIfMissing="true"
            android:contentDescription="@string/vmoji_character_accessibility_share"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:tint="?attr/vk_legacy_header_tint"/>
        <ImageView
            android:id="@+id/more"
            android:background="@drawable/vk_highlight_circle"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_more_vertical_24"
            android:layout_centerVertical="true"
            android:contentDescription="@string/vmoji_character_accessibility_more"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"
            app:tint="?attr/vk_legacy_header_tint"/>
    </RelativeLayout>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow_view"
        android:elevation="10dp"
        app:vk_appbar_allowSeparator="false"
        style="@style/AppBarShadow"/>
    <com.vk.lists.CustomSwipeRefreshLayout
        android:id="@+id/vmoji_recycler_swipe_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:background="?attr/vk_legacy_background_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.vk.lists.CustomSwipeRefreshLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/vmoji_character_buy_container"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/vmoji_error_state_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textColor="?attr/vk_legacy_text_secondary"
            android:gravity="center"
            android:id="@+id/vmoji_error_state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="2"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            style="@style/VkLegacyTypography.Headline.Regular"/>
        <TextView
            android:textColor="?attr/vk_legacy_button_tertiary_foreground"
            android:id="@+id/vmoji_error_state_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry"
            style="@style/VkLegacyButton.Tertiary.Rounded"/>
    </LinearLayout>
</RelativeLayout>
