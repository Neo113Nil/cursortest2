<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:id="@+id/internal_nps_input"
        android:background="@drawable/vkui_bg_edittext_stated"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/internal_nps_text_question_hint"
        android:lines="4"
        android:inputType="textMultiLine"
        android:importantForAutofill="no"
        style="@style/VKUIEditText"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_gravity="end"
        android:id="@+id/internal_nps_input_limit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        style="@style/VkUiTypography.Footnote"/>
</LinearLayout>
