<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.onboarding.highlighter.VkOnboardingHighlighter xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/highlighter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:autoHighlight="false"
    app:highlighterColor="azure"
    app:highlighterType="type3">
    <TextView
        android:textAppearance="@style/VkUiTypography.TextMedium"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tab_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
</com.vk.core.tool.view.onboarding.highlighter.VkOnboardingHighlighter>
