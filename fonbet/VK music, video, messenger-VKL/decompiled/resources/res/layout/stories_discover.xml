<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.story.viewer.impl.presentation.stories.view.discover.DiscoverRecyclerPaginatedView
        android:layout_gravity="fill_vertical"
        android:id="@+id/grid"
        android:background="@color/vk_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.NonBouncedAppBarLayout$ScrollingViewBehavior"/>
    <com.google.android.material.appbar.NonBouncedAppBarLayout
        android:id="@+id/appbar"
        android:background="@drawable/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <com.google.android.material.appbar.NonBouncedCollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/header_container"
                android:paddingTop="0.5dp"
                android:paddingBottom="0.5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/vk_icon_compass_outline_56"
                    app:tint="@color/vk_violet_light"/>
                <TextView
                    android:textColor="@color/vk_gray_100"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="24dp"
                    android:text="@string/stories_discover_title"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    style="@style/VkUiTypography.Title2Medium"/>
                <TextView
                    android:textColor="@color/vk_gray_500"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/stories_discover_description"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    style="@style/VkUiTypography.Headline1Normal"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="48dp"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/vk_icon_swipe_up_48"
                        android:alpha="0.24"
                        android:importantForAccessibility="no"
                        app:tint="@color/vk_white"/>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.appbar.NonBouncedCollapsingToolbarLayout>
    </com.google.android.material.appbar.NonBouncedAppBarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
