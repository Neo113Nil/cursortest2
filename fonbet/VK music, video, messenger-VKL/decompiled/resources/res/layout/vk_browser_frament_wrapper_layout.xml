<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/content_stub"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/container_browser"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/content_stub"
        app:layout_constraintEnd_toEndOf="@+id/content_stub"
        app:layout_constraintStart_toStartOf="@+id/content_stub"
        app:layout_constraintTop_toTopOf="@+id/content_stub"/>
</androidx.constraintlayout.widget.ConstraintLayout>
