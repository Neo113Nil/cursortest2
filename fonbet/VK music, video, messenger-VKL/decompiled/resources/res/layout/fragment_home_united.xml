<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:background="?attr/vk_ui_header_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_container"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_scrollFlags="snap|enterAlways|scroll">
            <ImageButton
                android:layout_gravity="start|center_vertical"
                android:id="@+id/navigation_icon"
                android:background="@drawable/highlight_unbounded"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/user_photo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/vk_icon_arrow_left_outline_28"
                app:tint="?attr/vk_ui_icon_accent_themed"/>
            <com.vk.imageloader.view.VKImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/user_photo"
                android:padding="3dp"
                android:visibility="gone"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/accessibility_navigation_drawer"
                android:layout_marginStart="7dp"
                app:actualImageScaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/title"
                app:layout_constraintStart_toEndOf="@+id/navigation_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/user_placeholder"
                app:roundAsCircle="true"
                app:roundingBorderColor="?attr/vk_ui_separator_primary_alpha"
                app:roundingBorderWidth="0.5dp"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="start"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/newsfeed_header_title"
                android:textDirection="locale"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/posting_button_container"
                app:layout_constraintStart_toEndOf="@+id/user_photo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="10dp"
                style="@style/ToolbarTitle"/>
            <FrameLayout
                android:id="@+id/posting_button_container"
                android:background="@drawable/highlight_unbounded"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/feed_accessibility_simple_posting_create"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/search_button"
                app:layout_constraintStart_toEndOf="@+id/title"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/posting_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/vk_icon_add_circle_outline_28"
                    app:tint="?attr/vk_ui_icon_accent_themed"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/search_button"
                android:background="@drawable/highlight_unbounded"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/feed_accessibility_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/notifications_container"
                app:layout_constraintStart_toEndOf="@+id/posting_button_container"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/vk_icon_search_outline_28"
                app:tint="?attr/vk_ui_icon_accent_themed"/>
            <FrameLayout
                android:layout_gravity="end|center_vertical"
                android:id="@+id/notifications_container"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/search_button"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/notifications_button"
                    android:background="@drawable/highlight_unbounded"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/accessibility_open_notifications"
                    app:tint="?attr/vk_ui_icon_accent_themed"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Caption1"
                    android:textColor="@color/bottom_menu_color"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:id="@+id/counter"
                    android:background="@drawable/bottom_navigation_counter_bg"
                    android:paddingLeft="@dimen/vk_bottom_navigation_counter_padding"
                    android:paddingRight="@dimen/vk_bottom_navigation_counter_padding"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/vk_bottom_navigation_counter_height_outer"
                    android:layout_marginTop="8dp"
                    android:minWidth="@dimen/vk_bottom_navigation_counter_height_outer"
                    android:minHeight="@dimen/vk_bottom_navigation_counter_height_outer"
                    android:singleLine="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="2dp"/>
                <View
                    android:layout_gravity="end|top"
                    android:id="@+id/dot"
                    android:background="@drawable/bottom_navigation_dot_corner"
                    android:visibility="gone"
                    android:layout_width="@dimen/vk_bottom_navigation_dot_height"
                    android:layout_height="@dimen/vk_bottom_navigation_dot_height"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="?attr/vk_ui_accent_red"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <include
        android:id="@+id/appkit_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:layout_behavior="@string/vk_toolbar_behavior_scrolling"
        layout="@layout/appkit_tabs"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow_view"
        style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
