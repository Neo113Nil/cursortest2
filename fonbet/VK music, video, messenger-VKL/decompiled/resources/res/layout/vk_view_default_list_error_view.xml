<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/load_more_error"
    android:layout_width="match_parent"
    android:layout_height="@dimen/footer_height">
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/error_text"
        android:padding="16dp"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:text="@string/liblists_err_text"
        android:singleLine="true"
        android:layout_weight="1"
        style="@style/VkUiTypography.Headline2Normal"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/error_button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/liblists_retry"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"/>
</LinearLayout>
