<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_sharing_footer_disabled_hint"
    android:background="?attr/vk_ui_background_secondary"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_content_rounded_8"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="16dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_subhead"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/share_subtitle_disabled_hint"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/vk_icon_lock_outline_28"
        android:scaleType="centerInside"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="16dp"
        app:tint="?attr/vk_ui_icon_medium"/>
</FrameLayout>
