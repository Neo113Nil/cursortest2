<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_chooser_round_corners"
    android:clipToPadding="false"
    android:layout_width="94dp"
    android:layout_height="94dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp">
    <com.vk.imageloader.VkSimpleDraweeView
        android:id="@+id/vkim_background_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        app:actualImageScaleType="centerCrop"
        app:roundedCornerRadius="6dp"
        app:viewAspectRatio="1"/>
    <ImageView
        android:id="@+id/vkim_icon_check_view"
        android:background="@drawable/bg_circle_shadow_alpha12"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/vkim_icon_image_view"
        android:visibility="gone"
        android:layout="@layout/vkim_image_view"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/vkim_background_image"
        app:layout_constraintLeft_toLeftOf="@+id/vkim_background_image"
        app:layout_constraintRight_toRightOf="@+id/vkim_background_image"
        app:layout_constraintTop_toTopOf="@+id/vkim_background_image"/>
</FrameLayout>
