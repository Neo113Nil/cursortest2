<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/money_info_container"
    android:paddingBottom="12dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_mt_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:singleLine="false"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/photo"
            android:fontFamily="@font/vk_roboto_medium"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:id="@+id/tv_mt_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/photo"
            android:layout_below="@+id/tv_mt_to"
            android:fontFamily="@font/vk_roboto_regular"/>
        <com.vk.money.ui.avatar.MoneyAvatarView
            android:id="@+id/photo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentLeft="true"
            app:placeholderImage="@drawable/group_placeholder"/>
        <com.vk.im.ui.views.avatars.AvatarView
            android:id="@+id/avatar"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentLeft="true"
            app:placeholderImage="@drawable/group_placeholder"
            style="@style/VkIm.AvatarView"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_mt_sum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="39dp"
            android:layout_below="@+id/photo"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="24sp"
                android:textColor="?attr/vk_legacy_text_muted"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_mt_sign"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:importantForAccessibility="no"
                android:fontFamily="@font/vk_roboto_regular"/>
            <TextView
                android:textSize="48sp"
                android:textColor="?attr/vk_legacy_text_muted"
                android:gravity="bottom"
                android:id="@+id/tv_mt_sum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:text="500"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:fontFamily="@font/vk_roboto_light"/>
            <TextView
                android:textSize="24sp"
                android:textColor="?attr/vk_legacy_text_muted"
                android:gravity="bottom"
                android:id="@+id/tv_mt_sum_symb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₽"
                android:importantForAccessibility="no"
                android:fontFamily="@font/vk_roboto_regular"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_mt_comment_status_container"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_mt_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="8dp"
            android:maxLines="4"
            android:singleLine="false"/>
        <com.vk.core.view.OverlayTextView
            android:textSize="14sp"
            android:textColor="@color/vk_green"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_mt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:fontFamily="@font/vk_roboto_medium"
            android:textAlignment="center"/>
    </LinearLayout>
</LinearLayout>
