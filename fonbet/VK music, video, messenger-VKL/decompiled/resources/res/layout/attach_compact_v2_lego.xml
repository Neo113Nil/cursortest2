<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/vk_ui_spacing_size2_xs"
    android:paddingBottom="@dimen/vk_ui_spacing_size2_xs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingStart="@dimen/vk_ui_spacing_size2_xl"
    android:paddingEnd="@dimen/vk_ui_spacing_size2_xl">
    <FrameLayout
        android:id="@+id/image_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.newsfeed.common.views.header.HeaderPhotoView
            android:layout_gravity="center"
            android:id="@+id/attach_compact_image"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/accessibility_compact_attach_photo"
            app:imageCenterX="18dp"
            app:imageCenterY="18dp"
            app:imageInset="0dp"
            app:imageRadius="18dp"
            app:imageSmallRadius="18dp"
            app:overlayImageCenterX="18dp"
            app:overlayImageCenterY="18dp"
            app:overlayImageRadius="18dp"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="center"
            android:id="@+id/attach_compact_photo"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/accessibility_compact_attach_photo"
            app:actualImageScaleType="centerInside"
            app:placeholderImageScaleType="fitXY"/>
        <com.vk.newsfeed.common.views.StackSquareView
            android:layout_gravity="center"
            android:id="@+id/attach_compact_images_stack"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/accessibility_compact_attach_photo"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/attach_compact_overlay"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="center"
            android:importantForAccessibility="no"
            app:tint="@color/vk_white"/>
    </FrameLayout>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/attach_compact_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_xl"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_xl"
        app:layout_constraintBottom_toTopOf="@+id/attach_compact_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/barrier_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/image_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <com.vk.core.view.components.text.VkFadeText
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_gravity="center_vertical"
            android:id="@+id/attach_compact_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            app:vk_layout_isFluid="true"
            style="?attr/vk_ui_typography_text"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/attach_compact_verified"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <com.vk.core.view.components.text.VkFadeText
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/attach_compact_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_xl"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_xl"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@+id/barrier_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/image_container"
        app:layout_constraintTop_toBottomOf="@+id/attach_compact_title_container"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/vk_ui_typography_paragraph"/>
    <com.vk.core.view.components.text.VkFadeText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/attach_compact_restriction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:singleLine="true"
        android:textAlignment="gravity"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_xl"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_xl"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@+id/barrier_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/image_container"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/vk_ui_typography_paragraph"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="43dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="start"
        app:constraint_referenced_ids="attach_compact_button,attach_compact_chevron,attach_remove"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/attach_compact_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/attach_compact_chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_chevron_24"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/attach_remove"
        android:background="@drawable/vk_icon_cancel_20"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/vkim_accessibility_remove_attachment"
        android:backgroundTint="?attr/vk_ui_icon_secondary"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
