<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/music_recommendation_onboarding_floating_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toEndOf="@+id/music_recommendation_onboarding_container"
        app:layout_constraintTop_toTopOf="@+id/music_recommendation_onboarding_container"
        app:srcCompat="@drawable/vk_icon_dismiss_dark_24"/>
    <FrameLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/music_recommendation_onboarding_container"
        android:background="@drawable/white_rect_with_12dp_corners"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="416dp"
        android:layout_height="576dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/music_recommendation_onboarding"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
