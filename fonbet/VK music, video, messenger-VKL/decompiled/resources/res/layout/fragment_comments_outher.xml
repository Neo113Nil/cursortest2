<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comments_outher_content_holder"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:elevation="0dp"
        style="@style/VKAppBar">
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/comments_regular_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.userstack.VkUserStack
            android:id="@+id/likes_photo_stack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:vkAvatarSize="small"/>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@+id/comments_outher_fragment_outher_container"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/vk_toolbar_behavior_scrolling">
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/comments_outher_fragment_container"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.vk.core.view.AppBarShadowView style="@style/AppBarShadow"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/comments_outher_jump_to_end"
        android:background="@drawable/comments_scroll_to_bottom"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/comments_ripple_scroll_to_bottom"
        android:minHeight="56dp"
        android:contentDescription="@string/accessibility_scroll_to_bottom_comments"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_behavior="com.vk.newsfeed.impl.replybar.ReplyBarGravityBehavior"/>
    <com.vk.feed.design.view.newsfeed.reply.ReplyBarPlaceholderView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/comments_outher_replybar_placeholder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/comments_outher_bottom_sheet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/comments_outher_replybar_shadow"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_behavior="com.vk.newsfeed.impl.replybar.ReplyBarGravityBehavior"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
