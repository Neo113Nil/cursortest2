<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/personal_discount_new_gift_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/personal_discount_new_gift_portrait"
        android:layout_width="240dp"
        android:layout_height="160dp"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/vk_icon_illustration_games_gift_confetti_160h"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/personal_discount_new_gift_landscape"
        android:visibility="gone"
        android:layout_width="180dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/vk_icon_illustration_games_gift_confetti_120h"/>
</FrameLayout>
