<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_main_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <View
        android:id="@+id/v_profile_main_info_background"
        android:background="?attr/vk_ui_background_tertiary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/profile_main_info_avatar"/>
    <com.vk.profile.design.view.cover.SnowballsCoverView
        android:id="@+id/snowballs_cover"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/profile_main_info_avatar"
        app:layout_constraintTop_toTopOf="@+id/profile_main_info_avatar"/>
    <com.vk.profile.design.view.avatar.UserProfileAvatarView
        android:id="@+id/profile_main_info_avatar"
        android:layout_width="@dimen/user_profile_avatar_view_width"
        android:layout_height="wrap_content"
        android:translationY="-2dp"
        app:layout_constraintBottom_toTopOf="@+id/profile_main_info_base"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:id="@+id/profile_main_a_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/profile_aplus_details_title"
        android:layout_marginEnd="12dp"
        app:contentBadgeAppearance="overlay"
        app:contentBadgeMode="secondary"
        app:contentBadgeSize="small"
        app:layout_constraintBottom_toTopOf="@+id/v_profile_main_info_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:text="@string/profile_a_plus_mark"/>
    <com.vk.profile.design.view.profileheader.UserProfileBaseInfoView
        android:id="@+id/profile_main_info_base"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/user_profile_main_info_content_padding_small"
        app:layout_constraintBottom_toTopOf="@+id/profile_main_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_main_info_avatar"/>
    <include
        android:id="@+id/profile_main_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="@dimen/user_profile_main_info_content_padding_small"
        app:layout_constraintBottom_toTopOf="@+id/profile_main_subscription_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_main_info_base"
        layout="@layout/view_user_profile_main_info_buttons"/>
    <com.vk.profile.design.view.subscriptioninfo.SubscriptionInfoView
        android:id="@+id/profile_main_subscription_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/profile_closed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_main_buttons"/>
    <com.vk.core.view.components.text.links.VkLinkedText
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/profile_closed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/user_profile_make_profile_open"
        android:maxLines="2"
        android:drawablePadding="5dp"
        android:layout_marginHorizontal="@dimen/user_profile_main_info_content_padding"
        app:layout_constraintBottom_toTopOf="@+id/profile_hint_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_main_subscription_info"/>
    <com.vk.profile.design.view.onboarding.UserProfileOnBoardingBannerView
        android:id="@+id/profile_hint_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/profile_card_base_info_horizontal_padding"
        app:layout_constraintBottom_toTopOf="@+id/silent_mode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_closed"/>
    <com.vk.profile.design.view.silentmodebanner.SilentModeBannerView
        android:id="@+id/silent_mode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="@dimen/user_profile_main_info_content_padding"
        app:layout_constraintBottom_toTopOf="@+id/v_bottom_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_hint_banner"/>
    <View
        android:id="@+id/v_bottom_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/silent_mode"/>
</androidx.constraintlayout.widget.ConstraintLayout>
