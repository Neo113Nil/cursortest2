<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/vk_corner_background_16"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginBottom="8dp">
    <com.vk.core.ui.themes.VKReplacerView
        android:layout_gravity="center_vertical"
        android:id="@+id/vk_exchange_user_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/vk_exchange_user_container"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center_vertical"
            android:id="@+id/vk_exchange_user_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/VkUiTypography.Headline1Normal"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/vk_exchange_user_subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lines="1"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/vk_exchange_user_delete"
        android:padding="4dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/vk_auth_remove_accept"
        android:layout_marginEnd="12dp"
        app:srcCompat="@drawable/vk_icon_dismiss_substract_24"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</LinearLayout>
