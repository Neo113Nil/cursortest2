<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainContainer"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vk_sticky_banner_size_extra_small">
    <FrameLayout
        android:id="@+id/ads_image_container"
        android:layout_width="@dimen/vk_sticky_banner_size_extra_small"
        android:layout_height="@dimen/vk_sticky_banner_size_extra_small"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.my.target.nativeads.views.MediaAdView
            android:id="@+id/nativeads_media_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.my.target.nativeads.views.IconAdView
            android:id="@+id/nativeads_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <View
        android:id="@+id/nativeads_icon_separator"
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="0.5dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ads_image_container"
        app:layout_constraintEnd_toEndOf="@+id/ads_image_container"
        app:layout_constraintTop_toTopOf="@+id/ads_image_container"/>
    <View
        android:id="@+id/separatorTop"
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/banner_content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginVertical="8dp"
        app:constraint_referenced_ids="nativeads_title,banner_additional_info_container"
        app:flow_horizontalBias="0"
        app:flow_verticalGap="4dp"
        app:flow_verticalStyle="packed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/nativeads_call_to_action"
        app:layout_constraintStart_toEndOf="@+id/ads_image_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/nativeads_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:importantForAccessibility="no"
        style="@style/VkUiTypography.FootnoteMedium.Unscaled"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/banner_additional_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:constraint_referenced_ids="nativeads_advertising_text_chip,nativeads_domain_chip,nativeads_rating_chip,nativeads_description"
        app:flow_horizontalBias="0"
        app:flow_horizontalGap="4dp"
        app:flow_horizontalStyle="packed"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/nativeads_advertising_text_chip"
        android:background="@drawable/vk_sticky_banner_chip_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/nativeads_advertising_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/nativeads_age_restrictions"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/nativeads_domain_chip"
        android:background="@drawable/vk_sticky_banner_chip_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/nativeads_rating_chip"
        android:background="@drawable/vk_sticky_banner_chip_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/nativeads_rating_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="2dp"
            app:srcCompat="@drawable/vk_icon_favorite_12"
            app:tint="?attr/vk_ui_accent_orange"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/nativeads_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/nativeads_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:importantForAccessibility="no"
        style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
    <com.my.target.nativeads.views.NativeAdChoicesView
        android:id="@+id/nativeads_ad_choices"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/nativeads_ad_choices_icon"
        app:layout_constraintEnd_toEndOf="@+id/nativeads_ad_choices_icon"
        app:layout_constraintStart_toStartOf="@+id/nativeads_ad_choices_icon"
        app:layout_constraintTop_toTopOf="@+id/nativeads_ad_choices_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/nativeads_ad_choices_icon"
        android:background="@drawable/vkui_ripple_circle_highlight"
        android:padding="8dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/vk_accessibility_actions"
        android:layout_marginEnd="4dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:srcCompat="@drawable/vk_icon_more_horizontal_16"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:ellipsize="end"
        android:id="@+id/nativeads_call_to_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="106dp"
        android:text="@string/vk_banner_call_to_action_button_text"
        android:maxLines="1"
        android:layout_marginEnd="4dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/nativeads_ad_choices_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/separatorBottom"
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/nativeads_ad_options"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
