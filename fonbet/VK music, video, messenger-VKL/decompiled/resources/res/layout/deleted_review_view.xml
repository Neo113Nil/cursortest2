<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <com.vk.imageloader.view.DefaultVkImageView
        android:id="@+id/user_photo_iv"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="1dp"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/vk_icon_avatar_placeholder_anonim_150"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/delete_review_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reviews_have_been_deleted"
        android:singleLine="true"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/user_photo_iv"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.TextNormal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_link"
        android:id="@+id/restore_review_iv"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/reviews_restore_action"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/delete_review_message"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.TextMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
