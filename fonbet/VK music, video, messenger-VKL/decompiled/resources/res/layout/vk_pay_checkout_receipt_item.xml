<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vk_pay_checkout_receipt_order_amount"
            android:layout_weight="1"
            style="@style/VkLegacyTypography.Caption.Regular"/>
        <TextView
            android:id="@+id/vk_pay_checkout_bonuses_receipt_order_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/VkLegacyTypography.Caption.Regular"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vk_pay_checkout_receipt_bonuses"
            android:layout_weight="1"
            style="@style/VkLegacyTypography.Caption.Regular"/>
        <TextView
            android:id="@+id/vk_pay_checkout_bonuses_receipt_bonuses_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/VkLegacyTypography.Caption.Regular"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vk_pay_checkout_receipt_total"
            android:layout_weight="1"
            style="@style/VkLegacyTypography.Caption.Regular"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:id="@+id/vk_pay_checkout_bonuses_receipt_total_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/VkLegacyTypography.Caption.Regular"/>
    </LinearLayout>
</LinearLayout>
