<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/friend_request_message_container"
    android:paddingTop="56dp"
    android:paddingBottom="50dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <View
        android:id="@+id/v_bottom_separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="11.5dp">
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/friend_request_message_photo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:placeholderImage="@drawable/user_placeholder"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="0.5dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Text"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/friend_request_message_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Paragraph"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="start|top"
        android:layout_gravity="start|top"
        android:id="@+id/friend_request_message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
</LinearLayout>
