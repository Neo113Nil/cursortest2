<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vkim_theme_container"
    android:clipToPadding="false"
    android:layout_width="94dp"
    android:layout_height="match_parent"
    android:layout_marginTop="6dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp">
    <com.vk.imageloader.VkSimpleDraweeView
        android:id="@+id/vkim_background_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/vkim_item_text"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="6dp"
        app:roundingBorderColor="?attr/vk_legacy_image_border"
        app:roundingBorderWidth="0.5dp"
        app:viewAspectRatio="1"/>
    <com.vk.im.ui.components.theme_chooser.themeadapter.GradientBubblesView
        android:id="@+id/vkim_themed_bubbles_preview"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/vkim_background_image"
        app:layout_constraintLeft_toLeftOf="@+id/vkim_background_image"
        app:layout_constraintRight_toRightOf="@+id/vkim_background_image"
        app:layout_constraintTop_toTopOf="@+id/vkim_background_image"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/vkim_icon_check_view"
        android:background="@drawable/bg_circle_shadow_alpha12"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        app:layout_constraintLeft_toLeftOf="@+id/vkim_background_image"
        app:layout_constraintTop_toTopOf="@+id/vkim_background_image"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/vkim_icon_image_view"
        android:visibility="gone"
        android:layout="@layout/vkim_image_view"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/vkim_background_image"
        app:layout_constraintLeft_toLeftOf="@+id/vkim_background_image"
        app:layout_constraintRight_toRightOf="@+id/vkim_background_image"
        app:layout_constraintTop_toTopOf="@+id/vkim_background_image"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:gravity="center"
        android:id="@+id/vkim_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:fontFamily="@string/font_family_regular"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vkim_background_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
