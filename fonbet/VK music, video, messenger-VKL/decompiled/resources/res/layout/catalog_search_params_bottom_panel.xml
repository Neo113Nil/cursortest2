<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/ll_bottom_parameters_container"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bottom_navigation_shadow"
        android:background="@drawable/bg_bottom_navigation_shadow"
        android:layout_width="match_parent"
        android:layout_height="6dp"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/rich_cell_params"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"/>
    <FrameLayout
        android:id="@+id/old_params"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/vk_icon_filter_24"
            app:tint="?attr/vk_ui_stroke_accent_themed"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginVertical="8dp">
            <TextView
                android:textColor="?attr/vk_ui_text_muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vk_discover_search_parameters"
                style="@style/VkUiTypography.Headline1Normal"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/VkUiTypography.Footnote"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_close"
            android:background="@drawable/highlight_unlimited"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/accessibility_clear"
            app:srcCompat="@drawable/vk_icon_cancel_24"
            app:tint="?attr/vk_ui_icon_secondary"/>
    </FrameLayout>
</LinearLayout>
