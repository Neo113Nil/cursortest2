<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="@drawable/rounded_list_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp">
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/photo"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:emptyImagePlaceholder="@drawable/group_placeholder"
        app:placeholderImage="@drawable/user_placeholder"
        app:placeholderImageScaleType="fitXY"
        style="@style/UserSmallPhoto"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:layout_marginStart="@dimen/small_photo_size"
        android:layout_marginEnd="40dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.HeadlineNormal.Unscaled"
            android:textColor="?attr/vk_ui_text_muted"
            android:ellipsize="marquee"
            android:id="@+id/title"
            android:duplicateParentState="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"
            android:drawablePadding="10dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/options"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/post_side_padding_menu"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</FrameLayout>
