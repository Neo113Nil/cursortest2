<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/retry_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/load_error_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/vk_icon_info_outline_56"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/load_error_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/vk_auth_load_network_title_error"
        style="@style/VkUiTypography.Title2Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/load_error_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="@string/vk_auth_load_network_error"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="24dp"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.auth.ui.VkAuthTextView
        android:layout_gravity="center"
        android:id="@+id/retry_button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="32dp"
        android:text="@string/vk_auth_load_network_retry"
        style="@style/VkAuth.Button.Primary"/>
</LinearLayout>
