<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:screenReaderFocusable="true">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/cover_image_view"
        android:background="@drawable/market_album_image_picker_background"
        android:focusable="false"
        android:layout_width="160dp"
        android:layout_height="96dp"
        android:scaleType="centerCrop"
        android:tint="@color/vk_black_alpha35"
        app:layout_constraintBottom_toTopOf="@+id/album_image_error_reason_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/plus_image_view"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/plus_text_view"
        app:layout_constraintEnd_toEndOf="@+id/cover_image_view"
        app:layout_constraintStart_toStartOf="@+id/cover_image_view"
        app:layout_constraintTop_toTopOf="@+id/cover_image_view"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/vk_icon_add_36"
        app:tint="@color/vk_azure_300"/>
    <TextView
        android:textColor="@color/vk_azure_300"
        android:gravity="center"
        android:id="@+id/plus_text_view"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/market_album_load_cover"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/cover_image_view"
        app:layout_constraintStart_toStartOf="@+id/cover_image_view"
        app:layout_constraintTop_toBottomOf="@+id/plus_image_view"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkLegacyTypography.Subhead1.Medium"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/vk_white"
        android:id="@+id/cover_label_text_view"
        android:background="@drawable/market_album_cover_label_background"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/market_album_cover"
        android:maxLines="1"
        android:singleLine="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="@+id/cover_image_view"
        app:layout_constraintTop_toTopOf="@+id/cover_image_view"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cancel_button"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/market_album_remove_cover_accessibility"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/cover_image_view"
        app:layout_constraintTop_toTopOf="@+id/cover_image_view"
        app:srcCompat="@drawable/vk_icon_cancel_circle_outline_28"
        app:tint="@color/vk_white"/>
    <com.vk.ecomm.market.album.MarketAlbumImageUploadProgressView
        android:id="@+id/album_progress_view"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/cover_image_view"
        app:layout_constraintEnd_toEndOf="@+id/cover_image_view"
        app:layout_constraintStart_toStartOf="@+id/cover_image_view"
        app:layout_constraintTop_toTopOf="@+id/cover_image_view"/>
    <TextView
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/album_image_error_text_view"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/market_album_upload_error"
        android:lines="2"
        app:layout_constraintBottom_toBottomOf="@+id/cover_image_view"
        app:layout_constraintEnd_toEndOf="@+id/cover_image_view"
        app:layout_constraintStart_toStartOf="@+id/cover_image_view"
        app:layout_constraintTop_toTopOf="@+id/cover_image_view"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
    <TextView
        android:textColor="@color/vk_red"
        android:id="@+id/album_image_error_reason_text_view"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/market_album_upload_error_reason"
        android:labelFor="@+id/container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cover_image_view"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
