<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:layout_gravity="start"
        android:id="@+id/select_language_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vkim_translate_language_picker_title"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/VkUiTypography.DisplayTitle1Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:layout_gravity="start"
        android:id="@+id/select_language_original_picker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/vkim_translate_language_picker_original_title"
        android:layout_marginStart="16dp"
        style="@style/VkUiTypography.Subhead"/>
    <Spinner
        android:id="@+id/select_language_original_picker"
        android:background="@drawable/vkui_spinner_default_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:minWidth="100dp"
        android:popupBackground="@drawable/vk_bg_modal_dialog"
        android:paddingEnd="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:layout_gravity="start"
        android:id="@+id/select_language_translate_picker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/vkim_translate_language_picker_translate_title"
        android:layout_marginStart="16dp"
        style="@style/VkUiTypography.Subhead"/>
    <Spinner
        android:id="@+id/select_language_translate_picker"
        android:background="@drawable/vkui_spinner_default_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:minWidth="100dp"
        android:popupBackground="@drawable/vk_bg_modal_dialog"
        android:paddingEnd="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/select_language_apply_button"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="28dp"
        android:text="@string/vkim_accept"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/VkUiTypography.Text"/>
</LinearLayout>
