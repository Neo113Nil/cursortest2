<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/vk_ui_base_padding_horizontal"
    android:paddingVertical="@dimen/vk_ui_spacing_size_s">
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/community_address_info_cell_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_xl"
        app:layout_constraintEnd_toStartOf="@+id/community_address_info_cell_distance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Headline1"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/community_address_info_cell_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/community_address_info_cell_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/community_address_info_cell_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/community_address_info_cell_title"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/community_address_info_cell_metro_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/vk_icon_circle_12"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/community_address_info_cell_metro_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/community_address_info_cell_metro_text"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/community_address_info_cell_metro_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
        app:layout_constraintEnd_toEndOf="@+id/community_address_info_cell_subtitle"
        app:layout_constraintStart_toEndOf="@+id/community_address_info_cell_metro_icon"
        app:layout_constraintTop_toBottomOf="@+id/community_address_info_cell_subtitle"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/community_address_info_cell_work_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/community_address_info_cell_metro_text"
        style="@style/VkUiTypography.Footnote"/>
</merge>
