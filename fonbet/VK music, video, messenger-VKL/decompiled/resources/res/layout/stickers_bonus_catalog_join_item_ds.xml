<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bonus_join_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_bonus_catalog_points"
        android:paddingTop="19dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            style="@style/VkUiTypography.HeadlineMedium"/>
        <com.vk.vas.design.view.sticker.VkGradientButton
            android:id="@+id/join"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/stickers_bonus_catalog_points_join_button"
            app:buttonMode="primary"
            app:buttonSizeType="medium"/>
        <com.vk.core.view.components.text.links.VkLinkedText
            android:textAppearance="@style/VkUiTypography.Caption2"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stickers_bonus_catalog_points_join_help"
            android:textAlignment="center"/>
    </LinearLayout>
</FrameLayout>
