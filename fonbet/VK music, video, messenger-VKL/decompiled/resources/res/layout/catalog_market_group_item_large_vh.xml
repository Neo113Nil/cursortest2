<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_catalog_card_elevation_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground">
        <com.vk.imageloader.view.VKCircleImageView
            android:id="@+id/group_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundingBorderColor="?attr/vk_legacy_image_border"
            app:roundingBorderWidth="0.5dp"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/group_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="@string/font_family_medium"
            android:layout_marginStart="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/group_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/verification_tick"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/group_icon"
            app:layout_constraintTop_toTopOf="@+id/group_icon"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/VkLegacyTypography.Text"/>
        <ImageView
            android:id="@+id/verification_tick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/group_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/group_title"
            app:layout_constraintTop_toTopOf="@+id/group_title"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="12dp"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/group_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@+id/group_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/group_title"
            app:layout_constraintTop_toBottomOf="@+id/group_title"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="12dp"
            style="@style/VkLegacyTypography.Subhead2"/>
        <com.vk.core.view.NestedScrollableRecyclerView
            android:id="@+id/goods_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/group_icon"/>
        <View
            android:id="@+id/bottom_divider"
            android:background="?attr/vk_legacy_separator_alpha"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goods_list"/>
        <TextView
            android:textSize="15sp"
            android:gravity="center"
            android:id="@+id/show_more_btn"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/catalog_market_show_more"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bottom_divider"
            style="@style/VkLegacyButton.Tertiary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
