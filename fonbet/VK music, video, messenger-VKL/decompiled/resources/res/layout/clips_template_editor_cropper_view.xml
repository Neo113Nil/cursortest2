<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="horizontal"
        android:id="@+id/clips_template_editor_cropper_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="64dp"
        android:paddingStart="@dimen/clips_template_editor_item_cropper_slide_controls_size"
        android:paddingEnd="@dimen/clips_template_editor_item_cropper_slide_controls_size"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="left"
        android:id="@+id/clips_template_editor_cropper_view_pager_left_control"
        android:layout_width="@dimen/clips_template_editor_item_cropper_slide_controls_size"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/clips_template_editor_cropper_view_pager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/clips_template_editor_cropper_view_pager"/>
    <View
        android:layout_gravity="right"
        android:id="@+id/clips_template_editor_cropper_view_pager_right_control"
        android:layout_width="@dimen/clips_template_editor_item_cropper_slide_controls_size"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/clips_template_editor_cropper_view_pager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/clips_template_editor_cropper_view_pager"/>
</merge>
