<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:paddingHorizontal="@dimen/post_side_padding">
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/followers"
        style="@style/VkUiTypography.Headline1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/followers_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:paddingVertical="0dp"
        style="@style/VkUiTypography.Footnote"/>
</LinearLayout>
