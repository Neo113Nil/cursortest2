<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="?attr/colorPrimary">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/search_milkshake_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="@drawable/vk_bg_card_elevation2_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:backgroundTint="?attr/vk_ui_search_field_background"/>
            <View
                android:background="@drawable/vk_bg_card_elevation2_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:backgroundTint="?attr/vk_ui_search_field_background"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/search_box"
            android:background="@drawable/bg_modern_search"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/talkback_ic_search"
            android:backgroundTint="?attr/vk_ui_search_field_background"
            android:backgroundTintMode="multiply">
            <FrameLayout
                android:id="@+id/iv_icon_left_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/iv_progress_left"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/vk_ui_icon_medium"
                    android:indeterminateTintMode="src_in"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_icon_left"
                    android:background="@drawable/highlight_unlimited"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/talkback_ic_back"
                    app:srcCompat="@drawable/vk_icon_arrow_left_outline_28"
                    app:tint="?attr/vk_ui_icon_medium"/>
            </FrameLayout>
            <com.vk.core.view.NoMenuEditText
                android:textSize="16dp"
                android:textColor="?attr/vk_ui_text_primary"
                android:textColorHint="?attr/vk_ui_vkontakte_color_search_bar_field_tint"
                android:gravity="center_vertical"
                android:id="@+id/query"
                android:background="@null"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/search"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionSearch"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Text.Unscaled"
                android:textColor="?attr/vk_ui_text_primary"
                android:textColorHint="?attr/vk_ui_vkontakte_color_search_bar_field_tint"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/query_static"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/search"
                android:maxLines="1"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_icon_params"
                android:background="@drawable/highlight_unlimited"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/talkback_ic_search_params"
                app:srcCompat="@drawable/vk_icon_filter_24"
                app:tint="?attr/vk_ui_icon_medium"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_icon_right"
                android:background="@drawable/highlight_unlimited"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/talkback_ic_cancel"
                app:srcCompat="@drawable/vk_icon_cancel_24"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_icon_third"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_icon_third"
                    android:background="@drawable/highlight_unlimited"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerInside"
                    app:tint="?attr/vk_ui_icon_medium"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_contrast"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:id="@+id/tv_icon_third_badge"
                    android:background="@drawable/vk_superapp_counter_bg_9"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:backgroundTint="?attr/vk_ui_accent_red"
                    style="@style/VkUiTypography.Subhead"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</merge>
