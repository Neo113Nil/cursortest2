<?xml version="1.0" encoding="utf-8"?>
<com.vk.attachpicker.widget.TopShadowLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/picker_toolbar_height"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/fl_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.attachpicker.widget.ContextProgressView
                android:layout_gravity="center_horizontal"
                android:id="@+id/cpv_progress"
                android:visibility="gone"
                android:layout_width="@dimen/picker_gallery_loading_progress"
                android:layout_height="@dimen/picker_gallery_loading_progress"
                android:layout_marginTop="128dp"/>
            <com.vk.attachpicker.widget.GalleryRecyclerView
                android:id="@+id/rv_gallery"
                android:visibility="invisible"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/fl_permission_stub_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"/>
            <FrameLayout
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/fl_samsung_photopicker_stub_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/fl_bottom_button"
            android:layout_width="match_parent"
            android:layout_height="76dp">
            <View
                android:background="@drawable/picker_bg_attach_bottom_toolbar_shadow"
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <FrameLayout
                android:layout_gravity="bottom"
                android:background="?attr/vk_ui_background_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <com.vk.core.view.components.button.VkButton
                    android:id="@+id/acv_bottom_panel_counter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/picker_attach_button"
                    app:buttonAppearance="accent"
                    app:buttonMode="primary"
                    app:buttonSizeType="large"/>
                <com.vk.core.view.components.button.VkSimpleButton
                    android:gravity="center"
                    android:id="@+id/tv_bottom_panel_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/picker_cancel"
                    app:buttonAppearance="accent"
                    app:buttonMode="secondary"
                    app:buttonSizeType="large"/>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
</com.vk.attachpicker.widget.TopShadowLinearLayout>
