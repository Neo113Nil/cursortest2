<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/posting_draft_layout"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:foreground="@drawable/highlight_post">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:layout_marginStart="6dp"
        app:srcCompat="@drawable/vk_icon_pen_outline_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1Normal.Unscaled"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/newsfeed_draft_title"
        android:singleLine="true"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="56dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/publish_suggest_action_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/newsfeed_draft_subtitle"
        android:singleLine="true"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="56dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/draft_remove"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/newsfeed_draft_delete"
        android:layout_marginEnd="4dp"
        app:srcCompat="@drawable/vk_icon_cancel_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
</FrameLayout>
