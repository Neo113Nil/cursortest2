<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/album_sticker_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.stories.design.view.stickers.photo.PhotoWithCaptionViewGroup
        android:orientation="vertical"
        android:id="@+id/album_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.stories.design.view.stickers.post.RoundedFrameLayout
            android:id="@+id/image_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.vk.attachpicker.stickers.post.attach.StoryAttachImageView
                android:id="@+id/cover_image"
                android:background="?attr/vk_ui_image_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.vk.imageloader.view.VKImageView
                    android:layout_gravity="center"
                    android:id="@+id/restriction_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:tint="@color/vk_white"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Subhead"
                    android:textColor="@color/vk_white"
                    android:id="@+id/restriction_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lines="2"
                    android:textAlignment="center"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/multiple_photos_indicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="9dp"
                android:layout_marginRight="9dp"
                android:src="@drawable/vk_icon_picture_on_square_outline_20"
                app:tint="?attr/vk_ui_icon_contrast"/>
        </com.vk.stories.design.view.stickers.post.RoundedFrameLayout>
        <com.vk.stories.design.view.stickers.post.PostAuthorView
            android:id="@+id/album_owner"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"/>
    </com.vk.stories.design.view.stickers.photo.PhotoWithCaptionViewGroup>
</FrameLayout>
