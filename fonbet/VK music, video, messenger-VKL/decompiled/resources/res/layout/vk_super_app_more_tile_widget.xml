<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/button"
        android:background="@drawable/vk_highlight_radius_12"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="44dp">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center_horizontal"
            android:layout_gravity="center_vertical"
            android:id="@+id/button_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vk_show_all"
            android:drawablePadding="7dp"
            android:paddingStart="4dp"
            app:drawableTint="?attr/vk_ui_icon_secondary"
            app:drawableTopCompat="@drawable/vk_icon_chevron_right_circle_28"
            style="@style/VkUiTypography.SubheadMedium"/>
    </FrameLayout>
</FrameLayout>
