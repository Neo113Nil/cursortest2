<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <CheckBox
        android:layout_gravity="start|center_vertical"
        android:id="@+id/checkbox"
        android:focusable="false"
        android:visibility="visible"
        android:clickable="false"
        android:checked="true"
        android:text=""
        android:layout_marginEnd="16dp"
        android:buttonTint="?attr/vk_ui_icon_secondary"
        style="@style/CircleCheckBox"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="marquee"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="48dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="marquee"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="48dp"/>
</FrameLayout>
