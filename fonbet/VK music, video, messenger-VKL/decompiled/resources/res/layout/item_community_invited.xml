<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_group_invited"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/photo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:placeholderImage="@drawable/user_placeholder"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="76dp"
        android:layout_marginEnd="16dp">
        <com.vk.core.view.links.LinkedTextView
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            style="@style/VkUiTypography.Subhead"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:ellipsize="end"
                android:id="@+id/accept"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/group_inv_accept"
                android:singleLine="true"
                android:layout_marginEnd="8dp"
                style="@style/VkLegacyButton.Primary"/>
            <TextView
                android:textSize="14dp"
                android:ellipsize="end"
                android:id="@+id/reject"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/group_inv_decline"
                android:singleLine="true"
                style="@style/VkLegacyButton.Secondary"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
