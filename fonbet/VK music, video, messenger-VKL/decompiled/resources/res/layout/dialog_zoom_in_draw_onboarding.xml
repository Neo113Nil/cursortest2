<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center"
            android:clipChildren="false"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginBottom="16dp">
            <FrameLayout
                android:layout_gravity="center"
                android:clipChildren="false"
                android:layout_width="72dp"
                android:layout_height="72dp">
                <com.vk.photo.editor.views.PointerView
                    android:layout_gravity="end|top"
                    android:id="@+id/view_pointer_touch_top"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:innerCircleRadius="0dp"
                    app:outerCircleRadius="0dp"/>
                <com.vk.photo.editor.views.PointerView
                    android:layout_gravity="start|bottom"
                    android:id="@+id/view_pointer_touch_bottom"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:innerCircleRadius="0dp"
                    app:outerCircleRadius="0dp"/>
            </FrameLayout>
        </FrameLayout>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/text_view_onboarding_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_onboarding_zoom_draw_title"
            android:alpha="0"
            android:textAlignment="center"
            android:layout_marginHorizontal="32dp"
            style="?attr/editorTextTitle2"/>
    </LinearLayout>
</FrameLayout>
