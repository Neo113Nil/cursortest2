<?xml version="1.0" encoding="utf-8"?>
<com.vk.music.player.presentation.main.BigPlayerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:currentState="@+id/lyrics_collapsed"
    app:layoutDescription="@xml/music_player_main_scene">
    <RelativeLayout
        android:id="@+id/block_image"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp">
        <com.vk.music.view.ThumbsImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="16dp"
            app:tiv_background_image="?attr/vk_ui_background_modal"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/ic_song_placeholder_96"
            app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"
            app:viewAspectRatio="1"/>
        <View
            android:id="@+id/v_margin"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:gravity="center"
            android:id="@+id/open_ad_banner"
            android:background="@drawable/music_white_advertisement_background"
            android:paddingTop="5.5dp"
            android:paddingBottom="6.5dp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="30dp"
            android:text="@string/disable_music_ad"
            android:layout_alignBottom="@+id/image"
            android:layout_centerHorizontal="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:overlayDrawable="@drawable/highlight_radius_8"
            app:padAsBackground="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/title_compact_container"
        android:layout_width="0dp"
        android:layout_height="0dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.DisplayTitle2"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="marquee"
            android:gravity="start"
            android:id="@+id/title_compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="26dp"
            android:singleLine="true"
            android:textAlignment="gravity"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/artist_compact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:maxLines="1"
        android:textAlignment="gravity"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lyrics_recycler"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:nestedScrollingEnabled="true"/>
    <FrameLayout
        android:id="@+id/block_seekbar"
        android:paddingBottom="5dp"
        android:clickable="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <com.vk.core.view.SeekBarSamsungFixed
            android:id="@+id/seekbar"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:maxHeight="35dp"
            android:max="100"
            android:progressDrawable="@drawable/music_progress_with_padding"
            android:minHeight="35dp"
            android:thumb="@drawable/music_progress_thumb"
            android:thumbOffset="0dp"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"
            android:splitTrack="false"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="end|bottom"
            android:id="@+id/duration"
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:textAlignment="viewEnd"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="end|bottom"
            android:id="@+id/online"
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:text="@string/music_player_duration_online"
            android:textAlignment="viewEnd"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="start|bottom"
            android:id="@+id/time"
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/title_container"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="0dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.DisplayTitle1"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/title_container_music_track"
        android:layout_width="0dp"
        android:layout_height="0dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.DisplayTitle1"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/title_music_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_accent"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="60dp"
        android:paddingEnd="60dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_accent"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/artist_music_track"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:paddingStart="0dp"
        android:paddingEnd="120dp"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="title,artist"
        app:layout_constraintBottom_toTopOf="@+id/play_pause"
        app:layout_constraintTop_toBottomOf="@+id/block_seekbar"
        app:layout_constraintVertical_chainStyle="spread"/>
    <FrameLayout
        android:id="@+id/switch_lyrics"
        android:layout_width="40dp"
        android:layout_height="40dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/hide_lyrics_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/music_talkback_hide_song_text"
            app:srcCompat="@drawable/vk_icon_text_tt_dot_bottom_outline_28"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/show_lyrics_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/music_talkback_show_song_text"
            app:srcCompat="@drawable/vk_icon_text_tt_outline_24"/>
    </FrameLayout>
    <ImageButton
        android:id="@+id/play_pause"
        android:background="@drawable/highlight_circle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/music_talkback_play"/>
    <ImageButton
        android:id="@+id/prev"
        android:background="@drawable/highlight_circle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/music_talkback_prev"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/play_pause"
        app:layout_constraintTop_toTopOf="@+id/play_pause"/>
    <ImageButton
        android:id="@+id/next"
        android:background="@drawable/highlight_circle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/music_talkback_next"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@+id/play_pause"
        app:layout_constraintTop_toTopOf="@+id/play_pause"/>
    <ImageButton
        android:id="@+id/dislike"
        android:background="@drawable/highlight_circle"
        android:layout_width="24dp"
        android:layout_height="24dp"/>
    <ImageButton
        android:id="@+id/add"
        android:background="@drawable/highlight_circle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/music_talkback_add_audio"/>
    <com.vk.music.design.view.download.DownloadingView
        android:id="@+id/downloading"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="?attr/vk_ui_background_content_inverse"
        app:downloaded_icon="@drawable/vk_icon_download_check_outline_24"
        app:loading_width="2dp"
        app:not_loaded_icon="@drawable/vk_icon_download_outline_24"
        app:pending_icon="@drawable/vk_icon_download_outline_24"
        app:pending_tint="?attr/vk_ui_background_content_inverse"
        app:show_not_loaded="true"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteMedium"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/speed"
        android:background="@drawable/bg_speed_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:minHeight="24dp"/>
    <ImageButton
        android:id="@+id/more"
        android:background="@drawable/highlight_circle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/music_talkback_more"/>
</com.vk.music.player.presentation.main.BigPlayerLayout>
