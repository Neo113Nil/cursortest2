<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="24dp"
    android:paddingRight="24dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="end|top"
            android:id="@+id/btnEndTitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"
            app:buttonSizeType="small"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/content"
            android:background="@drawable/vk_bg_radius_12"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/icon"
                android:layout_width="56dp"
                android:layout_height="56dp"/>
            <FrameLayout
                android:id="@+id/fl_photo_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/photo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"/>
                <com.vk.core.ui.themes.VKReplacerView
                    android:id="@+id/placeholder"
                    android:layout_width="100dp"
                    android:layout_height="100dp"/>
                <ImageView
                    android:layout_gravity="end|bottom"
                    android:id="@+id/indicator"
                    android:background="@drawable/vk_bg_photo_indicator"
                    android:layout_width="22dp"
                    android:layout_height="22dp"/>
            </FrameLayout>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="5"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/VkUiTypography.Title2Medium"/>
            <TextView
                android:textColor="@color/vk_ui_text_title_color"
                android:gravity="center_horizontal"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/VkUiTypography.Subhead"/>
            <TextView
                android:textColor="@color/vk_ui_text_title_color"
                android:gravity="center_horizontal"
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/VkUiTypography.Subhead"/>
            <com.vk.core.view.components.button.VkSimpleButton
                android:id="@+id/more"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                app:buttonAppearance="accent"
                app:buttonMode="tertiary"
                app:buttonSizeType="small"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/fl_additional_custom_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/close_icon"
            android:background="@drawable/vk_highlight_unlimited"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/close"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp">
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/negative_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="0.5"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="large"/>
        <View
            android:id="@+id/buttons_divider"
            android:layout_width="12dp"
            android:layout_height="0dp"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/positive_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="0.5"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/custom_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
