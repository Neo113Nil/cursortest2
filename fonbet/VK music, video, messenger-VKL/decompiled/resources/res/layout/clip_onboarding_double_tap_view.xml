<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_black_alpha60"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/like"
        android:background="@drawable/bg_white_circle_alpha_20"
        android:padding="10dp"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/vk_icon_like_28"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <ImageView
        android:id="@+id/hand"
        android:paddingTop="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_hand"
        android:paddingStart="28dp"
        android:paddingEnd="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/like"
        app:layout_constraintEnd_toEndOf="@+id/like"
        app:layout_constraintStart_toEndOf="@+id/like"
        app:layout_constraintTop_toBottomOf="@+id/like"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Headline1Normal"
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/clip_feed_onboarding_double_tap"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/like"/>
</androidx.constraintlayout.widget.ConstraintLayout>
