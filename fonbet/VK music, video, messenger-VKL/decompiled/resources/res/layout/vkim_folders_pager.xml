<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/folders_pager_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/folder_tab_header_container"
        android:layout_width="match_parent"
        android:layout_height="16dp">
        <FrameLayout
            android:background="@drawable/folder_tab_header"
            android:layout_width="match_parent"
            android:layout_height="16dp"/>
    </FrameLayout>
    <com.vk.core.view.components.tabs.VkTabs
        android:id="@+id/folders_carousel_vk_tabs"
        android:padding="0dp"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:paddingHorizontal="@dimen/vk_ui_base_padding_horizontal"
        android:paddingVertical="@dimen/vk_ui_spacing_size_m"
        app:tabsLayoutMode="tabsLayoutScrollable"
        app:tabsMode="tabsModeAccent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/folders_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
