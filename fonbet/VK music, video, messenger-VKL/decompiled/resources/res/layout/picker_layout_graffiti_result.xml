<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fl_graffiti_preview"
    android:background="#66000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/fl_graffiti_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/iv_preview"
                android:background="@drawable/picker_bg_graffiti_preview_top"
                android:paddingLeft="32dp"
                android:paddingTop="32dp"
                android:paddingRight="32dp"
                android:paddingBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="0px"
                android:layout_weight="1"
                app:actualImageScaleType="centerInside"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:id="@+id/tv_send_button"
                android:background="@drawable/picker_bg_graffiti_preview_bottom"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:text="@string/picker_send"
                android:singleLine="true"
                android:textAllCaps="true"
                android:fontFamily="@string/font_family_medium"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
