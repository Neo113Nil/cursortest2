<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/warning_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/vk_icon_error_outline_56"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/no_space_dialog_title"
        android:layout_marginHorizontal="16dp"
        style="@style/VkUiTypography.Title2"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="@string/no_space_dialog_description"
        android:lines="2"
        android:breakStrategy="balanced"
        android:layout_marginHorizontal="16dp"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/go_to_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="@string/no_space_dialog_offline_settings"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/close_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:text="@string/no_space_dialog_close"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="large"/>
</LinearLayout>
