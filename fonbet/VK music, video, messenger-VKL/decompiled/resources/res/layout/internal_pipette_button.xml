<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="40dp"
    android:layout_height="40dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_selected_outside_border"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/bg_color_button_border_outside_selected"
        android:importantForAccessibility="no"/>
    <com.vk.photo.editor.markup.view.tools.PaintBackgroundView
        android:layout_gravity="center"
        android:id="@+id/color"
        android:layout_width="32dp"
        android:layout_height="32dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_selected_inside_border"
        android:visibility="gone"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_color_button_border_inside_selected"
        android:importantForAccessibility="no"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_pipette"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_pipette"
        android:importantForAccessibility="no"/>
</FrameLayout>
