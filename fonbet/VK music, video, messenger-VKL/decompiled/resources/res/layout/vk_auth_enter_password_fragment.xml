<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/vk_auth_enter_password_container"
    android:background="?attr/vk_ui_background_content"
    android:paddingBottom="@dimen/vk_auth_keyboard_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle2SemiBold"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_sign_up_enter_password_title"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vk_auth_sign_up_enter_password_description"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/VkAuth.Title.Secondary"/>
    <com.vk.auth.ui.VkAuthPasswordView
        android:id="@+id/password_smart_layout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:vk_edit_text_hint="@string/vk_auth_sign_up_enter_password_hint"
        app:vk_edit_text_id="@+id/vk_password"
        app:vk_toggle_button_content_description="@string/vk_auth_show_pass"/>
    <com.vk.auth.ui.VkAuthPasswordView
        android:id="@+id/repeat_password_smart_layout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:vk_edit_text_hint="@string/vk_auth_sign_up_enter_password_repeat_hint"
        app:vk_edit_text_id="@+id/vk_repeat_password"
        app:vk_toggle_button_content_description="@string/vk_auth_show_pass"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteNormal"
        android:textColor="?attr/vk_ui_text_negative"
        android:layout_gravity="start"
        android:id="@+id/error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vk_auth_sign_up_enter_password_error_equality"
        android:layout_marginHorizontal="16dp"/>
    <com.vk.auth.enterpassword.VkEnterPasswordProgressBarView
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.vk.auth.ui.VkLoadingButton
        android:id="@+id/continue_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/vk_auth_continue"
        android:layout_marginHorizontal="16dp"
        style="@style/VkAuth.Button.Primary"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/help_button"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_help_button"
        android:layout_marginHorizontal="16dp"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
</LinearLayout>
