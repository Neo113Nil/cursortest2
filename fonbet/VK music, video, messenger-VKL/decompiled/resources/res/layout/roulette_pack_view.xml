<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">
    <FrameLayout
        android:id="@+id/pack_container"
        android:layout_width="102dp"
        android:layout_height="102dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/pack_image_border"
            android:background="@drawable/item_border_15"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.vas.design.view.VKStickerPackView
            android:layout_gravity="center"
            android:id="@+id/pack_image"
            android:layout_width="@dimen/roulette_pack_img_normal_size"
            android:layout_height="@dimen/roulette_pack_img_normal_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="?attr/vk_ui_typography_subhead"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/pack_name"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:textAlignment="center"/>
</LinearLayout>
