<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/hide_reason_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/item_ignored_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:lottie_autoPlay="false"
            app:lottie_fileName="check_circle_outline_56.json"
            app:lottie_loop="false"/>
        <com.vk.core.view.links.LinkedTextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/item_ignored_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="24dp"
            android:text="@string/newsfeed_item_ad_ignored_title"
            style="@style/VkUiTypography.Title2Medium"/>
        <com.vk.core.view.links.LinkedTextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/item_ignored_message"
            android:paddingBottom="1dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:minHeight="20dp"
            android:text="@string/newsfeed_item_ad_ignored_message"
            android:maxLines="3"
            android:minLines="1"
            android:lineSpacingExtra="1sp"
            android:textAlignment="gravity"
            style="@style/VkUiTypography.Headline1Normal"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hide_reasons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/item_ignored_cancel"
            android:background="@drawable/background_vk_ui_button_secondary"
            android:paddingLeft="@dimen/vk_ui_button_padding_left"
            android:paddingTop="@dimen/vk_ui_button_padding_top"
            android:paddingRight="@dimen/vk_ui_button_padding_right"
            android:paddingBottom="@dimen/vk_ui_button_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:minHeight="36dp"
            android:text="@string/newsfeed_item_ignored_cancel"
            android:singleLine="true"
            android:textAlignment="gravity"
            style="@style/VkUiTypography.Headline2Medium"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ad_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no">
            <androidx.cardview.widget.CardView
                android:id="@+id/icon_container"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="@dimen/post_side_padding"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ads_title">
                <com.my.target.nativeads.views.IconAdView
                    android:layout_gravity="center"
                    android:id="@+id/icon"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.vk.feed.tool.view.newsfeed.image.FixedSizeVKEnhancedImageView
                    android:layout_gravity="center"
                    android:id="@+id/iconImage"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    app:disableAnimationOnColdStart="true"
                    app:emptyPlaceholder="?attr/vk_ui_image_placeholder"
                    app:layout_constraintTop_toTopOf="parent"
                    app:placeholder="?attr/vk_ui_image_placeholder"/>
            </androidx.cardview.widget.CardView>
            <ImageView
                android:id="@+id/post_options_btn"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:scaleType="center"
                android:contentDescription="@string/menu"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/vk_icon_more_vertical_24"/>
            <TextView
                android:textColor="?attr/newsfeed_post_title_color"
                android:ellipsize="end"
                android:id="@+id/ads_title"
                android:paddingBottom="1dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="2dp"
                android:singleLine="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toTopOf="@+id/subtitle"
                app:layout_constraintEnd_toStartOf="@+id/post_options_btn"
                app:layout_constraintStart_toEndOf="@+id/icon_container"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/VkUiTypography.SubheadMedium"/>
            <com.vk.newsfeed.common.views.header.PostHeaderSubtitleTextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/subtitle"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="14dp"
                android:maxLines="1"
                android:importantForAccessibility="yes"
                android:textAlignment="gravity"
                app:layout_constraintBottom_toBottomOf="@+id/photo"
                app:layout_constraintEnd_toEndOf="@+id/ads_title"
                app:layout_constraintStart_toStartOf="@+id/ads_title"
                app:layout_constraintTop_toBottomOf="@+id/ads_title"
                style="@style/VkUiTypography.Caption1Normal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/mediaViewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/videoContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.my.target.nativeads.views.MediaAdView
                android:id="@+id/mediaView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.feed.tool.view.newsfeed.image.FixedSizeVKEnhancedImageView
                android:id="@+id/imageView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/accessibility_photo"
                app:disableAnimationOnColdStart="true"
                app:emptyPlaceholder="?attr/vk_ui_image_placeholder"
                app:imageScaleType="center_crop"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholder="?attr/vk_ui_image_placeholder"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/cta_button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/disclaimer_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/description_container"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:importantForAccessibility="no"
            android:paddingStart="@dimen/post_side_padding"
            android:paddingEnd="@dimen/post_side_padding">
            <com.vk.feed.tool.view.newsfeed.text.VkFeedTextWrapper
                android:id="@+id/text_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.core.view.text.SquareExcerptTextView
                    android:textColor="?attr/vk_ui_text_muted"
                    android:id="@+id/description"
                    android:paddingBottom="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4sp"
                    android:importantForAccessibility="yes"
                    style="@style/VkUiTypography.Paragraph"/>
            </com.vk.feed.tool.view.newsfeed.text.VkFeedTextWrapper>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
