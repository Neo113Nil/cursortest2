<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/media_picker_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingEnd="3dp">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/fast_scroller_handle"
        android:visibility="gone"
        android:layout_width="3dp"
        android:layout_height="38dp"
        android:src="@drawable/ds_scrollbar_handle"
        android:importantForAccessibility="no"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:layout_gravity="end"
        android:id="@+id/fast_scroller_popup_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_l"
        app:contentBadgeMode="primary"
        app:contentBadgeSize="large"/>
</FrameLayout>
