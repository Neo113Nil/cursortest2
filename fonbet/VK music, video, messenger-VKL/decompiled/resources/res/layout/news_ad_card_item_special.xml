<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/bg_secondary_rounded_12"
    android:layout_width="212dp"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/content_photo"
        android:layout_width="212dp"
        android:layout_height="280dp"
        android:contentDescription="@null"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.ParagraphNormal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/old_price"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_photo"
        app:layout_goneMarginEnd="@dimen/post_ad_block_item_padding"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.FootnoteNormal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/old_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/post_ad_block_item_padding"
        app:layout_constraintBaseline_toBaselineOf="@+id/price"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/price"
        app:layout_constraintWidth_max="wrap"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.FootnoteNormal"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/post_ad_block_item_padding"
        android:layout_marginEnd="@dimen/post_ad_block_item_padding"
        app:layout_constraintBottom_toTopOf="@+id/button"
        app:layout_constraintEnd_toEndOf="@+id/content_photo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/price"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="@dimen/paddingXXS"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/paddingXXS"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:text="Купить"/>
</androidx.constraintlayout.widget.ConstraintLayout>
