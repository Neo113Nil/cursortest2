<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="start"
    android:background="@drawable/music_selectable_bg"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:minHeight="64dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/owner_image"
        android:layout_width="@dimen/catalog_link_small_avatar_width"
        android:layout_height="@dimen/catalog_link_small_avatar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/owner_verified"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/owner_name"
        app:layout_constraintEnd_toStartOf="@+id/actions_container_area"
        app:layout_constraintStart_toEndOf="@+id/owner_name"
        app:layout_constraintTop_toTopOf="@+id/owner_name"
        app:layout_constraintVertical_bias="0.5"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/owner_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/owner_description"
        app:layout_constraintEnd_toStartOf="@+id/owner_verified"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/owner_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"
        style="@style/VkUiTypography.HeadlineNormal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/owner_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/notification_icon"
        app:layout_constraintStart_toEndOf="@+id/owner_image"
        app:layout_constraintTop_toBottomOf="@+id/owner_name"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/notification_icon"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_notifications_28"
        android:scaleType="center"
        android:contentDescription="@string/music_talkback_more"
        android:layout_marginEnd="-10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/chevron_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/chevron_icon"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_dropdown_20"
        android:scaleType="center"
        android:contentDescription="@string/music_talkback_more"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <View
        android:id="@+id/actions_container_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/notification_icon"
        app:layout_constraintEnd_toEndOf="@+id/chevron_icon"
        app:layout_constraintStart_toStartOf="@+id/notification_icon"
        app:layout_constraintTop_toTopOf="@+id/chevron_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
