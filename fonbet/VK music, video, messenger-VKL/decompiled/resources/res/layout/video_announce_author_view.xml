<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_announce_author_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:gravity="center_vertical"
        android:id="@+id/video_author_avatar_stub"
        android:layout="@layout/video_author_avatar_with_stroke"
        android:inflatedId="@+id/video_author_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/video_author_texts_container"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/video_author_buttons_barrier"
        app:layout_constraintStart_toEndOf="@+id/video_author_avatar"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/video_author_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:drawablePadding="4dp"
            style="@style/VkUiTypography.Headline1"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/video_author_amount_of_views"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkUiTypography.Footnote"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/video_author_buttons_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="left"
        app:constraint_referenced_ids="video_author_subscribe_button,video_author_subscribed_button"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/video_author_subscribe_button"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/video_subscribe_author"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/video_author_subscribed_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_btn_subscribed"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:icon="@drawable/vk_icon_done_16"
        app:iconColorful="?attr/vk_ui_icon_accent_themed"
        app:iconSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
