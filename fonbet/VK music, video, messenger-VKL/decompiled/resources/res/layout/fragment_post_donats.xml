<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/donut_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.paging.list.VkRecyclerPaginatedView
        android:id="@+id/donut_users_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/donut_button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vk_enableItemAnimations="true"/>
    <FrameLayout
        android:id="@+id/donut_button_container"
        android:background="?attr/vk_ui_background_modal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/donut_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"
            app:text="@string/modal_post_donut_choose_amount"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/donut_text_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/donut_users_recycler_view"
        app:layout_constraintEnd_toEndOf="@+id/donut_users_recycler_view"
        app:layout_constraintStart_toStartOf="@+id/donut_users_recycler_view"
        app:layout_constraintTop_toTopOf="@+id/donut_users_recycler_view"
        style="@style/VkUiTypography.Text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
