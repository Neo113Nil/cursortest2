<?xml version="1.0" encoding="utf-8"?>
<com.vk.attachpicker.widget.TopShadowLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/top_shadow"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/picker_toolbar_height"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/fl_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/content_overlay_view"
            android:background="@android:color/black"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/fl_bottom_button"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/bottom_button_shadow"
                android:background="@drawable/picker_bg_attach_bottom_toolbar_shadow"
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <FrameLayout
                android:id="@+id/buttons_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/first_step_button_container"
                    android:background="?attr/vk_ui_background_content"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/picker_bottom_button_container_height"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <com.vk.core.view.components.button.VkButton
                        android:id="@+id/acv_bottom_panel_counter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/picker_attach_button"
                        app:buttonAppearance="accent"
                        app:buttonMode="primary"
                        app:buttonSizeType="large"/>
                    <com.vk.core.view.components.button.VkSimpleButton
                        android:gravity="center"
                        android:id="@+id/tv_bottom_panel_cancel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/picker_cancel"
                        app:buttonAppearance="accent"
                        app:buttonMode="secondary"
                        app:buttonSizeType="large"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@+id/second_step_button_container"
                    android:background="?attr/vk_ui_background_content"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/picker_bottom_button_container_height"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <com.vk.core.view.components.button.VkSimpleButton
                        android:gravity="center"
                        android:id="@+id/second_step_cancel"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/picker_cancel"
                        android:maxLines="1"
                        android:layout_weight="1"
                        app:buttonAppearance="accent"
                        app:buttonMode="secondary"
                        app:buttonSizeType="large"/>
                    <View
                        android:layout_width="12dp"
                        android:layout_height="match_parent"/>
                    <com.vk.core.view.components.button.VkButton
                        android:id="@+id/second_step_continue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:buttonAppearance="accent"
                        app:buttonMode="primary"
                        app:buttonSizeType="large"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</com.vk.attachpicker.widget.TopShadowLinearLayout>
