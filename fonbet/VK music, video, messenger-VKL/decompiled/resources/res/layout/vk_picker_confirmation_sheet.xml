<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_bg_card_elevation_8_cropped_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/dialog_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/vk_picker_add_to_chat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_icon"
        style="@style/VkLegacyTypography.Title1"/>
    <Button
        android:id="@+id/dialog_dismiss"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:text="@string/vk_picker_confirm_dialog_cancel"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/dialog_confirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"
        style="@style/VkLegacyButton.Secondary.Big"/>
    <com.vk.core.view.ProgressButton
        android:id="@+id/dialog_confirm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/vk_picker_confirm_dialog_add"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:indeterminateTint="?attr/vk_legacy_button_primary_foreground"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_dismiss"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dialog_dismiss"
        app:layout_constraintTop_toTopOf="@+id/dialog_dismiss"
        style="@style/VkLegacyButton.Primary.Big"/>
</androidx.constraintlayout.widget.ConstraintLayout>
