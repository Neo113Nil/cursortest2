<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="14dp"
        android:text="@string/video_quality_new_additional"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="64dp"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_link"
        android:id="@+id/quality_settings_go_to"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="14dp"
        android:text="@string/video_quality_new_go_to"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="64dp"
        android:lineHeight="18sp"
        style="@style/VkUiTypography.Title2"/>
    <com.vk.core.view.components.divider.VkSeparator
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
