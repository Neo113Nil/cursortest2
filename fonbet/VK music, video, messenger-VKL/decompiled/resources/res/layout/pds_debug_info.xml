<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.FootnoteBold"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/pds_debug_info_label"
        android:background="@drawable/highlight"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/pds_debug_info_description"
        android:background="@drawable/highlight"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="5"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</merge>
