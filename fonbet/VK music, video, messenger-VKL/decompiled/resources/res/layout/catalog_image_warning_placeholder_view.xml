<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:paddingBottom="40dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="480dp"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/catalog_placeholder_view_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="22dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_ui_text_title_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_placeholder_view_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:drawablePadding="12dp"
        style="@style/VkUiTypography.Title2Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_placeholder_view_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:drawablePadding="12dp"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_placeholder_view_hint_description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/primary_button"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/secondary_button"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"/>
</LinearLayout>
