<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_bg_card_elevation_8_cropped_full"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/VoipSessionRoomList.Subhead"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/voip_session_room_name"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:lines="1"
        android:fontFamily="@font/vk_roboto_regular"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VoipSessionRoomList.Caption"
        android:gravity="center_vertical"
        android:id="@+id/voip_session_room_rename_button"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/voip_session_room_admin_room_rename"
        android:drawablePadding="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:drawableStartCompat="@drawable/vk_icon_edit_outline_28"
        app:drawableTint="?attr/vk_ui_text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_session_room_name"/>
    <TextView
        android:textAppearance="@style/VoipSessionRoomList.Caption"
        android:gravity="center_vertical"
        android:id="@+id/voip_session_room_remove_button"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:text="@string/voip_session_room_admin_room_remove"
        android:drawablePadding="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:drawableStartCompat="@drawable/vk_icon_delete_outline_28"
        app:drawableTint="@color/vk_red_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_session_room_rename_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
