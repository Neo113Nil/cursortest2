<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_modal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/select_language_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:layout_gravity="start"
        android:id="@+id/select_language_original_picker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size2_xl"
        android:text="@string/vkim_translate_language_picker_original_title"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_xl"/>
    <com.vk.core.view.components.formitem.VkInputSelect
        android:id="@+id/select_language_original_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_xl"
        android:hint="@string/vkim_translate_language_picker_original_title"
        android:inputType="textNoSuggestions"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_xl"
        style="@style/VkInput.Select"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:layout_gravity="start"
        android:id="@+id/select_language_translate_picker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
        android:text="@string/vkim_translate_language_picker_translate_title"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_xl"/>
    <com.vk.core.view.components.formitem.VkInputSelect
        android:id="@+id/select_language_translate_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_xl"
        android:inputType="textNoSuggestions"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_xl"
        style="@style/VkInput.Select"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/select_language_apply_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vkim_accept"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl"
        android:layout_marginVertical="@dimen/vk_ui_spacing_size_xl"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</LinearLayout>
