<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="28dp"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/finish"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="center"
        android:adjustViewBounds="false"
        android:contentDescription="@string/voip_broadcast_finish_short"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_16"
        app:tint="@color/vk_white"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:gravity="center_vertical"
        android:id="@+id/content"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/finish"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_broadcast_icon"
            android:layout_width="34dp"
            android:layout_height="16dp"
            android:src="@drawable/vk_icon_live_badge_16"
            android:scaleType="center"
            android:importantForAccessibility="no"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_record_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/vk_icon_recording_circle_fill_20"
            android:scaleType="center"
            android:tint="?attr/vk_ui_accent_red"
            android:importantForAccessibility="no"/>
        <TextView
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_broadcast_preview_counter_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:05"
            android:maxLines="2"
            android:layout_marginStart="6dp"
            app:vk_layout_isFluid="true"
            style="@style/VoipRunningTaskLabel.Title"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/divider"
            android:background="@color/vk_white_alpha60"
            android:layout_width="0.5dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="8dp"/>
        <TextView
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_broadcast_initiator_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            style="@style/VoipRunningTaskLabel.Title"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
