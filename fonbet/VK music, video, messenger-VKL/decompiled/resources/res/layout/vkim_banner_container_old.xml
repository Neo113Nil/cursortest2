<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/banner_container"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/pinned_msg_container"
        android:background="@drawable/vkim_bg_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/bar_container"
        android:background="@drawable/vkim_bg_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/business_notify_container"
        android:background="@drawable/vkim_bg_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/player_container"
        android:background="@drawable/vkim_bg_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/chat_audio_player_container"
        android:background="@drawable/vkim_bg_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/group_call_container"
        android:background="@drawable/vkim_bg_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/separator"
        app:vk_appbar_forceMode="separator"
        style="@style/AppBarShadow"/>
</FrameLayout>
