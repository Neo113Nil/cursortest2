<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/vk_highlight_radius_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="86dp">
    <ImageView
        android:id="@+id/icon_background"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_background_top_margin_space"/>
    <FrameLayout
        android:id="@+id/icon_container"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon_background"
        app:layout_constraintEnd_toEndOf="@+id/icon_background"
        app:layout_constraintStart_toStartOf="@+id/icon_background"
        app:layout_constraintTop_toTopOf="@+id/icon_background"/>
    <Space
        android:id="@+id/icon_background_top_margin_space"
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/icon_background"
        app:layout_constraintEnd_toEndOf="@+id/icon_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <Space
        android:id="@+id/icon_background_right_margin_space"
        android:layout_width="4dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/icon_background"
        app:layout_constraintTop_toTopOf="@+id/icon_background"/>
    <Space
        android:id="@+id/icon_background_bottom_margin_space"
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        app:layout_constraintEnd_toEndOf="@+id/icon_background"
        app:layout_constraintStart_toStartOf="@+id/icon_background"
        app:layout_constraintTop_toBottomOf="@+id/icon_background"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:minHeight="18dp"
        android:lines="1"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_background"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1Medium"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/counter"
        android:background="@drawable/vk_superapp_counter_bg_9"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginTop="1dp"
        android:minWidth="18dp"
        android:minHeight="18dp"
        android:singleLine="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toEndOf="@+id/icon_background_right_margin_space"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/icon_background"
        app:layout_constraintTop_toTopOf="@+id/icon_background_top_margin_space"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption2SemiBold"
        android:textColor="@color/vk_azure_300"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/badge"
        android:background="@drawable/vk_superapp_promo_badge_radius_4"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:singleLine="true"
        android:rotation="-5"
        android:paddingStart="4.5dp"
        android:paddingEnd="4.5dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon_background_bottom_margin_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_default="wrap"/>
    <ImageView
        android:id="@+id/new_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/icon_background"
        app:layout_constraintTop_toTopOf="@+id/icon_background"
        app:srcCompat="@drawable/vk_superapp_fintech_new_badge"/>
    <ImageView
        android:id="@+id/dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintEnd_toEndOf="@+id/icon_background_right_margin_space"
        app:layout_constraintTop_toTopOf="@+id/icon_background_top_margin_space"
        app:srcCompat="@drawable/vk_superapp_dot"/>
    <ImageView
        android:id="@+id/favorite_badge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintEnd_toEndOf="@+id/icon_background_right_margin_space"
        app:layout_constraintTop_toTopOf="@+id/icon_background_top_margin_space"/>
</androidx.constraintlayout.widget.ConstraintLayout>
