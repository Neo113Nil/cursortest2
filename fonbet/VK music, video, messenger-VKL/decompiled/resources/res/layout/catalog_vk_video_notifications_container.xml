<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end|center_vertical"
    android:id="@+id/notifications_container"
    android:layout_width="48dp"
    android:layout_height="48dp">
    <ImageView
        android:id="@+id/notifications_button"
        android:background="@drawable/highlight_unbounded"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/video_catalog_header_accessibility_open_notifications"
        app:srcCompat="@drawable/vk_icon_animated_notification_receive_28_60fps"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/counter"
        android:background="@drawable/bottom_navigation_counter_bg"
        android:paddingLeft="@dimen/vk_bottom_navigation_counter_padding"
        android:paddingRight="@dimen/vk_bottom_navigation_counter_padding"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vk_bottom_navigation_counter_height_outer"
        android:layout_marginTop="8dp"
        android:minWidth="@dimen/vk_bottom_navigation_counter_height_outer"
        android:minHeight="@dimen/vk_bottom_navigation_counter_height_outer"
        android:singleLine="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"/>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/dot"
        android:background="@drawable/app_bar_notification_dot_corner"
        android:visibility="gone"
        android:layout_width="@dimen/vk_bottom_navigation_dot_height"
        android:layout_height="@dimen/vk_bottom_navigation_dot_height"
        android:layout_marginTop="10dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginEnd="10dp"
        android:backgroundTint="?attr/vk_ui_accent_red"/>
</FrameLayout>
