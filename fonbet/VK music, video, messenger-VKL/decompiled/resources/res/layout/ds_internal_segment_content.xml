<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@android:id/icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_s"
        app:tint="?attr/vk_ui_icon_primary"/>
    <TextView
        android:textAppearance="?attr/vk_ui_typography_headline2"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@android:id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
</merge>
