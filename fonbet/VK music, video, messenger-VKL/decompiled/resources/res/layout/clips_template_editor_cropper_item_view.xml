<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="68dp">
        <com.vk.clips.design.view.timeline.VideoTimelineView
            android:layout_gravity="center"
            android:id="@+id/clips_template_editor_cropper_timeline_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vtv_corner_radius="8dp"
            app:vtv_custom_bounds="true"
            app:vtv_frame_height="56dp"
            app:vtv_outbound_frames_color="@color/vk_black_alpha45"
            app:vtv_timeline_height="64dp"/>
    </LinearLayout>
</merge>
