<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/toolbar"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_scrollFlags="snap|enterAlways"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/ll_stories_scroll_content"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize">
        <LinearLayout
            android:orientation="vertical"
            android:background="?attr/vk_ui_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/general_ll"
                android:background="?attr/vk_ui_background_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.core.view.components.group.header.VkGroupHeader
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/general_gh"
                    android:background="?attr/vk_ui_background_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/story_setting_camera_general"
                    android:textAlignment="viewStart"/>
                <com.vk.core.view.components.cell.VkCell
                    android:id="@+id/hidden_from_stories"
                    android:background="?attr/vk_ui_background_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.vk.core.view.components.cell.VkCell
                    android:id="@+id/camera_60fps"
                    android:background="?attr/vk_ui_background_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.vk.core.view.components.cell.VkCell
                    android:id="@+id/camera_grid"
                    android:background="?attr/vk_ui_background_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.vk.core.view.components.cell.VkCell
                    android:id="@+id/save_stories"
                    android:background="?attr/vk_ui_background_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.vk.core.view.components.cell.button.VkCellButton
                    android:id="@+id/clear_masks_cache"
                    android:background="?attr/vk_ui_background_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <com.vk.core.view.components.group.header.VkGroupHeader
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center_vertical"
                android:id="@+id/stories_privacy_label"
                android:background="?attr/vk_ui_background_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_stories_privacy_holder"
                android:background="?attr/vk_ui_background_content"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_discover_settings"
                android:background="?attr/vk_ui_background_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.core.view.components.group.header.VkGroupHeader
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/discover_group_header"
                    android:background="?attr/vk_ui_background_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"/>
                <com.vk.core.view.components.cell.VkCell
                    android:id="@+id/show_discover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/ll_stories_progress"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"/>
    <com.vk.core.view.components.button.VkButton
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/stories_reload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/refresh"
        android:paddingHorizontal="8dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:text="@string/refresh"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
