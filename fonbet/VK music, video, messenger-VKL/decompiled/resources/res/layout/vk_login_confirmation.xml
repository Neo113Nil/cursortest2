<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VKAppBar">
        <com.vk.superapp.ui.toolbar.VkAuthToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationContentDescription="@string/vk_auth_accessibility_close"
            app:navigationIcon="@drawable/vk_icon_cancel_alt_outline_28"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/allow"
        app:layout_constraintTop_toBottomOf="@+id/app_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/vk_icon_error_outline_56"
                app:tint="?attr/vk_ui_icon_tertiary"/>
            <TextView
                android:textColor="@color/vk_ui_text_title_color"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/vk_login_confirmation_title"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                style="@style/VkUiTypography.Title1Medium"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/user_container"
                android:background="@drawable/vk_auth_bg_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <com.vk.core.ui.themes.VKReplacerView
                    android:id="@+id/user_avatar_view"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/vk_ui_text_title_color"
                    android:id="@+id/username"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toTopOf="@+id/user_city"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/user_avatar_view"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/VkUiTypography.Headline1"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/user_city"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/user_avatar_view"
                    app:layout_constraintTop_toBottomOf="@+id/username"
                    style="@style/VkUiTypography.Footnote"/>
                <include layout="@layout/vk_login_confirmation_user_progress"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/info_recycler"
                    android:paddingBottom="10dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/error_retry_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp">
                    <TextView
                        android:textColor="?attr/vk_ui_text_secondary"
                        android:gravity="center_horizontal"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/error_retry_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vk_login_confirmation_user_data_error"
                        style="@style/VkUiTypography.Headline1Normal"/>
                    <com.vk.core.view.components.button.VkSimpleButton
                        android:ellipsize="end"
                        android:id="@+id/error_retry"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/vk_common_retry"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        app:buttonAppearance="accent"
                        app:buttonMode="tertiary"
                        style="@style/VkAuth.Button.Primary"/>
                </LinearLayout>
                <include layout="@layout/vk_login_confirmation_progress"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@+id/app_bar"
        app:srcCompat="?attr/vk_toolbar_shadow"/>
    <com.vk.auth.ui.VkLoadingButton
        android:id="@+id/allow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_login_confirmation_allow"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/deny"
        style="@style/VkAuth.Button.Primary"/>
    <com.vk.auth.ui.VkLoadingButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/deny"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_login_confirmation_deny"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/VkAuth.Button.Secondary"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/status_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/status_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/vk_icon_error_outline_56"/>
        <TextView
            android:textColor="@color/vk_ui_text_title_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/status_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/VkUiTypography.Title2Normal"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center_horizontal"
            android:id="@+id/status_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/VkUiTypography.Headline1Normal"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/status_button"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"
            style="@style/VkAuth.Button.Primary"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
