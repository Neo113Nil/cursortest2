<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="5dp"
    android:paddingVertical="@dimen/vk_ui_spacing_size2_xs">
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:id="@+id/info_badge_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/VkUiTypography.Caption3Caps.Unscaled"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/info_badge_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"/>
</androidx.appcompat.widget.LinearLayoutCompat>
