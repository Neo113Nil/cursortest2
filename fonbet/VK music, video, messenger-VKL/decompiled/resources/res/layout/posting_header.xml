<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/close"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:gravity="center_vertical"
        android:id="@+id/btn_done"
        android:background="@drawable/ripple_10dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginVertical="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_divider"
        app:layout_constraintEnd_toStartOf="@+id/author_avatar_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="12dp"
        style="@style/VkUiTypography.Headline2"/>
    <com.vk.newsfeed.impl.posting.avatar.PostingAvatarViewContainer
        android:id="@+id/author_avatar_image"
        android:focusable="true"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundAvatarSize="28dp"/>
    <View
        android:id="@+id/v_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="0dp"
        android:layout_height="@dimen/newsfeed_newpost_header_divider_height"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_close"/>
    <TextView
        android:textColor="@color/vk_steel_gray_400"
        android:ellipsize="end"
        android:id="@+id/tv_author"
        android:paddingTop="5.5dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="13dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_divider"
        style="@style/VkUiTypography.Subhead"/>
</androidx.constraintlayout.widget.ConstraintLayout>
