<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/white_label_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.ui.CircularProgressView
        android:id="@+id/white_label_progress_bar"
        android:layout_width="47dp"
        android:layout_height="47dp"
        android:indeterminate="true"
        app:cpv_animAutostart="true"
        app:cpv_color="?attr/vk_ui_icon_medium"
        app:cpv_indeterminate="true"
        app:cpv_thickness="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/white_label_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VKID.Text.DisplayTitle2SemiBold"/>
    <TextView
        android:gravity="center"
        android:id="@+id/white_label_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/white_label_title"
        style="@style/VKID.Text.Headline1Normal"/>
    <com.vk.core.ui.themes.VKReplacerView
        android:id="@+id/white_label_avatar_view"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/white_label_subtitle"/>
    <TextView
        android:id="@+id/white_label_user_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/white_label_avatar_view"
        style="@style/VKID.Text.Headline1Medium"/>
    <TextView
        android:id="@+id/white_label_user_phone"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/white_label_user_name"
        style="@style/VKID.Text.SubheadNormal"/>
    <com.vk.auth.ui.VkLoadingButton
        android:id="@+id/continue_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_auth_confirm"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/white_label_another_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:vk_lb_text_appearance="@style/VKID.Text.Button.Primary"
        app:vk_lb_use_vk_ui="true"
        style="@style/VKID.View.Button.Primary"/>
    <com.vk.auth.ui.VkLoadingButton
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/white_label_another_account"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_auth_use_another_account"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:vk_lb_text_appearance="@style/VKID.Text.Headline1Medium"
        app:vk_lb_use_vk_ui="true"
        style="@style/VKID.View.Button.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
