<?xml version="1.0" encoding="utf-8"?>
<com.vk.im.ui.components.msg_send.recording.AudioRecordOverlay xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vkim_voice_recording_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    app:targetId="@+id/msg_list">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vkim_cancel_container"
        android:background="?attr/vk_legacy_background_content"
        android:layout_width="0dp"
        android:layout_height="@dimen/vkim_audio_hold_container_height"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:id="@+id/vkim_cancel_arrow_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rotation="90"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/vkim_cancel"
            app:layout_constraintRight_toLeftOf="@+id/vkim_cancel"
            app:layout_constraintTop_toTopOf="@+id/vkim_cancel"
            app:srcCompat="@drawable/vk_icon_dropdown_16"
            app:tint="?attr/vk_legacy_text_subhead"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_subhead"
            android:id="@+id/vkim_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vkim_audio_hold_container_cancel_margin"
            android:text="@string/vkim_cancel"
            android:textAllCaps="true"
            android:layout_marginStart="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_subhead"
            android:layout_gravity="bottom"
            android:id="@+id/vkim_processing_label"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vkim_audio_hold_container_cancel_margin"
            android:text="@string/vkim_loading"
            android:layout_marginStart="38dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/vkim_cancel_container_border"
        android:background="?attr/vk_legacy_separator_alternate"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/vkim_cancel_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <ImageView
        android:id="@+id/vkim_cancel_mic_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.4"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/vk_icon_voice_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
    <com.pnikosis.materialishprogress.ProgressWheel
        android:id="@+id/vkim_proccessing_progress"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:matProg_barColor="?attr/vk_legacy_accent"
        app:matProg_barWidth="3dp"
        app:matProg_progressIndeterminate="true"/>
    <FrameLayout
        android:id="@+id/vkim_voice_record_hold"
        android:background="@drawable/bg_voice_msg_tip"
        android:paddingTop="24dp"
        android:paddingBottom="50dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="108dp"
        android:layout_marginBottom="124dp"
        android:layout_marginEnd="-8dp"
        android:backgroundTint="?attr/vk_legacy_modal_card_background"
        android:backgroundTintMode="multiply"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/vkim_hold_arrow"
            android:layout_width="14dp"
            android:layout_height="wrap_content"
            android:rotation="180"
            app:srcCompat="@drawable/vk_icon_dropdown_16"
            app:tint="?attr/vk_legacy_icon_outline_secondary"/>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/vkim_hold_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_unlocked_16"
            app:tint="?attr/vk_legacy_icon_outline_secondary"/>
    </FrameLayout>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/vkim_wave_container"
        android:background="@drawable/bg_voice_msg_recording"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="102dp"
        android:layout_marginBottom="50dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:layout_marginEnd="-8dp"
        android:backgroundTint="?attr/vk_legacy_modal_card_background"
        android:backgroundTintMode="multiply"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/vkim_audio_send"
            android:background="@drawable/bg_im_send_audio_btn"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:contentDescription="@string/vkim_accessibility_send"
            app:tint="?attr/vk_legacy_background_content">
            <ImageView
                android:id="@+id/vkim_audio_send_ic"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="13dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="?attr/im_ic_send_msg"
                android:scaleType="fitCenter"
                app:tint="?attr/vk_legacy_background_content"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/vkim_play_pause"
            android:background="@drawable/bg_im_play_audio_btn_accent"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:contentDescription="@string/vkim_accessibility_stop">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/vkim_play_pause_icon"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/vk_icon_stop_24"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="88dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <com.vk.im.ui.views.WaveFormView
                android:id="@+id/vkim_wave"
                android:layout_width="86dp"
                android:layout_height="13dp"
                android:layout_marginEnd="2dp"
                app:vkim_amplifyThreshold="1"
                app:vkim_barWidth="2dp"
                app:vkim_indeterminate="false"
                app:vkim_primaryColor="?attr/vk_legacy_accent"
                app:vkim_spaceWidth="2dp"/>
            <View
                android:layout_gravity="bottom"
                android:background="@drawable/vkim_red_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginBottom="4sp"
                android:translationY="2dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="?attr/vk_legacy_accent"
                android:layout_gravity="bottom"
                android:id="@+id/vkim_voice_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationY="2dp"
                android:fontFamily="@font/vk_roboto_medium"
                android:layout_marginStart="14dp"/>
        </FrameLayout>
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/vkim_cancel_label"
            android:background="@drawable/bg_im_audio_cancel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="28dp"
            android:minWidth="92dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/vkim_cancel_label_text"
                app:srcCompat="@drawable/vk_icon_cancel_16"
                app:tint="?attr/vk_legacy_destructive"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/vk_legacy_destructive"
                android:gravity="center"
                android:id="@+id/vkim_cancel_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vkim_cancel"
                android:layout_centerInParent="true"
                android:textAllCaps="true"
                android:fontFamily="@font/vk_roboto_medium"/>
        </RelativeLayout>
    </FrameLayout>
</com.vk.im.ui.components.msg_send.recording.AudioRecordOverlay>
