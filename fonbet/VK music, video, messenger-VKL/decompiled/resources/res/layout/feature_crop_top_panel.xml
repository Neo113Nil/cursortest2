<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:splitMotionEvents="true">
    <Button
        android:textStyle="bold"
        android:id="@+id/button_crop_reset"
        android:background="@drawable/ripple_50dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_crop_reset"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/editorButtonCompatStyle"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/container_button_crop_mirror"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/button_crop_mirror"
                android:background="@drawable/ripple_50dp"
                android:padding="10dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/is_mirror"
                android:contentDescription="@string/editor_crop_mirror"
                style="?attr/editorButtonPrimaryStyle"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/container_button_crop_rotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp">
            <ImageButton
                android:id="@+id/button_crop_rotate"
                android:background="@drawable/ripple_50dp"
                android:padding="10dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_rotate_left"
                android:contentDescription="@string/editor_crop_rotate_left_90"
                style="?attr/editorButtonPrimaryStyle"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
