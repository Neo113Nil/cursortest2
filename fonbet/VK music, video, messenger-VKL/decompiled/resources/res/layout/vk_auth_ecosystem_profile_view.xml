<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_view_container"
    android:paddingTop="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profile_user_data_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.superapp.design.view.multiaccount.avatar.VkProfileAvatarView
            android:id="@+id/user_avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_ui_text_title_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_avatar"
            style="@style/VkUiTypography.DisplayTitle4Medium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/user_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_name"
            style="@style/VkUiTypography.Footnote"/>
        <com.vk.superapp.multiaccount.impl.ecosystemswitcher.view.VkEcosystemProfileButtonView
            android:id="@+id/vk_id_lk_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/logout_button"
            app:layout_constraintTop_toBottomOf="@+id/user_info"
            app:layout_constraintVertical_chainStyle="packed"/>
        <com.vk.superapp.multiaccount.impl.ecosystemswitcher.view.VkEcosystemLogoutButtonView
            android:layout_gravity="start"
            android:id="@+id/logout_button"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/vk_auth_switcher_logout_talkback"
            android:layout_marginEnd="8dp"
            app:layout_constraintLeft_toRightOf="@+id/vk_id_lk_button"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_info"
            app:vk_logout_icon="@drawable/vk_icon_door_arrow_right_outline_24"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/vk_auth_ecosystem_profile_loading_layout"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/profile_error_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:layout_gravity="center"
            android:id="@+id/error_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/vk_auth_loading_error"
            style="@style/VkUiTypography.Headline1Normal"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="center"
            android:id="@+id/profile_retry_button"
            android:layout_width="102dp"
            android:layout_height="36dp"
            android:text="@string/vk_auth_retry"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="large"/>
    </LinearLayout>
</FrameLayout>
