<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/likes"
        android:background="@drawable/video_controls_bar_bg"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:contentDescription="@string/accessibility_like"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_likes"
            android:duplicateParentState="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/video_controls_bar_like"
            app:tint="@color/video_controls_bar_icon_like"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/video_controls_bar_text_like"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_likes"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            style="@style/VkUiTypography.SubheadMedium"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/video_controls_bar_text"
        android:gravity="center_vertical"
        android:id="@+id/comments"
        android:background="@drawable/video_controls_bar_bg"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:drawablePadding="0dp"
        android:contentDescription="@string/accessibility_comments"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="2dp"
        app:drawableLeftCompat="@drawable/vk_icon_comment_outline_24"
        app:drawableTint="@color/video_controls_bar_icon"
        style="@style/VkUiTypography.SubheadMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/video_controls_bar_text"
        android:gravity="center_vertical"
        android:id="@+id/shares"
        android:background="@drawable/video_controls_bar_bg"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:drawablePadding="0dp"
        android:contentDescription="@string/accessibility_share"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="2dp"
        app:drawableLeftCompat="@drawable/vk_icon_share_outline_24"
        app:drawableTint="@color/video_controls_bar_icon"
        style="@style/VkUiTypography.SubheadMedium"/>
    <Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/watch_video_later"
        android:background="@drawable/video_controls_bar_bg"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:contentDescription="@string/video_accessibility_watch_later_video"
        android:layout_marginStart="2dp"
        app:srcCompat="@drawable/video_controls_bar_watch_later"
        app:tint="@color/video_controls_bar_icon"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/more"
        android:background="@drawable/video_controls_bar_bg"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:contentDescription="@string/menu"
        android:layout_marginStart="2dp"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"
        app:tint="@color/video_controls_bar_icon"/>
</merge>
