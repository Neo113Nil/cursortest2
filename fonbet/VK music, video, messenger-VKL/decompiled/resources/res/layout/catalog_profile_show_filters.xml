<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/horizontal_vh_filters_container"
    android:paddingTop="6dp"
    android:paddingBottom="9dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/catalog_vertical_padding">
    <com.vk.core.view.components.subnavigation.VkSubnavigationButton
        android:id="@+id/horizontal_filters_show_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/horizontal_filters_separator"
        android:background="?attr/vk_ui_field_border_alpha"
        android:layout_width="0.5dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/horizontal_filters_show_btn"
        app:layout_constraintStart_toEndOf="@+id/horizontal_filters_show_btn"
        app:layout_constraintTop_toTopOf="@+id/horizontal_filters_show_btn"/>
    <View
        android:id="@+id/horizontal_filters_gradient"
        android:background="@drawable/catalog_video_filter_gradient"
        android:layout_width="36dp"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/horizontal_filters_separator"
        app:layout_constraintStart_toEndOf="@+id/horizontal_filters_separator"
        app:layout_constraintTop_toTopOf="@+id/horizontal_filters_separator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
