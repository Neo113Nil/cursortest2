<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlist_header_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_collapseMode="parallax">
    <ImageView
        android:id="@+id/cover_overlay"
        android:background="@drawable/cover_scrim"
        android:paddingTop="@dimen/video_catalog_playlist_cover_padding_top"
        android:paddingBottom="@dimen/video_catalog_playlist_cover_padding_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/empty_playlist_cover"
        app:layout_constraintBottom_toBottomOf="@+id/video_playlist_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/video_playlist_cover"/>
    <com.vk.imageloader.view.VkImageViewTopCrop
        android:id="@+id/video_playlist_cover"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_catalog_playlist_cover_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.button.VkButton
        android:gravity="center"
        android:id="@+id/watch_button"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="@dimen/vk_video_profile_v2_toolbar_buttons_margin"
        android:layout_marginEnd="4dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="@+id/video_playlist_cover"
        app:layout_constraintEnd_toStartOf="@+id/subscribe_button"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:gravity="center"
        android:id="@+id/subscribe_button"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/video_catalog_subscribe"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/vk_video_profile_v2_toolbar_buttons_margin"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="@+id/video_playlist_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/watch_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
