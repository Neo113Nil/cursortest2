<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.stories.design.view.stats.carousel.PreviewSnapRecyclerView
        android:id="@+id/preview_recycler"
        android:visibility="invisible"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/story_statistics_preview_top_margin"
        android:layout_marginBottom="@dimen/story_statistics_preview_bottom_margin"
        app:layout_constraintBottom_toBottomOf="@+id/preview_bottom_border"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/collapsible_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/story_statistics_preview_top_margin"
        android:layout_marginBottom="@dimen/story_statistics_preview_bottom_margin"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/preview_bottom_border"
        app:layout_constraintDimensionRatio="W,9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/story_statistics_preview_item_corner_radius"/>
    <ImageView
        android:id="@+id/button_settings"
        android:background="@drawable/vk_ripple_circle_highlight"
        android:padding="8dp"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_gear_outline_24"
        android:contentDescription="@string/story_statistics_settings"
        android:paddingStart="16dp"
        android:layout_marginVertical="@dimen/story_statistics_button_top_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vk_white"/>
    <ImageView
        android:id="@+id/button_close"
        android:background="@drawable/vk_ripple_circle_highlight"
        android:padding="8dp"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_cancel_outline_24"
        android:contentDescription="@string/story_statistics_close"
        android:paddingEnd="16dp"
        android:accessibilityTraversalAfter="@+id/button_settings"
        android:layout_marginVertical="@dimen/story_statistics_button_top_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vk_white"/>
    <ViewSwitcher
        android:id="@+id/button_privacy"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/story_statistics_privacy_bottom_margin"
        app:layout_constraintBottom_toBottomOf="@+id/preview_bottom_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.vk.core.view.components.button.tool.VkToolButton
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/story_statistics_privacy_height"
            app:iconSize="20dp"
            app:toolButtonTextPosition="right"
            app:useUnscaledFont="true"/>
        <com.vk.core.view.components.button.tool.VkToolButton
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/story_statistics_privacy_height"
            app:iconSize="20dp"
            app:toolButtonTextPosition="right"
            app:useUnscaledFont="true"/>
    </ViewSwitcher>
    <View
        android:id="@+id/preview_bottom_border"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</merge>
