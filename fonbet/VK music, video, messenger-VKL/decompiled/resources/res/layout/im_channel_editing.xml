<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/channel_creation"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/im_appbar"
        android:layout_width="match_parent"
        style="@style/Vk.Theme.Appbar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/im_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/im_channel_editing"
            style="@style/VkIm.Toolbar.Style.LargeWithBack">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/im_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/im_new_channel_channel_settings"
                android:lines="1"
                style="@style/VkUiTypography.DisplayTitle2"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.im.ui.views.avatars.AvatarView
                android:id="@+id/im_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/im_channel_photo"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.vk.core.view.components.formitem.VkInputSelect
                android:id="@+id/im_channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/im_enter_name"
                android:lines="1"
                android:maxLength="48"
                android:inputType="textCapSentences"
                android:imeOptions="actionDone"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/im_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/im_avatar"
                style="@style/VkInput"/>
            <TextView
                android:textColor="?attr/vk_ui_text_subhead"
                android:id="@+id/im_channel_name_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/im_channel_editing_name_hint"
                app:layout_constraintBottom_toTopOf="@+id/im_channel_name"
                app:layout_constraintEnd_toEndOf="@+id/im_channel_name"
                app:layout_constraintStart_toStartOf="@+id/im_channel_name"
                style="@style/VkUiTypography.Subhead"/>
            <com.vk.core.view.components.cell.VkCell
                android:id="@+id/im_switch_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/im_channel_name"/>
            <com.vk.core.view.components.cell.button.VkCellButton
                android:id="@+id/im_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cellButtonAppearance="negative"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/im_switch_comments"
                app:title="@string/im_new_channel_delete"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="bottom"
        android:id="@+id/snackbar_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_anchor="@+id/scrollView2"
        app:layout_anchorGravity="center"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
