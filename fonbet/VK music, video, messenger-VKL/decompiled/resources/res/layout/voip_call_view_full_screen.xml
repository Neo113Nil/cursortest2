<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/iv_peer_big_blurred_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/fl_render_container_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/fl_p2p_render_container_remote_big"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/iv_p2p_remote_stub"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ll_p2p_remote_mic_cam"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_margin="12dp"
                android:translationY="-36dp"
                android:scaleX="4"
                android:scaleY="4">
                <ImageView
                    android:id="@+id/iv_p2p_remote_mic_off"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/vk_icon_microphone_slash_24"
                    app:tint="@color/vk_white"/>
                <ImageView
                    android:id="@+id/iv_p2p_remote_cam_off"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/vk_icon_videocam_slash_24"
                    app:tint="@color/vk_white"/>
            </LinearLayout>
            <View
                android:id="@+id/big_touch_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fl_p2p_render_container_own_minimized"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/iv_p2p_own_preview"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ll_p2p_own_mic_cam"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_margin="12dp"
                android:translationY="-36dp"
                android:scaleX="4"
                android:scaleY="4">
                <ImageView
                    android:id="@+id/iv_p2p_own_mic_off"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/vk_icon_microphone_slash_24"
                    app:tint="@color/vk_white"/>
                <ImageView
                    android:id="@+id/iv_p2p_own_cam_off"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/vk_icon_videocam_slash_24"
                    app:tint="@color/vk_white"/>
            </LinearLayout>
            <View
                android:id="@+id/thumb_touch_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_main"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:id="@+id/fl_peer_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="200dp"
            android:minHeight="200dp"
            android:importantForAccessibility="no">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/peer_photo_bg_circle_one"
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:src="@drawable/white_oval"
                android:scaleType="fitXY"
                android:contentDescription="@string/photo"
                android:alpha="0.2"
                app:layout_constraintBottom_toBottomOf="@+id/iv_peer_photo"
                app:layout_constraintEnd_toEndOf="@+id/iv_peer_photo"
                app:layout_constraintStart_toStartOf="@+id/iv_peer_photo"
                app:layout_constraintTop_toTopOf="@+id/iv_peer_photo"
                app:tint="@color/vk_white"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/peer_photo_bg_circle_two"
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:src="@drawable/white_oval"
                android:scaleType="fitXY"
                android:contentDescription="@string/photo"
                android:alpha="0.2"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="@+id/iv_peer_photo"
                app:layout_constraintEnd_toEndOf="@+id/iv_peer_photo"
                app:layout_constraintStart_toStartOf="@+id/iv_peer_photo"
                app:layout_constraintTop_toTopOf="@+id/iv_peer_photo"
                app:tint="@color/vk_white"/>
            <com.vk.voip.ui.avatars.VoipAvatarViewContainer
                android:layout_gravity="center"
                android:id="@+id/iv_peer_photo"
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:contentDescription="@string/photo"
                android:importantForAccessibility="no"
                app:emptyImagePlaceholder="@drawable/ic_user_260"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundAvatarSize="120dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/vk_white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_peer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:shadowColor="#3d000000"
                android:shadowRadius="4"
                android:fontFamily="@font/vk_roboto_medium"
                android:letterSpacing="0.02"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_peer_photo"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ru.ok.android.externcalls.sdk.stat.view.TextStatRendererView
            android:layout_gravity="center_vertical"
            android:id="@+id/debug_media_stat_fullscreen"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="300dp"/>
        <com.vk.voip.ui.groupcalls.grid.GroupCallGridContainerView
            android:id="@+id/grid_group_call_view"
            android:background="@color/vk_black"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.voip.ui.groupcalls.list.ListGroupCallView
            android:id="@+id/list_group_call_view"
            android:background="@color/vk_black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.voip.ui.feedback.ui.FeedbackGroupCallFlyView
            android:id="@+id/feedback_group_fly_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.voip.ui.feedback.ui.FeedbackP2PCallFlyView
            android:id="@+id/feedback_p2p_fly_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_scrims"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="top"
                android:id="@+id/scrim_top"
                android:background="@drawable/scrim_top"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3"
                android:alpha="0.64"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/scrim_bottom"
                android:background="@drawable/scrim_bottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3"
                android:alpha="0.48"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_layers_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.voip.ui.debug.view.HeadersViewBoundsDebugView
                android:id="@+id/bounds_debug_view"
                android:background="@drawable/voip_control_bounds_debug_view_background"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/top_layers_background"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/top_layers_bottom_barrier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/top_layers_fits_system_windows_anchor"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/session_room_indicator_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_layers_fits_system_windows_anchor"/>
            <FrameLayout
                android:id="@+id/broadcast_preview_simple_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/session_room_indicator_container"/>
            <FrameLayout
                android:id="@+id/broadcast_preview_extended_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/broadcast_preview_simple_container"/>
            <FrameLayout
                android:id="@+id/asr_preview_extended_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/broadcast_preview_extended_container"/>
            <FrameLayout
                android:id="@+id/screencast_preview_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/asr_preview_extended_container"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/top_layers_bottom_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierAllowsGoneWidgets="false"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="broadcast_preview_simple_container,broadcast_preview_extended_container,screencast_preview_container, asr_preview_extended_container"/>
            <View
                android:id="@+id/voip_waiting_room_label_background"
                android:background="@color/vk_black_alpha35"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/in_call_header_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/screencast_preview_container"
                layout="@layout/voip_call_view_header_in_call"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/voip_waiting_room_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:maxWidth="300dp"
                android:maxLines="3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/in_call_header_container"/>
            <include
                android:id="@+id/voip_indicators_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/in_call_header_container"
                layout="@layout/voip_indicators_layout"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/call_state_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:shadowColor="@color/vk_white"
                android:shadowRadius="4"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/voip_indicators_container"
                style="@style/VoipRunningTaskLabel.Title"/>
            <FrameLayout
                android:id="@+id/header_join_link_notification_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/in_call_header_container"/>
            <FrameLayout
                android:id="@+id/header_join_as_contact_notification_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/in_call_header_container"/>
            <include
                android:id="@+id/voip_waiting_room_notification_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/in_call_header_container"
                layout="@layout/voip_waiting_room_admin_notification"/>
            <TextView
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:id="@+id/header_network_status_opponent_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="36dp"
                android:text="@string/voip_call_network_status_opponent_bad"
                android:shadowColor="@color/vk_black_alpha24"
                android:shadowRadius="4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/voip_indicators_container"
                style="@style/VkLegacyTypography.Subhead1.Medium"/>
            <include
                android:id="@+id/incoming_call_header_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/screencast_preview_container"
                layout="@layout/voip_call_view_header_incoming_call"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <include layout="@layout/voip_holiday_interaction"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/session_room_transition_indicator_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/voip_hint_view_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.vk.voip.ui.hint.VoipHintView
                    android:layout_gravity="center"
                    android:id="@+id/voip_hint_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
            <com.vk.voip.ui.menu.ui.MainMenuView
                android:id="@+id/voip_call_view_slide_up_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="vertical"
            android:id="@+id/fl_answer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/fl_answer_contact_call_warning"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="36dp"
                layout="@layout/voip_call_view_fl_answer_contact_call_warning"/>
            <FrameLayout
                android:id="@+id/fl_answer_audio"
                android:layout_width="match_parent"
                android:layout_height="144dp">
                <com.vk.voip.ui.VoipTextButton
                    android:id="@+id/btn_accept_audio"
                    android:layout_width="152dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/voip_accessibility_accept_call_audio"
                    app:background="@drawable/voip_button_accept"
                    app:btnLabelText="@string/voip_accept"
                    app:iconSrc="@drawable/vk_icon_phone_36"
                    app:iconTint="@color/vk_white"/>
                <com.vk.voip.ui.VoipTextButton
                    android:layout_gravity="right"
                    android:id="@+id/btn_decline_call"
                    android:layout_width="152dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/voip_accessibility_decline_call"
                    app:background="@drawable/voip_button_decline"
                    app:btnLabelText="@string/voip_decline"
                    app:iconSrc="@drawable/vk_icon_cancel_36"
                    app:iconTint="@color/vk_white"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_answer_video"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="144dp">
                <com.vk.voip.ui.VoipTextButton
                    android:id="@+id/btn_accept_video_call"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/voip_accessibility_accept_call_video"
                    app:background="@drawable/voip_button_accept"
                    app:btnLabelText="@string/voip_reply_with_video"
                    app:iconSrc="@drawable/vk_icon_videocam_36"
                    app:iconTint="@color/vk_white"/>
                <com.vk.voip.ui.VoipTextButton
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/btn_accept_audio_call"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@string/voip_accessibility_accept_call_audio"
                    app:background="@drawable/voip_button_cancel"
                    app:btnLabelText="@string/voip_reply_with_audio"
                    app:btnSmall="true"
                    app:iconSrc="@drawable/vk_icon_phone_32"
                    app:iconTint="@color/vk_white"/>
                <com.vk.voip.ui.VoipTextButton
                    android:layout_gravity="right"
                    android:id="@+id/btn_decline_video_call"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/voip_accessibility_decline_call"
                    app:background="@drawable/voip_button_decline"
                    app:btnLabelText="@string/voip_decline_call"
                    app:iconSrc="@drawable/vk_icon_cancel_36"
                    app:iconTint="@color/vk_white"/>
            </FrameLayout>
        </LinearLayout>
        <com.vk.attachpicker.widget.MaxWidthFrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/fl_message_recording_actinos"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="144dp">
            <com.vk.voip.ui.VoipTextButton
                android:id="@+id/btn_send_audio_message"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="152dp"
                android:layout_height="wrap_content"
                app:background="@drawable/voip_button_send"
                app:btnLabelText="@string/voip_send_audio_message"
                app:iconSrc="@drawable/vk_icon_send_36"
                app:iconTint="@color/vk_white"
                app:inactiveBackground="@drawable/voip_button_cancel"/>
            <com.vk.voip.ui.VoipTextButton
                android:layout_gravity="right"
                android:id="@+id/btn_cancel_recording"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="152dp"
                android:layout_height="wrap_content"
                app:background="@drawable/voip_button_cancel"
                app:btnLabelText="@string/voip_cancel_audio_message"
                app:iconSrc="@drawable/vk_icon_cancel_36"
                app:iconTint="@color/vk_white"/>
        </com.vk.attachpicker.widget.MaxWidthFrameLayout>
        <com.vk.attachpicker.widget.MaxWidthFrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/fl_callback_actions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="144dp">
            <com.vk.voip.ui.VoipTextButton
                android:id="@+id/btn_callback"
                android:layout_width="152dp"
                android:layout_height="wrap_content"
                app:background="@drawable/voip_button_accept"
                app:btnLabelText="@string/voip_recall"
                app:iconSrc="@drawable/vk_icon_phone_36"/>
            <com.vk.voip.ui.VoipTextButton
                android:id="@+id/btn_callback_video"
                android:layout_width="152dp"
                android:layout_height="wrap_content"
                app:background="@drawable/voip_button_accept"
                app:btnLabelText="@string/voip_recall"
                app:iconSrc="@drawable/vk_icon_videocam_36"/>
            <com.vk.voip.ui.VoipTextButton
                android:layout_gravity="right"
                android:id="@+id/btn_cancel"
                android:layout_width="152dp"
                android:layout_height="wrap_content"
                app:background="@drawable/voip_button_cancel"
                app:btnLabelText="@string/voip_close"
                app:iconSrc="@drawable/vk_icon_cancel_36"
                app:iconTint="@color/vk_white"/>
        </com.vk.attachpicker.widget.MaxWidthFrameLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/broadcast_launch_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/broadcast_finish_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</merge>
