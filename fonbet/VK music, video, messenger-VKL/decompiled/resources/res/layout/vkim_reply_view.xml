<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/line"
        android:layout_width="@dimen/nested_line_width"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        app:vk_layout_isAdjust="true"/>
    <com.vk.im.ui.views.StencilLayout
        android:id="@+id/icon_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/reply_preview_start_margin">
        <com.vk.im.ui.views.RestrictionFrescoImageViewLegacy
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            app:vk_layout_isAdjust="true"
            app:vkim_scaleType="center_crop"/>
    </com.vk.im.ui.views.StencilLayout>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/reply_title_start_margin">
        <com.vk.superapp.ui.FixTextView
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <com.vk.superapp.ui.FixTextView
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
</merge>
