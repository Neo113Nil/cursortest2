<?xml version="1.0" encoding="utf-8"?>
<com.vk.superapp.ui.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">
        <View
            android:id="@+id/personal_discount_avatar_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_round_v3"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            app:layout_constraintBottom_toTopOf="@+id/personal_discount_title_skeleton_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/personal_discount_title_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_32"
            android:layout_width="200dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@+id/personal_discount_subtitle_skeleton_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/personal_discount_avatar_skeleton_view"/>
        <View
            android:id="@+id/personal_discount_subtitle_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_32"
            android:layout_width="120dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@+id/personal_discount_banner_skeleton_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/personal_discount_title_skeleton_view"/>
        <View
            android:id="@+id/personal_discount_banner_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_8dp"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/personal_discount_subtitle_skeleton_view"/>
        <View
            android:id="@+id/personal_discount_time_title_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_32"
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/personal_discount_banner_skeleton_view"/>
        <View
            android:id="@+id/personal_discount_time_block1_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_8dp"
            android:layout_width="40dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toStartOf="@+id/personal_discount_time_block2_skeleton_view"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/personal_discount_time_title_skeleton_view"/>
        <View
            android:id="@+id/personal_discount_time_block2_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_8dp"
            android:layout_width="40dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toStartOf="@+id/personal_discount_time_divider_view"
            app:layout_constraintStart_toEndOf="@+id/personal_discount_time_block1_skeleton_view"
            app:layout_constraintTop_toTopOf="@+id/personal_discount_time_block1_skeleton_view"/>
        <TextView
            android:textColor="?attr/vk_ui_skeleton_from"
            android:gravity="center"
            android:id="@+id/personal_discount_time_divider_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_apps_time_divider"
            android:layout_marginHorizontal="10dp"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/personal_discount_time_block2_skeleton_view"
            app:layout_constraintEnd_toStartOf="@+id/personal_discount_time_block3_skeleton_view"
            app:layout_constraintStart_toEndOf="@+id/personal_discount_time_block2_skeleton_view"
            app:layout_constraintTop_toTopOf="@+id/personal_discount_time_block2_skeleton_view"
            style="@style/VkUiTypography.DisplayTitle1"/>
        <View
            android:id="@+id/personal_discount_time_block3_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_8dp"
            android:layout_width="40dp"
            android:layout_height="56dp"
            app:layout_constraintEnd_toStartOf="@+id/personal_discount_time_block4_skeleton_view"
            app:layout_constraintStart_toEndOf="@+id/personal_discount_time_divider_view"
            app:layout_constraintTop_toTopOf="@+id/personal_discount_time_block1_skeleton_view"/>
        <View
            android:id="@+id/personal_discount_time_block4_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_8dp"
            android:layout_width="40dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/personal_discount_time_block3_skeleton_view"
            app:layout_constraintTop_toTopOf="@+id/personal_discount_time_block1_skeleton_view"/>
        <View
            android:id="@+id/personal_discount_positive_button_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_10dp"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="54dp"
            app:layout_constraintBottom_toTopOf="@+id/personal_discount_negative_button_skeleton_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/personal_discount_time_block1_skeleton_view"/>
        <View
            android:id="@+id/personal_discount_negative_button_skeleton_view"
            android:background="@drawable/vk_bg_skeleton_10dp"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="80dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/personal_discount_positive_button_skeleton_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
