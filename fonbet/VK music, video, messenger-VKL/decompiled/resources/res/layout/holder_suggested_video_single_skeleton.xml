<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/holder_suggested_single_shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="?attr/vk_ui_background_secondary"
                android:layout_width="match_parent"
                android:layout_height="208dp"/>
            <View
                android:background="@drawable/bg_rounded_4"
                android:layout_width="150dp"
                android:layout_height="15sp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"/>
            <View
                android:background="@drawable/bg_rounded_4"
                android:layout_width="100dp"
                android:layout_height="15sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
    <View
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <View
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="175dp"/>
    <View
        android:layout_gravity="start"
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="0.5dp"
        android:layout_height="175dp"/>
    <View
        android:layout_gravity="end"
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="0.5dp"
        android:layout_height="175dp"/>
    <View
        android:layout_gravity="right"
        android:background="@drawable/bg_rounded_4"
        android:layout_width="54dp"
        android:layout_height="12dp"
        android:layout_marginTop="185dp"
        android:layout_marginEnd="8dp"/>
</FrameLayout>
