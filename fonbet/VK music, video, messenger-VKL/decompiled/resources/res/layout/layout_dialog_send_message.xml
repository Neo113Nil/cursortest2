<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_black_alpha60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/click_handler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/reactions_root"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="52dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.vk.core.view.components.text.VkText
                android:textColor="@color/vk_white"
                android:gravity="center_horizontal"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/story_send_reaction_to_im"
                android:singleLine="true"
                app:layout_constraintBottom_toTopOf="@+id/rv_stickers"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="?attr/vk_ui_typography_footnote_medium"/>
            <me.grishka.appkit.views.UsableRecyclerView
                android:id="@+id/rv_stickers"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/bottom_sheet_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <View
            android:id="@+id/bottom_sheet_gradient_view"
            android:background="@drawable/bg_story_bottom_sheet_gradient"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <com.vk.core.view.components.formitem.VkInputSelect
            android:textColor="?attr/vk_ui_text_primary"
            android:textColorHint="?attr/vk_ui_text_subhead"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/et_send_message"
            android:background="@drawable/bg_story_action_rounded_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:hint="@string/stories_replies_reply"
            android:maxLines="5"
            android:ems="10"
            android:inputType="textMultiLine"
            android:paddingStart="12dp"
            android:paddingEnd="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="106dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_send"
            app:layout_constraintEnd_toEndOf="@+id/stickers_keyboard"
            app:layout_constraintStart_toStartOf="parent"
            style="?attr/vk_ui_typography_paragraph_normal"/>
        <ImageView
            android:id="@+id/stickers_keyboard"
            android:background="@drawable/white_ripple_unbounded"
            android:padding="4dp"
            android:visibility="visible"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="2dp"
            android:scaleType="center"
            android:contentDescription="@string/story_stickers_title"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_send"
            app:layout_constraintEnd_toStartOf="@+id/iv_send"
            app:layout_constraintTop_toTopOf="@+id/iv_send"
            app:srcCompat="@drawable/vk_icon_smile_outline_28"
            app:tint="@color/vk_white"/>
        <ImageView
            android:id="@+id/iv_send"
            android:background="@drawable/bg_story_message_send_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginBottom="15dp"
            android:scaleType="center"
            android:contentDescription="@string/story_accessibility_send_message"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/vk_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/vk_icon_send_24"
            app:tint="@color/vk_gray_900"/>
        <ImageView
            android:id="@+id/dialog_send_message_voice_button"
            android:background="@drawable/bg_story_message_voice_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginBottom="15dp"
            android:scaleType="center"
            android:contentDescription="@string/story_accessibility_voice_msg"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/vk_icon_voice_24"
            app:tint="@color/vk_gray_900"/>
        <FrameLayout
            android:id="@+id/audio_msg_recorder_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
