<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/friend_req_btns_wrap"
    android:paddingTop="7.5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.divider.VkDivider
        android:id="@+id/post_divider"
        android:layout_width="wrap_content"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/post_side_padding"
        android:layout_marginRight="@dimen/post_side_padding"/>
    <com.vk.core.view.components.cell.button.group.VkCellButtonGroupLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.cell.button.group.VkGroupItem
            android:id="@+id/friend_req_btn_add"
            android:background="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.cell.button.group.VkGroupItem
            android:id="@+id/friend_req_btn_decline"
            android:background="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.vk.core.view.components.cell.button.group.VkCellButtonGroupLayout>
    <com.vk.core.view.components.divider.VkDivider
        android:id="@+id/bottom_divider"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/post_side_padding"
        android:layout_marginRight="@dimen/post_side_padding"/>
</LinearLayout>
