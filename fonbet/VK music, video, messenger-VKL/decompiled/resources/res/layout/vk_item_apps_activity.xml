<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/vk_highlight_radius_16"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/icon"
        android:layout_width="84dp"
        android:layout_height="74dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2Normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption2Medium"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/counter"
        android:background="@drawable/vk_superapp_counter_bg"
        android:paddingLeft="@dimen/vk_bottom_navigation_counter_padding"
        android:paddingRight="@dimen/vk_bottom_navigation_counter_padding"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vk_bottom_navigation_counter_height_outer"
        android:layout_marginTop="4dp"
        android:minWidth="@dimen/vk_bottom_navigation_counter_height_outer"
        android:minHeight="@dimen/vk_bottom_navigation_counter_height_outer"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
