<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mask_info_container"
        android:background="@drawable/bg_mask_info_title"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:foreground="?attr/selectableItemBackground">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/mask_info_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="6dp"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/mask_info_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/mask_info_chevron"
            app:layout_constraintStart_toEndOf="@+id/mask_info_avatar"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Headline1"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/mask_info_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lines="1"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/mask_info_chevron"
            app:layout_constraintStart_toStartOf="@+id/mask_info_title"
            app:layout_constraintTop_toBottomOf="@+id/mask_info_title"
            style="@style/VkUiTypography.Footnote"/>
        <ImageView
            android:id="@+id/mask_info_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_chevron_16"
            android:importantForAccessibility="no"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_ui_icon_tertiary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mask_info_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
