<?xml version="1.0" encoding="utf-8"?>
<com.vk.superapp.ui.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/shape_bg_skeleton_40"
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:contentDescription="@null"/>
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/shape_bg_skeleton_8"
            android:layout_width="200dp"
            android:layout_height="26dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/edit"
            android:background="@drawable/shape_bg_skeleton_8"
            android:layout_width="128dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"/>
        <View
            android:background="?attr/vk_legacy_separator_common"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
