<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/deactivated_container"
    android:background="?attr/vk_legacy_background_content"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.fresco.VKEnhancedImageView
        android:id="@+id/im_channel_deactivated_img"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:isCircle="true"
        app:placeholder="@drawable/vk_icon_avatar_placeholder_sad_persik_alt_150"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.Title2Medium"
        android:textColor="?attr/vk_legacy_text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/im_channel_deactivated_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vkim_channels_deactivated_title"/>
    <com.vk.core.view.links.LinkedTextView
        android:textAppearance="@style/VkUiTypography.ParagraphNormal"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:gravity="center_horizontal"
        android:id="@+id/im_channel_deactivated_subtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</LinearLayout>
