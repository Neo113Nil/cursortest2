<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.catalog2.common.ui.mvp.holder.video.showcase.VideoAutoPlayHolderView
        android:id="@+id/video_wrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:controls="all"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showProgressBar="true"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_wrap"
        style="@style/VkUiTypography.SubheadMedium"/>
    <ImageView
        android:id="@+id/menu"
        android:background="@drawable/highlight_circle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/common_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_wrap"
        app:srcCompat="@drawable/vk_icon_more_horizontal_16"
        app:tint="?attr/vk_ui_icon_primary"/>
    <TextView
        android:id="@+id/titleMeasureView"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:lines="2"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/subtitleMeasureView"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_wrap"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.libvideo.design.view.info.VideoInfoTextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:lines="2"
        app:isCustomEllipsizeEnabled="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.libvideo.design.view.info.VideoInfoTextView
        android:id="@+id/subtitleMeasureView"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2sp"
        app:isCustomEllipsizeEnabled="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleMeasureView"
        style="@style/VkUiTypography.Footnote"/>
</androidx.constraintlayout.widget.ConstraintLayout>
