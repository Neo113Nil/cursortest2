<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/appkit_loader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vkontakte.android.ui.layout.ExpandableBarLayout
        android:id="@+id/expandable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar">
        <FrameLayout
            android:id="@+id/appkit_loader_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/loading"
                layout="@layout/appkit_loading"/>
            <include
                android:id="@+id/error"
                android:visibility="gone"
                layout="@layout/vk_error_screen"/>
            <View
                android:id="@+id/content_stub"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <com.vkontakte.android.ui.widget.ForegroundRelativeLayout
            android:id="@+id/search_bar"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:foreground="@drawable/highlight">
            <TextView
                android:textAppearance="@style/VkUiTypography.Text.Unscaled"
                android:textColor="?attr/vk_ui_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/extended_search_padding"
                android:text="@string/search_params"
                android:layout_toLeftOf="@+id/search_icon"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/extended_search_padding"
                android:src="@drawable/vk_icon_deprecated_ic_search_params_expand"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:tint="?attr/vk_ui_text_secondary"/>
        </com.vkontakte.android.ui.widget.ForegroundRelativeLayout>
        <FrameLayout
            android:background="@color/vk_white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/video_search_ext_params"/>
        </FrameLayout>
    </com.vkontakte.android.ui.layout.ExpandableBarLayout>
</RelativeLayout>
