<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/text_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/hint_tab_bar_container"
        android:background="@drawable/hint_tab_bar_background"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="204dp"
        android:layout_height="74dp"
        android:importantForAccessibility="no"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/title"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        android:textAlignment="gravity"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/hint_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/switch_button"
            android:background="@drawable/button_alpha_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="30dp"
            android:maxLines="1"
            android:textAlignment="gravity"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="4dp"
            app:vk_layout_isFluid="true"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="@color/vk_azure_300"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/ok_button"
            android:background="@drawable/button_gray_40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="30dp"
            android:maxLines="1"
            android:textAlignment="gravity"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="4dp"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
</merge>
