<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bottom_navigation_shadow"
        android:background="@drawable/bg_bottom_navigation_shadow"
        android:layout_width="match_parent"
        android:layout_height="6dp"/>
    <FrameLayout
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/vk_icon_filter"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerInside"
            android:contentDescription="@null"
            app:srcCompat="@drawable/vk_icon_filter_24"
            app:tint="?attr/vk_ui_icon_accent"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.SubheadMedium"
                android:textColor="?attr/vk_ui_text_muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalog_search_parameters"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/close"
            android:background="@drawable/highlight_unlimited"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/cancel"
            app:srcCompat="@drawable/vk_icon_cancel_24"
            app:tint="?attr/vk_ui_icon_secondary"/>
    </FrameLayout>
</merge>
