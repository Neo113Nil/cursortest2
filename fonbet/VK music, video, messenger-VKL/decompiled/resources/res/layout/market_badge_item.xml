<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:background="@drawable/highlight_unlimited"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_margin="4dp"
    android:layout_marginRight="8dp"
    android:contentDescription="@null">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_user_circle_outline_28"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_legacy_header_tint"/>
    <TextView
        android:textColor="?attr/vk_legacy_counter_prominent_text"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/text_badge"
        android:background="@drawable/market_badge_item_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="18dp"
        android:minHeight="18dp"
        android:maxLines="1"
        android:singleLine="true"
        android:paddingStart="5.5dp"
        android:paddingEnd="5.5dp"
        android:backgroundTint="?attr/vk_legacy_counter_prominent_background"
        style="@style/VkLegacyTypography.Caption2"/>
</FrameLayout>
