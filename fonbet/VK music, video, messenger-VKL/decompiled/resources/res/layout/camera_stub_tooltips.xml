<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clips_controls_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/camera_clips_buttons_flow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:constraint_referenced_ids="camera_clips_gesture_btn,         camera_clips_timer_btn,camera_clips_speed_btn,         camera_clips_music_btn,clips_duet_mic_btn,camera_clips_templates_btn,camera_drafts_addon"
        app:flow_verticalGap="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/camera_clips_gesture_btn"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:layout_marginTop="4dp"
        android:foreground="@drawable/white_ripple_circle"
        android:src="@drawable/vk_icon_gesture_outline_shadow_large_48"
        android:scaleType="center"
        android:contentDescription="@string/clips_gestures"/>
    <com.vk.core.view.components.progress.VkProgress
        android:id="@+id/camera_clips_gesture_progress"
        android:visibility="gone"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="2dp"
        android:layout_marginTop="-2dp"
        android:indeterminate="false"
        android:progressDrawable="@drawable/create_camera_clips_model_progress"
        app:layout_constraintEnd_toEndOf="@+id/camera_clips_gesture_btn"
        app:layout_constraintStart_toStartOf="@+id/camera_clips_gesture_btn"
        app:layout_constraintTop_toBottomOf="@+id/camera_clips_gesture_btn"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <View
        android:id="@+id/dynamic_lib_popup_anchor"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/camera_clips_gesture_progress"
        app:layout_constraintStart_toStartOf="@+id/camera_clips_gesture_progress"
        app:layout_constraintTop_toBottomOf="@+id/camera_clips_gesture_progress"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/camera_clips_timer_btn"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:layout_marginTop="4dp"
        android:foreground="@drawable/white_ripple_circle"
        android:src="@drawable/vk_icon_timer_outline_shadow_large_48"
        android:scaleType="center"
        android:contentDescription="@string/clips_timer_dialog_title"/>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/camera_clips_speed_btn"
        android:tag="1"
        android:visibility="gone"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:foreground="@drawable/white_ripple_circle">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/camera_clips_speed_btn_image"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/vk_icon_circle_outline_shadow_large_48"
            android:scaleType="center"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/camera_clips_speed_btn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@color/vk_black_alpha16"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            style="@style/VkUiTypography.Caption1Medium"/>
    </FrameLayout>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="horizontal"
        android:id="@+id/camera_clips_speed_flow"
        android:background="@drawable/clip_speedbar_bg"
        android:paddingLeft="2dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:paddingVertical="2dp"
        app:constraint_referenced_ids="camera_clips_speedbar_0_3_btn,camera_clips_speedbar_0_5_btn,         camera_clips_speedbar_1_btn,camera_clips_speedbar_2_btn,camera_clips_speedbar_3_btn,camera_clips_speedbar_close_btn"
        app:flow_horizontalGap="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/camera_clips_speed_btn"
        app:layout_constraintEnd_toEndOf="@+id/camera_clips_speed_btn"
        app:layout_constraintTop_toTopOf="@+id/camera_clips_speed_btn"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_black"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/camera_clips_speedbar_0_3_btn"
        android:tag="0.3"
        android:background="@drawable/btn_white_18dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:foreground="@drawable/white_ripple_circle"
        android:text="@string/clips_speed_0_3"
        android:shadowColor="@color/vk_black_alpha16"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="5"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/camera_clips_speedbar_0_5_btn"
        android:tag="0.5"
        android:background="@null"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:foreground="@drawable/white_ripple_circle"
        android:text="@string/clips_speed_0_5"
        android:shadowColor="@color/vk_black_alpha16"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="5"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_black"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/camera_clips_speedbar_1_btn"
        android:tag="1"
        android:background="@drawable/btn_white_18dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:foreground="@drawable/white_ripple_circle"
        android:text="@string/clips_speed_1"
        android:shadowColor="@color/vk_black_alpha16"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="5"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_black"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/camera_clips_speedbar_2_btn"
        android:tag="2"
        android:background="@drawable/btn_white_18dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:foreground="@drawable/white_ripple_circle"
        android:text="@string/clips_speed_2"
        android:shadowColor="@color/vk_black_alpha16"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="5"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_black"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/camera_clips_speedbar_3_btn"
        android:tag="3"
        android:background="@drawable/bg_white_rounded_16"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:foreground="@drawable/white_ripple_circle"
        android:text="@string/clips_speed_3"
        android:shadowColor="@color/vk_black_alpha16"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="5"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center_vertical"
        android:id="@+id/camera_clips_speedbar_close_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:foreground="@drawable/white_ripple_circle"
        android:src="@drawable/vk_icon_cancel_24"
        android:scaleType="center"
        android:contentDescription="@string/close"
        android:layout_marginEnd="4dp"
        app:tint="@color/vk_white"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/camera_clips_music_bg"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:foreground="@null"
        android:src="@drawable/bg_clip_control_item"
        android:scaleType="center"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/camera_clips_music_btn"
        app:layout_constraintEnd_toEndOf="@+id/camera_clips_music_btn"
        app:layout_constraintStart_toStartOf="@+id/camera_clips_music_btn"
        app:layout_constraintTop_toTopOf="@+id/camera_clips_music_btn"
        app:placeholderImage="@drawable/bg_clip_control_item"/>
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="end"
        android:id="@+id/camera_clips_music_btn"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:foreground="@drawable/white_ripple_circle"
        android:scaleType="center"
        android:contentDescription="@string/camera_button_music"
        app:placeholderImage="@drawable/vk_icon_music_outline_shadow_large_48"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/clips_duet_mic_btn"
        android:visibility="gone"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:foreground="@drawable/white_ripple_circle"
        android:src="@drawable/vk_icon_microphone_outline_shadow_large_48"
        android:scaleType="center"
        android:contentDescription="@string/mic"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center_vertical"
        android:id="@+id/camera_clips_templates_btn"
        android:layout_width="@dimen/camera_icon_size"
        android:layout_height="@dimen/camera_icon_size"
        android:layout_marginTop="4dp"
        android:foreground="@drawable/white_ripple_circle"
        android:src="@drawable/vk_icon_cards_2_outline_large_48"
        android:scaleType="center"
        android:contentDescription="@string/clips_templates_tip"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/camera_drafts_addon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.divider.VkDivider
            android:layout_gravity="center_horizontal"
            android:id="@+id/camera_clips_controls_divider"
            android:layout_width="32dp"
            android:layout_height="0.5dp"/>
        <FrameLayout
            android:id="@+id/camera_clips_drafts_btn"
            android:visibility="gone"
            android:layout_width="@dimen/camera_icon_size"
            android:layout_height="@dimen/camera_icon_size">
            <com.vk.core.view.components.picture.VkImageSimple
                android:layout_width="@dimen/camera_icon_size"
                android:layout_height="@dimen/camera_icon_size"
                android:foreground="@drawable/white_ripple_circle"
                android:src="@drawable/vk_icon_write_rectangle_stack_outline_shadow_large_48"
                android:scaleType="center"
                android:contentDescription="@string/clips_drafts_title"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/camera_clips_drafts_counter"
                android:background="@drawable/bottom_navigation_counter_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="8dp"
                android:minWidth="18dp"
                android:singleLine="true"
                android:layout_marginEnd="2dp"
                style="@style/VkUiTypography.Caption1Normal"/>
        </FrameLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/camera_clips_tooltips_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="camera_clips_controls_tip_settings,camera_clips_controls_tip_gesture,         camera_clips_controls_tip_timer,camera_clips_controls_tip_speed,         camera_clips_controls_tip_music,camera_clips_controls_tip_templates, camera_clips_controls_tip_drafts"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/tooltips_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="32dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/camera_clips_controls_tip_settings"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/camera_settings_margin"
        android:text="@string/clips_camera_settings_title"
        android:shadowColor="@color/vk_black_alpha12"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        app:layout_constraintEnd_toStartOf="@+id/tooltips_guideline"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:id="@+id/camera_clips_controls_tip_gesture"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/clips_gesture_tip_enable"
        android:shadowColor="@color/vk_black_alpha12"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        app:layout_constraintBottom_toBottomOf="@+id/camera_clips_gesture_btn"
        app:layout_constraintEnd_toStartOf="@+id/tooltips_guideline"
        app:layout_constraintTop_toTopOf="@+id/camera_clips_gesture_btn"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/camera_clips_controls_tip_timer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/clips_timer_tip"
        android:shadowColor="@color/vk_black_alpha12"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        app:layout_constraintBottom_toBottomOf="@+id/camera_clips_timer_btn"
        app:layout_constraintEnd_toStartOf="@+id/tooltips_guideline"
        app:layout_constraintTop_toTopOf="@+id/camera_clips_timer_btn"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/camera_clips_controls_tip_speed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/clips_speed_tip"
        android:shadowColor="@color/vk_black_alpha12"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        app:layout_constraintBottom_toBottomOf="@+id/camera_clips_speed_btn"
        app:layout_constraintEnd_toStartOf="@+id/tooltips_guideline"
        app:layout_constraintTop_toTopOf="@+id/camera_clips_speed_btn"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/camera_clips_controls_tip_music"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/clips_music_tip"
        android:shadowColor="@color/vk_black_alpha12"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        app:layout_constraintBottom_toBottomOf="@+id/camera_clips_music_btn"
        app:layout_constraintEnd_toStartOf="@+id/tooltips_guideline"
        app:layout_constraintTop_toTopOf="@+id/camera_clips_music_btn"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/camera_clips_controls_tip_templates"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/clips_templates_tip"
        android:shadowColor="@color/vk_black_alpha12"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        app:layout_constraintBottom_toBottomOf="@+id/camera_clips_templates_btn"
        app:layout_constraintEnd_toStartOf="@+id/tooltips_guideline"
        app:layout_constraintTop_toTopOf="@+id/camera_clips_templates_btn"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:id="@+id/camera_clips_controls_tip_drafts"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/clips_drafts_tip"
        android:shadowColor="@color/vk_black_alpha12"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        app:layout_constraintBottom_toBottomOf="@+id/camera_drafts_addon"
        app:layout_constraintEnd_toStartOf="@+id/tooltips_guideline"
        style="@style/VkUiTypography.FootnoteMedium"/>
</merge>
