<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Vk.Theme.VkApp.bright_light_generated"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/bg_cover_tap_to_play"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/vk_ui_spacing_size2_xl">
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center_vertical"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        app:srcCompat="@drawable/vk_icon_play_16"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tap_to_play_tooltip"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
        android:paddingVertical="@dimen/vk_ui_spacing_size_l"
        style="@style/VkUiTypography.Subhead"/>
</LinearLayout>
