<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/attach_appbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/VKAppBar">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:background="?attr/vk_ui_background_modal"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:collapseIcon="@drawable/ic_back_collapse"
                app:titleTextColor="?attr/vk_ui_text_muted"/>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tabs_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">
            <com.vk.tab.presentation.TabView
                android:gravity="center"
                android:id="@+id/video_filter_tab"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <com.vk.tab.presentation.TabView
                android:gravity="center"
                android:id="@+id/video_playlist_filter_tab"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <com.vk.core.view.components.paging.list.VkRecyclerPaginatedView
            android:id="@+id/attach_recycler_view"
            android:background="?attr/vk_ui_background_content"
            android:paddingBottom="20dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/attach_counter_view_wrapper"
        android:background="?attr/vk_ui_background_content"
        android:paddingTop="@dimen/picker_attach_btn_top_bot_space"
        android:paddingBottom="@dimen/picker_attach_btn_top_bot_space"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/picker_attach_btn_height"
        android:paddingStart="@dimen/picker_attach_btn_left_right_space"
        android:paddingEnd="@dimen/picker_attach_btn_left_right_space">
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="bottom"
            android:id="@+id/attach_counter_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </FrameLayout>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        android:visibility="gone"
        style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
