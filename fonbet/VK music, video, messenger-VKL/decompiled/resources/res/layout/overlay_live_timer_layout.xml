<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:gravity="center_horizontal"
        android:id="@+id/days_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        app:layout_constraintEnd_toStartOf="@+id/days_hours_separator"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1Bold"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:id="@+id/days_hours_separator"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/live_time_separator"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/days_left"
        app:layout_constraintEnd_toStartOf="@+id/hours_left"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/days_left"
        app:layout_constraintTop_toTopOf="@+id/days_left"
        app:layout_constraintVertical_bias="0.5"
        style="@style/VkUiTypography.DisplayTitle2Bold"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:gravity="center_horizontal"
        android:id="@+id/hours_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        app:layout_constraintEnd_toStartOf="@+id/hours_minutes_separator"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/days_hours_separator"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:id="@+id/hours_minutes_separator"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/live_time_separator"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/hours_left"
        app:layout_constraintEnd_toStartOf="@+id/minutes_left"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/hours_left"
        app:layout_constraintTop_toTopOf="@+id/hours_left"
        app:layout_constraintVertical_bias="0.5"
        style="@style/VkUiTypography.DisplayTitle2Bold"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:gravity="center_horizontal"
        android:id="@+id/minutes_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        app:layout_constraintEnd_toStartOf="@+id/minutes_seconds_separator"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/hours_minutes_separator"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1Bold"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:id="@+id/minutes_seconds_separator"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/live_time_separator"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/minutes_left"
        app:layout_constraintEnd_toStartOf="@+id/seconds_left"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/minutes_left"
        app:layout_constraintTop_toTopOf="@+id/minutes_left"
        app:layout_constraintVertical_bias="0.5"
        style="@style/VkUiTypography.DisplayTitle2Bold"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:gravity="center_horizontal"
        android:id="@+id/seconds_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/minutes_seconds_separator"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1Bold"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:id="@+id/days_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/live_days_unit"
        app:layout_constraintEnd_toEndOf="@+id/days_left"
        app:layout_constraintStart_toStartOf="@+id/days_left"
        app:layout_constraintTop_toBottomOf="@+id/days_left"
        style="@style/VkUiTypography.Caption2Normal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:id="@+id/hours_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/live_hours_unit"
        app:layout_constraintEnd_toEndOf="@+id/hours_left"
        app:layout_constraintStart_toStartOf="@+id/hours_left"
        app:layout_constraintTop_toBottomOf="@+id/hours_left"
        style="@style/VkUiTypography.Caption2Normal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:id="@+id/minutes_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/live_minutes_unit"
        app:layout_constraintEnd_toEndOf="@+id/minutes_left"
        app:layout_constraintStart_toStartOf="@+id/minutes_left"
        app:layout_constraintTop_toBottomOf="@+id/minutes_left"
        style="@style/VkUiTypography.Caption2Normal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:id="@+id/seconds_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/live_seconds_unit"
        app:layout_constraintEnd_toEndOf="@+id/seconds_left"
        app:layout_constraintStart_toStartOf="@+id/seconds_left"
        app:layout_constraintTop_toBottomOf="@+id/seconds_left"
        style="@style/VkUiTypography.Caption2Normal"/>
</merge>
