<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayoutWithFixedTouches xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/minimizableMotionLayout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:translationZ="1dp"
    app:currentState="@+id/hidden">
    <View
        android:id="@+id/mainFragmentContainerShadow"
        android:background="@color/vk_black_alpha20"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/relatedVideoItemsBackground"
        android:background="@color/vk_gray_1000"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/frameRelatedVideoItemsRecyclerView"
        app:layout_constraintTop_toTopOf="@+id/frameRelatedVideoItemsRecyclerView"/>
    <include
        android:id="@+id/contentContainer"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playerContainer"
        layout="@layout/video_content_container"/>
    <View
        android:id="@+id/tabletRecommendationsBackground"
        android:background="@color/vk_gray_1000"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="@+id/tabletRecommendationsContainer"
        app:layout_constraintStart_toStartOf="@+id/tabletRecommendationsContainer"/>
    <include
        android:id="@+id/tabletRecommendationsContainer"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playerContainer"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/video_tablet_recommendations_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerContainer"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/touchable_seek_zone"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="@dimen/video_touchable_seek_bar_zone_height"
        app:layout_constraintEnd_toEndOf="@+id/playerContainer"
        app:layout_constraintStart_toStartOf="@+id/playerContainer"
        app:layout_constraintTop_toBottomOf="@+id/playerContainer"/>
    <View
        android:id="@+id/playerShadow"
        android:background="@color/vk_black_alpha75"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/playerContainer"
        app:layout_constraintEnd_toEndOf="@+id/playerContainer"
        app:layout_constraintStart_toStartOf="@+id/playerContainer"
        app:layout_constraintTop_toTopOf="@+id/playerContainer"/>
    <FrameLayout
        android:id="@+id/rightPromoContainer"
        android:background="@color/vk_black"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="1"
        app:layout_constraintTop_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/bottomPromoContainer"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/playerContainer"
        app:layout_constraintStart_toStartOf="@+id/playerContainer"/>
    <View
        android:id="@+id/cover_overlay_view"
        android:background="@color/vk_black_alpha45"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="@+id/playerContainer"
        app:layout_constraintEnd_toEndOf="@+id/playerContainer"
        app:layout_constraintStart_toStartOf="@+id/playerContainer"
        app:layout_constraintTop_toTopOf="@+id/playerContainer"/>
    <com.vk.lists.RecyclerPaginatedView
        android:id="@+id/about_video_fullscreen_recycler"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/playerContainer"
        app:layout_constraintTop_toTopOf="@+id/playerContainer"/>
    <include
        android:id="@+id/similar_slider_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="6dp"
        app:layout_constraintBottom_toTopOf="@+id/similar_slider"
        app:layout_constraintEnd_toEndOf="@+id/playerContainer"
        app:layout_constraintStart_toStartOf="@+id/playerContainer"
        layout="@layout/video_similar_slider_header_container"/>
    <include
        android:id="@+id/similar_slider"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/playerContainer"
        app:layout_constraintStart_toStartOf="@+id/playerContainer"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintVertical_bias="1"
        layout="@layout/video_similar_slider_content_container"/>
    <FrameLayout
        android:id="@+id/dialogContainer"
        android:background="@color/vk_black"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="1"
        app:layout_constraintTop_toBottomOf="parent"/>
</androidx.constraintlayout.motion.widget.MotionLayoutWithFixedTouches>
