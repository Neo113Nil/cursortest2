<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="2.5dp"
    android:paddingEnd="2.5dp">
    <RelativeLayout
        android:layout_width="38dp"
        android:layout_height="38dp">
        <ImageView
            android:id="@+id/ivBorderOutsideSelected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_collage_color_border_outside_selected"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp">
            <FrameLayout
                android:id="@+id/colorRoundedWrapper"
                android:background="@drawable/bg_rounded_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/color"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/ivBorderInsideSelectedWhite"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_collage_color_border_inside_selected_white"/>
            <ImageView
                android:id="@+id/ivBorderInsideSelectedBlack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_collage_color_border_inside_selected_black"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/ivBorderOutside"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_collage_color_border_outside"/>
    </RelativeLayout>
</LinearLayout>
