<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_slide_up_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/accessibility_back"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/toolbar"
            app:srcCompat="@drawable/vk_icon_back_24"
            app:tint="?attr/vk_ui_text_primary"/>
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toEndOf="@+id/back"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@string/voip_call_menu_actions_participant_permissions"
            app:titleTextAppearance="@style/ToolbarTitle"
            app:titleTextColor="?attr/vk_ui_text_primary"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/link_view_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/share_link_pager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <View
                android:id="@+id/copy_link_background"
                android:background="@drawable/bg_gray_800_corner10"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="-12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/update_link_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/call_link_area_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/voip_call_link"
                android:importantForAccessibility="no"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="@+id/copy_link_background"
                app:layout_constraintStart_toStartOf="@+id/copy_link_background"
                app:layout_constraintTop_toBottomOf="@+id/toolbar"
                style="@style/VkUiTypography.Headline1Normal"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/update_link_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/voip_call_permissions_update_call_link_hint"
                android:maxLines="2"
                android:lines="2"
                android:importantForAccessibility="no"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="@+id/copy_link_background"
                app:layout_constraintStart_toStartOf="@+id/copy_link_background"
                app:layout_constraintTop_toBottomOf="@+id/call_link_area_title"
                style="@style/VkUiTypography.Footnote"/>
            <FrameLayout
                android:id="@+id/copy_link_container"
                android:background="@drawable/bg_gray_700_corner10"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:clipToOutline="true"
                app:layout_constraintEnd_toStartOf="@+id/update_link_container"
                app:layout_constraintStart_toStartOf="@+id/copy_link_background"
                app:layout_constraintTop_toBottomOf="@+id/update_link_description">
                <TextView
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center"
                    android:id="@+id/copy_link_view"
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/voip_call_permissions_copy_call_link"
                    android:importantForAccessibility="no"
                    style="@style/VkUiTypography.Paragraph"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/update_link_container"
                android:background="@drawable/bg_gray_700_stroke_corner10"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:clipToOutline="true"
                app:layout_constraintEnd_toEndOf="@+id/copy_link_background"
                app:layout_constraintStart_toEndOf="@+id/copy_link_container"
                app:layout_constraintTop_toTopOf="@+id/copy_link_container">
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/update_link_progress_view"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="?attr/vk_ui_icon_tertiary"
                    android:indeterminateTintMode="src_in"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center"
                    android:id="@+id/update_link_click_area_view"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/voip_call_permissions_update_call_link"
                    android:importantForAccessibility="no"
                    style="@style/VkUiTypography.Paragraph"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.vk.voip.ui.share.link.pager.view.VoipShareLinkPagerView
            android:id="@+id/share_link_pager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/link_view_container"/>
        <TextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:gravity="center"
            android:id="@+id/share_link_pager_refresh_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voip_scheduled_call_settings_link_refresh_subtitle"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp"
            app:layout_constraintTop_toBottomOf="@+id/share_link_pager"
            style="@style/VkUiTypography.Subhead"/>
        <View
            android:id="@+id/share_link_pager_divider"
            android:background="?attr/vk_ui_separator_primary"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/share_link_pager_refresh_description"/>
        <com.vk.voip.ui.view.VoipActionMultiLineView
            android:id="@+id/media_setting_microphones"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:minHeight="56dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/share_link_pager_divider"
            app:voip_amlv_openIconVisible="true"
            app:voip_amlv_subtitle_max_lines="2"
            app:voip_amlv_title="@string/voip_call_actions_media_microphones"
            app:voip_amlv_title_lines="1"
            style="@style/VoipActionMultiLineView"/>
        <com.vk.voip.ui.view.VoipActionMultiLineView
            android:id="@+id/media_setting_video"
            android:visibility="gone"
            android:minHeight="56dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/media_setting_microphones"
            app:voip_amlv_openIconVisible="true"
            app:voip_amlv_subtitle_max_lines="2"
            app:voip_amlv_title="@string/voip_call_actions_media_cameras"
            app:voip_amlv_title_lines="1"
            style="@style/VoipActionMultiLineView"/>
        <com.vk.voip.ui.view.VoipActionMultiLineView
            android:id="@+id/voip_toggle_screensharing"
            android:layout_width="0dp"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:minHeight="40dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/media_setting_video"
            app:voip_amlv_subtitle_max_lines="2"
            app:voip_amlv_switchVisible="true"
            app:voip_amlv_title="@string/voip_call_by_link_setting_share_screen"
            app:voip_amlv_title_lines="1"
            style="@style/VoipActionMultiLineView"/>
        <com.vk.voip.ui.view.VoipActionMultiLineView
            android:id="@+id/voip_toggle_record"
            android:layout_width="0dp"
            android:minHeight="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voip_toggle_screensharing"
            app:voip_amlv_switchVisible="true"
            app:voip_amlv_title="@string/voip_call_by_link_setting_record"
            app:voip_amlv_title_lines="1"
            style="@style/VoipActionMultiLineView"/>
        <com.vk.voip.ui.view.VoipActionMultiLineView
            android:id="@+id/allow_feedback_switch_view"
            android:layout_width="0dp"
            android:checked="true"
            android:minHeight="40dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voip_toggle_record"
            app:voip_amlv_subtitle_max_lines="2"
            app:voip_amlv_title="@string/voip_call_by_link_setting_feedback_title"
            app:voip_amlv_title_lines="1"
            style="@style/VoipActionMultiLineView"/>
        <com.vk.voip.ui.view.VoipActionMultiLineView
            android:id="@+id/voip_toggle_watch_together"
            android:visibility="gone"
            android:layout_width="0dp"
            android:minHeight="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/allow_feedback_switch_view"
            app:voip_amlv_subtitle_max_lines="2"
            app:voip_amlv_switchVisible="true"
            app:voip_amlv_title="@string/voip_call_by_link_setting_watch_together_title"
            style="@style/VoipActionMultiLineView"/>
        <View
            android:id="@+id/options_divider"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/voip_toggle_watch_together"
            style="@style/LinkSettingsDivider"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/options_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/voip_call_permissions_update_options_hint"
            android:importantForAccessibility="no"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/options_divider"
            style="@style/VkUiTypography.Footnote"/>
        <com.vk.voip.ui.view.VoipActionMultiLineView
            android:id="@+id/is_service_chat_switch_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/options_description"
            app:voip_amlv_subtitle="@string/void_service_chat_setting_subtitle"
            app:voip_amlv_subtitle_max_lines="2"
            app:voip_amlv_title="@string/void_service_chat_setting_title"
            app:voip_amlv_title_max_lines="1"
            style="@style/VoipActionMultiLineView"/>
        <com.vk.voip.ui.view.VoipActionMultiLineView
            android:id="@+id/waiting_room_switch_view"
            android:layout_width="0dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/is_service_chat_switch_view"
            app:voip_amlv_subtitle="@string/voip_call_permissions_waiting_room_description"
            app:voip_amlv_subtitle_max_lines="2"
            app:voip_amlv_title="@string/voip_call_permissions_waiting_room"
            app:voip_amlv_title_lines="1"
            style="@style/VoipActionMultiLineView"/>
        <com.vk.voip.ui.view.VoipActionMultiLineView
            android:id="@+id/allow_join_anonymously_switch_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/waiting_room_switch_view"
            app:voip_amlv_subtitle="@string/voip_call_permissions_anonymous_join_description"
            app:voip_amlv_subtitle_max_lines="2"
            app:voip_amlv_title="@string/voip_call_permissions_anonymous_join"
            app:voip_amlv_title_lines="1"
            style="@style/VoipActionMultiLineView"/>
        <com.vk.voip.ui.view.VoipActionSingleLineView
            android:id="@+id/allow_show_chat_history_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/allow_join_anonymously_switch_view"
            app:voip_aslv_openIconVisible="false"
            app:voip_aslv_switchVisible="true"
            app:voip_aslv_title="@string/voip_call_by_link_settings_chat_history"
            app:voip_aslv_title_lines="2"
            style="@style/VoipActionSingleLineView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
