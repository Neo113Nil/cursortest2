<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/voip_admin_change_name_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/voip_admin_change_name_toolbar"/>
    <com.vk.core.view.components.formitem.VkFormField
        android:id="@+id/voip_form_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="@dimen/vk_ui_base_padding_horizontal"
        app:activeInputIcon="@drawable/vk_icon_clear_16"
        app:label="@string/voip_change_name_block_title"
        app:layout_constraintBottom_toTopOf="@+id/voip_admin_change_name_apply_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_admin_change_name_toolbar">
        <com.vk.core.view.components.formitem.VkInputSelect
            android:id="@+id/voip_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/join_to_call_by_link_name"
            android:maxLength="50"
            app:inputSize="singleLine"
            style="@style/VkInput"/>
    </com.vk.core.view.components.formitem.VkFormField>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/voip_admin_change_name_apply_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/voip_change_name"
        android:stateListAnimator="@null"
        android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/voip_admin_change_name_over_content_progress_bar"
        android:visibility="visible"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:translationZ="1dp"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"
        app:layout_constraintBottom_toTopOf="@+id/voip_admin_change_name_apply_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
