<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/user_photo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/user_placeholder"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Paragraph"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/user_city"
        app:layout_constraintEnd_toStartOf="@+id/btn_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/user_photo"
        app:layout_constraintTop_toTopOf="@+id/user_photo"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/user_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/user_photo"
        app:layout_constraintEnd_toStartOf="@+id/btn_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/user_name"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
    <FrameLayout
        android:id="@+id/btn_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.button.VkSimpleButton
            android:gravity="center"
            android:id="@+id/user_add"
            android:layout_width="98dp"
            android:layout_height="30dp"
            android:text="@string/social_graph_user_add"
            android:contentDescription="@string/accessibility_social_graph_send_friend_request"
            android:layout_marginStart="8dp"
            android:stateListAnimator="@null"
            android:lineHeight="18sp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="small"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:gravity="center"
            android:id="@+id/user_add_cancel"
            android:visibility="visible"
            android:layout_width="98dp"
            android:layout_height="30dp"
            android:text="@string/social_graph_user_add_cancel"
            android:contentDescription="@string/social_graph_user_add_cancel"
            android:layout_marginStart="8dp"
            android:stateListAnimator="@null"
            android:lineHeight="18sp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="small"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
