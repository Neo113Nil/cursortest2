<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_container"
    android:paddingTop="2dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/catalog_video_header_height"
    android:paddingStart="@dimen/catalog_video_header_padding"
    android:paddingEnd="@dimen/catalog_video_header_padding"
    app:layout_scrollFlags="snap|enterAlways|scroll">
    <ImageView
        android:id="@+id/navigation_icon"
        android:visibility="gone"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_arrow_left_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/user_photo"
        android:padding="3dp"
        android:visibility="gone"
        android:layout_width="@dimen/video_catalog_header_user_photo_size"
        android:layout_height="@dimen/video_catalog_header_user_photo_size"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/accessibility_navigation_drawer"
        android:layout_marginStart="7dp"
        app:actualImageScaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/navigation_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_separator_primary_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/video_catalog_header_new"
        android:textDirection="locale"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cast_button"
        app:layout_constraintStart_toEndOf="@+id/user_photo"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle2"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/cast_button"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_screencast_outline_28"
        android:scaleType="centerInside"
        android:contentDescription="@string/video_start_video_cast"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/first_button"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/first_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/search_button"
        app:layout_constraintStart_toEndOf="@+id/cast_button"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/add_button"
            android:background="@drawable/highlight_unbounded"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/add"
            app:srcCompat="@drawable/vk_icon_add_outline_28"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <include
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/catalog_vk_video_notifications_container"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/search_button"
        android:background="@drawable/highlight_unbounded"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/settings_button"
        app:layout_constraintStart_toEndOf="@+id/add_button"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_search_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <ImageView
        android:id="@+id/settings_button"
        android:background="@drawable/highlight_unbounded"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_settings_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
</androidx.constraintlayout.widget.ConstraintLayout>
