<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.msg.MsgPartIconTwoRowView
        android:id="@+id/expired_story_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/time_and_status"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vkim_icon="@drawable/ic_story"
        app:vkim_iconTint="@null"
        style="@style/VkIm.MsgPart.IconTwoRow.Default"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/available_story_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ic_one_time, available_story_title, available_story_btn"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ic_one_time"
        android:background="@drawable/bg_nested_story_new"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="8dp"
        android:scaleType="centerInside"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_bomb_outline_28"
        app:tint="@color/vk_white"/>
    <TextView
        android:textSize="14dp"
        android:textColor="?attr/vk_legacy_text_muted"
        android:ellipsize="end"
        android:id="@+id/available_story_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/story"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@string/font_family_medium"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/available_story_btn"
        app:layout_constraintStart_toEndOf="@+id/ic_one_time"
        app:layout_constraintTop_toTopOf="@+id/ic_one_time"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.core.view.TintTextView
        android:id="@+id/available_story_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/open"
        android:fontFamily="@string/font_family_medium"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/available_story_title"
        app:layout_constraintTop_toBottomOf="@+id/available_story_title"
        style="@style/outline_button"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:id="@+id/time_and_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
