<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.AvatarView
        android:id="@+id/vkim_channel_title_avatar_description_item__avatar_view"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/vkim_accessibility_avatar_channel"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"
        style="@style/VkIm.AvatarView"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vkim_channel_profile_channel_settings_title_header"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/vkim_channel_title_avatar_description_item__avatar_view"/>
    <EditText
        android:textSize="15sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:textColorHint="?attr/vk_legacy_text_placeholder"
        android:id="@+id/vkim_channel_settings_item__title_edittext"
        android:background="@drawable/bg_settings_edittext_normal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:fadingEdgeLength="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:hint="@string/vkim_channel_profile_channel_settings_title_hint"
        android:includeFontPadding="false"
        android:maxLength="48"
        android:layout_alignBottom="@+id/vkim_channel_title_avatar_description_item__avatar_view"
        android:inputType="textCapSentences"
        android:imeOptions="actionDone"
        android:requiresFadingEdge="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/vkim_channel_title_avatar_description_item__avatar_view"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:id="@+id/vkim_channel_title_avatar_description_item__description_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="8dp"
        android:text="@string/vkim_channel_profile_channel_settings_description_header"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_below="@+id/vkim_channel_title_avatar_description_item__avatar_view"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <EditText
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:textColorHint="?attr/vk_legacy_text_placeholder"
        android:gravity="top"
        android:id="@+id/vkim_channel_settings_item__description_edittext"
        android:background="@drawable/bg_settings_edittext_normal"
        android:fadingEdge="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text=""
        android:hint="@string/vkim_channel_profile_channel_settings_description_hint"
        android:maxLines="5"
        android:minLines="2"
        android:singleLine="false"
        android:includeFontPadding="false"
        android:maxLength="3999"
        android:layout_below="@+id/vkim_channel_title_avatar_description_item__description_hint"
        android:lineSpacingExtra="1sp"
        android:inputType="textMultiLine"
        android:imeOptions="actionDone"
        android:requiresFadingEdge="vertical"
        android:layout_marginHorizontal="16dp"
        style="@style/VKUIEditText"/>
    <com.vk.im.ui.views.settings.MaterialSwitchSettingsView
        android:id="@+id/messages_settings_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vkim_channel_settings_item__description_edittext"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="16dp"
        app:im_descriptionText="@string/vkim_channel_profile_channel_settings_messages_description"
        app:im_labelText="@string/vkim_channel_profile_channel_settings_messages_header"/>
</RelativeLayout>
