<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/user_vh"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="10dp"
    android:paddingEnd="12dp">
    <CheckBox
        android:id="@+id/vkim_checkbox"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:checked="true"
        android:text=""
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vkim_avatar"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CircleCheckBox"/>
    <com.vk.im.ui.views.avatars.ImAvatarView
        android:id="@+id/vkim_avatar"
        android:layout_width="@dimen/vkim_contact_avatar_container_size"
        android:layout_height="@dimen/vkim_contact_avatar_container_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/vkim_checkbox"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkIm.AvatarView"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="marquee"
        android:id="@+id/vkim_subtitle"
        android:paddingTop="1dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/new_contact_dot_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/vkim_avatar"
        app:layout_constraintTop_toBottomOf="@+id/vkim_username"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.HeadlineMedium"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="marquee"
        android:id="@+id/vkim_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/vkim_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/item_contact_edu_label"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/vkim_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/item_contact_edu_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_education_16"
        android:importantForAccessibility="no"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/vkim_username"
        app:layout_constraintEnd_toStartOf="@+id/new_contact_dot_view"
        app:layout_constraintStart_toEndOf="@+id/vkim_username"
        app:layout_constraintTop_toTopOf="@+id/vkim_username"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/new_contact_dot_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vkim_unread"
        android:scaleType="centerInside"
        android:tint="?attr/vk_ui_icon_accent_themed"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/call_audio"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/call_audio"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_phone_outline_28"
        android:scaleType="centerInside"
        android:tint="?attr/vk_ui_icon_accent_themed"
        android:contentDescription="@string/vkim_msg_header_menu_call_with_audio"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/call_video"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/call_video"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_videocam_outline_28"
        android:scaleType="centerInside"
        android:tint="?attr/vk_ui_icon_accent_themed"
        android:contentDescription="@string/vkim_msg_header_menu_call_with_video"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
