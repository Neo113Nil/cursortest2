<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_chat_profile_adapter_simple_item__icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/vkim_chat_profile_adapter_simple_item__title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vkim_chat_profile_adapter_simple_item__title"/>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Headline.Regular"
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_chat_profile_adapter_simple_item__title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vkim_chat_profile_adapter_simple_item_icon_right"
        app:layout_constraintStart_toEndOf="@+id/vkim_chat_profile_adapter_simple_item__icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/vkim_chat_profile_adapter_simple_item_hint_icon_right"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/vkim_chat_profile_adapter_simple_item__title"
        app:layout_constraintEnd_toEndOf="@+id/vkim_chat_profile_adapter_simple_item_icon_right"
        app:layout_constraintTop_toTopOf="@+id/vkim_chat_profile_adapter_simple_item__title"
        app:tint="?attr/vk_ui_accent_blue"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vkim_chat_profile_adapter_simple_item_icon_right"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/vkim_chat_profile_adapter_simple_item__title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vkim_chat_profile_adapter_simple_item__title"
        app:tint="?attr/vk_legacy_header_tint"/>
</androidx.constraintlayout.widget.ConstraintLayout>
