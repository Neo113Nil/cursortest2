<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp">
            <View
                android:layout_gravity="center"
                android:background="@drawable/vk_multiaccount_swipe_indicator"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_marginVertical="10dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
                    android:id="@+id/ecosystem_switcher_loading_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="vertical"
                        android:id="@+id/vk_multi_account_loading_switcher_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/vk_multi_account_switcher_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <android.widget.ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/vk_multi_account_progress_bar"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="?attr/vk_ui_icon_medium"
                    android:indeterminateTintMode="src_in"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/error_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:layout_gravity="center"
            android:id="@+id/error_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/vk_auth_loading_error"
            style="@style/VkUiTypography.Headline1Normal"/>
        <Button
            android:textColor="?attr/vk_ui_background_accent_themed"
            android:layout_gravity="center"
            android:id="@+id/retry_button"
            android:background="@drawable/vk_error_button_background"
            android:layout_width="102dp"
            android:layout_height="36dp"
            android:text="@string/vk_auth_retry"
            style="@style/VkLegacyTypography.Headline2"/>
    </LinearLayout>
</FrameLayout>
