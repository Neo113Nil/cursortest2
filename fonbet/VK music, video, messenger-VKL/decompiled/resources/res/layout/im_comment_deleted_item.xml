<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/im_deleted_comment_container"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingVertical="4dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/im_deleted_comment_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/vk_icon_avatar_placeholder_anonim_150"
        app:placeholderImageScaleType="centerCrop"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/im_deleted_comment_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vkim_channel_comments_comment_deleted"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/im_deleted_comment_restore"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/im_deleted_comment_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteMedium"
        android:textColor="?attr/vk_ui_text_link"
        android:id="@+id/im_deleted_comment_restore"
        android:background="@drawable/ripple_4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/vkim_channel_comments_restore_comment"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/im_deleted_comment_avatar"
        app:layout_constraintTop_toBottomOf="@+id/im_deleted_comment_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
