<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vk_app_bar"
    android:background="@drawable/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/VKAppBar">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/transparent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:collapseIcon="@null"
        app:contentInsetEnd="8dp"
        app:contentInsetEndWithActions="0dp"
        app:contentInsetStart="11dp"
        app:contentInsetStartWithNavigation="12dp"
        app:layout_scrollFlags="enterAlways"
        app:logo="@null"
        app:navigationContentDescription="@string/vkim_accessibility_toolbar_back_exit"
        app:navigationIcon="@null"
        app:subtitle="@null"
        app:title="@null"
        app:titleMarginStart="0dp"
        style="@style/VkIm.Toolbar.Style">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/owner_photo"
                android:visibility="gone"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/accessibility_navigation_drawer"
                app:actualImageScaleType="centerInside"
                app:layout_constraintEnd_toStartOf="@+id/title"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/user_placeholder"
                app:roundAsCircle="true"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/title_dropdown"
                app:layout_constraintStart_toEndOf="@+id/owner_photo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap"
                app:layout_goneMarginEnd="16dp"
                style="@style/VkUiTypography.DisplayTitle2"/>
            <ImageView
                android:id="@+id/title_dropdown"
                android:layout_width="20dp"
                android:layout_height="16dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:translationY="1.5dp"
                android:importantForAccessibility="no"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/title"
                app:layout_constraintTop_toTopOf="@+id/title"
                app:srcCompat="@drawable/vk_icon_dropdown_20"
                app:tint="?attr/vk_ui_icon_accent_themed"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>
</com.google.android.material.appbar.AppBarLayout>
