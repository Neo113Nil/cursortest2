<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <com.vk.voip.ui.avatars.VoipAvatarViewContainer
        android:id="@+id/voip_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAvatarSize="40dp"
        style="@style/VkIm.AvatarView"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/voip_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/let_in_btn"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/voip_avatar"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkRobotoRegularStyle.Text.Medium"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/let_in_btn"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/menu_btn"
        app:layout_constraintTop_toTopOf="parent"
        app:text="@string/voip_call_actions_let_in"/>
    <ImageView
        android:id="@+id/menu_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/voip_participant_menu"
        android:paddingStart="12dp"
        android:layout_marginEnd="18dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_accent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
