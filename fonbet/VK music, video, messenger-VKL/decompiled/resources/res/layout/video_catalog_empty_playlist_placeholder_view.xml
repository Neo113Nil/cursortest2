<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:minWidth="480dp"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/catalog_placeholder_view_image"
        android:layout_width="56dp"
        android:layout_height="56dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_placeholder_view_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/video_catalog_empty_playlist_title_top_margin"
        android:layout_marginBottom="@dimen/video_catalog_empty_playlist_title_bottom_margin"
        style="@style/VkUiTypography.Title2Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_placeholder_view_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_placeholder_view_hint_description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/primary_button"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/video_catalog_empty_playlist_button_top_margin"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/secondary_button"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/video_catalog_empty_playlist_button_top_margin"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"/>
</LinearLayout>
