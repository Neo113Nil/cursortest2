<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feed_coauthors_root"
    android:background="@drawable/bg_coowners_invite"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp">
    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/feed_coauthors_photos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutDescription="@xml/feed_post_coowners_invite_banner_scene"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.Barrier
            android:orientation="vertical"
            android:id="@+id/feed_coauthors_middle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/feed_coauthors_coauthor_photo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="2dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintStart_toEndOf="@+id/feed_coauthors_middle"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/user_placeholder"
            app:roundAsCircle="true"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="0.5dp"/>
        <View
            android:id="@+id/feed_coauthors_author_border"
            android:background="@drawable/white_oval"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:backgroundTint="?attr/vk_ui_background_secondary"
            app:layout_constraintBottom_toBottomOf="@+id/feed_coauthors_author_photo"
            app:layout_constraintEnd_toEndOf="@+id/feed_coauthors_author_photo"
            app:layout_constraintStart_toStartOf="@+id/feed_coauthors_author_photo"
            app:layout_constraintTop_toTopOf="@+id/feed_coauthors_author_photo"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/feed_coauthors_author_photo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="2dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintEnd_toStartOf="@+id/feed_coauthors_middle"
            app:layout_constraintTop_toTopOf="@+id/feed_coauthors_coauthor_photo"
            app:placeholderImage="@drawable/user_placeholder"
            app:roundAsCircle="true"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="0.5dp"/>
    </androidx.constraintlayout.motion.widget.MotionLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/feed_coowners_invite_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="false"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feed_coauthors_photos"
        style="@style/VkUiTypography.SubheadNormal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/feed_coowners_invite_accepted_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="false"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feed_coowners_invite_title"
        style="@style/VkUiTypography.SubheadNormal"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/feed_coowners_invite_accept_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/feed_coowners_invite_decline_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feed_coowners_invite_title"
        app:text="@string/coowners_invite_accept_button"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/feed_coowners_invite_decline_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:buttonAppearance="neutral"
        app:buttonMode="tertiary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/feed_coowners_invite_accept_button"
        app:layout_constraintTop_toTopOf="@+id/feed_coowners_invite_accept_button"
        app:text="@string/coowners_invite_decline_button"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/feed_coowners_invite_settings_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feed_coowners_invite_title"
        app:text="@string/coowners_invite_settings_button"/>
    <ImageView
        android:id="@+id/feed_coowners_invite_close_button"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        android:foreground="@drawable/ripple"
        android:contentDescription="@string/coowners_invite_close_button_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_outline_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
