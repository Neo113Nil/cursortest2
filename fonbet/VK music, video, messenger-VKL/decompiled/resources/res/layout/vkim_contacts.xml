<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/vkim_recycler_view"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <com.pnikosis.materialishprogress.ProgressWheel
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:matProg_barColor="?attr/vk_legacy_accent"
        app:matProg_progressIndeterminate="true"/>
    <com.vk.core.view.FastScroller
        android:layout_gravity="end"
        android:id="@+id/vkim_fast_scroller"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="16dp"
        app:fsHandle="@drawable/fastscroller_section_indicator"
        app:fsTrackColor="?attr/vk_legacy_separator_alpha"
        app:fsTrackWidth="1dp"/>
    <TextView
        android:textSize="48dp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/vkim_fast_scroll_preview"
        android:background="@drawable/fastscroller_popup"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:minWidth="72dp"
        android:layout_marginEnd="22dp"/>
</FrameLayout>
