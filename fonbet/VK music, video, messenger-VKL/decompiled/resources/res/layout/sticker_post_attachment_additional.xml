<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/post_sticker_attachment_additional_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/post_sticker_attachment_additional_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_attach_16"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/post_sticker_attachment_additional_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationY="-0.38sp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/post_sticker_attachment_additional_icon"
        app:layout_constraintStart_toEndOf="@+id/post_sticker_attachment_additional_icon"
        style="@style/VkUiTypography.Footnote"/>
</androidx.constraintlayout.widget.ConstraintLayout>
