<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="wrap_content">
        <com.vk.stories.design.view.poll.RoundedCornersView
            android:id="@+id/poll_preview_background"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            app:borderStrokeWidth="2dp"
            app:cornerRadius="6dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.stories.design.view.poll.RoundedCornersView
                android:id="@+id/poll_preview_title_line_1"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="22dp"
                app:cornerRadius="1.5dp"/>
            <com.vk.stories.design.view.poll.RoundedCornersView
                android:id="@+id/poll_preview_title_line_2"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:layout_marginHorizontal="32dp"
                app:cornerRadius="1.5dp"/>
            <com.vk.stories.design.view.poll.RoundedCornersView
                android:id="@+id/poll_preview_option_line_1"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="8dp"
                app:cornerRadius="2dp"/>
            <com.vk.stories.design.view.poll.RoundedCornersView
                android:id="@+id/poll_preview_option_line_2"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="3dp"
                android:layout_marginHorizontal="8dp"
                app:cornerRadius="2dp"/>
            <com.vk.stories.design.view.poll.RoundedCornersView
                android:id="@+id/poll_preview_option_line_3"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="3dp"
                android:layout_marginHorizontal="8dp"
                app:cornerRadius="2dp"/>
            <com.vk.stories.design.view.poll.RoundedCornersView
                android:id="@+id/poll_preview_footer_line_1"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:layout_marginHorizontal="34dp"
                app:cornerRadius="1.5dp"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/poll_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:importantForAccessibility="no"
        style="@android:style/Widget.CompoundButton.RadioButton"/>
</LinearLayout>
