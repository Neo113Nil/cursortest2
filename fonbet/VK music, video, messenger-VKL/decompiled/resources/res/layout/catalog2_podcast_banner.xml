<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rv_item_podcast_banner"
    android:background="@drawable/music_selectable_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/image_banner_background"
        android:layout_width="328dp"
        android:layout_height="152dp"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="12dp"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/image_podcast_cover"
        android:visibility="gone"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:scaleType="center"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_banner_background"
        app:layout_constraintEnd_toEndOf="@+id/image_banner_background"
        app:layout_constraintTop_toTopOf="@+id/image_banner_background"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle3"
        android:textColor="@color/vk_white"
        android:id="@+id/text_on_banner"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_banner_background"
        app:layout_constraintEnd_toStartOf="@+id/image_podcast_cover"
        app:layout_constraintStart_toStartOf="@+id/image_banner_background"
        app:layout_constraintTop_toTopOf="@+id/image_banner_background"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/image_banner_background"
        app:layout_constraintStart_toStartOf="@+id/image_banner_background"
        app:layout_constraintTop_toBottomOf="@+id/image_banner_background"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/text_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toEndOf="@+id/image_banner_background"
        app:layout_constraintStart_toStartOf="@+id/image_banner_background"
        app:layout_constraintTop_toBottomOf="@+id/text_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
