<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/broadcastTop">
    <View
        android:layout_gravity="top"
        android:id="@+id/broadcast_fade_up"
        android:background="@drawable/scrim_top"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:alpha="0.5"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/broadcast_fade_bottom"
        android:background="@drawable/bg_live_fade_bottom"
        android:layout_width="match_parent"
        android:layout_height="1000dp"
        android:layout_marginBottom="-936dp"
        android:alpha="1"/>
    <FrameLayout
        android:id="@+id/broadcast_main_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/bottom_sheet_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="96dp"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/bottom_sheet_gradient_view"
            android:background="@drawable/bg_live_bottom_sheet_gradient"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </FrameLayout>
    <com.vk.libvideo.live.impl.views.error.ErrorView
        android:id="@+id/broadcast_error"
        android:background="@color/live_error_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.spinner.VkSpinner
        android:layout_gravity="center"
        android:id="@+id/broadcast_progress"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/vk_white"
        app:spinnerSize="large"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/broadcast_top_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:alpha="1">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/broadcast_top_holder_left"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:contentDescription="@string/story_accessibility_stream_stat"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/broadcast_top_holder_center"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/broadcast_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/accessibility_done"
            app:buttonAppearance="neutral"
            app:buttonMode="tertiary"
            app:buttonSizeType="large"
            app:icon="@drawable/vk_icon_cancel_shadow_medium_48"
            app:iconSize="48dp"/>
    </LinearLayout>
</merge>
