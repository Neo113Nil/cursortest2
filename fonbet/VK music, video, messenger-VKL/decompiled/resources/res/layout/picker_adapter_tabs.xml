<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.attachpicker.widget.TabImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="8dp"
        android:scaleType="centerInside"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/attach_badge"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="17dp"
        android:src="@drawable/vk_icon_deprecated_ic_attach_new_tab_badge"/>
    <com.vk.attachpicker.widget.TabTextView
        android:textAppearance="@style/VkUiTypography.Caption1Normal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
    <View
        android:layout_gravity="top|right"
        android:id="@+id/attach_hint_point_right"
        android:layout_width="1dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"/>
    <View
        android:layout_gravity="top|left"
        android:id="@+id/attach_hint_point_left"
        android:layout_width="1dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginStart="24dp"/>
</merge>
