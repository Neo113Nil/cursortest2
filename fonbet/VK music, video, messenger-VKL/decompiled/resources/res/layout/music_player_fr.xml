<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/player_background_blur_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginStart="-32dp"
        android:layout_marginEnd="-32dp"/>
    <View
        android:id="@+id/player_gradient"
        android:background="@drawable/music_playlist_header_gradient"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="300dp"/>
    <FrameLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.music.player.presentation.main.SwipeBlockingViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/shadow"
            android:background="@drawable/shadow_bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/music_player_bottom_height"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="bottom"
            android:id="@+id/shuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/music_talkback_shuffle_enable"
            android:layout_marginStart="8dp"
            app:buttonAppearance="neutral"
            app:buttonBackgroundCornerRadius="@dimen/vk_ui_border_radius"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"
            app:icon="@drawable/vk_icon_shuffle_24"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="end|bottom"
            android:id="@+id/repeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/music_talkback_repeat_one"
            android:layout_marginEnd="8dp"
            app:buttonAppearance="neutral"
            app:buttonBackgroundCornerRadius="@dimen/vk_ui_border_radius"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"
            app:icon="@drawable/vk_icon_repeat_24"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <View
                android:id="@+id/dot1"
                android:background="@drawable/music_ic_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginRight="8dp"/>
            <View
                android:id="@+id/dot2"
                android:background="@drawable/music_ic_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginRight="7dp"/>
            <View
                android:id="@+id/dot3"
                android:background="@drawable/ic_playlist_dot_10"
                android:layout_width="9dp"
                android:layout_height="8dp"/>
        </LinearLayout>
    </FrameLayout>
    <ImageButton
        android:id="@+id/close"
        android:background="@drawable/highlight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/music_player_top_height"
        android:src="@drawable/ic_hide_16"
        android:contentDescription="@string/music_talkback_roll_down_player"
        app:tint="?attr/vk_ui_icon_tertiary_alpha"/>
</FrameLayout>
