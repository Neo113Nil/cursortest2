<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:layout_gravity="center"
        android:id="@+id/background"
        android:background="@drawable/bg_adjustment_btn"
        android:layout_width="@dimen/correction_icon_btn_size"
        android:layout_height="@dimen/correction_icon_btn_size"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="@dimen/correction_icon_btn_size"
        android:layout_height="@dimen/correction_icon_btn_size"
        android:scaleType="center"
        android:tint="@color/vk_white"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_gray_50"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/text"
        android:visibility="gone"
        android:layout_width="@dimen/correction_icon_btn_size"
        android:layout_height="@dimen/correction_icon_btn_size"
        android:lineSpacingExtra="2sp"
        style="@style/VkUiTypography.Headline2Medium"/>
</merge>
