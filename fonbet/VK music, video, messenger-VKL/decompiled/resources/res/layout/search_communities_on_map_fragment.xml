<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/map_container"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageButton
        android:id="@+id/back_btn"
        android:background="@drawable/search_communities_bg_map_back_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/back"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="8dp"
        app:srcCompat="@drawable/vk_icon_arrow_left_outline_24"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <FrameLayout
        android:id="@+id/communities_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        app:behavior_peekHeight="100dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"/>
    <FrameLayout
        android:id="@+id/details_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:outlineProvider="none"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_gradient"
        android:background="@drawable/collapsed_bottomsheet_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:elevation="5dp"
        android:outlineProvider="none"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
