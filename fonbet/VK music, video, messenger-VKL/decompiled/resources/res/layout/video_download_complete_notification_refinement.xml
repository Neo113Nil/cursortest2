<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="@color/notification_text_primary"
            android:ellipsize="end"
            android:id="@+id/download_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/completed_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <TextView
                android:textColor="@color/notification_text_accent"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/complete_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/long_video_download_complete_notification_message"
                android:lines="1"
                android:layout_marginStart="4dp"
                style="@style/VkUiTypography.Caption1Medium"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/download_preview"
        android:layout_width="75dp"
        android:layout_height="43dp"
        android:src="@drawable/offline_notification_preview_placeholder"
        android:scaleType="centerCrop"
        android:layout_marginStart="8dp"/>
</LinearLayout>
