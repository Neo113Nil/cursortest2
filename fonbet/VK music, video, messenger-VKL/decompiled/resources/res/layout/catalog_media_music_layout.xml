<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root_container"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/vk_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        app:layout_behavior="com.vk.core.view.FixAppBarLayoutBehavior"
        style="@style/VKAppBar"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow_view"
        android:elevation="10dp"
        style="@style/AppBarShadow"/>
    <com.vk.music.view.vkmix.view.MusicMixAnimationView
        android:layout_gravity="top"
        android:id="@+id/mix_animation"
        android:layout_width="match_parent"
        android:layout_height="532dp"
        android:elevation="-10dp"/>
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="top"
        android:id="@+id/mix_animation_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="532dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:elevation="-10dp"/>
    <View
        android:id="@+id/overlap_separator"
        android:background="@drawable/bg_rounded_top_corners_20"
        android:layout_width="match_parent"
        android:layout_height="@dimen/overlap_separator_height"
        android:layout_marginTop="512dp"
        android:elevation="-10dp"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
