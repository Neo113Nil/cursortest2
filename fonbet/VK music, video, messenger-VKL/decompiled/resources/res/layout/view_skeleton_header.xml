<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_cover_skeleton"
        android:background="?attr/vk_ui_background_secondary"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_block"
        android:background="@drawable/profile_card_background"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="160dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.profile.design.view.skeleton.AvatarViewWrapper
        android:id="@+id/iv_avatar_skeleton"
        android:layout_width="@dimen/user_profile_avatar_size"
        android:layout_height="@dimen/user_profile_avatar_size"
        app:layout_constraintBottom_toTopOf="@+id/v_block"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_block"
        app:solidFillAroundAvatarEnabled="true"/>
    <FrameLayout
        android:id="@+id/name_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_avatar_skeleton">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/tv_name"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/VkUiTypography.DisplayTitle2SemiBold"/>
        <com.vk.core.view.components.skeleton.VkSkeleton
            android:id="@+id/v_name_skeleton"
            android:background="@drawable/profile_skeleton_rounded_background_10dp"
            android:visibility="gone"
            android:layout_width="236dp"
            android:layout_height="26dp"/>
    </FrameLayout>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_status_skeleton"
        android:background="@drawable/profile_skeleton_rounded_background_10dp"
        android:layout_width="210dp"
        android:layout_height="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_container"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_buttons_skeleton"
        android:background="@drawable/profile_skeleton_rounded_background_10dp"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="27dp"
        android:layout_marginBottom="16dp"
        android:maxWidth="328dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_status_skeleton"/>
</merge>
