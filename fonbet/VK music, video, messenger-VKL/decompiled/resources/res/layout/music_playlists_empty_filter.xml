<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_empty_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/music_empty_container"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/music_empty_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintBottom_toTopOf="@+id/music_empty_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Title3Medium.Unscaled"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/music_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintBottom_toTopOf="@+id/music_empty_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_empty_icon"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/music_empty_description"
            android:layout_width="258dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="6sp"
            app:layout_constraintBottom_toTopOf="@+id/music_empty_btn_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_empty_title"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/music_empty_btn_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"
            app:layout_constraintBottom_toTopOf="@+id/music_empty_btn_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_empty_description"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:gravity="center"
            android:id="@+id/music_empty_btn_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAlignment="center"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/music_empty_btn_1"
            app:layout_constraintStart_toStartOf="@+id/music_empty_btn_1"
            app:layout_constraintTop_toBottomOf="@+id/music_empty_btn_1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
