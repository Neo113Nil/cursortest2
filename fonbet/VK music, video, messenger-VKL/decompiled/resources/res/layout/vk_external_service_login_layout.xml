<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <ImageView
        android:id="@+id/external_service_login_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/external_service_login_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_gravity="center"
        android:id="@+id/external_service_login_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/external_service_login_progress"
        app:layout_constraintStart_toEndOf="@+id/external_service_login_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.pnikosis.materialishprogress.ProgressWheel
        android:id="@+id/external_service_login_progress"
        android:visibility="invisible"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/external_service_login_text"
        app:layout_constraintTop_toTopOf="parent"
        app:matProg_barColor="?attr/vk_ui_text_primary"
        app:matProg_barWidth="2dp"
        app:matProg_progressIndeterminate="true"/>
</merge>
