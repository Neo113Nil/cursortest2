<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/clips_geolocation_ask_permission_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="none"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="25dp"
        android:minHeight="30dp"
        android:text="@string/geo_sticker_location_restrictions_title"
        android:lineSpacingExtra="2sp"
        android:fontFamily="@font/vk_roboto_regular"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/button"
        android:background="@drawable/vkui_bg_button_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/vk_legacy_button_primary_foreground"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="107dp"
            android:minHeight="30dp"
            android:text="@string/geo_sticker_location_restrictions_button"
            android:fontFamily="@string/font_family_medium"
            style="@style/VkLegacyTypography.Subhead.Regular"/>
    </FrameLayout>
</LinearLayout>
