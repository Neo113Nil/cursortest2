<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.components.card.VkCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="?attr/vk_ui_background_modal"
    android:padding="@dimen/vk_ui_spacing_size2_xl"
    android:layout_width="@dimen/user_profile_new_user_onboarding_card_width"
    android:layout_height="match_parent"
    android:foreground="?attr/selectableItemBackground"
    android:elevation="2dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_ui_icon_accent"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_accent"
            android:gravity="start"
            android:id="@+id/action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            style="@style/VkUiTypography.FootnoteMedium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="start"
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAlignment="gravity"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/action"
            style="@style/VkUiTypography.Caption1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.core.view.components.card.VkCard>
