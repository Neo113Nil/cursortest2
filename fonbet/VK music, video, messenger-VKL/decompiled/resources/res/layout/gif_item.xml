<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.RatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:id="@+id/gif_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    app:orientation="horizontal">
    <com.vk.core.view.fresco.VKEnhancedImageView
        android:layout_gravity="center"
        android:id="@+id/att_doc_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.libvideo.design.view.videotexture.VideoTextureView
        android:layout_gravity="center"
        android:id="@+id/video_display"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/play"
        android:background="@drawable/bg_gif_label"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_play_24"
        app:tint="@android:color/white"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/error"
        android:background="@drawable/bg_gif_label"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:srcCompat="@drawable/vk_icon_error_circle_outline_24"
        app:tint="@color/vk_white"/>
    <com.vk.libvideo.design.view.duration.DurationView
        android:layout_gravity="end|bottom"
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"/>
</com.vk.core.tool.view.RatioFrameLayout>
