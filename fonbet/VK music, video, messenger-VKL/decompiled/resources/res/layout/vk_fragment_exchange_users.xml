<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/linear_layout"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/close_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:contentDescription="@string/close"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            app:srcCompat="@drawable/vk_icon_cancel_outline_28"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/exchange_title_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_account_linking_extended_subtitle"
            android:lines="1"
            style="@style/VkAuth.Title.Primary"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/exchange_logo_toolbar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <include
                android:layout_gravity="center_horizontal"
                android:id="@+id/logo"
                android:layout_width="@dimen/vk_auth_client_logo_size"
                android:layout_height="@dimen/vk_auth_client_logo_size"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                layout="@layout/vk_auth_logo"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center"
                android:id="@+id/exchange_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vk_account_linking_extended_subtitle"
                style="@style/VkAuth.Title.Primary"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Text"
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:id="@+id/exchange_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vk_account_linking_extended_accounts_limit_description"
                style="@style/VkAuth.Title.Secondary"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/exchange_users"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:overScrollMode="never"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
