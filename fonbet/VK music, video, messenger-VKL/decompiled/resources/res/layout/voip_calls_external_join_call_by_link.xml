<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/vk_icon_chain_outline_28"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/call_anon_onboarding_join_by_link"
        style="@style/VkLegacyTypography.Title2.Medium"/>
    <EditText
        android:id="@+id/insert_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:hint="@string/join_to_call_by_link_insert"
        android:maxLines="1"
        android:inputType="textUri"
        android:imeOptions="actionDone"
        style="@style/VKUIEditText"/>
    <EditText
        android:id="@+id/insert_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/join_to_call_by_link_name"
        android:maxLines="1"
        android:maxLength="50"
        android:inputType="textPersonName"
        android:imeOptions="actionDone"
        style="@style/VKUIEditText"/>
    <TextView
        android:textColor="?attr/vk_ui_text_tertiary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/join_to_call_by_link_name_hint"
        style="@style/VkRobotoRegularStyle.Caption1"/>
    <CheckBox
        android:textAppearance="@style/VkLegacyTypography.Text"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/remember_name_checkbox"
        android:paddingLeft="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/join_to_call_by_link_remember_name"
        style="@style/VkCheckBoxTheme"/>
    <TextView
        android:id="@+id/continue_btn"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="12dp"
        android:text="@string/join_to_call_by_link_continue"
        android:paddingStart="12dp"
        style="@style/VkLegacyButton.Primary.Big"/>
</LinearLayout>
