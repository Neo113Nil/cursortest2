<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.components.card.VkCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="@dimen/vk_expandable_menu_container_width"
        android:layout_height="@dimen/vk_expandable_menu_container_height"
        android:layout_marginBottom="4dp">
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="center"
            android:id="@+id/icon_container"
            android:background="@drawable/vk_expandable_menu_bg_stub_16"
            android:layout_width="@dimen/vk_catalog_miniapp_item_icon_size"
            android:layout_height="@dimen/vk_catalog_miniapp_item_icon_size"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Headline2Medium.Unscaled"
            android:textColor="?attr/vk_ui_text_contrast"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/counter"
            android:background="@drawable/vk_menu_counter_badge_bg"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vk_expandable_menu_counter_height"
            android:minWidth="@dimen/vk_expandable_menu_counter_min_width"
            android:textAlignment="center"
            android:paddingHorizontal="8dp"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="end|top"
            android:id="@+id/dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:layout_marginEnd="8dp"
            app:srcCompat="@drawable/vk_menu_dot_badge_bg"/>
        <com.vk.core.view.components.text.VkText
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginBottom="4dp"
            android:rotation="-5"
            style="@style/SuperApp.Item.Showcase.Badge"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="end|top"
            android:id="@+id/new_badge"
            android:background="@drawable/vk_new_badge_bg_32"
            android:layout_width="@dimen/vk_expandable_menu_badge_width"
            android:layout_height="@dimen/vk_expandable_menu_badge_height"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:layout_marginEnd="8dp"
            android:backgroundTint="?attr/vk_ui_background_content"
            app:srcCompat="@drawable/vk_icon_badge_new_32"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="end|top"
            android:id="@+id/messenger_badge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@string/vk_badge_messenger_description"
            android:layout_marginEnd="4dp"
            app:srcCompat="@drawable/vk_message_badge_24"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption1Normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="none"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:fadingEdgeLength="50dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_expandable_menu_title_margin_top"
        android:layout_marginBottom="8dp"
        android:singleLine="true"
        android:fadeScrollbars="false"
        android:requiresFadingEdge="horizontal"
        android:paddingHorizontal="4dp"/>
</com.vk.core.view.components.card.VkCard>
