<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.formitem.VkFormField
        android:id="@+id/url_form_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:label="@string/story_link_url_label">
        <com.vk.core.view.components.formitem.VkInputSelect
            android:id="@+id/url_input"
            android:nextFocusDown="@+id/name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/story_link_url_hint"
            android:inputType="textUri"
            style="@style/VkInput"/>
    </com.vk.core.view.components.formitem.VkFormField>
    <com.vk.core.view.components.formitem.VkFormField
        android:id="@+id/name_form_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginHorizontal="16dp"
        app:label="@string/story_link_name_label">
        <com.vk.core.view.components.formitem.VkInputSelect
            android:id="@+id/name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/story_link_name_hint"
            android:inputType="text"
            android:imeOptions="actionDone"
            style="@style/VkInput"/>
    </com.vk.core.view.components.formitem.VkFormField>
    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"/>
</merge>
