<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/UserSmallRoot">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/photo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:borderStrokeWidth="3dp"
        app:placeholderImage="@drawable/user_placeholder"
        style="@style/UserSmallPhoto"/>
    <CheckBox
        android:id="@+id/check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        style="@style/Widget.AppCompat.CompoundButton.CheckBox"/>
    <TextView
        android:textColor="?attr/vk_ui_text_muted"
        android:id="@+id/title"
        android:layout_toStartOf="@+id/check"
        style="@style/UserSmallTitle"/>
    <ImageView style="@style/Online.Small"/>
</RelativeLayout>
