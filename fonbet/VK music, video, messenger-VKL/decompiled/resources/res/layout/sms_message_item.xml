<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/libverify_activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/libverify_activity_sms_messages_margin_left"
    android:paddingEnd="@dimen/libverify_activity_sms_messages_margin_right">
    <ImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/libverify_message_image_margin_top"
        android:src="@drawable/libverify_ic_account_circle_white"
        android:layout_alignParentTop="true"
        android:importantForAccessibility="no"
        android:layout_alignParentStart="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/textArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/libverify_message_bubble_margin_top"
        android:layout_marginStart="@dimen/libverify_message_bubble_margin_left"
        android:layout_toEndOf="@+id/image"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="@style/libverify_font_subhead"
            android:textColor="#ffffff"
            android:gravity="start"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/libverify_message_text_margin_left"
            android:layout_marginTop="@dimen/libverify_message_text_margin_top"
            android:layout_marginRight="@dimen/libverify_message_text_margin_left"
            android:layout_marginBottom="@dimen/libverify_message_text_margin_top"
            android:textIsSelectable="false"/>
    </RelativeLayout>
    <TextView
        android:textAppearance="@style/libverify_font_caption"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textArea"
        android:textIsSelectable="false"
        android:layout_marginStart="@dimen/libverify_message_time_margin_left"
        android:layout_toEndOf="@+id/image"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toBottomOf="@+id/textArea"/>
</androidx.constraintlayout.widget.ConstraintLayout>
