<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/music_selectable_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="84dp">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="@dimen/music_thumbs_offset">
        <com.vk.music.view.ThumbsImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/audio_image"
            android:layout_width="@dimen/music_podcast_image"
            android:layout_height="@dimen/music_podcast_image"
            app:roundedCornerRadius="@dimen/music_image_corners_6"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_song_outline_28"
            app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
        <ImageView
            android:id="@+id/audio_playing_indicator"
            android:background="@drawable/music_dark_round_rect_6dp"
            android:visibility="gone"
            android:layout_width="@dimen/music_podcast_image"
            android:layout_height="@dimen/music_podcast_image"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="13dp">
        <TextView
            android:textColor="@color/vk_ui_text_title_color"
            android:id="@+id/audio_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/VkUiTypography.Headline1Normal"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/audio_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            style="@style/VkUiTypography.Footnote"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/audio_menu"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_actions_small_24"
        android:scaleType="center"
        android:contentDescription="@string/music_talkback_more"
        android:layout_marginEnd="4dp"
        style="@style/ActionButton.More"/>
</LinearLayout>
