<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/vk_legacy_accent"
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_search_btn"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/search"
        android:layout_marginEnd="16dp"
        app:srcCompat="@drawable/vk_icon_search_24"
        app:tint="?attr/vk_legacy_accent"/>
</LinearLayout>
