<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.stickers.views.sticker.ImStickerView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/msg_sticker_max_height"
        android:contentDescription="@string/vkim_accessibility_sticker"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextContrast"
        android:layout_gravity="end|bottom"
        android:id="@+id/timeAndStatus"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/ugcStickerIcon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/vk_icon_ugc_chat_sticker_circle_fill_black_alpha_20"/>
</FrameLayout>
