<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vk_qr_code_auth_device_info_title"
        android:accessibilityHeading="true"
        style="?attr/vk_ui_typography_title2_bold"/>
    <include
        android:id="@+id/qr_code_auth_device_info_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        layout="@layout/vk_qr_code_auth_device_info_item"/>
    <include
        android:id="@+id/qr_code_auth_device_info_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        layout="@layout/vk_qr_code_auth_device_info_item"/>
    <include
        android:id="@+id/qr_code_auth_device_info_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        layout="@layout/vk_qr_code_auth_device_info_item"/>
</LinearLayout>
