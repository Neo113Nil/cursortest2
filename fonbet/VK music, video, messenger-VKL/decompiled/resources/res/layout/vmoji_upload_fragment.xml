<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/vk_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/vk_legacy_header_tint"
            android:id="@+id/cancel_header"
            android:background="@drawable/vk_highlight"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vmoji_upload_fail_cancel"
            android:layout_alignParentTop="true"
            android:lineSpacingExtra="2sp"
            android:fontFamily="@font/vk_roboto_medium"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="4dp"
            android:letterSpacing="0.01"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/retry"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="20sp"
                android:textColor="?attr/vk_legacy_text_primary"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/vmoji_upload_fail_title"
                android:lineSpacingExtra="1sp"
                android:fontFamily="@font/vk_roboto_medium"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/vk_legacy_text_secondary"
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vmoji_upload_fail_hint"
                android:lineSpacingExtra="1sp"
                android:letterSpacing="0.01"/>
        </LinearLayout>
        <TextView
            android:id="@+id/retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="44dp"
            android:minHeight="44dp"
            android:text="@string/vmoji_upload_fail_retry"
            android:layout_above="@+id/cancel"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VkLegacyButton.Primary.Big"/>
        <TextView
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxHeight="44dp"
            android:minHeight="44dp"
            android:text="@string/cancel"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VkLegacyButton.Tertiary.Big"/>
    </RelativeLayout>
</FrameLayout>
