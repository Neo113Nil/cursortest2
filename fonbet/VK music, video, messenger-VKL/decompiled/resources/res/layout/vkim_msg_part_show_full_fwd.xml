<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:contentDescription="@string/vkim_msg_list_fwd_show_all">
    <TextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/tv_three_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="..."
        style="@style/VkLegacyTypography.Headline.Roboto.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:id="@+id/tv_show_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vkim_msg_list_fwd_show_all"
        android:singleLine="true"
        android:layout_marginStart="@dimen/fwd_btn_show_all_inner_margin"
        style="@style/VkLegacyTypography.Headline.Roboto.Medium"/>
</LinearLayout>
