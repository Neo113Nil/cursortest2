<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/content"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.fresco.FrescoImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxWidth="320dp"
            android:maxHeight="320dp"
            android:minWidth="128dp"
            android:minHeight="128dp"
            app:vkim_scaleType="center_crop"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="26dp">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:lineSpacingExtra="6dp"
                android:fontFamily="@string/font_family_regular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/vk_black"
                android:gravity="center"
                android:id="@+id/read_button"
                android:background="@drawable/vkim_white_btn_8"
                android:paddingLeft="14dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="16dp"
                android:drawablePadding="8dp"
                android:textAllCaps="true"
                android:fontFamily="@string/font_family_medium"
                app:layout_constraintEnd_toStartOf="@+id/fl_listen"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <FrameLayout
                android:id="@+id/fl_listen"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="16dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/read_button"
                app:layout_constraintTop_toBottomOf="@+id/title"
                style="@style/VkLegacyButton.WhiteTransparent20">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/vk_white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/listen_button"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vkim_longread_listen_button"
                    android:textAllCaps="true"
                    android:fontFamily="@string/font_family_medium"
                    android:layout_marginStart="20dp"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/blocked_layout"
        android:background="@drawable/vkim_bg_blue_with_corners"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ic_blocked_view"
            android:layout_width="@dimen/vkim_article_blocked_ic_size"
            android:layout_height="@dimen/vkim_article_blocked_ic_size"
            android:layout_marginTop="@dimen/vkim_article_blocked_ic_margin"
            android:src="@drawable/ic_article_protected_72"
            android:tint="@color/vk_gray_400"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="@dimen/vkim_article_blocked_title_size"
            android:textStyle="bold"
            android:textColor="@color/vk_gray_400"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/blocked_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vkim_article_blocked_title_side_margin"
            android:layout_marginTop="@dimen/vkim_article_blocked_title_margin"
            android:layout_marginRight="@dimen/vkim_article_blocked_title_side_margin"
            android:layout_marginBottom="@dimen/vkim_article_blocked_bottom_margin"
            android:maxLines="2"
            android:lineSpacingExtra="2sp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/deleted_layout"
        android:background="@drawable/vkim_bg_blue_with_corners"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/vk_gray_400"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/vkim_article_deleted"
            android:drawablePadding="8dp"
            android:fontFamily="@string/font_family_regular"
            app:drawableStartCompat="@drawable/vk_icon_delete_24"
            app:drawableTint="@color/vk_gray_400"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/vk_gray_400"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/deleted_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="24dp"
            android:maxLines="3"
            android:lineSpacingExtra="6dp"
            android:fontFamily="@string/font_family_regular"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/vk_gray_400"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/publisher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="36dp"
            android:maxLines="1"
            android:fontFamily="@string/font_family_regular"/>
    </LinearLayout>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextContrast"
        android:layout_gravity="bottom|right"
        android:id="@+id/timeAndStatus"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:importantForAccessibility="no"/>
</FrameLayout>
