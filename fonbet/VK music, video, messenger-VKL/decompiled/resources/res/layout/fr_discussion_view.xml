<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1">
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/commentBar">
        <ProgressBar
            android:id="@+id/bigProgress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="?attr/vk_ui_icon_tertiary"
            android:indeterminateTintMode="src_in"/>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="?attr/vk_ui_text_muted"
        android:gravity="center"
        android:id="@+id/createHint"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/create_topic_explain"
        android:layout_above="@+id/commentBar"
        android:layout_centerInParent="true"/>
    <me.grishka.appkit.views.UsableRecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/commentBar"/>
    <com.vk.writebar.WriteBar
        android:id="@+id/commentBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <View
        android:id="@+id/commentBarShadow"
        android:background="@drawable/shadow_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_above="@+id/commentBar"/>
    <com.vk.topics.impl.view.PaginationView
        android:id="@+id/paginationView"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="5dp"
        android:layout_alignParentRight="true"/>
    <FrameLayout
        android:id="@+id/bottom_sheet_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/commentBar"/>
</RelativeLayout>
