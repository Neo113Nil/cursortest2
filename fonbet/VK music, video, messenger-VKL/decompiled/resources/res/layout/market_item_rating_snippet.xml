<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="1dp">
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center_vertical"
        android:id="@+id/market_item_rating_star_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_favorite_12"
        app:tint="?attr/vk_ui_accent_orange_peach"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/market_item_rating_tv_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vk_ui_spacing_size2_xs"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_icon_tertiary"
        android:id="@+id/market_item_rating_dot_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="·"
        android:layout_marginStart="@dimen/vk_ui_spacing_size2_xs"
        style="@style/VkUiTypography.Caption1"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/market_item_rating_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="@dimen/vk_ui_spacing_size2_xs"
        style="@style/VkUiTypography.Caption1"/>
</merge>
