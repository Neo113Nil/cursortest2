<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:id="@+id/vkim_link_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vkim_chat_make_link_hint"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_roboto_regular"
        android:paddingStart="@dimen/vkim_list_padding"
        android:paddingEnd="@dimen/vkim_list_padding"
        style="@style/VkLegacyTypography.Subhead1"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="@dimen/vkim_list_padding"
        android:paddingEnd="@dimen/vkim_list_padding">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/vkim_chat_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/vk_roboto_regular"/>
        <com.pnikosis.materialishprogress.ProgressWheel
            android:layout_gravity="center"
            android:id="@+id/vkim_progress"
            android:visibility="invisible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:matProg_barColor="?attr/vk_legacy_accent"
            app:matProg_progressIndeterminate="true"/>
    </FrameLayout>
    <com.vk.im.ui.views.settings.DividerSettingsView
        android:id="@+id/vkim_show_last_messages_divider"
        android:layout_marginTop="12dp"
        style="@style/VkIm.Settings.Divider"/>
    <com.vk.im.ui.views.settings.MaterialSwitchSettingsView
        android:id="@+id/vkim_show_last_messages"
        app:im_descriptionText="@string/vkim_chat_make_link_hint"
        app:im_labelText="@string/vkim_show_chat_history"
        style="@style/VkIm.Settings.Label.Normal"/>
    <com.vk.im.ui.views.settings.DividerSettingsView style="@style/VkIm.Settings.Divider"/>
    <com.vk.im.ui.views.settings.LabelSettingsView
        android:id="@+id/vkim_share"
        app:vkim_icon="@drawable/vk_icon_share_outline_28"
        app:vkim_titleText="@string/vkim_share"
        style="@style/VkIm.Settings.Label.Normal"/>
    <com.vk.im.ui.views.settings.LabelSettingsView
        android:id="@+id/vkim_copy"
        app:vkim_icon="@drawable/vk_icon_copy_outline_28"
        app:vkim_titleText="@string/vkim_copy_link"
        style="@style/VkIm.Settings.Label.Normal"/>
    <com.vk.im.ui.views.settings.LabelSettingsView
        android:id="@+id/vkim_share_qr"
        app:vkim_icon="@drawable/vk_icon_qr_code_outline_28"
        app:vkim_titleText="@string/vkim_chat_link_share_qr"
        style="@style/VkIm.Settings.Label.Normal"/>
    <com.vk.im.ui.views.settings.DividerSettingsView style="@style/VkIm.Settings.Divider"/>
    <com.vk.im.ui.views.settings.LabelSettingsView
        android:id="@+id/vkim_link_invalidate"
        app:vkim_icon="@drawable/vk_icon_block_outline_28"
        app:vkim_iconTint="?attr/vkim_chat_link_invalidate_icon_color"
        app:vkim_titleText="@string/vkim_chat_link_invalidate"
        app:vkim_titleTextAppearance="?attr/vkim_chat_link_invalidate_title_text_appearance"
        style="@style/VkIm.Settings.Label.Normal"/>
</LinearLayout>
