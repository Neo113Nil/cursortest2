<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/voip_watch_video_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_watch_video_load_error_title"
        android:lines="2"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:id="@+id/voip_watch_video_error_retry_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/retry"
        style="@style/VkLegacyButton.Primary"/>
</LinearLayout>
