<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fullscreen_password_root_contrainer"
    android:paddingBottom="@dimen/vk_auth_keyboard_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_fullscreen_password_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle2SemiBold"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vk_auth_fullscreen_password_subtitle"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.auth.ui.VkAuthPasswordView
        android:id="@+id/password_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sub_title"
        app:vk_edit_text_background="@drawable/vk_ui_auth_bg_edittext_stated"
        app:vk_edit_text_hint="@string/vk_auth_enter_password_hint"
        app:vk_edit_text_layout="@layout/vk_auth_landing_password_edittext"
        app:vk_toggle_button_content_description="@string/vk_auth_show_pass"/>
    <TextView
        android:textColor="?attr/vk_ui_text_negative"
        android:gravity="start"
        android:id="@+id/error_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vk_auth_incorrect_login_message"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/password_container"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <com.vk.auth.ui.VkAuthClickableTextView
        android:textColor="?attr/vk_ui_text_link"
        android:id="@+id/fullscreen_password_forget_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vk_auth_forgot_or_no_pass"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_message"
        style="@style/VkUiTypography.SubheadMedium"/>
    <com.vk.auth.ui.VkLoadingButton
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:id="@+id/continue_btn"
        android:background="@drawable/vk_ui_auth_bg_landing_primary_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/vk_auth_continue"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toTopOf="@+id/verify_by_phone"
        app:layout_constraintTop_toBottomOf="@+id/fullscreen_password_forget_password"
        app:layout_constraintVertical_bias="1"
        app:vk_lb_text_appearance="@style/VkUiTypography.Headline1Medium"
        style="@style/VKID.View.Button"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/verify_by_phone"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_auth_confirm_another_way"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toTopOf="@+id/vk_enter_by_mail"
        app:layout_goneMarginBottom="0dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/vk_enter_by_mail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_auth_by_password_mail"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toTopOf="@+id/help_button"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/help_button"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vk_auth_help_button"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
