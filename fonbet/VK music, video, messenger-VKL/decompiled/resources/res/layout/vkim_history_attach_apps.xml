<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_legacy_content_tint_background"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <com.vk.core.view.fresco.FrescoImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/mini_app_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="10dp"
        app:vkim_placeholderDrawable="?attr/vk_legacy_placeholder_icon_background"/>
    <TextView
        android:textSize="14dp"
        android:textColor="?attr/vk_legacy_text_muted"
        android:ellipsize="end"
        android:id="@+id/mini_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@string/font_family_medium"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/mini_app_image"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:ellipsize="end"
        android:id="@+id/mini_app_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@string/font_family_regular"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/mini_app_image"
        app:layout_constraintTop_toBottomOf="@+id/mini_app_title"/>
    <com.vk.core.view.TintTextView
        android:id="@+id/mini_app_btn"
        android:paddingTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:drawablePadding="5.5dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:drawableStartCompat="@drawable/vk_icon_services_16"
        app:drawableTint="?attr/vk_legacy_button_outline_foreground"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/mini_app_image"
        app:layout_constraintEnd_toStartOf="@+id/time"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/mini_app_image"
        app:layout_constraintTop_toBottomOf="@+id/mini_app_description"
        app:layout_constraintVertical_bias="1"
        style="@style/outline_button"/>
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_legacy_separator_common"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mini_app_image"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:textColorLink="?attr/vk_legacy_accent"
        android:ellipsize="end"
        android:linksClickable="true"
        android:id="@+id/footer_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/time_and_status"
        app:layout_constraintStart_toEndOf="@+id/app_users"
        app:layout_constraintTop_toBottomOf="@+id/separator"
        style="@style/VkSansTextViewStyle"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/app_users"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toStartOf="@+id/footer_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/separator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
