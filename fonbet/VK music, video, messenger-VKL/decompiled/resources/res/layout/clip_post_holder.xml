<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clip_post_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clip_post_clip_owner_container"
        android:background="@drawable/highlight"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.imageloader.view.VKCircleImageView
            android:id="@+id/clip_post_clip_owner_avatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            app:actualImageScaleType="centerCrop"
            app:emptyImagePlaceholder="@drawable/user_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/clip_post_clip_owner_name"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/clip_post_clip_owner_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/clip_post_clip_owner_avatar"
            app:layout_constraintEnd_toStartOf="@+id/clip_post_clip_owner_verified"
            app:layout_constraintStart_toEndOf="@+id/clip_post_clip_owner_avatar"
            app:layout_constraintTop_toTopOf="@+id/clip_post_clip_owner_avatar"/>
        <ImageView
            android:id="@+id/clip_post_clip_owner_verified"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/vk_icon_verified_16"
            app:layout_constraintBottom_toBottomOf="@+id/clip_post_clip_owner_name"
            app:layout_constraintEnd_toStartOf="@+id/clip_post_clip_label"
            app:layout_constraintStart_toEndOf="@+id/clip_post_clip_owner_name"
            app:layout_constraintTop_toTopOf="@+id/clip_post_clip_owner_name"
            app:tint="@color/vk_white"/>
        <TextView
            android:textColor="@color/vk_white_alpha60"
            android:id="@+id/clip_post_clip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clip"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/clip_post_clip_owner_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/clip_post_clip_owner_verified"
            app:layout_constraintTop_toTopOf="@+id/clip_post_clip_owner_name"
            style="@style/VkUiTypography.Subhead"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
