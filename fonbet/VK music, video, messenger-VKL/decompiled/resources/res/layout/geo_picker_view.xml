<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/geo_picker_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_gravity="top"
        android:id="@+id/geo_picker_appbar"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:elevation="0dp"
        app:elevation="0dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/geo_picker_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/vk_toolbar_behavior_scrolling"/>
    <ScrollView
        android:id="@+id/geo_picker_placeholder_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="110dp">
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.core.view.components.spinner.VkSpinner
                android:layout_gravity="center"
                android:id="@+id/geo_picker_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:spinnerSize="large"
                app:spinnerState="loading"/>
            <com.vk.core.view.components.paging.list.VkErrorView
                android:layout_gravity="center"
                android:id="@+id/geo_picker_network_error_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.vk.core.view.components.paging.list.VkErrorView
                android:layout_gravity="center"
                android:id="@+id/geo_picker_permission_error_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/geo_picker_empty_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/geo_picker_search_empty_list"
                android:textAlignment="gravity"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                style="@style/VkUiTypography.Headline2Normal"/>
        </FrameLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
