<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="36dp"
    android:layout_height="48dp">
    <View
        android:id="@+id/clips_template_editor_fragment_item_background"
        android:background="@drawable/clips_template_item_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.attachpicker.widget.MediaStoreItemSmallView
        android:id="@+id/picker_photo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/gallery_picker_preview_accessibility_photo"
        app:actualImageScaleType="fitCenter"/>
    <TextView
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/clips_template_editor_fragment_item_duration"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/VkUiTypography.Footnote"/>
</FrameLayout>
