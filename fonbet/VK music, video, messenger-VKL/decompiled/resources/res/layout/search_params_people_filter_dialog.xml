<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.core.view.ConstrainedLinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vk_standard_list_item_padding"
        android:paddingRight="@dimen/vk_standard_list_item_padding"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:vk_max_width="400dp">
        <TextView
            android:text="@string/vk_discover_search_city"
            style="@style/VKUIFormHeader"/>
        <TextView
            android:id="@+id/tv_cities"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_discover_search_city"
            style="@style/VKUIFormButton"/>
        <TextView
            android:text="@string/vk_discover_search_gender"
            style="@style/VKUIFormHeader"/>
        <com.vk.core.view.components.segmented.control.VkSegmentedControl
            android:id="@+id/tv_gender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"/>
        <TextView
            android:text="@string/vk_discover_search_age"
            style="@style/VKUIFormHeader"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp">
            <include
                android:id="@+id/spinner_age_from"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/vk_discover_search_spinner"/>
            <Space
                android:layout_width="8dp"
                android:layout_height="8dp"/>
            <include
                android:id="@+id/spinner_age_to"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/vk_discover_search_spinner"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/education_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/vk_ui_text_title_color"
                android:id="@+id/education_param_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/search_params_education_title"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toTopOf="@+id/education_param_value"
                app:layout_constraintEnd_toStartOf="@+id/education_param_chevron"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginBottom="8dp"
                style="@style/VkUiTypography.Headline1"/>
            <TextView
                android:textColor="?attr/vk_ui_text_subhead"
                android:id="@+id/education_param_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/education_param_chevron"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/education_param_title"
                style="@style/VkUiTypography.Subhead"/>
            <ImageView
                android:id="@+id/education_param_chevron"
                android:layout_width="16dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/vk_icon_chevron_right_24"
                app:tint="?attr/vk_ui_icon_tertiary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:text="@string/search_params_work_title"
            style="@style/VKUIFormHeader"/>
        <EditText
            android:textColorHint="@color/vkui_form_button_text"
            android:gravity="start|center_vertical"
            android:id="@+id/work_param_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="40dp"
            android:hint="@string/search_params_work_hint"
            android:singleLine="true"
            android:maxLength="60"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingVertical="8dp"
            android:importantForAutofill="no"
            style="@style/VKUIEditText"/>
        <TextView
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="@string/vk_discover_search_relationships"
            style="@style/VKUIFormHeader"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <include
                android:id="@+id/spinner_relationships"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/vk_discover_search_spinner"/>
        </LinearLayout>
    </com.vk.core.view.ConstrainedLinearLayout>
</merge>
