<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/vk_highlight"
    android:layout_width="320dp"
    android:layout_height="60dp">
    <TextView
        android:id="@+id/app_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/app_image"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/MiniApps.ItemTitle"/>
    <TextView
        android:id="@+id/app_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/app_title"
        app:layout_constraintTop_toBottomOf="@+id/app_title"
        style="@style/MiniApps.ItemSubTitle"/>
    <FrameLayout
        android:id="@+id/app_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption2Medium.Unscaled"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/counter"
        android:background="@drawable/vk_vkapp_catalog_bg"
        android:paddingLeft="@dimen/vk_bottom_navigation_counter_padding"
        android:paddingRight="@dimen/vk_bottom_navigation_counter_padding"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:minWidth="@dimen/vk_bottom_navigation_counter_height_outer"
        android:minHeight="16dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/app_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
