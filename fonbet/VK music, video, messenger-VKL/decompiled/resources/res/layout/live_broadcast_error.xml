<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp">
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_broadcast_error_title"
            android:shadowColor="#52000000"
            android:shadowDy="2"
            android:shadowRadius="12"
            style="@style/VkUiTypography.DisplayTitle1SemiBold"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/live_broadcast_error_message"
            android:shadowColor="#52000000"
            android:shadowDy="2"
            android:shadowRadius="12"
            style="@style/VkUiTypography.Footnote"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/broadcast_error_retry_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/live_broadcast_error_retry"
            android:layout_marginHorizontal="16dp"
            app:buttonAppearance="neutral"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/broadcast_error_cancel_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/live_broadcast_error_finish"
            android:layout_marginHorizontal="16dp"
            app:buttonAppearance="neutral"
            app:buttonMode="tertiary"
            app:buttonSizeType="large"/>
    </LinearLayout>
</merge>
