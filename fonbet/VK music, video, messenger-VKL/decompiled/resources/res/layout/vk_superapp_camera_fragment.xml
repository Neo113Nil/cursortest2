<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/qr_scanner_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="@dimen/vk_camera_target_size"
            android:layout_height="@dimen/vk_camera_target_size"
            android:layout_marginBottom="@dimen/vk_camera_target_bottom_margin"
            app:srcCompat="@drawable/vk_ic_qrscanner"/>
        <TextView
            android:textSize="@dimen/vk_camera_target_text_size"
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:gravity="center_horizontal"
            android:id="@+id/tv_qr_scanner_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_camera_ui_qr_scanner_info"
            android:lineSpacingExtra="2sp"
            android:fontFamily="@font/vk_roboto_medium"/>
    </LinearLayout>
    <com.vk.core.ui.TopBottomAnimView
        android:id="@+id/qr_scanner_animation"
        android:background="@drawable/vk_bg_qr_scanner_anim"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="115dp"/>
    <ImageView
        android:id="@+id/vk_superapp_qr_camera_close"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/vk_accessibility_close"
        android:layout_marginStart="14dp"
        app:srcCompat="@drawable/vk_icon_cancel_outline_28"
        app:tint="@color/vk_white"/>
</FrameLayout>
