<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.OverlayLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:overlayDrawable="@drawable/highlight_post"
    app:padOverlay="true">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:paddingTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:foregroundGravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <com.vk.core.view.fresco.FrescoImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/snippet_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|top"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_alignTop="@+id/snippet_image"
            android:layout_marginEnd="8dp"
            android:layout_alignEnd="@+id/snippet_image">
            <ImageView
                android:layout_gravity="top"
                android:id="@+id/snippet_toggle_fave"
                android:background="@drawable/highlight_circle_white"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/fave_start_button"
                android:scaleType="center"
                android:layout_marginEnd="4dp"/>
            <ImageView
                android:layout_gravity="end|top"
                android:id="@+id/snippet_actions"
                android:background="@drawable/highlight_unlimited"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:scaleType="center"
                app:srcCompat="@drawable/vk_icon_more_vertical_24"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_snippet_status"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/vk_icon_linked_24"
            app:tint="@color/fave_snippet_dark_gray"/>
        <TextView
            android:layout_gravity="start|top"
            android:id="@+id/tv_new_label"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_alignTop="@+id/snippet_image"
            android:layout_marginStart="-2dp"
            android:layout_alignStart="@+id/snippet_image"
            style="@style/NewLabel"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/info"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/post_side_padding"
        android:paddingEnd="@dimen/post_side_padding">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/attach_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_toStartOf="@+id/attach_button"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:id="@+id/attach_subtitle_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/attach_title"
            android:layout_toStartOf="@+id/attach_button"
            android:layout_alignParentStart="true">
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/attach_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <com.vk.core.view.RatingView
                android:id="@+id/attach_rating"
                android:layout_width="88dp"
                android:layout_height="19dp"
                android:paddingStart="7dp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="@color/almost_black"
                android:ellipsize="end"
                android:id="@+id/attach_review_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:paddingStart="7dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/attach_url_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/attach_subtitle_wrap"
            android:layout_toStartOf="@+id/attach_button"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/iv_amp"
                style="@style/AmpSmallIconStyle"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/attach_subsubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <com.vk.core.view.components.button.VkSimpleButton
            android:gravity="center"
            android:id="@+id/attach_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"
            app:buttonMode="outline"/>
    </RelativeLayout>
</com.vk.core.tool.view.OverlayLinearLayout>
