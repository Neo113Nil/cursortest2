<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingHorizontal="16dp">
        <androidx.cardview.widget.CardView
            android:id="@+id/media_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginVertical="6dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@+id/guideline_disclaimer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/media_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"/>
        </androidx.cardview.widget.CardView>
        <ImageView
            android:id="@+id/ads_icon"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="9dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/media_container"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_logo_vk_ads_16"
            app:tint="?attr/vk_ui_icon_tertiary"/>
        <TextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAllCaps="true"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/ads_icon"
            app:layout_constraintEnd_toStartOf="@+id/choices_button"
            app:layout_constraintStart_toEndOf="@+id/ads_icon"
            app:layout_constraintTop_toTopOf="@+id/ads_icon"
            style="@style/VkUiTypography.Caption3Medium"/>
        <ImageView
            android:id="@+id/choices_button"
            android:background="@drawable/vkui_ripple_circle_highlight"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:src="@drawable/vk_icon_more_horizontal_16"
            android:contentDescription="@string/vk_accessibility_actions"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/ads_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ads_icon"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/media_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/media_container"
            app:layout_constraintTop_toBottomOf="@+id/ads_icon">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                style="@style/VkUiTypography.TextSemiBold"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                style="@style/VkUiTypography.Caption1Normal"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guideline_disclaimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="1"/>
        <ImageView
            android:id="@+id/disclaimer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guideline_disclaimer"
            app:tint="@color/vk_stateful_secondary_color"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
