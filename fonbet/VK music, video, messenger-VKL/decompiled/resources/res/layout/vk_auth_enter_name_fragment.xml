<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/vk_auth_enter_name_container"
    android:paddingBottom="@dimen/vk_auth_keyboard_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_sign_up_enter_profile_info_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkAuth.Title.Primary"/>
    <ViewStub
        android:id="@+id/name_block_redesign_view_stub"
        android:inflatedId="@+id/name_and_avatar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteNormal"
        android:textColor="?attr/vk_ui_text_negative"
        android:layout_gravity="end"
        android:id="@+id/error_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_and_avatar_container"/>
    <TextView
        android:id="@+id/choose_gender_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/vk_auth_sign_up_choose_gender_title"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_name"
        style="@style/VKID.Text.Subtitle"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/choose_gender_radio_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/choose_gender_title">
        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/male_gender_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_auth_sign_up_gender_male"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:buttonTint="@color/vk_auth_radiobutton_tint"
            style="@style/VKID.View.RadioButton"/>
        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/female_gender_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_auth_sign_up_gender_female"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:buttonTint="@color/vk_auth_radiobutton_tint"
            style="@style/VKID.View.RadioButton"/>
    </RadioGroup>
    <TextView
        android:id="@+id/enter_birthday_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/vk_auth_sign_up_enter_profile_info_birthday_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/choose_gender_radio_container"
        style="@style/VKID.Text.SubheadNormal.Subhead"/>
    <ImageView
        android:id="@+id/enter_birthday_tooltip"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@string/vk_auth_sign_up_enter_birthday_tooltip_description"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/enter_birthday_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/enter_birthday_header"
        app:layout_constraintTop_toTopOf="@+id/enter_birthday_header"
        app:srcCompat="@drawable/vk_icon_info_outline_16"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <com.vk.auth.ui.VkAuthExtendedEditText
        android:id="@+id/enter_birthday_container"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:hint="@string/vk_auth_sign_up_enter_birthday_format_hint"
        android:inputType="date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/enter_birthday_header"
        app:vk_error_stated_action_button_content_description="@string/vk_auth_sign_up_enter_birthday_accessibility_hint"
        app:vk_error_stated_action_button_id="@+id/open_calendar"
        app:vk_error_stated_action_button_src="@drawable/vk_icon_calendar_outline_24"
        app:vk_error_stated_edit_text_id="@+id/enter_birthday"
        style="@style/VkAuth.EditText.Stated.WithError"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteNormal"
        android:textColor="?attr/vk_ui_text_negative"
        android:id="@+id/error_birthday"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/enter_birthday_container"/>
    <com.vk.auth.ui.VkLoadingButton
        android:id="@+id/continue_btn"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/vk_auth_continue"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/help_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_birthday"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_goneMarginBottom="0dp"
        style="@style/VkAuth.Button.Primary"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/help_button"
        android:padding="@dimen/vk_ui_button_padding_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_help_button"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
