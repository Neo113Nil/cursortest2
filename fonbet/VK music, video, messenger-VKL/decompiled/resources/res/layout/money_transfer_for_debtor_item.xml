<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_list_selector"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="16dp">
    <com.vk.money.ui.avatar.MoneyAvatarView
        android:id="@+id/photo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="6dp"
        android:layout_alignParentStart="true"
        app:placeholderImage="@drawable/user_placeholder"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:layout_alignTop="@+id/photo"
        android:fontFamily="@string/font_family_medium"
        android:layout_toStartOf="@+id/tv_mt_sum"
        android:layout_toEndOf="@+id/photo"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_muted"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="4"
        android:singleLine="false"
        android:layout_below="@+id/title"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/tv_mt_sum"
        android:layout_alignStart="@+id/title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_below="@+id/subtitle"
        android:layout_toEndOf="@+id/photo"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/positive"
        android:layout_marginTop="7dp"
        android:text="@string/money_transfer_accept"
        android:layout_below="@+id/info"
        android:fontFamily="@string/font_family_medium"
        android:layout_marginEnd="4dp"
        android:layout_toEndOf="@+id/photo"
        style="@style/primary_button"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/negative"
        android:paddingBottom="7dp"
        android:layout_marginTop="7dp"
        android:text="@string/money_transfer_decline"
        android:layout_below="@+id/info"
        android:fontFamily="@string/font_family_medium"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/positive"
        style="@style/secondary_button"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:id="@+id/tv_mt_sum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_alignTop="@+id/photo"
        android:fontFamily="@string/font_family_regular"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
