<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_highlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.voip.ui.avatars.VoipAvatarViewContainer
        android:id="@+id/friend_avatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAvatarSize="44dp"/>
    <com.vk.im.ui.views.online.OnlineView
        android:id="@+id/friend_online"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/friend_avatar"
        app:layout_constraintCircle="@+id/friend_avatar"
        app:layout_constraintCircleAngle="135"
        app:layout_constraintCircleRadius="22dp"
        app:layout_constraintEnd_toEndOf="@+id/friend_avatar"
        app:layout_constraintStart_toStartOf="@+id/friend_avatar"
        app:layout_constraintTop_toTopOf="@+id/friend_avatar"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/friend_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/friend_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/friend_call_audio_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/friend_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/friend_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/friend_call_audio_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/friend_avatar"
        app:layout_constraintTop_toBottomOf="@+id/friend_title"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
    <ImageView
        android:id="@+id/friend_call_audio_button"
        android:background="@drawable/vk_highlight_unlimited"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_phone_outline_28"
        android:scaleType="center"
        android:contentDescription="@string/voip_accessibility_call_by_audio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/friend_call_video_button"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent"/>
    <ImageView
        android:id="@+id/friend_call_video_button"
        android:background="@drawable/vk_highlight_unlimited"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_videocam_outline_28"
        android:scaleType="center"
        android:contentDescription="@string/voip_accessibility_call_by_video"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
