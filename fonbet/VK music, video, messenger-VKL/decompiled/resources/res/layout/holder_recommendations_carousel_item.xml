<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_container"
    android:background="@drawable/recommendations_carousel_gray_item_bg"
    android:layout_width="@dimen/recomm_carousel_item_width"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/image"
        android:layout_width="@dimen/recomm_carousel_item_width"
        android:layout_height="@dimen/recomm_carousel_item_width"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/carousel_card_top_action_button"
        android:background="@drawable/vk_ripple_circle_highlight"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_hide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_dismiss_dark_20"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:gravity="start|top"
            android:id="@+id/title"
            android:paddingBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:maxLines="1"
            android:textAlignment="gravity"
            app:vk_layout_isFluid="true"
            style="@style/VkUiTypography.Headline1Normal"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/secondary_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            style="@style/VkUiTypography.Footnote"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/title_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16sp"
        android:lines="1"
        style="@style/VkUiTypography.Footnote"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/title_subtitle_flow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="12dp"
        app:constraint_referenced_ids="title_container,subtitle"
        app:flow_verticalGap="2dp"
        app:layout_constraintBottom_toTopOf="@+id/action_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:orientation="horizontal"
        android:id="@+id/badge_container"
        android:background="@drawable/recommendations_carousel_badge_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:paddingVertical="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image"
        app:layout_constraintVertical_bias="100">
        <com.vk.core.view.PhotoStackView
            android:layout_gravity="center_vertical"
            android:id="@+id/badge_photostack"
            android:layout_width="wrap_content"
            android:layout_height="16dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/badge_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="6dp"
            app:vk_layout_isFluid="true"
            style="@style/VkUiTypography.FootnoteMedium"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/action_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="12dp"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_subtitle_flow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
