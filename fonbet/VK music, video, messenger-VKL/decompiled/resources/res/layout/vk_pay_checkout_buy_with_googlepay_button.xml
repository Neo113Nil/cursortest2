<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_pay_checkout_googlepay_button_no_shadow_background"
    android:padding="2sp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="48sp"
    android:contentDescription="@string/vk_pay_checkout_buy_with_googlepay_button_content_description"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="2">
        <TextView
            android:textColor="?attr/vk_legacy_button_primary_foreground"
            android:gravity="center"
            android:id="@+id/vk_pay_checkout_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_pay_checkout_buy_with_googlepay_button"
            style="@style/VkLegacyTypography.Headline.Medium"/>
        <ImageView
            android:id="@+id/vk_pay_checkout_image"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:layout_marginStart="8dp"
            app:srcCompat="@drawable/vk_icon_google_pay_logo"/>
    </LinearLayout>
    <ImageView
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/vk_pay_checkout_googlepay_button_overlay"/>
</RelativeLayout>
