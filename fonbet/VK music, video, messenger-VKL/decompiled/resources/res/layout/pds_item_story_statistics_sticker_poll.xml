<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="17dp"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Title3"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/subtitle_privacy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3.5dp"
        android:text="@string/story_statistics_stickers_poll_subtitle_public"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/subtitle_gap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="·"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle_privacy"
        app:layout_constraintStart_toEndOf="@+id/subtitle_privacy"
        app:layout_constraintTop_toTopOf="@+id/subtitle_privacy"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.userstack.VkUserStack
        android:id="@+id/subtitle_photo_stack"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle_privacy"
        app:layout_constraintStart_toEndOf="@+id/subtitle_gap"
        app:layout_constraintTop_toTopOf="@+id/subtitle_privacy"
        app:vkAvatarSize="small"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/subtitle_votes_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle_privacy"
        app:layout_constraintStart_toEndOf="@+id/subtitle_photo_stack"
        app:layout_constraintTop_toTopOf="@+id/subtitle_privacy"
        style="@style/VkUiTypography.Footnote"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/options_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle_privacy"/>
</androidx.constraintlayout.widget.ConstraintLayout>
