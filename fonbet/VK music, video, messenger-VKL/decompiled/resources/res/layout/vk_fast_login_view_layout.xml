<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="visible"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/vk_ui_icon_medium"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.auth.ui.fastlogin.VkConnectInfoHeader
                android:id="@+id/info_header"
                android:paddingBottom="19dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>
            <com.vk.auth.ui.fastlogin.StickyRecyclerView
                android:layout_gravity="center_horizontal"
                android:id="@+id/users_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/titles_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp">
                <TextView
                    android:textAppearance="@style/VkUiTypography.Headline1Medium"
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.SubheadNormal"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/input_fields_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <com.vk.auth.ui.VkAuthExtendedEditText
                    android:textColor="?attr/vk_ui_text_primary"
                    android:textColorHint="?attr/vk_ui_text_secondary"
                    android:background="@drawable/vk_ui_auth_bg_edittext_stated_with_error_landing"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="@string/vk_auth_mail_or_login"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:importantForAutofill="no"
                    app:vk_error_stated_edit_text_id="@+id/enter_email_or_phone"/>
                <com.vk.auth.ui.VkAuthPhoneView
                    android:id="@+id/enter_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:vk_hide_country_field="true"/>
            </FrameLayout>
            <TextView
                android:textColor="?attr/vk_ui_text_negative"
                android:id="@+id/error_incorrect_login_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vk_auth_login_not_found"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/VkUiTypography.FootnoteNormal"/>
            <TextView
                android:textColor="?attr/vk_ui_text_negative"
                android:id="@+id/error_incorrect_login_subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vk_auth_login_not_found_try_again"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/VkUiTypography.FootnoteNormal"/>
            <com.vk.auth.ui.VkLoadingButton
                android:textColor="?attr/vk_ui_text_contrast_themed"
                android:id="@+id/login_btn"
                android:background="?attr/vk_ui_background_accent_themed"
                android:layout_marginTop="16dp"
                android:text="@string/vk_auth_account_continue"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:vk_lb_text_appearance="@style/VkUiTypography.Headline1Medium"
                app:vk_lb_use_vk_ui="true"
                style="@style/VKID.View.Button"/>
            <com.vk.auth.ui.VkExternalServiceLoginButton
                android:id="@+id/fast_login_secondary_auth"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </FrameLayout>
    <com.vk.auth.ui.VkAuthTextView
        android:textAppearance="@style/VkUiTypography.Headline1Medium"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:ellipsize="end"
        android:id="@+id/use_alternative_auth_btn"
        android:background="?attr/vk_ui_background_secondary_alpha"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_use_another_account"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/VKID.View.Button"/>
    <com.vk.auth.ui.VkAuthTextView
        android:textAppearance="@style/VkUiTypography.Headline1Medium"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:ellipsize="end"
        android:id="@+id/create_account_btn"
        android:background="?attr/vk_ui_background_secondary_alpha"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_create_account"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/VKID.View.Button"/>
    <com.vk.auth.ui.VkAuthTextView
        android:textAppearance="@style/VkUiTypography.Headline1Medium"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:ellipsize="end"
        android:id="@+id/another_way_auth"
        android:background="?attr/vk_ui_background_secondary_alpha"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_another_way_to_log_in"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/VKID.View.Button"/>
    <com.vk.auth.ui.VkOAuthContainerView
        android:id="@+id/fast_login_layout_oauth_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:vk_headerText="@string/vk_connect_exteranl_login_header"/>
    <Button
        android:textAppearance="@style/VkUiTypography.Headline1Medium"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:ellipsize="end"
        android:id="@+id/fast_login_tertiary_btn"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/VKID.View.Button"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/help_button"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_help_button"
        android:layout_marginHorizontal="16dp"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/fast_login_sim_card_banner"
        android:background="@drawable/vk_simcard_banner_bg"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/vk_icon_warning_triangle_outline_20"
            app:tint="@color/vk_orange"/>
        <Space
            android:layout_width="12dp"
            android:layout_height="0dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vk_fast_login_sim_banner"
            style="@style/VkUiTypography.Footnote"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        layout="@layout/vk_terms_layout"/>
</merge>
