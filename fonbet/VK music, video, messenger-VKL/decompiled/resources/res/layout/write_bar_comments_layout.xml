<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/comments_layout_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/comment_disable_text"
        android:background="?attr/colorPrimaryDark"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/comment_restriction_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:layout_marginStart="12dp"
            app:srcCompat="@drawable/vk_icon_privacy_circle_fill_purple_32"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_restriction_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/vk_roboto_regular"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="16dp"
            style="@style/VkLegacyTypography.Text"/>
    </FrameLayout>
    <View
        android:id="@+id/comment_restriction_attach_divider"
        android:background="?attr/vk_legacy_separator_alternate"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"/>
</LinearLayout>
