<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shimmer_layout"
    android:layout_width="70dp"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/icon"
        android:background="@drawable/vk_bg_skeleton_round_v3"
        android:layout_width="48dp"
        android:layout_height="48dp"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/app_title"
        android:background="@drawable/vk_bg_skeleton_v3_2dp"
        android:layout_width="56dp"
        android:layout_height="10dp"
        android:layout_marginTop="60dp"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/app_subtitle"
        android:background="@drawable/vk_bg_skeleton_v3_2dp"
        android:layout_width="40dp"
        android:layout_height="10dp"
        android:layout_marginTop="74dp"/>
</com.vk.core.view.shimmer.ShimmerFrameLayout>
