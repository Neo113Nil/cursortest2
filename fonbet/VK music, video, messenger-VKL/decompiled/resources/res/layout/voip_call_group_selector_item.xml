<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_highlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.voip.ui.avatars.VoipAvatarViewContainer
        android:id="@+id/call_group_selector_item_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAvatarSize="48dp"/>
    <ImageView
        android:id="@+id/call_user_selector_item_icon"
        android:background="@drawable/bg_icon_round_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/call_group_selector_item_avatar"
        app:layout_constraintEnd_toEndOf="@+id/call_group_selector_item_avatar"
        app:layout_constraintStart_toStartOf="@+id/call_group_selector_item_avatar"
        app:layout_constraintTop_toTopOf="@+id/call_group_selector_item_avatar"
        app:tint="?attr/vk_ui_icon_medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/call_group_selector_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/call_group_selector_item_check_icon"
        app:layout_constraintStart_toEndOf="@+id/call_group_selector_item_avatar"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <ImageView
        android:id="@+id/call_group_selector_item_check_icon"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/vk_icon_check_circle_on_28"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
