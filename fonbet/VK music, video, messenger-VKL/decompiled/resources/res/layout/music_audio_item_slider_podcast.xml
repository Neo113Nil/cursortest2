<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/background_container"
    android:background="@drawable/bg_podcast_episodes_slider"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="310dp"
    android:maxHeight="120dp">
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/audio_image"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="8dp"
        app:tiv_background_image="?attr/vk_ui_image_placeholder"
        app:tiv_border_width="0.5dp"
        app:tiv_empty_resource="@drawable/vk_icon_song_outline_28"
        app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
    <ImageView
        android:id="@+id/audio_fave"
        android:background="@drawable/highlight_circle"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/catalog_fave_button_24dp"
        android:scaleType="center"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vk_white_alpha60"
        app:tintMode="src_in"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/audio_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:translationY="-1.05sp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/audio_subtitle_container"
        app:layout_constraintEnd_toStartOf="@+id/audio_fave"
        app:layout_constraintStart_toEndOf="@+id/audio_image"
        app:layout_constraintTop_toTopOf="@+id/audio_image"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/audio_subtitle_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/audio_title"
        app:layout_constraintTop_toBottomOf="@+id/audio_title">
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="@color/vk_gray_400"
            android:gravity="center_vertical"
            android:id="@+id/audio_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:singleLine="true"
            app:vk_layout_isFluid="true"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="@color/vk_gray_400"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:text=" · "
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="@color/vk_gray_400"
            android:gravity="center"
            android:id="@+id/audio_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:translationY="-0.65sp"/>
        <View
            android:id="@+id/explicit"
            android:background="@drawable/vk_icon_error_circle_fill_gray_12"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="0.5dp"
            android:layout_marginStart="2.5dp"
            android:backgroundTint="?attr/vk_ui_icon_tertiary"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="@color/vk_white_alpha60"
        android:id="@+id/lucky_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:minHeight="16dp"
        android:maxLines="2"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/audio_title"
        app:layout_constraintTop_toBottomOf="@+id/audio_title"/>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/audio_listen_button"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:foreground="?attr/selectableItemBackground"
        android:minWidth="112dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:icon="@drawable/vk_icon_play_16"
        app:layout_constraintBottom_toBottomOf="@+id/audio_image"
        app:layout_constraintStart_toStartOf="@+id/audio_title"
        app:text="@string/podcast_play"/>
</androidx.constraintlayout.widget.ConstraintLayout>
