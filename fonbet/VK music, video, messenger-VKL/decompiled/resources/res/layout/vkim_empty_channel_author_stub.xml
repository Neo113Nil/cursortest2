<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/channel_onboarding_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/illustration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_illustration_success_64h"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Title2Medium"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/onboarding_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/vkm_empty_channel_title"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/illustration"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1Normal"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:gravity="center"
        android:id="@+id/onboarding_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/music_image_corners_8"
        android:text="@string/vkm_empty_channel_subtitle"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/onboarding_title"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/icon_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="28dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/text_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="68dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/text_end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="28dp"/>
    <View
        android:id="@+id/add_description_backgroud"
        android:background="@drawable/bg_empty_channel_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-12dp"
        android:layout_marginBottom="-8dp"
        app:layout_constraintBottom_toBottomOf="@+id/add_description_button"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/onboarding_subtitle"
        app:layout_constraintTop_toTopOf="@+id/add_description_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/add_description_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="@+id/icon_guideline"
        app:layout_constraintTop_toTopOf="@+id/add_description_title"
        app:srcCompat="@drawable/vk_icon_list_add_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.HeadlineMedium"
        android:id="@+id/add_description_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/vkm_empty_channel_add_description_title"
        app:layout_constraintEnd_toEndOf="@+id/text_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/text_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/onboarding_subtitle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.SubheadNormal"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/add_description_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/text_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/text_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/add_description_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:gravity="center_vertical"
        android:id="@+id/add_description_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vkm_empty_channel_add"
        android:layout_marginStart="-8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintStart_toStartOf="@+id/text_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/add_description_subtitle"/>
    <View
        android:id="@+id/share_link_backgroud"
        android:background="@drawable/bg_empty_channel_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-12dp"
        android:layout_marginBottom="-8dp"
        app:layout_constraintBottom_toBottomOf="@+id/share_link_button"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toTopOf="@+id/share_link_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/share_link_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="@+id/icon_guideline"
        app:layout_constraintTop_toBottomOf="@+id/add_description_button"
        app:srcCompat="@drawable/vk_icon_share_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.HeadlineMedium"
        android:id="@+id/share_link_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vkm_empty_channel_share_link_title"
        app:layout_constraintEnd_toEndOf="@+id/text_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/text_start_guideline"
        app:layout_constraintTop_toTopOf="@+id/share_link_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.SubheadNormal"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/share_link_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vkm_empty_channel_share_link_subtitile"
        app:layout_constraintEnd_toEndOf="@+id/text_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/text_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/share_link_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:gravity="center_vertical"
        android:id="@+id/share_link_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vkm_empty_channel_share"
        android:layout_marginStart="-8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintStart_toStartOf="@+id/text_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/share_link_subtitle"/>
    <View
        android:id="@+id/write_post_backgroud"
        android:background="@drawable/bg_empty_channel_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-12dp"
        app:layout_constraintBottom_toBottomOf="@+id/write_post_subtitle"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toTopOf="@+id/write_post_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/write_post_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="@+id/icon_guideline"
        app:layout_constraintTop_toBottomOf="@+id/share_link_button"
        app:srcCompat="@drawable/vk_icon_edit_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.HeadlineMedium"
        android:id="@+id/write_post_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vkm_empty_channel_write_first_message_title"
        app:layout_constraintEnd_toEndOf="@+id/text_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/text_start_guideline"
        app:layout_constraintTop_toTopOf="@+id/write_post_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.SubheadNormal"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/write_post_subtitle"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vkm_empty_channel_write_first_message_subtitle"
        app:layout_constraintEnd_toEndOf="@+id/text_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/text_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/write_post_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
