<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/UserMediumRoot">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/photo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:borderStrokeWidth="3dp"
        app:roundAvatarSize="48dp"
        style="@style/UserSmallPhoto"/>
    <TextView
        android:id="@+id/title"
        android:layout_marginEnd="60dp"
        style="@style/UserSmallTitle"/>
    <ImageView
        android:id="@+id/action"
        style="@style/UserMediumAction"/>
    <ImageView
        android:id="@+id/online"
        style="@style/Online.Small"/>
</RelativeLayout>
