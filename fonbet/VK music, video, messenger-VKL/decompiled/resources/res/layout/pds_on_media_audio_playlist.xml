<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pds_on_media_audio_root"
    android:layout_width="match_parent"
    android:layout_height="92dp">
    <com.vk.feed.design.view.newsfeed.overlay.VkOverlayCircleButton
        android:id="@+id/pds_on_media_audio_circle_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:id="@+id/pds_on_media_audio_badge_container_bang"
        android:background="@drawable/bg_half_rounded_8"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginBottom="-6dp"
        android:alpha="0.4"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="@color/vk_gray_800"
        app:layout_constraintBottom_toTopOf="@+id/pds_on_media_audio_song_badge_container"
        app:layout_constraintEnd_toEndOf="@+id/pds_on_media_audio_song_badge_container"
        app:layout_constraintStart_toStartOf="@+id/pds_on_media_audio_song_badge_container"/>
    <View
        android:id="@+id/pds_on_media_audio_song_badge_container"
        android:background="@drawable/bg_rounded_12"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.7"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="-12dp"
        android:backgroundTint="@color/vk_gray_800"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/pds_on_media_audio_wrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/pds_on_media_audio_song_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/accessibility_compact_attach_photo"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/pds_on_media_audio_song_badge_container"
        app:layout_constraintStart_toStartOf="@+id/pds_on_media_audio_song_badge_container"
        app:layout_constraintTop_toTopOf="@+id/pds_on_media_audio_song_badge_container"
        app:srcCompat="@drawable/vk_icon_music_12"/>
    <com.vk.feed.tool.view.newsfeed.music.OnMediaTitleWrapperView
        android:orientation="vertical"
        android:id="@+id/pds_on_media_audio_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/pds_on_media_audio_song_badge_container"
        app:layout_constraintEnd_toStartOf="@+id/pds_on_media_audio_circle_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/pds_on_media_audio_song_icon"
        app:layout_constraintTop_toTopOf="@+id/pds_on_media_audio_song_badge_container"
        app:layout_constraintVertical_chainStyle="packed">
        <com.vk.feed.tool.view.newsfeed.music.RunningLineTextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:id="@+id/pds_on_media_audio_song_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="8dp"
            style="@style/VkUiTypography.Caption1Medium"/>
        <com.vk.feed.tool.view.newsfeed.music.RunningLineTextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:id="@+id/pds_on_media_audio_song_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:paddingStart="8dp"
            style="@style/VkUiTypography.Caption1Medium"/>
    </com.vk.feed.tool.view.newsfeed.music.OnMediaTitleWrapperView>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="start|center_vertical"
        android:id="@+id/pds_on_media_audio_explicit_label"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_error_circle_12"
        android:scaleType="center"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/pds_on_media_audio_song_badge_container"
        app:layout_constraintEnd_toStartOf="@+id/pds_on_media_audio_button_add"
        app:layout_constraintTop_toTopOf="@+id/pds_on_media_audio_song_badge_container"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/pds_on_media_audio_button_add"
        android:padding="10dp"
        android:visibility="visible"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_add_20"
        android:scaleType="fitStart"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/pds_on_media_audio_song_badge_container"
        app:layout_constraintEnd_toEndOf="@+id/pds_on_media_audio_song_badge_container"
        app:layout_constraintTop_toTopOf="@+id/pds_on_media_audio_song_badge_container"
        app:tint="?attr/vk_ui_icon_contrast"/>
</androidx.constraintlayout.widget.ConstraintLayout>
