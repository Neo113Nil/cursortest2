<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stub_container"
    android:clipChildren="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="128dp"
    android:minHeight="128dp">
    <com.vk.core.view.fresco.VKEnhancedImageView
        android:layout_gravity="center"
        android:id="@+id/stub_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextSimple"
        android:layout_gravity="bottom|right"
        android:id="@+id/stub_time_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="12dp"/>
</FrameLayout>
