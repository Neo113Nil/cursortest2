<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="20dp"
    android:paddingBottom="28dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.stories.design.view.stickerbutton.SimpleIconStickerButton
        android:id="@+id/sticker_button_mention"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/sticker_button_title_mention"
        android:rotation="-1"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/sticker_button_location"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:stickerIcon="@drawable/vk_icon_mention_outline_24"
        app:stickerText="@string/sticker_button_title_mention"/>
    <com.vk.stories.design.view.stickerbutton.SimpleIconStickerButton
        android:id="@+id/sticker_button_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/sticker_button_title_location"
        android:rotation="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/sticker_button_mention"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sticker_button_mention"
        app:layout_constraintTop_toTopOf="@+id/sticker_button_mention"
        app:stickerIcon="@drawable/vk_icon_place_outline_24"
        app:stickerText="@string/sticker_button_title_location"/>
    <com.vk.stories.design.view.stickerbutton.PollStickerButton
        android:id="@+id/sticker_button_poll"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:rotation="1"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/sticker_button_opinion"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sticker_button_mention"/>
    <com.vk.stories.design.view.stickerbutton.OpinionStickerButton2
        android:id="@+id/sticker_button_opinion"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:rotation="-1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/sticker_button_poll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sticker_button_poll"
        app:layout_constraintTop_toBottomOf="@+id/sticker_button_mention"/>
    <com.vk.stories.design.view.stickerbutton.ImageStickerButton
        android:id="@+id/sticker_button_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:rotation="-1"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/sticker_button_reaction"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sticker_button_poll"
        app:stickerImage="@drawable/stories_track_cover_example_96h"
        app:stickerOverlay="@drawable/vk_icon_play_32"
        app:stickerTitle="@string/sticker_button_title_track"/>
    <com.vk.stories.design.view.stickerbutton.ReactionStickerButton
        android:id="@+id/sticker_button_reaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/sticker_button_music"
        app:layout_constraintEnd_toStartOf="@+id/sticker_button_photo"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/sticker_button_music"
        app:layout_constraintTop_toBottomOf="@+id/sticker_button_poll"/>
    <com.vk.stories.design.view.stickerbutton.ImageStickerButton
        android:id="@+id/sticker_button_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:rotation="1"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/sticker_button_music"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sticker_button_reaction"
        app:layout_constraintTop_toBottomOf="@+id/sticker_button_poll"
        app:stickerImage="@drawable/stories_photo_example_96h"
        app:stickerTitle="@string/sticker_button_title_photo"/>
    <com.vk.stories.design.view.stickerbutton.SimpleIconStickerButton
        android:id="@+id/sticker_button_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:contentDescription="@string/sticker_button_title_time"
        android:rotation="-3"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/sticker_button_link"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sticker_button_music"
        app:stickerIcon="@drawable/vk_icon_clock_outline_24"/>
    <com.vk.stories.design.view.stickerbutton.SimpleIconStickerButton
        android:id="@+id/sticker_button_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/sticker_button_title_link"
        android:rotation="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/sticker_button_time"
        app:layout_constraintEnd_toStartOf="@+id/sticker_button_hashtag"
        app:layout_constraintStart_toEndOf="@+id/sticker_button_time"
        app:layout_constraintTop_toTopOf="@+id/sticker_button_time"
        app:stickerIcon="@drawable/vk_icon_linked_24"
        app:stickerText="@string/sticker_button_title_link"/>
    <com.vk.stories.design.view.stickerbutton.SimpleIconStickerButton
        android:id="@+id/sticker_button_hashtag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/sticker_button_title_hashtag"
        android:rotation="-1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/sticker_button_time"
        app:layout_constraintEnd_toStartOf="@+id/sticker_button_product"
        app:layout_constraintStart_toEndOf="@+id/sticker_button_link"
        app:layout_constraintTop_toTopOf="@+id/sticker_button_time"
        app:stickerIcon="@drawable/vk_icon_hashtag_outline_24"
        app:stickerText="@string/sticker_button_title_hashtag"/>
    <com.vk.stories.design.view.stickerbutton.SimpleIconStickerButton
        android:id="@+id/sticker_button_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/sticker_button_title_product"
        android:rotation="3"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/sticker_button_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sticker_button_hashtag"
        app:layout_constraintTop_toTopOf="@+id/sticker_button_time"
        app:stickerIcon="@drawable/vk_icon_market_outline_24"/>
</androidx.constraintlayout.widget.ConstraintLayout>
