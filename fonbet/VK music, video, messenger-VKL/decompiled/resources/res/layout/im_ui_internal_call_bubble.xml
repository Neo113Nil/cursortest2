<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/im_ui_internal_call_bubble_root"
    android:background="@drawable/im_ui_internal_bg_radius_promo"
    android:padding="@dimen/vk_ui_spacing_size_m"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/im_ui_internal_call_babble_middle_icon"
        android:background="@drawable/im_ui_internal_bg_oval_stroke_1_5"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/im_ui_internal_call_babble_middle_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/im_ui_internal_call_babble_middle_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        style="@style/VkUiTypography.Headline2"/>
    <TextView
        android:id="@+id/im_ui_internal_call_babble_middle_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
        app:layout_constraintEnd_toStartOf="@+id/im_ui_internal_call_babble_middle_time"
        app:layout_constraintStart_toStartOf="@+id/im_ui_internal_call_babble_middle_title"
        app:layout_constraintTop_toBottomOf="@+id/im_ui_internal_call_babble_middle_title"
        app:layout_constraintWidth_default="wrap"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:id="@+id/im_ui_internal_call_babble_middle_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
        app:layout_constraintBottom_toBottomOf="@+id/im_ui_internal_call_babble_middle_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/im_ui_internal_call_babble_middle_subtitle"
        style="@style/VkUiTypography.Caption2"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/im_ui_internal_call_babble_bottom_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/vk_ui_button_small_height"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/im_ui_internal_call_babble_middle_subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
