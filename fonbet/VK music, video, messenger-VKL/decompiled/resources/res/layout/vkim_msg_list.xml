<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/msg_list"
        android:visibility="invisible"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="true"
        android:overScrollMode="never"/>
    <ViewStub
        android:id="@+id/bot_action_stub"
        android:layout="@layout/vkim_bot_snackbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.im.ui.views.msg.MsgStickyDateView
        android:textColor="?attr/vk_ui_vkontakte_im_service_message_text"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/msg_list_sticky_date"
        android:background="?attr/im_bg_sticky_date"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:singleLine="true"
        style="@style/VkUiTypography.Footnote"/>
    <ViewStub
        android:id="@+id/msg_skeleton_view_viewstub"
        android:layout="@layout/vkim_msg_list_skeleton_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/msg_skeleton_redesign_view_viewstub"
        android:layout="@layout/vkim_msg_list_skeleton_layout_redesign"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/progress_viewstub"
        android:layout="@layout/vkim_msg_list_progress_layout"
        android:layout_width="48dp"
        android:layout_height="48dp"/>
    <com.vk.core.view.OverSizeChildLayout
        android:id="@+id/empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:oscl_gravityFitSize="center"
        app:oscl_gravityOverSize="bottom|center_horizontal"
        app:oscl_limitSizeByHeight="false"
        app:oscl_limitSizeByWidth="true"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/empty_placeholder_stub"
        android:layout="@layout/vkim_msg_list_empty_placeholder_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl"/>
    <LinearLayout
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:id="@+id/scroll_to_item_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="56dp"
        android:layout_height="wrap_content">
        <ViewStub
            android:layout_gravity="end|bottom"
            android:id="@+id/scroll_to_reaction_view_stub"
            android:paddingBottom="8dp"
            android:layout="@layout/vkim_msg_list_scroll_to_bottom_layout"
            android:inflatedId="@+id/scroll_to_reaction"
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
        <ViewStub
            android:layout_gravity="end|bottom"
            android:id="@+id/scroll_to_mention_view_stub"
            android:paddingBottom="8dp"
            android:layout="@layout/vkim_msg_list_scroll_to_bottom_layout"
            android:inflatedId="@+id/scroll_to_mention"
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
        <ViewStub
            android:layout_gravity="end|bottom"
            android:id="@+id/scroll_to_bottom_view_stub"
            android:paddingBottom="8dp"
            android:layout="@layout/vkim_msg_list_scroll_to_bottom_layout"
            android:inflatedId="@+id/scroll_to_bottom"
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
    </LinearLayout>
    <com.vk.im.reactions.api.BigReactionAnimationsView
        android:id="@+id/big_reaction_animations"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/float_reactions_picker"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60dp"
        android:layout_marginRight="8dp"
        android:elevation="3dp"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
