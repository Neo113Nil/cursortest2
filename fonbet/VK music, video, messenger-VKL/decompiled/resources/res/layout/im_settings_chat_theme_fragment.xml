<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/vk_im_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VKAppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/vk_im_toolbar"
            app:layout_scrollFlags="noScroll"
            app:title="@string/vkim_settings_theme"
            style="@style/VkIm.Toolbar.Style.LargeWithBack"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.vk.core.view.fresco.VKEnhancedImageView
        android:id="@+id/dialog_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:imageScaleType="center_crop"
        app:layout_constraintBottom_toBottomOf="@+id/vkim_chat_preview_container"
        app:layout_constraintEnd_toEndOf="@+id/vkim_chat_preview_container"
        app:layout_constraintStart_toStartOf="@+id/vkim_chat_preview_container"
        app:layout_constraintTop_toTopOf="@+id/vkim_chat_preview_container"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/vkim_chat_preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/vkim_background_chooser_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_im_appbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vkim_theme_global_set_warning"
        android:background="?attr/colorPrimary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="52dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_im_appbar">
        <View
            android:background="?attr/vk_legacy_separator_common"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/vkim_theme_warning_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/vk_icon_error_circle_outline_28"
            android:importantForAccessibility="no"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_legacy_dynamic_orange"/>
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/vkim_theme_warning_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/vkim_chat_theme_warning"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/vkim_theme_warning_dismiss"
            app:layout_constraintStart_toEndOf="@+id/vkim_theme_warning_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkLegacyTypography.Subhead1.Primary"/>
        <ImageView
            android:id="@+id/vkim_theme_warning_dismiss"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/vk_icon_dismiss_24"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_legacy_icon_outline_medium"/>
        <View
            android:background="?attr/vk_legacy_separator_common"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/vkim_background_chooser_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/vkim_stickers_popup_animation_autoplay_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vkim_chat_preview_container"/>
    <FrameLayout
        android:id="@+id/vkim_stickers_popup_animation_autoplay_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vkim_background_chooser_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
