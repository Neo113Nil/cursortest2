<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/post_side_padding">
        <TextView
            android:textAppearance="@style/VkUiTypography.Text"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            style="@style/TextStyle"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:id="@+id/badge"
            android:background="@drawable/catalog_header_badge_prominent"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:minWidth="20dp"
            android:singleLine="true"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            style="@style/VkUiTypography.SubheadNormal"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.ParagraphNormal"
        android:textColor="?attr/vk_ui_text_accent"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/show_all_btn"
        android:background="@drawable/music_playlist_selectable_bg_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/catalog_button_show_all"
        android:layout_marginEnd="16dp"/>
</FrameLayout>
