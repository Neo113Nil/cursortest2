<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="182dp"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingVertical="16dp">
    <TextView
        android:textColor="@color/vk_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sticker_music_only_music_title"
        android:textAlignment="center"
        style="@style/VkUiTypography.Headline"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/sticker_music_only_music_description"
        android:alpha="0.6"
        android:textAlignment="center"
        style="@style/VkUiTypography.Caption1"/>
</LinearLayout>
