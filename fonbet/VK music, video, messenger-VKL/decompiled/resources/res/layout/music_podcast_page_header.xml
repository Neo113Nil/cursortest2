<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlist_header_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/music_playlist_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/music_playlist_header_gradient"
        android:layout_width="match_parent"
        android:layout_height="112dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.music.view.ThumbsImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/playlist_foreground_image"
            android:focusable="true"
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:elevation="5dp"
            app:roundedCornerRadius="@dimen/music_playlist_corner_radius"
            app:tiv_background_image="?attr/vk_ui_background_content"
            app:tiv_placeholder_resource="@drawable/vk_icon_podcast_48"
            app:tiv_placeholder_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/playlist_title"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="2"
            android:textAlignment="gravity"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VkUiTypography.Headline1"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/playlist_owner_text"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            style="@style/VkUiTypography.Subhead"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/buttons_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/subscribe_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonAppearance="accent"
                app:buttonMode="primary"
                app:buttonSizeType="medium"/>
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/notifications_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:buttonAppearance="accent"
                app:buttonMode="secondary"
                app:buttonSizeType="medium"/>
        </LinearLayout>
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/friends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:minHeight="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:textColor="?attr/vk_ui_text_subhead"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/friends_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="30dp"
                android:maxLines="2"
                app:vk_layout_isFluid="true"
                style="@style/VkUiTypography.Subhead"/>
            <com.vk.core.view.PhotoStripView
                android:layout_gravity="center_vertical"
                android:id="@+id/friends_photos"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="@dimen/music_podcasts_separator_side_margin"
        android:layout_marginEnd="@dimen/music_podcasts_separator_side_margin"/>
</FrameLayout>
