<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_view_holder"
    android:background="@drawable/market_all_reviews_item_view_holder_background"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/community_photo_iv"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/vk_icon_avatar_placeholder_anonim_150"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/community_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/community_photo_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/community_photo_iv"
        app:layout_constraintTop_toTopOf="@+id/community_photo_iv"
        style="@style/VkUiTypography.Headline1Normal"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/header_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="community_name_tv, community_photo_iv"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/delete_review_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/market_all_reviews_review_is_deleted"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/community_photo_iv"
        app:layout_constraintTop_toBottomOf="@+id/community_photo_iv"
        style="@style/VkUiTypography.Paragraph"/>
    <TextView
        android:textColor="?attr/vk_ui_text_link"
        android:id="@+id/restore_review_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/market_all_reviews_restore_review_action"
        android:layout_marginStart="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/delete_review_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/delete_review_message"
        style="@style/VkUiTypography.ParagraphMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
