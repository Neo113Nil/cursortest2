<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
        android:id="@+id/stub_items_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/vk_expandable_menu_bg_stub_4"
            android:layout_width="@dimen/vk_expandable_menu_item_stub_title_width"
            android:layout_height="@dimen/vk_expandable_menu_item_stub_title_height"
            android:layout_marginTop="14dp"
            android:layout_marginStart="12dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stub_items_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:layout_marginBottom="@dimen/vk_expandable_menu_item_indicator_height"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <View
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/vk_expandable_menu_bg_stub_4"
            android:layout_width="@dimen/vk_expandable_menu_item_indicator_size"
            android:layout_height="@dimen/vk_expandable_menu_item_indicator_size"
            android:layout_marginBottom="@dimen/vk_expandable_menu_item_indicator_mid"/>
        <View
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/vk_expandable_menu_bg_stub_4"
            android:layout_width="@dimen/vk_expandable_menu_item_indicator_size"
            android:layout_height="@dimen/vk_expandable_menu_item_indicator_size"
            android:layout_marginBottom="@dimen/vk_expandable_menu_item_indicator_mid"
            android:layout_marginStart="@dimen/vk_expandable_menu_item_indicator_mid"/>
        <View
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/vk_expandable_menu_bg_stub_4"
            android:layout_width="@dimen/vk_expandable_menu_item_indicator_size"
            android:layout_height="@dimen/vk_expandable_menu_item_indicator_size"
            android:layout_marginBottom="@dimen/vk_expandable_menu_item_indicator_mid"
            android:layout_marginEnd="@dimen/vk_expandable_menu_item_indicator_mid"/>
    </com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
</LinearLayout>
