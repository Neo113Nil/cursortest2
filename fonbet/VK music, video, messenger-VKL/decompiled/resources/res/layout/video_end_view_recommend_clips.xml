<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:theme="@style/VkLegacyTypography.Title3.Regular"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/video_add_as_clip_tip"
        android:singleLine="false"
        android:layout_marginHorizontal="32dp"/>
    <TextView
        android:theme="@style/VkLegacyTypography.Text.Medium"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/video_add_as_clip"
        android:background="@drawable/vkui_bg_button_white20"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:text="@string/video_add_as_clip"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"/>
    <TextView
        android:theme="@style/VkLegacyTypography.Text.Medium"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/video_keep_watching"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="@string/video_end_view_continue"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"/>
</merge>
