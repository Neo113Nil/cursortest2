<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/music_recommendation_onboarding_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:outlineProvider="none"
        app:elevation="0dp"
        app:layout_behavior="com.vk.music.onboarding.impl.behavior.DisableableAppBarLayoutBehavior">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/music_recommendation_onboarding_collapsing_layout"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:outlineProvider="none"
            app:elevation="0dp"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/music_recommendation_onboarding_header"
                    android:paddingTop="?attr/actionBarSize"
                    android:paddingBottom="48dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textAppearance="?attr/vk_ui_typography_display_title1"
                        android:textColor="@color/vk_ui_text_title_color"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/music_recommendation_onboarding_header_title"/>
                    <TextView
                        android:textAppearance="?attr/vk_ui_typography_headline1_normal"
                        android:textColor="?attr/vk_ui_text_secondary"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/music_recommendation_onboarding_header_subtitle"/>
                </LinearLayout>
                <View
                    android:id="@+id/music_recommendation_onboarding_toolbar"
                    android:background="?attr/vk_ui_background_content"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:layout_scrollFlags="snap|enterAlways|scroll"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <com.vk.core.view.components.search.VkSearchView
        android:id="@+id/music_recommendation_onboarding_search"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:layout_anchor="@+id/music_recommendation_onboarding_appbar"
        app:layout_behavior="com.vk.music.onboarding.impl.behavior.SearchFieldToToolbarBehavior"/>
    <com.vk.lists.RecyclerPaginatedView
        android:id="@+id/music_recommendation_onboarding_content_recycler_view"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_anchor="@+id/music_recommendation_onboarding_search"
        app:layout_anchorGravity="bottom"
        app:layout_behavior="com.vk.music.onboarding.impl.behavior.RecyclerViewScrollWithSearchFieldBehavior"
        app:vk_enableItemAnimations="true"
        app:vk_errorFitCenter="true"/>
    <com.vk.lists.RecyclerPaginatedView
        android:id="@+id/music_recommendation_onboarding_search_recycler_view"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_anchor="@+id/music_recommendation_onboarding_search"
        app:layout_anchorGravity="bottom"
        app:layout_behavior="com.vk.music.onboarding.impl.behavior.RecyclerViewScrollWithSearchFieldBehavior"
        app:vk_enableItemAnimations="true"
        app:vk_errorFitCenter="true"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="68dp">
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/music_recommendation_onboarding_save"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/music_recommendation_onboarding_continue"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </FrameLayout>
    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/music_recommendation_onboarding_process_layout"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutDescription="@xml/music_recommendation_onboarding_scene"
        app:layout_anchor="@+id/music_recommendation_onboarding_search"
        app:layout_anchorGravity="bottom">
        <TextView
            android:textAppearance="?attr/vk_ui_typography_title2"
            android:textColor="@color/vk_ui_text_title_color"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/music_recommendation_onboarding_process_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="62dp"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/music_recommendation_onboarding_process_image"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/music_recommendation_onboarding_process_image_finish"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"/>
        <TextView
            android:textAppearance="?attr/vk_ui_typography_display_title1_semi_bold"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:id="@+id/music_recommendation_onboarding_process_text_finish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/music_recommendation_onboarding_process_finish_title"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/music_recommendation_onboarding_wave_image"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="248dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/music_recommendation_onboarding_process_recycler"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_anim_slide_up"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:translationX="-55dp"
            android:translationY="-15dp"
            android:scrollIndicators="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_recommendation_onboarding_wave_image"
            app:stackFromEnd="true"/>
    </androidx.constraintlayout.motion.widget.MotionLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="0dp"
        android:outlineProvider="none">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/music_recommendation_onboarding_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="center"
            android:contentDescription="@string/close"
            android:elevation="5dp"
            app:srcCompat="@drawable/vk_icon_cancel_24"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
