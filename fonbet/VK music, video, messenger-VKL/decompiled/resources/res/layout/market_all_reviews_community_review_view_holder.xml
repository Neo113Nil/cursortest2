<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_view_holder"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/community_photo_iv"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/review_action_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/community_photo_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/community_photo_iv"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/community_name_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/review_action_button"
        app:layout_constraintStart_toEndOf="@+id/community_photo_iv"
        app:layout_constraintTop_toTopOf="@+id/community_photo_iv"
        style="@style/VkUiTypography.Headline1Normal"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/header_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="community_name_tv, community_photo_iv, rating_bar, rating_description_tv"/>
    <com.vk.core.view.components.rating.VkStaticRatingBar
        android:id="@+id/rating_bar"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="yes"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/community_photo_iv"
        app:layout_constraintStart_toEndOf="@+id/community_photo_iv"
        app:layout_constraintTop_toBottomOf="@+id/community_name_tv"
        app:rating_size="small"/>
    <TextView
        android:textColor="?attr/vk_ui_text_tertiary"
        android:id="@+id/rating_description_tv"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/market_all_reviews_community_review_description"
        android:contentDescription="@string/market_all_reviews_community_review_description_access"
        android:alpha="0.8"
        android:paddingStart="1dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/rating_bar"
        app:layout_constraintEnd_toStartOf="@+id/review_action_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/rating_bar"
        app:layout_constraintTop_toTopOf="@+id/rating_bar"
        style="@style/VkUiTypography.Footnote"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/community_attache_images_rv"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingEnd="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/community_photo_iv"/>
    <com.vk.core.view.ExpandableTextViewGroup
        android:id="@+id/review_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/community_attache_images_rv"
        style="@style/VkUiTypography.TextNormal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/published_review_status_tv"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="yes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/review_tv"
        app:layout_goneMarginTop="16dp"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/edit_review_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/market_all_reviews_community_view_holder_edit_action"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/published_review_status_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
