<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/qr_code_auth_title"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vk_qr_code_auth_title"
        android:contentDescription="@string/vk_qr_code_auth_title_accessibility"
        android:accessibilityHeading="true"
        style="?attr/vk_ui_typography_title2_bold"/>
    <include
        android:id="@+id/qr_code_auth_account_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        layout="@layout/vk_qr_code_auth_account_row"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/qr_code_auth_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="@style/VKID.Text.DisplayTitle1.QrCodeAuthCode"/>
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:background="@drawable/vk_qr_code_auth_warning_background"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/vk_icon_error_shield_filled_yellow_20"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vk_qr_code_auth_warning_text"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="?attr/vk_ui_typography_paragraph"/>
    </LinearLayout>
</LinearLayout>
