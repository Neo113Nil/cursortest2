<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlight"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/subscription_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/subscription_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/payed_date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/subscription_icon"
        app:layout_constraintTop_toTopOf="@+id/subscription_icon"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/payed_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/subscription_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/subscription_icon"
        app:layout_constraintTop_toBottomOf="@+id/subscription_title"
        style="@style/VkUiTypography.Footnote"/>
</androidx.constraintlayout.widget.ConstraintLayout>
