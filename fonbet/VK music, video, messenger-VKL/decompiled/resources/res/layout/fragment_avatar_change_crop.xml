<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/avatar_crop_back_btn"
        android:background="@drawable/highlight_circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_legacy_ic_back_collapse_header"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_back"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="23sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/avatar_crop_title"
        android:fontFamily="@font/vk_sans_display_demibold"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_crop_back_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatar_crop_back_btn"
        app:layout_constraintTop_toTopOf="@+id/avatar_crop_back_btn"
        style="@style/ToolbarTitle"/>
    <com.vk.crop.CropImageView
        android:id="@+id/avatar_crop_crop_image_view"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:civ_circleCrop="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_crop_back_btn"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.Headline2Normal"
        android:textColor="@color/white_opacity40"
        android:gravity="center"
        android:id="@+id/avatar_crop_subtitle_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/avatar_crop_subtitle"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_crop_back_btn"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/avatar_crop_preview_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_crop_subtitle_text">
        <com.vk.avatarchange.CropAvatarView
            android:id="@+id/avatar_crop_preview_image"
            android:layout_width="@dimen/avatar_crop_preview_size"
            android:layout_height="@dimen/avatar_crop_preview_size"
            android:contentDescription="@string/accessibility_zoomable_image"
            android:layout_marginStart="22dp"
            app:borderStrokeWidth="2dp"
            app:contourOverlayEnabled="true"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="@style/VkUiTypography.Headline2Normal"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/avatar_crop_username_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="@style/VkUiTypography.Caption1"
                android:textColor="@color/white_opacity40"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avatar_crop_sample"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/avatar_crop_continue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/avatar_crop_continue"
        android:singleLine="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
