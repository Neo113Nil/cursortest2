<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/post_sticker_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.stories.design.view.stickers.photo.PhotoWithCaptionViewGroup
        android:orientation="vertical"
        android:id="@+id/post_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/post_sticker_attachment_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.stories.design.view.stickers.post.PostAuthorView
            android:id="@+id/post_sticker_author"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/post_sticker_text"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            style="@style/VkUiTypography.Subhead"/>
    </com.vk.stories.design.view.stickers.photo.PhotoWithCaptionViewGroup>
    <com.vk.stories.design.view.stickers.MetaHeaderLinearLayout
        android:orientation="vertical"
        android:id="@+id/meta_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/meta_author_name"
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:shadowColor="@color/vk_black_alpha35"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:paddingHorizontal="64dp"
            style="@style/VkUiTypography.SubheadSemiBold"/>
        <com.vk.stories.design.view.stickers.post.PostAuthorView
            android:id="@+id/meta_subtitle"
            android:paddingTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="64dp"/>
    </com.vk.stories.design.view.stickers.MetaHeaderLinearLayout>
</FrameLayout>
