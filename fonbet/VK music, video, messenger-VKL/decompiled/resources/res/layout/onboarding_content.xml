<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/followers_mode_onboarding_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/image"
        style="@style/VkUiTypography.DisplayTitle2Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/followers_mode_onboarding_description"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkUiTypography.DisplayTitle4Normal"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/promo_text_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/followers_mode_promo_text_1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/promo_text_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/promo_icon_1"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/promo_text_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/followers_mode_promo_text_2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/promo_text_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/promo_icon_2"
        app:layout_constraintTop_toBottomOf="@+id/promo_text_1"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/promo_text_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/followers_mode_promo_text_3"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/promo_icon_3"
        app:layout_constraintTop_toBottomOf="@+id/promo_text_2"
        style="@style/VkUiTypography.Headline1Normal"/>
    <ImageView
        android:id="@+id/promo_icon_1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_add_square_outline_24"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/promo_text_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/promo_text_1"
        style="@style/FollowersModeOnboardingPromoIcon"/>
    <ImageView
        android:id="@+id/promo_icon_2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_notification_slash_outline_24"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/promo_text_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/promo_text_2"
        style="@style/FollowersModeOnboardingPromoIcon"/>
    <ImageView
        android:id="@+id/promo_icon_3"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_picture_outline_24"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/promo_text_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/promo_text_3"
        style="@style/FollowersModeOnboardingPromoIcon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
