<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/picker_bg_attach_bottom_toolbar_shadow"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text.Unscaled"
        android:textColor="?attr/vk_ui_text_accent"
        android:gravity="center"
        android:id="@+id/group_picker_cancel_button"
        android:background="@drawable/sharing_white_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/sharing_cancel_button_label"
        android:textAllCaps="true"/>
</LinearLayout>
