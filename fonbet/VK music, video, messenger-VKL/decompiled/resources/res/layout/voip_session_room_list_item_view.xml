<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_gray_100"
        android:id="@+id/room_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="3"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="56dp"
        app:layout_constraintBottom_toTopOf="@+id/room_participants"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VoipSessionRoomList.Caption"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_gray_500"
        android:ellipsize="end"
        android:id="@+id/room_participants"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:lines="1"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/room_name"
        style="@style/VoipSessionRoomList.FootNote"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/selected_room_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_animated_check_circle_on_24"
        app:tint="?attr/vk_ui_icon_accent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
