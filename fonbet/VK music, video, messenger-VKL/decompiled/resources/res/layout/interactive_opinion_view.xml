<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="12dp"
        style="@style/VkUiTypography.DisplayTitle4"/>
    <com.vk.core.view.components.formitem.VkInputSelect
        android:textColor="@color/vk_black"
        android:id="@+id/editText"
        android:background="@drawable/bg_edittext_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="12dp"
        android:maxHeight="152dp"
        android:hint="@string/story_question_input_field_hint"
        android:maxLength="80"
        android:layout_marginHorizontal="12dp"
        style="@style/VkInput"/>
    <com.vk.stories.design.view.polls.VoteProgressButton
        android:id="@+id/buttonSend"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginHorizontal="12dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/privacyFooter"
        android:background="@drawable/privacy_ripple"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:drawablePadding="4dp"
        android:layout_marginVertical="4dp"
        app:drawableTint="?attr/vk_ui_icon_secondary"
        style="@style/VkUiTypography.Footnote"/>
</merge>
