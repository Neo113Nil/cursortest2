<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/music_bottom_actions_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <View
        android:layout_gravity="center"
        android:id="@+id/tongue"
        android:background="@drawable/music_track_menu_tongue"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/audio_bottom_sheet_header_remaining_time"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="47dp"
        style="@style/VkUiTypography.Footnote"/>
    <View
        android:id="@+id/top_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <include
        android:id="@+id/include"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/music_audio_item_actions_header"/>
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
</LinearLayout>
