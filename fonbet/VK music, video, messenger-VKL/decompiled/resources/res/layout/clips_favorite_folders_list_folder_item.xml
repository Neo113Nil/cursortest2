<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="9dp"
    android:layout_marginStart="9dp">
    <com.vk.clips.design.view.favorites.folder.ClipsFoldersCoverView
        android:id="@+id/favorite_folder_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:favoriteCoverEmptyIcon="@drawable/vk_icon_folder_outline_56"
        app:favoriteCoverSize="normal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/favorite_folder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:lines="1"
        android:layout_marginStart="3dp"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/favorite_folder_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        android:layout_marginStart="3dp"
        style="@style/VkUiTypography.Footnote"/>
</LinearLayout>
