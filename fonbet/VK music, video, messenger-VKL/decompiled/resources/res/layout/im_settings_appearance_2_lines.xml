<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/settings_chats_list_2_lines"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:paddingHorizontal="8dp">
    <FrameLayout
        android:id="@+id/settings_chats_list_2_stroke"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/bg_square_rounded_18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/settings_chats_list_2_circle_1"
                android:background="@drawable/bg_gray_circle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toTopOf="@+id/settings_chats_list_2_circle_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/settings_chats_list_2_circle_1_line_1"
                android:background="@drawable/bg_gray_square_rounded"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="42dp"
                app:layout_constraintBottom_toTopOf="@+id/settings_chats_list_2_circle_1_line_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/settings_chats_list_2_circle_1"
                app:layout_constraintTop_toTopOf="@+id/settings_chats_list_2_circle_1"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:id="@+id/settings_chats_list_2_circle_1_line_2"
                android:background="@drawable/bg_gray_square_rounded"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/settings_chats_list_2_circle_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/settings_chats_list_2_circle_1"
                app:layout_constraintTop_toBottomOf="@+id/settings_chats_list_2_circle_1_line_1"/>
            <View
                android:id="@+id/settings_chats_list_2_circle_2"
                android:background="@drawable/bg_gray_circle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/settings_chats_list_2_circle_1"/>
            <View
                android:id="@+id/settings_chats_list_2_circle_2_line_1"
                android:background="@drawable/bg_gray_square_rounded"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="42dp"
                app:layout_constraintBottom_toTopOf="@+id/settings_chats_list_2_circle_2_line_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/settings_chats_list_2_circle_2"
                app:layout_constraintTop_toTopOf="@+id/settings_chats_list_2_circle_2"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:id="@+id/settings_chats_list_2_circle_2_line_2"
                android:background="@drawable/bg_gray_square_rounded"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/settings_chats_list_2_circle_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/settings_chats_list_2_circle_2"
                app:layout_constraintTop_toBottomOf="@+id/settings_chats_list_2_circle_2_line_1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/settings_chats_list_2_lines_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vkim_settings_appearance_chats_list_2_lines"
        style="@style/VkLegacyTypography.Caption.Regular"/>
</LinearLayout>
