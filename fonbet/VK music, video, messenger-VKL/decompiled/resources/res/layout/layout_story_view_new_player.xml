<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/iv_image_preview_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <com.vk.story.viewer.impl.presentation.stories.view.storyview.VKImageViewCallbackWrapper
        android:id="@+id/iv_image_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <com.vk.media.player.video.view.PlaylistPlayerVideoView
        android:id="@+id/vv_video_preview"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/v_custom_view_anchor"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <com.vk.libvideo.design.view.seek.VideoFastSeekView
        android:id="@+id/story_fast_seek_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/back_gradient"
        android:background="@drawable/scrim_left_40percent"
        android:visibility="invisible"
        android:layout_width="88dp"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/gesture_handler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/pb_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        style="@style/Base.Widget.AppCompat.ProgressBar"/>
    <include layout="@layout/layout_error_story_view"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/top_gradient"
        android:background="@drawable/vk_gradient_top_112"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:alpha="0.24"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_gradient"
        android:background="@drawable/vk_gradient_bottom_112"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:alpha="0.24"/>
    <com.vk.stories.design.view.viewer.StoryViewHeader
        android:id="@+id/story_view_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textColor="@color/vk_white"
        android:gravity="start|center_vertical"
        android:layout_gravity="bottom"
        android:id="@+id/story_music_restriction_text"
        android:background="@drawable/bg_music_restriction_text"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="64dp"
        android:drawablePadding="14dp"
        android:drawableStart="@drawable/vk_icon_error_circle_outline_28"
        android:drawableTint="@color/vk_red"
        style="@style/VkUiTypography.Subhead"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_deleted"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_stories_viewer_deleted_72dp"/>
        <TextView
            android:textColor="@color/vk_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stories_author_deleted_story"
            android:singleLine="true"
            style="@style/VkUiTypography.SubheadMedium"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_private"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_stories_viewer_private_72dp"/>
        <TextView
            android:textColor="@color/vk_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stories_author_access_denied"
            android:singleLine="true"
            style="@style/VkUiTypography.SubheadMedium.Unscaled"/>
    </LinearLayout>
    <com.vk.stories.design.view.viewer.StoryBottomViewGroup
        android:layout_gravity="bottom"
        android:id="@+id/bottom_view_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.stories.design.view.viewer.StoryUploadIndicatorView
        android:layout_gravity="bottom"
        android:id="@+id/fl_upload_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_view_bottom_btn_height"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>
</merge>
