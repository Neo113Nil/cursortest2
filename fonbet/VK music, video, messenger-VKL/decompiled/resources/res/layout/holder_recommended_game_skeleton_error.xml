<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="230dp">
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recommendations_carousel_load_error"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/retry_load_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:gravity="center"
        android:id="@+id/retry_load_button"
        android:background="@drawable/ripple_10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/recommendations_carousel_retry_load"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toTopOf="@+id/separator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_title"
        style="@style/VkUiTypography.Headline2"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0.33dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
