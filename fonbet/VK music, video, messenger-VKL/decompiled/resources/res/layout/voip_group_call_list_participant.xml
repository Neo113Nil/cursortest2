<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/fl_render_container"
        android:background="@color/vk_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/bg_blurred_avatar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <com.vk.voip.ui.avatars.VoipAvatarViewContainer
        android:id="@+id/avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        app:actualImageScaleType="centerCrop"
        app:borderStrokeWidth="3dp"
        app:emptyImagePlaceholder="@drawable/ic_user_260"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:roundAvatarSize="48dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:id="@+id/connection_status"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toLeftOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_participant_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:minHeight="24dp"
        android:maxLines="1"
        android:shadowColor="@color/vk_black"
        android:shadowRadius="2"
        android:drawablePadding="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkLegacyTypography.Subhead1.Medium"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/pin_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="4dp"
        android:scaleType="center"
        android:importantForAccessibility="no"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/voip_pin_shadow_24"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hand_layout"
        android:background="#cc5c9ce6"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/vk_icon_privacy_outline_28"
        app:tint="@color/vk_white"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/reaction_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="6dp"
        android:scaleType="centerInside"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/border_overlay_holder"
        android:background="@drawable/voip_call_participant_border_default"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/border_speaking_holder"
        android:background="@drawable/voip_call_participant_border_speaking_10_radius"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/voip_participant_icons_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="12dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/watch_together_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/voip_participant_icons_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_participant_icons_guideline"
        app:srcCompat="@drawable/vk_icon_logo_vk_video_shadow_24"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/screen_capture_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/voip_participant_icons_guideline"
        app:layout_constraintStart_toEndOf="@+id/watch_together_icon"
        app:layout_constraintTop_toTopOf="@+id/voip_participant_icons_guideline"
        app:srcCompat="@drawable/vk_icon_arrow_up_rectangle_shadow_24"/>
</merge>
