<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="41dp"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2Normal"
        android:textColor="?attr/vk_ui_text_accent"
        android:gravity="start|center_vertical"
        android:layout_gravity="start|top"
        android:id="@+id/menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:drawablePadding="4dp"
        android:textAlignment="gravity"
        app:drawableEndCompat="@drawable/vk_icon_dropdown_16"
        app:drawableTint="?attr/vk_ui_icon_accent"/>
</FrameLayout>
