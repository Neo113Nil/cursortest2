<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/liveEndViewBack"
        android:background="@color/vk_black_alpha15"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/liveEndViewLinear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.imageloader.view.VKCircleImageView
            android:id="@+id/liveEndUserImage"
            android:layout_width="72dp"
            android:layout_height="72dp"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/liveEndText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/live_video_story_ended"
            android:maxLines="1"
            app:fontFamily="@font/vk_sans_display_demibold"/>
        <com.vk.core.view.links.LinkedTextView
            android:textColor="@color/vk_white"
            android:gravity="center_horizontal"
            android:id="@+id/liveEndUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="32dp"
            android:shadowColor="#52000000"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:fontFamily="@font/vk_sans_display_regular"
            style="@style/VkLegacyTypography.Subhead.Regular"/>
        <androidx.appcompat.widget.AppCompatButton
            android:gravity="center"
            android:id="@+id/liveEndStartSteamingButton"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/live_story_end_create_stream"
            style="@style/VkLegacyButton.White"/>
        <androidx.appcompat.widget.AppCompatButton
            android:gravity="center"
            android:id="@+id/liveEndShareButton"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/live_story_end_share_video"
            style="@style/VkLegacyButton.WhiteTransparent20"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/vk_white"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/liveEndWatchNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="16dp"
        android:text="@string/live_watch_next"
        android:shadowColor="#52000000"
        android:fontFamily="@font/vk_sans_text_medium"/>
</merge>
