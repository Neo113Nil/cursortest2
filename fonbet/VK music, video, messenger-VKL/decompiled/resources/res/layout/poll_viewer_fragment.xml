<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/appkit_poll_view_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/poll_viewer_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VKAppBar">
        <include layout="@layout/appkit_toolbar"/>
        <com.vk.core.view.AppBarShadowView
            android:id="@+id/poll_viewer_appbar_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.vk.core.view.components.paging.list.VkRecyclerPaginatedView
        android:id="@+id/poll_list"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/poll_viewer_appbar"
        app:layout_constraintStart_toStartOf="@+id/poll_viewer_appbar"
        app:layout_constraintTop_toBottomOf="@+id/poll_viewer_appbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
