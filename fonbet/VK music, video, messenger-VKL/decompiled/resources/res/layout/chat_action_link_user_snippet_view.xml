<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/live_chat_snippet_image"
        android:visibility="visible"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:actualImageScaleType="centerCrop"
        app:backgroundImage="@color/vk_white_alpha20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="8dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <ImageView
        android:id="@+id/live_chat_snippet_moderation_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/live_chat_snippet_image"
        app:layout_constraintEnd_toEndOf="@+id/live_chat_snippet_image"
        app:layout_constraintStart_toStartOf="@+id/live_chat_snippet_image"
        app:layout_constraintTop_toTopOf="@+id/live_chat_snippet_image"
        app:srcCompat="@drawable/vk_icon_hide_outline_28"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/live_chat_snippet_badge"
        android:background="@drawable/bg_rounded_6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="?attr/vk_ui_accent_red"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_chat_snippet_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/live_chat_snippet_title"
        app:layout_constraintTop_toTopOf="@+id/live_chat_snippet_title"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:id="@+id/live_chat_snippet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/live_chat_snippet_badge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/live_chat_snippet_image"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.ParagraphMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:id="@+id/live_chat_snippet_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/live_chat_snippet_image"
        app:layout_constraintTop_toBottomOf="@+id/live_chat_snippet_title"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginStart="0dp"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/live_chat_snippet_button"
        android:background="@drawable/live_chat_snippet_button_background"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:drawablePadding="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="12dp"
        app:drawableTint="?attr/vk_ui_icon_contrast"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/live_chat_snippet_image"
        style="@style/VkUiTypography.SubheadMedium"/>
</merge>
