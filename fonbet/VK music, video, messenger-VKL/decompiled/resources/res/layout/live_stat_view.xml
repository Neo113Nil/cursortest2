<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/live_viewers_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/live_stat_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.spinner.VkScreenSpinner
        android:layout_gravity="center"
        android:id="@+id/live_viewers_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:backgroundColorful="false"
        app:spinnerMode="dropdown"
        app:spinnerSize="medium"
        app:spinnerState="loading"/>
</merge>
