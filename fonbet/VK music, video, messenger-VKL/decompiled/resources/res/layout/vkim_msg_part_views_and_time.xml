<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="6dp"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="6dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_views_count_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="0.5dp"
        android:src="@drawable/vk_icon_view_12"
        android:contentDescription="@null"/>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Caption3.Regular"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:id="@+id/vkim_views_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkLegacyTypography.Caption3.Regular"
        android:layout_gravity="end"
        android:id="@+id/vkim_time_and_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
