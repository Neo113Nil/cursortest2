<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="360dp">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/personal_discount_new_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/close"
        android:layout_marginEnd="12dp"
        app:srcCompat="@drawable/vk_icon_cancel_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <FrameLayout
            android:id="@+id/personal_discount_new_head_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Title2"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/personal_discount_new_title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/personal_discount_new_subhead_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1CapsMedium"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/personal_discount_new_actual_time_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_apps_new_personal_discount_discount"/>
        <com.vk.superapp.browser.internal.ui.time.StaticTimerView
            android:layout_gravity="center"
            android:id="@+id/personal_discount_new_time_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/personal_discount_new_positive_view"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_apps_new_personal_discount_accept"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/personal_discount_new_negative_view"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:text="@string/vk_apps_new_personal_discount_decline"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:textColorHighlight="@android:color/transparent"
            android:textColorLink="?attr/vk_ui_text_link"
            android:gravity="center"
            android:id="@+id/personal_discount_new_rules_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_apps_new_personal_discount_rules"/>
    </LinearLayout>
</FrameLayout>
