<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/closed_profile_popup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/photo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/vk_icon_lock_outline_56"
            android:importantForAccessibility="no"
            app:placeholderImage="@drawable/user_placeholder"
            app:tint="?attr/vk_ui_icon_accent"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:paddingTop="0.5dp"
            android:paddingBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/followers_mode_not_enabled_message"
            android:paddingStart="@dimen/post_side_padding"
            android:paddingEnd="@dimen/post_side_padding"
            style="@style/VkUiTypography.Title2Medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:paddingTop="0.5dp"
            android:paddingBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/make_profile_open_message"
            android:paddingStart="@dimen/post_side_padding"
            android:paddingEnd="@dimen/post_side_padding"
            style="@style/VkUiTypography.Subhead"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/open_profile_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="32dp"
            android:text="@string/open_profile"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/dismiss_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/vk_icon_cancel_20"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_hide"
        app:tint="?attr/vk_ui_icon_secondary"/>
</merge>
