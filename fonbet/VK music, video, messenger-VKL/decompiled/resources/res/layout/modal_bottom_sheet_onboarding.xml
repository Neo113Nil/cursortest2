<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="24dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="24dp"/>
        <ImageView
            android:id="@+id/image_single"
            android:visibility="visible"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="32dp"
            android:scaleType="centerInside"
            android:contentDescription="@null"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_illustration_heart_80"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Title2Medium"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="2"
            app:layout_constraintBottom_toTopOf="@+id/text_description"
            app:layout_constraintEnd_toEndOf="@+id/guideline_end"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            app:layout_constraintTop_toBottomOf="@+id/image_single"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintVertical_chainStyle="packed"/>
        <com.vk.core.view.links.LinkedTextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:linksClickable="false"
            android:id="@+id/text_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="4"
            android:hyphenationFrequency="none"
            app:layout_constraintBottom_toTopOf="@+id/button_action"
            app:layout_constraintEnd_toEndOf="@+id/guideline_end"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            app:layout_constraintTop_toBottomOf="@+id/text_title"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:gravity="center"
            android:id="@+id/button_action"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/guideline_end"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            app:layout_constraintTop_toBottomOf="@+id/text_description"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.TextMedium"
            android:textColor="@color/vk_primary_button_text"
            android:gravity="center_vertical"
            android:id="@+id/text_button_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_onboarding_set_up_recommendations"
            android:elevation="12dp"
            app:drawableStartCompat="@drawable/custom_icon_with_padding"
            app:drawableTint="@color/vk_primary_button_text"
            app:layout_constraintBottom_toBottomOf="@+id/button_action"
            app:layout_constraintEnd_toEndOf="@+id/button_action"
            app:layout_constraintStart_toStartOf="@+id/button_action"
            app:layout_constraintTop_toTopOf="@+id/button_action"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/image_btn_hide"
        android:background="@drawable/highlight_circle"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_hide"
        android:layout_marginEnd="20dp"
        app:srcCompat="@drawable/vk_icon_cancel_20"
        app:tint="?attr/vk_ui_icon_secondary"/>
</androidx.cardview.widget.CardView>
