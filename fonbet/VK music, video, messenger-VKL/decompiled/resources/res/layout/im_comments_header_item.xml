<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.FluidHorizontalLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteCapsSemiBold"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/im_comments_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="12dp"
        app:vk_layout_isFluid="true"/>
    <FrameLayout
        android:id="@+id/im_comments_sort_order_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="12dp">
        <ProgressBar
            android:layout_gravity="end|center_vertical"
            android:id="@+id/im_order_progress"
            android:visibility="invisible"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="?attr/vk_ui_icon_secondary"
            android:indeterminateTintMode="src_in"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_accent"
            android:gravity="center_vertical"
            android:id="@+id/im_comments_order"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:paddingVertical="8dp"
            app:drawableEndCompat="@drawable/vk_icon_dropdown_16"
            app:drawableTint="?attr/vk_ui_text_accent"/>
    </FrameLayout>
</com.vk.core.tool.view.FluidHorizontalLayout>
