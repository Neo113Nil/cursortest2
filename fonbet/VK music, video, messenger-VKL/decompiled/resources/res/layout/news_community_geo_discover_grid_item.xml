<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/news_community_geo_grid_item_container"
    android:background="?attr/vk_ui_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.StaticMapView
        android:id="@+id/news_community_geo_discover_grid_item_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/news_community_discover_grid_item_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scaleType="center"
        android:tint="?attr/vk_ui_icon_contrast"
        android:layout_marginEnd="4dp"/>
</FrameLayout>
