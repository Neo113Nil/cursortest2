<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tab_view_placeholder"
    android:background="@drawable/market_all_reviews_tabs_view_holder_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/market_all_reviews_shimmer_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/tabs_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/market_all_reviews_own_reviews_view_holder_title"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/VkUiTypography.Headline1"/>
            <View
                android:id="@+id/good_reviews_tab"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="4dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/community_reviews_tab"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabs_title"/>
            <View
                android:id="@+id/community_reviews_tab"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="16dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/good_reviews_tab"
                app:layout_constraintTop_toBottomOf="@+id/tabs_title"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/tabs_barrier"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="good_reviews_tab, community_reviews_tab"/>
            <View
                android:id="@+id/separator"
                android:background="?attr/vk_ui_separator_primary"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabs_barrier"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
</FrameLayout>
