<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/background_light_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/vkim_accessibility_promo_link_banner"
    android:paddingHorizontal="16dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/promo_link_logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_logo_vk_me_color_24"
        android:contentDescription="@string/vk_auth_accessibility_logo"
        android:layout_marginVertical="8dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/promo_link_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:id="@+id/promo_link_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:lines="1"
            android:layout_weight="1"
            android:fontFamily="@font/vk_roboto_medium"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/vk_legacy_text_subhead"
            android:ellipsize="end"
            android:id="@+id/promo_link_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:lines="1"
            android:layout_weight="1"
            android:lineSpacingExtra="2sp"
            android:fontFamily="@font/vk_roboto_regular"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/promo_link_is_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_new_badge_rounded_24"
        android:contentDescription="@string/vkim_accessibility_promo_link_banner_new"/>
</LinearLayout>
