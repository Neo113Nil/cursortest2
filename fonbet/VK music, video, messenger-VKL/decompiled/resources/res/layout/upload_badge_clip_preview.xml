<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="@dimen/clips_upload_badge_width"
    android:layout_height="@dimen/clips_upload_badge_height"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false">
    <com.vk.clips.design.view.component.video.preview.ClipRectanglePreview
        android:id="@+id/upload_badge_clip_preview"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/clips_upload_badge_width"
        android:layout_height="@dimen/clips_upload_badge_height"/>
</androidx.cardview.widget.CardView>
