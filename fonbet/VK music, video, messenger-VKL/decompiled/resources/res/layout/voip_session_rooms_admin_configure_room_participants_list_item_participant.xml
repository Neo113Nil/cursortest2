<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voip_session_rooms_admin_configure_rooms_dialog_configure"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_room_participant_check_mark"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="?attr/vk_ui_icon_tertiary"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_check_circle_off_24"/>
    <com.vk.voip.ui.avatars.VoipAvatarViewContainer
        android:id="@+id/voip_room_participant_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/voip_room_participant_check_mark"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAvatarSize="40dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_room_admin_badge"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="-2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/voip_room_participant_avatar"
        app:srcCompat="@drawable/vk_icon_star_circle_fill_blue_16"/>
    <TextView
        android:textAppearance="@style/VoipSessionRoomList.Caption"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/voip_room_participant_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_room_participant_status"
        app:layout_constraintEnd_toStartOf="@+id/voip_room_participant_assistance_status"
        app:layout_constraintStart_toEndOf="@+id/voip_room_participant_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VoipSessionRoomList.FootNote"
        android:id="@+id/voip_room_participant_status"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voip_room_participant_assistance_status"
        app:layout_constraintStart_toEndOf="@+id/voip_room_participant_avatar"
        app:layout_constraintTop_toBottomOf="@+id/voip_room_participant_name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_room_participant_assistance_status"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="@color/vk_orange"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voip_room_participant_hand_status"
        app:layout_constraintStart_toEndOf="@+id/voip_room_participant_name"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_question_24"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_room_participant_hand_status"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="@color/vk_steel_gray_400"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voip_room_participant_options"
        app:layout_constraintStart_toEndOf="@+id/voip_room_participant_assistance_status"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"
        app:srcCompat="@drawable/vk_icon_privacy_24"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_room_participant_options"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="32dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:tint="?attr/vk_ui_icon_tertiary"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/voip_room_participant_hand_status"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
