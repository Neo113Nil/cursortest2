<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rv_gif_skeleton"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/recent_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/story_gif_recent"
        android:layout_marginStart="12dp"
        style="@style/VkUiTypography.FootnoteCapsMedium"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recent_gifs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/popular_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/story_gif_popular"
        android:layout_marginStart="12dp"
        style="@style/VkUiTypography.FootnoteCapsMedium"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/all_gifs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
