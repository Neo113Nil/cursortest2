<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vk_pay_checkout_bonuses_vkpay"
        style="@style/VkLegacyTypography.Headline"/>
    <TextView
        android:textStyle="bold"
        android:textColor="?attr/vk_legacy_accent"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/vk_pay_checkout_bonuses_amount_or_hide"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        app:drawableTint="?attr/vk_legacy_accent"/>
</FrameLayout>
