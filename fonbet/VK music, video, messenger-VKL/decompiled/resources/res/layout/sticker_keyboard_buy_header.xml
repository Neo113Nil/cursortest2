<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/header_container"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/sticker_btn_wrap"
            android:layout_alignParentLeft="true"
            android:fontFamily="@string/font_family_medium"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawablePadding="10dp"
            android:layout_below="@+id/title"
            android:layout_alignRight="@+id/title"
            android:layout_alignParentLeft="true"/>
        <FrameLayout
            android:id="@+id/sticker_btn_wrap"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:layout_alignParentRight="true">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.vk.vas.design.view.VkDiscountTextView
                    android:id="@+id/sticker_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    app:vk_discountButtonStyle="commerce"/>
                <ImageButton
                    android:id="@+id/gift_button"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    app:srcCompat="@drawable/vk_icon_gift_16"
                    app:tint="@color/vk_white"
                    style="@style/VkLegacyButton.Green"/>
            </LinearLayout>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/sticker_progress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:max="100"
                android:indeterminate="false"
                android:indeterminateOnly="false"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sticker_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_recommendation_added"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sticker_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/vk_icon_error_circle_outline_24"/>
        </FrameLayout>
    </RelativeLayout>
    <View
        android:id="@+id/header_shadow"
        android:background="@drawable/vk_bg_toolbar_shadow_light"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
</LinearLayout>
