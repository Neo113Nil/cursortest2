<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/story_media_picker_root_layout"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/story_media_picker_toolbar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/story_media_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/story_media_picker_toolbar_container"/>
    <com.vk.stories.design.view.camera.StoryMediaPickerTabView
        android:id="@+id/story_tabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size2_xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/story_selected_items_view"
        android:background="@drawable/story_selected_photos_background_new"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:paddingHorizontal="@dimen/vk_ui_base_padding_vertical"
        android:paddingVertical="@dimen/vk_ui_base_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/button_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vk_ui_spacing_size2_xl"
            app:buttonAppearance="neutral"
            app:buttonMode="primary"
            app:buttonSizeType="large"
            app:icon="@drawable/vk_icon_cards_2_outline_24"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/button_collage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="large"
            app:icon="@drawable/vk_icon_screen_grid_tile_outline_28"
            app:text="@string/story_picker_add_to_collage"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
