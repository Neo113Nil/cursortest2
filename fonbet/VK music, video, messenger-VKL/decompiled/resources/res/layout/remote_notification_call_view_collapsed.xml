<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_new_logo_vk_color_28"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/text_wrap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            style="@style/TextAppearance.Compat.Notification.Title"/>
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/voip_incoming_audio_call"
            android:maxLines="1"
            android:singleLine="true"
            style="@style/TextAppearance.Compat.Notification.Info"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/decline_btn"
        android:background="@drawable/voip_remote_view_decline_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_phone_down_20"
        android:scaleType="center"
        android:contentDescription="@string/voip_accessibility_decline_call"
        android:layout_marginStart="15dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/answer_btn"
        android:background="@drawable/voip_remote_view_accept_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_phone_20"
        android:scaleType="center"
        android:contentDescription="@string/voip_accessibility_accept_call"
        android:layout_marginStart="8dp"/>
</LinearLayout>
