<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_bottom_sheet_rounded_corners"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ProgressBar
        android:id="@+id/vmoji_progress"
        android:layout_width="49dp"
        android:layout_height="49dp"
        android:layout_marginTop="200dp"
        android:layout_marginBottom="200dp"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/vmoji_text_views"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="vmoji_image_box, vmoji_title, vmoji_description"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vmoji_close_view"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        android:tint="@color/vk_white"
        android:contentDescription="@string/cancel"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_outline_28"/>
    <FrameLayout
        android:id="@+id/vmoji_image_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/vmoji_placeholder"
            android:layout_width="282dp"
            android:layout_height="168dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/voip_vmoji_preview_content_description_no_vmoji"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/vmoji_avatar"
            android:layout_width="181dp"
            android:layout_height="181dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/voip_vmoji_preview_content_description_got_vmoji"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vmoji_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/voip_configure_vmoji_title"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vmoji_image_box"
        style="@style/VkLegacyTypography.Title2.Regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vmoji_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voip_configure_vmoji_description"
        android:maxLines="2"
        android:lines="2"
        android:textAlignment="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vmoji_title"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vmoji_create_vmoji"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="36dp"
        android:text="@string/voip_configure_vmoji_create_vmoji"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/vmoji_enable_vmoji"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vmoji_description"
        app:layout_goneMarginBottom="12dp"
        style="@style/VkLegacyButton.Primary.Big"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vmoji_enable_vmoji"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="@string/voip_configure_vmoji_enable_vmoji"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/vmoji_edit_vmoji"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vmoji_create_vmoji"
        app:layout_goneMarginBottom="12dp"
        app:layout_goneMarginTop="36dp"
        style="@style/VkLegacyButton.Primary.Big"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vmoji_edit_vmoji"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/voip_configure_vmoji_edit_vmoji"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vmoji_enable_vmoji"
        style="@style/VkLegacyButton.Secondary.Big"/>
</androidx.constraintlayout.widget.ConstraintLayout>
