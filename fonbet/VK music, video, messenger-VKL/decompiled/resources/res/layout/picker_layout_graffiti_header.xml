<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="76dp">
        <com.vk.core.view.TintTextView
            android:textSize="16sp"
            android:layout_gravity="center"
            android:id="@+id/fl_new_graffiti"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_margin="16dp"
            android:layout_marginRight="8dp"
            android:text="@string/picker_new_graffiti"
            android:drawablePadding="16dp"
            app:drawableStartCompat="@drawable/vk_icon_add_16"
            app:drawableStartTint="?attr/vk_legacy_button_primary_foreground"
            style="@style/VkLegacyButton.Primary"/>
    </FrameLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="72dp"
        android:text="@string/picker_graffiti_history_desc"/>
</LinearLayout>
