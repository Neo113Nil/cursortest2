<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <include
            android:elevation="0dp"
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <View
        android:id="@+id/widget_preview_toolbar_separator"
        android:background="@color/vk_black_alpha12"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="3.5dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/community_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="12dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/community_widget_preview_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="10dp"
            android:hyphenationFrequency="none"/>
    </LinearLayout>
    <View
        android:background="@color/vk_black_alpha12"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/community_widget_preview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:background="@color/vk_black_alpha12"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/community_widget_install_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/community_install_widget"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</LinearLayout>
