<?xml version="1.0" encoding="utf-8"?>
<com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    app:overlayDrawable="@drawable/highlight_radius_4"
    app:padOverlay="true">
    <FrameLayout
        android:background="@drawable/repost_compact_bg"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.tool.view.FluidHorizontalLayout
                android:gravity="center_vertical"
                android:id="@+id/name_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">
                <View
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/vk_icon_repost_16"
                    android:visibility="visible"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="?attr/vk_ui_icon_secondary"/>
                <com.vk.imageloader.view.VKCircleImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/photo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.SubheadMedium"
                    android:textColor="?attr/newsfeed_post_title_color"
                    android:ellipsize="end"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginStart="8dp"
                    app:vk_layout_isFluid="true"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/icon"
                    android:visibility="gone"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Footnote"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="16dp"
                    android:layout_marginStart="6dp"/>
            </com.vk.core.tool.view.FluidHorizontalLayout>
            <TextView
                android:textAppearance="@style/VkUiTypography.Paragraph"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:layout_marginEnd="72dp"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/container"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="1dp">
            <com.vk.imageloader.view.VKImageView
                android:layout_gravity="center"
                android:id="@+id/attach_thumb"
                android:layout_width="60dp"
                android:layout_height="60dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/overlay"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                app:srcCompat="@drawable/vk_icon_play_28"/>
        </FrameLayout>
    </FrameLayout>
</com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout>
