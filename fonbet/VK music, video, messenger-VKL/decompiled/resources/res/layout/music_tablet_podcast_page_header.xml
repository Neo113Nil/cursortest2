<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlist_header_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="180dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <com.vk.music.view.ThumbsImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/playlist_foreground_image"
        android:focusable="true"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:elevation="5dp"
        app:roundedCornerRadius="@dimen/music_playlist_corner_radius"
        app:tiv_background_image="?attr/vk_ui_background_content"
        app:tiv_border_width="0.5dp"
        app:tiv_placeholder_resource="@drawable/vk_icon_podcast_48"
        app:tiv_placeholder_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="7.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginStart="156dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Title3"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/playlist_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/playlist_owner_text"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:minHeight="18dp"
            android:singleLine="true"
            style="@style/VkUiTypography.Footnote"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttons_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/subscribe_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonAppearance="accent"
                app:buttonMode="primary"
                app:buttonSizeType="medium"/>
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/notifications_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:buttonAppearance="accent"
                app:buttonMode="secondary"
                app:buttonSizeType="medium"/>
        </LinearLayout>
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:gravity="center_vertical"
            android:id="@+id/friends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="32dp">
            <TextView
                android:textColor="?attr/vk_ui_text_subhead"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/friends_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="30dp"
                android:maxLines="2"
                app:vk_layout_isFluid="true"
                style="@style/VkUiTypography.Subhead"/>
            <com.vk.core.view.PhotoStripView
                android:layout_gravity="center_vertical"
                android:id="@+id/friends_photos"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</FrameLayout>
