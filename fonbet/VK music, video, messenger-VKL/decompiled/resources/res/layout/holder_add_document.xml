<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/newsfeed_newpost_add_item_header_height"
    android:baselineAligned="false"
    android:divider="@drawable/posting_attach_header_divider"
    android:showDividers="middle">
    <FrameLayout
        android:id="@+id/holder_add_document_from_gallery_btn"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.TextNormal.Unscaled"
            android:textColor="?attr/vk_ui_text_accent"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/newsfeed_newpost_attach_documents_from_gallery"
            android:singleLine="true"
            android:drawablePadding="8dp"
            app:drawableLeftCompat="@drawable/vk_icon_gallery_24"
            app:drawableStartCompat="@drawable/vk_icon_gallery_24"
            app:drawableTint="?attr/vk_ui_icon_accent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/holder_add_document_from_device_btn"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.TextNormal.Unscaled"
            android:textColor="?attr/vk_ui_text_accent"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/newsfeed_newpost_attach_documents_from_device"
            android:singleLine="true"
            android:drawablePadding="8dp"
            app:drawableLeftCompat="@drawable/vk_icon_upload_24"
            app:drawableStartCompat="@drawable/vk_icon_upload_24"
            app:drawableTint="?attr/vk_ui_icon_accent"/>
    </FrameLayout>
</LinearLayout>
