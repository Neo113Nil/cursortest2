<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/native_ad_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/yandex_native_ad_icon"
        android:background="@drawable/bg_white_circle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:foreground="@drawable/vk_circle_border"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        android:backgroundTint="?attr/vk_ui_image_placeholder"
        android:foregroundTint="?attr/vk_ui_image_border_alpha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/yandex_native_ad_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-1dp"
        android:minHeight="18dp"
        android:maxLines="1"
        android:textAlignment="gravity"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/yandex_native_ad_options_container"
        app:layout_constraintStart_toEndOf="@+id/yandex_native_ad_icon"
        app:layout_constraintTop_toTopOf="@+id/yandex_native_ad_icon"
        style="@style/VkUiTypography.SubheadMedium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/yandex_native_ad_advertiser"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="14dp"
        android:maxLines="1"
        android:importantForAccessibility="yes"
        android:textAlignment="gravity"
        app:layout_constraintEnd_toStartOf="@+id/yandex_native_ad_options_container"
        app:layout_constraintStart_toStartOf="@+id/yandex_native_ad_title"
        app:layout_constraintTop_toBottomOf="@+id/yandex_native_ad_title"
        style="@style/VkUiTypography.Caption1Normal"/>
    <FrameLayout
        android:id="@+id/yandex_native_ad_options_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@+id/yandex_native_ad_media_holder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/yandex_native_ad_fake_options"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:contentDescription="@null"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/yandex_native_ad_options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/vk_icon_more_vertical_24"
            android:scaleType="centerInside"
            android:contentDescription="@string/accessibility_actions"
            app:tint="?attr/vk_ui_icon_secondary"/>
    </FrameLayout>
    <com.vk.newsfeed.common.views.ContentRatioLayout
        android:id="@+id/yandex_native_ad_media_holder"
        android:background="?attr/vk_ui_image_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/yandex_native_ad_advertiser"
        app:ratio="1.33"/>
    <Button
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/yandex_native_ad_cta_button"
        android:background="?attr/vk_ui_background_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:translationZ="0dp"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="44dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/yandex_native_ad_media_holder"
        style="@style/VkUiTypography.ParagraphNormal"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/yandex_native_ad_disclaimer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scaleType="fitXY"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/yandex_native_ad_cta_button"
        app:tint="?attr/vk_ui_text_secondary"/>
    <FrameLayout
        android:id="@+id/yandex_native_ad_body_text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/yandex_native_ad_disclaimer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
