<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="start"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:padding="2dp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        app:srcCompat="@drawable/vk_icon_error_circle_outline_32"
        app:tint="?attr/vk_legacy_destructive"/>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Footnote.Regular"
        android:textSize="13sp"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:translationY="-0.6dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"/>
</LinearLayout>
