<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_contrast_themed"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:foreground="?attr/selectableItemBackground"
    android:backgroundTint="?attr/vk_ui_background_contrast_themed"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/music_navigation_title_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="36dp"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="end"
        android:id="@+id/music_navigation_image_small"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:scaleType="fitEnd"
        app:actualImageScaleType="fitEnd"/>
</androidx.cardview.widget.CardView>
