<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/status_popup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="?attr/vk_ui_background_modal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp">
        <com.vk.avatar.api.VKAvatarView
            android:id="@+id/avatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:avatarImageSize="72dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/story_generated_popup_title"
            android:textAlignment="gravity"
            style="@style/VkUiTypography.Title2Medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:gravity="center_horizontal"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/story_generated_popup_subtitle"
            style="@style/VkUiTypography.SubheadNormal"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/open_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/story_generated_popup_action"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close_modal"
        android:padding="16dp"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="-16dp"
        android:contentDescription="@string/accessibility_close"
        android:layout_marginEnd="-16dp"
        app:srcCompat="@drawable/vk_icon_cancel_20"
        app:tint="?attr/vk_ui_icon_secondary"/>
</merge>
