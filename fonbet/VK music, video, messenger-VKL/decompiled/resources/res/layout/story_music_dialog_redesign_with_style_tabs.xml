<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/story_music_dialog_root"
    android:background="?attr/vk_ui_overlay_primary"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.stories.tool.view.NoOverlappingRenderingImageView
        android:id="@+id/story_music_track_close"
        android:background="@drawable/white_ripple_unbounded"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="4dp"
        android:src="@drawable/vk_icon_arrow_left_outline_28"
        android:scaleType="center"
        android:tint="?attr/vk_ui_icon_contrast"
        android:contentDescription="@string/close"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/btn_delete_track"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/delete"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:icon="@drawable/vk_icon_delete_outline_16"
        app:layout_constraintLeft_toRightOf="@+id/story_music_track_close"
        app:layout_constraintRight_toLeftOf="@+id/story_dialog_done"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.stories.tool.view.NoOverlappingRenderingImageView
        android:id="@+id/story_dialog_done"
        android:background="@drawable/white_ripple_unbounded"
        android:layout_width="@dimen/story_done_btn_size"
        android:layout_height="@dimen/story_done_btn_size"
        android:layout_marginTop="4dp"
        android:src="@drawable/vk_icon_done_28"
        android:scaleType="center"
        android:tint="?attr/vk_ui_icon_contrast"
        android:contentDescription="@string/story_hashtag_content_desc_done_bn"
        android:layout_marginEnd="4dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/story_music_dialog_range_waveform"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/story_dialog_done">
        <com.vk.stories.design.view.stickers.music.MusicStickerStyleSwitchingView
            android:id="@+id/music_sticker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/btn_change_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/story_music_change_track_long"
            app:buttonAppearance="accent"
            app:buttonMode="link"
            app:buttonSizeType="small"
            app:icon="@drawable/vk_icon_sync_16"/>
    </LinearLayout>
    <com.vk.stories.design.view.editor.SelectRangeWaveFormView
        android:layout_gravity="bottom"
        android:id="@+id/story_music_dialog_range_waveform"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_music_range_selector_height"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/music_style_picker"/>
    <com.vk.core.view.ColorProgressBar
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/story_music_progress_bar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="24dp"
        android:color="@color/vk_white"
        app:layout_constraintBottom_toTopOf="@+id/style_controls"
        app:layout_constraintLeft_toLeftOf="@+id/story_music_dialog_range_waveform"
        app:layout_constraintRight_toRightOf="@+id/story_music_dialog_range_waveform"/>
    <com.vk.stories.design.view.editor.StoryStylePickerView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/music_style_picker"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
