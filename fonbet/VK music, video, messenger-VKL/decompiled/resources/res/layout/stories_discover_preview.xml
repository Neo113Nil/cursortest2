<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.SimpleRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_gray_850"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/white_ripple"
    android:minHeight="184dp"
    app:orientation="horizontal"
    app:ratio="0.57">
    <FrameLayout
        android:id="@+id/stories_discover_preview_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:background="@color/vk_black_alpha05"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/vk_gradient_bottom_72_alpha48"
            android:layout_width="match_parent"
            android:layout_height="72dp"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.stories.design.view.avatar.StoryAvatarView
                android:layout_gravity="center_horizontal"
                android:id="@+id/photo"
                android:layout_width="@dimen/stories_discover_preview_avatar_size"
                android:layout_height="@dimen/stories_discover_preview_avatar_size"
                android:layout_margin="4dp"
                app:contourOverlayEnabled="true"
                app:vk_border="@drawable/avatar_border_48"
                app:vk_borderTint="@color/vk_sky_300"/>
            <TextView
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:lines="2"
                android:textAlignment="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                style="@style/VkUiTypography.Subhead"/>
        </LinearLayout>
    </FrameLayout>
    <include layout="@layout/stories_discover_skeleton_shimmer"/>
</com.vk.core.tool.view.SimpleRatioFrameLayout>
