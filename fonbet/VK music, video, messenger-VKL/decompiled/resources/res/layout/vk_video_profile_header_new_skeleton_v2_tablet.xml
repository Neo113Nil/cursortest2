<?xml version="1.0" encoding="utf-8"?>
<com.vk.superapp.ui.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_profile_header_new_v2_skeleton_layout"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/vk_video_profile_header_v2_guideline_tablet"
    android:paddingEnd="@dimen/vk_video_profile_header_v2_guideline_tablet">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/video_profile_header_v2_skeleton_avatar"
            android:background="@drawable/white_oval"
            android:layout_width="@dimen/vk_video_profile_header_v2_avatar_size_tablet"
            android:layout_height="@dimen/vk_video_profile_header_v2_avatar_size_tablet"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_title"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="200dp"
            android:layout_height="28dp"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toTopOf="@+id/video_profile_header_v2_skeleton_intertitle_1"
            app:layout_constraintStart_toEndOf="@+id/video_profile_header_v2_skeleton_avatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_intertitle_1"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="98dp"
            android:layout_height="12dp"
            android:layout_marginTop="5dp"
            app:layout_constraintBottom_toTopOf="@+id/video_profile_header_v2_skeleton_subtitle_1"
            app:layout_constraintStart_toStartOf="@+id/video_profile_header_v2_skeleton_title"
            app:layout_constraintTop_toBottomOf="@+id/video_profile_header_v2_skeleton_title"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_intertitle_2"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="98dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/video_profile_header_v2_skeleton_intertitle_1"
            app:layout_constraintTop_toTopOf="@+id/video_profile_header_v2_skeleton_intertitle_1"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_subtitle_1"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="260dp"
            android:layout_height="12dp"
            android:layout_marginTop="11dp"
            app:layout_constraintBottom_toTopOf="@+id/video_profile_header_v2_skeleton_subscribe_button"
            app:layout_constraintStart_toStartOf="@+id/video_profile_header_v2_skeleton_title"
            app:layout_constraintTop_toBottomOf="@+id/video_profile_header_v2_skeleton_intertitle_1"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_subtitle_2"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="64dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/video_profile_header_v2_skeleton_subtitle_1"
            app:layout_constraintTop_toTopOf="@+id/video_profile_header_v2_skeleton_subtitle_1"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_subscribe_button"
            android:background="@drawable/vk_video_skeleton_background_rectangle_10dp"
            android:layout_width="123dp"
            android:layout_height="32dp"
            android:layout_marginTop="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/video_profile_header_v2_skeleton_title"
            app:layout_constraintTop_toBottomOf="@+id/video_profile_header_v2_skeleton_subtitle_1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
