<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/footer"
    android:paddingTop="13dp"
    android:paddingBottom="13dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="62dp"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <TextView
        android:textColor="?attr/vk_legacy_text_muted"
        android:ellipsize="end"
        android:id="@+id/attach_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="10dp"
        app:fontWeight="400"
        app:layout_constraintBottom_toTopOf="@+id/attach_description"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center_vertical"
        android:id="@+id/attach_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/attach_title"
        style="@style/VkLegacyTypography.Footnote.Regular"/>
    <ImageView
        android:id="@+id/attach_rating_img"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/vk_icon_favorite_16"
        android:importantForAccessibility="no"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/attach_description"
        app:layout_constraintStart_toEndOf="@+id/attach_description"
        app:layout_constraintTop_toTopOf="@+id/attach_description"
        app:tint="?attr/vk_ui_accent_orange"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center_vertical"
        android:id="@+id/attach_rating_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:singleLine="true"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/attach_description"
        app:layout_constraintStart_toEndOf="@+id/attach_rating_img"
        app:layout_constraintTop_toTopOf="@+id/attach_description"
        style="@style/VkLegacyTypography.Footnote.Regular"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="attach_subtitle"/>
    <com.vk.core.view.AdsButton
        android:textSize="14sp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/attach_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/outline_button"/>
    <FrameLayout
        android:id="@+id/containerShine"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:backgroundTint="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="@+id/attach_subtitle"
        app:layout_constraintEnd_toEndOf="@+id/attach_subtitle"
        app:layout_constraintStart_toStartOf="@+id/attach_subtitle"
        app:layout_constraintTop_toTopOf="@+id/attach_subtitle">
        <View
            android:id="@+id/shine_anim"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="@+id/attach_subtitle"
            app:layout_constraintEnd_toEndOf="@+id/attach_subtitle"
            app:layout_constraintStart_toStartOf="@+id/attach_subtitle"
            app:layout_constraintTop_toTopOf="@+id/attach_subtitle"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
