<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="12dp"
    android:paddingVertical="4dp">
    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.picture.VkPicture
            android:id="@+id/iv_main_image"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:placeholderImage="@drawable/vk_icon_gallery_outline_56"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="@dimen/vk_ui_border_radius"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="@dimen/vk_ui_border2x"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/iv_moderation_icon"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/vk_icon_hide_outline_shadow_medium_48"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Headline2Medium"
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:id="@+id/market_clip_attach_title"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/market_clip_attach_description"
        app:layout_constraintEnd_toStartOf="@+id/market_clip_attach_badge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/imageContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:id="@+id/market_clip_attach_live_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        app:capsule="false"
        app:contentBadgeMode="primary"
        app:contentBadgeSize="small"
        app:layout_constraintBottom_toBottomOf="@+id/imageContainer"
        app:layout_constraintEnd_toEndOf="@+id/imageContainer"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:id="@+id/market_clip_attach_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:capsule="false"
        app:contentBadgeMode="primary"
        app:contentBadgeSize="small"
        app:layout_constraintBottom_toBottomOf="@+id/market_clip_attach_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/market_clip_attach_title"
        app:layout_constraintTop_toTopOf="@+id/market_clip_attach_title"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:id="@+id/market_clip_attach_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/market_clip_attach_button"
        app:layout_constraintEnd_toStartOf="@+id/market_clip_attach_rating"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/imageContainer"
        app:layout_constraintTop_toBottomOf="@+id/market_clip_attach_title"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption1Medium"
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:id="@+id/market_clip_attach_rating"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawablePadding="2dp"
        android:drawableStart="@drawable/vk_icon_favorite_12"
        android:layout_marginStart="4dp"
        android:drawableTint="?attr/vk_ui_icon_contrast"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/market_clip_attach_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/market_clip_attach_description"
        app:layout_constraintTop_toTopOf="@+id/market_clip_attach_description"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/market_clip_attach_button"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="10dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/imageContainer"
        app:layout_constraintTop_toBottomOf="@+id/market_clip_attach_description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
