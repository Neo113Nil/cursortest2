<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_related_video_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/preview"
        android:layout_width="142dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="6dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="8dp"
        app:roundingBorderColor="@color/vk_white_alpha8"
        app:roundingBorderWidth="0.5dp"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/overlay_view"
        android:visibility="gone"
        android:layout_width="142dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="6dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vov_corner_radius="8dp"
        app:vov_force_redesign="true"
        app:vov_mode="dark"
        app:vov_size="small"/>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginBottom="-0.5dp"
        android:max="100"
        android:indeterminate="false"
        android:progressDrawable="@drawable/video_progress_redesign"
        app:layout_constraintBottom_toBottomOf="@+id/preview"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        app:layout_constraintStart_toStartOf="@+id/preview"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/image_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="end"
        app:constraint_referenced_ids="overlay_view,preview"/>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/live_badge"
        android:visibility="invisible"
        android:layout_width="44dp"
        android:layout_height="20dp"
        android:layout_marginBottom="14dp"
        android:src="@drawable/vk_icon_live_badge_20"
        android:importantForAccessibility="no"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/image_barrier"/>
    <com.vk.libvideo.design.view.duration.DurationView
        android:textAppearance="@style/VkUiTypography.HeadlineMedium"
        android:id="@+id/duration"
        android:background="@drawable/bg_video_duration_label"
        android:visibility="invisible"
        android:layout_width="44dp"
        android:layout_height="20dp"
        android:layout_marginBottom="14dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/image_barrier"/>
    <com.vk.libvideo.design.view.movika.InteractiveDurationView
        android:textAppearance="@style/VkUiTypography.HeadlineMedium"
        android:id="@+id/interactive_duration"
        android:background="@drawable/bg_interactiv_video_duration_label_rounded_4"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/image_barrier"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/privacy_icon"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="6dp"
        android:scaleType="center"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitle_views"
        app:layout_constraintEnd_toStartOf="@+id/more_actions"
        app:layout_constraintStart_toEndOf="@+id/image_barrier"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1Normal"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/subtitle_views"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/subtitle_date"
        app:layout_constraintEnd_toStartOf="@+id/icon_verify"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/image_barrier"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintWidth_default="wrap"/>
    <ImageView
        android:id="@+id/icon_verify"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle_views"
        app:layout_constraintEnd_toStartOf="@+id/more_actions"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/subtitle_views"
        app:layout_constraintTop_toTopOf="@+id/subtitle_views"
        app:layout_constraintVertical_bias="0.5"/>
    <com.vk.libvideo.design.view.info.VideoInfoTextView
        android:textAppearance="@style/VkUiTypography.Caption1Normal"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/subtitle_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/more_actions"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/image_barrier"
        app:layout_constraintTop_toBottomOf="@+id/subtitle_views"/>
    <ImageView
        android:id="@+id/more_actions"
        android:background="@drawable/highlight_unlimited"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="4dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/menu"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_primary"/>
    <ImageView
        android:id="@+id/playback_visualization"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        app:layout_constraintStart_toStartOf="@+id/preview"
        app:layout_constraintTop_toTopOf="@+id/preview"/>
</androidx.constraintlayout.widget.ConstraintLayout>
