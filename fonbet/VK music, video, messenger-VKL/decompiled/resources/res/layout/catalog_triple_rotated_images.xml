<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/link_image_container"
    android:layout_width="@dimen/music_catalog_link_item_width"
    android:layout_height="@dimen/music_catalog_link_item_width">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center"
        android:id="@+id/link_image_background"
        android:layout_width="@dimen/music_catalog_link_item_width"
        android:layout_height="@dimen/music_catalog_link_item_width"
        app:roundedCornerRadius="12dp"/>
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center"
        android:id="@+id/link_image_static"
        android:visibility="gone"
        android:layout_width="@dimen/music_catalog_link_item_width"
        android:layout_height="@dimen/music_catalog_link_item_width"
        app:roundedCornerRadius="12dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/link_image_rotated_container_1"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="23.68dp"
        android:rotation="-14"
        android:layout_marginEnd="27dp"
        app:cardCornerRadius="11dp"
        app:cardElevation="16dp">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/link_image_rotated_1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:roundedCornerRadius="11dp"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="0.5dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/link_image_rotated_container_2"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="8.75dp"
        android:rotation="17"
        android:layout_marginStart="8.13dp"
        app:cardCornerRadius="11dp"
        app:cardElevation="16dp">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/link_image_rotated_2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:roundedCornerRadius="11dp"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="0.5dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/link_image_rotated_container_3"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="24.34dp"
        android:rotation="34"
        android:layout_marginStart="37dp"
        app:cardCornerRadius="11dp"
        app:cardElevation="16dp">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/link_image_rotated_3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:roundedCornerRadius="11dp"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="0.5dp"/>
    </androidx.cardview.widget.CardView>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/link_image_animation"
        android:visibility="gone"
        android:layout_width="@dimen/music_catalog_link_item_width"
        android:layout_height="@dimen/music_catalog_link_item_width"
        app:lottie_repeatCount="-1"
        app:lottie_repeatMode="restart"/>
</FrameLayout>
