<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="44dp"
        android:paddingBottom="36dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/post_side_padding"
        android:paddingEnd="@dimen/post_side_padding">
        <TextView
            android:textColor="@color/vk_ui_text_title_color"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/VkUiTypography.Title2Medium"/>
        <TextView
            android:textColor="@color/vk_ui_text_title_color"
            android:gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/VkUiTypography.Subhead"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/menu"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/common_actions"
        android:layout_marginEnd="@dimen/post_side_padding_menu"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</FrameLayout>
