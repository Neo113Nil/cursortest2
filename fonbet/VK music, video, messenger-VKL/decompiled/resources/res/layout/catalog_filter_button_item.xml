<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/catalog_bg_filter_button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="3dp"
        style="@style/VkLegacyTypography.Caption1.Primary"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_tertiary"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="3dp"
        style="@style/VkLegacyTypography.Caption1"/>
</androidx.appcompat.widget.LinearLayoutCompat>
