<?xml version="1.0" encoding="utf-8"?>
<com.my.target.nativeads.views.NativeAdContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nativeads_ad_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.my.target.nativeads.views.MediaAdView
            android:id="@+id/nativeads_media_view"
            android:background="?attr/vk_ui_background_secondary_alpha"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ad_media_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.my.target.nativeads.views.IconAdView
            android:id="@+id/nativeads_icon"
            android:background="?attr/vk_ui_background_secondary_alpha"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ad_media_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Caption3Medium"
            android:textColor="?attr/vk_ui_text_contrast"
            android:gravity="center"
            android:id="@+id/nativeads_advertising"
            android:background="@drawable/bg_ad_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:drawablePadding="3dp"
            android:textAllCaps="true"
            android:drawableStart="@drawable/vk_icon_logo_vk_ads_12"
            android:layout_marginEnd="12dp"
            android:drawableTint="?attr/vk_ui_icon_contrast"
            android:paddingHorizontal="5dp"
            android:paddingVertical="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Title3SemiBold"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/nativeads_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nativeads_media_view"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.FootnoteNormal"
            android:textColor="?attr/vk_ui_text_muted"
            android:id="@+id/nativeads_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nativeads_title"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/nativeads_call_to_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="15dp"
            app:buttonAppearance="neutral"
            app:buttonBackgroundCornerRadius="10dp"
            app:buttonMode="secondary"
            app:buttonSizeType="small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nativeads_description"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.my.target.nativeads.views.NativeAdContainer>
