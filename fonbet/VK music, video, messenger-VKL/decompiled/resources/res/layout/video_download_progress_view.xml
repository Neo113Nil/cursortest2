<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.spinner.VkSpinner
        android:layout_gravity="center"
        android:id="@+id/download_progress_view"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminate="false"
        android:progressTint="@color/video_light_white"
        android:indeterminateTint="@color/video_light_white"
        app:spinnerSize="regular"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/getting_qualities_view_stub"
        android:layout="@layout/getting_qualities_progress_layout"
        android:inflatedId="@+id/getting_qualities_progress_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/animated_downloads_view_stub"
        android:layout="@layout/animated_downloads_view_layout"
        android:inflatedId="@+id/animated_downloads_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@+id/download_progress_action_view"
        android:padding="1dp"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/vk_icon_cancel_16"
        app:tint="@color/video_light_white"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@+id/action_view"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/vk_icon_download_outline_24"
        app:tint="@color/video_light_white"/>
</merge>
