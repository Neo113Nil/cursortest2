<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/clips_common_header"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.divider.VkDivider
        android:id="@+id/clips_grid_header_cell_separator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <com.vk.core.view.components.cell.rich.VkRichCell
        android:id="@+id/grid_header_info_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginVertical="8dp"/>
    <com.vk.core.view.components.cell.VkMiniInfoCell
        android:id="@+id/clip_grid_challenge_more_info_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.divider.VkDivider
        android:id="@+id/clips_grid_header_author_separator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/clips_grid_header_author_cell"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <ViewStub
        android:id="@+id/clips_grid_trends_banner_stub"
        android:layout="@layout/clips_grid_trends_banner_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/clips_grid_left_toolbar_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="8dp"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/clips_grid_right_toolbar_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="8dp"/>
    </LinearLayout>
    <View
        android:id="@+id/clips_grid_info_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <LinearLayout
        android:gravity="start|top"
        android:orientation="horizontal"
        android:id="@+id/clips_grid_info_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:srcCompat="@drawable/vk_icon_info_circle_outline_20"
            app:tint="?attr/vk_ui_text_subhead"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_subhead"
            android:gravity="start|top"
            android:id="@+id/clips_grid_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            style="@style/VkUiTypography.Paragraph"/>
    </LinearLayout>
</LinearLayout>
