<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/voip_bg_corner24"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="?attr/vk_ui_background_secondary_alpha">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/voip_share_link_pager_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/voip_share_link_page_title"
        android:lines="1"
        android:drawablePadding="4dp"
        android:layout_marginHorizontal="12dp"
        app:drawableStartCompat="@drawable/vk_icon_chain_20"
        app:drawableTint="?attr/vk_ui_icon_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Headline1"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/voip_share_link_pager_tab_recycler_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="@+id/voip_share_link_pager_title"
        app:layout_constraintTop_toBottomOf="@+id/voip_share_link_pager_title"/>
    <LinearLayout
        android:id="@+id/voip_share_link_pager_textarea"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:foreground="@drawable/voip_bg_corner8_stroke05"
        android:foregroundTint="?attr/vk_ui_field_border_alpha"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@+id/voip_share_link_pager_tab_recycler_view">
        <androidx.core.widget.NestedScrollView
            android:background="@drawable/voip_bg_corner8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="?attr/vk_ui_field_background">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/voip_share_link_pager_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:paddingVertical="8dp"
                style="@style/VkUiTypography.Text"/>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/voip_share_link_pager_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="?attr/vk_ui_icon_secondary"
        app:layout_constraintBottom_toBottomOf="@+id/voip_share_link_pager_textarea"
        app:layout_constraintEnd_toEndOf="@+id/voip_share_link_pager_textarea"
        app:layout_constraintStart_toStartOf="@+id/voip_share_link_pager_textarea"
        app:layout_constraintTop_toTopOf="@+id/voip_share_link_pager_textarea"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/voip_share_link_pager_share_btn"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_share_outline_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voip_share_link_pager_refresh_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_share_link_pager_textarea"
        app:text="@string/voip_share_link_page_share"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/voip_share_link_pager_refresh_btn"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="@+id/voip_share_link_pager_share_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/voip_share_link_pager_share_btn"
        app:layout_constraintTop_toTopOf="@+id/voip_share_link_pager_share_btn"
        app:text="@string/voip_share_link_page_refresh"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/voip_share_link_pager_single_share_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:icon="@drawable/vk_icon_share_outline_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_share_link_pager_textarea"
        app:text="@string/voip_share_link_page_share"/>
</androidx.constraintlayout.widget.ConstraintLayout>
