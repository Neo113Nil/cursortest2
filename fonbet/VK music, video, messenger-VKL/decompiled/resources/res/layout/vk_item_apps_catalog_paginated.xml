<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/pager_indicator_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vk_expandable_menu_item_indicator_height">
        <com.vk.core.view.components.pagination.VkPaginationDots
            android:layout_gravity="center"
            android:id="@+id/pager_indicator"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
