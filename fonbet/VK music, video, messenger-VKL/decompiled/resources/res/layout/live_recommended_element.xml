<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/liveRecommendedTop"
    android:background="@color/live_recommended_element_back"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="?android:attr/selectableItemBackground">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/liveRecommendedImg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:overlayImage="@drawable/gift_item_selector"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:alpha="0.9"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="10dp">
        <com.vk.libvideo.live.impl.widgets.timeprogress.CircularTimeBar
            android:id="@+id/liveRecommendedTimeBar"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="20dp"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginRight="4dp">
            <com.vk.core.view.components.picture.VkImageSimple
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_spectators_recommendations"/>
            <com.vk.core.view.components.text.VkText
                android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
                android:textColor="@color/vk_white"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/liveRecommendedViews"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="21dp"
                android:text=""
                android:elevation="@dimen/vk_ui_elevation_two"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp">
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.core.view.components.text.VkText
                    android:textAppearance="@style/VkUiTypography.Subhead"
                    android:textColor="@color/vk_white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/liveRecommendedName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text=""
                    android:maxLines="2"
                    android:shadowColor="@color/vk_black_alpha24"
                    android:shadowDy="2"
                    android:shadowRadius="12"/>
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/liveRecommendedVerified"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginBottom="2dp"
                    android:alpha="0.8"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
