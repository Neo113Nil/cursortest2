<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:id="@+id/voip_scheduled_call_confirm_remove_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/voip_scheduled_remove_confirm_title"
        android:maxLines="1"
        android:textAllCaps="false"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Caption.Caps.Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_scheduled_call_confirm_remove_reschedule_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voip_scheduled_remove_confirm_reschedule"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:drawableStartCompat="@drawable/vk_icon_clock_outline_24"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_scheduled_call_confirm_remove_title"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_background_negative"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_scheduled_call_confirm_remove_item"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/delete"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:drawableStartCompat="@drawable/vk_icon_delete_outline_28"
        app:drawableTint="?attr/vk_ui_background_negative"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_scheduled_call_confirm_remove_reschedule_item"
        style="@style/VkLegacyTypography.Headline.Regular"/>
</merge>
