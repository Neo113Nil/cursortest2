<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/vk_highlight_radius_8"
    android:clipToPadding="false"
    android:layout_width="332dp"
    android:layout_height="60dp">
    <com.vk.core.view.components.cell.rich.VkRichCell
        android:id="@+id/cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/icon_end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="68dp"/>
    <com.vk.core.view.components.picture.VkPicture
        android:id="@+id/dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="@+id/icon_end_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_superapp_catalog_dot_filled"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/badge"
        android:background="@drawable/vk_app_catalog_bg_red"
        android:paddingLeft="@dimen/vk_bottom_navigation_counter_padding"
        android:paddingRight="@dimen/vk_bottom_navigation_counter_padding"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="10dp"
        android:maxWidth="56dp"
        android:minWidth="@dimen/vk_bottom_navigation_counter_height_outer"
        android:minHeight="16dp"
        android:lines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/messenger_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/vk_badge_messenger_description"
        app:layout_constraintEnd_toEndOf="@+id/icon_end_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_message_badge_24"/>
</androidx.constraintlayout.widget.ConstraintLayout>
