<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vk_mix_block"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_swipe_action_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="44dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_swipe_action_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="68dp"/>
    <com.vk.music.view.MusicRoundPlayView
        android:id="@+id/play_view"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:elevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:mrp_background_tint="@color/vk_white"
        app:mrp_compact_progess_bar="true"
        app:mrp_pause_icon="@drawable/vk_icon_pause_32"
        app:mrp_play_icon="@drawable/vk_icon_play_32"
        app:mrp_play_icon_tint="@color/vk_black"
        app:mrp_scale_buffering="true"/>
    <TextView
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/title_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:singleLine="true"
        android:layout_marginHorizontal="34dp"
        android:paddingHorizontal="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1"/>
    <TextView
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/title_second"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginHorizontal="34dp"
        android:paddingHorizontal="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1"/>
    <TextView
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/description_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:alpha="0.8"
        android:layout_marginHorizontal="34dp"
        android:paddingHorizontal="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_first"
        style="@style/VkUiTypography.Paragraph"/>
    <TextView
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/description_second"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:alpha="0.8"
        android:layout_marginHorizontal="34dp"
        android:paddingHorizontal="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_second"
        style="@style/VkUiTypography.Paragraph"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/button_settings_first"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toTopOf="@+id/guideline_swipe_action_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_first"
        app:layout_constraintVertical_bias="0"
        app:trailingIconSize="16dp"/>
    <com.vk.core.view.components.button.VkButton
        android:textColor="@color/vk_white"
        android:id="@+id/button_settings_second"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_second"
        app:layout_constraintVertical_bias="0"
        app:trailingIconSize="16dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/button_placeholder_first"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:buttonAppearance="overlay"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toTopOf="@+id/guideline_swipe_action_top"
        app:layout_constraintEnd_toStartOf="@+id/button_placeholder_second"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_second"
        app:layout_constraintVertical_bias="0"
        app:trailingIconSize="16dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/button_placeholder_second"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:buttonAppearance="overlay"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:iconSize="16dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_swipe_action_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_placeholder_first"
        app:layout_constraintTop_toBottomOf="@+id/description_second"
        app:layout_constraintVertical_bias="0"
        style="@style/VkUiTypography.SubheadMedium"/>
    <ImageView
        android:id="@+id/image_icon_arrow_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_chevron_16"
        android:rotationY="-180"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_swipe_action_bottom"
        app:layout_constraintEnd_toStartOf="@+id/shimmer"
        app:layout_constraintHorizontal_bias="0.5"
        app:tint="@color/vk_white"/>
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_swipe_action_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_icon_arrow_start">
        <TextView
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/text_swipe_action_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:paddingHorizontal="6dp"
            style="@style/VkUiTypography.Footnote"/>
        <TextView
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/text_swipe_action_second"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:paddingHorizontal="6dp"
            style="@style/VkUiTypography.Footnote"/>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
    <ImageView
        android:id="@+id/image_icon_arrow_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_chevron_16"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_swipe_action_bottom"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/shimmer"
        app:tint="@color/vk_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
