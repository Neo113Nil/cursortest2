<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start|top"
    android:background="@drawable/vk_bg_locality_description"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:paddingStart="12dp"
    android:paddingEnd="18dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:srcCompat="@drawable/vk_icon_location_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vk_geopicker_locality_desc"
        android:layout_marginStart="12dp"
        style="@style/VkSuperApp.Locality.Description"/>
</LinearLayout>
