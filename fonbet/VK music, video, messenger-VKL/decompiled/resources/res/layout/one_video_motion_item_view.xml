<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/one_video_gray_100"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/video_motion_title_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/vk_roboto_regular"
        app:layout_constraintBottom_toTopOf="@+id/video_motion_price_view"
        app:layout_constraintEnd_toEndOf="@+id/video_motion_image_view"
        app:layout_constraintStart_toStartOf="@+id/video_motion_image_view"
        app:layout_constraintTop_toBottomOf="@+id/video_motion_image_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/one_video_white"
        android:gravity="end"
        android:id="@+id/video_motion_price_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/vk_roboto_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/video_motion_old_price_view"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/video_motion_image_view"
        app:layout_constraintTop_toBottomOf="@+id/video_motion_title_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/one_video_gray_300"
        android:ellipsize="end"
        android:id="@+id/video_motion_old_price_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/vk_roboto_regular"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_motion_price_view"
        app:layout_constraintEnd_toEndOf="@+id/video_motion_image_view"
        app:layout_constraintStart_toEndOf="@+id/video_motion_price_view"
        app:layout_constraintTop_toTopOf="@+id/video_motion_price_view"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_motion_image_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/video_motion_title_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/one_video_white"
        android:id="@+id/video_motion_discount_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vk_roboto_medium"
        app:layout_constraintStart_toStartOf="@+id/video_motion_image_view"
        app:layout_constraintTop_toTopOf="@+id/video_motion_image_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15dp"
        android:textColor="@color/one_video_white"
        android:gravity="center"
        android:id="@+id/video_motion_button_view"
        android:background="@drawable/one_video_background_rounded_12_redirect"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/vk_roboto_medium"
        android:backgroundTint="@color/one_video_azure_300"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_motion_image_view"
        app:layout_constraintEnd_toEndOf="@+id/video_motion_image_view"
        app:layout_constraintStart_toStartOf="@+id/video_motion_image_view"/>
</merge>
