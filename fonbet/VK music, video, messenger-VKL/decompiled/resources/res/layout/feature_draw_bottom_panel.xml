<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/editorBackground"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/layout_colors_panel"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tool_bottom_view"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_color_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="start|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/colors_list"
                android:background="@drawable/bg_panel_background"
                android:padding="4dp"
                android:visibility="invisible"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/internal_brush_close_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/internal_brush_close_button"
                android:visibility="invisible"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/colors_list"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.vk.photo.editor.markup.view.tools.button.ColorButton
                android:id="@+id/color_button"
                android:background="@drawable/bg_panel_background"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/color_select_button_accessibility_description"
                app:accessibilityMode="open"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/colors_list"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.vk.photo.editor.markup.view.tools.button.PipetteButton
                android:id="@+id/pipette_button"
                android:background="@drawable/bg_panel_background"
                android:padding="4dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/colors_list"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_brush_panel"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tool_bottom_view"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="end|center_vertical"
            android:id="@+id/layout_brush_container"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.vk.photo.editor.markup.view.tools.BrushesPanel
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/brush_panel"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/internal_pipette_button"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.vk.photo.editor.markup.view.tools.button.PipetteButton
                android:layout_gravity="end|center_vertical"
                android:id="@+id/internal_pipette_button"
                android:background="@drawable/bg_panel_background"
                android:padding="4dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/brush_panel"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:layout_gravity="end|bottom"
                android:id="@+id/closed_brush_panel_button"
                android:background="@drawable/bg_panel_background"
                android:visibility="invisible"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:foreground="@drawable/ripple_16dp"
                android:contentDescription="@string/open_brush_panel_button_accessibility_description"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/brush_panel">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_dismiss"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <com.vk.photo.editor.views.ToolBottomView
        android:id="@+id/tool_bottom_view"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:toolName="@string/editor_draw_bottom_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
