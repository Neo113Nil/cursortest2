<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/catalog_article_background_image_slider_width"
    android:layout_height="175dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/article_holder_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="8dp"/>
    <ImageView
        android:id="@+id/article_holder_toggle_fave"
        android:background="@drawable/highlight_circle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/catalog_fave_button_48dp"
        android:scaleType="center"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/article_holder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toTopOf="@+id/article_holder_owner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/vk_white_alpha60"
        android:gravity="center"
        android:id="@+id/article_holder_owner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/article_holder_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/article_holder_title"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/article_holder_button"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:foreground="?attr/selectableItemBackground"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fl_listen"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/article_holder_owner"
        style="@style/VkLegacyButton.White">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/read_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/vk_icon_flash_16"
            app:tint="@color/vk_black"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/vk_black"
            android:layout_gravity="center_vertical"
            android:id="@+id/read_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalog_article_read"
            android:textAllCaps="true"
            android:fontFamily="@string/font_family_medium"
            android:layout_marginStart="20dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_listen"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/article_holder_button"
        app:layout_constraintTop_toBottomOf="@+id/article_holder_owner"
        style="@style/VkLegacyButton.WhiteTransparent20">
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/listen_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalog_article_listen"
            android:textAllCaps="true"
            android:fontFamily="@string/font_family_medium"
            android:layout_marginStart="20dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
