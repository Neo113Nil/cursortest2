<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="start"
    android:background="@drawable/music_selectable_bg"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:minHeight="64dp"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/owner_image"
        android:layout_width="@dimen/catalog_link_small_content_item_width"
        android:layout_height="@dimen/catalog_link_small_content_item_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/owner_verified"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/owner_name"
        app:layout_constraintEnd_toStartOf="@+id/btn_container"
        app:layout_constraintStart_toEndOf="@+id/owner_name"
        app:layout_constraintTop_toTopOf="@+id/owner_name"
        app:layout_constraintVertical_bias="0.5"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Headline1Normal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/owner_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/owner_description"
        app:layout_constraintEnd_toStartOf="@+id/owner_verified"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/owner_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/owner_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_container"
        app:layout_constraintStart_toEndOf="@+id/owner_image"
        app:layout_constraintTop_toBottomOf="@+id/owner_name"/>
    <FrameLayout
        android:id="@+id/btn_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/owner_description"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/hide_unhide_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="small"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
