<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_recommended_playlists"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.imageloader.view.VKOverlayImageView
            android:id="@+id/signal_banner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:foreground="?attr/selectableItemBackground"
            app:emptyImagePlaceholder="@drawable/playlist_cover_placeholder"
            app:layout_constraintDimensionRatio="2.7:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:overlayDrawable="@drawable/recommended_playlist_overlay"
            app:roundedCornerRadius="@dimen/music_recommended_playlist_corner_radius"/>
        <TextView
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/signal_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/signal_banner"
            app:layout_constraintEnd_toStartOf="@+id/signal_play"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/VkUiTypography.Caption1"/>
        <TextView
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/signal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/recommended_playlist_title_with_subtitle_offset"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/signal_banner"
            app:layout_constraintEnd_toStartOf="@+id/signal_play"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/VkUiTypography.DisplayTitle4"/>
        <ImageView
            android:id="@+id/signal_play"
            android:background="@drawable/bg_white_circle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:scaleType="center"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/signal_banner"
            app:layout_constraintEnd_toEndOf="@+id/signal_banner"
            app:srcCompat="@drawable/vk_icon_play_24"
            app:tint="@color/vk_black"/>
        <include
            android:id="@+id/signal_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/signal_banner"
            layout="@layout/music_audio_item_playlist"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
