<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/pds_comment_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/pds_comment_title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/pds_comment_avatar"
        app:layout_constraintTop_toTopOf="@+id/pds_comment_avatar">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/pds_comment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:singleLine="true"
            app:vk_layout_isFluid="true"
            style="@style/VkUiTypography.TextSemiBold"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="center_vertical"
            android:id="@+id/pds_comment_verified_mark"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="2dp"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="start|center_vertical"
            android:id="@+id/pds_comment_status_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="2dp"
            app:actualImageScaleType="centerInside"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="start|center_vertical"
            android:id="@+id/pds_comment_donut_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="2dp"
            app:actualImageScaleType="centerInside"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_contrast"
            android:id="@+id/pds_comment_author_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pds_comment_author_badge"
            android:layout_marginStart="4dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            style="@style/VkUiTypography.FootnoteSemiBold"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <com.vk.core.view.components.text.expandable.VkExpandableText
        android:textColor="?attr/vk_ui_text_primary"
        android:linksClickable="false"
        android:id="@+id/pds_comment_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textDirection="locale"
        android:layout_marginEnd="16dp"
        android:hyphenationFrequency="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/pds_comment_title_container"
        app:layout_constraintTop_toBottomOf="@+id/pds_comment_title_container"
        style="@style/VkUiTypography.ParagraphSemiBold"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/pds_comment_attach_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="@+id/pds_comment_text"
        app:layout_constraintStart_toStartOf="@+id/pds_comment_text"
        app:layout_constraintTop_toBottomOf="@+id/pds_comment_text"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/pds_comment_time"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/pds_comment_text"
        app:layout_constraintTop_toBottomOf="@+id/pds_comment_attach_container"
        style="@style/VkUiTypography.FootnoteSemiBold"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/pds_comment_reply"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:text="@string/pds_comment_reply"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/pds_comment_time"
        app:layout_constraintStart_toEndOf="@+id/pds_comment_time"
        app:layout_constraintTop_toTopOf="@+id/pds_comment_time"
        style="@style/VkUiTypography.FootnoteSemiBold"/>
    <com.vk.im.design.view.comments.VkCommentAuthorLikedView
        android:id="@+id/pds_comment_author_liked_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/pds_comment_reply"
        app:layout_constraintStart_toEndOf="@+id/pds_comment_reply"
        app:layout_constraintTop_toTopOf="@+id/pds_comment_reply"/>
    <LinearLayout
        android:id="@+id/pds_comment_likes_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/pds_comment_time"
        app:layout_constraintEnd_toEndOf="@+id/pds_comment_text"
        app:layout_constraintTop_toTopOf="@+id/pds_comment_time">
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="center_vertical"
            android:id="@+id/pds_comment_likes_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:actualImageScaleType="centerInside"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/pds_comment_likes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            style="@style/VkUiTypography.FootnoteSemiBold"/>
    </LinearLayout>
</merge>
