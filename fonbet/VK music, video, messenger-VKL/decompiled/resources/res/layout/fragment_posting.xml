<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/posting_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/WhiteTheme">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/posting_scroll_content"
        android:background="?attr/vk_legacy_background_content"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="@dimen/newsfeed_newpost_bottom_panel_height"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/posting_linear_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.dto.stories.model.mention.SelectionChangeEditText
                    android:textSize="23dp"
                    android:textColor="?attr/vk_legacy_text_primary"
                    android:textColorHint="@color/vk_gray_300"
                    android:id="@+id/posting_edit_text"
                    android:background="@null"
                    android:paddingLeft="16dp"
                    android:paddingTop="14dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="14dp"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/what_new"
                    android:maxLength="16384"
                    android:inputType="textMultiLine"
                    android:fontFamily="sans-serif-light">
                    <requestFocus/>
                </com.vk.dto.stories.model.mention.SelectionChangeEditText>
                <com.vk.core.tool.view.RatioFrameLayout
                    android:id="@+id/posting_poster_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:orientation="horizontal"
                    app:ratio="0.75">
                    <com.vk.core.view.VKViewPager
                        android:id="@+id/posting_poster_background_pager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"/>
                    <com.vk.newsfeed.common.views.poster.PosterEditText
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/posting_poster_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/what_new"
                        android:inputType="textMultiLine"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14dp"
                        android:textColor="@color/vk_black"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/posting_poster_mode_button"
                        android:background="@drawable/bg_color_posts_mode"
                        android:paddingLeft="@dimen/poster_action_button_left_right_space"
                        android:paddingTop="@dimen/poster_action_button_top_bottom_space"
                        android:paddingRight="@dimen/poster_action_button_left_right_space"
                        android:paddingBottom="@dimen/poster_action_button_top_bottom_space"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"/>
                </com.vk.core.tool.view.RatioFrameLayout>
            </FrameLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/posting_attachments_recycler_view"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/posting_banner"
                android:background="@drawable/bg_best_friends_banner"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:id="@+id/posting_banner_icon"
                    android:background="@drawable/gradient_posting_unicorn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:scaleType="center"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/vk_icon_write_outline_28"
                    app:tint="@color/vk_white"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="?attr/vk_legacy_text_subhead"
                    android:id="@+id/posting_banner_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3sp"
                    android:layout_marginStart="12dp"
                    app:layout_constraintEnd_toStartOf="@+id/posting_banner_close"
                    app:layout_constraintStart_toEndOf="@+id/posting_banner_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/posting_banner_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="center"
                    android:contentDescription="@string/accessibility_hide"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/vk_icon_cancel_24"
                    app:tint="?attr/vk_legacy_icon_secondary"/>
                <com.vk.core.view.links.LinkedTextView
                    android:textSize="14sp"
                    android:textColor="@color/vk_tertiary_button_text"
                    android:gravity="start|top"
                    android:id="@+id/posting_banner_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9.5dp"
                    android:layout_marginBottom="14.5dp"
                    android:lineSpacingExtra="4sp"
                    android:fontFamily="@string/font_family_medium"
                    android:textAlignment="gravity"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/posting_banner_close"
                    app:layout_constraintStart_toEndOf="@+id/posting_banner_icon"
                    app:layout_constraintTop_toBottomOf="@+id/posting_banner_info"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <HorizontalScrollView
                android:layout_gravity="bottom"
                android:id="@+id/posting_settings_scroll_view"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/newsfeed_newpost_settings_layout_height">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:divider="@drawable/divider_post_suggest_list"
                    android:showDividers="middle">
                    <com.vk.core.view.TintTextView
                        android:id="@+id/posting_setting_donut_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:text="@string/newsfeed_newpost_for_all"
                        app:drawableEndCompat="@drawable/ic_dropdown_12"
                        style="@style/PostingSettingsTextView"/>
                    <com.vk.core.view.TintTextView
                        android:id="@+id/posting_setting_donut_duration_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:text="@string/posting_settings_paid_duration"
                        app:drawableEndCompat="@drawable/ic_dropdown_12"
                        app:drawableLeftCompat="@drawable/ic_time_16"
                        app:drawableRightCompat="@drawable/ic_dropdown_12"
                        app:drawableStartCompat="@drawable/ic_time_16"
                        style="@style/PostingSettingsTextView"/>
                    <com.vk.core.view.TintTextView
                        android:textColor="@color/vk_blue_300"
                        android:id="@+id/posting_setting_copyright_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:text="@string/posting_settings_source"
                        app:backgroundTint="?attr/vk_legacy_accent"
                        app:drawableEndCompat="@drawable/ic_dropdown_12"
                        app:drawableStartCompat="@drawable/vk_icon_link_16"
                        app:drawableTint="?attr/vk_legacy_accent"
                        style="@style/PostingSettingsTextView"/>
                    <com.vk.core.view.TintTextView
                        android:id="@+id/posting_setting_visibility_text"
                        android:layout_width="wrap_content"
                        android:text="@string/newsfeed_newpost_for_all"
                        app:drawableEndCompat="@drawable/ic_dropdown_12"
                        style="@style/PostingSettingsTextView"/>
                    <com.vk.core.view.TintTextView
                        android:id="@+id/posting_carousel_grid_switcher"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:text="@string/newsfeed_newpost_grid"
                        style="@style/PostingSettingsTextView"/>
                    <com.vk.core.view.TintTextView
                        android:id="@+id/posting_setting_group_signature_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:text="@string/newsfeed_newpost_without_sign"
                        app:drawableStartCompat="@drawable/vk_icon_user_outline_16"
                        style="@style/PostingSettingsTextView"/>
                    <com.vk.core.view.TintTextView
                        android:id="@+id/posting_setting_postpone_text"
                        android:layout_width="wrap_content"
                        android:text="@string/posting_settings_now"
                        app:drawableEndCompat="@drawable/ic_dropdown_12"
                        app:drawableStartCompat="@drawable/ic_time_16"
                        style="@style/PostingSettingsTextView"/>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:id="@+id/posting_mention_select_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <include layout="@layout/post_sources_layout"/>
    <FrameLayout
        android:background="?attr/vk_legacy_header_alternate_background"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/posting_close_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/close"
            android:layout_marginStart="2dp"
            app:srcCompat="@drawable/vk_icon_cancel_outline_28"
            app:tint="?attr/vk_legacy_header_tint_alternate"/>
        <TextView
            android:textSize="23dp"
            android:textColor="?attr/vk_legacy_text_muted"
            android:layout_gravity="center_vertical"
            android:id="@+id/posting_header_title_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_status"
            android:fontFamily="?attr/toolbar_font"
            android:layout_marginStart="64dp"/>
        <include layout="@layout/posting_sender_layout"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/posting_done_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="center"
            android:contentDescription="@string/publish_now"
            android:layout_marginEnd="4dp"
            app:srcCompat="@drawable/vk_icon_done_outline_28"/>
    </FrameLayout>
    <View
        android:id="@+id/top_divider"
        android:background="?attr/vk_legacy_separator_alpha"
        android:layout_width="match_parent"
        android:layout_height="@dimen/newsfeed_newpost_header_divider_height"
        android:layout_marginTop="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/posting_bottom_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/newsfeed_newpost_bottom_panel_height"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/posting_tab_photo_button"
            android:layout_width="@dimen/newsfeed_newpost_bottom_panel_button_width"
            android:layout_height="match_parent"
            android:contentDescription="@string/newsfeed_newpost_tab_gallery"
            app:srcCompat="@drawable/vk_icon_picture_outline_28"
            style="@style/PostingAttachCategoryItem"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/posting_tab_music_button"
            android:layout_width="@dimen/newsfeed_newpost_bottom_panel_button_width"
            android:layout_height="match_parent"
            android:contentDescription="@string/music"
            app:srcCompat="@drawable/vk_icon_music_outline_28"
            style="@style/PostingAttachCategoryItem"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/posting_tab_more_button"
            android:layout_width="@dimen/newsfeed_newpost_bottom_panel_button_width"
            android:layout_height="match_parent"
            android:contentDescription="@string/more"
            app:srcCompat="@drawable/vk_icon_more_horizontal_28"
            style="@style/PostingAttachCategoryItem"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/posting_poster_preview_recycler_view"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/newsfeed_newpost_bottom_panel_settings_button_width"/>
        <View
            android:layout_gravity="end"
            android:id="@+id/posting_poster_preview_shadow_view"
            android:background="@drawable/bg_posting_panel_shadow"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/newsfeed_newpost_bottom_panel_settings_button_width"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/posting_bottom_mention_button"
            android:layout_width="@dimen/newsfeed_newpost_bottom_panel_button_width"
            android:layout_height="match_parent"
            android:contentDescription="@string/mentions"
            android:layout_marginEnd="@dimen/newsfeed_newpost_bottom_panel_settings_button_width"
            app:srcCompat="@drawable/vk_icon_mention_outline_28"
            style="@style/PostingAttachCategoryItem"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/posting_bottom_settings_button"
            android:background="@drawable/bg_posting_panel_settings"
            android:layout_width="@dimen/newsfeed_newpost_bottom_panel_settings_button_width"
            android:layout_height="match_parent"
            android:foreground="@drawable/highlight_unlimited"
            android:contentDescription="@string/posting_settings_title"
            app:srcCompat="@drawable/vk_icon_settings_outline_28"
            style="@style/PostingAttachCategoryItem"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/posting_bottom_name_hint_text"
            android:background="?attr/vk_legacy_background_content"
            android:paddingLeft="56dp"
            android:paddingRight="56dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/posting_name_or_address"/>
        <com.vk.core.view.ColorProgressBar
            android:layout_gravity="center_vertical"
            android:id="@+id/posting_bottom_progress_bar"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:color="?attr/vk_legacy_icon_secondary"
            android:layout_marginStart="18dp"/>
        <com.vk.newsfeed.impl.posting.viewpresenter.bottom.CharacterCounterView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/posting_bottom_counter"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="48dp"/>
    </FrameLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_divider"
        android:background="?attr/vk_legacy_separator_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="@dimen/newsfeed_newpost_bottom_panel_height"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
