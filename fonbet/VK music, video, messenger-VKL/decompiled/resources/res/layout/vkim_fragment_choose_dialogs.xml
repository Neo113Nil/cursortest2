<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/im_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Vk.Theme.Appbar">
        <ViewStub
            android:id="@+id/dialogs_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="snap|enterAlways|scroll"/>
        <me.zhanghai.android.materialprogressbar.MaterialProgressBar
            android:id="@+id/im_sync_state_progress_bar"
            android:visibility="invisible"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            style="?attr/im_dialogs_state_style"/>
    </com.google.android.material.appbar.AppBarLayout>
    <ViewStub
        android:id="@+id/im_dialogs_list_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/im_appbar_shadow"
        style="@style/AppBarShadow"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/im_show_chat_history_layout"
        android:background="?attr/vk_legacy_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="16dp">
        <LinearLayout
            android:layout_gravity="start"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="68dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="@style/VkLegacyTypography.Headline.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vkim_show_chat_history"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="@style/VkLegacyTypography.Caption1.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/vkim_show_chat_history_info"/>
        </LinearLayout>
        <com.vk.im.ui.views.settings.SwitchSettingsView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/im_show_chat_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:vkim_checked="true"/>
    </FrameLayout>
    <ViewStub
        android:id="@+id/im_dialogs_search_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
