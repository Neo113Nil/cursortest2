<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="580dp"
    android:transitionName="checkoutTransition">
    <LinearLayout
        android:textColor="?attr/vk_legacy_text_primary"
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/vk_pay_checkout_confirm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="72dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed">
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:gravity="center_horizontal"
            android:id="@+id/vk_pay_checkout_confirm_title_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vk_pay_checkout_confirm_payment"
            style="@style/VkLegacyTypography.Title3.Regular"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/vk_pay_checkout_confirm_title_secondary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lines="1"
            style="@style/VkLegacyTypography.Caption1.Regular"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/vk_legacy_text_primary"
        android:id="@+id/vk_pay_checkout_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_pin_dots"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_pay_checkout_confirm_title"/>
    <com.vk.pin.views.dots.PinDotsView
        android:id="@+id/vk_pay_checkout_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_pay_checkout_amount"
        app:vk_dotsCount="4"
        app:vk_dotsFactory="com.vk.superapp.vkpay.checkout.feature.verification.keyboard.dots.CheckoutDotsFactory"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:gravity="center"
        android:id="@+id/vk_pay_checkout_hint"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_pin_keyboard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_pay_checkout_pin_dots"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
    <com.vk.pin.views.keyboard.PinKeyboardView
        android:textStyle="bold"
        android:id="@+id/vk_pay_checkout_pin_keyboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:backgroundDrawable="@drawable/pin_button_transparent"
        app:keyboardFactory="com.vk.superapp.vkpay.checkout.feature.verification.keyboard.keys.CheckoutPinKeyboardFactory"
        app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_pin_restore_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_pay_checkout_hint"
        app:marginBottom="4dp"
        app:marginEnd="12dp"
        app:marginStart="12dp"
        app:marginTop="4dp"
        app:maxSizeDiff="12dp"/>
    <TextView
        android:textColor="?attr/vk_legacy_text_link"
        android:layout_gravity="center_horizontal"
        android:id="@+id/vk_pay_checkout_pin_restore_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/vk_pay_checkout_pin_restore"
        android:fontFamily="@font/vk_roboto_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkLegacyButton.Tertiary"/>
    <View
        android:id="@+id/vk_pay_checkout_overlay"
        android:background="?attr/vk_legacy_landing_primary_button_foreground_disabled"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vk_pay_checkout_confirm_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
