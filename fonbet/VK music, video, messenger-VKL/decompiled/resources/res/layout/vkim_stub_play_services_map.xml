<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="?attr/vk_legacy_background_content"
    android:paddingTop="52dp"
    android:paddingBottom="52dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/vk_icon_error_outline_56"
        app:tint="?attr/vk_legacy_content_placeholder_icon"/>
    <TextView
        android:textSize="20sp"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/google_play_services_map"
        style="@style/VkLegacyTypography.Title2"/>
    <TextView
        android:textColor="?attr/vk_legacy_content_placeholder_text"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/google_play_services_map_description"
        style="@style/VkLegacyTypography.Headline"/>
</LinearLayout>
