<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_container"
    android:background="@drawable/carousel_skeleton_item_background"
    android:layout_width="138dp"
    android:layout_height="256dp"
    android:elevation="8dp">
    <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/image"
                android:background="@drawable/vk_bg_carousel_skeleton_image"
                android:layout_width="137dp"
                android:layout_height="138dp"
                android:layout_marginTop="0.5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/title"
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="96dp"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image"/>
            <View
                android:id="@+id/subtitle"
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="60dp"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <View
                android:id="@+id/icon"
                android:background="@drawable/carousel_skeleton_icon_background"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="34dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
            <View
                android:id="@+id/icon_description"
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="48dp"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="6dp"
                app:layout_constraintStart_toEndOf="@+id/icon"
                app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
            <View
                android:id="@+id/button"
                android:background="@drawable/vk_bg_skeleton_10dp"
                android:layout_width="114dp"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
</FrameLayout>
