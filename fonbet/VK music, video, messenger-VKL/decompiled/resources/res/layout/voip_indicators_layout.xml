<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voip_indicators_container"
    android:paddingTop="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">
    <com.vk.voip.ui.sessionrooms.view.SessionRoomIndicatorView
        android:id="@+id/session_room_indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/header_duration_text"
        android:background="@drawable/bg_gray_750_alpha32_rounded_36"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:minHeight="32dp"
        android:shadowColor="@color/vk_black_alpha24"
        android:shadowRadius="4"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/primary_tabs_view"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/session_room_indicator"
        app:layout_goneMarginTop="0dp"
        style="@style/VkLegacyTypography.Subhead1.Medium"/>
    <com.vk.voip.ui.groupcalls.list.primary.tab.PrimaryTabsView
        android:id="@+id/primary_tabs_view"
        android:layout_width="200dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/voip_pin_status_image_view"
        app:layout_constraintStart_toEndOf="@+id/header_duration_text"
        app:layout_constraintTop_toBottomOf="@+id/session_room_indicator"
        app:layout_goneMarginTop="0dp"/>
    <ImageView
        android:id="@+id/voip_pin_status_image_view"
        android:background="@drawable/voip_primary_view_pin_background"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/vk_icon_pin_16"
        android:scaleType="center"
        android:contentDescription="@string/voip_participant_pinned_accessibility"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/primary_tabs_view"
        app:layout_constraintTop_toBottomOf="@+id/session_room_indicator"
        app:layout_goneMarginTop="0dp"
        app:tint="@color/vk_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
