<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.VKTabLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/pinned_tabs"
        android:background="@drawable/transparent"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/catalog_first_pinned_tabs_height"
        app:tabMaxWidth="0dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="?attr/vk_ui_text_primary"
        app:tabTextColor="?attr/vk_ui_text_secondary"
        style="?attr/tabBarTheme"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/catalog_first_pinned_tabs_height">
        <com.vk.core.view.VKTabLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/scroll_tabs"
            android:background="@drawable/transparent"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/catalog_first_pinned_tabs_height"
            app:tabMaxWidth="0dp"
            app:tabMinWidth="0dp"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="?attr/vk_ui_text_primary"
            app:tabTextColor="?attr/vk_ui_text_secondary"
            style="?attr/tabBarTheme"/>
        <FrameLayout
            android:id="@+id/tabsSeparator"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/catalog_first_pinned_tabs_height">
            <View
                android:layout_gravity="start"
                android:background="@drawable/catalog_tab_divider_gradient"
                android:layout_width="30dp"
                android:layout_height="match_parent"/>
            <View
                android:layout_gravity="start|center_vertical"
                android:background="?attr/vk_ui_separator_primary"
                android:layout_width="0.5dp"
                android:layout_height="24dp"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
