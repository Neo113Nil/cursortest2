<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/status_image_popup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        app:actualImageScaleType="focusCrop"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/photo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            app:placeholderImage="@drawable/user_placeholder"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="@dimen/post_side_padding"
            android:paddingEnd="@dimen/post_side_padding"
            style="@style/VkUiTypography.Title2Medium"/>
        <com.vk.core.view.links.LinkedTextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/VkUiTypography.Footnote"/>
        <com.vk.core.view.components.user.stack.VkUserStackOld
            android:layout_gravity="center_horizontal"
            android:id="@+id/participants_photos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/participants_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VkUiTypography.Footnote"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>
        <com.vk.core.view.links.LinkedTextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VkUiTypography.Caption1"/>
    </LinearLayout>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/dismiss_button"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="16dp"
        android:contentDescription="@string/accessibility_hide"/>
</merge>
