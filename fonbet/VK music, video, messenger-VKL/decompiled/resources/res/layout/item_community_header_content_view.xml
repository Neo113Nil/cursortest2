<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.links.LinkedTextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/community_content_title"
        android:fadingEdgeLength="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:drawablePadding="12dp"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/community_content_subtitle"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"
        style="@style/VkUiTypography.Paragraph"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/community_content_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawablePadding="6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/community_friend_avatars"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/community_content_title"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Paragraph"/>
    <com.vk.core.view.PhotoStackView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/community_friend_avatars"
        android:background="@drawable/highlight_radius_16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
