<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_container"
    android:paddingBottom="12dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <com.vk.newsfeed.common.recycler.holders.comments.avatar.CommentAvatarView
        android:id="@+id/poster_photo"
        android:layout_width="@dimen/post_comment_avatar_size"
        android:layout_height="@dimen/post_comment_avatar_size"
        android:layout_marginTop="10dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="-4dp"
        android:layout_marginEnd="8dp"
        android:layout_alignParentStart="true"
        app:contourOverlayEnabled="true"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <View
        android:id="@+id/author_badge"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignBottom="@+id/poster_photo"
        android:translationX="2dp"
        android:layout_alignEnd="@+id/poster_photo"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/poster_name_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_alignTop="@+id/poster_photo"
        android:layout_toEndOf="@+id/poster_photo">
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/poster_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:vk_layout_isFluid="true"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="start|center_vertical"
            android:id="@+id/status"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            app:actualImageScaleType="centerInside"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/icon1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"/>
        <View
            android:layout_gravity="start|center_vertical"
            android:id="@+id/icon2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="?attr/newsfeed_post_title_color"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/comment_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="center"
            android:id="@+id/pinned_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/newsfeed_dot"
            android:singleLine="true"
            style="@style/VkUiTypography.Footnote"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/pinned_badge"
            android:background="@drawable/vk_icon_pin_16"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:backgroundTint="?attr/vk_ui_text_secondary"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/reply_to_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:singleLine="true"
        android:layout_alignTop="@+id/poster_name_view"
        android:layout_alignBottom="@+id/poster_name_view"
        android:textAlignment="gravity"
        android:layout_marginStart="9dp"
        android:layout_toEndOf="@+id/poster_name_view"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/post_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/poster_name_view"
        android:layout_alignStart="@+id/poster_name_view">
        <com.vk.core.view.links.LinkedTextView
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_primary"
            android:linksClickable="false"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            android:hyphenationFrequency="none"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/post_attach_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:divider="@drawable/comments_attach_divider"
        android:layout_below="@+id/post_view"
        android:showDividers="middle"
        android:layout_toEndOf="@+id/poster_photo"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1Medium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start"
        android:layout_gravity="start"
        android:id="@+id/post_info_view"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_below="@+id/post_attach_container"
        android:layout_marginEnd="12dp"
        android:layout_toEndOf="@+id/poster_photo"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteMedium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/comment_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reply_to"
        android:layout_alignBaseline="@+id/post_info_view"
        android:layout_alignTop="@+id/post_info_view"
        android:layout_toEndOf="@+id/post_info_view"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1Medium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="end"
        android:id="@+id/post_likes"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-16dp"
        android:drawablePadding="4dp"
        android:layout_below="@+id/post_attach_container"
        android:layout_alignBaseline="@+id/comment_reply"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:layout_marginEnd="-16dp"
        android:layout_alignParentEnd="true"
        app:drawableStartCompat="@drawable/ic_like_outline_16_xml"/>
</RelativeLayout>
