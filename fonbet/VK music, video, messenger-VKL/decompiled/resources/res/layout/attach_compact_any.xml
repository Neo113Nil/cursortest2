<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="2dp"
    android:paddingBottom="1dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingStart="@dimen/post_side_padding_story_border"
    android:paddingEnd="@dimen/post_side_padding">
    <FrameLayout
        android:id="@+id/image_container"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.newsfeed.common.views.header.HeaderPhotoView
            android:layout_gravity="start|top"
            android:id="@+id/attach_compact_image"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:contentDescription="@string/accessibility_compact_attach_photo"
            app:imageCenterX="22dp"
            app:imageCenterY="22dp"
            app:imageInset="2dp"
            app:imageRadius="20dp"
            app:imageSmallRadius="20dp"
            app:overlayImageCenterX="34dp"
            app:overlayImageCenterY="34dp"
            app:overlayImageRadius="10dp"/>
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="start|top"
            android:id="@+id/attach_compact_photo"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="@string/accessibility_compact_attach_photo"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:actualImageScaleType="centerInside"
            app:placeholderImageScaleType="fitXY"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="0.5dp"/>
    </FrameLayout>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/attach_compact_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/attach_compact_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/barrier_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/image_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/attach_compact_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:maxLines="1"
            android:textAlignment="gravity"
            app:vk_layout_isFluid="true"
            style="@style/VkUiTypography.HeadlineMedium"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/attach_compact_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="2"
        android:textAlignment="gravity"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@+id/barrier_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/image_container"
        app:layout_constraintTop_toBottomOf="@+id/attach_compact_title_container"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Subhead"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/attach_compact_restriction"
        android:paddingBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:textAlignment="gravity"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@+id/attach_compact_chevron"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/image_container"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="1dp"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/attach_compact_chevron"
        android:background="@drawable/vk_icon_chevron_right_outline_20"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:backgroundTint="?attr/vk_ui_icon_secondary"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
