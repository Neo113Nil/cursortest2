<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="12dp"
    android:layout_width="206dp"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight_radius_4"
    android:minHeight="186dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/preview"
        android:layout_width="194dp"
        android:layout_height="108dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="8dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/overlay_view"
        android:layout_width="194dp"
        android:layout_height="108dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vov_corner_radius="6dp"
        app:vov_force_redesign="true"
        app:vov_size="medium"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/image_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="overlay_view,preview"/>
    <com.vk.libvideo.design.view.duration.DurationView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/image_barrier"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.donut.design.view.badge.DonutBadge
        android:id="@+id/donut_price_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/image_barrier"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/privacy_icon"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/image_barrier"
        app:layout_constraintStart_toStartOf="@+id/image_barrier"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.libvideo.ui.UpcomingIndicatorView
        android:textAppearance="@style/VkUiTypography.Caption1Medium"
        android:gravity="center"
        android:id="@+id/video_upcoming_indicator"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="6dp"
        android:lineHeight="12sp"
        app:layout_constraintBottom_toTopOf="@+id/image_barrier"
        app:layout_constraintStart_toEndOf="@+id/privacy_icon"/>
    <com.vk.libvideo.design.view.movika.InteractiveDurationView
        android:id="@+id/interactive_duration"
        android:background="@drawable/bg_interactiv_video_duration_label_rounded_4"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/image_barrier"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_barrier"
        app:layout_goneMarginEnd="6dp"/>
    <com.vk.core.view.components.text.links.VkLinkedText
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle_views"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginEnd="6dp"/>
    <ImageView
        android:id="@+id/menu"
        android:background="@drawable/highlight_unlimited"
        android:layout_width="24dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/menu"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle_views"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
