<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.components.card.VkCard xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/half_tile_root_view"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="106dp">
    <FrameLayout
        android:id="@+id/avatars_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_margin="12dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:layout_gravity="bottom"
        android:id="@+id/subtitle_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:maxLines="2"
        style="@style/VkUiTypography.Footnote.Unscaled"/>
</com.vk.core.view.components.card.VkCard>
