<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/select_part_access_images"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="74dp">
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="@string/media_picker_part_access_info_text"
        android:maxLines="2"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="132dp"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="end|bottom"
        android:id="@+id/select_part_access_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/media_picker_part_access_settings"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="small"/>
</FrameLayout>
