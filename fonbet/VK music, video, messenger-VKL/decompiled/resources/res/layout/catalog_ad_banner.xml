<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/ad_banner_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_disclaimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="1"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/ad_disclaimer"
        android:background="?attr/vk_ui_overlay_primary"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="39dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/ad_banner_image"
        app:layout_constraintEnd_toEndOf="@+id/ad_banner_image"
        app:layout_constraintStart_toStartOf="@+id/ad_banner_image"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:id="@+id/ad_dots"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        app:capsule="true"
        app:contentBadgeAppearance="overlay"
        app:contentBadgeMode="secondary"
        app:contentBadgeSize="medium"
        app:icon="@drawable/vk_icon_more_vertical_16"
        app:layout_constraintEnd_toStartOf="@+id/close_ad"
        app:layout_constraintTop_toTopOf="@+id/ad_banner_image"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:id="@+id/close_ad"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        app:capsule="true"
        app:contentBadgeAppearance="overlay"
        app:contentBadgeMode="secondary"
        app:contentBadgeSize="medium"
        app:icon="@drawable/vk_icon_cancel_16"
        app:layout_constraintEnd_toEndOf="@+id/ad_banner_image"
        app:layout_constraintTop_toTopOf="@+id/ad_banner_image"/>
    <com.vk.libvideo.design.view.ads.AdBlockBadgeView
        android:id="@+id/ad_age"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toStartOf="@+id/ad_banner_image"
        app:layout_constraintTop_toTopOf="@+id/ad_banner_image"/>
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="11dp"
        android:layout_marginStart="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ad_banner_image"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        app:layout_constraintEnd_toStartOf="@+id/action_button"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/ad_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/VkUiTypography.SubheadMedium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="end"
            android:id="@+id/ad_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            style="@style/VkUiTypography.Caption1"/>
    </LinearLayout>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/action_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <ImageView
        android:id="@+id/action_dots"
        android:background="@drawable/highlight_round"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/common_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
