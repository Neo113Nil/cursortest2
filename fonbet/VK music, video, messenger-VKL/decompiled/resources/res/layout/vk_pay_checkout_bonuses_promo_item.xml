<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/vk_pay_checkout_alert_background_drawable"
    android:padding="12dp"
    android:layout_width="284dp"
    android:layout_height="84dp">
    <com.vk.core.ui.themes.VKReplacerView
        android:layout_gravity="center_vertical"
        android:id="@+id/vk_pay_checkout_bonuses_promo_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"/>
    <TextView
        android:layout_gravity="top"
        android:id="@+id/vk_pay_checkout_bonuses_promo_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@string/font_family_regular"
        android:layout_marginStart="12dp"
        android:letterSpacing="0.01"
        style="@style/VkRobotoRegularStyle.Title"/>
</LinearLayout>
