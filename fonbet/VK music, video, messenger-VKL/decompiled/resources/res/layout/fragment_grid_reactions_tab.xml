<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content_wrap"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/title_message"
        android:background="@drawable/bg_likes_title"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <com.vk.reactions.view.GridReactionsPaginatedView
        android:id="@+id/rpb_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
