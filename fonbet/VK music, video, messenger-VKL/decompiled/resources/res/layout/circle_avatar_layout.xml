<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/avatar_button"
    android:background="@drawable/vkui_btn_circle_avatar"
    android:layout_width="96dp"
    android:layout_height="96dp"
    android:contentDescription="@string/accessibility_avatar_choose">
    <ImageView
        android:layout_gravity="center"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_camera_outline_42"
        android:tint="@color/vk_azure_350"/>
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/avatar_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/accessibility_avatar_choose"/>
</FrameLayout>
