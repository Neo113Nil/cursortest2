<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="80dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/icon_selection_background"
        android:background="@drawable/selected_icon_background_solid"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center"
            android:id="@+id/icon_outline"
            android:background="@drawable/selected_icon_background_outline"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:backgroundTint="?attr/vk_ui_background_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon_image_view"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerInside"
            android:contentDescription="@null"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Caption2.Medium"
        android:gravity="center"
        android:id="@+id/icon_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_selection_background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
