<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/empty_click_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:background="@drawable/picker_rounded_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.vk.core.ui.bottomsheet.internal.VkBottomSheetBehavior">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/bottom_sheet_swipe_indicator"
            android:background="@drawable/bg_swipe_indicator"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"/>
        <com.vk.core.view.components.search.VkSearchView
            android:id="@+id/search_view"
            android:paddingTop="@dimen/picker_search_padding"
            android:paddingBottom="@dimen/picker_search_padding"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/picker_search_height"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"/>
        <View
            android:id="@+id/view_header_separator"
            android:background="@color/vk_black_alpha12"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:alpha="0"/>
        <FrameLayout
            android:id="@+id/list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/vp_pager"
                android:paddingBottom="@dimen/picker_tabs_container_height"
                android:visibility="visible"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.vk.attachpicker.stickers.selection.views.SearchRecyclerPaginatedView
                android:id="@+id/rv_search"
                android:visibility="gone"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="true"/>
            <com.vk.attachpicker.stickers.selection.views.GifSearchSkeletonView
                android:id="@+id/gif_skeleton"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fl_tabs_container"
        android:background="?attr/vk_ui_background_contrast_themed"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/picker_tabs_container_height"/>
</merge>
