<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="12dp"
        style="@style/VkLegacyTypography.Caption.Regular"/>
    <ProgressBar
        android:layout_gravity="center_vertical"
        android:id="@+id/progress"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="12dp"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/open"
        android:layout_width="16dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:translationY="-1dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        app:srcCompat="@drawable/vk_icon_chevron_24"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_gravity="center_vertical"
        android:id="@+id/switch_view"
        android:layout_width="56dp"
        android:layout_height="44dp"
        android:text=""
        android:layout_marginStart="12dp"/>
</merge>
