<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end|top"
    android:orientation="horizontal"
    android:id="@+id/poster_author_layout"
    android:visibility="invisible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="8dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1CapsMedium.Unscaled"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/poster_author_text"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.5dp"
        android:layout_marginStart="2dp"
        app:srcCompat="@drawable/vk_icon_chevron_16"
        app:tint="@color/vk_white"/>
</LinearLayout>
