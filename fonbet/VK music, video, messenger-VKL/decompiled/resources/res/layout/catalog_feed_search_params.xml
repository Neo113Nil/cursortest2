<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/filter_sort_type_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/feed_catalog_filters_sort"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/separator"/>
    <RadioGroup
        android:id="@+id/sort_types"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/filter_sort_type_title">
        <com.vk.core.view.components.radio.VkRadioButton
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:id="@+id/by_relevance"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feed_catalog_filters_sort_relevance"
            android:paddingStart="10dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VkUiTypography.Text"/>
        <com.vk.core.view.components.radio.VkRadioButton
            android:id="@+id/by_time"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feed_catalog_filters_sort_date"
            android:paddingStart="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VkUiTypography.Text"/>
    </RadioGroup>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/filter_other_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/feed_catalog_filters_other"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_types"/>
    <com.vk.core.view.components.checkbox.VkCheckboxItem
        android:id="@+id/filter_remove_duplicates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:checkboxType="square"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/filter_other_title"
        app:title="@string/feed_catalog_filters_remove_duplicates"/>
</merge>
