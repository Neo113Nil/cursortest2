<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.VKTabLayout
        android:id="@+id/vkim_chat_profile_tabs__tab_layout"
        app:layout_constraintBottom_toTopOf="@+id/vkim_chat_profile_tabs__viewpager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabGravity="fill"
        app:tabMode="scrollable"
        style="?attr/tabBarTheme"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vkim_chat_profile_tabs__viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vkim_chat_profile_tabs__tab_layout"/>
</merge>
