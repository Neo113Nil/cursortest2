<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.stickers.views.VKStickerCachedImageView
        android:id="@+id/sticker_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/popup_sticker_icon"
        android:background="@drawable/bg_popup_sticker_play_btn"
        android:padding="4dp"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/vk_icon_play_12"
        android:contentDescription="@string/sticker_accessibility_popup_play_button"
        app:tint="@color/vk_white"/>
    <ProgressBar
        android:layout_gravity="end|bottom"
        android:id="@+id/loader"
        android:background="@drawable/bg_popup_sticker_play_btn"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="4dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/vk_white"
        android:indeterminateTintMode="src_in"
        style="?android:attr/progressBarStyle"/>
</merge>
