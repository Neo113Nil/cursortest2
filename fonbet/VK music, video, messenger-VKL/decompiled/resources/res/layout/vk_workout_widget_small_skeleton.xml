<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/vgRoot"
    android:layout_width="146dp"
    android:layout_height="146dp">
    <ImageView
        android:id="@+id/ivAppWidgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/vk_workout_widget_bg"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/vgCounter"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:background="@drawable/vk_workout_widget_skeleton_rectangle"
            android:layout_width="102dp"
            android:layout_height="18dp"
            style="@style/VkWorkoutWidget.Title"/>
        <ImageView
            android:background="@drawable/vk_workout_widget_skeleton_rectangle"
            android:layout_width="72dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            style="@style/VkWorkoutWidget.WorkoutsCount"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vgTrainingDistance"
            android:background="@drawable/vk_workout_widget_distance_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">
            <ImageView
                android:background="@drawable/vk_workout_widget_skeleton_rectangle"
                android:layout_width="64dp"
                android:layout_height="18dp"
                android:alpha="0.2"
                style="@style/VkWorkoutWidget.DistanceTitle"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:background="@drawable/vk_workout_widget_skeleton_rectangle"
                    android:layout_width="52dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0.2"
                    style="@style/VkWorkoutWidget.Distance"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:background="@drawable/vk_workout_widget_skeleton_rectangle"
                    android:layout_width="16dp"
                    android:layout_height="12dp"
                    android:alpha="0.2"
                    android:layout_marginStart="2dp"
                    style="@style/VkWorkoutWidget.Distance"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
