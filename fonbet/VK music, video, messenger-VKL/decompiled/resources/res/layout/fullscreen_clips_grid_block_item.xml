<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/clip_item_video_texture_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/clip_item_skeleton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/clip_item_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"/>
    <com.vk.clips.design.view.component.badge.ClipBadge
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/clip_item_badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_l"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_l"/>
    <View
        android:id="@+id/clip_item_transition_overlay"
        android:background="?attr/vk_ui_background_secondary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
