<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/polls_grade_title"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Title2"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/polls_grade_slider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/polls_grade_title"
        style="@style/PollsSliderStyle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/poll_grade_min_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/polls_grade_slider"
        app:layout_constraintStart_toStartOf="@+id/polls_grade_slider"
        style="@style/VkUiTypography.Footnote"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/poll_grade_max_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/polls_grade_slider"
        app:layout_constraintEnd_toEndOf="@+id/polls_grade_slider"
        style="@style/VkUiTypography.Footnote"/>
</merge>
