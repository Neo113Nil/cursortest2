<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:paddingLeft="@dimen/vk_app_catalog_section_left_padding"
    android:paddingRight="@dimen/vk_app_catalog_section_right_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp">
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/apps_section_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:maxLines="1"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/apps_section_header_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/apps_section_header_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="9dp"
        app:layout_goneMarginEnd="16dp"
        style="@style/VkUiTypography.FootnoteCapsMedium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/apps_section_header_subtitle"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="9dp"
        android:maxLines="1"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/apps_section_header_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/apps_section_header_title"
        app:layout_goneMarginEnd="16dp"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/apps_section_header_button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
