<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/common_holder_frame_layout"
    android:paddingLeft="@dimen/post_side_padding"
    android:paddingTop="7dp"
    android:paddingRight="@dimen/post_side_padding"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/attach_icon"
        android:layout_width="@dimen/post_attach_common_icon_size"
        android:layout_height="@dimen/post_attach_common_icon_size"
        android:layout_marginTop="1dp"
        android:scaleType="centerInside"
        app:tint="?attr/vk_ui_icon_medium"/>
    <FrameLayout
        android:id="@+id/attach_error_view"
        android:visibility="gone"
        android:layout_width="@dimen/post_attach_common_icon_size"
        android:layout_height="@dimen/post_attach_common_icon_size"
        android:layout_marginTop="1dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/vk_icon_replay_36"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/attach_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/attachment"
        android:maxLines="1"
        android:layout_marginStart="@dimen/post_attach_common_text_left_space"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/newsfeed_attach_subtitle_color"
        android:id="@+id/attach_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21sp"
        android:text="@string/attach_link"
        android:maxLines="1"
        android:layout_marginStart="@dimen/post_attach_common_text_left_space"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/attach_common_remove_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:scaleType="center"
        android:contentDescription="@string/delete"
        app:srcCompat="@drawable/vk_icon_cancel_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
</FrameLayout>
