<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_ripple"
    android:paddingTop="0dp"
    android:paddingBottom="4dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/post_side_padding_avatar"
    android:paddingEnd="@dimen/post_side_padding_small">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/photo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:borderStrokeWidth="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/friends_and_subtitle_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/online"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/photo"
        app:layout_constraintEnd_toEndOf="@+id/photo"/>
    <TextView
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:fontFamily="@string/font_family_medium"
        android:layout_marginStart="6dp"
        android:letterSpacing="-0.007"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/friends_and_subtitle_container"
        app:layout_constraintEnd_toStartOf="@+id/icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/photo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="6dp"
        style="@style/VkLegacyTypography.Text.Medium"/>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/actions_button"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/friends_and_subtitle_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="6dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/actions_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <com.vk.core.view.PhotoStackView
            android:id="@+id/common_friends"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginEnd="2dp"
            app:placeholder="@drawable/user_placeholder"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkLegacyTypography.Caption1.Regular"/>
    </LinearLayout>
    <com.vk.core.view.ProgressIconButton
        android:id="@+id/actions_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:iconTint="?attr/vk_legacy_icon_tertiary"
        app:layout_constraintBottom_toBottomOf="@+id/friends_and_subtitle_container"
        app:layout_constraintEnd_toStartOf="@+id/negative_button"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_user_added_outline_28"/>
    <com.vk.core.view.ProgressIconButton
        android:id="@+id/negative_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:iconTint="?attr/vk_legacy_icon_tertiary"
        app:layout_constraintBottom_toBottomOf="@+id/friends_and_subtitle_container"
        app:layout_constraintEnd_toStartOf="@+id/positive_button"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_cancel_circle_outline_28"/>
    <com.vk.core.view.ProgressIconButton
        android:id="@+id/positive_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:iconTint="?attr/vk_legacy_accent"
        app:layout_constraintBottom_toBottomOf="@+id/friends_and_subtitle_container"
        app:layout_constraintEnd_toStartOf="@+id/call_button"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_user_add_outline_28"/>
    <ImageView
        android:id="@+id/call_button"
        android:background="@drawable/highlight_circle"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/friends_and_subtitle_container"
        app:layout_constraintEnd_toStartOf="@+id/message_button"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_phone_outline_28"/>
    <ImageView
        android:id="@+id/message_button"
        android:background="@drawable/highlight_circle"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/friends_and_subtitle_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_message_outline_28"/>
</androidx.constraintlayout.widget.ConstraintLayout>
