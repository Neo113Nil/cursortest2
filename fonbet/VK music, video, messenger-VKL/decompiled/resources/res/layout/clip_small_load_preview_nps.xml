<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="@dimen/clips_upload_badge_width"
    android:layout_height="@dimen/clips_upload_badge_height"
    app:cardCornerRadius="6dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/clip_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@drawable/clip_placeholder"
        app:placeholderImageScaleType="fitCenter"/>
    <View
        android:background="@color/vk_black_alpha35"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.cardview.widget.CardView>
