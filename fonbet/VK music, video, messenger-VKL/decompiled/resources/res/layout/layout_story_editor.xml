<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/left_story_skeleton"
        android:background="@drawable/bg_story_edit_skeleton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="110dp"
        android:layout_marginEnd="32dp"/>
    <View
        android:id="@+id/right_story_skeleton"
        android:background="@drawable/bg_story_edit_skeleton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="110dp"
        android:layout_marginStart="32dp"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/preview_glow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/bg_story_glow"
        android:alpha="0.6"/>
    <com.vk.stories.design.view.stickers.StickersDrawingViewGroup
        android:id="@+id/sdv_stickers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:with_background_view="true"/>
    <View
        android:layout_gravity="start|top"
        android:id="@+id/story_editor_close_background_view"
        android:background="@drawable/stories_vertical_blur_left"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="104dp"
        android:alpha="0.64"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_gradient"
        android:background="@drawable/vk_gradient_bottom_112"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:alpha="0.24"/>
    <com.vk.stories.tool.view.NoOverlappingRenderingFrameLayout
        android:id="@+id/fl_top_buttons_panel"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.stories.tool.view.NoOverlappingRenderingImageView
                android:layout_gravity="start|top"
                android:id="@+id/iv_close"
                android:background="@drawable/bg_story_button_rounded"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="16dp"
                android:src="@drawable/vk_icon_chevron_outline_shadow_large_48"
                android:scaleType="center"
                android:contentDescription="@string/talkback_ic_back"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/meta_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-8dp">
                <TextView
                    android:textColor="?attr/vk_ui_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/stub_story_view_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    style="@style/VkUiTypography.SubheadSemiBold"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/stub_story_view_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    style="@style/VkUiTypography.Caption1"/>
            </LinearLayout>
        </LinearLayout>
        <com.vk.stories.tool.view.NoOverlappingRenderingImageView
            android:layout_gravity="start|top"
            android:id="@+id/sharing_compact_image"
            android:background="@drawable/white_ripple_circle"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_story_repost_48"
            android:scaleType="center"
            android:layout_marginStart="56dp"/>
        <com.vk.stories.tool.view.NoOverlappingRenderingTextView
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/open_camera"
            android:background="@drawable/bg_open_camera"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            android:text="@string/story_open_camera"
            android:singleLine="true"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            app:drawableStartCompat="@drawable/vk_icon_camera_outline_24"
            app:drawableTint="@android:color/white"
            style="@style/VkUiTypography.Headline2Medium"/>
        <com.vk.stories.tool.view.NoOverlappingRenderingTextView
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/change_photo"
            android:background="@drawable/bg_open_camera"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            android:text="@string/story_change_photo"
            android:singleLine="true"
            android:contentDescription="@string/story_change_photo"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/VkUiTypography.Headline2Medium"/>
    </com.vk.stories.tool.view.NoOverlappingRenderingFrameLayout>
    <com.vk.stories.design.view.editor.SideControlPanelView
        android:layout_gravity="end|top"
        android:id="@+id/side_control_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom_16percent"
        android:layout_width="match_parent"
        android:layout_height="340dp"/>
    <com.vk.stories.tool.view.NoOverlappingRenderingFrameLayout
        android:layout_gravity="top"
        android:id="@+id/fl_drawing_undo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="104dp">
        <View
            android:layout_gravity="end|top"
            android:background="@drawable/stories_vertical_blur_right"
            android:layout_width="88dp"
            android:layout_height="104dp"
            android:alpha="0.64"/>
        <com.vk.stories.tool.view.NoOverlappingRenderingImageView
            android:layout_gravity="end|top"
            android:id="@+id/iv_drawing_undo"
            android:background="@drawable/white_ripple_unbounded"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/vk_icon_undo_outline_shadow_large_48"
            android:scaleType="centerInside"
            android:contentDescription="@string/story_accessibility_drawing_undo"
            app:tint="@color/vk_white"/>
    </com.vk.stories.tool.view.NoOverlappingRenderingFrameLayout>
    <com.vk.stories.design.view.editor.StickerDeleteAreaView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/stickers_delete_area"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="18dp"/>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/fl_verticalization_banner_stub"
        android:layout="@layout/layout_story_editor_verticalization_banner"
        android:inflatedId="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.stories.design.view.editor.StoryStylePickerView
            android:layout_gravity="center"
            android:id="@+id/repost_style_picker"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/bottom_control_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/remove"
        android:background="@drawable/bg_story_edit_delete_new"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_delete"
        app:srcCompat="@drawable/vk_icon_delete_outline_20"
        app:tint="@android:color/white"/>
    <FrameLayout
        android:id="@+id/fl_stickers_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/fl_draw_panel_stub"
        android:visibility="gone"
        android:layout="@layout/layout_draw_panel"
        android:inflatedId="@+id/fl_draw_panel"
        android:layout_width="match_parent"
        android:layout_height="130dp"/>
    <TextView
        android:textColor="@color/vk_gray_100"
        android:gravity="start|center_vertical"
        android:layout_gravity="bottom"
        android:id="@+id/story_editor_music_restriction_text"
        android:background="@drawable/bg_music_restriction_text"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="112dp"
        android:text="@string/story_editor_reply_sound_off"
        style="@style/VkUiTypography.Headline2Normal.Unscaled"/>
</merge>
