<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_market_product_tile"
    android:background="@drawable/ecomm_ds_internal_bg_tile"
    android:paddingBottom="@dimen/vk_ui_spacing_size_m"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.picture.VkPicture
        android:id="@+id/iv_main_image"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_xs"
        android:layout_marginHorizontal="@dimen/market_product_tile_image_horizontal_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/vk_icon_gallery_outline_56"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="@dimen/vk_ui_border_radius"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="@dimen/vk_ui_border2x"
        app:viewAspectRatio="@dimen/ecomm_ds_internal_tile_image_aspect"/>
    <com.vk.ecomm.design.view.tile.MarketProductTilePaginatedImagesView
        android:id="@+id/view_paginated_images"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_main_image"
        app:layout_constraintEnd_toEndOf="@+id/iv_main_image"
        app:layout_constraintStart_toStartOf="@+id/iv_main_image"
        app:layout_constraintTop_toTopOf="@+id/iv_main_image"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/iv_moderation_icon"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_main_image"
        app:layout_constraintEnd_toEndOf="@+id/iv_main_image"
        app:layout_constraintStart_toStartOf="@+id/iv_main_image"
        app:layout_constraintTop_toTopOf="@+id/iv_main_image"
        app:srcCompat="@drawable/vk_icon_hide_outline_shadow_medium_48"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_price"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_xs"
        android:minHeight="18dp"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_s"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_main_image"
        app:layout_goneMarginEnd="@dimen/vk_ui_spacing_size_s"
        style="@style/VkUiTypography.SubheadMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/ecomm_market_tile_second_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_s"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_price"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_price"
        app:layout_constraintTop_toTopOf="@+id/tv_price"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_name"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
        android:fallbackLineSpacing="false"
        app:layout_constraintEnd_toEndOf="@+id/iv_main_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_price"
        app:layout_goneMarginEnd="@dimen/vk_ui_spacing_size_s"
        app:layout_goneMarginTop="4dp"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_tertiary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_owner_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="16dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_s"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.ecomm.design.view.tile.MarketItemRatingSnippetView
        android:id="@+id/view_market_rating"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
        android:minHeight="16dp"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_owner_name"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_product_properties"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_market_rating"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/iv_favorite"
        android:background="@drawable/ecomm_ds_internal_tile_top_end_icon_highlight"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_main_image"
        app:layout_constraintTop_toTopOf="@+id/iv_main_image"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/is_selected_tag"
        android:background="@drawable/ecomm_ds_internal_tile_top_end_icon_highlight"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_main_image"
        app:layout_constraintTop_toTopOf="@+id/iv_main_image"
        app:srcCompat="@drawable/vk_icon_check_circle_filled_blue_shadow_medium_48"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/right_tags_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:constraint_referenced_ids="iv_favorite, is_selected_tag"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rv_badges"
        android:visibility="gone"
        android:clipToPadding="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/right_tags_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_main_image"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:id="@+id/tv_status_badge"
        android:background="@drawable/ecomm_ds_internal_bg_status_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_s"
        android:maxLines="1"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
        android:paddingHorizontal="@dimen/vk_ui_spacing_size_s"
        android:paddingVertical="@dimen/vk_ui_spacing_size_xs"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_main_image"
        app:layout_constraintEnd_toEndOf="@+id/iv_main_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/iv_main_image"
        style="@style/VkUiTypography.Caption1"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/square_cta_button"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:elevation="4dp"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_m"
        android:layout_marginVertical="@dimen/vk_ui_spacing_size_m"
        android:paddingHorizontal="@dimen/vk_ui_spacing_size_s"
        android:paddingVertical="@dimen/vk_ui_spacing_size_s"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="@+id/iv_main_image"
        app:layout_constraintEnd_toEndOf="@+id/iv_main_image"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/iv_main_image"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/cta_button"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_s"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_s"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_properties"
        app:layout_constraintVertical_bias="1"/>
</merge>
