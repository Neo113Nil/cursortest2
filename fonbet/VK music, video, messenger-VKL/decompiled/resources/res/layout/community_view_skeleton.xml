<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <com.vk.community.design.view.skeleton.community.header.CommunityHeaderSkeleton
            android:id="@+id/header_skeleton_shimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.community.design.view.skeleton.community.header.CommunityLiveHeaderSkeleton
            android:id="@+id/live_header_skeleton_shimmer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.vk.community.design.view.skeleton.community.post.CommunityContentSkeleton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
