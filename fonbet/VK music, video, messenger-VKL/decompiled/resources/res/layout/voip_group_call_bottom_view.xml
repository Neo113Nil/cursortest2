<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/voip_call_invite_footer"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/voip_call_invite_name_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voip_call_invite_name_description"/>
    <EditText
        android:id="@+id/voip_call_invite_name"
        android:background="@drawable/vk_auth_bg_landing_edittext"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:hint="@string/voip_call_invite_name_placeholder"
        android:maxLength="50"
        android:inputType="text"
        style="@style/VkAuth.EditText.Landing"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center"
        android:id="@+id/anonym_call_legal_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/voip_call_invite_join_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">
        <com.vk.core.view.components.button.VkButton
            android:textAppearance="@style/VkUiTypography.Headline1Medium"
            android:id="@+id/voip_call_join_with_video"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:icon="@drawable/vkui_ic_voip_call_video_24"
            app:text="@string/voip_call_invite_dialog_join_video_btn"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/voip_call_join"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:scaleType="centerInside"
            android:layout_marginStart="12dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:icon="@drawable/vk_icon_phone_24"
            app:tint="?attr/vk_ui_text_contrast_themed"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/voip_call_link_share_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp">
        <com.vk.core.view.components.button.VkButton
            android:textAppearance="@style/VkUiTypography.Headline1Medium"
            android:layout_gravity="center"
            android:id="@+id/voip_call_link_share_btn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vkim_share_link"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"
            app:drawableTint="?attr/vk_ui_text_accent_themed"
            app:icon="@drawable/vk_icon_share_outline_24"/>
    </FrameLayout>
</LinearLayout>
