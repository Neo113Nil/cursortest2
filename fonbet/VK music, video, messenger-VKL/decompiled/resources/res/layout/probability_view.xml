<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        app:vk_appbar_forceMode="separator"
        style="@style/AppBarShadow"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/probability_note_tv"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</LinearLayout>
