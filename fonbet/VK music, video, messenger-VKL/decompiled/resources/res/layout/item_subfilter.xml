<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="64dp"
    android:importantForAccessibility="no">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/layout_filter_preview_wrapper"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="yes">
        <ImageView
            android:id="@+id/image_filter_preview"
            android:background="@drawable/bg_rounded_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/selected_stroke_view"
            android:background="@drawable/subfilter_selected_stroke_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.vk.photo.editor.views.shimmer.ShimmerFrameLayout
        android:id="@+id/loading_state_frame_layout"
        android:layout_width="wrap_content"
        android:layout_height="64dp">
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_filter_skeleton"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </com.vk.photo.editor.views.shimmer.ShimmerFrameLayout>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/error_frame_layout"
        android:layout_width="wrap_content"
        android:layout_height="64dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/retry_button"
            android:background="@drawable/bg_subfilter_skeleton"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_retry_24"
            android:contentDescription="@string/editor_accessibility_retry"/>
    </FrameLayout>
</FrameLayout>
