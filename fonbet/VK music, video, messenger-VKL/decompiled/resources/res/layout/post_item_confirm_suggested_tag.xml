<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <View
        android:id="@+id/photo"
        android:layout_width="48dp"
        android:layout_height="48dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:layout_marginStart="60dp">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/photo_tags_confirm_suggested_is_this_you"
            style="@style/VkUiTypography.Subhead"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            style="@style/VkUiTypography.Subhead"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.vk.core.view.components.button.VkSimpleButton
                android:id="@+id/accept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/photo_tags_confirm_suggested"
                android:singleLine="true"
                android:layout_marginEnd="8dp"
                app:buttonAppearance="accent"
                app:buttonMode="primary"
                app:buttonSizeType="medium"/>
            <com.vk.core.view.components.button.VkSimpleButton
                android:id="@+id/reject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/photo_tags_decline_suggested"
                android:singleLine="true"
                app:buttonMode="secondary"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</FrameLayout>
