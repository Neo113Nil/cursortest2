<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification_root"
    android:paddingRight="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/cover"
        android:background="#80384554"
        android:layout_width="@android:dimen/notification_large_icon_width"
        android:layout_height="@android:dimen/notification_large_icon_height"
        android:src="@drawable/aplayer_cover_placeholder"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingRight="8dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadBold"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="marquee"
            android:id="@+id/title"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Custom title"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.FootnoteNormal"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="marquee"
            android:id="@+id/content"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Content!!!!1one"
            android:singleLine="true"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/playpause"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_pause_24"
        style="?android:attr/borderlessButtonStyle"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/next"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_skip_next_24"
        style="?android:attr/borderlessButtonStyle"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/stop"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        app:srcCompat="@drawable/vk_icon_cancel_24"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
