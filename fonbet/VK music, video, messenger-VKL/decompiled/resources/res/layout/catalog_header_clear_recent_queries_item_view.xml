<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/post_side_padding">
        <TextView
            android:textStyle="normal"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:layout_marginEnd="8dp"
            style="@style/VkUiTypography.FootnoteMedium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:id="@+id/badge"
            android:background="@drawable/catalog_header_badge_prominent"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:minWidth="20dp"
            android:singleLine="true"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            style="@style/VkUiTypography.SubheadNormal"/>
    </LinearLayout>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/clear_container"
        android:background="@drawable/music_playlist_selectable_bg_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/music_button_clear"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/VkUiTypography.SubheadNormal"/>
</FrameLayout>
