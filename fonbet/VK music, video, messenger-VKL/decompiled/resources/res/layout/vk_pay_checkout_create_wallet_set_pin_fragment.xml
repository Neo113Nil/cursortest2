<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="536dp"
    android:transitionName="checkoutTransition">
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/vk_pay_checkout_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="72dp"
        android:text="@string/vk_pay_checkout_enter_new_pin"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_pin_dots"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.pin.views.dots.PinDotsView
        android:id="@+id/vk_pay_checkout_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_pin_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_pay_checkout_pin_title"
        app:vk_dotsCount="4"
        app:vk_dotsFactory="com.vk.superapp.vkpay.checkout.feature.verification.keyboard.dots.CheckoutDotsFactory"/>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/vk_pay_checkout_pin_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/vk_pay_checkout_pin_keyboard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
    <com.vk.pin.views.keyboard.PinKeyboardView
        android:textStyle="bold"
        android:id="@+id/vk_pay_checkout_pin_keyboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:backgroundDrawable="@drawable/pin_button_transparent"
        app:keyboardFactory="com.vk.superapp.vkpay.checkout.feature.pin.CheckoutPinNoBiometricKeyboardFactory"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:marginBottom="4dp"
        app:marginEnd="12dp"
        app:marginStart="12dp"
        app:marginTop="4dp"
        app:maxSizeDiff="12dp"/>
    <View
        android:id="@+id/overlay"
        android:background="?attr/vk_legacy_landing_primary_button_foreground_disabled"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vk_pay_checkout_pin_title"/>
    <com.vk.superapp.vkpay.checkout.feature.pin.success.PinSuccessView
        android:id="@+id/vk_pay_checkout_pin_success"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vk_text="@string/vk_pay_checkout_pin_set_success"/>
</androidx.constraintlayout.widget.ConstraintLayout>
