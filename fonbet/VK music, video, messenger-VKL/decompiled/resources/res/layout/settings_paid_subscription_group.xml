<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlight"
    android:paddingTop="7dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding_menu">
    <View
        android:layout_gravity="start|top"
        android:id="@+id/arrow"
        android:background="@drawable/vk_icon_arrow_turn_right_outline_20"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="8dp"
        android:backgroundTint="?attr/vk_ui_icon_secondary"/>
    <com.vk.imageloader.view.VKCircleImageView
        android:layout_gravity="start|top"
        android:id="@+id/photo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        app:placeholderImage="@drawable/user_placeholder"
        app:placeholderImageScaleType="fitXY"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <LinearLayout
        android:layout_gravity="start|top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="20dp"
                android:maxLines="1"
                android:textAlignment="gravity"
                app:vk_layout_isFluid="true"
                style="@style/VkUiTypography.Paragraph"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/verified_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:minHeight="20dp"
            android:maxLines="1"
            android:textAlignment="gravity"
            style="@style/VkUiTypography.Paragraph"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/subtitle2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="16dp"
            android:maxLines="1"
            android:textAlignment="gravity"
            style="@style/VkUiTypography.Footnote"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/actions"
        android:background="@drawable/highlight_unbounded"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/common_actions"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</LinearLayout>
