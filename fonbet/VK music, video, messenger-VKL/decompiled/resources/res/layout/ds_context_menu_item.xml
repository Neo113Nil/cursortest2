<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="44dp"
    android:paddingHorizontal="@dimen/vk_ui_spacing_size2_xl"
    android:paddingVertical="@dimen/vk_ui_spacing_size_l">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/left_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/vk_ui_base_padding_horizontal"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_tertiary"
        android:layout_gravity="center_vertical"
        android:id="@+id/detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vk_ui_base_padding_horizontal"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/right_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/vk_ui_spacing_size2_xl"/>
</LinearLayout>
