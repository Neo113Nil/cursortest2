<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/vk_app_error_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:srcCompat="@drawable/vk_icon_globe_cross_outline_56"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/VkUiTypography.Title2Medium"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/vk_apps_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_apps_loading_error_simple"
            app:lineHeight="24dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/VkUiTypography.Text"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/vk_apps_error_description"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:lineHeight="20dp"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/vk_apps_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/vk_common_retry"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/show_console"
        android:background="@drawable/vk_bg_show_console_ripple"
        android:padding="15dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="76dp"
        android:text="@string/vk_show_debug_console"
        android:drawablePadding="15dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:drawableStartCompat="@drawable/vk_icon_brackets_square_outline_28"
        app:drawableTint="?attr/vk_ui_text_accent"
        style="@style/VkUiTypography.DisplayTitle4Normal"/>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/vk_apps_error_bottom_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <ImageView
        android:layout_gravity="top|left"
        android:id="@+id/vk_close_button"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="14dp"
        app:srcCompat="@drawable/vk_icon_cancel_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
</FrameLayout>
