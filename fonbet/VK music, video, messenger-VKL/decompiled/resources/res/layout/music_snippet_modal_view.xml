<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/snippet_layout"
        android:background="@drawable/music_white_round_rect_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="marquee"
            android:gravity="start"
            android:id="@+id/snippet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/music_snippet_title"
            android:singleLine="true"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.music.view.ThumbsImageView
            android:id="@+id/image"
            android:layout_width="@dimen/music_snippet_thumb_size"
            android:layout_height="@dimen/music_snippet_thumb_size"
            android:layout_marginTop="24dp"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/snippet_title"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="16dp"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_song_outline_56"
            app:tiv_empty_tint="?attr/vk_ui_icon_secondary"
            app:viewAspectRatio="1"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.DisplayTitle2"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/track_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:singleLine="true"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2Normal"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/track_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/track_name"/>
        <com.vk.music.snippet.ui.preview.MusicSnippetPreviewProgressView
            android:id="@+id/progressView"
            android:layout_width="@dimen/music_snippet_thumb_size"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/track_artist"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start"
        android:id="@+id/add_to_music_layout"
        android:background="@drawable/music_white_round_rect_12dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/music_snippet_add_button_height"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/add_to_music_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@drawable/vk_icon_add_outline_28"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline1Normal"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/add_to_music_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_snippet_add_track_button"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="64dp"
            app:layout_constraintBottom_toBottomOf="@+id/add_to_music_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/add_to_music_icon"
            app:layout_constraintTop_toTopOf="@+id/add_to_music_icon"/>
        <View
            android:id="@+id/add_to_music_button"
            android:background="@drawable/music_round_rect_ripple_12dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/music_talkback_add_audio"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
