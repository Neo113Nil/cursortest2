<?xml version="1.0" encoding="utf-8"?>
<com.vk.feed.tool.view.newsfeed.attach.PrimaryAttachmentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attach"
    android:layout_width="match_parent"
    android:layout_height="0dp">
    <com.vk.feed.tool.view.newsfeed.image.FixedSizeFrescoImageViewLegacy
        android:id="@+id/image_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:vkim_emptyPlaceholder="?attr/vk_ui_image_placeholder"
        app:vkim_placeholderDrawable="?attr/vk_ui_image_placeholder"
        app:vkim_scaleType="center_crop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="5dp"
            android:scaleType="centerInside"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/vk_icon_picture_stack_outline_20"
            app:tint="@color/vk_white"/>
        <TextView
            android:textColor="@color/vk_white"
            android:gravity="center_vertical"
            android:id="@+id/counter"
            android:paddingTop="0.5dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:singleLine="true"
            android:alpha="0.9"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"
            style="@style/VkUiTypography.Caption1Medium"/>
        <TextView
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/VkUiTypography.Title2Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.feed.design.view.newsfeed.restriction.RestrictedPhotoView
        android:layout_gravity="center"
        android:id="@+id/restriction_view"
        android:padding="32dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.vk.feed.tool.view.newsfeed.attach.PrimaryAttachmentLayout>
