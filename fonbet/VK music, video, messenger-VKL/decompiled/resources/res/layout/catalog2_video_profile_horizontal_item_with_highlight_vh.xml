<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_rounded_100"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:backgroundTint="?attr/vk_ui_background_secondary_alpha">
    <com.vk.core.tool.view.onboarding.highlighter.VkOnboardingHighlighter
        android:layout_gravity="center_vertical"
        android:id="@+id/highlight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:autoHighlight="false"
        app:highlightVerticalPadding="24"
        app:highlighterColor="lime"
        app:highlighterType="type1">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            style="@style/VkUiTypography.SubheadMedium"/>
    </com.vk.core.tool.view.onboarding.highlighter.VkOnboardingHighlighter>
</FrameLayout>
