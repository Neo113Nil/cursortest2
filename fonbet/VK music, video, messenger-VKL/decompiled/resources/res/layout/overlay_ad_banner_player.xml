<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.components.card.VkCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:maxHeight="124dp"
        android:minHeight="106dp">
        <View
            android:id="@+id/background_view"
            android:background="?attr/vk_ui_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.7"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/close_button"
            app:layout_constraintStart_toEndOf="@+id/image"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Headline2"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary_alpha"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/close_button"
            app:layout_constraintStart_toEndOf="@+id/image"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/VkUiTypography.Subhead"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cta_and_label_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/disclaimer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image"
            app:layout_constraintTop_toBottomOf="@+id/subtitle">
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/cta_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="164dp"
                android:minWidth="85dp"
                android:layout_marginEnd="8dp"
                app:buttonAppearance="accent"
                app:buttonMode="secondary"
                app:buttonSizeType="small"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ad_icon"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/VkUiTypography.SubheadMedium"/>
            <com.vk.core.view.components.picture.VkImageSimple
                android:id="@+id/ad_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/vk_icon_logo_vk_ads_12"
                android:scaleType="centerInside"
                android:tint="?attr/vk_ui_icon_secondary"
                app:layout_constraintBottom_toBottomOf="@+id/ad_label"
                app:layout_constraintEnd_toStartOf="@+id/ad_label"
                app:layout_constraintStart_toEndOf="@+id/cta_button"
                app:layout_constraintTop_toTopOf="@+id/ad_label"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/ad_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="68dp"
                android:maxLines="2"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/ad_icon"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/VkUiTypography.Caption3Caps"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guideline_disclaimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="1"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/disclaimer"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:scaleType="fitXY"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image"
            app:layout_constraintTop_toBottomOf="@+id/guideline_disclaimer"
            app:tint="@color/vk_stateful_secondary_color"/>
        <com.vk.core.view.components.badge.VkContentBadge
            android:id="@+id/close_button"
            android:padding="2dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:capsule="true"
            app:contentBadgeAppearance="neutral"
            app:contentBadgeMode="secondary"
            app:contentBadgeSize="medium"
            app:icon="@drawable/vk_icon_cancel_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.badge.VkContentBadge
            android:id="@+id/choices_button"
            android:padding="2dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            app:capsule="true"
            app:contentBadgeAppearance="neutral"
            app:contentBadgeMode="secondary"
            app:contentBadgeSize="medium"
            app:icon="@drawable/vk_icon_more_vertical_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/close_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.core.view.components.card.VkCard>
