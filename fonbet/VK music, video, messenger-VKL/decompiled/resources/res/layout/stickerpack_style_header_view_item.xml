<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/vk_ui_typography_title2_medium"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_vertical"
        android:id="@+id/style_title_text"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"/>
    <ImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/wish_list_button"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/stickers_wish_list_add_content_descr"/>
    <ImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/style_title_close"
        android:background="@drawable/highlight_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:srcCompat="@drawable/vk_icon_cancel_24"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</LinearLayout>
