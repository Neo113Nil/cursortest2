<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.stories.design.view.StoryProgressView
        android:id="@+id/stub_story_view_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/stub_story_view_avatar_image"
        android:padding="4dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stub_story_view_progress"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/stub_story_view_avatar_image"
        app:layout_constraintEnd_toStartOf="@+id/moreButton"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/stub_story_view_avatar_image"
        app:layout_constraintTop_toTopOf="@+id/stub_story_view_avatar_image">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/stub_story_view_name_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:shadowColor="@color/vk_black_alpha35"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                style="@style/VkUiTypography.SubheadSemiBold"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/stub_story_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/story_stub_header_time"
                android:singleLine="true"
                android:shadowColor="@color/vk_black_alpha35"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:layout_marginStart="4dp"
                style="@style/VkUiTypography.SubheadNormal"/>
        </LinearLayout>
        <com.vk.stories.design.view.viewer.AnimatedSubtitleView
            android:id="@+id/animated_subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:translationY="2dp"
            android:layout_marginHorizontal="4dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/moreButton"
        android:padding="6dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_more_vertical_shadow_24"
        app:layout_constraintBottom_toBottomOf="@+id/stub_story_view_avatar_image"
        app:layout_constraintEnd_toStartOf="@+id/cancelButton"
        app:layout_constraintTop_toTopOf="@+id/stub_story_view_avatar_image"/>
    <ImageView
        android:id="@+id/cancelButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/vk_icon_cancel_shadow_medium_48"
        app:layout_constraintBottom_toBottomOf="@+id/stub_story_view_avatar_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stub_story_view_avatar_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
