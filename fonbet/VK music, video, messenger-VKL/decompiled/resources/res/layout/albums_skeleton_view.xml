<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/skeleton_shimmer"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.photos.root.albums.presentation.skeleton.AlbumsHeaderSkeletonView
                android:id="@+id/albums_header_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>
            <View
                android:id="@+id/albums_margin_if_header_is_hidden"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="14dp"/>
            <com.vk.photos.root.albums.presentation.skeleton.SystemAlbumsListSkeletonView
                android:id="@+id/system_albums_list_skeleton"
                android:paddingTop="2dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"/>
            <com.vk.photos.root.albums.presentation.skeleton.AlbumsUserTitleSkeletonView
                android:id="@+id/albums_user_title_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.photos.root.albums.presentation.skeleton.AlbumsListSkeletonView
                android:id="@+id/albums_list_skeleton"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="2dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
</merge>
