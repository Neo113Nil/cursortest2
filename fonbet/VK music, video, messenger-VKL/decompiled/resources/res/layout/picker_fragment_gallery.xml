<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gallery_picker_container"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.attachpicker.widget.ContextProgressView
        android:layout_gravity="center_horizontal"
        android:id="@+id/cpv_progress"
        android:visibility="gone"
        android:layout_width="@dimen/picker_gallery_loading_progress"
        android:layout_height="@dimen/picker_gallery_loading_progress"
        android:layout_marginTop="128dp"/>
    <com.vk.attachpicker.widget.GalleryRecyclerView
        android:id="@+id/rv_gallery"
        android:visibility="invisible"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.attachpicker.fragment.gallery.FastScroller
        android:layout_gravity="end"
        android:id="@+id/fast_scroller"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="12sp"
            android:textColor="?attr/vk_ui_text_primary_invariably"
            android:ellipsize="none"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/section_title_popup"
            android:background="@drawable/bg_fast_scroller_date"
            android:paddingTop="4dp"
            android:paddingBottom="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFamily="@font/vk_roboto_regular"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:elevation="4dp"
            android:letterSpacing="0.0042"
            app:lineHeight="14sp"/>
    </com.vk.attachpicker.fragment.gallery.FastScroller>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/fl_permission_stub_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/fl_samsung_photopicker_stub_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"/>
</FrameLayout>
