<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/sharing_send_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="17dp"
            android:textColor="?attr/vk_ui_text_primary"
            android:textColorHint="?attr/vk_ui_text_secondary"
            android:id="@+id/sharing_comment_input_wall_post"
            android:paddingLeft="12dp"
            android:paddingRight="44dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="11dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/sharing_hint_comment_add_comment"
            android:maxLines="2"
            android:singleLine="false"
            android:inputType="textMultiLine"
            android:paddingStart="12dp"
            android:paddingEnd="44dp"
            android:importantForAutofill="no"
            style="@style/VKUIEditText"/>
        <ImageButton
            android:layout_gravity="end|bottom"
            android:id="@+id/sharing_comment_input_wall_post_clear_button"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="5dp"
            android:tint="?attr/vk_ui_icon_secondary"
            android:contentDescription="@string/clear_input"
            android:layout_marginEnd="12dp"
            app:srcCompat="@drawable/vk_icon_cancel_24"
            style="@style/Widget.AppCompat.ActionButton"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/sharing_attach_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <FrameLayout
        android:id="@+id/sharing_send_button"
        android:background="@drawable/sharing_blue_btn_rounded"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="48dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline.Unscaled"
            android:textColor="@color/sharing_blue_btn_text"
            android:layout_gravity="center"
            android:id="@+id/sharing_send_button_title"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sharing_send_button_label"
            android:textAllCaps="true"/>
    </FrameLayout>
</LinearLayout>
