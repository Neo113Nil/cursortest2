<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.fresco.FrescoImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/msg_bubble_max_width"
        android:maxHeight="@dimen/msg_content_max_height"
        android:minWidth="128dp"
        android:minHeight="128dp"
        android:contentDescription="@string/vkim_accessibility_photo"
        app:vkim_scaleType="center_crop"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/play"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_attachment_video_play"/>
    <com.vk.core.view.ProgressView
        android:layout_gravity="center"
        android:id="@+id/upload"
        style="@style/VkIm.MsgPart.UploadIndicator.Default"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:layout_gravity="bottom|right"
        android:id="@+id/timeAndStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:importantForAccessibility="no"/>
</FrameLayout>
