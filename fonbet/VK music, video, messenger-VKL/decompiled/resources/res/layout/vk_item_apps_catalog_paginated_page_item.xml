<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_highlight_radius_8"
    android:layout_width="match_parent"
    android:layout_height="86dp">
    <FrameLayout
        android:id="@+id/icon_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_background_top_margin_space">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon_background"
            android:layout_width="44dp"
            android:layout_height="44dp"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="center"
            android:id="@+id/icon_container"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="center"
            android:id="@+id/icon_container_redesigned"
            android:visibility="gone"
            android:layout_width="@dimen/vk_catalog_miniapp_item_icon_size"
            android:layout_height="@dimen/vk_catalog_miniapp_item_icon_size"/>
    </FrameLayout>
    <Space
        android:id="@+id/icon_background_top_margin_space"
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/icon_layout"
        app:layout_constraintEnd_toEndOf="@+id/icon_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/icon_background_right_margin_space"
        android:layout_width="4dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/icon_layout"
        app:layout_constraintTop_toTopOf="@+id/icon_layout"/>
    <Space
        android:id="@+id/icon_background_bottom_margin_space"
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        app:layout_constraintEnd_toEndOf="@+id/icon_layout"
        app:layout_constraintStart_toStartOf="@+id/icon_layout"
        app:layout_constraintTop_toBottomOf="@+id/icon_layout"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_layout"
        style="@style/VkUiTypography.Subhead"/>
    <TextView
        android:id="@+id/counter"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="1dp"
        android:minWidth="18dp"
        android:minHeight="18dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/icon_background_right_margin_space"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/icon_layout"
        app:layout_constraintTop_toTopOf="@+id/icon_background_top_margin_space"
        style="@style/SuperApp.Item.Showcase.Counter"/>
    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:rotation="-5"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/icon_background_bottom_margin_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SuperApp.Item.Showcase.Badge"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/new_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/icon_layout"
        app:layout_constraintTop_toTopOf="@+id/icon_layout"
        app:srcCompat="@drawable/vk_superapp_fintech_new_badge"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintEnd_toEndOf="@+id/icon_background_right_margin_space"
        app:layout_constraintTop_toTopOf="@+id/icon_background_top_margin_space"
        app:srcCompat="@drawable/vk_superapp_dot"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/messenger_badge"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/vk_badge_messenger_description"
        app:layout_constraintEnd_toEndOf="@+id/icon_background_right_margin_space"
        app:layout_constraintTop_toTopOf="@+id/icon_background_top_margin_space"
        app:srcCompat="@drawable/vk_message_badge_16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
