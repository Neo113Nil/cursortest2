<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/main"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/attach_container"
        android:clipChildren="false"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_xl">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="end|top"
            android:id="@+id/stack_item"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:rotation="16"
            android:importantForAccessibility="no"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/left_container"
            android:layout_width="36dp"
            android:layout_height="36dp">
            <com.vk.core.view.components.picture.VkImageSimple
                android:id="@+id/overlay"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.4"
                android:importantForAccessibility="no"/>
            <com.vk.core.view.components.picture.VkImageSimple
                android:layout_gravity="center"
                android:id="@+id/player_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/vk_icon_lego_play_16"
                android:importantForAccessibility="no"
                app:tint="?attr/vk_ui_icon_contrast"/>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.vk.core.view.components.text.VkFadeText
            android:textColor="?attr/vk_ui_text_contrast"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkUiTypography.Lego.Text"/>
        <com.vk.core.view.components.text.VkFadeText
            android:textColor="?attr/vk_ui_text_contrast"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
            android:singleLine="true"
            style="@style/VkUiTypography.Lego.Paragraph"/>
    </LinearLayout>
</LinearLayout>
