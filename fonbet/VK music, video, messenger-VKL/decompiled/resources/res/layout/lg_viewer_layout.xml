<?xml version="1.0" encoding="utf-8"?>
<com.vk.photogallery.view.CoordinatorLayoutWithContextMenuDelegate xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/lg_dim"
        android:background="#66000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lg_bottom_sheet_container"
        android:fitsSystemWindows="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.bottomsheet.PagerViewBottomSheetBehavior">
        <FrameLayout
            android:id="@+id/lg_header_container"
            android:background="@drawable/lg_card_with_top_corners_rounded"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/lg_popup_anchor"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"/>
            <com.vk.core.view.VKTabLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/lg_tab_layout"
                android:background="?attr/photo_gallery_background_color"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginEnd="40dp"
                app:tabGravity="center"
                app:tabIndicator="?attr/tabBarIndicator"
                app:tabIndicatorColor="?attr/vk_legacy_header_tint"
                app:tabMode="scrollable"
                app:tabPaddingEnd="16dp"
                app:tabPaddingStart="16dp"
                app:tabSelectedTextColor="?attr/vk_legacy_header_tab_active_text"
                app:tabTextAppearance="@style/TabBarTheme.TabTextAppearance"
                app:tabTextColor="?attr/vk_legacy_header_tab_inactive_text"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/lg_close_btn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/lg_close_drawable"
                android:contentDescription="@string/photo_gallery_accessebility_close"/>
        </FrameLayout>
        <include
            android:id="@+id/lg_partial_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lg_header_container"
            layout="@layout/lg_part_permission"/>
        <com.vk.photogallery.PhotoGalleryView
            android:id="@+id/lg_gallery_view"
            android:background="?attr/vk_legacy_modal_card_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:accentColor="?attr/vk_legacy_accent"
            app:checkColor="@color/vk_white"
            app:itemPadding="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lg_partial_permission"
            app:preferredItemSize="size_120dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/lg_bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/lg_caption_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/lg_caption_separator"
            android:background="?attr/vk_legacy_separator_alpha"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_above="@+id/lg_caption_view"/>
        <com.vk.core.view.BottomConfirmButton
            android:id="@+id/lg_confirm_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_alignParentBottom="true"
            android:alpha="0"
            app:bcb_cancel_bg_color="?attr/vk_legacy_button_muted_background"
            app:bcb_cancel_text="@string/photo_gallery_cancel"
            app:bcb_cancel_text_color="?attr/vk_legacy_button_muted_foreground"
            app:bcb_divider="?attr/vk_legacy_separator_alpha"
            app:bcb_send_bg_color="?attr/vk_legacy_button_primary_background"
            app:bcb_send_text="@string/photo_gallery_send"
            app:bcb_send_text_color="?attr/vk_legacy_button_primary_foreground"/>
        <EditText
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:textColorHint="?attr/vk_legacy_text_placeholder"
            android:id="@+id/lg_caption_view"
            android:background="?attr/vk_legacy_modal_card_background"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="110dp"
            android:minHeight="48dp"
            android:hint="@string/photo_gallery_add_caption_hint"
            android:maxLines="4"
            android:layout_alignParentBottom="true"
            android:inputType="textMultiLine"
            android:alpha="0"
            android:paddingStart="16dp"
            android:paddingEnd="70dp"/>
        <ImageView
            android:id="@+id/lg_caption_icon"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"
            app:tint="?attr/vk_legacy_text_placeholder"/>
        <com.vk.core.view.ArrowSendButton
            android:id="@+id/send_btn"
            android:clipToPadding="false"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="-34dp"
            android:layout_above="@+id/lg_caption_view"
            android:alpha="0"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</com.vk.photogallery.view.CoordinatorLayoutWithContextMenuDelegate>
