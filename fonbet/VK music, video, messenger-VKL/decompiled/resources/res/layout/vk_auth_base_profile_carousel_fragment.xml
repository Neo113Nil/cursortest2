<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.superapp.ui.toolbar.VkAuthToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/vk_auth_accessibility_close"
        app:navigationIcon="@drawable/vk_icon_arrow_left_outline_28"/>
    <include
        android:id="@+id/logo"
        android:layout_width="@dimen/vk_auth_logo_size_mini"
        android:layout_height="@dimen/vk_auth_logo_size_mini"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/user_carousel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/vk_auth_logo"/>
    <com.vk.auth.ui.carousel.UserCarouselView
        android:gravity="center_horizontal"
        android:id="@+id/user_carousel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/continue_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.auth.ui.VkLoadingButton
        android:id="@+id/continue_btn"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/vk_auth_account_continue"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/help_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_carousel"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkAuth.Button.Landing.Exchange.Primary"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/help_button"
        android:padding="@dimen/vk_ui_button_padding_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vk_auth_help_button"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
