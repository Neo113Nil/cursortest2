<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlight"
    android:paddingTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/feed_coauthors_coauthor_photo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="5.5dp"
        android:layout_marginStart="24dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <View
        android:id="@+id/feed_coauthors_author_border"
        android:background="@drawable/white_oval"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:layout_constraintBottom_toBottomOf="@+id/feed_coauthors_author_photo"
        app:layout_constraintEnd_toEndOf="@+id/feed_coauthors_author_photo"
        app:layout_constraintStart_toStartOf="@+id/feed_coauthors_author_photo"
        app:layout_constraintTop_toTopOf="@+id/feed_coauthors_author_photo"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/feed_coauthors_author_photo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/feed_coauthors_coauthor_photo"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <View
        android:id="@+id/feed_coauthors_avatars_click_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/feed_coauthors_author_photo"
        app:layout_constraintEnd_toEndOf="@+id/feed_coauthors_coauthor_photo"
        app:layout_constraintStart_toStartOf="@+id/feed_coauthors_author_photo"
        app:layout_constraintTop_toTopOf="@+id/feed_coauthors_coauthor_photo"/>
    <com.vk.feed.tool.view.newsfeed.coauthors.CoauthorsTextLayout
        android:id="@+id/text_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-1.5dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/post_header_options"
        app:layout_constraintStart_toEndOf="@+id/feed_coauthors_coauthor_photo"
        app:layout_constraintTop_toTopOf="@+id/feed_coauthors_coauthor_photo">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkUiTypography.TextMedium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/feed_coauthor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkUiTypography.TextMedium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/feed_coauthor_short"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkUiTypography.TextMedium"/>
    </com.vk.feed.tool.view.newsfeed.coauthors.CoauthorsTextLayout>
    <View
        android:layout_gravity="start|center_vertical"
        android:id="@+id/post_header_pin"
        android:background="@drawable/vk_icon_pin_12"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="4dp"
        android:backgroundTint="?attr/vk_ui_icon_medium"
        app:layout_constraintBottom_toBottomOf="@+id/text_layout"
        app:layout_constraintStart_toEndOf="@+id/text_layout"
        app:layout_constraintTop_toTopOf="@+id/text_layout"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/feed_coauthors_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="@+id/text_layout"
        app:layout_constraintStart_toStartOf="@+id/text_layout"
        app:layout_constraintTop_toBottomOf="@+id/text_layout"
        style="@style/VkUiTypography.Caption2Normal"/>
    <ImageView
        android:id="@+id/post_header_options"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/common_actions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
