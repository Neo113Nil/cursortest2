<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fullscreen_clip_main_overlay_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/fullscreen_clip_top_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ClipTopGradient"/>
    <View
        android:id="@+id/fullscreen_clip_bottom_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/clip_bottom_fade_margin_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_clip_primary_badges_list"/>
    <View
        android:id="@+id/fullscreen_clip_description_expanded_blackout"
        android:background="@color/clip_description_expanded_blackout_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.clips.tool.view.viewer.feed.list.clip.ClipFeedSideControlsView
        android:id="@+id/fullscreen_clip_side_controls"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/clips_controls_margin_bottom"
        android:paddingStart="@dimen/clips_controls_padding_horizontal"
        android:paddingEnd="@dimen/clips_controls_padding_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_main_overlay_nps"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/fullscreen_clip_activities_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_primary_badges_list"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.NestedScrollableRecyclerView
        android:orientation="horizontal"
        android:id="@+id/fullscreen_clip_primary_badges_list"
        android:visibility="gone"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="20dp"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="horizontal"
        android:paddingVertical="12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_owner_view"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_start_space"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.clips.design.view.component.user.ClipUserView
        android:id="@+id/fullscreen_clip_owner_view"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_description"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_subscribe"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_start_space"
        app:layout_constraintTop_toBottomOf="@+id/fullscreen_clip_primary_badges_list"
        app:layout_goneMarginBottom="2dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/fullscreen_clip_subscribe"
        android:background="@drawable/bg_outline_rounded_6"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:foreground="@drawable/highlight_radius_6"
        android:text="@string/clips_subscribe"
        android:maxLines="1"
        android:paddingStart="@dimen/clip_feed_item_subscribe_button_padding_horizontal"
        android:paddingEnd="@dimen/clip_feed_item_subscribe_button_padding_horizontal"
        android:layout_marginStart="@dimen/clip_feed_item_subscribe_button_margin_start"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen_clip_owner_view"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_owner_view"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_clip_owner_view"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center_vertical"
        android:id="@+id/fullscreen_clip_subscribed_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:text="@string/clips_subscribed"
        android:layout_marginStart="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen_clip_owner_view"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_right_title_dot_separator"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_clip_owner_view"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white_alpha60"
        android:ellipsize="end"
        android:id="@+id/fullscreen_clip_publication_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen_clip_owner_view"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_right_title_dot_separator"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_clip_owner_view"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="end"
        android:id="@+id/fullscreen_clip_right_title_dot_separator"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="wrap_content"
        android:text="·"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen_clip_owner_view"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_owner_view"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_clip_owner_view"
        style="@style/VkUiTypography.Caption1SemiBold"/>
    <FrameLayout
        android:id="@+id/fullscreen_clip_products_container"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_mute_icon"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintStart_toStartOf="@+id/fullscreen_clip_start_space"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/fullscreen_clip_long_description_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.vk.clips.design.view.component.description.ClipDescription
        android:id="@+id/fullscreen_clip_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="@dimen/clip_start_space"
        android:layout_marginEnd="@dimen/clip_description_end_margin"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_products_container"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullscreen_clip_long_description_guideline"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginBottom="0dp"
        style="@style/ClipDescriptionContainer"/>
    <com.vk.clips.design.view.component.audio.ClipsAudioToggle
        android:id="@+id/fullscreen_clip_mute_icon"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_banner_companion_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="0dp"
        style="@style/ClipMuteIcon"/>
    <FrameLayout
        android:id="@+id/fullscreen_clip_banner_companion_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_primary_action_btn"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_start_space"/>
    <com.vk.core.view.NestedScrollableRecyclerView
        android:orientation="horizontal"
        android:id="@+id/fullscreen_clip_secondary_badges_list"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="20dp"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"
        android:paddingVertical="5dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen_clip_mute_icon"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_mute_icon"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_clip_mute_icon"/>
    <com.vk.core.view.tools.VkViewStub
        android:id="@+id/fullscreen_clip_primary_action_btn"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_secondary_action_btn"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_start_space"/>
    <com.vk.core.view.tools.VkViewStub
        android:id="@+id/fullscreen_clip_secondary_action_btn"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_main_overlay_nps"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_start_space"/>
    <com.vk.clips.tool.view.viewer.feed.list.nps.LazyNpsView
        android:id="@+id/fullscreen_clip_main_overlay_nps"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_clip_start_space"/>
    <Space
        android:id="@+id/fullscreen_clip_start_space"
        android:layout_width="16dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_clip_primary_badges_list"/>
    <com.vk.clips.viewer.impl.feed.view.subs.ClipsCanvasSubtitleView
        android:id="@+id/fullscreen_clip_main_overlay_subtitles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_clip_activities_container"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_clip_side_controls"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.clips.design.view.feed.ClipCoauthorInvitationView
        android:id="@+id/fullscreen_clip_coauthor_invitations"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
