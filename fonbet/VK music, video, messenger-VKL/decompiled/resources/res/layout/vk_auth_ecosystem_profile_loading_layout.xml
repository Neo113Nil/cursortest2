<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vk_ecoplate_shimmer_layout"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:layout_gravity="center"
        android:id="@+id/vk_ecoplate_profile_avatar_shimmer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_xs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:skeletonType="circle"/>
    <com.vk.core.view.components.skeleton.VkTextSkeleton
        android:layout_gravity="center"
        android:id="@+id/vk_ecoplate_profile_title_shimmer"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_s"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_ecoplate_profile_avatar_shimmer"
        style="@style/VkUiTypography.DisplayTitle4Medium"/>
    <com.vk.core.view.components.skeleton.VkTextSkeleton
        android:layout_gravity="center"
        android:id="@+id/vk_ecoplate_profile_info_shimmer"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_ecoplate_profile_title_shimmer"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/vk_ecoplate_profile_lk_button_shimmer"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginTop="26dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/vk_ecoplate_profile_logout_button_shimmer"
        app:layout_constraintTop_toBottomOf="@+id/vk_ecoplate_profile_info_shimmer"
        app:skeletonType="block"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/vk_ecoplate_profile_logout_button_shimmer"
        android:layout_width="48dp"
        android:layout_height="16dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintLeft_toRightOf="@+id/vk_ecoplate_profile_lk_button_shimmer"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vk_ecoplate_profile_info_shimmer"
        app:skeletonType="block"/>
</androidx.constraintlayout.widget.ConstraintLayout>
