<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vkim_selection_list"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/vk_ui_spacing_size_xl"
        android:paddingEnd="@dimen/vk_ui_spacing_size_xl"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:layout_gravity="center"
        android:id="@+id/vkim_empty_selection"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
