<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/stub_icon"
            android:background="@drawable/vk_expandable_menu_bg_stub_16"
            android:layout_width="@dimen/vk_expandable_menu_item_width"
            android:layout_height="@dimen/vk_expandable_menu_item_height"
            android:layout_marginVertical="8dp"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/title_text_view"
            android:background="@drawable/vk_expandable_menu_bg_stub_4"
            android:layout_width="@dimen/vk_expandable_menu_item_stub_text_width"
            android:layout_height="@dimen/vk_expandable_menu_item_stub_text_height"
            android:layout_marginTop="@dimen/vk_expandable_menu_title_stub_margin_top"
            android:layout_marginBottom="@dimen/vk_expandable_menu_title_stub_margin_bottom"/>
    </com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
</FrameLayout>
