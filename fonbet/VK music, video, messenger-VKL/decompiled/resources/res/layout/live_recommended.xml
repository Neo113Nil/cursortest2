<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/liveRecommendedRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/liveRecommendedError"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="250dp"
        android:text="@string/live_general_error_description"/>
    <com.vk.core.view.components.spinner.VkSpinner
        android:layout_gravity="center"
        android:id="@+id/liveRecommendedProgress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/vk_white"
        app:spinnerSize="large"/>
</merge>
