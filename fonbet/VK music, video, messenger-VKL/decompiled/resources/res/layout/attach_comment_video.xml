<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/picture"
        android:layout_width="120dp"
        android:layout_height="80dp"
        app:actualImageScaleType="centerCrop"
        app:overlayImage="@drawable/scrim_bottom_16percent"
        app:roundedCornerRadius="4dp"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/media_overlay_view"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="80dp"
        app:vov_size="small"/>
    <com.vk.core.view.TintTextView
        android:textAppearance="@style/VkUiTypography.Caption2.Unscaled"
        android:textColor="@color/vk_white"
        android:gravity="center_vertical"
        android:layout_gravity="end|bottom"
        android:id="@+id/duration"
        android:background="@drawable/bg_video_duration_label_old"
        android:paddingTop="4dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:drawablePadding="2dp"
        android:paddingStart="2dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:drawableStartCompat="@drawable/vk_icon_play_16"
        app:drawableTint="@android:color/white"/>
    <com.vk.libvideo.design.view.movika.InteractiveDurationView
        android:layout_gravity="end|bottom"
        android:id="@+id/interactive_duration"
        android:background="@drawable/bg_interactiv_video_duration_label_rounded_4"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.core.view.VideoRestrictionView
        android:id="@+id/media_deprecated_restriction_view"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="80dp"/>
</FrameLayout>
