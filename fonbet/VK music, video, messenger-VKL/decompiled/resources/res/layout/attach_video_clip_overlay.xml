<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/video_single_clip_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="top"
        android:id="@+id/video_single_clip_title"
        android:paddingTop="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:shadowColor="@color/vk_black_alpha16"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="@dimen/video_sound_control_size"/>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/video_single_clip_bottom_container"
        android:paddingLeft="?attr/attach_left_right_padding"
        android:paddingTop="32dp"
        android:paddingRight="?attr/attach_left_right_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/video_single_clip_owner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/video_single_clip_like"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/video_single_clip_like"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="@dimen/clip_fixed_width_overlay_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/vk_white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.vk.core.view.TextViewEllipsizeEnd
            android:textColor="@color/vk_white"
            android:id="@+id/video_single_clip_descr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:maxLines="2"
            android:lineSpacingExtra="4sp"
            style="@style/VkUiTypography.Paragraph"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="@color/vk_white"
            android:layout_gravity="center"
            android:id="@+id/video_single_clip_views"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:maxLines="2"
            android:drawablePadding="4dp"
            app:drawableStartCompat="@drawable/vk_icon_view_12"
            app:drawableTint="@color/vk_white"/>
        <FrameLayout
            android:id="@+id/video_single_clip_song_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp">
            <com.vk.core.view.components.picture.VkImage
                android:id="@+id/video_single_clip_song_cover"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
            <ImageView
                android:id="@+id/video_single_clip_song_progress"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption1"
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/video_single_clip_song_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:layout_marginStart="28dp"/>
        </FrameLayout>
        <com.vk.core.view.components.button.VkButton
            android:gravity="center"
            android:id="@+id/video_single_clip_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/video_single_clip_button_text"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:paddingVertical="6dp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"/>
        <View
            android:id="@+id/video_single_clip_bottom_padding"
            android:layout_width="wrap_content"
            android:layout_height="16dp"/>
    </LinearLayout>
</FrameLayout>
