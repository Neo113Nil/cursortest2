<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:gravity="center"
        android:id="@+id/create_camera_rotation_tip_main_container"
        android:background="@color/vk_black_alpha75"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/create_camera_rotation_tip_inner_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/create_camera_rotation_tip_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/vk_icon_flip_portrait_outline_56"
                app:tint="@color/vk_white"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/camera_rotate_hint_title"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/VkUiTypography.Title2Medium"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/vk_white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/create_camera_rotation_tip_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/camera_rotate_hint_text"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/VkUiTypography.Paragraph"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.FootnoteMedium"
        android:textStyle="normal"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/create_camera_rotation_tip_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/camera_rotate_hint_bottom_text"/>
</merge>
