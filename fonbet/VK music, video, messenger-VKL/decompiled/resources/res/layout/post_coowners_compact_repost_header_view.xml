<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_highlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <View
        android:id="@+id/post_repost_icon"
        android:background="@drawable/vk_icon_repost_outline_16"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="21.5dp"
        android:backgroundTint="?attr/vk_ui_icon_tertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/feed_coauthors_coauthor_photo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="1.5dp"
        android:layout_marginStart="15.5dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintStart_toEndOf="@+id/post_repost_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <View
        android:id="@+id/feed_coauthors_author_border"
        android:background="@drawable/white_oval"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:layout_constraintBottom_toBottomOf="@+id/feed_coauthors_author_photo"
        app:layout_constraintEnd_toEndOf="@+id/feed_coauthors_author_photo"
        app:layout_constraintStart_toStartOf="@+id/feed_coauthors_author_photo"
        app:layout_constraintTop_toTopOf="@+id/feed_coauthors_author_photo"/>
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/feed_coauthors_author_photo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="10.5dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintStart_toEndOf="@+id/post_repost_icon"
        app:layout_constraintTop_toTopOf="@+id/feed_coauthors_coauthor_photo"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <View
        android:id="@+id/feed_coauthors_avatars_click_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/feed_coauthors_author_photo"
        app:layout_constraintEnd_toEndOf="@+id/feed_coauthors_coauthor_photo"
        app:layout_constraintStart_toStartOf="@+id/feed_coauthors_author_photo"
        app:layout_constraintTop_toTopOf="@+id/feed_coauthors_coauthor_photo"/>
    <com.vk.feed.tool.view.newsfeed.coauthors.CoauthorsTextLayout
        android:id="@+id/text_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"
        android:layout_marginStart="10.5dp"
        app:layout_constraintEnd_toStartOf="@+id/feed_coauthors_date"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/feed_coauthors_coauthor_photo"
        app:layout_constraintTop_toTopOf="@+id/feed_coauthors_coauthor_photo"
        app:layout_constraintWidth="wrap_content_constrained">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkUiTypography.SubheadMedium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/feed_coauthor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkUiTypography.SubheadMedium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/feed_coauthor_short"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkUiTypography.SubheadMedium"/>
    </com.vk.feed.tool.view.newsfeed.coauthors.CoauthorsTextLayout>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/feed_coauthors_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/text_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text_layout"
        app:layout_constraintTop_toTopOf="@+id/text_layout"
        style="@style/VkUiTypography.FootnoteNormal"/>
</merge>
