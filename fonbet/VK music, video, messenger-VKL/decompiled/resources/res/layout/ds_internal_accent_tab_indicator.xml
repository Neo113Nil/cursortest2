<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/ds_accent_tab_indicator_card"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_tab_regular_height"
        android:foreground="@drawable/ds_tab_indicator_background_accent"
        android:elevation="2dp"
        android:layout_marginHorizontal="@dimen/ds_indicator_tab_horizontal_padding"
        android:layout_marginVertical="@dimen/ds_indicator_tab_vertical_padding"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/ds_tab_accent_corner_radius"/>
</merge>
