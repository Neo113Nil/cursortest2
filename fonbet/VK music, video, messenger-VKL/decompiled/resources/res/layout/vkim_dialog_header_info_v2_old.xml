<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:padding="0dp"
    app:contentInsetEnd="8dp"
    app:contentInsetEndWithActions="4dp"
    app:contentInsetStart="8dp"
    app:contentInsetStartWithNavigation="8dp"
    app:logo="@null"
    app:navigationContentDescription="@string/vkim_accessibility_toolbar_back_exit"
    app:navigationIcon="@null"
    app:subtitle="@null"
    app:title="@null"
    app:titleMarginStart="0dp"
    style="@style/VkIm.Toolbar.Style">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:background="@drawable/bg_im_chat_header_ripple"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/avatar_wrapper"
            android:background="@drawable/bg_im_chat_header_ripple"
            android:paddingTop="4dp"
            android:clipChildren="false"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/vkim_title_text"
            app:layout_constraintTop_toTopOf="parent">
            <com.vk.im.ui.views.avatars.ImAvatarView
                android:id="@+id/avatar_content"
                android:focusable="false"
                android:layout_width="@dimen/im_dialog_header_avatar_container_size"
                android:layout_height="@dimen/im_dialog_header_avatar_container_size"
                android:importantForAccessibility="no"
                style="@style/VkIm.AvatarView"/>
            <ViewStub
                android:layout_gravity="end|bottom"
                android:id="@+id/verified_stub"
                android:layout="@layout/vkim_dialog_header_avatar_verified_view"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
        </FrameLayout>
        <com.vk.superapp.ui.FixTextView
            android:textSize="16dp"
            android:id="@+id/vkim_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="@string/font_family_medium"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toTopOf="@+id/subtitle_container"
            app:layout_constraintLeft_toRightOf="@+id/avatar_wrapper"
            app:layout_constraintRight_toLeftOf="@+id/title_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="wrap"
            style="@style/VkIm.Toolbar.Title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:minHeight="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/vkim_title_text"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/vkim_title_text"
            app:layout_constraintRight_toRightOf="parent">
            <com.vk.imageloader.view.VKImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_emoji"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="0dp"
                android:layout_marginStart="2dp"
                app:actualImageScaleType="centerInside"/>
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_donut"
                android:visibility="visible"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginBottom="0dp"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                android:layout_marginStart="4dp"
                app:srcCompat="@drawable/vk_icon_star_circle_fill_yellow_12"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_casper"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginStart="4dp"
                app:srcCompat="@drawable/vk_icon_ghost_16"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_writing_disabled"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginStart="4dp"
                app:srcCompat="@drawable/vk_icon_message_cross_16"
                app:tint="?attr/im_dropdown_arrow_tint"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_muted"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginBottom="0dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginStart="4dp"
                app:srcCompat="@drawable/vk_icon_muted_16"
                app:tint="?attr/im_dropdown_arrow_tint"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_dropdown"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginBottom="0dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginStart="3dp"
                app:srcCompat="@drawable/vk_icon_dropdown_16"
                app:tint="?attr/im_dropdown_arrow_tint"/>
        </LinearLayout>
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:id="@+id/subtitle_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/avatar_wrapper"
            app:layout_constraintTop_toBottomOf="@+id/vkim_title_text"
            app:layout_constraintWidth_default="spread">
            <com.vk.superapp.ui.FixTextView
                android:textSize="13dp"
                android:id="@+id/subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                app:vk_layout_isFluid="true"
                style="@style/VkIm.Toolbar.Subtitle"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/typing_progress"
                android:layout_width="30dp"
                android:layout_height="10dp"
                android:layout_marginBottom="2dp"
                android:scaleType="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginStart="4dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="bottom"
                android:id="@+id/subtitle_online_mobile"
                android:layout_width="8dp"
                android:layout_height="12dp"
                android:layout_marginBottom="2dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:alpha="0.4"
                android:importantForAccessibility="no"
                android:layout_marginStart="6dp"
                app:srcCompat="@drawable/vk_icon_online_mobile_12"
                app:tint="?attr/vk_legacy_header_text_secondary"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.Toolbar>
