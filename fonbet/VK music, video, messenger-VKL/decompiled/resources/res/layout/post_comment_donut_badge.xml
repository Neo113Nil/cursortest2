<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_container"
    android:paddingTop="@dimen/post_side_padding_small"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/post_side_padding">
    <com.vk.newsfeed.common.recycler.holders.comments.avatar.CommentAvatarView
        android:id="@+id/poster_photo"
        android:layout_width="@dimen/post_comment_avatar_size"
        android:layout_height="@dimen/post_comment_avatar_size"
        android:layout_marginStart="-5dp"
        app:contourOverlayEnabled="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/poster_name_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/poster_photo"
        app:layout_constraintTop_toTopOf="@+id/poster_photo">
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="?attr/newsfeed_post_title_color"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/poster_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:vk_layout_isFluid="true"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="start|center_vertical"
            android:id="@+id/status"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            app:actualImageScaleType="centerInside"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/icon1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"/>
        <View
            android:layout_gravity="start|center_vertical"
            android:id="@+id/icon2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="?attr/newsfeed_post_title_color"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/comment_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/sent_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="70dp"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/poster_name_view"
        app:layout_constraintTop_toTopOf="@+id/poster_name_view"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/post_view"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_photo"
        app:layout_constraintTop_toBottomOf="@+id/poster_name_view">
        <com.vk.core.view.links.LinkedTextView
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_primary"
            android:linksClickable="false"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            android:hyphenationFrequency="none"/>
        <com.vk.donut.design.view.badge.SmallOneTimeDonutBadge
            android:id="@+id/comment_donut_small_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <com.vk.donut.design.view.badge.LargeOneTimeDonutBadge
            android:id="@+id/comment_donut_large_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/post_info_view"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@+id/comment_reply"
        app:layout_constraintStart_toEndOf="@+id/poster_photo"
        app:layout_constraintTop_toBottomOf="@+id/post_view"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteMedium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/comment_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reply_to"
        android:layout_alignBaseline="@+id/post_info_view"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/post_info_view"
        app:layout_constraintTop_toTopOf="@+id/post_info_view"/>
    <include
        android:layout_gravity="end|center_vertical"
        android:id="@+id/comment_author_liked"
        android:visibility="gone"
        android:contentDescription="@string/accessibility_comment_author_liked"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/comment_reply"
        app:layout_constraintStart_toEndOf="@+id/comment_reply"
        app:layout_constraintTop_toTopOf="@+id/comment_reply"
        layout="@layout/author_liked_comment_layout"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="@color/post_counters"
        android:gravity="end"
        android:id="@+id/post_likes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        app:drawableStartCompat="@drawable/ic_like_outline_16_xml"
        app:layout_constraintBottom_toBottomOf="@+id/comment_reply"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
