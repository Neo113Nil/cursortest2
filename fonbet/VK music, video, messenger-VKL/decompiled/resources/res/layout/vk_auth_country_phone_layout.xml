<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.auth.ui.VkAuthTintTextView
            android:textAppearance="@style/VkUiTypography.TextNormal"
            android:textColor="?attr/vk_ui_text_primary"
            android:textColorHint="?attr/vk_ui_text_secondary"
            android:id="@+id/choose_country"
            android:background="@drawable/vk_ui_auth_bg_edittext_top"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableEndCompat="@drawable/vk_icon_chevron_16"
            app:vk_drawable_end_tint="?attr/vk_ui_icon_secondary"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/phone_container"
            android:background="@drawable/vk_auth_bg_edittext_bottom"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.TextNormal"
                android:textColor="?attr/vk_ui_text_primary"
                android:textColorHint="?attr/vk_ui_icon_secondary"
                android:layout_gravity="center"
                android:id="@+id/phone_code"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="18.5dp"
                android:paddingEnd="18.5dp"/>
            <View
                android:layout_gravity="center"
                android:background="?attr/vk_ui_separator_primary_alpha"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>
            <com.vk.auth.ui.VkAuthExtendedEditText
                android:textAppearance="@style/VkUiTypography.TextNormal"
                android:textColor="?attr/vk_ui_text_primary"
                android:textColorHint="?attr/vk_ui_text_secondary"
                android:layout_gravity="center"
                android:id="@+id/parent_phone_edit_text"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/vk_auth_sign_up_phone_hint"
                android:lines="1"
                android:inputType="number"
                android:paddingStart="11.5dp"
                app:drawableTint="?attr/vk_ui_icon_secondary"
                app:is_clearable="true"
                app:vk_error_stated_edit_text_id="@+id/phone_edit_text"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"/>
</merge>
