<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <com.vk.core.view.components.divider.VkDivider
        android:id="@+id/mention_separator"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/mention_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mention_bottom_description"
        style="@style/VkUiTypography.Footnote"/>
</merge>
