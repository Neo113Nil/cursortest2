<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/error_layout"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.rlottie.RLottieView
        android:id="@+id/rlottie_view_icon"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="2dp"
        app:raw="@raw/icon_antenna"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/photo_flow_error_title_text"
        style="@style/PhotosRoot.ErrorText"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/error_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/photo_flow_error_retry_text"
        style="@style/PhotosRoot.ErrorButton"/>
</LinearLayout>
