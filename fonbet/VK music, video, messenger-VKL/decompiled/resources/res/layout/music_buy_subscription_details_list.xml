<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/active_indicator"
        android:background="@drawable/music_buy_music_subscription_selector_rect"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_subscription_option_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/music_subscription_option_1"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle2"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/music_subscription_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:maxLines="1"
        android:lineSpacingExtra="1sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/music_subscription_option_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:minHeight="38dp"
        android:maxLines="2"
        android:drawablePadding="14dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:lineHeight="18dp"
        app:layout_constraintEnd_toStartOf="@+id/music_subscription_option_1_new_badge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_subscription_title"
        style="@style/VkUiTypography.SubheadNormal"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1SemiBold"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/music_subscription_option_1_new_badge"
        android:background="@drawable/app_item_badge_new"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:text="@string/music_new_badge"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_subscription_option_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/music_subscription_option_1"
        app:layout_constraintTop_toTopOf="@+id/music_subscription_option_1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/music_subscription_option_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="38dp"
        android:maxLines="2"
        android:drawablePadding="14dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:lineHeight="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_subscription_option_1"
        style="@style/VkUiTypography.SubheadNormal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/music_subscription_option_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="38dp"
        android:maxLines="2"
        android:drawablePadding="14dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:lineHeight="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_subscription_option_2"
        style="@style/VkUiTypography.SubheadNormal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/music_subscription_option_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="38dp"
        android:maxLines="2"
        android:drawablePadding="14dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:lineHeight="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_subscription_option_3"
        style="@style/VkUiTypography.SubheadNormal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/music_subscription_option_5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="38dp"
        android:maxLines="2"
        android:drawablePadding="14dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:lineHeight="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_subscription_option_4"
        style="@style/VkUiTypography.SubheadNormal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/music_subscription_option_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="38dp"
        android:maxLines="2"
        android:drawablePadding="14dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:lineHeight="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_subscription_option_5"
        style="@style/VkUiTypography.SubheadNormal"/>
    <com.vk.music.ui.subscription.BuyMusicSubscriptionButton
        android:id="@+id/buy_music_subscription_btn"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/music_subscription_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_subscription_option_6"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:gravity="center"
        android:id="@+id/music_cancel_dialog"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:layout_marginBottom="16dp"
        android:text="@string/music_buy_subscription_bottomsheet_free_cancel_button_continue_with_restrictions_redesigned"
        android:maxLines="2"
        android:singleLine="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toTopOf="@+id/music_subscription_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_subscription_option_6"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption2"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="top"
        android:id="@+id/music_subscription_subtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_marginBottom="16dp"
        android:maxWidth="360dp"
        android:lineSpacingExtra="1sp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
