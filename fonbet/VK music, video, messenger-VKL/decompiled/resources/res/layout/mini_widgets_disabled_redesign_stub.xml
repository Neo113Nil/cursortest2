<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/stub_container"
        android:background="@drawable/vk_mini_widgets_stub_bg"
        android:layout_width="248dp"
        android:layout_height="184dp">
        <View
            android:id="@+id/top_background_stub"
            android:background="@drawable/vk_mini_widget_bg_16dp"
            android:layout_width="248dp"
            android:layout_height="66dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/tile1_stub"
            android:layout_width="113dp"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/top_background_stub"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/mini_widgets_disabled_redesign_tile_stub"/>
        <include
            android:id="@+id/tile2_stub"
            android:layout_width="113dp"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/top_background_stub"
            app:layout_constraintEnd_toEndOf="parent"
            layout="@layout/mini_widgets_disabled_redesign_tile_stub"/>
        <ImageView
            android:id="@+id/icon_stub"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/bottom_background_stub"
            app:layout_constraintEnd_toStartOf="@+id/title_stub"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_background_stub"
            app:srcCompat="@drawable/vk_icon_settings_outline_28"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <TextView
            android:textColor="?attr/vk_ui_text_accent_themed"
            android:id="@+id/title_stub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_settings_mini_widgets_title"
            android:importantForAccessibility="no"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon_stub"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon_stub"
            app:layout_constraintTop_toTopOf="@+id/icon_stub"
            style="@style/VkUiTypography.Footnote.Unscaled"/>
        <View
            android:id="@+id/bottom_background_stub"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="248dp"
            android:layout_height="42dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/bottom_stub1"
            android:background="@drawable/vk_mini_widget_stub_6dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bottom_stub2"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/bottom_stub2"
            android:background="@drawable/vk_mini_widget_stub_6dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_stub1"
            app:layout_constraintEnd_toStartOf="@+id/bottom_stub3"
            app:layout_constraintStart_toEndOf="@+id/bottom_stub1"/>
        <View
            android:id="@+id/bottom_stub3"
            android:background="@drawable/vk_mini_widget_stub_6dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_stub2"
            app:layout_constraintEnd_toStartOf="@+id/bottom_stub4"
            app:layout_constraintStart_toEndOf="@+id/bottom_stub2"/>
        <View
            android:id="@+id/bottom_stub4"
            android:background="@drawable/vk_mini_widget_stub_6dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_stub3"
            app:layout_constraintEnd_toStartOf="@+id/bottom_stub5"
            app:layout_constraintStart_toEndOf="@+id/bottom_stub3"/>
        <View
            android:id="@+id/bottom_stub5"
            android:background="@drawable/vk_mini_widget_stub_6dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_stub4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bottom_stub4"/>
        <View
            android:background="@drawable/vk_mini_widgets_stub_border_bg"
            android:layout_width="248dp"
            android:layout_height="184dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vk_mini_widgets_stub"
        android:textAlignment="center"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="20dp"
        style="@style/VkUiTypography.Headline1Normal"/>
</LinearLayout>
