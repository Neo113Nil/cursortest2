<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="@dimen/vk_ui_spacing_size_xl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/title"
        android:background="@drawable/bg_empty_channel_message"
        android:paddingTop="@dimen/vk_ui_spacing_size_xs"
        android:paddingBottom="@dimen/vk_ui_spacing_size_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vkm_empty_channel_postponed_posts"
        android:paddingHorizontal="@dimen/vk_ui_spacing_size_xl"/>
</FrameLayout>
