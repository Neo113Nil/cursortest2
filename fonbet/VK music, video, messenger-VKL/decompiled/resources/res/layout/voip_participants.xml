<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/call_participants_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/bottom_sheet"
        android:background="@drawable/voip_bg_corner_top16"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:behavior_hideable="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"/>
    <com.vk.core.view.BottomConfirmButton
        android:layout_gravity="bottom"
        android:id="@+id/invite_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bcb_cancel_bg_color="?attr/vk_ui_background"
        app:bcb_cancel_text="@string/voip_invite_to_call_btn"
        app:bcb_cancel_text_color="?attr/vk_ui_text_contrast_themed"
        app:bcb_divider="?attr/vk_ui_separator_primary"
        app:bcb_send_text="@string/voip_invite_to_call_btn"
        app:bcb_send_text_color="?attr/vk_ui_text_contrast_themed"
        style="@style/VkIm.BottomButton"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottom_control_container"
        android:background="?attr/vk_ui_background_contrast_themed"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/invite_btn_new"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"
            app:icon="@drawable/vk_icon_user_add_outline_24"
            app:text="@string/voip_add"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/share_link_btn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/voip_participants_share_button_start_margin"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="large"
            app:icon="@drawable/vk_icon_chain_outline_28"
            app:text="@string/voip_link"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
