<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/discover_post_bg"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.FootnoteCapsMedium"
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_show_all"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/show_all"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</LinearLayout>
