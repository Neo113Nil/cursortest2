<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/marks_stat_cl"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="26dp">
    <ImageView
        android:id="@+id/star_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_favorite_12"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mark_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_accent_orange_peach"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/mark_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2.5dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/progress_bar"
        app:layout_constraintStart_toEndOf="@+id/star_iv"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Caption1SemiBold"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:layout_marginEnd="2dp"
        app:indicatorColor="?attr/vk_ui_accent_orange_peach"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/dividing_progress_indicator_line"
        app:layout_constraintStart_toEndOf="@+id/mark_tv"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="?attr/vk_ui_separator_primary"
        app:trackCornerRadius="2dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/dividing_progress_indicator_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.8"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="start"
        android:id="@+id/marks_count_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="textStart"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dividing_progress_indicator_line"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Caption1Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
