<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/cover"
        android:background="#80384554"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/aplayer_cover_placeholder"/>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="81dp"
            android:layout_marginEnd="40dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.SubheadBold"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="marquee"
                android:id="@+id/title"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="Custom title"
                android:singleLine="true"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.FootnoteNormal"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="marquee"
                android:id="@+id/content"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="Content!!!!1one"
                android:singleLine="true"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/action_divider"
            android:background="?android:attr/dividerHorizontal"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:src="@null"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/prev"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:layout_weight="1"
                app:srcCompat="@drawable/vk_icon_skip_previous_36"
                style="?android:attr/borderlessButtonStyle"/>
            <ImageView
                android:id="@+id/playpause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:layout_weight="1"
                app:srcCompat="@drawable/vk_icon_play_36"
                style="?android:attr/borderlessButtonStyle"/>
            <ImageView
                android:id="@+id/next"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:layout_weight="1"
                app:srcCompat="@drawable/vk_icon_skip_next_36"
                style="?android:attr/borderlessButtonStyle"/>
            <ImageView
                android:id="@+id/shuffle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:layout_weight="1"
                app:srcCompat="@drawable/vk_icon_shuffle_outline_24"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/stop"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="-40dp"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        app:srcCompat="@drawable/vk_icon_cancel_24"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
