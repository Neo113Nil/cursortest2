<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/music_selectable_bg"
    android:layout_width="320dp"
    android:layout_height="wrap_content">
    <com.vk.music.view.ThumbsImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/audio_image"
        android:layout_width="@dimen/music_track_image"
        android:layout_height="@dimen/music_track_image"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="@dimen/music_picker_offset_grid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/music_image_corners_6"
        app:tiv_background_image="?attr/vk_legacy_placeholder_icon_background"
        app:tiv_empty_resource="@drawable/vk_icon_song_outline_28"
        app:tiv_empty_tint="?attr/vk_legacy_placeholder_icon_foreground_secondary"/>
    <TextView
        android:textStyle="normal"
        android:id="@+id/audio_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:drawablePadding="3dp"
        android:layout_marginStart="12dp"
        app:fontFamily="@font/vk_roboto_regular"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/audio_artist"
        app:layout_constraintEnd_toStartOf="@+id/audio_play_pause_btn"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/audio_image"
        app:layout_constraintTop_toTopOf="@+id/audio_image"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Music.Title"/>
    <TextView
        android:textStyle="normal"
        android:id="@+id/audio_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        app:fontFamily="@font/vk_roboto_regular"
        app:layout_constraintBottom_toBottomOf="@+id/audio_image"
        app:layout_constraintEnd_toStartOf="@+id/audio_play_pause_btn"
        app:layout_constraintStart_toStartOf="@+id/audio_title"
        app:layout_constraintTop_toBottomOf="@+id/audio_title"
        style="@style/Music.SubTitle"/>
    <FrameLayout
        android:id="@+id/audio_play_pause_btn"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/audio_play_pause_btn_icon"
            android:background="@drawable/vkui_bg_button_play"
            android:padding="12dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="center"
            android:rotationY="@integer/angle_rtl_180"
            app:srcCompat="@drawable/vk_icon_play_16"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
