<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/touch_outside"
        android:background="#66000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:soundEffectsEnabled="false"
        android:alpha="0"
        android:importantForAccessibility="no"/>
    <RelativeLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/design_bottom_sheet"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.vk.core.ui.bottomsheet.internal.VkBottomSheetBehavior"
        style="?attr/bottomSheetStyle">
        <View
            android:id="@+id/header_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"/>
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="?attr/vk_ui_background_modal"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:elevation="3dp"
            android:outlineProvider="bounds"/>
        <View
            android:id="@+id/header_shadow"
            android:background="@drawable/picker_bg_attach_bottom_toolbar_shadow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="54dp"
            android:rotation="180"/>
        <FrameLayout
            android:id="@+id/fl_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
