<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@+id/description_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <com.vk.feed.tool.view.newsfeed.text.VkFeedTextWrapper
            android:id="@+id/text_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.text.SquareExcerptTextView
                android:textColor="?attr/vk_ui_text_muted"
                android:id="@+id/description_text_view"
                android:paddingTop="9dp"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4sp"
                android:importantForAccessibility="yes"
                android:paddingStart="@dimen/post_side_padding"
                android:paddingEnd="@dimen/post_side_padding"
                style="@style/VkUiTypography.Paragraph"/>
        </com.vk.feed.tool.view.newsfeed.text.VkFeedTextWrapper>
    </FrameLayout>
</merge>
