<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="21dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/vk_icon_write_outline_56"
        app:tint="?attr/vk_legacy_content_placeholder_icon"/>
    <TextView
        android:textColor="?attr/vk_legacy_text_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        android:text="@string/write_first_post"
        android:lineSpacingExtra="4sp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        style="@style/VkLegacyTypography.Title1"/>
    <TextView
        android:textColor="?attr/vk_legacy_text_placeholder"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="23dp"
        android:text="@string/share_with_friends_important"
        android:lineSpacingExtra="4sp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        style="@style/VkLegacyTypography.Headline"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="@string/new_status"
        android:fontFamily="@font/vk_roboto_medium"
        style="@style/VkLegacyButton.Primary"/>
</LinearLayout>
