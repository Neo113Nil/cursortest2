<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/icon_wrap"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.music.bottomsheets.settings.presentation.RoundedShadowView
            android:layout_gravity="center"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:roundedCornerRadius="16dp"
            app:shadowColor="@color/vk_black_alpha8"
            app:shadowRadius="2dp"/>
        <com.vk.music.bottomsheets.settings.presentation.RoundedShadowView
            android:layout_gravity="center"
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:roundedCornerRadius="16dp"
            app:shadowColor="@color/vk_black_alpha8"
            app:shadowRadius="16dp"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/mood_icon"
            android:background="?attr/vk_ui_background_modal"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:clipToOutline="true"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="end|top"
            android:id="@+id/mood_badge"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
    </FrameLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/mood_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/icon_wrap"
        style="@style/VkUiTypography.Caption1Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
