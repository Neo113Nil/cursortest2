<?xml version="1.0" encoding="utf-8"?>
<com.vk.superapp.ui.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_content_shimmer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">
        <View
            android:id="@+id/achievement_skeleton"
            android:background="@drawable/vk_bg_skeleton_8dp"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_marginTop="17dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/steps_amount_skeleton"
            android:background="@drawable/vk_bg_skeleton_8dp"
            android:layout_width="268dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/achievement_skeleton"/>
        <View
            android:id="@+id/distance_amount_skeleton"
            android:background="@drawable/vk_bg_skeleton_8dp"
            android:layout_width="182dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/steps_amount_skeleton"/>
        <View
            android:id="@+id/goal_text_skeleton"
            android:background="@drawable/vk_bg_skeleton_6dp"
            android:layout_width="104dp"
            android:layout_height="16dp"
            android:layout_marginTop="28dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/distance_amount_skeleton"/>
        <View
            android:id="@+id/divider"
            android:background="@drawable/vk_bg_skeleton_6dp"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goal_text_skeleton"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/counters_skeleton"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:weightSum="7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <View
                android:background="@drawable/vk_bg_skeleton_10dp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="5"
                android:layout_marginEnd="10dp"/>
            <View
                android:background="@drawable/vk_bg_skeleton_10dp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"/>
            <View
                android:background="@drawable/vk_bg_skeleton_10dp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
