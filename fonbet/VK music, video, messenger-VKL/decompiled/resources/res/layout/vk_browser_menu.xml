<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="88dp"
    android:layout_height="36dp">
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/vk_menu_more"
        android:background="@drawable/vk_app_bg_navigation_left"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:scaleType="center"
        android:contentDescription="@string/vk_accessibility_actions"
        app:srcCompat="@drawable/vk_icon_more_horizontal_24"
        app:tint="@color/vk_white"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/vk_menu_close"
        android:background="@drawable/vk_app_bg_navigation_right"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:layout_marginLeft="44dp"
        android:scaleType="center"
        android:contentDescription="@string/close"
        app:srcCompat="@drawable/vk_icon_cancel_24"
        app:tint="@color/vk_white"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/vk_menu_divider"
        android:background="@drawable/vk_app_bg_navigation_divider"
        android:layout_width="1dp"
        android:layout_height="28dp"/>
</FrameLayout>
