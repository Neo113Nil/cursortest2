<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/banner_companion_layout"
    android:background="@drawable/clips_bg_black_rounded_12"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="10dp"
    android:clipToOutline="true">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/ad_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:foregroundGravity="center_vertical"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ad_close_spinner"
        app:layout_constraintStart_toEndOf="@+id/ad_image"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary_alpha"
            android:id="@+id/ad_label"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            app:textAllCaps="true"
            style="@style/VkUiTypography.Caption3Caps"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_contrast"
            android:ellipsize="end"
            android:id="@+id/ad_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="10dp"
            style="@style/VkUiTypography.SubheadMedium.Unscaled"/>
    </LinearLayout>
    <com.vk.core.view.components.spinner.VkSpinner
        android:id="@+id/ad_close_spinner"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        android:indeterminateTint="?attr/vk_ui_accent_azure"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.counter.VkCounter
        android:id="@+id/ad_close_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foregroundGravity="center"
        app:counterMode="primary"
        app:counterSize="small"
        app:layout_constraintBottom_toBottomOf="@+id/ad_close_spinner"
        app:layout_constraintEnd_toEndOf="@+id/ad_close_spinner"
        app:layout_constraintStart_toStartOf="@+id/ad_close_spinner"
        app:layout_constraintTop_toTopOf="@+id/ad_close_spinner"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/ad_close_image"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/vk_icon_cancel_24"
        android:contentDescription="@string/vk_ui_accessibility_close"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_contrast"/>
</androidx.constraintlayout.widget.ConstraintLayout>
