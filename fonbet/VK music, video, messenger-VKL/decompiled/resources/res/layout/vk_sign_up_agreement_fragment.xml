<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/vk_auth_keyboard_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/vk_icon_illustration_welcome_120h"
        android:layout_width="192dp"
        android:layout_height="120dp"
        android:layout_marginTop="150dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/sign_up_agreement_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:gravity="center"
        android:id="@+id/sign_up_agreement_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/continue_btn"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Title2Medium"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_icon_medium"
        android:gravity="center"
        android:id="@+id/sign_up_agreement_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_agreement_title"/>
    <com.vk.auth.ui.VkLoadingButton
        android:id="@+id/continue_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_auth_continue"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/help_button"
        style="@style/VkAuth.Button.Primary"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/help_button"
        android:padding="@dimen/vk_ui_button_padding_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_auth_help_button"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/sign_up_agreement_legal_notes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption2Normal"
        android:textColor="?attr/vk_ui_text_tertiary"
        android:gravity="center"
        android:id="@+id/sign_up_agreement_legal_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
