<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vkim_msg_part_audiomsg_root"
    android:paddingLeft="4dp"
    android:paddingTop="4dp"
    android:paddingRight="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp">
    <com.vk.im.ui.views.AudioMsgStatusView
        android:id="@+id/icon"
        android:layout_width="@dimen/audio_msg_icon_size"
        android:layout_height="@dimen/audio_msg_icon_size"
        android:layout_marginTop="2dp"
        app:amsv_circle_stroke_size="1.5dp"
        app:amsv_color="?attr/vk_legacy_im_attach_tint"
        app:amsv_dot_clip_size="2dp"
        app:amsv_dot_position_degree="45"
        app:amsv_dot_size="7dp"
        app:amsv_pause_content_description="@string/vkim_accessibility_icon_pause"
        app:amsv_pause_icon="@drawable/vk_icon_pause_24"
        app:amsv_pause_icon_offsetX="0.75dp"
        app:amsv_play_content_description="@string/vkim_accessibility_icon_play"
        app:amsv_play_icon="@drawable/vk_icon_play_24"
        app:amsv_play_icon_offsetX="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.im.ui.views.msg.MsgTranscriptButton
        android:id="@+id/btn_transcription"
        android:layout_width="38dp"
        android:layout_height="26dp"
        android:tint="?attr/vk_legacy_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:mtb_hide_transcript_icon="@drawable/vkim_icon_transcript_hide"
        app:mtb_show_transcript_icon="@drawable/vkim_icon_transcript_show"/>
    <com.vk.im.ui.views.WaveFormView
        android:id="@+id/waveform"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/vkim_accessibility_rewinding"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_transcription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vkim_amplifyThreshold="0.5"
        app:vkim_barWidth="2dp"
        app:vkim_indeterminate="false"
        app:vkim_primaryColor="?attr/vk_legacy_accent"
        app:vkim_spaceWidth="1dp"/>
    <TextView
        android:textAppearance="@style/VkIm.MsgPart.AudioMsg.Duration"
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:importantForAccessibility="noHideDescendants"
        android:layout_marginStart="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/waveform"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextSimple"
        android:id="@+id/timeAndStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2.5dp"
        android:includeFontPadding="false"
        android:importantForAccessibility="noHideDescendants"
        android:layout_marginEnd="3.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
