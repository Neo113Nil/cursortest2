<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/vkui_bg_button_secondary_radius_8"
    android:layout_width="wrap_content"
    android:layout_height="30dp"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="16dp"
    android:paddingHorizontal="6dp"
    android:paddingVertical="4dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/tvCategoryChipTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginEnd="4dp"
        style="@style/VkUiTypography.ParagraphNormal"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCategoryChipClose"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:srcCompat="@drawable/vk_icon_cancel_20"
        app:tint="?attr/vk_legacy_icon_outline_secondary"/>
</LinearLayout>
