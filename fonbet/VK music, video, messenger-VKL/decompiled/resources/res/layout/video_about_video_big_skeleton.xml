<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/video_skeleton"
        android:background="@color/vk_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:backgroundTint="?attr/vk_ui_background_secondary"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/avatar"
        android:background="@drawable/vk_bg_skeleton_round"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:backgroundTint="?attr/vk_ui_background_secondary"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_skeleton"/>
    <View
        android:id="@+id/line1"
        android:background="@drawable/bg_rounded_4"
        android:layout_width="156dp"
        android:layout_height="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        android:backgroundTint="?attr/vk_ui_background_secondary"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toBottomOf="@+id/video_skeleton"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <View
        android:id="@+id/line2"
        android:background="@drawable/bg_rounded_4"
        android:layout_width="100dp"
        android:layout_height="12dp"
        android:backgroundTint="?attr/vk_ui_background_secondary"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/line1"
        app:layout_constraintTop_toBottomOf="@+id/line1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
