<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/posting_step_1_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/posting_step1_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/posting_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/post_text_restriction_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/posting_top_bar">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/posting_text_and_attachment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/post_attachments_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:isScrollContainer="true"
                    android:overScrollMode="ifContentScrolls"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <com.vk.core.view.components.formitem.VkInputSelect
                        android:textColor="?attr/vk_ui_text_primary"
                        android:textColorHint="?attr/vk_ui_text_secondary"
                        android:gravity="start|top"
                        android:id="@+id/post_text_input"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="20dp"
                        android:hint="@string/post_text_input_hint"
                        android:inputType="textMultiLine"
                        android:isScrollContainer="true"
                        android:overScrollMode="ifContentScrolls"
                        android:autofillHints=""
                        app:disableSaveInstanceState="true"
                        app:fillByHeight="true"
                        app:inputSize="undefined"
                        style="@style/VkUiTypography.TextNormal"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="left"
            android:layout_gravity="center_horizontal"
            android:id="@+id/post_text_restriction_text_view"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@+id/bottom_toolbar_separator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/VkUiTypography.Footnote"/>
        <com.vk.feed.design.view.posting.divider.PostingDivider
            android:id="@+id/bottom_toolbar_separator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@+id/media_picker_open_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/media_picker_open_button"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:contentDescription="@string/bottom_toolbar_photo_video_picker_content_description"
            android:layout_marginStart="12dp"
            app:buttonAppearance="neutral"
            app:buttonMode="secondary"
            app:buttonSizeType="small"
            app:icon="@drawable/vk_icon_picture_plus_outline_20"
            app:iconSize="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/drafts_open_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/drafts_open_button"
            app:text="@string/bottom_toolbar_photo_video_picker"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/drafts_open_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/accessibility_drafts_list_button"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginVertical="12dp"
            app:buttonAppearance="neutral"
            app:buttonMode="secondary"
            app:buttonSizeType="small"
            app:icon="@drawable/vk_icon_list_pen_outline_20"
            app:iconSize="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:text="@string/bottom_toolbar_drafts"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include layout="@layout/posting_media_picker_content"/>
    <include layout="@layout/posting_mention_content"/>
    <com.vk.stories.design.view.MentionHint
        android:layout_gravity="bottom"
        android:id="@+id/mention_description_container"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>
    <include layout="@layout/posting_loader_view"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
