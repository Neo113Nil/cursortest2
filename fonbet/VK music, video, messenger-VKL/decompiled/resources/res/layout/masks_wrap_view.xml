<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/masks_wrap_author_action_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/masks_wrap_author"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="84dp">
            <View
                android:background="@drawable/bg_stories_masks_author"
                android:layout_width="44dp"
                android:layout_height="44dp"/>
            <com.vk.imageloader.view.VKCircleImageView
                android:layout_gravity="center"
                android:id="@+id/masks_wrap_author_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="10dp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption1"
                android:textColor="@color/vk_white"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/masks_wrap_author_name"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginLeft="42dp"
                android:singleLine="true"
                android:shadowColor="#99000000"
                android:shadowDy="2"
                android:shadowRadius="8"/>
        </FrameLayout>
        <TextView
            android:textAppearance="@style/VkUiTypography.DisplayTitle3Medium"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/masks_wrap_action_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="52dp"
            android:layout_marginRight="52dp"
            android:shadowColor="#99000000"
            android:shadowDy="2"
            android:shadowRadius="8"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/masks_wrap_progress"
        android:background="@drawable/bg_mask_load_progress"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="@dimen/masks_progress_size"
        android:layout_height="@dimen/masks_progress_size"
        android:foreground="@drawable/highlight_circle_white"
        android:contentDescription="@string/accessibility_cancel_mask_loading">
        <com.vk.core.ui.CircularProgressView
            android:layout_gravity="center"
            android:id="@+id/masks_wrap_progress_circular"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cpv_animAutostart="true"
            app:cpv_animSwoopDuration="0"
            app:cpv_color="#fff"
            app:cpv_indeterminate="false"
            app:cpv_maxProgress="1"
            app:cpv_thickness="2.5dp"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/vk_icon_cancel_outline_shadow_large_48_close"
            app:tint="#fff"/>
    </FrameLayout>
</merge>
