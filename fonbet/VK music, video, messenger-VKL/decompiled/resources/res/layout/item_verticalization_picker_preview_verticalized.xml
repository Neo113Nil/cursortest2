<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="39dp"
    android:layout_height="64dp">
    <View
        android:layout_gravity="center"
        android:id="@+id/picker_preview_verticalized_selector"
        android:background="@drawable/bg_verticalization_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="5dp"/>
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center"
        android:id="@+id/picker_preview_verticalized_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/accessibility_photo"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="8dp"
        app:placeholderImage="@drawable/vk_default_placeholder"/>
</FrameLayout>
