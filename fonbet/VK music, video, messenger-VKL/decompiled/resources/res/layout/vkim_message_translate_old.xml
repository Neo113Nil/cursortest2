<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/message_translate_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/message_translate_close_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/close"
            app:srcCompat="@drawable/vk_icon_cancel_outline_28"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/message_translate_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vkim_message_translate_title"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VkUiTypography.DisplayTitle1Medium"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/message_translate_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.translate.impl.views.MessageTranslationUnitViewGroup
                    android:id="@+id/message_translate_translation_unit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <com.vk.translate.impl.views.MessageTranslateActionsLayout
                    android:id="@+id/message_translate_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.vk.translate.impl.views.TranslateFailedView
            android:layout_gravity="center_horizontal"
            android:id="@+id/message_translate_language_not_recognized"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <com.vk.core.ui.CircularProgressView
            android:layout_gravity="center_horizontal"
            android:id="@+id/message_translate_progress_bar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:cpv_animAutostart="true"
            app:cpv_indeterminate="true"/>
    </FrameLayout>
</LinearLayout>
