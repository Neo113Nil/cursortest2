<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="16dp">
    <ImageView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:src="@drawable/vk_icon_folder_plus_badge_outline_56"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_legacy_icon_secondary"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vkim_folders_create_promo_subtitle"
        android:fontFamily="@font/vk_roboto_regular"/>
    <TextView
        android:textSize="15sp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/vkim_confirm_btn"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="48dp"
        android:text="@string/vkim_folders_create_promo_confirm_text"
        android:fontFamily="@string/font_family_medium"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/VkLegacyButton.Primary"/>
</LinearLayout>
