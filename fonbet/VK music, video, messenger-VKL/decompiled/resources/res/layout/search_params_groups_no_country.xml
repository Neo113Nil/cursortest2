<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:background="?attr/vk_ui_background_content"
        android:paddingBottom="48dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <com.vk.core.view.ConstrainedLinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="@dimen/standard_list_item_padding"
            android:paddingRight="@dimen/standard_list_item_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vk_max_width="400dp">
            <TextView
                android:text="@string/discover_search_sort"
                style="@style/VKUIFormHeader"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp">
                <include
                    android:id="@+id/spinner_sort"
                    android:layout_width="0px"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    layout="@layout/vk_discover_search_spinner"/>
            </LinearLayout>
            <TextView
                android:text="@string/discover_search_community_type"
                style="@style/VKUIFormHeader"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp">
                <include
                    android:id="@+id/spinner_type"
                    android:layout_width="0px"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    layout="@layout/vk_discover_search_spinner"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_cities_title"
                android:text="@string/vk_discover_search_city"
                style="@style/VKUIFormHeader"/>
            <TextView
                android:id="@+id/tv_cities"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:text="@string/vk_discover_search_city"
                android:drawablePadding="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                app:drawableEndCompat="@drawable/vk_icon_chevron_down_24"
                app:drawableTint="?attr/vk_ui_icon_secondary"
                style="@style/VKUIFormButton"/>
            <com.vk.common.view.settings.SettingsCheckBoxView
                android:id="@+id/cb_only_future"
                android:layout_width="match_parent"
                android:layout_height="48dp"/>
            <Space
                android:layout_width="1px"
                android:layout_height="56dp"/>
        </com.vk.core.view.ConstrainedLinearLayout>
    </ScrollView>
    <com.vk.core.view.components.button.VkSimpleButton
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/tv_apply_params"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_discover_search_show_result"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</merge>
