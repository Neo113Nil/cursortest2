<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/modal_post_reactions_content_holder"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:elevation="0dp"
        style="@style/VKAppBar">
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/modal_post_reactions_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.tabs.VkSecondaryTabLayout
            android:id="@+id/modal_post_reactions_tabs"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            app:tabGravity="start"
            app:tabMinWidth="0dp"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"/>
        <FrameLayout
            android:id="@+id/modal_post_reactions_divider"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp">
            <com.vk.core.view.components.divider.VkDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"/>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/vk_toolbar_behavior_scrolling">
        <com.vk.core.view.disableable.DisableableViewPager
            android:id="@+id/modal_post_reactions_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/modal_post_reactions_error_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/liblists_err_text"
                android:freezesText="true"
                android:paddingHorizontal="32dp"
                style="@style/VkUiTypography.Headline1Normal"/>
            <com.vk.core.view.components.button.VkButton
                android:layout_gravity="center_horizontal"
                android:id="@+id/modal_post_reactions_error_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:buttonAppearance="accent"
                app:buttonMode="tertiary"
                app:buttonSizeType="small"
                app:text="@string/liblists_retry"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/modal_post_reactions_empty_state_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/post_reactions_modal_empty_tabs"
                android:freezesText="true"
                android:paddingHorizontal="32dp"
                style="@style/VkUiTypography.Headline1Normal"/>
        </LinearLayout>
        <com.vk.core.view.components.spinner.VkSpinner
            android:layout_gravity="center"
            android:id="@+id/modal_post_reactions_progress_bar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:spinnerSize="medium"
            style="?attr/progressBarStyle"/>
    </FrameLayout>
    <com.vk.core.view.AppBarShadowView style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
