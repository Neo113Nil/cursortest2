<?xml version="1.0" encoding="utf-8"?>
<com.vkontakte.android.ui.FullWidthLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/drawer_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="16dp">
        <ImageView
            android:id="@+id/leftmenu_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            app:srcCompat="@drawable/vk_icon_user_24"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1Medium.Unscaled"
            android:textColor="?attr/vk_ui_text_contrast_themed"
            android:gravity="center"
            android:id="@+id/leftmenu_counter2"
            android:background="@drawable/left_notify_tablet_collapsed"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:minWidth="20dp"
            android:text="1"
            android:singleLine="true"
            android:layout_alignParentRight="true"/>
        <View
            android:id="@+id/leftmenu_icon_new_badge"
            android:background="@drawable/left_menu_new_icon_bg"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/leftmenu_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:text="TextView"
        android:singleLine="true"
        android:layout_weight="1"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteMedium.Unscaled"
        android:textColor="?attr/vk_ui_background_accent_themed"
        android:gravity="center"
        android:id="@+id/leftmenu_new_badge"
        android:background="@drawable/fragment_menu_new_bg"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="26dp"
        android:text="@string/new_badge"
        android:singleLine="true"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:gravity="center"
        android:id="@+id/leftmenu_counter"
        android:background="@drawable/left_notify"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="26dp"
        android:minWidth="24dp"
        android:text="1"
        android:singleLine="true"/>
</com.vkontakte.android.ui.FullWidthLinearLayout>
