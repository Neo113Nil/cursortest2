<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/music_selectable_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="84dp">
    <FrameLayout
        android:id="@+id/music_audio_item_playlist_image_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="@dimen/music_thumbs_offset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.music.view.ThumbsImageView
            android:id="@+id/audio_image"
            android:layout_width="@dimen/music_playlist_image"
            android:layout_height="@dimen/music_playlist_image"
            app:roundedCornerRadius="@dimen/music_image_corners_8"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_song_outline_28"
            app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
        <ImageView
            android:id="@+id/audio_playing_indicator"
            android:background="@drawable/music_dark_round_rect"
            android:visibility="gone"
            android:layout_width="@dimen/music_playlist_image"
            android:layout_height="@dimen/music_playlist_image"/>
    </FrameLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/audio_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:lineSpacingExtra="4sp"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/audio_artist"
        app:layout_constraintEnd_toStartOf="@+id/playlist_explicit"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/music_audio_item_playlist_image_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.TextNormal"/>
    <ImageView
        android:id="@+id/playlist_explicit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="@dimen/android_4_fix"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_title"
        app:layout_constraintEnd_toStartOf="@+id/audio_menu"
        app:layout_constraintStart_toEndOf="@+id/audio_title"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/audio_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/audio_menu"
        app:layout_constraintStart_toStartOf="@+id/audio_title"
        app:layout_constraintTop_toBottomOf="@+id/audio_title"
        style="@style/VkUiTypography.SubheadNormal"/>
    <ImageView
        android:id="@+id/audio_menu"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_actions_small_24"
        android:contentDescription="@string/music_talkback_more"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ActionButton.Gray"/>
</androidx.constraintlayout.widget.ConstraintLayout>
