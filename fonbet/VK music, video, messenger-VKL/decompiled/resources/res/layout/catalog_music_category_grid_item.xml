<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="?attr/vk_ui_background_contrast_themed"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:layout_margin="@dimen/catalog_link_music_category_margin"
    android:foreground="?attr/selectableItemBackground"
    android:backgroundTint="?attr/vk_ui_background_contrast_themed"
    app:cardCornerRadius="12dp"
    app:cardElevation="@dimen/catalog_link_music_category_elevation">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.music.view.MusicCoverStackedView
            android:id="@+id/music_category_stacked_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:translationX="@dimen/music_stacked_image_default_translation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/music_rectangle_right_image"
            android:visibility="gone"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:translationX="@dimen/music_right_image_default_translation"
            app:actualImageScaleType="fitEnd"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/music_rectangle_right_image_animation"
            android:visibility="gone"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:translationX="@dimen/music_right_image_default_translation"
            app:actualImageScaleType="fitEnd"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/music_category_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="46dp"
            app:layout_constraintBottom_toTopOf="@+id/music_category_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/VkUiTypography.Headline1Normal"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/music_category_subtitle"
            android:paddingTop="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/music_category_title"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/music_category_title"
            app:layout_constraintTop_toBottomOf="@+id/music_category_title"
            style="@style/VkUiTypography.Footnote"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
