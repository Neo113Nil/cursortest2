<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.formitem.VkFormField
        android:id="@+id/voip_phone_form_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/vk_ui_base_padding_vertical"
        app:activeInputIcon="@drawable/vk_icon_cancel_24">
        <com.vk.core.view.components.formitem.VkInputSelect
            android:id="@+id/voip_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/voip_call_by_phone_hint"
            android:maxLength="20"
            android:drawablePadding="@dimen/vk_ui_button_tertiary_small_padding_horizontal_icon"
            android:inputType="numberSigned"
            android:drawableStart="@drawable/vk_icon_phone_outline_24"
            app:inputSize="singleLine"
            style="@style/VkInput"/>
    </com.vk.core.view.components.formitem.VkFormField>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/voip_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VkUiTypography.Caption1Normal"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/voip_action_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vk_ui_button_large_height"
        android:layout_marginTop="@dimen/vk_ui_base_padding_horizontal"
        android:text="@string/voip_call_by_phone_check_number"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/voip_alternative_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vk_ui_button_large_height"
        android:layout_marginTop="@dimen/vk_ui_base_padding_vertical"
        android:text="@string/voip_call_by_phone_call_anyway"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"/>
</LinearLayout>
