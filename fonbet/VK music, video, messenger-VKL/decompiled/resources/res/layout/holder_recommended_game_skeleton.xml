<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skeleton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/banner"
            android:background="@drawable/bg_rounded_6"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:backgroundTint="?attr/vk_ui_background_secondary"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line1"
            android:background="@drawable/bg_rounded_4"
            android:layout_width="150dp"
            android:layout_height="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="?attr/vk_ui_background_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/banner"/>
        <View
            android:id="@+id/line2"
            android:background="@drawable/bg_rounded_4"
            android:layout_width="100dp"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="?attr/vk_ui_background_secondary"
            app:layout_constraintStart_toStartOf="@+id/line1"
            app:layout_constraintTop_toBottomOf="@+id/line1"/>
        <View
            android:id="@+id/separator"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="2dp"
            android:backgroundTint="?attr/vk_ui_separator_primary2x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/line2"
            app:layout_constraintStart_toStartOf="@+id/line2"
            app:layout_constraintTop_toBottomOf="@+id/line2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.core.view.shimmer.ShimmerFrameLayout>
