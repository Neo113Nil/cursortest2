<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pds_on_media_audio_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pds_on_media_audio_song_badge_container"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:paddingStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="wrap"
        app:layout_constraintWidth_percent="0.7">
        <View
            android:id="@+id/pds_on_media_audio_track_song_background"
            android:background="@drawable/bg_rounded_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.7"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@color/vk_gray_800"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/pds_on_media_audio_button_add"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/pds_on_media_audio_song_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginBottom="4dp"
            android:contentDescription="@string/accessibility_compact_attach_photo"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/pds_on_media_audio_song_name"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_music_12"/>
        <com.vk.feed.tool.view.newsfeed.music.RunningLineTextView
            android:textStyle="normal"
            android:textColor="?attr/vk_ui_text_contrast"
            android:gravity="center_vertical"
            android:id="@+id/pds_on_media_audio_song_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:minWidth="84dp"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/pds_on_media_audio_explicit_label"
            app:layout_constraintStart_toEndOf="@+id/pds_on_media_audio_song_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Caption1SemiBold"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="start|center_vertical"
            android:id="@+id/pds_on_media_audio_explicit_label"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/vk_icon_error_circle_12"
            android:scaleType="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="13dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/pds_on_media_audio_button_add"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/pds_on_media_audio_song_name"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_ui_icon_contrast"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="start|center_vertical"
            android:id="@+id/pds_on_media_audio_button_add"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/vk_icon_add_16"
            android:scaleType="fitStart"
            android:paddingStart="4dp"
            android:paddingVertical="13dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/pds_on_media_audio_explicit_label"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_ui_icon_contrast"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.feed.design.view.newsfeed.overlay.VkOverlayCircleButton
        android:id="@+id/pds_on_media_audio_circle_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
