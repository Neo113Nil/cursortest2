<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">
    <com.vk.auth.ui.VkLoadingButton
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:id="@+id/libverify_callin_make_call_button"
        android:background="@drawable/vk_ui_auth_bg_landing_primary_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="@string/vk_otp_method_selection_verification_methods_libverify_callin_make_call"
        app:vk_lb_text_appearance="@style/VkUiTypography.Headline1Medium"
        style="@style/VKID.View.Button"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/libverify_callin_sms_info_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="32dp"
        android:text="@string/vk_otp_method_selection_verification_methods_libverify_callin_sms_info_text"
        style="@style/VkUiTypography.Caption2Normal"/>
</LinearLayout>
