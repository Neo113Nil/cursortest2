<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/error_layout"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/vk_gray_500"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/error_text"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="?attr/appkitDefaultErrorText"
        android:freezesText="true"
        style="@style/VkUiTypography.Text.Unscaled"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/error_retry"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:text="@string/retry"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="small"/>
</LinearLayout>
