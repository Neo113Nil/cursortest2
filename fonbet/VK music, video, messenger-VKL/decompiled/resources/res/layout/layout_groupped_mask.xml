<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:foreground="@drawable/mask_groupped_tab_bg">
    <View
        android:id="@+id/view_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/vk_icon_deprecated_bg_group_effect_unselected"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/iv_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:placeholderImage="@drawable/ic_stories_masks_placeholder_mask"
        app:roundedCornerRadius="40dp"/>
    <View
        android:id="@+id/view_selected_foreground"
        android:background="@drawable/bg_group_effect_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
