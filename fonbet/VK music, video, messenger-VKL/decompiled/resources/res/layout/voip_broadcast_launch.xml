<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_black_alpha60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="100sp"
        android:textColor="@color/vk_white"
        android:id="@+id/awaiting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vk_roboto_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.ColorProgressBar
        android:id="@+id/launching"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:color="@color/vk_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/vk_white"
        android:id="@+id/cancel"
        android:background="@drawable/btn_white20_8dp"
        android:paddingTop="7.5dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:minHeight="44dp"
        android:text="@string/voip_broadcast_cancel"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        android:fontFamily="@font/vk_roboto_medium"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/error_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@+id/error_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/vk_icon_info_circle_outline_28"
        app:tint="@color/vk_white"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxWidth="200dp"
        android:fontFamily="@font/vk_roboto_regular"
        android:letterSpacing="0.01"
        app:layout_constraintBottom_toTopOf="@+id/error_retry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/vk_white"
        android:id="@+id/error_retry"
        android:background="@drawable/btn_white20_8dp"
        android:paddingTop="7.5dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="44dp"
        android:text="@string/voip_broadcast_retry"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        android:fontFamily="@font/vk_roboto_medium"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/error_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_text"
        app:layout_constraintVertical_chainStyle="packed"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/vk_white"
        android:id="@+id/error_close"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="7.5dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="36dp"
        android:text="@string/voip_broadcast_close"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        android:fontFamily="@font/vk_roboto_medium"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_retry"
        app:layout_constraintVertical_chainStyle="packed"/>
</androidx.constraintlayout.widget.ConstraintLayout>
