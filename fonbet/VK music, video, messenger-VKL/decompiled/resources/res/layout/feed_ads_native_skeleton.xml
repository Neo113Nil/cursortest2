<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/feed_ads_avatar_skeleton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/feed_ads_title_skeleton"
        android:layout_width="140dp"
        android:layout_height="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/feed_ads_avatar_skeleton"
        app:layout_constraintTop_toTopOf="@+id/feed_ads_avatar_skeleton"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/feed_ads_subtitle_skeleton"
        android:layout_width="80dp"
        android:layout_height="8dp"
        android:layout_marginTop="9dp"
        app:layout_constraintStart_toStartOf="@+id/feed_ads_title_skeleton"
        app:layout_constraintTop_toBottomOf="@+id/feed_ads_title_skeleton"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/feed_ads_image_skeleton"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feed_ads_subtitle_skeleton"/>
</merge>
