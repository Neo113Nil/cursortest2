<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.AlertDialogLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/parentPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline1Normal"
            android:textColor="?attr/vk_ui_text_subhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/posting_settings_paid_duration_description"/>
        <Spinner
            android:id="@+id/spinner"
            android:background="@drawable/vkui_spinner_default_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:popupBackground="@drawable/vk_bg_modal_dialog"
            android:paddingEnd="32dp"/>
    </LinearLayout>
</androidx.appcompat.widget.AlertDialogLayout>
