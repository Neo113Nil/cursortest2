<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/error_layout"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/error_text"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/sticker_search_error_title"
        android:freezesText="true"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:layout_gravity="center_horizontal"
        android:id="@+id/error_retry"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/sticker_search_error_button"
        style="@style/VkUiTypography.Headline2Normal"/>
</LinearLayout>
