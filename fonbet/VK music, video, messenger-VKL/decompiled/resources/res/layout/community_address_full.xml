<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/full_address"
    android:background="@drawable/bg_community_all_addresses_bottom_sheet"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/community_address_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.components.cell.VkMiniInfoCell
                android:id="@+id/community_address_place_mini_info_cell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.components.cell.VkMiniInfoCell
                android:id="@+id/community_address_metro_mini_info_cell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.components.cell.VkMiniInfoCell
                android:id="@+id/community_address_phone_mini_info_cell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.components.cell.VkMiniInfoCell
                android:id="@+id/community_address_work_status_mini_info_cell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/community_address_time_table_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.components.button.VkSimpleButton
                android:id="@+id/community_address_create_route_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="@dimen/vk_ui_spacing_size_xl"
                android:text="@string/create_a_route"
                android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
                app:buttonAppearance="accent"
                app:buttonMode="primary"
                app:buttonSizeType="large"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
