<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:paddingEnd="8dp">
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_action_button"
        android:paddingTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:letterSpacing="0.0133"
        app:drawableTint="?attr/vk_ui_icon_accent_themed"
        style="@style/PhotosRoot.PageHeaderTextButtonStyle"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/iv_settings"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/album_details_setting_button_content_description"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"
        app:tint="?attr/vk_ui_icon_accent_themed"
        style="@style/PhotosRoot.PageHeaderButtonStyle"/>
</LinearLayout>
