<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="96dp"
    android:layout_height="72dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/attach_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundedCornerRadius="2dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/attach_title"
        android:background="@drawable/bg_thumb_size"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:singleLine="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:fontFamily="@string/font_family_medium"/>
    <ProgressBar
        android:id="@+id/attach_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginBottom="2dp"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/attach_error"
        android:background="?attr/vk_legacy_placeholder_icon_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginBottom="2dp"
        android:text="@string/error"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/attach_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8.5dp"
        android:layout_marginRight="-8.5dp"
        android:src="@drawable/vk_icon_deprecated_ic_deattach_28"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/vkim_accessibility_remove_attachment"/>
</RelativeLayout>
