<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/banner_companion_layout"
    android:background="@drawable/clips_bg_black_rounded_12"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_marginBottom="10dp"
    android:clipToOutline="true">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/ad_image"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:gravity="center_vertical"
        android:id="@+id/ad_label"
        android:background="@drawable/clips_bg_round_4_overlay_primary"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintStart_toStartOf="@+id/ad_image"
        app:layout_constraintTop_toTopOf="@+id/ad_image"
        style="@style/VkUiTypography.Caption3"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:foregroundGravity="center_vertical"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ad_close_spinner"
        app:layout_constraintStart_toEndOf="@+id/ad_image"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_contrast"
            android:ellipsize="end"
            android:id="@+id/ad_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/VkUiTypography.Headline2Medium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary_invariably"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/ad_button_cta"
            android:background="@drawable/clips_bg_contrast_round_8"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            style="@style/VkUiTypography.Caption1Medium"/>
    </LinearLayout>
    <com.vk.core.view.components.spinner.VkSpinner
        android:id="@+id/ad_close_spinner"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:indeterminateTint="?attr/vk_ui_accent_azure"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.counter.VkCounter
        android:id="@+id/ad_close_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foregroundGravity="center"
        app:counterMode="primary"
        app:counterSize="small"
        app:layout_constraintBottom_toBottomOf="@+id/ad_close_spinner"
        app:layout_constraintEnd_toEndOf="@+id/ad_close_spinner"
        app:layout_constraintStart_toStartOf="@+id/ad_close_spinner"
        app:layout_constraintTop_toTopOf="@+id/ad_close_spinner"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/ad_close_image"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/vk_icon_cancel_24"
        android:contentDescription="@string/vk_ui_accessibility_close"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_contrast"/>
</androidx.constraintlayout.widget.ConstraintLayout>
