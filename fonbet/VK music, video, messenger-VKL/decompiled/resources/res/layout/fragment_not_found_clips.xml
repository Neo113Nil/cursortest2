<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/not_found_clips_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/accessibility_back"
        app:theme="?attr/actionBarTheme"
        app:titleTextAppearance="@style/ToolbarTitle"
        style="?attr/actionBarTheme"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/vk_icon_error_circle_outline_32"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/error"
            style="@style/VkUiTypography.Title2Normal.Unscaled"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/not_found_clips_error_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/clips_not_found"
            style="@style/VkUiTypography.Headline1Normal.Unscaled"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/watch_top_clips"
            style="@style/VkUiTypography.Headline1Normal.Unscaled"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/not_found_clips_go_to_clips_feed"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:text="@string/go_to_clips_feed"
            app:buttonAppearance="overlay"
            app:buttonMode="primary"
            app:buttonSizeType="medium"/>
    </LinearLayout>
</LinearLayout>
