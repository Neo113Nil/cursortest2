<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/music_playlist_slider_layout_padding"
    android:paddingBottom="@dimen/music_playlist_slider_layout_padding"
    android:layout_width="@dimen/music_smart_playlist_layout_width"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/music_playlist_slider_layout_padding"
    android:paddingEnd="@dimen/music_playlist_slider_layout_padding">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/background_image"
        android:layout_width="@dimen/music_smart_playlist_image_width"
        android:layout_height="240dp"
        app:emptyImagePlaceholder="@drawable/playlist_smart_cover_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="12dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/artist_thumb"
        android:layout_width="137dp"
        android:layout_height="137dp"
        android:translationY="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/background_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundAsCircle="true"
        app:roundedCornerRadius="100dp"/>
    <com.vk.music.view.MusicRoundPlayView
        android:id="@+id/play_view"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/background_image"
        app:layout_constraintEnd_toEndOf="@+id/background_image"
        app:mrp_background_tint="@color/vk_white"
        app:mrp_compact_progess_bar="true"
        app:mrp_pause_icon="@drawable/vk_icon_pause_28"
        app:mrp_play_icon="@drawable/vk_icon_play_28"
        app:mrp_play_icon_tint="@color/vk_black"/>
    <TextView
        android:textAppearance="@style/Card.Title2"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/artist_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2Normal"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/artist_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/artist_title"
        app:layout_goneMarginTop="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
