<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.newsfeed.impl.views.ModalCommentsPaginatedView
        android:layout_gravity="center"
        android:id="@+id/rpb_list"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/news_entry_feedback_comments_order_button"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="41dp"
        android:paddingStart="@dimen/post_side_padding"
        android:paddingEnd="@dimen/post_side_padding">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2Normal"
            android:textColor="?attr/vk_ui_text_accent"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|top"
            android:id="@+id/news_entry_feedback_comments_order_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:drawablePadding="4dp"
            android:textAlignment="gravity"
            app:drawableEndCompat="@drawable/vk_icon_dropdown_16"
            app:drawableTint="?attr/vk_ui_icon_accent"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
