<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/vk_ui_spacing_size_l">
    <com.vk.im.design.view.listitem.skeleton.ImChatProfileMembersSkeleton
        android:id="@+id/skeletonFirst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.im.design.view.listitem.skeleton.ImChatProfileMembersSkeleton
        android:id="@+id/skeletonSecond"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size3_xl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonFirst"/>
    <com.vk.im.design.view.listitem.skeleton.ImChatProfileMembersSkeleton
        android:id="@+id/skeletonThird"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size3_xl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonSecond"/>
</androidx.constraintlayout.widget.ConstraintLayout>
