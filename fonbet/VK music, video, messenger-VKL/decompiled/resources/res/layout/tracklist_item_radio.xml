<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/music_selectable_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="16dp">
        <com.vk.music.view.ThumbsImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/audio_image"
            android:layout_width="@dimen/music_track_image"
            android:layout_height="@dimen/music_track_image"
            app:roundedCornerRadius="@dimen/music_podcasts_image_playlist_cover_corners"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_radiowaves_around_outline_28"
            app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
        <ImageView
            android:id="@+id/audio_playing_indicator"
            android:background="@drawable/music_dark_round_rect"
            android:visibility="gone"
            android:layout_width="@dimen/music_track_image"
            android:layout_height="@dimen/music_track_image"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/audio_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:minHeight="20dp"
        android:maxLines="1"
        android:drawablePadding="3dp"
        android:layout_weight="1"
        android:layout_marginStart="9dp"/>
</LinearLayout>
