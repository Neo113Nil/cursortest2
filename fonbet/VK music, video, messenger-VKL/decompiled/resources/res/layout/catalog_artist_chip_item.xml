<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_artist_chip"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:minHeight="@dimen/catalog_artist_chip_min_height">
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/artist_chip_button"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minHeight="@dimen/catalog_artist_chip_min_height"
        app:backgroundColorful="false"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:iconColorful="false"
        app:textColorful="false"/>
</FrameLayout>
