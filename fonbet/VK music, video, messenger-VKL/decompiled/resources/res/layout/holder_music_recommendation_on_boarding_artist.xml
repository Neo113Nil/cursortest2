<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="138dp">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/holder_music_recommendation_on_boarding_artist_image_container"
        android:layout_width="@dimen/music_recommendation_on_boarding_image_width"
        android:layout_height="@dimen/music_recommendation_on_boarding_image_width"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKCircleImageView
            android:id="@+id/holder_music_recommendation_on_boarding_artist_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/holder_music_recommendation_on_boarding_artist_image_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/holder_music_recommendation_on_boarding_artist_progress"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminate="true"
            android:indeterminateOnly="true"
            android:indeterminateTint="@color/vk_white"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/holder_music_recommendation_on_boarding_artist_heart"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:srcCompat="@drawable/vk_icon_like_36"
            app:tint="@color/vk_white"/>
    </FrameLayout>
    <TextView
        android:textAppearance="?attr/vk_ui_typography_subhead"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/holder_music_recommendation_on_boarding_artist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/holder_music_recommendation_on_boarding_artist_image_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
