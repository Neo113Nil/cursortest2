<?xml version="1.0" encoding="utf-8"?>
<com.vk.feed.tool.view.newsfeed.text.VkFeedTextWrapper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.vk.core.view.text.SquareExcerptTextView
        android:textColor="?attr/vk_ui_text_primary"
        android:linksClickable="false"
        android:id="@+id/post_view"
        android:paddingLeft="@dimen/post_side_padding"
        android:paddingTop="4dp"
        android:paddingRight="@dimen/post_side_padding"
        android:paddingBottom="6dp"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:textDirection="locale"
        android:hyphenationFrequency="none"
        style="@style/VkUiTypography.ParagraphNormal"/>
</com.vk.feed.tool.view.newsfeed.text.VkFeedTextWrapper>
