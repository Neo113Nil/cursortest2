<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.ImAvatarView
        android:layout_gravity="center_horizontal"
        android:id="@+id/im_avatar"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="26dp"
        android:contentDescription="@string/vkim_accessibility_avatar"
        style="@style/VkIm.AvatarView"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <TextView
            android:textSize="20sp"
            android:textStyle="normal"
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="center_vertical"
            android:id="@+id/im_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4sp"
            android:fontFamily="@string/font_family_medium"
            app:vk_layout_isFluid="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/im_verified"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:translationY="0sp"
            android:layout_marginStart="4dp"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/vk_gray_400"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/im_last_seen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        android:lineSpacingExtra="5sp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
</LinearLayout>
