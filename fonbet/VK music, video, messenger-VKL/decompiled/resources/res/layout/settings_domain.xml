<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="16dp"
            android:textColor="?attr/vk_ui_text_primary"
            android:textColorHint="?attr/vk_ui_text_secondary"
            android:id="@+id/domain_input"
            android:background="@drawable/domain_text_field"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/page_address"
            android:singleLine="true"
            android:maxLength="32"
            android:inputType="textFilter"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/domain_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Status"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/domain_explain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/domain_explain"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="?attr/vk_ui_text_accent"
            android:id="@+id/domain_current_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://vk.com/durov"/>
    </LinearLayout>
</ScrollView>
