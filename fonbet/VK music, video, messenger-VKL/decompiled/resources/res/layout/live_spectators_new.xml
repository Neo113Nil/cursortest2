<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Space
        android:id="@+id/live_spectators_start_space"
        android:layout_width="12dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/liveSpectatorsEndSpace"
        android:layout_width="55dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.avatar.api.VKAvatarView
        android:layout_gravity="center"
        android:id="@+id/live_spectators_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:avatarImageSize="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_spectators_name_scroll_view"
        app:layout_constraintStart_toEndOf="@+id/live_spectators_start_space"
        app:layout_constraintTop_toTopOf="@+id/live_spectators_name_scroll_view"/>
    <HorizontalScrollView
        android:id="@+id/live_spectators_name_scroll_view"
        android:scrollbars="none"
        android:fadingEdgeLength="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/live_spectators_description"
        app:layout_constraintEnd_toStartOf="@+id/live_spectators_owner_subscribe_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/live_spectators_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <androidx.appcompat.widget.AppCompatTextView
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:id="@+id/live_spectators_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:drawablePadding="4dp"
            style="@style/VkUiTypography.SubheadMedium"/>
    </HorizontalScrollView>
    <FrameLayout
        android:id="@+id/live_spectators_owner_subscribe_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toStartOf="@+id/liveSpectatorsEndSpace"
        app:layout_constraintStart_toEndOf="@+id/live_spectators_name_scroll_view"
        app:layout_constraintTop_toTopOf="@+id/live_spectators_name_scroll_view"/>
    <com.vk.core.view.links.LinkedTextView
        android:id="@+id/live_spectators_description"
        android:visibility="gone"
        android:layout_marginLeft="4dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/live_spectators_viewers_container"
        app:layout_constraintEnd_toStartOf="@+id/liveSpectatorsEndSpace"
        app:layout_constraintStart_toEndOf="@+id/live_spectators_start_space"
        app:layout_constraintTop_toBottomOf="@+id/live_spectators_name_scroll_view"
        style="@style/LiveDescription"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/live_spectators_mute_icon"
        android:padding="4dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_spectators_viewers_container"
        app:layout_constraintStart_toStartOf="@+id/live_spectators_avatar"
        app:layout_constraintTop_toTopOf="@+id/live_spectators_viewers_container"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/live_spectators_viewers_container"
        android:background="@drawable/bg_rounded_8"
        android:paddingLeft="2dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:backgroundTint="@color/vk_white_alpha15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/live_spectators_mute_icon"
        app:layout_constraintTop_toBottomOf="@+id/live_spectators_description">
        <ImageView
            android:id="@+id/live_spectators_live_badge_new"
            android:layout_width="38dp"
            android:layout_height="18dp"
            android:src="@drawable/vk_icon_live_badge_20"/>
        <ImageView
            android:id="@+id/live_spectators_viewers_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/vk_icon_view_12"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"
            app:tint="@color/vk_white"/>
        <TextView
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/live_spectators_viewers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/VkUiTypography.Caption1Medium"/>
        <ImageView
            android:id="@+id/live_spectators_balance_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/vk_icon_deprecated_ic_live_donation"
            android:scaleType="center"
            android:tint="@color/vk_white"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_spectators_live_badge_new"
            app:layout_constraintEnd_toStartOf="@+id/live_spectators_balance"
            app:layout_constraintStart_toEndOf="@+id/live_spectators_viewers"
            app:layout_constraintTop_toTopOf="@+id/live_spectators_live_badge_new"/>
        <TextView
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/live_spectators_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:text=" "
            android:maxLines="1"
            android:shadowColor="@color/vk_black_alpha35"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:breakStrategy="simple"
            app:layout_constraintBottom_toBottomOf="@+id/live_spectators_balance_icon"
            app:layout_constraintStart_toEndOf="@+id/live_spectators_balance_icon"
            app:layout_constraintTop_toTopOf="@+id/live_spectators_balance_icon"
            style="@style/VkUiTypography.Caption1Medium"/>
    </LinearLayout>
</merge>
