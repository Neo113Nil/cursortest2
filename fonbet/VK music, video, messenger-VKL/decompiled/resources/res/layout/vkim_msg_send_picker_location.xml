<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.vk.core.view.fresco.FrescoImageView
        android:id="@+id/vkim_location_ic"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        app:placeholderImage="@drawable/vk_icon_place_circle_fill_gray_48"
        app:vkim_isCircle="true"
        app:vkim_scaleType="center_crop"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/vkim_location_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        android:layout_toEndOf="@+id/vkim_location_ic"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:ellipsize="end"
        android:id="@+id/vkim_location_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.5dp"
        android:lines="1"
        android:layout_below="@+id/vkim_location_title"
        android:layout_toStartOf="@+id/vkim_location_info"
        android:layout_toEndOf="@+id/vkim_location_ic"/>
    <com.vk.core.view.TintTextView
        android:textSize="12sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/vkim_location_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:drawablePadding="2dp"
        android:layout_alignBottom="@+id/vkim_location_subtitle"
        android:layout_marginStart="10dp"
        android:layout_alignParentEnd="true"
        app:drawableRightCompat="@drawable/vk_icon_user_16"
        app:drawableRightTint="?attr/vk_legacy_text_subhead"/>
</RelativeLayout>
