<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/music_podcast_special_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="8dp"
    android:foreground="@drawable/highlight_radius_12"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp">
        <TextView
            android:textColor="@color/vk_ui_text_title_color"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/vk_ui_typography_title3_medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            style="?attr/vk_ui_typography_subhead"/>
    </LinearLayout>
    <View
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/vk_icon_chevron_24"
        android:layout_width="16dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="?attr/vk_ui_icon_secondary"/>
</FrameLayout>
