<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="@dimen/vkim_new_chat_user_padding_top_bottom"
    android:paddingBottom="@dimen/vkim_new_chat_user_padding_top_bottom"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.vk.im.ui.views.avatars.AvatarView
        android:id="@+id/vkim_avatar"
        android:layout_width="@dimen/vkim_new_chat_user_avatar"
        android:layout_height="@dimen/vkim_new_chat_user_avatar"
        android:layout_centerVertical="true"
        style="@style/VkIm.AvatarView"/>
    <ImageView
        android:id="@+id/online"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignBottom="@+id/vkim_avatar"
        android:contentDescription="@null"
        android:layout_alignEnd="@+id/vkim_avatar"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="36dp"
        android:layout_toEndOf="@+id/vkim_avatar">
        <TextView
            android:textAppearance="@style/VkUiTypography.HeadlineNormal"
            android:textColor="?attr/vk_ui_text_muted"
            android:ellipsize="marquee"
            android:id="@+id/vkim_username"
            android:duplicateParentState="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="marquee"
            android:id="@+id/vkim_user_info"
            android:duplicateParentState="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vkim_new_chat_invite_sms_info"
            android:singleLine="true"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/vkim_remove"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/vkim_new_chat_user_delete_icon"
        android:layout_height="@dimen/vkim_new_chat_user_delete_icon"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:contentDescription="@string/vkim_remove_from_list"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/vk_icon_cancel_outline_28"
        app:tint="?attr/vk_ui_icon_secondary"/>
</RelativeLayout>
