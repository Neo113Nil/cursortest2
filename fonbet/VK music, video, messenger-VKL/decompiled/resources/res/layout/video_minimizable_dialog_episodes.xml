<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/videoDialogHeaderRoot"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/videoDialogTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/grabber"
            android:background="@drawable/ds_internal_bottom_sheet_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"/>
    </FrameLayout>
    <include
        android:id="@+id/videoDialogHeaderRootV2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_minimizable_dialog_header_height"
        app:layout_constraintTop_toBottomOf="@+id/videoDialogHeaderRoot"
        layout="@layout/video_minimizable_dialog_header_v2"/>
    <include
        android:id="@+id/videoDialogHeaderRootLegacy"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_minimizable_dialog_header_height"
        app:layout_constraintTop_toBottomOf="@+id/videoDialogHeaderRootV2"
        layout="@layout/video_minimizable_dialog_header"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/videoDialogContentView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/videoDialogHeaderRootLegacy"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/videoDialogContentCompose"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/videoDialogHeaderRootLegacy"/>
</androidx.constraintlayout.widget.ConstraintLayout>
