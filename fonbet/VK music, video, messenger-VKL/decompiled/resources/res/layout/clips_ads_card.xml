<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/card_image"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:id="@+id/card_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_m"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        app:capsule="true"
        app:contentBadgeMode="primary"
        app:contentBadgeSize="large"
        app:layout_constraintBottom_toBottomOf="@+id/card_image"
        app:layout_constraintStart_toStartOf="@+id/card_image"
        app:text="-50%"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="none"
        android:id="@+id/card_price"
        android:fadingEdgeLength="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
        android:maxLines="1"
        android:singleLine="true"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/card_description"
        app:layout_constraintEnd_toStartOf="@+id/card_old_price"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_image"
        app:layout_goneMarginBottom="@dimen/vk_ui_spacing_size_m"
        app:layout_goneMarginEnd="@dimen/vk_ui_spacing_size_m"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="none"
        android:id="@+id/card_old_price"
        android:fadingEdgeLength="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_m"
        app:layout_constraintBaseline_toBaselineOf="@+id/card_price"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/card_price"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="none"
        android:id="@+id/card_description"
        android:fadingEdgeLength="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size3_xs"
        android:maxLines="1"
        android:singleLine="true"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_m"
        app:layout_constraintBottom_toTopOf="@+id/card_button"
        app:layout_constraintEnd_toEndOf="@+id/card_image"
        app:layout_constraintStart_toStartOf="@+id/card_image"
        app:layout_constraintTop_toBottomOf="@+id/card_price"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="@dimen/vk_ui_spacing_size_m"
        app:layout_goneMarginTop="@dimen/vk_ui_spacing_size_m"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/card_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/vk_ui_spacing_size_m"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_description"/>
</merge>
