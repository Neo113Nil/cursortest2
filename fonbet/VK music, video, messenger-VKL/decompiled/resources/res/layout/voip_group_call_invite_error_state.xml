<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp">
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:srcCompat="@drawable/vk_icon_phone_down_outline_56"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/vk_ui_text_muted"
        android:layout_gravity="center_horizontal"
        android:id="@+id/voip_call_invite_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="4sp"
        android:fontFamily="@string/font_family_medium"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center"
        android:id="@+id/voip_call_invite_error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4sp"
        android:fontFamily="@string/font_family_regular"/>
    <TextView
        android:gravity="center"
        android:id="@+id/voip_call_invite_error_close_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:text="@string/close"
        android:fontFamily="@string/font_family_medium"
        style="@style/VkLegacyButton.Secondary.Big"/>
</LinearLayout>
