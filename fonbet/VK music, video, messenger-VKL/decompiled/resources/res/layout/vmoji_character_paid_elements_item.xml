<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vmoji_character_paid_elements"
        android:layout_toLeftOf="@+id/show_all"
        android:layout_alignBaseline="@+id/show_all"
        android:layout_alignParentTop="true"
        android:lineSpacingExtra="1sp"
        android:textAllCaps="true"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        android:layout_alignParentStart="true"
        android:letterSpacing="0.02"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/vk_legacy_accent"
        android:id="@+id/show_all"
        android:background="@drawable/vk_highlight"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vmoji_character_show_all"
        android:layout_alignParentTop="true"
        android:lineSpacingExtra="2sp"
        android:layout_marginEnd="4dp"
        android:layout_alignParentEnd="true"
        android:letterSpacing="0.01"/>
    <com.vk.vmoji.character.utils.HorizontalPaginatedView
        android:id="@+id/paginated_view"
        android:layout_width="match_parent"
        android:layout_height="89dp"
        android:layout_below="@+id/show_all"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
