<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.FluidHorizontalLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/photo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp"
        app:vk_layout_isFluid="true">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkUiTypography.Headline1Normal"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            style="@style/VkUiTypography.Footnote"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="122dp">
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="center"
            android:id="@+id/confirm_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/photo_tags_confirm_single_tag"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="center"
            android:id="@+id/cancel_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"/>
        <View
            android:layout_gravity="end|center_vertical"
            android:id="@+id/done"
            android:background="@drawable/vk_icon_done_outline_28"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="2dp"
            android:backgroundTint="?attr/vk_ui_icon_tertiary"/>
    </FrameLayout>
</com.vk.core.tool.view.FluidHorizontalLayout>
