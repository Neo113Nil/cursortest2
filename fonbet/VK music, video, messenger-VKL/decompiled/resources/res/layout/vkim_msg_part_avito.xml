<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vkim_ripple_dark"
    android:padding="4dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/iconView"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:emptyImagePlaceholder="@drawable/ic_icon_picture_outline_48_placeholder_rounded_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:roundedCornerRadius="10dp"
        app:roundingBorderColor="?attr/vk_legacy_image_border"
        app:roundingBorderWidth="0.5dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/afterPhotoGuideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="88dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.Subhead1.Medium"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:drawablePadding="5dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/afterPhotoGuideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/sellerFullInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        app:constraint_referenced_ids="sellerName,sellerRating"
        app:flow_firstHorizontalBias="0"
        app:flow_horizontalBias="0"
        app:flow_horizontalGap="4dp"
        app:flow_horizontalStyle="packed"
        app:flow_verticalGap="4dp"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/afterPhotoGuideline"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.FootnoteAppearance"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:ellipsize="end"
        android:id="@+id/sellerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constrainedWidth="true"
        app:lineHeight="16sp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.FootnoteAppearance"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:id="@+id/sellerRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:drawablePadding="2sp"
        android:fontFamily="@string/font_family_regular"
        app:drawableStartCompat="@drawable/vk_icon_favorite_12"
        app:drawableTint="?attr/vk_legacy_text_subhead"
        app:layout_constrainedWidth="true"
        app:lineHeight="16sp"/>
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/sellerPlatformFavicon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        app:emptyImagePlaceholder="@drawable/ic_external_market_favicon_16_placeholder"
        app:layout_constraintStart_toEndOf="@+id/afterPhotoGuideline"
        app:layout_constraintTop_toBottomOf="@+id/sellerFullInfo"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.FootnoteAppearance"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:ellipsize="end"
        android:id="@+id/sellerPlatform"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:lines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"
        app:flow_verticalAlign="top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/timeAndStatus"
        app:layout_constraintStart_toEndOf="@+id/sellerPlatformFavicon"
        app:layout_constraintTop_toBottomOf="@+id/sellerFullInfo"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginStart="0dp"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextSimple"
        android:id="@+id/timeAndStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-2dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
