<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.button.tool.VkToolButton
        android:id="@+id/format_back_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/clips_editor_accessibility_close"
        android:layout_marginStart="8dp"
        app:icon="@drawable/vk_icon_arrow_left_outline_28"
        app:iconTint="@color/vk_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:toolButtonAppearance="accent"
        app:toolButtonMode="tertiary"/>
    <View
        android:id="@+id/format_overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/format_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/format_back_btn"
        app:layout_constraintVertical_bias="0.5"/>
    <com.vk.clips.design.view.seek.ClipsSeekBar
        android:id="@+id/clips_editor_seek_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/format_overlay_view"
        app:layout_constraintEnd_toEndOf="@+id/format_overlay_view"
        app:layout_constraintStart_toStartOf="@+id/format_overlay_view"
        app:layout_constraintTop_toBottomOf="@+id/format_overlay_view"
        app:lineThickness="3dp"
        app:thumbSize="12dp"
        app:unselectedColor="@color/vk_white_alpha40"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/format_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="72dp"
        android:requiresFadingEdge="horizontal"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/format_done"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="@string/clips_editor_aspect_ratio_done"
        android:contentDescription="@string/clips_editor_aspect_ratio_done"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
