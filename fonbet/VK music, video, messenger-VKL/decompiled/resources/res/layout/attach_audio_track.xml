<?xml version="1.0" encoding="utf-8"?>
<com.vk.feed.tool.view.newsfeed.attach.PrimaryAttachmentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.music.view.ThumbsImageView
            android:id="@+id/audio_attachment_album_cover"
            android:layout_width="166dp"
            android:layout_height="166dp"
            android:elevation="2dp"
            app:layout_constraintBottom_toTopOf="@+id/audio_attachment_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:roundedCornerRadius="16dp"
            app:tiv_background_image="?attr/vk_ui_background_content"
            app:tiv_empty_resource="@drawable/attach_audio_song_outline_60"
            app:tiv_empty_tint="?attr/vk_ui_icon_medium"/>
        <ImageView
            android:id="@+id/audio_attachment_playing_indicator"
            android:background="@drawable/music_dark_round_rect_16dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:translationZ="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/audio_attachment_album_cover"
            app:layout_constraintEnd_toEndOf="@+id/audio_attachment_album_cover"
            app:layout_constraintStart_toStartOf="@+id/audio_attachment_album_cover"
            app:layout_constraintTop_toTopOf="@+id/audio_attachment_album_cover"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Title2Medium"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:id="@+id/audio_attachment_title"
            android:paddingTop="0.5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="24sp"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toTopOf="@+id/audio_attachment_artist"
            app:layout_constraintEnd_toStartOf="@+id/audio_attachment_explicit"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audio_attachment_album_cover"
            app:layout_constraintWidth="wrap_content_constrained"
            app:layout_goneMarginEnd="16dp"/>
        <View
            android:id="@+id/audio_attachment_explicit"
            android:background="@drawable/vk_icon_error_circle_fill_gray_12"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/music_talkback_explicit"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="?attr/vk_ui_icon_contrast"
            app:layout_constraintBottom_toBottomOf="@+id/audio_attachment_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/audio_attachment_title"
            app:layout_constraintTop_toTopOf="@+id/audio_attachment_title"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:id="@+id/audio_attachment_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="20sp"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/audio_attachment_play_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audio_attachment_title"/>
        <View
            android:id="@+id/shadow_view"
            android:background="@drawable/primary_attachment_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="-21.5dp"
            android:layout_marginBottom="-25.5dp"
            android:layout_marginStart="-24dp"
            android:layout_marginEnd="-24dp"
            app:layout_constraintBottom_toBottomOf="@+id/audio_attachment_play_btn"
            app:layout_constraintEnd_toEndOf="@+id/audio_attachment_play_btn"
            app:layout_constraintStart_toStartOf="@+id/audio_attachment_play_btn"
            app:layout_constraintTop_toTopOf="@+id/audio_attachment_play_btn"/>
        <View
            android:id="@+id/shadow_add_view"
            android:background="@drawable/primary_attachment_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="-21.5dp"
            android:layout_marginBottom="-25.5dp"
            android:layout_marginStart="-24dp"
            android:layout_marginEnd="-24dp"
            app:layout_constraintBottom_toBottomOf="@+id/audio_attachment_add_btn"
            app:layout_constraintEnd_toEndOf="@+id/audio_attachment_add_btn"
            app:layout_constraintStart_toStartOf="@+id/audio_attachment_add_btn"
            app:layout_constraintTop_toTopOf="@+id/audio_attachment_add_btn"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="@color/vk_black"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/audio_attachment_play_btn"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/audio_attachment_play"
            android:drawablePadding="6dp"
            android:paddingStart="13dp"
            android:paddingEnd="16dp"
            app:drawableStartCompat="@drawable/vk_icon_play_24"
            app:drawableTint="@color/vk_black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/audio_attachment_add_btn"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audio_attachment_artist"/>
        <ImageView
            android:id="@+id/audio_attachment_add_btn"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/audio_attachment_play_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/audio_attachment_play_btn"
            app:layout_constraintTop_toTopOf="@+id/audio_attachment_play_btn"
            app:srcCompat="@drawable/vk_icon_add_24"
            app:tint="@color/vk_black"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.feed.tool.view.newsfeed.attach.PrimaryAttachmentLayout>
