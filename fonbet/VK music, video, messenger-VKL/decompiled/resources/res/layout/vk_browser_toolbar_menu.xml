<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/main_container"
    android:background="@color/vk_black"
    android:layout_width="match_parent"
    android:layout_height="32dp">
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="start|center_vertical"
        android:id="@+id/vk_menu_close"
        android:padding="8dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:cropToPadding="true"
        android:contentDescription="@string/vk_accessibility_close"
        app:srcCompat="@drawable/vk_icon_cancel_16"
        app:tint="@android:color/white"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/game_name_textview"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:lines="1"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        style="@style/VkUiTypography.Caption1"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="end|center_vertical"
        android:id="@+id/vk_menu_more"
        android:padding="8dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/vk_accessibility_actions"
        app:srcCompat="@drawable/vk_icon_more_horizontal_16"
        app:tint="@color/vk_white"/>
</LinearLayout>
