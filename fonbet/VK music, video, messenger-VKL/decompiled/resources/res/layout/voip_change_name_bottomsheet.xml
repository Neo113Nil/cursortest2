<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/voip_change_name_toolbar"/>
    <ViewFlipper
        android:id="@+id/voip_change_name_view_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/voip_change_name_progress_bar"
            android:visibility="visible"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminateTint="?attr/vk_ui_icon_tertiary"
            android:indeterminateTintMode="src_in"/>
        <include layout="@layout/voip_change_name_error_state"/>
        <include layout="@layout/voip_change_name_content_visible_state"/>
    </ViewFlipper>
</LinearLayout>
