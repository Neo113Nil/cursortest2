<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/video_minimizable_dialog_header_height">
    <ImageButton
        android:id="@+id/videoDialogNavigationIcon"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@drawable/vk_icon_arrow_left_outline_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_text_primary"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle2SemiBold"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/videoDialogTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/videoDialogNavigationIcon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/vk_gray_750"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
