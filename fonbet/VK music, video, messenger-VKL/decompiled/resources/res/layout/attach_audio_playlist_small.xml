<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/video_single_info"
        android:background="@drawable/attach_fb_overlay_6dp_corner"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:maxWidth="480dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <com.vk.music.view.ThumbsImageView
            android:id="@+id/snippet_image"
            android:paddingTop="0.5dp"
            android:paddingBottom="0.5dp"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:paddingStart="0.5dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="6dp"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_empty_resource="@drawable/vk_icon_playlist_outline_56"
            app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
        <View
            android:id="@+id/v_line"
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toEndOf="@+id/snippet_image"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2SemiBold"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/attach_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/playlist_explicit"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/v_line"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/playlist_explicit"
            android:background="@drawable/vk_icon_error_circle_fill_gray_12"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="?attr/vk_ui_icon_tertiary"
            app:layout_constraintBottom_toBottomOf="@+id/attach_title"
            app:layout_constraintEnd_toStartOf="@+id/attach_audio_playlist_remove_button"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/attach_title"
            app:layout_constraintTop_toTopOf="@+id/attach_title"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/attach_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:layout_marginEnd="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/attach_title"
            app:layout_constraintTop_toBottomOf="@+id/attach_title"
            app:layout_constraintWidth_default="wrap"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/attach_subsubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:layout_marginEnd="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/attach_title"
            app:layout_constraintTop_toBottomOf="@+id/attach_subtitle"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/attach_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="11dp"
            app:buttonAppearance="neutral"
            app:buttonMode="secondary"
            app:buttonSizeType="small"
            app:icon="@drawable/vk_icon_play_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/attach_title"/>
        <com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:overlayDrawable="@drawable/highlight_post"
            app:padOverlay="true"/>
        <ImageView
            android:id="@+id/attach_audio_playlist_remove_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_deprecated_ic_close_attach_36"
            android:contentDescription="@string/delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/playlist_explicit"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
