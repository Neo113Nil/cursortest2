<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="0dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">
    <com.vk.common.view.overlay.OverlayConstraintLayout
        android:background="?attr/vk_ui_background_content"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.tool.view.AspectRatioFrameLayout
            android:id="@+id/photo_tag_preview_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:as_aspect_ratio="1.285"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/photo_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"/>
            <com.vk.imageloader.view.VKImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/photo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/talkback_photo_preview"
                app:actualImageScaleType="fitCenter"
                app:viewAspectRatio="1.285"/>
            <com.vk.photos.common.ui.tags.TagsSuggestionsOverlayView
                android:layout_gravity="center"
                android:id="@+id/photo_tag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/restriction_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:id="@+id/restriction_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    app:tint="?attr/vk_ui_icon_contrast"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textAppearance="@style/Headline1TextAppearance"
                    android:textColor="?attr/vk_ui_text_contrast"
                    android:id="@+id/restriction_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:textAlignment="center"
                    style="@style/Headline1Style"/>
                <com.vk.core.view.components.button.VkSimpleButton
                    android:ellipsize="end"
                    android:id="@+id/skip_restriction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="36dp"
                    android:singleLine="true"
                    android:translationY="-1.21sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="12dp"
                    app:buttonAppearance="accent"
                    app:buttonMode="secondary"
                    app:buttonSizeType="medium"
                    app:lineHeight="20sp"/>
            </LinearLayout>
        </com.vk.core.tool.view.AspectRatioFrameLayout>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/album"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="9dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/info"
            app:layout_constraintDimensionRatio="360:280"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/photo_tag_preview_layout"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/album"
            app:layout_constraintTop_toBottomOf="@+id/photo_tag_preview_layout">
            <com.google.android.material.textview.MaterialTextView
                android:textAppearance="@style/Headline1TextAppearance"
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="20dp"
                app:lineHeight="20sp"
                style="@style/Headline1Style"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:id="@+id/source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="16dp"
                app:lineHeight="16sp"
                style="@style/VkUiTypography.Footnote"/>
        </LinearLayout>
        <com.vk.core.view.components.button.VkSimpleButton
            android:ellipsize="end"
            android:id="@+id/decline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:minHeight="36dp"
            android:singleLine="true"
            android:lineSpacingExtra="2sp"
            android:translationY="-1.21sp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"
            app:layout_constraintEnd_toStartOf="@+id/accept"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/info"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:ellipsize="end"
            android:id="@+id/accept"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:singleLine="true"
            android:translationY="-1.21sp"
            android:layout_marginEnd="16sp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/decline"
            app:layout_constraintTop_toTopOf="@+id/decline"/>
    </com.vk.common.view.overlay.OverlayConstraintLayout>
</androidx.cardview.widget.CardView>
