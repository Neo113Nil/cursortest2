<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/image_view"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_legacy_image_border"
        app:roundingBorderWidth="0.5dp"/>
    <View
        android:id="@+id/icon_view"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="2dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/vk_legacy_text_muted"
        android:ellipsize="end"
        android:id="@+id/title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:minHeight="20dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_roboto_medium"/>
    <View
        android:id="@+id/verified"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="1dp"
        android:layout_marginStart="4dp"
        android:backgroundTint="@color/vk_blue_200"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:minHeight="16dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_roboto_regular"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:ellipsize="end"
        android:id="@+id/text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="16dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_roboto_regular"/>
    <com.vk.core.view.PhotoStackView
        android:id="@+id/photo_image_view"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="6dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_button_outline_foreground"
        android:ellipsize="end"
        android:id="@+id/button"
        android:background="?attr/im_msg_part_button_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="30dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_roboto_medium"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextSimple"
        android:id="@+id/timeAndStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="14dp"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"/>
</merge>
