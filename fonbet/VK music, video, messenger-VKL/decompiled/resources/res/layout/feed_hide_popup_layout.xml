<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp">
        <View
            android:layout_gravity="start|center_vertical"
            android:id="@+id/popup_dismiss_button"
            android:background="@drawable/vk_icon_cancel_outline_28"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="14dp"
            android:backgroundTint="?attr/vk_ui_background_accent"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/popup_text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/newsfeed_modal_item_ignored_title"
            android:maxLines="1"
            android:layout_marginStart="64dp"
            style="@style/VkUiTypography.DisplayTitle1"/>
    </FrameLayout>
    <View
        android:id="@+id/popup_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/popup_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3.5dp"
        android:minHeight="240dp"/>
</LinearLayout>
