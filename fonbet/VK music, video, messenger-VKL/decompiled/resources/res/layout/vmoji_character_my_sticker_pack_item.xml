<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_my_sticker_pack"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="9dp"
    android:layout_marginBottom="7dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_toLeftOf="@+id/more"
            android:layout_alignParentTop="true"
            android:lineSpacingExtra="1sp"
            android:fontFamily="@font/vk_roboto_medium"
            android:layout_alignParentStart="true"
            android:letterSpacing="0.01"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:ellipsize="end"
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/more"
            android:layout_below="@+id/title"
            android:lineSpacingExtra="1sp"
            android:fontFamily="@font/vk_sans_text_regular"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/more"
            android:background="@drawable/vk_highlight_circle"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_more_horizontal_24"
            android:layout_alignParentTop="true"
            android:layout_alignWithParentIfMissing="true"
            android:contentDescription="@string/vmoji_character_accessibility_more"
            android:layout_alignParentEnd="true"
            app:tint="?attr/vk_legacy_icon_outline_secondary"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/first_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/second_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <TextView
        android:id="@+id/show"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:maxHeight="32dp"
        android:minHeight="32dp"
        android:text="@string/vmoji_character_my_pack_show"
        style="@style/VkLegacyButton.Secondary"/>
</LinearLayout>
