<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tabs.SkeletonTabLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabs"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/feed_tabs_height"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    app:layout_scrollFlags="snap|enterAlways|scroll"
    app:tabGravity="fill"
    app:tabIndicator="@drawable/feed_tab_sliding_selector_v2"
    app:tabIndicatorColor="?attr/vk_ui_text_accent"
    app:tabIndicatorFullWidth="true"
    app:tabIndicatorHeight="2dp"
    app:tabMode="fixed"
    app:tabRippleColor="?attr/vk_ui_transparent_active"
    app:tabSelectedTextColor="?attr/vk_ui_text_primary"
    app:tabTextColor="?attr/vk_ui_text_secondary"/>
