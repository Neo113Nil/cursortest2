<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.music.view.ThumbsImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/audio_image"
        android:layout_width="@dimen/music_track_image"
        android:layout_height="@dimen/music_track_image"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/foreign_agent_notice_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/music_image_rounding_corners"
        app:tiv_background_image="?attr/vk_ui_image_placeholder"
        app:tiv_border_width="0.5dp"
        app:tiv_empty_resource="@drawable/vk_icon_song_outline_28"
        app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
    <ImageView
        android:id="@+id/audio_playing_indicator"
        android:background="@drawable/music_dark_round_rect"
        android:visibility="gone"
        android:layout_width="@dimen/music_track_image"
        android:layout_height="@dimen/music_track_image"
        app:layout_constraintBottom_toBottomOf="@+id/audio_image"
        app:layout_constraintEnd_toEndOf="@+id/audio_image"
        app:layout_constraintStart_toStartOf="@+id/audio_image"
        app:layout_constraintTop_toTopOf="@+id/audio_image"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.HeadlineNormal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/audio_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:maxLines="1"
        android:drawablePadding="3dp"
        android:layout_marginStart="9dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/adult_content_tv"
        app:layout_constraintEnd_toStartOf="@+id/iv_explicit"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/audio_image"
        app:layout_constraintTop_toTopOf="@+id/audio_image"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/iv_explicit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_error_circle_fill_gray_12"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_title"
        app:layout_constraintEnd_toStartOf="@+id/gone_margin_target"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/audio_title"
        app:layout_constraintTop_toTopOf="@+id/audio_title"/>
    <Space
        android:id="@+id/gone_margin_target"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_title"
        app:layout_constraintEnd_toStartOf="@+id/audion_actions"
        app:layout_constraintStart_toEndOf="@+id/iv_explicit"
        app:layout_constraintTop_toTopOf="@+id/audio_title"
        app:layout_goneMarginEnd="16dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/adult_content_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="@dimen/android_4_fix"
        android:text="@string/music_track_age_restriction"
        android:drawablePadding="4dp"
        android:layout_marginStart="3dp"
        app:drawableStartCompat="@drawable/vk_icon_error_circle_fill_gray_12"
        app:layout_constraintBottom_toTopOf="@+id/audio_artist"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/audio_title"
        app:layout_constraintTop_toBottomOf="@+id/audio_title"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/audio_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="16dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/audio_image"
        app:layout_constraintEnd_toStartOf="@+id/audion_actions"
        app:layout_constraintStart_toStartOf="@+id/audio_title"
        app:layout_constraintTop_toBottomOf="@+id/adult_content_tv"
        app:layout_goneMarginEnd="16dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/foreign_agent_notice_tv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="24dp"
        android:text="@string/music_track_foreign_agent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/audio_image"
        app:layout_constraintTop_toBottomOf="@+id/audio_artist"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <FrameLayout
        android:id="@+id/audion_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/music_talkback_go_to_album"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/audio_chevron"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:scaleType="center"
            android:rotationY="@integer/angle_rtl_180"
            android:layout_marginEnd="5dp"
            app:srcCompat="@drawable/vk_icon_chevron_24"
            app:tint="?attr/vk_ui_text_secondary"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
