<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pds_overlay_circle_button_root"
    android:padding="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.vkblur.VkBlurView
        android:id="@+id/pds_overlay_circle_button_blur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/pds_overlay_circle_button_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/pds_overlay_circle_button_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="center"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:ellipsize="none"
            android:id="@+id/pds_overlay_circle_button_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingEnd="8dp"
            style="@style/VkUiTypography.Caption1Medium"/>
    </LinearLayout>
    <com.vk.core.view.components.spinner.VkSpinner
        android:id="@+id/pds_overlay_circle_button_progress"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="@color/vk_white"
        android:indeterminateTintMode="src_in"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:spinnerSize="small"/>
</androidx.constraintlayout.widget.ConstraintLayout>
