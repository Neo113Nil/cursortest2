<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/btn_change_author"
        android:background="@drawable/shape_banner_button"
        android:padding="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="?attr/vk_ui_background_secondary"
        app:layout_constraintEnd_toStartOf="@+id/btn_setting_youtube"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/bg_icon_user"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/vk_icon_users_outline_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/title_btn_authors"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/chevron_icon"
            app:layout_constraintStart_toEndOf="@+id/bg_icon_user"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Paragraph"/>
        <ImageView
            android:id="@+id/chevron_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_chevron_compact_right_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_ui_icon_tertiary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/btn_setting_youtube"
        android:background="@drawable/shape_banner_button"
        android:padding="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:backgroundTint="?attr/vk_ui_background_negative_tint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_change_author"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/bg_icon_play"
            android:background="@drawable/circle_gray_background"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:backgroundTint="@color/vk_red_nice"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/vk_icon_play_16"
            app:layout_constraintBottom_toBottomOf="@+id/bg_icon_play"
            app:layout_constraintEnd_toEndOf="@+id/bg_icon_play"
            app:layout_constraintStart_toStartOf="@+id/bg_icon_play"
            app:layout_constraintTop_toTopOf="@+id/bg_icon_play"
            app:tint="@color/vk_white"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/title_btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:lines="2"
            app:layout_constraintStart_toStartOf="@+id/bg_icon_play"
            app:layout_constraintTop_toBottomOf="@+id/bg_icon_play"
            style="@style/VkUiTypography.SubheadMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
