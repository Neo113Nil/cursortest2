<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/clips_feed_music_badge_container"
    android:layout_width="wrap_content"
    android:layout_height="22dp"
    android:foreground="@drawable/highlight_radius_8">
    <ViewStub
        android:id="@+id/trend_badge_image"
        android:layout="@layout/trend_badge_image_layout"
        android:inflatedId="@+id/trend_badge_image"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="2dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/trend_badge_title"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="40dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        android:marqueeRepeatLimit="0"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/trend_badge_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/vk_icon_flash_12"
        android:tint="?attr/vk_ui_icon_contrast"
        android:layout_marginEnd="4dp"/>
</LinearLayout>
