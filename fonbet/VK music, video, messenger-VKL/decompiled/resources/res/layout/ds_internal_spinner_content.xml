<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.spinner.VkSpinner
        android:layout_gravity="center"
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/cancel_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_cancel_24"
        android:contentDescription="@string/ds_internal_spinner_cancel"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/done_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ds_internal_spinner_done_state_56"
        android:contentDescription="@string/ds_internal_spinner_done"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/error_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ds_internal_spinner_error_state_56"
        android:contentDescription="@string/ds_internal_spinner_error"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/custom_content_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</merge>
