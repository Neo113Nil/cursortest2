<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="200dp">
        <com.vk.core.view.ColorProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:color="?attr/vk_ui_text_accent"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/error"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VkIm.Error.LargeText"/>
            <Button
                android:id="@+id/error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/vkim_retry"
                style="@style/VkIm.Error.LargeButton"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/ivClose"
                android:background="@drawable/vk_highlight_unlimited"
                android:padding="10dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:contentDescription="@string/close"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toTopOf="@+id/toolbar_divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/vk_icon_cancel_outline_28"
                app:tint="?attr/vk_ui_icon_accent_themed"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_broacast_start_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/vk_sans_display_demibold"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivClose"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.448"
                app:layout_constraintStart_toEndOf="@+id/ivClose"
                app:layout_constraintTop_toTopOf="@+id/ivClose"
                style="@style/VkLegacyTypography.Title1"/>
            <View
                android:id="@+id/toolbar_divider"
                android:background="?attr/vk_ui_separator_primary_alpha"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/owners_title"
                app:layout_constraintTop_toBottomOf="@+id/ivClose"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="start|center_vertical"
                android:id="@+id/owners_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="40dp"
                android:text="@string/voip_broadcast_author"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/owners_list"
                app:layout_constraintTop_toBottomOf="@+id/toolbar_divider"
                style="@style/VkLegacyTypography.Headline.Medium"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/owners_list"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layout_constraintBottom_toTopOf="@+id/owners_divider_bottom"
                app:layout_constraintTop_toBottomOf="@+id/owners_title"/>
            <View
                android:id="@+id/owners_divider_bottom"
                android:background="?attr/vk_ui_separator_primary_alpha"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/broadcast"
                app:layout_constraintTop_toBottomOf="@+id/owners_list"/>
            <com.vk.voip.ui.view.VoipActionMultiLineView
                android:id="@+id/broadcast"
                android:layout_marginTop="5.5dp"
                android:minHeight="56dp"
                app:layout_constraintBottom_toTopOf="@+id/broadcast_divider_bottom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/owners_divider_bottom"
                app:voip_amlv_icon="@drawable/vk_icon_deprecated_ic_clock_outline_28"
                app:voip_amlv_openIconVisible="true"
                app:voip_amlv_subtitle="@string/voip_broadcast_target_description_new"
                app:voip_amlv_title="@string/voip_broadcast_target_title"
                style="@style/VoipActionMultiLineView"/>
            <View
                android:id="@+id/broadcast_divider_bottom"
                android:background="?attr/vk_ui_separator_primary_alpha"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="6dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/title_label"
                app:layout_constraintTop_toBottomOf="@+id/broadcast"/>
            <TextView
                android:id="@+id/title_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17.5dp"
                android:text="@string/voip_broadcast_title"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/title_input"
                app:layout_constraintTop_toBottomOf="@+id/broadcast_divider_bottom"
                style="@style/VkLegacyTypography.Subhead.Regular"/>
            <EditText
                android:id="@+id/title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/voip_broadcast_title_hint"
                android:lines="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:importantForAutofill="no"
                app:layout_constraintBottom_toTopOf="@+id/privacy_selector"
                app:layout_constraintTop_toBottomOf="@+id/title_label"
                style="@style/VoipEditText"/>
            <com.vk.voip.ui.view.VoipActionMultiLineView
                android:id="@+id/privacy_selector"
                android:layout_marginTop="8dp"
                android:minHeight="56dp"
                app:layout_constraintBottom_toTopOf="@+id/privacy_description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title_input"
                app:voip_amlv_icon="@null"
                app:voip_amlv_ignore_content_description="true"
                app:voip_amlv_openIconVisible="true"
                app:voip_amlv_title="@string/voip_broadcast_privacy_label"
                style="@style/VoipActionMultiLineView"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="start"
                android:id="@+id/privacy_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@string/font_family_regular"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:letterSpacing="0.02"
                app:layout_constraintBottom_toTopOf="@+id/start"
                app:layout_constraintTop_toBottomOf="@+id/privacy_selector"
                app:layout_goneMarginTop="8dp"/>
            <Button
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:minHeight="44dp"
                android:text="@string/voip_broadcast_start"
                android:textAllCaps="false"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/start_hint"
                app:layout_constraintTop_toBottomOf="@+id/privacy_description"
                style="@style/VkLegacyButton.Primary"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/vk_ui_text_subhead"
                android:gravity="center"
                android:id="@+id/start_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/voip_broadcast_start_hint"
                android:fontFamily="@string/font_family_regular"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:letterSpacing="0.03"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/start"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/record_title_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="title_label,title_input"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
