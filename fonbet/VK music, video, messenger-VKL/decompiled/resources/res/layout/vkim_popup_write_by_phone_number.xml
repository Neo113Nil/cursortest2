<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_bg_modal_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/cancel_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_cancel_20"
        android:contentDescription="@string/vkim_cancel"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/vkim_contacts_write_by_phone_number_popup_title"
            android:textAlignment="center"
            android:layout_marginHorizontal="44dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkLegacyTypography.Title1"/>
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vkim_contacts_write_by_phone_number_popup_description"
            android:lines="@null"
            android:textAlignment="center"
            android:labelFor="@+id/phone_edit_text"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/VkLegacyTypography.Subhead.Regular"/>
        <EditText
            android:id="@+id/phone_edit_text"
            android:background="@drawable/vkui_bg_edittext_stated"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:text="@string/vkim_contacts_phone_number_plus_seven"
            android:lines="1"
            android:drawablePadding="10dp"
            android:inputType="phone"
            android:drawableStart="@drawable/ic_phone_outline_24"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:drawableTint="?attr/vk_legacy_icon_secondary"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            style="@style/VKUIEditText"/>
        <com.vk.im.ui.views.buttons.VkButtonWithSmallScreenSupport
            android:enabled="false"
            android:id="@+id/write_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:text="@string/vkim_contacts_write_by_phone_number_popup_write_btn"
            android:drawablePadding="8dp"
            android:drawableTint="?attr/vk_ui_icon_contrast_themed"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/phone_edit_text"
            app:vk_drawableStart="@drawable/vk_icon_message_outline_24"
            style="@style/VkLegacyButton.Primary.Big"/>
        <com.vk.im.ui.views.buttons.VkButtonWithSmallScreenSupport
            android:id="@+id/create_contact_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="@string/vkim_contacts_write_by_phone_number_popup_create_contact_btn"
            android:drawablePadding="8dp"
            android:drawableTint="?attr/vk_ui_icon_accent_themed"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/write_button"
            app:vk_drawableStart="@drawable/vk_icon_add_24"
            style="@style/VkLegacyButton.Secondary.Big"/>
    </LinearLayout>
</FrameLayout>
