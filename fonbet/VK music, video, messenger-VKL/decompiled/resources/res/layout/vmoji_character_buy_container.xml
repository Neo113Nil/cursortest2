<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/buy_container"
    android:background="?attr/vk_ui_background_content"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="4dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <FrameLayout
        android:id="@+id/buy_item_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="16dp">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="12dp"
            app:roundingBorderColor="@color/vk_black_alpha8"
            app:roundingBorderWidth="0.33dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption2"
            android:textStyle="bold"
            android:textColor="@color/vk_white"
            android:id="@+id/badge"
            android:background="@drawable/shape_vmoji_sticker_pack_badge"
            android:paddingBottom="0.5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.5dp"
            android:translationX="-4dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:src="@drawable/vk_icon_crown_16"
            android:contentDescription="@null"
            app:tint="?attr/vk_ui_accent_purple"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/buy_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/buy_item_icon"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/buy_item_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/vmoji_character_buy_container_hint"
        android:layout_toRightOf="@+id/buy_item_icon"
        android:layout_below="@+id/buy_item_title"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttons_container"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="19dp"
        android:layout_below="@+id/buy_item_icon"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="center"
            android:id="@+id/buy_item_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_weight="1"
            app:buttonAppearance="positive"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/try_on_item_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="large"
            app:icon="@drawable/vk_icon_hanger_outline_24"/>
    </LinearLayout>
</RelativeLayout>
