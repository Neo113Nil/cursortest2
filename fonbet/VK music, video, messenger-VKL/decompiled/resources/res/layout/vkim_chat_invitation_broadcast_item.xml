<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/vkim_ripple_dark"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:paddingStart="10dp"
    android:paddingEnd="8dp">
    <com.vk.im.ui.views.avatars.AvatarView
        android:id="@+id/avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkIm.AvatarView"/>
    <ImageView
        android:id="@+id/online"
        android:layout_width="12dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_online_web_composite_16"
        android:contentDescription="@null"
        android:translationX="-3dp"
        android:translationY="-3dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="@+id/avatar"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/selected"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:layout_gravity="start"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="?attr/im_contact_name_font_family"
            app:vk_layout_isFluid="true"/>
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/status"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="1dp"
            android:layout_marginStart="2dp"
            app:actualImageScaleType="centerInside"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:singleLine="true"
        android:fontFamily="@string/font_family_regular"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/selected"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/avatar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/selected"
        android:background="@drawable/vkim_ripple_dark_borderless"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        android:contentDescription="@string/select"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_check_circle_off_24"
        app:tint="?attr/vk_legacy_icon_outline_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
