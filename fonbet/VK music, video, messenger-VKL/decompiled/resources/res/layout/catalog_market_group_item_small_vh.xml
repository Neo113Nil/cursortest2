<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_catalog_card_elevation_8"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground">
        <com.vk.imageloader.view.VKCircleImageView
            android:id="@+id/group_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.TextViewEllipsizeEnd
            android:ellipsize="end"
            android:id="@+id/group_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="@string/font_family_medium"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/group_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/group_icon"
            app:layout_constraintTop_toTopOf="@+id/group_icon"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/VkLegacyTypography.Text"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/group_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/group_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/group_icon"
            app:layout_constraintTop_toBottomOf="@+id/group_title"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/VkLegacyTypography.Subhead2"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/good_image_1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/group_icon"
            app:placeholderImage="@drawable/ic_market_outline_96_placeholder"
            app:roundedCornerRadius="4dp"
            app:roundingBorderColor="?attr/vk_legacy_image_border"
            app:roundingBorderWidth="0.5dp"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/good_image_2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/good_image_1"
            app:layout_constraintTop_toTopOf="@+id/good_image_1"
            app:placeholderImage="@drawable/ic_market_outline_96_placeholder"
            app:roundedCornerRadius="4dp"
            app:roundingBorderColor="?attr/vk_legacy_image_border"
            app:roundingBorderWidth="0.5dp"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/good_image_3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/good_image_2"
            app:layout_constraintTop_toTopOf="@+id/good_image_2"
            app:placeholderImage="@drawable/ic_market_outline_96_placeholder"
            app:roundedCornerRadius="4dp"
            app:roundingBorderColor="?attr/vk_legacy_image_border"
            app:roundingBorderWidth="0.5dp"/>
        <TextView
            android:textColor="@color/vk_white"
            android:id="@+id/good_image_3_overlay_text"
            android:paddingTop="4sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@string/font_family_medium"
            app:layout_constraintBottom_toBottomOf="@+id/good_image_3"
            app:layout_constraintEnd_toEndOf="@+id/good_image_3"
            app:layout_constraintStart_toStartOf="@+id/good_image_3"
            app:layout_constraintTop_toTopOf="@+id/good_image_3"
            style="@style/VkLegacyTypography.Headline"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
