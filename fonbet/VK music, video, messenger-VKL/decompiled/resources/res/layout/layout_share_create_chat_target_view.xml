<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/rounded_list_selector"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:background="@drawable/bg_empty_placeholder"
        android:layout_width="@dimen/layout_share_target_avatar_size"
        android:layout_height="@dimen/layout_share_target_avatar_size"
        android:layout_marginLeft="16dp"
        android:scaleType="center"
        android:contentDescription="@null"
        app:srcCompat="@drawable/vk_icon_add_outline_24"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="0dp"
        android:text="@string/vkim_create_chat"
        android:maxLines="1"
        android:layout_weight="2"/>
</LinearLayout>
