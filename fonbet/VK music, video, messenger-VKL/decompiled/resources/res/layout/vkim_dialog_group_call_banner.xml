<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="6dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/vkim_accessibility_group_call_banner"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">
    <FrameLayout
        android:id="@+id/in_call_state_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.im.ui.views.avatars.StackAvatarView
            android:id="@+id/stack_avatar_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vkim_iconOffset="-6dp"
            app:vkim_iconSize="32dp"
            app:vkim_strokeColor="?attr/vk_legacy_header_background"
            app:vkim_strokeWidth="2dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/stack_avatar_placeholder"
            android:layout_width="20dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:contentDescription="@null"
            android:layout_marginEnd="4dp"
            app:srcCompat="@drawable/vk_icon_phone_outline_20"
            app:tint="?attr/vk_legacy_icon_secondary"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/title_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vkim_msg_list_group_call_title"
        android:lines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/join_btn"
        app:layout_constraintEnd_toStartOf="@+id/close_btn"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/in_call_state_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_legacy_accent"
        android:ellipsize="end"
        android:id="@+id/join_btn"
        android:background="@drawable/vk_auth_bg_passport_action"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vkim_join_by_link_btn"
        android:lines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/close_btn"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/in_call_state_container"
        app:layout_constraintTop_toBottomOf="@+id/title_view"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close_btn"
        android:background="@drawable/vkim_ripple_dark_borderless"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/vkim_accessibility_hide_group_call_banner_msg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_24"
        app:tint="?attr/vk_legacy_icon_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
