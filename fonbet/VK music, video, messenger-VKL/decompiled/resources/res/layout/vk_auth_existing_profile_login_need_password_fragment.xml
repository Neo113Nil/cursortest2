<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/existing_profile_need_password_container"
    android:background="?attr/vk_ui_background_content"
    android:paddingBottom="@dimen/vk_auth_keyboard_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle2SemiBold"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_existing_profile_with_pass_title"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vk_auth_existing_profile_with_pass_subtitle"
        style="@style/VkUiTypography.Headline1Normal"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        layout="@layout/vk_auth_existing_profile_user_info_block"/>
    <com.vk.auth.ui.VkAuthPasswordView
        android:id="@+id/password_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        app:vk_edit_text_background="@drawable/vk_ui_auth_bg_edittext_stated"
        app:vk_edit_text_hint="@string/vk_auth_sign_up_enter_password_hint"
        app:vk_edit_text_layout="@layout/vk_auth_landing_password_edittext"
        app:vk_toggle_button_content_description="@string/vk_auth_show_pass"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteNormal"
        android:textColor="?attr/vk_ui_text_negative"
        android:id="@+id/auth_existing_profile_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <com.vk.auth.ui.VkAuthClickableTextView
        android:textColor="?attr/vk_ui_text_link"
        android:id="@+id/existing_fragment_forget_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_forgot_pass"
        style="@style/VkUiTypography.SubheadMedium"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.vk.auth.ui.VkLoadingButton
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:id="@+id/continue_btn"
        android:background="@drawable/vk_ui_auth_bg_landing_primary_btn"
        android:layout_width="match_parent"
        android:layout_marginTop="16dp"
        android:text="@string/vk_login_confirmation_continue"
        app:vk_lb_text_appearance="@style/VkUiTypography.Headline1Medium"
        style="@style/VKID.View.Button"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/not_my_account"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_existing_profile_not_my_account"
        android:paddingHorizontal="@dimen/vk_ui_button_padding_horizontal"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="large"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/help_button"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_auth_help_button"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
</LinearLayout>
