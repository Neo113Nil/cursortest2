<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.RestrictionFrescoImageViewLegacy
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/vkim_accessibility_photo"
        app:vkim_scaleType="center_crop"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"/>
    <com.vk.core.view.ProgressView
        android:layout_gravity="center"
        android:id="@+id/upload"
        style="@style/VkIm.MsgPart.UploadIndicator.Default"/>
</FrameLayout>
