<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/background_ll"
        android:background="@drawable/bg_community_normal_cover_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/community_header_background_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:layout_gravity="end"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginStart="122dp"
            android:layout_marginEnd="16dp"
            layout="@layout/layout_community_normal_header_reviews"/>
        <com.vk.profile.design.view.ProfileTitleText
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="marquee"
            android:id="@+id/community_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            android:layout_marginHorizontal="16dp"
            style="@style/VkUiTypography.DisplayTitle2"/>
    </LinearLayout>
    <include
        android:layout_width="106dp"
        android:layout_height="106dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_community_header_avatar"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:id="@+id/community_header_age_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="6dp"
        app:contentBadgeAppearance="overlay"
        app:contentBadgeMode="secondary"
        app:contentBadgeSize="small"
        app:layout_constraintBottom_toTopOf="@+id/background_ll"
        app:layout_constraintEnd_toStartOf="@+id/community_header_a_plus"
        app:layout_goneMarginEnd="12dp"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:id="@+id/community_header_a_plus"
        android:focusable="true"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/profile_aplus_details_title"
        android:layout_marginEnd="12dp"
        app:contentBadgeAppearance="overlay"
        app:contentBadgeMode="secondary"
        app:contentBadgeSize="small"
        app:layout_constraintBottom_toTopOf="@+id/background_ll"
        app:layout_constraintEnd_toEndOf="parent"
        app:text="@string/profile_a_plus_mark"/>
</androidx.constraintlayout.widget.ConstraintLayout>
