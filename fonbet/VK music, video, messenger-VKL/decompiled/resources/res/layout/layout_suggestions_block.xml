<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/inserts_container"
    android:background="?attr/vk_ui_background_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/mention_select_shadow"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clip_bottomsheet_separator_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/icon_insert_hashtag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_hashtag_outline_20"
        android:paddingStart="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_medium"/>
    <com.vk.core.tool.view.onboarding.highlighter.VkOnboardingHighlighter
        android:layout_gravity="center_vertical"
        android:id="@+id/highlight_insert_hashtag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"
        android:paddingHorizontal="8dp"
        app:autoHighlight="false"
        app:highlighterColor="lime"
        app:highlighterType="type3"
        app:layout_constraintStart_toEndOf="@+id/icon_insert_hashtag"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_subhead"
            android:id="@+id/insert_hashtag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clips_edit_description_insert_hashtag"
            style="@style/VkUiTypography.SubheadMedium"/>
    </com.vk.core.tool.view.onboarding.highlighter.VkOnboardingHighlighter>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/icon_insert_mention"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_mention_outline_20"
        android:paddingStart="8dp"
        android:paddingVertical="12dp"
        app:layout_constraintStart_toEndOf="@+id/highlight_insert_hashtag"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_subhead"
        android:layout_gravity="center_vertical"
        android:id="@+id/insert_mention"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clips_edit_description_insert_mention"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        app:layout_constraintStart_toEndOf="@+id/icon_insert_mention"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.SubheadMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
