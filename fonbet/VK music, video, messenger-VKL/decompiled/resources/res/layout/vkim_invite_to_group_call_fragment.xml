<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/im_appbar"
        style="@style/Vk.Theme.Appbar">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_scrollFlags="enterAlways|scroll">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                style="@style/VkIm.Toolbar.Style.LargeWithBack"/>
            <com.vk.core.view.components.search.VkSearchView
                android:id="@+id/vkim_search"
                android:background="?attr/vk_ui_header_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                style="?attr/im_toolbar_search_style"/>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@+id/vkim_list_container"
        android:paddingBottom="104dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        style="@style/AppBarShadow"/>
    <View
        android:id="@+id/vkim_search_shadow"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        style="?attr/im_toolbar_shadow_style_thick"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/vkim_bottom_container"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/vkim_selected_users_counter"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/vkim_btn_video_call"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:text="@string/vkim_video_call_to_group_chat"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            app:buttonSizeType="large"
            app:icon="@drawable/vkui_ic_voip_call_video_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/vkim_btn_audio_call"
            app:layout_constraintTop_toBottomOf="@+id/vkim_selected_users_counter"
            app:tint="?attr/vk_ui_text_contrast_themed"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/vkim_btn_audio_call"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/vkim_accessibility_audio_call_to_group_chat"
            android:layout_marginEnd="16dp"
            app:icon="@drawable/vk_icon_phone_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vkim_selected_users_counter"
            app:tint="?attr/vk_ui_text_contrast_themed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
