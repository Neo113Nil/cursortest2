<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/super_app_page"
    android:background="?attr/vk_ui_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="top"
        android:id="@+id/gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="160dp"/>
    <com.vk.superapp.ui.views.SuperAppRecyclerView
        android:id="@+id/sa_recycler"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:splitMotionEvents="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        app:vk_appbar_ignoreHorizontalScroll="true"
        style="@style/AppBarShadow"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/error_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
