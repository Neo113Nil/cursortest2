<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/highlight_radius_8"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/clip_stub_item_clips_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:srcCompat="@drawable/vk_icon_chevron_right_circle_28"
        app:tint="?attr/vk_ui_icon_medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/clip_stub_item_more_clips_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/clips_newsfeed_show_all"
        android:layout_marginHorizontal="12dp"
        style="@style/VkUiTypography.SubheadMedium"/>
</LinearLayout>
