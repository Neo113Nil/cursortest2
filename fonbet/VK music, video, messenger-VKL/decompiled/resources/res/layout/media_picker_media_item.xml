<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.AspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/preview_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"/>
    <ImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/video_icon"
        android:padding="4dp"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/vk_icon_videocam_16"
        android:importantForAccessibility="no"
        app:tint="@color/vk_white"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:layout_gravity="end|bottom"
        android:id="@+id/video_duration"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:capsule="true"
        app:contentBadgeAppearance="overlay"
        app:contentBadgeMode="primary"
        app:contentBadgeSize="medium"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/checkbox"
        android:clickable="false"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
</com.vk.core.tool.view.AspectRatioFrameLayout>
