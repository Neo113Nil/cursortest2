<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/msv_back_btn"
        android:background="@drawable/vk_ripple_circle_highlight"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/vk_accessibility_back"
        android:alpha="1"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/msv_inner_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/msv_inner_container"
        app:srcCompat="@drawable/vk_icon_arrow_left_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/msv_inner_container"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/msv_bg_left_part"
                android:background="@drawable/vk_bg_card_elevation2_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationX="48dp"
                android:backgroundTint="?attr/vk_ui_search_field_background"/>
            <FrameLayout
                android:layout_gravity="start|center_vertical"
                android:id="@+id/msv_left_icon_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationX="48dp"
                android:layout_marginStart="12dp">
                <ImageView
                    android:id="@+id/msv_icon_search"
                    android:background="@drawable/vk_highlight_unlimited"
                    android:visibility="visible"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/vk_icon_search_outline_16"
                    app:tint="?attr/vk_ui_icon_medium"/>
                <ProgressBar
                    android:id="@+id/msv_progress_left"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/vk_ui_icon_medium"
                    android:indeterminateTintMode="src_in"/>
            </FrameLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/msv_bg_right_part"
            android:background="@drawable/vk_bg_card_elevation2_right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="?attr/vk_ui_search_field_background"/>
    </LinearLayout>
    <com.vk.internal.core.ui.edittext.PlainEditText
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:textColorHint="?attr/vk_ui_vkontakte_color_search_bar_field_tint"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/msv_query"
        android:background="@null"
        android:paddingBottom="1dp"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:hint="@string/vk_search"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:lineSpacingExtra="4sp"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionSearch"
        android:translationX="48dp"
        android:paddingStart="40dp"
        android:paddingEnd="80dp"
        android:letterSpacing="0.01"
        app:layout_constraintBottom_toBottomOf="@+id/msv_inner_container"
        app:layout_constraintEnd_toEndOf="@+id/msv_inner_container"
        app:layout_constraintStart_toStartOf="@+id/msv_inner_container"
        app:layout_constraintTop_toTopOf="@+id/msv_inner_container"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:id="@+id/msv_actions_container"
        android:layout_width="72dp"
        android:layout_height="36dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/msv_inner_container"
        app:layout_constraintEnd_toEndOf="@+id/msv_inner_container"
        app:layout_constraintTop_toTopOf="@+id/msv_inner_container">
        <ImageView
            android:id="@+id/msv_secondary_action"
            android:background="@drawable/vk_ripple_circle_highlight"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="@string/vk_accessibility_clear_input"
            app:srcCompat="@drawable/vk_icon_cancel_24"
            app:tint="?attr/vk_ui_vkontakte_color_search_bar_field_tint"/>
        <ImageView
            android:id="@+id/msv_action"
            android:background="@drawable/vk_ripple_circle_highlight"
            android:visibility="visible"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/vk_talkback_ic_voice"
            app:srcCompat="@drawable/vk_icon_voice_outline_24"
            app:tint="?attr/vk_ui_vkontakte_color_search_bar_field_tint"/>
    </LinearLayout>
</merge>
