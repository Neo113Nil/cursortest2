<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:backgroundTint="?attr/vk_ui_background_tertiary"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">
    <ImageView
        android:id="@+id/banner_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/vk_icon_hide_outline_28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/banner_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/toxic_coments"
        android:maxLines="1"
        android:textAlignment="textStart"
        android:layout_marginStart="14dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/banner_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.HeadlineSemiBold"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/banner_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reason_toxic_comments_hidden"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/banner_header"
        app:layout_constraintTop_toBottomOf="@+id/banner_header"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/banner_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/show_comments"
        android:maxLines="1"
        android:textAlignment="textStart"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/banner_header"
        app:layout_constraintTop_toBottomOf="@+id/banner_description"
        style="@style/VkUiTypography.HeadlineSemiBold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
