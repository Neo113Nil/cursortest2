<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/button_container"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.components.placeholder.VkPlaceholder
                android:id="@+id/placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.components.formitem.VkFormField
                android:id="@+id/name_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl">
                <com.vk.core.view.components.formitem.VkInputSelect
                    android:id="@+id/name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/VkInput"/>
            </com.vk.core.view.components.formitem.VkFormField>
            <com.vk.core.view.components.formitem.VkFormField
                android:id="@+id/price_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
                android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl">
                <com.vk.core.view.components.formitem.VkInputSelect
                    android:id="@+id/price_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/VkInput"/>
            </com.vk.core.view.components.formitem.VkFormField>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/button_container"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.vk.core.view.components.button.VkButton
            android:enabled="false"
            android:id="@+id/continue_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"
            app:text="@string/vkim_channels_donut_support_button_connect"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
