<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.attachpicker.widget.LocalImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/tiv_album_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:scaleType="centerCrop"/>
    <View
        android:layout_gravity="center_vertical"
        android:layout_width="1px"
        android:layout_height="48dp"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Text.Unscaled"
            android:textColor="?attr/vk_ui_text_muted"
            android:gravity="bottom|left"
            android:id="@+id/tv_title"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="?attr/vk_ui_text_subhead"
            android:gravity="top|left"
            android:id="@+id/tv_photos_count"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"/>
    </LinearLayout>
</LinearLayout>
