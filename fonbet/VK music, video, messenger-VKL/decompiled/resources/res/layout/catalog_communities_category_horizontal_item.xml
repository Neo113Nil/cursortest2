<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/catalog_bg_communities_category_12dp"
    android:padding="2dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight_radius_12">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="start"
        android:id="@+id/category_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        app:actualImageScaleType="fitCenter"
        app:roundedCornerRadius="10dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.33dp"/>
    <TextView
        android:textSize="16sp"
        android:layout_gravity="center_vertical"
        android:id="@+id/category_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        style="@style/VkLegacyTypography.Headline.Regular"/>
</LinearLayout>
