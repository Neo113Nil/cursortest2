<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/clips_interests_coordinator_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.clips.interests.impl.ui.recycler.ClipsInterestsRecyclerView
            android:id="@+id/clips_interests_recycler"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            app:layout_behavior="com.google.android.material.appbar.NonBouncedAppBarLayout$ScrollingViewBehavior"/>
        <com.google.android.material.appbar.NonBouncedAppBarLayout
            android:id="@+id/clips_interests_appbar"
            android:background="@null"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/clips_interests_titles_area"
                android:paddingTop="72dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="snap|scroll">
                <com.vk.core.view.components.text.VkText
                    android:textColor="?attr/vk_ui_text_accent"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/clips_interests_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    style="@style/VkUiTypography.Paragraph"/>
                <com.vk.core.view.components.text.VkText
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/clips_interests_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0"
                    style="@style/VkUiTypography.DisplayTitle2"/>
            </LinearLayout>
        </com.google.android.material.appbar.NonBouncedAppBarLayout>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/clips_interests_progress_bar"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clips_interests_error_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center"
                android:id="@+id/clips_grid_error_text"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/clips_interests_error"
                app:layout_constraintBottom_toTopOf="@+id/clips_interests_retry_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/VkUiTypography.Paragraph"/>
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/clips_interests_retry_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:buttonAppearance="neutral"
                app:buttonMode="secondary"
                app:buttonSizeType="medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clips_grid_error_text"
                app:text="@string/clips_interests_retry_button"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <ImageView
        android:layout_gravity="top|left"
        android:id="@+id/clips_interests_back"
        android:background="@drawable/bg_round_selectable_blur"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_back"
        android:layout_marginStart="12dp"
        app:srcCompat="@drawable/vk_icon_arrow_left_outline_28"
        app:tint="@color/vk_white"/>
    <com.vk.clips.design.view.interests.AvatarWithStepProgress
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/clips_interests_avatar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/clips_interests_avatar_area_height"/>
    <com.vk.clips.design.view.interests.NextButton
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/clips_interests_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"
        style="@style/VkUiTypography.Title3Medium"/>
</FrameLayout>
