<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.stickers.views.gift.GiftView
        android:id="@+id/gift_view"
        android:layout_width="@dimen/user_profile_gift_size"
        android:layout_height="@dimen/user_profile_gift_size"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_xs"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_m"
        android:foreground="?attr/selectableItemBackground"
        android:contentDescription="@string/user_profile_accessibility_gift"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_s"
        app:animationType="secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.badge.VkContentBadge
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:contentBadgeAppearance="neutral"
        app:contentBadgeMode="primary"
        app:contentBadgeSize="small"
        app:text="@string/user_profile_birthday_tooltip_free"/>
</FrameLayout>
