<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/posting_sender_layout"
    android:background="?attr/selectableItemBackground"
    android:paddingLeft="8dp"
    android:paddingRight="12dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="?attr/actionBarSize"
    android:layout_marginStart="52dp"
    android:layout_marginEnd="52dp">
    <com.vk.newsfeed.impl.posting.avatar.PostingAvatarViewContainer
        android:id="@+id/posting_avatar_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundAvatarSize="36dp"/>
    <FrameLayout
        android:id="@+id/posting_user_name_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp">
        <com.vk.catalog2.common.ui.core.view.CorrectlyMeasuringTextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_muted"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/posting_user_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkLegacyTypography.Title1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:layout_gravity="top"
            android:id="@+id/posting_subtitle_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/newsfeed_newpost_post_editing"
            android:singleLine="true"
            android:fontFamily="sans-serif"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/posting_author_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/vk_icon_dropdown_16"
        app:tint="?attr/vk_legacy_header_tint_alternate"/>
</LinearLayout>
