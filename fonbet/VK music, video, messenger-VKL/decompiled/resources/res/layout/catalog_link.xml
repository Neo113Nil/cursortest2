<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/music_line_link_container"
    android:paddingTop="4dp"
    android:paddingBottom="8dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.catalog2.feature.music.holders.view.CatalogTripleRotatedImagesCard
        android:layout_gravity="center"
        android:id="@+id/link_image_container"
        android:layout_width="@dimen/music_catalog_link_item_width"
        android:layout_height="@dimen/music_catalog_link_item_width"
        android:elevation="0dp"
        app:cardBackgroundColor="?attr/vk_ui_background_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/link_title"
        android:layout_width="@dimen/music_catalog_link_item_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAlignment="center"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption2"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/link_subtitle"
        android:layout_width="@dimen/music_catalog_link_item_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAlignment="center"/>
</LinearLayout>
