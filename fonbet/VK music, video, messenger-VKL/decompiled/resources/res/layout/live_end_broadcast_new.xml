<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="end"
        android:id="@+id/live_end_broadcast_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/accessibility_close"
        app:buttonAppearance="neutral"
        app:buttonMode="tertiary"
        app:buttonSizeType="large"
        app:icon="@drawable/vk_icon_cancel_shadow_medium_48"
        app:iconSize="48dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/liveEndViewLinear"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/live_end_broadcast_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_broadcast_end_finished"
            android:maxLines="1"
            style="@style/VkUiTypography.Title2"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/live_end_broadcast_stat"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            app:buttonAppearance="overlay"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"
            app:icon="@drawable/vk_icon_statistics_outline_24"
            app:text="@string/live_broadcast_end_stat"/>
        <com.vk.core.view.components.button.VkButton
            android:gravity="center"
            android:id="@+id/live_end_broadcast_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/live_broadcast_end_watch_video"
            app:buttonAppearance="neutral"
            app:buttonMode="tertiary"
            app:buttonSizeType="medium"/>
    </LinearLayout>
    <com.vk.core.view.components.button.VkButton
        android:gravity="center"
        android:id="@+id/live_end_broadcast_publish"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="60dp"
        android:text="@string/live_broadcast_end_screen_save_record_do"
        app:buttonAppearance="neutral"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</LinearLayout>
