<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/music_kids_stacked_height">
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/main_image"
        android:layout_width="@dimen/music_kids_stacked_image_main_size"
        android:layout_height="@dimen/music_kids_stacked_image_main_size"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:scaleType="centerCrop"
        android:rotation="-8"
        android:importantForAccessibility="no"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="38dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/secondary_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginEnd="8dp"
        app:roundedCornerRadius="@dimen/music_image_corners_6"
        app:tiv_border_color="?attr/vk_ui_image_border_alpha"
        app:tiv_border_width="1dp"
        app:tiv_empty_tint="?attr/vk_ui_image_placeholder_alpha"
        app:tiv_scale_inside_borders="true"/>
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/secondary_image"
        android:layout_width="@dimen/music_kids_stacked_image_secondary_size"
        android:layout_height="@dimen/music_kids_stacked_image_secondary_size"
        android:scaleType="centerCrop"
        android:rotation="-8"
        android:importantForAccessibility="no"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_image"
        app:layout_constraintVertical_bias="0.45"
        app:roundedCornerRadius="@dimen/music_image_corners_6"
        app:tiv_border_color="?attr/vk_ui_image_border_alpha"
        app:tiv_border_width="1dp"
        app:tiv_empty_tint="?attr/vk_ui_image_placeholder_alpha"
        app:tiv_scale_inside_borders="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
