<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/button"
    android:background="@drawable/highlight_radius_8"
    android:layout_width="140dp"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:id="@+id/button_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/catalog_button_show_all"
        android:drawablePadding="8dp"
        app:drawableTint="?attr/vk_ui_icon_secondary"
        app:drawableTopCompat="@drawable/vk_icon_chevron_right_circle_28"/>
</FrameLayout>
