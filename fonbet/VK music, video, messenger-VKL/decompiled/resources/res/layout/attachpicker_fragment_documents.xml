<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/attach_appbar_layout"
        android:background="?attr/vk_ui_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="?attr/vk_ui_background_modal"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:collapseIcon="@drawable/ic_back_collapse"
            app:contentInsetStartWithNavigation="0dp"
            app:titleTextColor="?attr/vk_ui_text_muted"/>
        <View
            android:id="@+id/attachpicker_documents_toolbar_shadow"
            android:background="@drawable/picker_bg_attach_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include
            android:id="@+id/attachpicker_documents_holder_document_layout"
            layout="@layout/holder_add_document"/>
        <com.vk.core.view.VKTabLayout
            android:id="@+id/attachpicker_documents_tab_layout"
            android:background="?attr/vk_ui_background_modal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="?attr/vk_ui_stroke_accent_themed"
            app:tabSelectedTextColor="?attr/vk_ui_text_primary"
            app:tabTextColor="?attr/vk_ui_text_tertiary"
            style="?attr/tabBarTheme"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/attachpicker_documents_view_pager"
        android:background="?attr/vk_ui_background_content"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.view.components.paging.list.VkRecyclerPaginatedView
        android:id="@+id/attach_recycler_view"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/attach_counter_view_wrapper"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/picker_attach_btn_height">
        <View
            android:id="@+id/attach_counter_divider"
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.33dp"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/picker_attach_btn_top_bot_space"
            android:layout_marginHorizontal="@dimen/picker_attach_btn_left_right_space"
            layout="@layout/attachpicker_warning_single_mode_view"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="bottom"
            android:id="@+id/attach_counter_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/picker_attach_btn_left_right_space"
            android:layout_marginVertical="@dimen/picker_attach_btn_top_bot_space"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </FrameLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/attachpicker_documents_progressbar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <include
        android:id="@+id/attachpicker_documents_error"
        android:visibility="gone"
        layout="@layout/vk_error_screen"/>
    <com.vk.core.view.AppBarShadowView style="@style/PostingAppBarShadow"/>
    <ViewStub
        android:id="@+id/attachpicker_documents_system_picker_stub"
        android:layout="@layout/attachpicker_documents_system_picker_container"
        android:inflatedId="@+id/attachpicker_documents_system_picker_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
