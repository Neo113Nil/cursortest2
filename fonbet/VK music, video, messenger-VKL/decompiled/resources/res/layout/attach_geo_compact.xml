<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attach_geo_compact_container"
    android:paddingTop="12dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="14dp"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <View
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/vk_icon_place_12"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:backgroundTint="?attr/vk_ui_icon_secondary"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/attach_geo_compact_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="14dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        style="@style/VkUiTypography.Caption1"/>
</FrameLayout>
