<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_list_selector"
    android:paddingBottom="8dp"
    android:layout_width="72dp"
    android:layout_height="wrap_content">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/page_info_photo"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginTop="-2dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/page_info_state"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:translationX="-2dp"
        android:translationY="-2dp"
        app:layout_constraintBottom_toBottomOf="@+id/page_info_photo"
        app:layout_constraintEnd_toEndOf="@+id/page_info_photo"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/page_info_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:translationY="-2dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/page_info_photo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
