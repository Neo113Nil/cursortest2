<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@android:color/transparent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_white"
        android:id="@+id/live_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_before_run_title"
        style="@style/VkUiTypography.Headline2Normal"/>
    <com.vk.libvideo.design.view.timer.LiveTimerView
        android:id="@+id/live_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/notification_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/live_notify_about_start"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
</merge>
