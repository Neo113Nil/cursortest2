<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="0.5dp">
        <com.vk.core.view.TextViewMultilineWrapContent
            android:ellipsize="end"
            android:id="@+id/audio_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:layout_marginStart="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/audio_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/vk_ui_typography_title2_medium"/>
        <com.vk.music.view.ThumbsImageView
            android:id="@+id/audio_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="3dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/audio_title"
            app:layout_constraintTop_toTopOf="parent"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_podcast_48"
            app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
        <com.vk.core.view.links.LinkedTextView
            android:textAppearance="?attr/vk_ui_typography_subhead"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/audio_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@+id/audio_title"
            app:layout_constraintStart_toStartOf="@+id/audio_title"
            app:layout_constraintTop_toBottomOf="@+id/audio_title"/>
        <FrameLayout
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="9dp"
            app:layout_constraintTop_toBottomOf="@+id/audio_artist">
            <include layout="@layout/music_podcast_audio"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/first_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <com.vk.core.view.components.group.header.VkGroupHeader
        android:id="@+id/audio_description_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"/>
    <com.vk.core.view.links.LinkedTextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/audio_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="?attr/vk_ui_typography_paragraph"/>
    <View
        android:id="@+id/second_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="19.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <include
        android:id="@+id/help_hint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        layout="@layout/music_podcast_catalog_help_hint"/>
</LinearLayout>
