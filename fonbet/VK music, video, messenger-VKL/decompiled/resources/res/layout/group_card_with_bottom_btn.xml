<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/group_card_container"
    android:background="@drawable/bg_group_card_with_bottom_btn"
    android:layout_width="match_parent"
    android:layout_height="257dp"
    android:foreground="@drawable/vk_highlight_radius_16">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:overlayImage="@drawable/bg_radius_12_with_border"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/friends_layout"
        android:background="@drawable/bg_friends_layout"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_m"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_m"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/photo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent">
        <com.vk.core.view.PhotoStackView
            android:id="@+id/photo_stack"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/vk_ui_spacing_size2_xs"/>
        <TextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawablePadding="@dimen/vk_ui_spacing_size_xs"
            android:paddingStart="@dimen/vk_ui_spacing_size_xs"
            android:paddingEnd="@dimen/vk_ui_spacing_size_m"
            android:paddingVertical="0dp"
            style="@style/VkUiTypography.Caption1"/>
    </LinearLayout>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:layout_gravity="start"
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_l"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_l"
        app:layout_constraintTop_toBottomOf="@+id/photo">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="none"
            android:id="@+id/title"
            android:fadingEdgeLength="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fadeScrollbars="false"
            android:requiresFadingEdge="horizontal"
            app:vk_layout_isFluid="true"
            style="@style/VkUiTypography.Headline1SemiBold"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_l"
        app:layout_constraintTop_toBottomOf="@+id/title_layout"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:layout_gravity="center"
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
        android:text="@string/join_page"
        android:elevation="2dp"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_l"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
</merge>
