<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/catalog_bg_corner_18"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/catalog_banner_end_image"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="19sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/catalog_banner_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="16dp"
        android:letterSpacing="0.01"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:ellipsize="end"
        android:id="@+id/catalog_banner_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        app:layout_constraintStart_toStartOf="@+id/catalog_banner_title"
        app:layout_constraintTop_toBottomOf="@+id/catalog_banner_title"/>
    <TextView
        android:id="@+id/catalog_banner_button"
        android:background="@drawable/vkui_bg_button_secondary_radius_8"
        android:layout_width="0dp"
        android:layout_marginTop="19dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/catalog_banner_message"
        style="@style/VkLegacyButton.Secondary.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
