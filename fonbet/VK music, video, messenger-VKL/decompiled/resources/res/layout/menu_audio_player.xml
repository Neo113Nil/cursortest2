<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:src="@drawable/shadow_bottom_panel"
        android:scaleType="fitXY"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/player_view_content"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <com.vk.music.view.ThumbsImageView
            android:id="@+id/player_view_albumart"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_song_outline_28"/>
        <ImageView
            android:id="@+id/player_view_button"
            android:background="@drawable/highlight_circle"
            android:clickable="true"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/vk_icon_pause_24"
            android:scaleType="center"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="1dp"
            android:layout_toLeftOf="@+id/player_view_button"
            android:layout_toRightOf="@+id/player_view_albumart">
            <TextView
                android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
                android:textColor="?attr/vk_ui_text_muted"
                android:ellipsize="marquee"
                android:id="@+id/player_view_title"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Only"
                android:singleLine="true"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption1.Unscaled"
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="marquee"
                android:id="@+id/player_view_artist"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sunrise Avenue"
                android:singleLine="true"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/player_view_progress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:indeterminate="false"
            android:progressDrawable="@drawable/drawer_player_progress"
            android:layout_toRightOf="@+id/player_view_albumart"
            android:layout_alignParentRight="true"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    </RelativeLayout>
</LinearLayout>
