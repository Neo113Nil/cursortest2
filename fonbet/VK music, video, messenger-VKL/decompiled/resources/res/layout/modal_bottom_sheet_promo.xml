<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_nested"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="24dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="24dp"/>
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/image_single"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginTop="32dp"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/image_background"
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_margin="8dp"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.vk.imageloader.view.VKCircleImageView
                android:id="@+id/image_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="32dp"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/user_placeholder"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/image_barrier"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="image_avatar, image_single"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Title2Medium"
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center"
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="2"
                app:layout_constraintBottom_toTopOf="@+id/text_description"
                app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                app:layout_constraintStart_toStartOf="@+id/guideline_start"
                app:layout_constraintTop_toBottomOf="@+id/image_barrier"
                app:layout_constraintVertical_bias="1"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.vk.core.view.links.LinkedTextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:linksClickable="false"
                android:id="@+id/text_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="4"
                android:hyphenationFrequency="none"
                app:layout_constraintBottom_toTopOf="@+id/button_action"
                app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                app:layout_constraintStart_toStartOf="@+id/guideline_start"
                app:layout_constraintTop_toBottomOf="@+id/text_title"/>
            <com.vk.core.view.components.button.VkSimpleButton
                android:id="@+id/button_action"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                app:buttonAppearance="accent"
                app:buttonMode="primary"
                app:buttonSizeType="small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                app:layout_constraintStart_toStartOf="@+id/guideline_start"
                app:layout_constraintTop_toBottomOf="@+id/text_description"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/image_btn_hide"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:contentDescription="@null"
        android:layout_marginEnd="20dp"
        app:srcCompat="@drawable/vk_icon_clear_20"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</androidx.cardview.widget.CardView>
