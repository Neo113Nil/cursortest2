<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clips_wrapper_content_container"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/clip_feed_background"
        android:background="@color/vk_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <com.vk.clips.tool.view.viewer.feed.wrapper.fragment.FragmentContainerFrameLayout
        android:id="@+id/clip_feed_lists_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/clip_feed_download_progress_stub"
        android:layout="@layout/clips_wrapper_fragment_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
