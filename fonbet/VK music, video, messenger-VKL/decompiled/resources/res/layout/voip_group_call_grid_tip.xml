<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@drawable/bg_group_call_tip">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/texts_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="36dp"
        android:paddingVertical="12dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="20sp"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:text="@string/voip_fast_call_create_tip_title"
            android:paddingEnd="2dp"
            style="@style/VkLegacyTypography.Title2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/voip_fast_call_create_tip_subtitle"
            android:shadowColor="@color/vk_black"
            android:shadowRadius="2"
            android:drawablePadding="4dp"
            android:lineSpacingExtra="2sp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15sp"
            android:layout_gravity="center"
            android:id="@+id/invite_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="36dp"
            android:text="@string/vkim_share_link"
            style="@style/VkLegacyButton.Primary"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15sp"
            android:layout_gravity="center"
            android:id="@+id/open_prefs_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="36dp"
            android:text="@string/voip_fast_call_create_tip_setup_access_text"
            style="@style/VkLegacyButton.Secondary"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/close_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:tint="@color/vk_gray_400"
        android:contentDescription="@string/accessibility_close"
        app:srcCompat="@drawable/vk_icon_dismiss_24"/>
</merge>
