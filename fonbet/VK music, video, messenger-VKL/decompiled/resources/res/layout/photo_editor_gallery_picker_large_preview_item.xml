<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/gallery_picker_preview_item_background"
    android:layout_width="140dp"
    android:layout_height="140dp">
    <com.vk.attachpicker.widget.MediaStoreItemSmallView
        android:id="@+id/picker_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/gallery_picker_preview_accessibility_photo"
        app:actualImageScaleType="centerCrop"/>
    <FrameLayout
        android:layout_gravity="top|right"
        android:id="@+id/picker_counter_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/bg_selected_circle"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/picker_counter_text"
            android:background="@drawable/picker_bg_accent_circle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            app:autoSizeMaxTextSize="15dp"
            app:autoSizeMinTextSize="6dp"
            app:autoSizeStepGranularity="1dp"
            app:autoSizeTextType="uniform"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center_vertical"
        android:layout_gravity="bottom|right"
        android:id="@+id/edit_icon"
        android:background="@drawable/gallery_picker_photo_editor_badge_background"
        android:paddingLeft="8dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/gallery_picker_editor_badge_text"
        android:drawableLeft="@drawable/vk_icon_sliders_outline_20"
        android:drawablePadding="4dp"
        android:contentDescription="@string/gallery_picker_editor_accessibility"
        app:drawableTint="?attr/vk_ui_text_contrast"
        style="@style/VkUiTypography.ParagraphMedium"/>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/ic_remove_photo"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_cancel_16"
        android:contentDescription="@string/gallery_picker_remove_photo_accessibility"
        app:tint="?attr/vk_ui_icon_contrast"/>
</FrameLayout>
