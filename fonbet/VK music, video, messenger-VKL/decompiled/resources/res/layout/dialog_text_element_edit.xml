<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/scrim_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/layout_edit_content"
        android:fitsSystemWindows="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">
        <com.vk.photo.editor.markup.view.tools.editor.TextElementEditText
            android:textSize="40sp"
            android:textColor="@color/editor_white"
            android:layout_gravity="center"
            android:id="@+id/edit_text_element"
            android:background="@null"
            android:paddingTop="80dp"
            android:paddingBottom="100dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="325"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            style="?attr/editorTextElementEditTextStyle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_text_edit_actions"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.Group
                android:id="@+id/top_bar_actions_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="button_text_align, button_text_background, button_text_edit_done"/>
            <ImageButton
                android:id="@+id/button_text_background"
                android:background="@drawable/ripple_50dp"
                android:padding="10dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_text_style_transparent_background"
                android:contentDescription="@string/text_background_button_accessibility_description"
                android:layout_marginVertical="4dp"
                app:layout_constraintEnd_toStartOf="@+id/button_text_align"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/editorButtonPrimaryStyle"/>
            <ImageButton
                android:id="@+id/button_text_align"
                android:background="@drawable/ripple_50dp"
                android:padding="10dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_text_align_center"
                android:contentDescription="@string/text_aligment_button_accessibility_description"
                android:layout_marginVertical="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/button_text_background"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/editorButtonPrimaryStyle"/>
            <ImageButton
                android:id="@+id/button_text_edit_done"
                android:background="@drawable/ripple_50dp"
                android:padding="10dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_done_outline"
                android:contentDescription="@string/editor_done"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/editorButtonPrimaryStyle"/>
            <com.vk.photo.editor.markup.view.tools.SizeSeekBarView
                android:id="@+id/font_size_seek_bar"
                android:layout_width="wrap_content"
                android:layout_height="216dp"
                android:contentDescription="@string/text_size_seekbar_description_accessibility_description"
                app:anchor="end"
                app:barMaxWidth="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:seekProgress="0.2"
                app:thumbRadius="12dp"/>
            <FrameLayout
                android:id="@+id/layout_colors_panel"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/layout_colors_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="horizontal"
                        android:id="@+id/colors_list"
                        android:background="@drawable/bg_panel_background"
                        android:padding="4dp"
                        android:visibility="invisible"
                        android:clipToPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/internal_font_button"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.vk.photo.editor.markup.view.tools.button.FontButton
                        android:id="@+id/internal_font_button"
                        android:background="@drawable/bg_panel_background"
                        android:visibility="invisible"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/colors_list"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.vk.photo.editor.markup.view.tools.button.ColorButton
                        android:id="@+id/color_button"
                        android:background="@drawable/bg_panel_background"
                        android:padding="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/color_select_button_accessibility_description"
                        app:accessibilityMode="open"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/colors_list"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.vk.photo.editor.markup.view.tools.button.PipetteButton
                        android:id="@+id/pipette_button"
                        android:background="@drawable/bg_panel_background"
                        android:padding="4dp"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/colors_list"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/layout_fonts_panel"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/layout_fonts_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="horizontal"
                        android:id="@+id/fonts_list"
                        android:background="@drawable/bg_panel_background"
                        android:padding="4dp"
                        android:clipToPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/internal_pipette_button"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.vk.photo.editor.markup.view.tools.button.PipetteButton
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/internal_pipette_button"
                        android:background="@drawable/bg_panel_background"
                        android:padding="4dp"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/fonts_list"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.vk.photo.editor.markup.view.tools.button.FontButton
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/font_button"
                        android:background="@drawable/bg_panel_background"
                        android:visibility="invisible"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/font_select_button_accessibility_description"
                        app:accessibilityMode="open"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/fonts_list"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <com.vk.photo.editor.markup.view.tools.PipetteView
        android:id="@+id/pipette_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
