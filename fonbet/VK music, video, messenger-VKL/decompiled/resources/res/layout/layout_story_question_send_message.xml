<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/question_message_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/iv_story_view"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="?attr/vk_ui_image_placeholder"
        app:roundedCornerRadius="8dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption2CapsMedium"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/tv_question_author_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:lines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_story_view"
        app:layout_constraintTop_toTopOf="@+id/iv_story_view"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.TextMedium"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/tv_question"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_story_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_question_author_name"/>
    <com.vk.core.view.components.formitem.VkInputSelect
        android:gravity="start"
        android:id="@+id/et_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:minHeight="64dp"
        android:hint="@string/story_question_option_message_hint"
        android:maxLines="4"
        android:lineSpacingExtra="4sp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:inputSize="textArea"
        app:layout_constraintTop_toBottomOf="@+id/tv_question"
        style="@style/VkInput"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:enabled="false"
        android:id="@+id/tv_question_send"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/story_question_option_message_send"
        android:lines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintTop_toBottomOf="@+id/et_message"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_question_send"/>
</androidx.constraintlayout.widget.ConstraintLayout>
