<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/floating_placeholder_square_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="12dp"
        app:roundedCornerRadius="4dp"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/floating_placeholder_circle_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:scaleType="center"
        android:layout_marginStart="12dp"
        app:roundAsCircle="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/floating_placeholder_text_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="11dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="48dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:ellipsize="end"
            android:id="@+id/floating_placeholder_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:maxLines="2"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
            android:ellipsize="end"
            android:id="@+id/floating_placeholder_action_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <View
        android:layout_gravity="end"
        android:id="@+id/floating_placeholder_close_background"
        android:background="@drawable/bg_close_floating_placeholder"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/floating_placeholder_close_button"
        android:layout_width="@dimen/newsfeed_floating_placeholder_close_image_size"
        android:layout_height="@dimen/newsfeed_floating_placeholder_close_image_size"
        android:foreground="@drawable/highlight_circle_white"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_cancel_16"/>
</merge>
