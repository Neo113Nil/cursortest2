<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/vkim_chat_profile_fragment__appbar"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        app:expanded="true">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/vkim_chat_profile_fragment_collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
            <View
                android:id="@+id/vkim_chat_profile_fragment_toolbar_background"
                android:background="@drawable/bg_rounded_corners_bottom_20"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/vkim_chat_profile_fragment__toolbar"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationContentDescription="@string/vkim_accessibility_toolbar_back_exit"
                style="@style/VkIm.Toolbar.Style"/>
            <LinearLayout
                android:gravity="top"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:id="@+id/vkim_chat_profile_fragment__collapsed_container"
                android:padding="0dp"
                android:paddingTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin">
                <FrameLayout
                    android:id="@+id/vkim_chat_profile_fragment__collapsed_text_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="@style/VkUiTypography.Title2Medium"
                        android:textColor="?attr/vk_ui_text_primary"
                        android:ellipsize="end"
                        android:id="@+id/vkim_chat_profile_fragment__collapsed_title_trimmed"
                        android:background="?attr/vk_ui_background_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="0dp"
                        android:drawablePadding="4dp"/>
                    <TextView
                        android:textAppearance="@style/VkUiTypography.Title2Medium"
                        android:textColor="?attr/vk_ui_text_primary"
                        android:ellipsize="end"
                        android:id="@+id/vkim_chat_profile_fragment__collapsed_title"
                        android:background="?attr/vk_ui_background_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="0dp"/>
                </FrameLayout>
                <TextView
                    android:textAppearance="@style/VkUiTypography.ParagraphNormal"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/vkim_chat_profile_fragment__collapsed_subtitle"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:maxLines="1"
                    android:lines="1"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vkim_chat_profile_fragment__header_container"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/vkim_chat_profile_fragment__header_info_wrapper"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.vk.im.ui.views.avatars.VkImAvatar
                        android:id="@+id/vkim_chat_profile_fragment__avatar"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginTop="12dp"
                        android:foreground="@drawable/vkim_chat_profile_avatar_foreground"
                        android:contentDescription="@string/vkim_accessibility_avatar"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/vkim_chat_profile_fragment__header_info_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/vkim_chat_profile_fragment__actions"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/avatarContainer">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/vkim_chat_profile_fragment__header_info_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.vk.core.tool.view.FluidHorizontalLayout
                            android:gravity="center_horizontal"
                            android:id="@+id/vkim_chat_profile_fragment__title_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textAppearance="@style/VkUiTypography.Title2Medium"
                                android:textColor="?attr/vk_ui_text_primary"
                                android:ellipsize="end"
                                android:gravity="center_horizontal"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/vkim_chat_profile_fragment__title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="4dp"
                                android:transformPivotY="0dp"
                                app:vk_layout_isFluid="true"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/vkim_chat_profile_fragment__verified"
                                android:visibility="gone"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:scaleType="centerInside"
                                android:adjustViewBounds="true"
                                android:contentDescription="@null"
                                android:translationY="0sp"
                                android:layout_marginStart="4dp"/>
                        </com.vk.core.tool.view.FluidHorizontalLayout>
                        <TextView
                            android:textAppearance="@style/VkUiTypography.ParagraphNormal"
                            android:textColor="?attr/vk_ui_text_link"
                            android:ellipsize="end"
                            android:gravity="center_horizontal"
                            android:id="@+id/vkim_chat_profile_fragment__link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="5dp"
                            android:lines="1"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            app:layout_constraintBottom_toTopOf="@+id/vkim_chat_profile_fragment__subtitle"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/vkim_chat_profile_fragment__title_container"
                            app:layout_goneMarginBottom="0dp"
                            app:layout_goneMarginTop="0dp"/>
                        <TextView
                            android:textAppearance="@style/VkUiTypography.ParagraphNormal"
                            android:textColor="?attr/vk_ui_text_secondary"
                            android:ellipsize="end"
                            android:gravity="center_horizontal"
                            android:id="@+id/vkim_chat_profile_fragment__subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="5dp"
                            android:lines="1"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/vkim_chat_profile_fragment__link"
                            app:layout_goneMarginBottom="0dp"/>
                        <TextView
                            android:textColor="?attr/vk_ui_accent_purple"
                            android:ellipsize="end"
                            android:gravity="center_horizontal"
                            android:id="@+id/vkim_chat_profile_fragment__not_disturb"
                            android:background="@drawable/bg_not_disturb_badge"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="5dp"
                            android:lines="1"
                            android:drawablePadding="6dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="16dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:paddingVertical="6dp"
                            app:drawableTint="?attr/vk_ui_accent_purple"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/vkim_chat_profile_fragment__subtitle"
                            app:layout_goneMarginBottom="0dp"
                            style="@style/VkUiTypography.SubheadMedium"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <FrameLayout
                        android:id="@+id/vkim_chat_profile_fragment__opacity_gradient"
                        android:background="@drawable/bg_opacity_gradient"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"/>
                </FrameLayout>
                <com.vk.im.design.view.chat_profile.ChatProfileActionsView
                    android:id="@+id/vkim_chat_profile_fragment__actions"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/vkim_chat_profile_fragment__header_info_wrapper"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <com.vk.im.ui.views.nested_recyclerview.NestedVerticalRecyclerViewContainer
        android:id="@+id/vkim_chat_profile_fragment__nested_rv_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vkim_chat_profile_fragment__rv_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:defaultFocusHighlightEnabled="false"/>
    </com.vk.im.ui.views.nested_recyclerview.NestedVerticalRecyclerViewContainer>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/vkim_chat_profile_fragment__shadow"
        style="@style/AppBarShadow"/>
    <FrameLayout
        android:id="@+id/vkim_chat_profile_fragment__loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.pnikosis.materialishprogress.ProgressWheel
            android:layout_gravity="center"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:matProg_barColor="?attr/vk_ui_text_accent"
            app:matProg_progressIndeterminate="true"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
