<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_black"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/videoAnnounce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/video_announce_author_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="0dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/videoAnnounceNextTextView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_announce_video_next"
            app:layout_constraintBottom_toBottomOf="@+id/videoAnnounceCloseView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/videoAnnounceCloseView"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/videoAnnounceNextAfterTextView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_announce_video_next_after"
            app:layout_constraintBottom_toBottomOf="@+id/videoAnnounceCloseView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/videoAnnounceCloseView"/>
        <FrameLayout
            android:id="@+id/videoAnnounceCloseView"
            android:visibility="gone"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:layout_constraintBottom_toTopOf="@+id/videoAnnounceImageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1">
            <ImageView
                android:layout_gravity="end|top"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/vk_icon_dismiss_24"
                android:contentDescription="@string/video_accessibility_close"
                android:layout_marginVertical="16dp"
                app:tint="@color/vk_ui_icon_medium_tint"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/videoAnnounceTitleView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:layout_marginStart="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintTop_toTopOf="@+id/videoAnnounceImageView"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.FootnoteNormal"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/videoAnnounceChannelNameView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintTop_toBottomOf="@+id/videoAnnounceTitleView"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/videoAnnounceImageView"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="@+id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:roundedCornerRadius="@dimen/next_video_image_corner_radius"/>
        <ImageView
            android:id="@+id/videoAnnouncePlayIcon"
            android:background="@drawable/play_circle_shape"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/vk_icon_play_24"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="@+id/videoAnnounceImageView"
            app:layout_constraintEnd_toEndOf="@+id/videoAnnounceImageView"
            app:layout_constraintStart_toStartOf="@+id/videoAnnounceImageView"
            app:layout_constraintTop_toTopOf="@+id/videoAnnounceImageView"
            app:tint="@color/vk_white"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1Medium"
            android:textColor="?attr/vk_ui_text_contrast"
            android:id="@+id/videoAnnounceDurationView"
            android:background="@drawable/duration_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/videoAnnounceImageView"
            app:layout_constraintEnd_toEndOf="@+id/videoAnnounceImageView"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/restrictionContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/videoAnnounceImageView"
            app:layout_constraintEnd_toEndOf="@+id/videoAnnounceImageView"
            app:layout_constraintStart_toStartOf="@+id/videoAnnounceImageView"
            app:layout_constraintTop_toTopOf="@+id/videoAnnounceImageView">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/videoAnnounceRestrictionIconView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/vk_icon_hide_outline_28"
                android:elevation="10dp"
                app:tint="@color/vk_white"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.FootnoteNormal"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/videoAnnounceRestrictionTitleView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="3"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.video.ui.discovery.minimizable.announce.author.VideoAnnounceAuthorView
        android:id="@+id/video_announce_author_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
