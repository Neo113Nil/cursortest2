<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="84dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/article_holder_background"
        android:layout_width="@dimen/catalog_article_background_image_list_width"
        android:layout_height="72dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="6dp"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/article_holder_toggle_fave"
        android:background="@drawable/highlight_circle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/catalog_fave_button_48dp"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="@+id/article_holder_background"
        app:layout_constraintTop_toTopOf="@+id/article_holder_background"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/article_holder_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:lineSpacingExtra="2sp"
        android:translationY="-1.05sp"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/article_holder_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/article_holder_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:ellipsize="end"
        android:id="@+id/article_holder_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:lineSpacingExtra="1sp"
        android:translationY="-0.65sp"
        android:fontFamily="@font/vk_roboto_regular"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/article_holder_text"
        app:layout_constraintEnd_toEndOf="@+id/article_holder_title"
        app:layout_constraintStart_toStartOf="@+id/article_holder_title"
        app:layout_constraintTop_toBottomOf="@+id/article_holder_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:ellipsize="end"
        android:id="@+id/article_holder_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:lineSpacingExtra="1sp"
        android:translationY="-0.65sp"
        android:fontFamily="@font/vk_roboto_regular"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/article_holder_title"
        app:layout_constraintStart_toStartOf="@+id/article_holder_title"
        app:layout_constraintTop_toBottomOf="@+id/article_holder_subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
