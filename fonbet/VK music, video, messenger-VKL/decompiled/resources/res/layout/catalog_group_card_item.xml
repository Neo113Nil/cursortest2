<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/catalog_bg_group_card_item"
    android:layout_width="206dp"
    android:layout_height="wrap_content"
    android:foreground="@drawable/catalog_fg_group_card_item">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/cover_image"
        android:layout_width="0dp"
        android:layout_height="82dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.catalog2.common.ui.holders.group.avatar.GroupAvatarViewContainer
        android:id="@+id/avatar_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="-32dp"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cover_image"
        app:originalAvatarPadding="4dp"
        app:originalAvatarSize="56dp"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_background_tertiary"
        app:roundingBorderPadding="1dp"
        app:roundingBorderWidth="2dp"
        app:solidFillAroundAvatarColor="?attr/vk_ui_background_tertiary"
        app:solidFillAroundAvatarEnabled="true"/>
    <ImageView
        android:id="@+id/icon_meta"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:scaleType="center"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:translationX="2dp"
        android:translationY="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/avatar_image"
        app:layout_constraintWidth="true"/>
    <FrameLayout
        android:id="@+id/subscribe_button_layout"
        android:background="@drawable/btn_white_10dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="-18dp"
        android:layout_marginEnd="12dp"
        android:elevation="4dp"
        android:backgroundTint="?attr/vk_legacy_background_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cover_image">
        <ImageButton
            android:id="@+id/subscribe_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/vk_icon_add_alt_20"
            android:hapticFeedbackEnabled="true"
            android:backgroundTint="?attr/vk_ui_background_contrast"
            style="@style/VkLegacyButton.White"/>
    </FrameLayout>
    <com.vk.core.view.text.SquareExcerptTextView
        android:textSize="17sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="none"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_sans_display_demibold"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        app:gradientColor="?attr/vk_ui_background_tertiary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cover_image"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/group_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
    <com.vk.core.view.PhotoStackView
        android:id="@+id/friends_photos"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/group_category"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/subscribers_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/friends_photos"
        app:layout_constraintTop_toBottomOf="@+id/group_category"
        app:layout_goneMarginStart="12dp"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
