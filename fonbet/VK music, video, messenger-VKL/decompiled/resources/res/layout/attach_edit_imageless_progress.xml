<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/attach_background"
    android:layout_width="96dp"
    android:layout_height="72dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/attach_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:id="@+id/attach_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:fontFamily="@string/font_family_medium"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:id="@+id/attach_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="@string/font_family_medium"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/attach_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/attach_error"
        android:background="#50000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginBottom="2dp"
        android:text="@string/error"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/attach_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8.5dp"
        android:layout_marginRight="-8.5dp"
        android:src="@drawable/vk_icon_deprecated_ic_deattach_28"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/vkim_accessibility_remove_attachment"/>
</RelativeLayout>
