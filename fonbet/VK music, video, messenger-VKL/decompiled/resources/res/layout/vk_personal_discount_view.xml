<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="360dp"
    android:paddingHorizontal="16dp">
    <com.vk.core.ui.themes.VKReplacerView
        android:id="@+id/personal_discount_user_avatar_view"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/personal_discount_title_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/personal_discount_badge_view"
        android:background="@drawable/vk_bg_round_oval"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-2dp"
        android:contentDescription="@null"
        android:layout_marginEnd="-2dp"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/personal_discount_user_avatar_view"
        app:layout_constraintEnd_toEndOf="@+id/personal_discount_user_avatar_view"
        app:srcCompat="@drawable/vk_icon_gift_circle_fill_yellow_20"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/personal_discount_title_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/personal_discount_banner_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/personal_discount_user_avatar_view"
        style="@style/VkUiTypography.Title2Medium"/>
    <com.vk.superapp.browser.internal.ui.banner.PersonalBannerView
        android:id="@+id/personal_discount_banner_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toTopOf="@+id/personal_discount_actual_time_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/personal_discount_title_view"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/personal_discount_actual_time_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/vk_apps_personal_discount_actual_time"
        app:layout_constraintBottom_toTopOf="@+id/personal_discount_time_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/personal_discount_banner_view"
        style="@style/VkUiTypography.Caption1CapsMedium"/>
    <com.vk.superapp.browser.internal.ui.time.StaticTimerView
        android:id="@+id/personal_discount_time_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/personal_discount_positive_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/personal_discount_actual_time_view"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/personal_discount_positive_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:text="@string/vk_apps_personal_discount_positive_action"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toTopOf="@+id/personal_discount_negative_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/personal_discount_time_view"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/personal_discount_negative_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="@string/vk_apps_personal_discount_negative_action"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toTopOf="@+id/personal_discount_rules_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/personal_discount_positive_view"/>
    <TextView
        android:textColorHighlight="@android:color/transparent"
        android:textColorLink="?attr/vk_ui_text_link"
        android:gravity="center"
        android:id="@+id/personal_discount_rules_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_apps_personal_discount_rules"
        app:layout_constraintBottom_toTopOf="@+id/personal_discount_bottom_space_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/personal_discount_negative_view"
        style="@style/VkUiTypography.Caption1"/>
    <Space
        android:id="@+id/personal_discount_bottom_space_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/personal_discount_progress_view"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/vk_personal_discount_progress_view"/>
    <ImageView
        android:id="@+id/personal_discount_error_icon"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@+id/personal_discount_error_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/vk_icon_pensive_face_56"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/personal_discount_error_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vk_apps_personal_discount_error_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/personal_discount_error_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/personal_discount_error_icon"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/personal_discount_error_action"
        android:paddingTop="7.5dp"
        android:paddingBottom="8.5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vk_apps_personal_discount_error_action"
        android:drawablePadding="10dp"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="12dp"
        app:drawableStartCompat="@drawable/vk_icon_refresh_outline_24"
        app:drawableTint="?attr/vk_ui_text_accent_themed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/personal_discount_error_title"
        style="@style/VkUiTypography.ParagraphMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
