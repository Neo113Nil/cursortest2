<?xml version="1.0" encoding="utf-8"?>
<com.vkontakte.android.ui.FullWidthLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="62dp"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <com.vk.core.view.VkRatingView
        android:id="@+id/attach_rating"
        android:layout_width="51dp"
        android:layout_height="10dp"
        android:layout_marginEnd="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="14dp"
        android:layout_weight="1"
        android:layout_marginEnd="12dp">
        <TextView
            android:textColor="?attr/vk_legacy_text_muted"
            android:ellipsize="end"
            android:id="@+id/attach_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:maxLines="2"
            android:fontFamily="@font/vk_roboto_medium"
            style="@style/VkLegacyTypography.Text"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_secondary"
            android:gravity="center_vertical"
            android:id="@+id/attach_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="8dp"
            style="@style/VkLegacyTypography.Subhead1"/>
    </LinearLayout>
    <com.vk.core.view.AdsButton
        android:textSize="14sp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/attach_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:maxLines="1"
        style="@style/outline_button"/>
</com.vkontakte.android.ui.FullWidthLinearLayout>
