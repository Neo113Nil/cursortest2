<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_left_button"
        android:background="@drawable/photo_flow_button_skeleton_background"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/photos_root_page_header_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_left_button_text"
        android:background="@drawable/photo_flow_skeleton_rounded_background_4dp"
        android:layout_width="212dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_left_button"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_right_button"
        android:background="@drawable/photo_flow_button_skeleton_background"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/photos_root_page_header_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
