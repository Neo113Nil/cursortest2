<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight_post"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">
            <com.vk.music.view.ThumbsImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/audio_image"
                android:layout_width="@dimen/music_track_image"
                android:layout_height="@dimen/music_track_image"
                app:roundedCornerRadius="@dimen/music_image_rounding_corners"
                app:tiv_background_image="?attr/vk_ui_image_placeholder"
                app:tiv_border_width="0.5dp"
                app:tiv_empty_resource="@drawable/vk_icon_song_outline_28"
                app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
            <ImageView
                android:id="@+id/audio_playing_indicator"
                android:background="@drawable/music_dark_round_rect"
                android:visibility="gone"
                android:layout_width="@dimen/music_track_image"
                android:layout_height="@dimen/music_track_image"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="13dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.Headline1Normal"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/audio_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:id="@+id/audio_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"/>
        </LinearLayout>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/audio_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="2dp"
            android:textAlignment="viewStart"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</FrameLayout>
