<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/vk_black_alpha60"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.stickers.views.animation.VKAnimationView
            android:layout_gravity="center"
            android:id="@+id/swipe_tooltip_animated"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginTop="-40dp"
            android:layout_marginBottom="-80dp"
            android:scaleType="fitCenter"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.TextMedium"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/swipe_tooltip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="36dp"
            android:text="@string/live_swipe_tooltip"
            android:elevation="@dimen/vk_ui_elevation_two"/>
    </LinearLayout>
</FrameLayout>
