<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_community_service_rectangle_rounded_bottom_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="24dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/image"
        android:layout_width="112dp"
        android:layout_height="112dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="24dp"
        android:text="@string/community_check_list_header_title"
        android:layout_marginHorizontal="32dp"
        style="@style/VkUiTypography.Title2Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:text="@string/community_check_list_header_description"
        android:layout_marginHorizontal="32dp"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.ecomm.design.view.DiscreteProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="24.5dp"
        app:activeDotColor="?attr/vk_ui_text_accent"
        app:cumulativeDots="true"
        app:dotCornerRadius="4dp"
        app:dotHeight="3dp"
        app:dotSpacing="4dp"
        app:dotWidth="22.25dp"
        app:inactiveDotColor="?attr/vk_ui_track_background"
        app:layout_constraintEnd_toStartOf="@+id/image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_title"
        app:max="12"
        app:progress="3"
        style="?android:attr/progressBarStyleHorizontal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/progress_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="16dp"
        android:layout_marginHorizontal="32dp"
        style="@style/VkUiTypography.SubheadNormal"/>
</LinearLayout>
