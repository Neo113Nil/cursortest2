<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="14dp">
        <ImageView
            android:id="@+id/close_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_cancel_28"
            android:contentDescription="@string/voip_close"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voip_share_QR_code_title"
            android:layout_marginStart="12dp"
            style="@style/VkUiTypography.DisplayTitle2"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxWidth="256dp"
        android:layout_marginHorizontal="70dp">
        <ImageView
            android:id="@+id/qr_code"
            android:background="@drawable/voip_bg_corner20"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:contentDescription="@string/voip_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ProgressBar
            android:id="@+id/qr_code_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/share_QR_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp"
        style="@style/VkLegacyButton.Primary.Big">
        <ImageView
            android:id="@+id/share_QR_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_share_outline_24"
            android:importantForAccessibility="no"
            app:tint="?attr/vk_ui_icon_contrast_themed"/>
        <TextView
            android:textColor="?attr/vk_ui_text_contrast_themed"
            android:gravity="center"
            android:id="@+id/share_QR_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voip_share_QR_code_share"
            android:layout_marginStart="8dp"
            style="@style/VkLegacyTypography.Headline.Regular"/>
        <ProgressBar
            android:id="@+id/share_QR_progress_bar"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="?attr/vk_ui_icon_contrast_themed"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
</LinearLayout>
