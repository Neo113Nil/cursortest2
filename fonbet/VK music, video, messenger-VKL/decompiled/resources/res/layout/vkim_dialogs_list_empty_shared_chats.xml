<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.im.ui.views.EmptyViewForList
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7.5dp"
        app:icon_size="@dimen/vkim_list_empty_icon_size"
        app:layout_constraintBottom_toTopOf="@+id/im_invite_to_chat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:text="@string/vkim_dialogs_list_empty_shared_chats"
        app:text_color="?attr/vk_legacy_text_placeholder"
        app:text_size="16sp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/vk_legacy_accent"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/im_invite_to_chat"
        android:background="@drawable/vkim_ripple_dark"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vkim_invite_to_chat"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2sp"
        android:fontFamily="@string/font_family_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty"/>
</androidx.constraintlayout.widget.ConstraintLayout>
