<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageButton
        android:id="@+id/ll_back"
        android:background="@drawable/picker_btn_actionbar_gradient"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/accessibility_back"
        app:srcCompat="@drawable/vk_icon_arrow_left_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <FrameLayout
        android:layout_width="0px"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/PickerGradientActionBarTitleStyle"/>
        <FrameLayout
            android:id="@+id/fl_video_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp">
            <com.vk.attachpicker.widget.VkSeekBar
                android:layout_gravity="center"
                android:id="@+id/vsb_video_progress"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption1"
                android:textColor="?attr/vk_ui_text_secondary"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_current_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption1"
                android:textColor="?attr/vk_ui_text_secondary"
                android:layout_gravity="center"
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"/>
        </FrameLayout>
    </FrameLayout>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/button_check"
        android:background="@drawable/picker_btn_actionbar_gradient"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:src="@drawable/picker_bg_gallery_check"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
</merge>
