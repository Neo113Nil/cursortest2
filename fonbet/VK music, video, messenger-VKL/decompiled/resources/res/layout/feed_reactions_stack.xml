<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/reactions_stack_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.feed.design.view.newsfeed.reactionstack.FeedMiniReactionsStack
        android:gravity="start|center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/reactions_stack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="start|center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/reactions_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"/>
</LinearLayout>
