<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/vkl_product_preview"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:layout_marginVertical="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
        android:textColor="@color/vk_white"
        android:id="@+id/vkl_product_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/vkl_product_preview"
        app:layout_constraintTop_toTopOf="@+id/vkl_product_preview"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/vkl_product_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/vkl_product_preview"
        app:layout_constraintEnd_toStartOf="@+id/vkl_product_close"
        app:layout_constraintStart_toStartOf="@+id/vkl_product_price"
        app:layout_constraintTop_toBottomOf="@+id/vkl_product_price"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/vkl_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="vkl_product_title,vkl_product_price"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/vkl_product_close"
        android:background="@drawable/ripple_8dp"
        android:padding="12dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/cancel"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vkl_barrier"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_16"
        app:tint="@color/vk_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
