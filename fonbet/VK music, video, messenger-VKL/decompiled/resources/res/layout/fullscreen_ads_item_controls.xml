<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/fullscreen_ads_error_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/fullscreen_ads_play_pause_button_stub"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"/>
    <include
        android:visibility="gone"
        layout="@layout/fullscreen_ads_main_overlay"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/fullscreen_clip_restriction"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:visibility="gone"
        layout="@layout/fullscreen_ads_item_end_overlay"/>
    <View
        android:id="@+id/fullscreen_ads_unfocused_blackout"
        android:background="@color/clip_unfocused_blackout_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
