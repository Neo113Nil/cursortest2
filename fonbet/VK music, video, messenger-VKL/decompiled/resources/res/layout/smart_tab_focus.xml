<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/circle_white_54"
    android:layout_width="54dp"
    android:layout_height="54dp"
    android:elevation="4dp">
    <View
        android:id="@+id/tab_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:backgroundTint="@color/vk_tip_background"/>
    <com.vk.feed.tool.view.newsfeed.tab.WrapContentAutoSizingTextView
        android:textColor="@color/vk_tip_background"
        android:gravity="center"
        android:id="@+id/tab_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="41dp"
        android:minHeight="8dp"
        android:maxLines="1"
        android:textAlignment="gravity"
        app:autoSizeMaxTextSize="8sp"
        app:autoSizeMinTextSize="4sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"/>
</LinearLayout>
