<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_write_restriction_loading_skeleton_circle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="18dp"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_write_restriction_loading_skeleton"
                android:layout_width="182dp"
                android:layout_height="16dp"
                android:layout_marginStart="64dp"/>
        </FrameLayout>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/im_write_restriction_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@null"
        android:layout_marginStart="18dp"
        app:tint="?attr/vk_ui_background_accent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/im_write_restriction_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="18dp"
        style="@style/VkUiTypography.HeadlineNormal"/>
</LinearLayout>
