<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabletRecommendationsContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.lists.RecyclerPaginatedView
        android:id="@+id/tabletRecommendationsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.video.ui.discovery.minimizable.playlist.collapsed.views.VideoTabletRelatedVideosCollapsedContainerView
        android:layout_gravity="bottom"
        android:id="@+id/tabletCollapsedPlaylistContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="8dp"/>
    <com.vk.video.ui.discovery.minimizable.doc2doc.onboarding.D2DOnboardingView
        android:id="@+id/catalogTabletTabsOnboarding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationY="@dimen/video_discovery_catalog_tabs_height"/>
    <com.vk.core.view.components.subnavigation.VkSubnavigationBar
        android:id="@+id/catalogTabletTabs"
        android:background="@color/vk_gray_1000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_discovery_catalog_tabs_height"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="8dp"
        android:paddingHorizontal="0dp"
        app:subnavigationBarAppearance="accent"/>
</FrameLayout>
