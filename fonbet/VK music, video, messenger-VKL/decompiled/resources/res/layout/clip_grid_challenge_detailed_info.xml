<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="68dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/clip_grid_challenge_detailed_info_descr_separator"
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.cell.VkMiniInfoCell
            android:id="@+id/clip_grid_challenge_detailed_info"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clip_grid_challenge_detailed_info_descr_separator"/>
        <com.vk.core.view.components.group.header.VkGroupHeader
            android:id="@+id/clip_grid_challenge_detailed_info_rules_header"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="yes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clip_grid_challenge_detailed_info"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/clip_grid_challenge_detailed_info_rules_rv"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clip_grid_challenge_detailed_info_rules_header"/>
        <com.vk.core.view.components.group.header.VkGroupHeader
            android:id="@+id/clip_grid_challenge_detailed_info_terms"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="yes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clip_grid_challenge_detailed_info_rules_rv"/>
        <include
            android:id="@+id/clip_grid_challenge_detailed_info_terms_link"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clip_grid_challenge_detailed_info_terms"
            layout="@layout/clip_grid_challenge_detailed_info_terms_link_view"/>
        <View
            android:id="@+id/clip_grid_challenge_detailed_info_disclaimer_separator"
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clip_grid_challenge_detailed_info_terms_link"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Caption1"
            android:textColor="?attr/vk_ui_text_subhead"
            android:id="@+id/clip_grid_challenge_detailed_info_disclaimer_text"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clip_grid_challenge_detailed_info_disclaimer_separator"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
