<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/EditorThemeDark"
    android:orientation="vertical"
    android:paddingTop="@dimen/paddingXXS"
    android:paddingBottom="@dimen/paddingXS"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btnShadows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_shadows"
            style="?attr/editorTabButtonStyle"/>
        <Button
            android:id="@+id/btnLights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_lights"
            style="?attr/editorTabButtonStyle"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/toneSeekbarWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:animateLayoutChanges="true">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvToneColorTitle"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginLeft="@dimen/paddingXS"
            android:minEms="2"
            android:drawablePadding="4dp"
            android:textAlignment="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/editorTextCaption1Style"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvToneSeekbarValue"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text="0.0"
            android:minEms="2"
            android:drawablePadding="4dp"
            android:textAlignment="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/editorTextCaption1Style"/>
        <com.vk.photo.editor.views.DashedSeekBar
            android:id="@+id/toneSeekbar"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:contentDescription="@string/editor_hue"
            android:importantForAccessibility="yes"
            app:editorDashedSeekbarDefaultValue="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvToneSeekbarValue"
            style="?attr/editorDashedSeekbarStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center"
            android:id="@+id/rvColors"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="40dp"/>
    </LinearLayout>
</LinearLayout>
