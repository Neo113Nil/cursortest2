<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shimmer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="8dp">
        <View
            android:background="@drawable/vk_bg_round_oval"
            android:layout_width="96dp"
            android:layout_height="96dp"/>
        <View
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="96dp"
            android:layout_height="18dp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
</com.vk.core.view.shimmer.ShimmerFrameLayout>
