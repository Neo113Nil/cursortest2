<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_legacy_background_content"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionName="checkoutTransition">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/status_view_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="142dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/status_view_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/vk_icon_check_circle_outline_56"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/status_view_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/status_view_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_view_icon"
        style="@style/VkLegacyTypography.Title2.Medium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:gravity="center"
        android:id="@+id/status_view_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/status_view_action_tertiary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_view_title"
        app:layout_goneMarginBottom="186dp"
        style="@style/VkLegacyTypography.Headline.Regular.NoEllipsize"/>
    <TextView
        android:id="@+id/status_view_action_tertiary"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="74dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/status_view_action_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_view_subtitle"
        app:layout_constraintVertical_bias="0"
        style="@style/VkLegacyButton.Tertiary"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/status_view_action_primary"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_view_action_tertiary"
        style="@style/VkLegacyButton.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
