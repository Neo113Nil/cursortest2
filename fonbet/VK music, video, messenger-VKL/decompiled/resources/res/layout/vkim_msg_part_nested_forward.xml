<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_rounded_8"
    android:padding="@dimen/nested_forward_content_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.ImAvatarView
        android:id="@+id/vkim_forward_author_icon"
        android:layout_width="@dimen/nested_forward_author_icon_size"
        android:layout_height="@dimen/nested_forward_author_icon_size"
        app:borderWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkIm.AvatarView"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/vkim_forward_author_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/nested_forward_author_name_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vkim_forward_author_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <TextView
        android:id="@+id/vkim_forward_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/vkim_forward_author_name"
        app:layout_constraintTop_toBottomOf="@+id/vkim_forward_author_icon"
        style="@style/VkUiTypography.SubheadNormal"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/vkim_forward_show_more_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="vkim_forward_show_more_authors_stack,vkim_forward_show_more_text"/>
    <com.vk.im.ui.views.avatars.StackAvatarView
        android:layout_gravity="center"
        android:id="@+id/vkim_forward_show_more_authors_stack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@+id/vkim_forward_author_icon"
        app:layout_constraintTop_toBottomOf="@+id/vkim_forward_content"
        app:vkim_iconOffset="-4dp"
        app:vkim_iconSize="@dimen/nested_forward_other_authors_icon_size"
        app:vkim_strokeColor="@android:color/transparent"
        app:vkim_strokeWidth="1dp"/>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_forward_show_more_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/nested_forward_show_more_text_padding_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vkim_forward_show_more_authors_stack"
        app:layout_constraintTop_toTopOf="@+id/vkim_forward_show_more_authors_stack"
        style="@style/VkUiTypography.FootnoteMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
