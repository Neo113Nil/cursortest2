<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.video.ui.discovery.minimizable.player.views.VideoViewContainer
        android:id="@+id/videoViewContainer"
        android:background="@color/vk_black"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.libvideo.design.view.toolbar.VideoToolbarView
        android:id="@+id/toolbar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.libvideo.design.view.fullscreen.VideoTopBarView
        android:id="@+id/top_controls"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/titleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="1dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitleView"
        app:layout_constraintEnd_toStartOf="@+id/playView"
        app:layout_constraintStart_toEndOf="@+id/videoViewContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="8dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/miniPlayerProgressView"
        app:layout_constraintEnd_toStartOf="@+id/playView"
        app:layout_constraintStart_toEndOf="@+id/videoViewContainer"
        app:layout_constraintTop_toBottomOf="@+id/titleView"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/adTitleView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/video_ad_title"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toTopOf="@+id/miniPlayerProgressView"
        app:layout_constraintEnd_toStartOf="@+id/playView"
        app:layout_constraintStart_toEndOf="@+id/videoViewContainer"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/playView"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:src="@drawable/vk_icon_play_24"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toTopOf="@+id/miniPlayerProgressView"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/closeView"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/videoViewContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="42dp"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <com.vk.core.ui.CircularProgressView
        android:id="@+id/loadingView"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:cpv_animAutostart="true"
        app:cpv_color="?attr/vk_ui_icon_secondary"
        app:cpv_indeterminate="true"
        app:cpv_thickness="1.8dp"
        app:layout_constraintBottom_toTopOf="@+id/miniPlayerProgressView"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/closeView"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/videoViewContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="24dp"/>
    <com.vk.core.ui.CircularProgressView
        android:id="@+id/circularProgressView"
        android:visibility="gone"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="1dp"
        app:cpv_animAutostart="false"
        app:cpv_animSwoopDuration="1"
        app:cpv_color="?attr/vk_ui_icon_secondary"
        app:cpv_indeterminate="false"
        app:cpv_maxProgress="0"
        app:cpv_progress="0"
        app:cpv_startAngle="-90"
        app:cpv_thickness="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/playView"
        app:layout_constraintEnd_toEndOf="@+id/playView"
        app:layout_constraintStart_toStartOf="@+id/playView"
        app:layout_constraintTop_toTopOf="@+id/playView"/>
    <ImageButton
        android:id="@+id/closeView"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:src="@drawable/vk_icon_cancel_24"
        android:contentDescription="@string/video_accessibility_close"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toTopOf="@+id/miniPlayerProgressView"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/videoViewContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="42dp"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <com.vk.libvideo.design.view.panel.VideoBottomPanelView
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.vk.libvideo.design.view.fullscreen.VideoFullscreenBottomBarView
        android:id="@+id/fullscreen_bottom_controls"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ProgressBar
        android:id="@+id/miniPlayerProgressView"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:importantForAccessibility="noHideDescendants"
        android:indeterminateTint="@color/vk_blue_200"
        android:indeterminateTintMode="src_in"
        app:layout_constraintBottom_toBottomOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
    <View
        android:id="@+id/miniPlayerView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/videoAnnounceBackground"
        android:background="@color/vk_black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/subscriptionProposal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
