<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:enabled="false"
        android:textSize="15sp"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:id="@+id/send_button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="@string/send"
        style="@style/primary_button"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@drawable/vk_selector_text_color_blue_disable"
        android:id="@+id/skip_button"
        android:background="@drawable/highlight_radius_4"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/voip_call_quality_assessment_skip_button"
        android:lineSpacingExtra="5sp"
        android:fontFamily="@string/font_family_medium"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</LinearLayout>
