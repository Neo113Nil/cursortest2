<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_selected"
        android:background="@drawable/bg_story_background_editor_selected"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/cv_container"
        android:background="@drawable/bg_text_color_item"
        android:layout_width="@dimen/story_color_text_items_height"
        android:layout_height="@dimen/story_color_text_items_height"
        android:layout_margin="@dimen/story_background_editor_items_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/pipette"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_color_picker_outline_16"
            app:tint="@color/vk_white"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/preview_dot"
            android:background="@drawable/bg_white_circle"
            android:layout_width="8dp"
            android:layout_height="8dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
