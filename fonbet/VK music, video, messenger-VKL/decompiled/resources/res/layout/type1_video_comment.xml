<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_container"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/post_side_padding"
    android:paddingVertical="10dp">
    <com.vk.newsfeed.common.recycler.holders.comments.avatar.CommentSmallAvatarView
        android:id="@+id/poster_photo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <View
        android:id="@+id/author_badge"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:translationX="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/poster_photo"
        app:layout_constraintEnd_toEndOf="@+id/poster_photo"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/poster_name_view"
        android:paddingBottom="1dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_photo"
        app:layout_constraintTop_toTopOf="@+id/poster_photo">
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:layout_gravity="top"
            android:id="@+id/poster_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:vk_layout_isFluid="true"
            style="@style/VkUiTypography.Footnote"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="start|center_vertical"
            android:id="@+id/status"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            app:actualImageScaleType="centerInside"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/icon1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"/>
        <ImageView
            android:id="@+id/icon2"
            android:paddingTop="4.75dp"
            android:paddingBottom="4dp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:paddingStart="1.25dp"
            android:paddingEnd="5.25dp"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:layout_gravity="top"
            android:id="@+id/comment_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/VkUiTypography.Footnote"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="top"
            android:id="@+id/post_info_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/poster_name_view"
            style="@style/VkUiTypography.Footnote"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="top"
            android:id="@+id/pinned_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/newsfeed_dot"
            android:singleLine="true"
            style="@style/VkUiTypography.Footnote"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/pinned_badge"
            android:background="@drawable/vk_icon_pin_16"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:backgroundTint="?attr/vk_ui_text_secondary"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <FrameLayout
        android:id="@+id/post_view"
        android:paddingBottom="1dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/poster_name_view"
        app:layout_constraintTop_toBottomOf="@+id/poster_name_view">
        <com.vk.core.view.links.LinkedTextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            style="@style/VkUiTypography.Subhead"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/post_attach_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:divider="@drawable/comments_attach_divider"
        android:layout_below="@+id/post_view"
        android:showDividers="middle"
        app:layout_constraintEnd_toEndOf="@+id/post_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/poster_name_view"
        app:layout_constraintTop_toBottomOf="@+id/post_view"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:layout_gravity="start"
        android:id="@+id/comment_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/reply_to"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/poster_name_view"
        app:layout_constraintTop_toBottomOf="@+id/post_attach_container"
        style="@style/VkUiTypography.SubheadMedium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent"
        android:ellipsize="end"
        android:layout_gravity="start"
        android:id="@+id/count_answer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/reply_to"
        android:maxLines="1"
        android:paddingVertical="5dp"
        app:layout_constraintStart_toStartOf="@+id/poster_name_view"
        app:layout_constraintTop_toBottomOf="@+id/comment_reply"
        style="@style/VkUiTypography.SubheadMedium"/>
    <TextView
        android:id="@+id/post_likes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:drawablePadding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/comment_reply"
        style="@style/VkUiTypography.FootnoteMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
