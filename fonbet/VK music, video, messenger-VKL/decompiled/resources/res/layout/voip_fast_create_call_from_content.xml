<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/voip_change_name_toolbar_close"
        android:background="@drawable/vk_highlight_unlimited"
        android:padding="10dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/voip_change_name_toolbar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_call_from"
        android:maxLines="1"
        android:fontFamily="@font/vk_sans_display_demibold"
        android:layout_marginStart="56dp"
        app:layout_constraintBottom_toBottomOf="@+id/voip_change_name_toolbar_close"
        app:layout_constraintStart_toStartOf="@+id/voip_change_name_toolbar_close"
        app:layout_constraintTop_toTopOf="@+id/voip_change_name_toolbar_close"
        style="@style/VkLegacyTypography.Title1"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/voip_change_name_toolbar_close"/>
    <com.vk.core.view.search.RoundedSearchView
        android:id="@+id/voip_search_group"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_call_from_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/voip_call_from_list"
        android:paddingTop="12dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/voip_call_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_search_group"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:id="@+id/voip_call_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/voip_call_by_link_start_call"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkLegacyButton.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
