<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_user_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_user_container_inner"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/vk_gray_500"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:singleLine="true"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_drawing_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_user_container">
        <include
            android:layout_gravity="top"
            android:id="@+id/drawing_top_panel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/graffiti_drawing_top_panel_height"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/fragment_graffiti_drawing_top_panel"/>
        <com.vk.photo.editor.markup.view.DrawingView
            android:id="@+id/drawing_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/drawing_bottom_panel"
            app:layout_constraintTop_toBottomOf="@+id/drawing_top_panel"/>
        <View
            android:background="?attr/vk_ui_separator_primary3x"
            android:layout_width="match_parent"
            android:layout_height="0.33dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/drawing_top_panel"/>
        <View
            android:background="?attr/vk_ui_separator_primary3x"
            android:layout_width="match_parent"
            android:layout_height="0.33dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toTopOf="@+id/drawing_bottom_panel"/>
        <com.vk.photo.editor.markup.view.tools.SizeCircleView
            android:id="@+id/brush_size_circle_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/drawing_view"
            app:layout_constraintEnd_toEndOf="@+id/drawing_view"
            app:layout_constraintStart_toStartOf="@+id/drawing_view"
            app:layout_constraintTop_toTopOf="@+id/drawing_view"
            app:maxAbsoluteSize="50dp"
            app:minAbsoluteSize="3dp"/>
        <include
            android:layout_gravity="bottom"
            android:id="@+id/drawing_bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/graffiti_drawing_bottom_panel_height"
            app:layout_constraintBottom_toBottomOf="parent"
            layout="@layout/fragment_graffiti_drawing_bottom_panel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.photo.editor.markup.view.tools.SizeSeekBarView
        android:id="@+id/brush_size_seek_bar"
        android:layout_width="wrap_content"
        android:layout_height="216dp"
        android:contentDescription="@string/text_size_seekbar_description_accessibility_description"
        app:anchor="end"
        app:barMaxWidth="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:seekProgress="0.2"
        app:thumbRadius="12dp"/>
    <com.vk.photo.editor.markup.view.tools.PipetteView
        android:id="@+id/pipette_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
</androidx.constraintlayout.widget.ConstraintLayout>
