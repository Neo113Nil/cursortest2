<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/sharing_send_redesign_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/sharing_redesign_create_chat_button"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:text="@string/sharing_create_chat_button_label"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="large"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/sharing_redesign_send_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:text="@string/sharing_send_button_label"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </LinearLayout>
    <com.vk.core.view.components.spinner.VkSpinner
        android:layout_gravity="center"
        android:id="@+id/sending_loader"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="12dp"
        android:indeterminateTint="?attr/vk_ui_icon_accent"
        android:indeterminateTintMode="src_in"
        app:spinnerSize="large"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center"
        android:id="@+id/sending_success_lottie"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="12dp"
        app:lottie_autoPlay="false"
        app:lottie_fileName="check_circle_outline_56.json"
        app:lottie_loop="false"/>
</FrameLayout>
