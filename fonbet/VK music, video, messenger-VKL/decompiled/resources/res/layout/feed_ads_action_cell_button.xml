<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/action_cell_shine"
        android:background="@drawable/feed_shine_drawable"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/action_cell_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/action_cell_start_icon"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/action_cell_label_margin_default"
        android:layout_marginVertical="@dimen/action_cell_label_margin_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_cell_label"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/action_cell_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/action_cell_label_margin_with_left_icon"
        android:layout_marginEnd="@dimen/action_cell_label_margin_with_right_icon"
        android:layout_marginVertical="@dimen/action_cell_label_margin_default"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_cell_label_trailing_icon"
        app:layout_constraintStart_toEndOf="@+id/action_cell_start_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/action_cell_label_margin_default"
        app:layout_goneMarginStart="@dimen/action_cell_label_margin_default"
        style="@style/VkUiTypography.Paragraph"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/action_cell_label_trailing_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/action_cell_label_margin_with_right_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_cell_end_button"
        app:layout_constraintStart_toEndOf="@+id/action_cell_label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/action_cell_label_margin_default"
        app:layout_goneMarginStart="@dimen/action_cell_label_margin_default"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/action_cell_end_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/action_cell_label_margin_with_right_button"
        android:layout_marginVertical="@dimen/action_cell_label_margin_default"
        app:buttonAppearance="overlay"
        app:buttonBackgroundCornerRadius="@dimen/vk_ui_border_radius"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_cell_end_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/action_cell_label_margin_default"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/action_cell_end_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/action_cell_label_margin_default"
        android:layout_marginVertical="@dimen/action_cell_label_margin_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"/>
    <View
        android:id="@+id/action_cell_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/action_cell_separator_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
