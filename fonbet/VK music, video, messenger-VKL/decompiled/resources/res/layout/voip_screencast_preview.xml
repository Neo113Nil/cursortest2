<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/screencast_preview_border"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_screencast_border_32"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.im.ui.views.avatars.AvatarView
        android:id="@+id/screencast_preview_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="@+id/screencast_preview_border"
        app:layout_constraintTop_toTopOf="@+id/screencast_preview_border"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/screencast_preview_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/voip_participants_see_your_screen"
        android:lines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/screencast_preview_audio_share"
        app:layout_constraintStart_toEndOf="@+id/screencast_preview_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VoipRunningTaskLabel.Title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/screencast_preview_audio_share"
        android:background="?attr/actionBarItemBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_sound_wave_outline_28"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/screencast_preview_stop"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/screencast_preview_stop"
        android:background="?attr/actionBarItemBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_cancel_outline_28"
        android:contentDescription="@string/actions_title_screen_demonstration_stop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_contrast"/>
</androidx.constraintlayout.widget.ConstraintLayout>
