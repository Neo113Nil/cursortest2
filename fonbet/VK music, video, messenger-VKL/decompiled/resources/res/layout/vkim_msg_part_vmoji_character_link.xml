<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.widget.AutoAdjustLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.fresco.FrescoImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxWidth="242dp"
        android:maxHeight="180dp"
        android:minWidth="180dp"
        android:minHeight="180dp"
        app:vk_layout_isAdjust="true"
        app:vkim_scaleType="fit_center"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:lines="1"
        android:fontFamily="@font/vk_roboto_medium"/>
    <com.vk.im.ui.views.span.SpanPressableTextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/vk_roboto_regular"/>
    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="4dp"
        android:text="@string/vkim_msg_list_vmoji_button"
        style="@style/VkLegacyButton.Outline.Small"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextSimple"
        android:layout_gravity="bottom|right"
        android:id="@+id/timeAndStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:layout_marginRight="8dp"
        android:importantForAccessibility="no"/>
</com.vk.core.widget.AutoAdjustLinearLayout>
