<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/first_image"
        android:layout_width="@dimen/photo_tags_preview_size"
        android:layout_height="@dimen/photo_tags_preview_size"/>
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/second_container"
        android:background="@drawable/photos_tags_preview_background"
        android:padding="2.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="17.5dp">
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="center"
            android:id="@+id/second_image"
            android:layout_width="@dimen/photo_tags_preview_size"
            android:layout_height="@dimen/photo_tags_preview_size"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/third_container"
        android:background="@drawable/photos_tags_preview_background"
        android:padding="2.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="37.5dp">
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="center"
            android:id="@+id/third_image"
            android:layout_width="@dimen/photo_tags_preview_size"
            android:layout_height="@dimen/photo_tags_preview_size"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadSemiBold"
            android:textColor="?attr/vk_ui_text_contrast_themed"
            android:layout_gravity="center"
            android:id="@+id/more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxLength="3"
            android:translationY="-0.65sp"
            android:textAlignment="center"/>
    </FrameLayout>
</merge>
