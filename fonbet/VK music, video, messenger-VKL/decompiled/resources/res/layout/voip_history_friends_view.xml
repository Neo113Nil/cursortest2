<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.lists.CustomSwipeRefreshLayout
        android:id="@+id/voip_history_friends_recycler_swipe_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_history_friends_new_call_by_link_button_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/voip_history_friends_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.vk.lists.CustomSwipeRefreshLayout>
    <FrameLayout
        android:id="@+id/voip_history_friends_loading_state_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_history_friends_new_call_by_link_button_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/voip_history_friends_loading_state_progress"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminateTint="?attr/vk_ui_icon_tertiary"
            android:indeterminateTintMode="src_in"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/voip_history_friends_error_state_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/voip_history_friends_new_call_by_link_button_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/voip_history_friends_error_state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="2"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            style="@style/VkLegacyTypography.Headline.Regular"/>
        <TextView
            android:textColor="?attr/vk_ui_text_accent_themed"
            android:id="@+id/voip_history_friends_error_state_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry"
            style="@style/VkLegacyButton.Tertiary.Rounded"/>
    </LinearLayout>
    <View
        android:id="@+id/voip_history_friends_new_call_by_link_button_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="0dp"
        android:layout_height="0.3dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_history_friends_new_call_by_link_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/voip_history_friends_new_call_by_link_button"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkLegacyButton.Primary.Big"/>
</androidx.constraintlayout.widget.ConstraintLayout>
