<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlist_header_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_collapseMode="parallax">
    <ImageView
        android:id="@+id/cover_overlay"
        android:background="@drawable/cover_scrim"
        android:paddingTop="@dimen/video_catalog_playlist_cover_padding_top"
        android:paddingBottom="@dimen/video_catalog_playlist_cover_padding_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/empty_playlist_cover"
        app:layout_constraintBottom_toBottomOf="@+id/video_playlist_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/video_playlist_cover"/>
    <com.vk.imageloader.view.VkImageViewTopCrop
        android:id="@+id/video_playlist_cover"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_catalog_playlist_cover_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/left_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/vk_video_profile_v2_toolbar_buttons_margin"/>
    <com.vk.core.view.components.button.VkButton
        android:gravity="center"
        android:id="@+id/watch_button"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="8dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="@+id/video_playlist_cover"
        app:layout_constraintEnd_toStartOf="@+id/watch_with_shuffle_button"
        app:layout_constraintStart_toStartOf="@+id/left_guideline"/>
    <com.vk.core.view.components.button.VkButton
        android:gravity="center"
        android:id="@+id/watch_with_shuffle_button"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginEnd="8dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_shuffle_24"
        app:layout_constraintBottom_toBottomOf="@+id/video_playlist_cover"
        app:layout_constraintEnd_toStartOf="@+id/subscribe_button"
        app:layout_constraintWidth_percent="0.16"/>
    <com.vk.core.view.components.button.VkButton
        android:gravity="center"
        android:id="@+id/subscribe_button"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_add_square_outline_24"
        app:layout_constraintBottom_toBottomOf="@+id/video_playlist_cover"
        app:layout_constraintEnd_toEndOf="@+id/right_guideline"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/right_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/vk_video_profile_v2_toolbar_buttons_margin"/>
</androidx.constraintlayout.widget.ConstraintLayout>
