<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp">
    <View
        android:id="@+id/gradient_bg"
        android:background="@drawable/bg_edu_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/vk_white"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vkim_edu_bar_title"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:letterSpacing="0.1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_bg"
        app:layout_constraintLeft_toLeftOf="@+id/gradient_bg"
        app:layout_constraintRight_toLeftOf="@+id/chevron"
        app:layout_constraintTop_toTopOf="@+id/gradient_bg"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/chevron"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:tint="@color/vk_white"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/gradient_bg"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toRightOf="@+id/title"
        app:layout_constraintRight_toRightOf="@+id/gradient_bg"
        app:layout_constraintTop_toTopOf="@+id/gradient_bg"
        app:placeholderImage="@drawable/vk_icon_chevron_right_24"/>
</androidx.constraintlayout.widget.ConstraintLayout>
