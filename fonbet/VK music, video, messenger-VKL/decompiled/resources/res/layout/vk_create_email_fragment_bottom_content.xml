<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/vk_create_email_fragment_ads_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="20dp">
        <CheckBox
            android:theme="@style/VkCheckBoxTheme"
            android:id="@+id/vk_create_email_fragment_ads_checkbox"
            android:layout_width="32dp"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_auth_create_email_ads"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1sp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <com.vk.auth.ui.VkLoadingButton
        android:textSize="16sp"
        android:id="@+id/continue_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/vk_auth_create_email_create"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/VkLegacyButton.Primary"/>
</LinearLayout>
