<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/videoLiveContent"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/previewModeSubTitle"
        android:background="?attr/vk_ui_header_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp">
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_live_preview_mode_sub_title"
            android:layout_marginStart="16dp"
            style="@style/VkUiTypography.ParagraphNormal"/>
    </FrameLayout>
    <include
        android:id="@+id/infoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/video_live_about_stream"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="16dp">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/chatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vk_live_chat"
            android:layout_weight="1"
            style="@style/VkUiTypography.DisplayTitle3"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/chatMessagePin"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/video_live_pin"/>
    </LinearLayout>
    <View
        android:id="@+id/chatDivider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"/>
    <FrameLayout
        android:id="@+id/chatContainer"
        android:background="@color/vk_gray_1000"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/chatDisabledTitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_live_chat_disabled"
            android:drawablePadding="6dp"
            app:drawableStartCompat="@drawable/vk_icon_message_cross_outline_20"
            app:drawableTint="?attr/vk_ui_icon_secondary"
            style="@style/VkUiTypography.Caption1Medium"/>
    </FrameLayout>
</LinearLayout>
