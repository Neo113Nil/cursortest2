<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voip_waiting_room_notification_root"
    android:background="@drawable/voip_waiting_room_notification_bg"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:elevation="8dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/vk_gray_100"
        android:id="@+id/voip_waiting_room_notification_action_hide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyButton.Tertiary"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/vk_gray_100"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/voip_waiting_room_notification_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:drawablePadding="16dp"
        android:drawableStart="@drawable/vk_icon_door_arrow_left_outline_28"
        android:layout_marginEnd="12dp"
        android:drawableTint="@color/vk_sky_300"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voip_waiting_room_notification_action_hide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
