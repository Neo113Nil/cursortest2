<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.clips.design.view.timeline.TimelineView
        android:id="@+id/timeline"
        android:background="@color/vk_black"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/timeline_mute_btn"
        android:background="@drawable/bg_timeline_mute_btn"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="@dimen/timeline_add_button_size"
        android:layout_height="@dimen/timeline_add_button_size"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_timeline_mute"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/vk_white"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/timeline_add_fragment_btn"
        android:background="@drawable/bg_timeline_add_btn"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="@dimen/timeline_add_button_size"
        android:layout_height="@dimen/timeline_add_button_size"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_timeline_add_fragment"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/vk_gray_850"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/timeline_play_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/timeline_pause_button_max_width"
        android:minWidth="@dimen/timeline_play_button_min_width"
        android:contentDescription="@string/accessibility_timeline_play"
        android:paddingVertical="9dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/timeline"
        app:tint="@color/vk_white"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/timeline_pause_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/timeline_pause_button_max_width"
        android:minWidth="@dimen/timeline_pause_button_min_width"
        android:contentDescription="@string/accessibility_timeline_pause"
        android:paddingVertical="9dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/timeline"
        app:tint="@color/vk_white"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/button_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/timeline_pause_button_max_width"
        android:minWidth="@dimen/timeline_pause_button_min_width"
        app:barrierDirection="end"
        app:constraint_referenced_ids="timeline_play_btn, timeline_pause_btn"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/undo_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:foreground="@drawable/vkui_ripple_circle_highlight"
        android:scaleType="fitEnd"
        android:contentDescription="@string/accessibility_timeline_undo"
        android:paddingEnd="4dp"
        android:paddingVertical="13dp"
        app:layout_constraintEnd_toStartOf="@+id/redo_btn"
        app:layout_constraintStart_toEndOf="@+id/button_barrier"
        app:layout_constraintTop_toTopOf="@+id/timeline"
        app:tint="@color/vk_white"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/redo_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:foreground="@drawable/vkui_ripple_circle_highlight"
        android:scaleType="fitStart"
        android:contentDescription="@string/accessibility_timeline_redo"
        android:paddingStart="4dp"
        android:paddingVertical="13dp"
        app:layout_constraintEnd_toStartOf="@+id/divider"
        app:layout_constraintStart_toEndOf="@+id/undo_btn"
        app:layout_constraintTop_toTopOf="@+id/timeline"
        app:tint="@color/vk_white"/>
    <View
        android:id="@+id/divider"
        android:background="@color/vk_white_alpha20"
        android:layout_width="1dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/timeline_expand_btn"
        app:layout_constraintEnd_toStartOf="@+id/timeline_expand_btn"
        app:layout_constraintStart_toEndOf="@+id/redo_btn"
        app:layout_constraintTop_toTopOf="@+id/timeline_expand_btn"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/timeline_expand_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:foreground="@drawable/vkui_ripple_circle_highlight"
        android:scaleType="fitEnd"
        android:contentDescription="@string/clips_editor_accessibility_preview"
        android:paddingEnd="12dp"
        android:paddingVertical="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/timeline"
        app:tint="@color/vk_white"/>
    <com.vk.clips.design.view.timeline.TimelineBottomActionsView
        android:id="@+id/bottom_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timeline"/>
    <com.vk.clips.design.view.timeline.TimelineEditingActionsView
        android:id="@+id/editing_actions"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timeline"/>
    <com.vk.clips.design.view.timeline.TimelineVoiceoverView
        android:id="@+id/voiceover_view"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timeline"/>
    <com.vk.clips.design.view.timeline.FragmentActionsView
        android:id="@+id/fragment_actions"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/timeline"/>
</merge>
