<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/game_banner_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/game_icon"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="?attr/vk_ui_image_placeholder"/>
    <View
        android:id="@+id/clickable_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/game_banner_container"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/game_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="@dimen/post_side_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_banner_container"
        app:placeholderImage="?attr/vk_ui_image_placeholder"
        app:roundedCornerRadius="10dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1Normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/app_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:lines="1"
        android:textAlignment="textStart"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/play_game"
        app:layout_constraintStart_toEndOf="@+id/game_icon"
        app:layout_constraintTop_toBottomOf="@+id/game_banner_container"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/app_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        android:textAlignment="textStart"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/play_game"
        app:layout_constraintStart_toStartOf="@+id/app_title"
        app:layout_constraintTop_toBottomOf="@+id/app_title"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/play_game"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="21dp"
        android:layout_marginBottom="21dp"
        android:minWidth="0dp"
        android:text="@string/feed_feature_block_play"
        android:textAllCaps="false"
        android:layout_marginEnd="@dimen/post_side_padding"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
