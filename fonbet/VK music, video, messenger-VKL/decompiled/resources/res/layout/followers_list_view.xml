<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/followers_list_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.lists.CustomSwipeRefreshLayout
        android:id="@+id/content_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/followers_list_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.vk.lists.CustomSwipeRefreshLayout>
    <FrameLayout
        android:id="@+id/loading_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminateTint="?attr/vk_ui_icon_tertiary"
            android:indeterminateTintMode="src_in"/>
    </FrameLayout>
    <include
        android:id="@+id/error_state_container"
        android:visibility="gone"
        layout="@layout/vk_error_screen"/>
    <FrameLayout
        android:id="@+id/empty_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/followers_list_empty_state_text"
            style="@style/VkUiTypography.Headline1Normal"/>
    </FrameLayout>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/empty_state_placeholder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
