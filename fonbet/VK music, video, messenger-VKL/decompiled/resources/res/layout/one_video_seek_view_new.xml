<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatSeekBar
        android:layout_gravity="bottom"
        android:id="@+id/seek_bar_progress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_video_new_seek_height"
        android:progressDrawable="@drawable/one_video_new_seek_view_background"
        android:splitTrack="false"
        android:thumbTint="@android:color/transparent"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:layout_gravity="bottom"
        android:id="@+id/seek_bar_thumb"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_video_new_seek_thumb_height"
        android:progressDrawable="@android:color/transparent"
        android:thumb="@drawable/one_video_new_seek_view_thumb_inactive"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/views_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/one_video_white"
            android:id="@+id/extend_seek_bar_hint"
            android:background="@drawable/one_video_new_seek_view_extend_background"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/one_video_extend_seek_bar_hint"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/cancel_extend_seek"
            android:background="@drawable/one_video_button_drawable"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:src="@drawable/one_video_icon_cancel_24"
            android:contentDescription="@string/one_video_cancel"
            android:alpha="0"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <one.video.controls.views.VideoButtonsView
            android:id="@+id/video_buttons_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/one_video_white"
            android:id="@+id/seek_time"
            android:background="@drawable/one_video_new_seek_view_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/one_video_white"
            android:ellipsize="end"
            android:id="@+id/seek_episode_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:maxWidth="400dp"
            android:maxLines="2"
            android:paddingHorizontal="2dp"
            app:layout_constraintBottom_toTopOf="@+id/seek_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/one_video_white"
            android:id="@+id/position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="false"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/video_buttons_view"
            app:layout_constraintEnd_toStartOf="@+id/duration"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/video_buttons_view"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/one_video_white"
            android:id="@+id/slash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/one_video_slash"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/position"
            app:layout_constraintEnd_toStartOf="@+id/duration"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/position"
            app:layout_constraintTop_toTopOf="@+id/position"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/one_video_white_alpha60"
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="false"
            app:layout_constraintBottom_toBottomOf="@+id/position"
            app:layout_constraintEnd_toStartOf="@+id/current_interval_title"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/slash"
            app:layout_constraintTop_toTopOf="@+id/position"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/one_video_white"
            android:ellipsize="end"
            android:id="@+id/current_interval_title"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@+id/position"
            app:layout_constraintEnd_toStartOf="@+id/interval_counter"
            app:layout_constraintStart_toEndOf="@+id/duration"
            app:layout_constraintTop_toTopOf="@+id/position"
            app:layout_constraintWidth_default="wrap"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/one_video_white_alpha60"
            android:id="@+id/interval_counter"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            app:drawableEndCompat="@drawable/one_video_icon_chevron_16"
            app:drawableTint="@color/one_video_white_alpha60"
            app:layout_constraintBottom_toBottomOf="@+id/position"
            app:layout_constraintEnd_toStartOf="@+id/video_buttons_view"
            app:layout_constraintStart_toEndOf="@+id/current_interval_title"
            app:layout_constraintTop_toTopOf="@+id/position"/>
        <one.video.controls.views.seek.extend.ExtendSeekBarView
            android:id="@+id/extend_seek_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:alpha="0"
            app:layout_constraintTop_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
