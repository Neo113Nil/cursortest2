<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="200dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/iv_close"
            android:background="@drawable/vk_highlight_unlimited"
            android:padding="10dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:contentDescription="@string/close"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toTopOf="@+id/toolbar_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_cancel_outline_28"
            app:tint="?attr/vk_ui_icon_accent_themed"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_asr_start_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/voip_asr_start_dialog"
            android:maxLines="1"
            android:fontFamily="@font/vk_sans_display_demibold"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_close"
            app:layout_constraintTop_toTopOf="@+id/iv_close"
            style="@style/VkLegacyTypography.Title1"/>
        <View
            android:id="@+id/toolbar_divider"
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_asr_title"
            app:layout_constraintTop_toBottomOf="@+id/iv_close"/>
        <TextView
            android:id="@+id/tv_asr_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17.5dp"
            android:text="@string/voip_broadcast_title"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/et_asr_title"
            app:layout_constraintTop_toBottomOf="@+id/toolbar_divider"
            style="@style/VkLegacyTypography.Subhead.Regular"/>
        <EditText
            android:id="@+id/et_asr_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/voip_broadcast_title_hint"
            android:lines="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:importantForAutofill="no"
            app:layout_constraintBottom_toTopOf="@+id/privacy_selector"
            app:layout_constraintTop_toBottomOf="@+id/tv_asr_title"
            style="@style/VoipEditText"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="start"
            android:id="@+id/tv_asr_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voip_asr_start_dialog_description"
            android:fontFamily="@string/font_family_regular"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:letterSpacing="0.02"
            app:layout_constraintBottom_toTopOf="@+id/btn_asr_start"
            app:layout_constraintTop_toBottomOf="@+id/et_asr_title"
            app:layout_goneMarginTop="8dp"/>
        <Button
            android:textColor="@color/vk_black"
            android:gravity="center"
            android:id="@+id/btn_asr_start"
            android:background="@drawable/voip_bg_asr_button_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:minHeight="44dp"
            android:text="@string/voip_asr_start_dialog_btn"
            android:textAllCaps="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_asr_description"
            style="@style/VkLegacyTypography.Headline.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
