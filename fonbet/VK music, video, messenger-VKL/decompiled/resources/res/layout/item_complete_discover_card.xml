<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:ratio="0.75">
    <View
        android:background="@drawable/bg_user_discover_background_rounded"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/user_discover_info_container"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/user_discover_done"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerInside"
            app:lottie_autoPlay="false"
            app:lottie_fileName="check_circle_outline_56.json"
            app:lottie_loop="false"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Title2Medium"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center_horizontal"
            android:id="@+id/user_discover_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Text"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center_horizontal"
            android:id="@+id/user_discover_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <com.vk.core.view.PhotoStripView
            android:id="@+id/user_discover_photos"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="36dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_subhead"
            android:gravity="center_horizontal"
            android:id="@+id/user_discover_photos_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
</merge>
