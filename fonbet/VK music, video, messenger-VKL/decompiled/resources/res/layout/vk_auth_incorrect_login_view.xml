<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textAppearance="@style/VkUiTypography.TextMedium"
        android:textColor="?attr/vk_ui_background_negative"
        android:id="@+id/login_error_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vk_auth_incorrect_login_title"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadNormal"
        android:textColor="?attr/vk_ui_background_negative"
        android:id="@+id/login_error_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/vk_auth_incorrect_login_subtitle"/>
</merge>
