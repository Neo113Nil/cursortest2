<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false">
    <FrameLayout
        android:id="@+id/layout_filter_preview_wrapper"
        android:layout_width="64dp"
        android:layout_height="64dp">
        <ImageView
            android:id="@+id/image_filter_preview"
            android:background="@drawable/bg_rounded_16"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ic_arrow_left"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_left_48"/>
        <View
            android:id="@+id/selected_stroke_view"
            android:background="@drawable/filter_selected_stroke_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/category_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_category_filter"
            android:contentDescription="@string/editor_accessibility_filters_category"/>
    </FrameLayout>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/text_filter_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:importantForAccessibility="no"
        style="?attr/editorTextCaption3Style"/>
</androidx.appcompat.widget.LinearLayoutCompat>
