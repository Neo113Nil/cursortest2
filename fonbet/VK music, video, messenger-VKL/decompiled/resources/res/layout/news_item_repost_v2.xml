<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <com.vk.core.tool.view.OverlayLinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/post_repost_open_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:importantForAccessibility="no"
        android:paddingStart="32dp"
        android:paddingEnd="16dp"
        app:overlayDrawable="@drawable/highlight_post_header">
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginStart="8dp">
            <com.vk.core.view.TintTextView
                android:textAppearance="@style/VkUiTypography.FootnoteMedium"
                android:textColor="?attr/newsfeed_post_title_color"
                android:ellipsize="end"
                android:id="@+id/post_repost_name"
                android:visibility="visible"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:singleLine="true"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@drawable/vk_icon_repost_12"
                app:drawableTint="?attr/vk_ui_icon_secondary"
                app:vk_layout_isFluid="true"/>
            <com.vk.core.view.components.picture.VkImage
                android:layout_gravity="start"
                android:id="@+id/status"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="2dp"
                app:actualImageScaleType="centerInside"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="-1.5dp"
                android:layout_marginStart="3dp"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="?attr/vk_ui_text_subhead"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/post_repost_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:singleLine="true"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/icon2"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
    </com.vk.core.tool.view.OverlayLinearLayout>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/post_repost_photo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:placeholderImage="@drawable/photo_loading"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
</FrameLayout>
