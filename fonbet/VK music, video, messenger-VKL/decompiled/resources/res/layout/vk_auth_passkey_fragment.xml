<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <com.vk.superapp.ui.toolbar.VkAuthToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/vk_auth_accessibility_close"
        app:navigationIcon="@drawable/vk_icon_arrow_left_outline_28"
        app:vk_navIconTint="?attr/vk_ui_icon_accent_themed"
        app:vk_titlePriority="picture"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:gravity="center"
        android:id="@+id/passkey_failed_attempt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/VkUiTypography.DisplayTitle2"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/passkey_failed_attempt_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/passkey_failed_attempt_title"
        style="@style/VkUiTypography.Headline1Normal"/>
    <Button
        android:textAppearance="@style/VKID.Text.Button.Primary"
        android:id="@+id/passkey_failed_attempt_retry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/passkey_secondary_button"
        style="@style/VKID.View.Button.Primary"/>
    <Button
        android:textAppearance="@style/VKID.Text.Button.Secondary"
        android:id="@+id/passkey_secondary_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/passkey_failed_attempt_restore_account"
        style="@style/VKID.View.Button.Secondary"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/passkey_failed_attempt_restore_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toTopOf="@+id/vk_enter_by_mail"/>
    <Button
        android:textAppearance="@style/VkUiTypography.Headline1"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/vk_enter_by_mail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_auth_by_password_mail"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/help_button"
        style="@style/VKID.View.Button.Tertiary"/>
    <com.vk.auth.ui.VkAuthTextView
        android:id="@+id/help_button"
        android:padding="@dimen/vk_ui_button_padding_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/vk_auth_help_button"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
    <FrameLayout
        android:id="@+id/phone_validation_progress_bar"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <ProgressBar
            android:layout_gravity="center"
            android:visibility="visible"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/vk_ui_icon_secondary"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
