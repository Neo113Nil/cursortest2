<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_icon"
        android:background="@drawable/bg_empty_placeholder"
        android:padding="10dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:srcCompat="@drawable/vk_icon_search_24"
        app:tint="?attr/vk_ui_icon_accent"/>
    <com.vk.core.tool.view.onboarding.highlighter.VkOnboardingHighlighter
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_highlighter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="76dp"
        app:autoHighlight="false"
        app:highlighterColor="cyan"
        app:highlighterType="type4">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline1Normal"
            android:textColor="?attr/vk_ui_text_accent"
            android:id="@+id/vkim_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vkim_contacts_invite"
            android:lines="1"/>
    </com.vk.core.tool.view.onboarding.highlighter.VkOnboardingHighlighter>
    <TextView
        android:textAppearance="@style/VkUiTypography.ParagraphMedium"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/vkim_cnt"
        android:background="@drawable/bg_counter"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="24dp"/>
    <View
        android:layout_gravity="end|center_vertical"
        android:id="@+id/vkim_dot"
        android:background="@drawable/vkim_round_destructive_dot"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="24dp"/>
</FrameLayout>
