<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/avatar_publish_back_btn"
        android:background="@drawable/highlight_circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_legacy_ic_back_collapse_header"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_back"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/avatar_publish_title"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_publish_back_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatar_publish_back_btn"
        app:layout_constraintTop_toTopOf="@+id/avatar_publish_back_btn"
        style="@style/ToolbarTitle"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/avatar_publish_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxWidth="300dp"
        android:maxHeight="300dp"
        android:minWidth="100dp"
        android:minHeight="100dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        app:layout_constraintBottom_toTopOf="@+id/avatar_publish_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_publish_back_btn"
        app:layout_constraintVertical_chainStyle="packed"
        app:viewAspectRatio="1"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2Normal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/avatar_publish_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxWidth="300dp"
        android:text="@string/avatar_publish_subtitle"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        app:layout_constraintBottom_toTopOf="@+id/avatar_publish_post_switch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_publish_image"/>
    <com.vk.core.view.components.p003switch.VkSwitchItem
        android:ellipsize="end"
        android:id="@+id/avatar_publish_post_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:checked="true"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/avatar_publish_story_cell"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:title="@string/avatar_publish_post"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/avatar_publish_story_cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/avatar_publish_continue"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/avatar_publish_continue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/avatar_crop_continue"
        android:singleLine="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
