<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grid_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_layout_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/vk_super_app_tile_widget_grid_icons"/>
        <View
            android:id="@+id/title_grid_text_view"
            android:background="@drawable/vk_bg_skeleton_v3_4dp"
            android:layout_width="80dp"
            android:layout_height="12dp"
            android:layout_marginTop="143dp"
            android:layout_marginStart="12dp"/>
        <View
            android:id="@+id/subtitle_grid_text"
            android:background="@drawable/vk_bg_skeleton_v3_2dp"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="167dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <View
            android:id="@+id/description_text"
            android:background="@drawable/vk_bg_skeleton_v3_2dp"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="181dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <View
            android:background="@drawable/vk_bg_skeleton_v3_2dp"
            android:layout_width="88dp"
            android:layout_height="10dp"
            android:layout_marginTop="195dp"
            android:layout_marginStart="12dp"/>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
</FrameLayout>
