<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/watch_in_video_standalone"
        android:background="@drawable/bg_panel_all_videos"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:paddingHorizontal="12dp">
        <ImageView
            android:id="@+id/btn_icon"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="center"
            app:srcCompat="@drawable/vk_icon_logo_google_play_28"
            app:tint="@color/vk_black"/>
        <TextView
            android:textColor="@color/vk_black"
            android:gravity="center"
            android:id="@+id/text_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/video_open_vk_video"
            android:layout_marginStart="4dp"
            style="@style/VkUiTypography.Headline2"/>
        <ImageView
            android:id="@+id/close_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:layout_marginStart="4dp"
            app:srcCompat="@drawable/vk_icon_cancel_24"
            app:tint="@color/vk_ui_icon_medium_tint"/>
    </LinearLayout>
</merge>
