<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/touch_outside"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:soundEffectsEnabled="false"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/design_bottom_sheet"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.tool.view.vkblur.VkBlurContentView
            android:id="@+id/lego_sheet_blur_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/bottom_sheet_content_holder"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/bottom_sheet_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <View
                        android:layout_gravity="center"
                        android:id="@+id/drag_handle"
                        android:background="@drawable/ds_internal_bottom_sheet_handle"
                        android:visibility="gone"
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
                        android:layout_marginBottom="@dimen/vk_ui_spacing_size_xl"
                        android:layout_marginHorizontal="4dp"/>
                    <FrameLayout
                        android:layout_gravity="top"
                        android:id="@+id/toolbar"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/ivClose"
                            android:background="@drawable/vk_highlight_unlimited"
                            android:padding="10dp"
                            android:visibility="invisible"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/close"
                            app:srcCompat="@drawable/vk_icon_cancel_outline_28"
                            app:tint="?attr/vk_ui_icon_accent_themed"/>
                        <LinearLayout
                            android:layout_gravity="start|center_vertical"
                            android:orientation="vertical"
                            android:id="@+id/llTitleContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="56dp">
                            <TextView
                                android:textColor="?attr/vk_ui_text_primary"
                                android:ellipsize="end"
                                android:id="@+id/tvTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                style="@style/VkUiTypography.DisplayTitle2"/>
                            <TextView
                                android:textColor="?attr/vk_ui_text_subhead"
                                android:id="@+id/tvSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                style="@style/VkUiTypography.Subhead"/>
                        </LinearLayout>
                        <com.vk.core.view.components.button.VkSimpleButton
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/btnEndTitle"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="12dp"
                            app:buttonAppearance="accent"
                            app:buttonMode="tertiary"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/ivEndIcon"
                            android:background="@drawable/vk_highlight_unlimited"
                            android:visibility="gone"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/accessibility_edit"
                            app:srcCompat="@drawable/vk_icon_write_24"/>
                    </FrameLayout>
                </LinearLayout>
                <View
                    android:layout_gravity="top"
                    android:id="@+id/header_shadow"
                    android:background="@drawable/vk_bg_toolbar_shadow_light"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="56dp"/>
            </FrameLayout>
        </com.vk.core.tool.view.vkblur.VkBlurContentView>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/buttons_container"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.tool.view.vkblur.VkBlurView
            android:id="@+id/lego_buttons_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/buttons_nested_container"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <com.vk.core.view.components.button.VkSimpleButton
                android:id="@+id/positive_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:stateListAnimator="@null"
                app:buttonAppearance="accent"
                app:buttonMode="primary"
                app:buttonSizeType="medium"/>
            <View
                android:id="@+id/button_space"
                android:layout_width="0dp"
                android:layout_height="12dp"/>
            <com.vk.core.view.components.button.VkSimpleButton
                android:id="@+id/negative_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:stateListAnimator="@null"
                app:buttonAppearance="accent"
                app:buttonMode="secondary"
                app:buttonSizeType="medium"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/custom_bottom_container"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
