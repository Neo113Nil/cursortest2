<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/profile_friends_list_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:elevation="0dp">
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/profile_friends_list_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="snap|scroll"/>
        <com.vk.core.view.components.search.VkSearchView
            android:id="@+id/profile_friends_list_search"
            android:background="?attr/vk_ui_header_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.vk.core.view.components.paging.list.VkRecyclerPaginatedView
        android:id="@+id/profile_friends_list"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="?attr/actionBarSize"
        app:layout_anchorGravity="bottom|center_horizontal"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:vk_enableItemAnimations="true"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/profile_friends_list_button_container"
        android:background="?attr/vk_ui_background_content"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/profile_friends_list_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"
            app:buttonAppearance="accent"
            app:buttonSizeType="large"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
