<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/narrative_root"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_marginTop="8dp"
    android:foreground="@drawable/bg_narrative_selector_white"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <com.vk.narratives.core.NarrativeCoverView
        android:layout_gravity="start|top"
        android:id="@+id/cover"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"/>
    <LinearLayout
        android:layout_gravity="start|top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="94dp"
        android:layout_marginEnd="48dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption2CapsMedium.Unscaled"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/attach_narrative"
            android:singleLine="true"
            android:alpha="0.6"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2.Unscaled"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/author_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:alpha="0.6"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/fave_button"
        android:background="@drawable/highlight_circle_white"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/fave_start_button"
        android:scaleType="center"
        android:alpha="0.7"
        android:layout_marginEnd="4dp"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/posting_remove"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/vk_icon_deprecated_ic_close_attach_36"
        android:contentDescription="@string/delete"
        android:layout_marginEnd="4dp"/>
</FrameLayout>
