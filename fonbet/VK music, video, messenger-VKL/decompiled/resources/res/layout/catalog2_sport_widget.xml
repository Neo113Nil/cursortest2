<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.cell.VkMiniInfoCell
        android:id="@+id/catalog_sport_widget_title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/catalog_sport_widget_score"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/catalog_sport_widget_title"
        style="@style/VkUiTypography.DisplayTitle1SemiBold"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_sport_widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:maxWidth="112dp"
        android:maxLines="2"
        android:drawablePadding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/catalog_sport_widget_score"
        style="@style/VkUiTypography.Caption1"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/catalog_sport_widget_team1_logo_planning"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/catalog_sport_widget_time"
        app:layout_constraintTop_toTopOf="@+id/catalog_sport_widget_time"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/catalog_sport_widget_team1_name_planning"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/catalog_sport_widget_time"
        app:layout_constraintEnd_toStartOf="@+id/catalog_sport_widget_team1_logo_planning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/catalog_sport_widget_time"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/catalog_sport_widget_team2_logo_planning"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/catalog_sport_widget_time"
        app:layout_constraintTop_toTopOf="@+id/catalog_sport_widget_time"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/catalog_sport_widget_team2_name_planning"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/catalog_sport_widget_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/catalog_sport_widget_team2_logo_planning"
        app:layout_constraintTop_toTopOf="@+id/catalog_sport_widget_time"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.tile.VkTile
        android:id="@+id/catalog_sport_widget_team1_running"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toStartOf="@+id/catalog_sport_widget_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/catalog_sport_widget_title"/>
    <com.vk.core.view.components.tile.VkTile
        android:id="@+id/catalog_sport_widget_team2_running"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/catalog_sport_widget_time"
        app:layout_constraintTop_toBottomOf="@+id/catalog_sport_widget_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
