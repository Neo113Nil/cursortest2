<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_bar_layout"
    android:background="?attr/vk_ui_header_background"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:id="@+id/collapsing_layout"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:collapsedTitleTextAppearance="@style/ArtistNameStyle"
        app:contentScrim="?attr/vk_ui_header_background"
        app:expandedTitleGravity="start|bottom"
        app:expandedTitleMarginBottom="16dp"
        app:expandedTitleMarginEnd="88dp"
        app:expandedTitleMarginStart="16dp"
        app:expandedTitleTextAppearance="@style/ArtistNameStyle.Expanded"
        app:layout_scrollFlags="exitUntilCollapsed|scroll"
        app:statusBarScrim="@android:color/transparent"/>
</com.google.android.material.appbar.AppBarLayout>
