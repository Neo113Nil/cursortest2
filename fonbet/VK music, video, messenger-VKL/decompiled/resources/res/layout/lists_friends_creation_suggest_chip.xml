<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.MaterialComponents.Light"
    android:textColor="?attr/vk_ui_text_secondary"
    android:textColorHighlight="?attr/vk_ui_transparent_active"
    android:id="@+id/chip"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/lists_friends_university_friends"
    android:checkable="true"
    app:checkedIconVisible="false"
    app:chipBackgroundColor="@color/bg_chip_state_list"
    app:chipCornerRadius="10dp"
    app:chipIconVisible="false"
    app:chipStrokeColor="@color/stroke_chip_state_list"
    app:chipStrokeWidth="1.5dp"
    app:closeIconVisible="false"
    app:rippleColor="?attr/vk_ui_transparent_active"
    style="@style/VkUiTypography.SubheadMedium"/>
