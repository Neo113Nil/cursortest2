<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background"
    android:layout_width="match_parent"
    android:layout_height="450dp">
    <ImageView
        android:id="@+id/external_nps_preview_view"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:layout_constraintBottom_toTopOf="@+id/external_nps_title_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/external_nps_title_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/external_nps_title"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/external_nps_subtitle_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/external_nps_preview_view"
        style="@style/VkUiTypography.DisplayTitle2"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/external_nps_subtitle_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/external_nps_subtitle"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/external_nps_begin_poll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/external_nps_title_view"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/external_nps_begin_poll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/external_nps_begin_poll_title"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/external_nps_subtitle_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
