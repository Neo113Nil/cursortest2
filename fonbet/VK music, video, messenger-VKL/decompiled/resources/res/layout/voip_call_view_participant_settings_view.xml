<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_slide_up_menu"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/accessibility_back"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"
        app:srcCompat="@drawable/vk_icon_back_24"
        app:tint="?attr/vk_ui_text_primary"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toEndOf="@+id/back"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/voip_call_actions"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:titleTextColor="?attr/vk_ui_text_primary"/>
    <View
        android:id="@+id/actions_section_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.vk.voip.ui.view.VoipActionSingleLineView
        android:id="@+id/change_name"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actions_section_divider"
        app:voip_aslv_openIconVisible="true"
        app:voip_aslv_title="@string/voip_call_settings_change_name"
        style="@style/VoipActionSingleLineView"/>
    <com.vk.voip.ui.view.VoipActionSingleLineView
        android:id="@+id/beauty_filter"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/change_name"
        app:voip_aslv_openIconVisible="true"
        app:voip_aslv_title="@string/voip_call_actions_beauty_filter"
        style="@style/VoipActionSingleLineView"/>
    <com.vk.voip.ui.view.VoipActionMultiLineView
        android:id="@+id/mirroring"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/beauty_filter"
        app:voip_amlv_openIconVisible="false"
        app:voip_amlv_subtitle="@string/voip_setting_camera_mirroring_description"
        app:voip_amlv_subtitle_max_lines="2"
        app:voip_amlv_switchVisible="true"
        app:voip_amlv_title="@string/voip_setting_camera_mirroring_title"
        style="@style/VoipActionMultiLineView"/>
    <com.vk.voip.ui.view.VoipActionSingleLineView
        android:id="@+id/gestures_feedback_view"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mirroring"
        app:voip_aslv_openIconVisible="false"
        app:voip_aslv_switchVisible="true"
        app:voip_aslv_title="@string/voip_setting_gestures_feedback_description"
        style="@style/VoipActionMultiLineView"/>
    <com.vk.voip.ui.view.VoipActionMultiLineView
        android:id="@+id/noise_suppressor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gestures_feedback_view"
        app:voip_amlv_openIconVisible="false"
        app:voip_amlv_subtitle="@string/voip_call_actions_noise_suppressor_description"
        app:voip_amlv_subtitle_max_lines="3"
        app:voip_amlv_title="@string/voip_call_actions_noise_suppressor_title"
        style="@style/VoipActionMultiLineView"/>
    <com.vk.voip.ui.view.VoipActionSectionPlaceholder
        android:id="@+id/video_audio_section_error_placeholder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noise_suppressor"
        app:voip_asp_button="@string/voip_call_actions_video_audio_section_error_retry"
        app:voip_asp_description="@string/voip_call_menu_actions_no_effects_description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
