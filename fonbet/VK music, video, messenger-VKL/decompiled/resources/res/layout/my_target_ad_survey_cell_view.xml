<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@+id/cell_container"
        android:background="@drawable/bg_search_field_border_radius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/survey_cell_left"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:foreground="@drawable/bg_circle_stroke_05"
            android:scaleType="centerCrop"
            android:layout_marginEnd="6dp"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_gravity="center_vertical"
            android:id="@+id/survey_cell_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/VkUiTypography.Paragraph"/>
        <com.vk.core.view.components.checkbox.VkCheckbox
            android:layout_gravity="center"
            android:id="@+id/survey_cell_right"
            android:background="@null"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="28dp"
            android:buttonTint="@null"/>
    </LinearLayout>
</merge>
