<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/voip_hint_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/voip_hint_image_view"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="17dp"
        android:importantForAccessibility="no"
        app:tint="@color/vk_white_alpha60"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/vk_white_alpha60"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/voip_hint_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:maxLines="5"
        android:lineSpacingExtra="1sp"
        android:letterSpacing="0.01"/>
    <TextView
        android:textColor="@color/vk_gray_800"
        android:layout_gravity="center_horizontal"
        android:id="@+id/voip_hint_button_view"
        android:background="@drawable/bg_white_rounded8"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</merge>
