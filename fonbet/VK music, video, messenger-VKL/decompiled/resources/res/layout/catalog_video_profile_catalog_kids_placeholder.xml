<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/catalog_placeholder_view_image"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginBottom="12dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_placeholder_view_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="360dp"
        android:drawablePadding="12dp"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/primary_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="36dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
</LinearLayout>
