<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_chat_profile_adapter_with_description_item_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/vkim_chat_profile_adapter_text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/vkim_chat_profile_adapter_with_description_item_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:lines="1"
            android:layout_weight="1"
            android:fontFamily="@string/font_family_regular"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/vkim_chat_profile_adapter_with_description_subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:lines="1"
            android:layout_weight="1"
            style="@style/VkLegacyTypography.Caption1.Regular"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="end|center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/vkim_chat_profile_adapter_with_description_hint"
            android:background="@drawable/bg_circle"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="10dp"
            android:backgroundTint="?attr/vk_ui_icon_accent_themed"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/vkim_chat_profile_adapter_with_description_item_end_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:tint="?attr/vk_ui_icon_secondary"/>
    </LinearLayout>
</FrameLayout>
