<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/friend_request_padding_top"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/friend_request_notification_photo"
        android:background="@drawable/user_placeholder_system_theme"
        android:layout_width="@dimen/friend_request_photo_size"
        android:layout_height="@dimen/friend_request_photo_size"
        android:contentDescription="@null"
        android:layout_marginStart="0dp"/>
    <LinearLayout
        android:layout_gravity="start"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/friend_request_info_margin_start"
        android:layout_marginEnd="@dimen/friend_request_info_margin_end">
        <TextView
            android:textSize="@dimen/friend_request_notification_title"
            android:textStyle="normal"
            android:ellipsize="end"
            android:layout_gravity="start"
            android:id="@+id/friend_request_notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/friend_request_notification_title_margin_top"
            android:layout_marginBottom="@dimen/friend_request_notification_title_margin_bottom"
            android:maxLines="3"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"
            android:textDirection="locale"
            style="@style/TextAppearance.Compat.Notification.Title"/>
        <LinearLayout
            android:layout_gravity="start"
            android:orientation="horizontal"
            android:id="@+id/friend_request_notification_common_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/friend_request_notification_mutual_photo"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/friend_request_notification_mutual_photo"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:includeFontPadding="false"
                android:contentDescription="@null"
                android:layout_marginEnd="@dimen/friend_request_notification_mutual_photo_margin_end"/>
            <TextView
                android:textSize="@dimen/friend_request_notification_mutual_text"
                android:textColor="@color/friend_request_notification_description"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/friend_request_notification_mutual_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif"
                android:textDirection="locale"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
