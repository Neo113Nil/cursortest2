<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/im_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Vk.Theme.Appbar">
        <ViewStub
            android:id="@+id/dialogs_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="snap|enterAlways|scroll"/>
        <me.zhanghai.android.materialprogressbar.MaterialProgressBar
            android:id="@+id/im_sync_state_progress_bar"
            android:visibility="invisible"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            style="?attr/im_dialogs_state_style"/>
        <FrameLayout
            android:id="@+id/audio_msg_player_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ViewStub
                android:id="@+id/audio_msg_player_stub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.AppBarShadowView
                android:id="@+id/audio_msg_player_separator"
                app:vk_appbar_forceMode="separator"
                style="@style/AppBarShadow"/>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <ViewStub
        android:id="@+id/im_dialogs_list_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/im_appbar_shadow"
        style="@style/AppBarShadow"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/vkim_fab"
        android:padding="14dp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/vkim_accessibility_write_msg"
        android:layout_marginEnd="16dp"
        app:backgroundTint="?attr/vk_legacy_modal_card_background"
        app:elevation="8dp"
        app:fabCustomSize="56dp"
        app:layout_anchor="@+id/im_dialogs_list_container"
        app:layout_anchorGravity="end|bottom"
        app:layout_behavior="com.vk.core.ui.VkFabBehaviour"
        app:maxImageSize="28dp"
        app:srcCompat="@drawable/vk_icon_write_square_outline_28"/>
    <ViewStub
        android:id="@+id/im_dialogs_search_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
