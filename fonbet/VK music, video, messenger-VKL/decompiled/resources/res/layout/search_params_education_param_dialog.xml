<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp">
    <FrameLayout
        android:background="@drawable/search_params_segmented_control_background"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp">
        <com.vk.core.view.VKTabLayout
            android:id="@+id/institution_type_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:overScrollMode="never"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/search_params_segmented_control_indicator"
            app:tabIndicatorColor="?attr/vk_ui_segmented_control"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorGravity="center"
            app:tabIndicatorHeight="40dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="16dp"
            app:tabPaddingStart="16dp"
            app:tabRippleColor="@null"
            app:tabTextAppearance="@style/VkUiTypography.Headline1"
            app:tabTextColor="?attr/vk_ui_text_primary"/>
    </FrameLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:paddingBottom="1sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:minHeight="20dp"
        android:text="@string/search_params_city_title"
        style="@style/VkUiTypography.Subhead"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/city_value"
        android:background="@drawable/vkui_bg_edittext"
        android:paddingLeft="12dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:minHeight="44dp"
        android:text="@string/search_params_city_not_selected"
        android:maxLines="1"
        android:drawablePadding="10dp"
        android:paddingVertical="8dp"
        app:drawableRightCompat="@drawable/vk_icon_chevron_down_24"
        app:drawableTint="?attr/vk_ui_icon_secondary"
        style="@style/VkUiTypography.Text"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:paddingBottom="1sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/search_params_education_institution_title"
        style="@style/VkUiTypography.Subhead"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/institution_value"
        android:background="@drawable/vkui_bg_edittext"
        android:paddingLeft="12dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:minHeight="44dp"
        android:text="@string/search_params_institution_not_selected"
        android:maxLines="1"
        android:paddingVertical="8dp"
        app:drawableRightCompat="@drawable/vk_icon_chevron_down_24"
        app:drawableTint="?attr/vk_ui_icon_secondary"
        style="@style/VkUiTypography.Text"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:paddingBottom="1sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/search_params_education_year_title"
        style="@style/VkUiTypography.Subhead"/>
    <Spinner
        android:id="@+id/year_spinner"
        android:background="@drawable/vkui_spinner_default_bg"
        android:paddingRight="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:minHeight="44dp"
        android:popupBackground="@drawable/vk_bg_modal_dialog"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/apply_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/search_params_apply_button"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</LinearLayout>
