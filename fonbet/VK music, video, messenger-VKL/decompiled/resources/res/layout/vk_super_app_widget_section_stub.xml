<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/vk_superapp_section_rect_background"
    android:layout_width="match_parent"
    android:layout_height="280dp">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_section_layout"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/header_title"
            android:background="@drawable/vk_superapp_content_tint_radius_4"
            android:layout_width="56dp"
            android:layout_height="14dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="17dp"/>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="48dp"
        android:baselineAligned="false"
        android:weightSum="2"
        android:paddingHorizontal="12dp">
        <FrameLayout
            android:background="@drawable/vk_bg_radius_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:backgroundTint="?attr/vk_ui_background_tertiary">
            <include layout="@layout/vk_super_app_widget_default_tile_stub"/>
        </FrameLayout>
        <FrameLayout
            android:background="@drawable/vk_bg_radius_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_weight="1"
            android:backgroundTint="?attr/vk_ui_background_tertiary">
            <include layout="@layout/vk_super_app_widget_tile_grid_stub"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
