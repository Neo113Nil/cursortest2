<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/vk_black_alpha60"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/pipette_image_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:background="@color/vk_black_alpha20"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.stories.design.view.text.TextStickerFrameLayout
            android:id="@+id/gesture_handler"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.camera.editor.common.text.views.CreateStoryEditText
                android:textColor="@color/vk_white"
                android:textColorHighlight="@color/vk_blue_overlight_1_alpha32"
                android:gravity="center_vertical"
                android:id="@+id/et_sticker"
                android:background="@null"
                android:paddingTop="80dp"
                android:paddingBottom="100dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/picker_cursor_sticker_text"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"/>
        </com.vk.stories.design.view.text.TextStickerFrameLayout>
        <com.vk.stories.design.view.editor.PipetteColorPicker
            android:layout_gravity="center_horizontal"
            android:id="@+id/pipette_color_picker"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_buttons"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_text_background"
                android:background="@drawable/white_ripple_unbounded"
                android:layout_width="@dimen/story_text_editor_button_top_size"
                android:layout_height="@dimen/story_text_editor_button_top_size"
                android:layout_marginTop="@dimen/story_text_editor_button_top_margin"
                android:src="@drawable/vk_icon_text_style_1_large_48"
                android:contentDescription="@string/story_accessibility_change_text_background"
                app:layout_constraintEnd_toStartOf="@+id/iv_align"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_align"
                android:background="@drawable/white_ripple_unbounded"
                android:layout_width="@dimen/story_text_editor_button_top_size"
                android:layout_height="@dimen/story_text_editor_button_top_size"
                android:layout_marginTop="@dimen/story_text_editor_button_top_margin"
                android:src="@drawable/vk_icon_align_center_shadow_large_48"
                android:contentDescription="@string/story_accessibility_text_align_center"
                app:layout_constraintEnd_toStartOf="@+id/iv_gradient_color_text"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/iv_text_background"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_gradient_color_text"
                android:background="@drawable/white_ripple_unbounded"
                android:layout_width="@dimen/story_text_editor_button_top_size"
                android:layout_height="@dimen/story_text_editor_button_top_size"
                android:layout_marginTop="@dimen/story_text_editor_button_top_margin"
                android:src="@drawable/vk_icon_gradient_shadow_large_48"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/iv_align"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/vk_button_text_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/accessibility_done"
                app:buttonMode="tertiary"
                app:icon="@drawable/vk_icon_done_outline_shadow_large_48"
                app:iconSize="@dimen/story_done_btn_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.vk.stories.design.view.text.StorySeekBar
                android:layout_gravity="start|center_vertical"
                android:id="@+id/font_size_seek_bar"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/story_accessibility_font_size"
                android:paddingStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.vk.stories.design.view.text.TextStyleFontPicker
                android:id="@+id/fonts_style_picker"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.vk.stories.design.view.text.TextStyleColorPicker
                android:id="@+id/color_picker"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
