<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:paddingStart="@dimen/post_side_padding_small"
    android:paddingEnd="@dimen/post_side_padding_small">
    <com.vk.feed.design.view.newsfeed.header.avatar.VkFeedHeaderAvatarView
        android:id="@+id/post_header_photo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/container_subscribe_avatar_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-3dp"
        android:layout_marginEnd="-3dp"
        app:layout_constraintBottom_toBottomOf="@+id/post_header_photo"
        app:layout_constraintEnd_toEndOf="@+id/post_header_photo"/>
    <com.vk.feed.design.view.newsfeed.header.description.VkFeedNewsfeedHeaderDescriptionLayout
        android:id="@+id/post_header_subtitle_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.5dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/post_header_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/post_header_photo"
        app:layout_constraintTop_toBottomOf="@+id/post_header_title_container"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"
        app:vk_animation_delay="1800"
        app:vk_animation_duration="600">
        <include
            android:id="@+id/post_header_subtitle"
            layout="@layout/feed_post_header_subtitle_v2"/>
    </com.vk.feed.design.view.newsfeed.header.description.VkFeedNewsfeedHeaderDescriptionLayout>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/post_header_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0.5dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/post_header_subtitle_container"
        app:layout_constraintEnd_toStartOf="@+id/post_header_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/post_header_photo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/post_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="18dp"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:textAlignment="gravity"
            app:vk_layout_isFluid="true"
            style="?attr/vk_ui_typography_subhead_medium"/>
        <com.vk.core.view.components.picture.VkImage
            android:layout_gravity="start|center_vertical"
            android:id="@+id/post_header_status"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="start|center_vertical"
            android:id="@+id/icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"/>
        <com.vk.core.view.components.text.links.VkLinkedText
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/post_info_view"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:textAlignment="gravity"
            android:layout_marginStart="4dp"
            style="?attr/vk_ui_typography_footnote"/>
        <View
            android:layout_gravity="start|center_vertical"
            android:id="@+id/post_header_pin"
            android:background="@drawable/vk_icon_pin_12"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="?attr/vk_ui_icon_medium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_accent"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/post_header_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:text="@string/fave_mark_new"
            android:layout_marginStart="8dp"
            style="?attr/vk_ui_typography_footnote"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/post_header_icon"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/container_subscribe_button"
        app:layout_constraintStart_toEndOf="@+id/post_header_title_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/container_subscribe_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/post_header_options"
        app:layout_constraintStart_toEndOf="@+id/post_header_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/post_header_options"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/common_actions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
</merge>
