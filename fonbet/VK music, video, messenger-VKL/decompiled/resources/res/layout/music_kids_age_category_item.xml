<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_double_list_small_item"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_margin="4dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="2dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:roundedCornerRadius="@dimen/music_image_corners_10"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1.Unscaled"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="start|top"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_marginStart="54dp"
        android:layout_marginEnd="8dp"/>
</FrameLayout>
