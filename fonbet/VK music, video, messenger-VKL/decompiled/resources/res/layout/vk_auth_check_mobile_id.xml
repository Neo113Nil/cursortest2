<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/mobile_id_progress_bar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/vk_ui_icon_medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="top|center_horizontal"
        android:id="@+id/mobile_id_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="1sp"
        android:layout_marginHorizontal="16dp"
        style="@style/VkUiTypography.Title2Medium"/>
</LinearLayout>
