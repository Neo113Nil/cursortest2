<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:paddingTop="@dimen/vk_ui_base_padding_vertical"
    android:paddingBottom="@dimen/vk_ui_base_padding_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/vk_ui_base_padding_horizontal"
    android:paddingEnd="@dimen/vk_ui_base_padding_horizontal">
    <com.vk.core.view.components.text.links.VkLinkedText
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/conditions_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/conditions_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/conditions_barrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="conditions_text"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/product_card_cta_cart_button_compose_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/product_card_cta_quantity_control_compose_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/conditions_barrier"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/product_card_cta_quantity_control_compose_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_xl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/product_card_cta_cart_button_compose_view"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/product_card_cta_primary_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintEnd_toStartOf="@+id/product_card_cta_secondary_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_card_cta_cart_button_compose_view"
        app:layout_goneMarginEnd="0dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/product_card_cta_secondary_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/product_card_cta_primary_button"
        app:layout_constraintTop_toTopOf="@+id/product_card_cta_primary_button"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/product_card_cta_call_primary_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintTop_toBottomOf="@+id/product_card_cta_primary_button"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/product_card_cta_call_primary_button_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_card_cta_primary_button"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/product_card_cta_call_secondary_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="large"
        app:layout_constraintTop_toBottomOf="@+id/product_card_cta_call_primary_button"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center"
        android:id="@+id/owner_answer_time_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_card_cta_call_secondary_button"
        style="@style/VkUiTypography.SubheadNormal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
