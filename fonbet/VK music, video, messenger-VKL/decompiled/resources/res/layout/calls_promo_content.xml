<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/calls_promo_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_calls_promo_light"
        android:importantForAccessibility="no"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle1"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/calls_promo_title"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/calls_promo_subtitle"/>
    <com.vk.core.view.TintTextView
        android:layout_marginTop="32dp"
        android:text="@string/calls_promo_item_participants"
        app:drawableStartCompat="@drawable/vk_icon_users_outline_28"
        style="@style/VoipPromoFeatureItem"/>
    <com.vk.core.view.TintTextView
        android:layout_marginTop="28dp"
        android:text="@string/calls_promo_item_join_with_link"
        app:drawableStartCompat="@drawable/vk_icon_chain_outline_28"
        style="@style/VoipPromoFeatureItem"/>
    <com.vk.core.view.TintTextView
        android:layout_marginTop="28dp"
        android:text="@string/calls_promo_item_screen_sharing"
        app:drawableStartCompat="@drawable/vk_icon_arrow_up_rectangle_outline_28"
        style="@style/VoipPromoFeatureItem"/>
    <com.vk.core.view.TintTextView
        android:layout_marginTop="28dp"
        android:text="@string/calls_promo_item_virtual_background"
        app:drawableStartCompat="@drawable/vk_icon_user_square_outline_28"
        style="@style/VoipPromoFeatureItem"/>
</LinearLayout>
