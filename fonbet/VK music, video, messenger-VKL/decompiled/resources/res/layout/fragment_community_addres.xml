<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/map_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"/>
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="3dp"/>
    <FrameLayout
        android:id="@+id/recycler_frame"
        android:background="@drawable/bg_community_all_addresses_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="-4dp"
        android:elevation="8dp">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/community_addresses_grabber"
            android:background="@drawable/bg_community_all_addresses_grabber"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/vk_ui_spacing_size_xs"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/addresses_recycler"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/community_addresses_list_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.spinner.VkSpinner
            android:layout_gravity="center_horizontal"
            android:id="@+id/progress"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="32dp"
            app:spinnerSize="medium"/>
    </FrameLayout>
    <include layout="@layout/community_address_full"/>
    <com.vk.core.view.components.placeholder.VkPlaceholder
        android:id="@+id/community_addresses_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
