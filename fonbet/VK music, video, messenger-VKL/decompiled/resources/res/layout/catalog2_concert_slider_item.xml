<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/catalog_slider_concert_item_padding_horizontal"
    android:paddingVertical="@dimen/catalog_slider_concert_item_padding_vertical">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/concert_slider_item_image"
        android:layout_width="@dimen/catalog_slider_concert_item_image_size"
        android:layout_height="@dimen/catalog_slider_concert_item_image_size"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/catalog_slider_concert_item_avatar_corner_radius"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Title1"
        android:id="@+id/concert_slider_item_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/concert_slider_item_month"
        app:layout_constraintEnd_toEndOf="@+id/concert_slider_item_image"
        app:layout_constraintStart_toStartOf="@+id/concert_slider_item_image"
        app:layout_constraintTop_toTopOf="@+id/concert_slider_item_image"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Paragraph"
        android:id="@+id/concert_slider_item_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="@+id/concert_slider_item_image"
        app:layout_constraintEnd_toEndOf="@+id/concert_slider_item_day"
        app:layout_constraintStart_toStartOf="@+id/concert_slider_item_day"
        app:layout_constraintTop_toBottomOf="@+id/concert_slider_item_day"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1Normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/concert_slider_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/concert_slider_item_subtitle1"
        app:layout_constraintEnd_toStartOf="@+id/concert_slider_item_button"
        app:layout_constraintStart_toEndOf="@+id/concert_slider_item_image"
        app:layout_constraintTop_toTopOf="@+id/concert_slider_item_image"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/concert_slider_item_subtitle1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginVertical="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/concert_slider_item_extrasubtitle"
        app:layout_constraintEnd_toStartOf="@+id/concert_slider_item_subtitle2"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/concert_slider_item_title"
        app:layout_constraintTop_toBottomOf="@+id/concert_slider_item_title"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/concert_slider_item_subtitle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/concert_slider_item_subtitle1"
        app:layout_constraintEnd_toEndOf="@+id/concert_slider_item_title"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/concert_slider_item_subtitle1"
        app:layout_constraintTop_toTopOf="@+id/concert_slider_item_subtitle1"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/concert_slider_item_extrasubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/concert_slider_item_image"
        app:layout_constraintEnd_toEndOf="@+id/concert_slider_item_title"
        app:layout_constraintStart_toStartOf="@+id/concert_slider_item_title"
        app:layout_constraintTop_toBottomOf="@+id/concert_slider_item_subtitle1"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/concert_slider_item_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
