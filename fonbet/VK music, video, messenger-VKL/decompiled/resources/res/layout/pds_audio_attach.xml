<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/pds_audio_attach_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/VkUiTypography.Headline2Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/pds_audio_attach_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/VkUiTypography.SubheadNormal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="end"
        android:id="@+id/pds_audio_attach_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/pds_audio_attach_play"
        android:background="@drawable/background_audio_attach_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/vk_icon_play_24"
        android:scaleType="center"
        android:tint="?attr/vk_ui_icon_primary"
        android:contentDescription="@string/music_talkback_play"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/pds_audio_attach_explicit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_error_circle_fill_gray_12"/>
    <com.vk.core.view.components.progress.VkProgress
        android:id="@+id/pds_audio_attach_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?android:attr/progressBarStyleHorizontal"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/pds_audio_attach_remove"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_cancel_24"
        android:tint="?attr/vk_ui_icon_secondary"
        android:contentDescription="@string/delete"
        app:tintMode="src_in"/>
</merge>
