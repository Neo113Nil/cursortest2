<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.avatar.api.VKAvatarView
        android:layout_gravity="center"
        android:id="@+id/iv_post_header_avatar"
        android:layout_width="@dimen/post_header_avatar_size"
        android:layout_height="@dimen/post_header_avatar_size"
        app:contourOverlayEnabled="true"/>
    <com.vk.avatar.api.VKAvatarView
        android:layout_gravity="end|bottom"
        android:id="@+id/iv_post_header_avatar_overlay"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="4dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:layout_marginEnd="4dp"
        app:borderWidth="0dp"
        app:contourOverlayEnabled="true"/>
</merge>
