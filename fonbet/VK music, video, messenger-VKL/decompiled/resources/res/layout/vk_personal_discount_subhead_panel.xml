<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/vk_bg_personal_banner_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="24dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/personal_discount_new_coin_view"
        android:background="@drawable/vk_bg_personal_banner_coin"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/vk_icon_coins_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline1"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/personal_discount_panel_new_title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/personal_discount_panel_new_subtitle_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
</LinearLayout>
