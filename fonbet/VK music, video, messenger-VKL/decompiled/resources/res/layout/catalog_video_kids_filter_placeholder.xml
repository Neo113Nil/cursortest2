<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingBottom="150dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/video_kids_filters_reset_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="296dp"
        android:text="@string/video_kids_filter_reset_title"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/video_kids_filters_reset_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/video_kids_filter_reset_button"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="medium"/>
</LinearLayout>
