<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/bottom_tabbar_popup_width"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bottom_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
        android:layout_marginVertical="@dimen/vk_ui_spacing_size_xs"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_groups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
