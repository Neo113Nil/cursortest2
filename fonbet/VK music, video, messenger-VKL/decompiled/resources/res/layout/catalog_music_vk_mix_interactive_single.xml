<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vk_mix_block"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.music.view.MusicRoundPlayView
        android:id="@+id/play_view"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:elevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:mrp_background_tint="@color/vk_white"
        app:mrp_compact_progess_bar="true"
        app:mrp_pause_icon="@drawable/vk_icon_pause_32"
        app:mrp_play_icon="@drawable/vk_icon_play_32"
        app:mrp_play_icon_tint="@color/vk_black"
        app:mrp_scale_buffering="true"/>
    <TextView
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:singleLine="true"
        android:layout_marginHorizontal="34dp"
        android:paddingHorizontal="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1"/>
    <TextView
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:alpha="0.8"
        android:layout_marginHorizontal="34dp"
        android:paddingHorizontal="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkUiTypography.Paragraph"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/button_settings"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:layout_constraintVertical_bias="0"
        app:trailingIconSize="16dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/button_placeholder_first"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:buttonAppearance="overlay"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintEnd_toStartOf="@+id/button_placeholder_second"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:layout_constraintVertical_bias="0"
        app:trailingIconSize="16dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/button_placeholder_second"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:buttonAppearance="overlay"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:iconSize="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_placeholder_first"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:layout_constraintVertical_bias="0"
        style="@style/VkUiTypography.SubheadMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
