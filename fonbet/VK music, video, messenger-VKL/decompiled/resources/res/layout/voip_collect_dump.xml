<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/voip_settings_dump_duration"
        android:layout_marginStart="17dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
    <TextView
        android:id="@+id/duration_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/duration_seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:max="3"
        android:progress="0"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration"/>
    <TextView
        android:id="@+id/server_dump_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voip_settings_remote_media_dump"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration_seek_bar"
        style="@style/VkLegacyTypography.Title1.Toolbar"/>
    <com.vk.voip.ui.view.VoipActionSingleLineView
        android:id="@+id/dump_audio"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/server_dump_header"
        app:voip_aslv_switchVisible="true"
        app:voip_aslv_title="@string/voip_settings_dump_audio"
        style="@style/VoipActionSingleLineView"/>
    <com.vk.voip.ui.view.VoipActionSingleLineView
        android:id="@+id/dump_video"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dump_audio"
        app:voip_aslv_switchVisible="true"
        app:voip_aslv_title="@string/voip_settings_dump_video"
        style="@style/VoipActionSingleLineView"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/submit"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_margin="8dp"
        android:layout_marginTop="24dp"
        android:text="@string/voip_settings_dump_submit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dump_video"/>
    <TextView
        android:id="@+id/client_dump_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voip_settings_local_audio_dump"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/submit"
        style="@style/VkLegacyTypography.Title1.Toolbar"/>
    <TextView
        android:id="@+id/client_dump_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voip_local_dump_description"
        android:maxLines="3"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/client_dump_header"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/submit_local_only"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_margin="8dp"
        android:text="@string/voip_settings_dump_submit_local_only"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/client_dump_description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
