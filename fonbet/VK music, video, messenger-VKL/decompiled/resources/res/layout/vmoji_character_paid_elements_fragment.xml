<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/vk_app_bar"
            android:background="@drawable/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            app:layout_behavior="com.vk.core.view.FixAppBarLayoutBehavior"
            style="@style/VKAppBar">
            <RelativeLayout
                android:id="@+id/toolbar"
                android:paddingTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/back"
                    android:background="@drawable/vk_highlight_circle"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/vk_icon_arrow_left_outline_28"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="4dp"
                    android:layout_alignParentStart="true"
                    app:tint="?attr/vk_legacy_header_tint"/>
                <TextView
                    android:textSize="23sp"
                    android:textColor="?attr/vk_legacy_header_text"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vmoji_character_paid_elements"
                    android:singleLine="true"
                    android:layout_toRightOf="@+id/back"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/vk_sans_display_demibold"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <com.vk.core.view.AppBarShadowView
            android:id="@+id/shadow_view"
            android:elevation="10dp"
            app:vk_appbar_allowSeparator="false"
            style="@style/AppBarShadow"/>
        <com.vk.lists.CustomSwipeRefreshLayout
            android:id="@+id/vmoji_products_recycler_swipe_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/toolbar"
                android:layout_alignParentBottom="true"/>
        </com.vk.lists.CustomSwipeRefreshLayout>
        <include
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/vmoji_character_buy_container"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
