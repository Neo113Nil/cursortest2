<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.im.design.view.wheel.ImWheelSelectorView
        android:id="@+id/wheel_selector"
        android:layout_width="match_parent"
        android:layout_height="240dp"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/accept_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl"
        android:layout_marginVertical="@dimen/vk_ui_spacing_size_xl"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
    <com.vk.core.view.components.text.links.VkLinkedText
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/terms_of_use"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_xl"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl"
        style="?attr/vk_ui_typography_footnote"/>
</LinearLayout>
