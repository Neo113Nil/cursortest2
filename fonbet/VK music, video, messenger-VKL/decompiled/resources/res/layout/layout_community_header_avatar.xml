<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/community_avatar_layout"
    android:clipChildren="false"
    android:layout_width="106dp"
    android:layout_height="106dp"
    android:layout_marginStart="12dp">
    <com.vk.community.design.view.avatar.CommunityProfileAvatarViewContainer
        android:layout_gravity="center"
        android:id="@+id/community_avatar"
        android:layout_width="106dp"
        android:layout_height="106dp"
        android:contentDescription="@string/community_profile_accessibility_avatar"
        app:borderWidth="4dp"
        app:roundAvatarSize="90dp"
        app:solidFillEnabled="true"/>
</FrameLayout>
