<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="46dp"
    android:paddingVertical="8dp">
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/author_photo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:emptyImagePlaceholder="@drawable/user_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/start_replay_body_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="end"
        app:constraint_referenced_ids="author_photo"/>
    <TextView
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="end"
        android:id="@+id/author_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/start_replay_body_barrier"
        app:layout_constraintTop_toTopOf="@+id/author_photo"
        style="@style/VkUiTypography.SubheadMedium"/>
    <com.vk.core.view.ExpandableTextViewGroup
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/text"
        android:paddingTop="1dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/start_replay_body_barrier"
        app:layout_constraintTop_toBottomOf="@+id/author_name"
        style="@style/VkUiTypography.SubheadNormal"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/attach_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/start_replay_body_barrier"
        app:layout_constraintTop_toBottomOf="@+id/text"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/start_replay_body_barrier"
        app:layout_constraintTop_toBottomOf="@+id/attach_container"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/reply_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/answer_button_text"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/date_tv"
        app:layout_constraintStart_toEndOf="@+id/date_tv"
        app:layout_constraintTop_toTopOf="@+id/date_tv"
        style="@style/VkUiTypography.FootnoteMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
