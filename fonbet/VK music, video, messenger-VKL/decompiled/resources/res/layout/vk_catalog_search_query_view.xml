<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/catalog_search_query_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:paddingEnd="4dp"
    app:layout_collapseMode="pin"
    app:layout_scrollFlags="snap|enterAlways|scroll">
    <FrameLayout
        android:id="@+id/navigation_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/music_talkback_go_back"
            android:layout_marginStart="4dp"
            app:tint="?attr/vk_ui_icon_accent_themed"
            style="@style/ActionButton.White"/>
        <ImageView
            android:id="@+id/navigation_icon"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/accessibility_navigation_drawer"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/search_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_icon_search_expand"
        app:layout_constraintStart_toEndOf="@+id/navigation_wrapper"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="8dp"
        app:layout_goneMarginStart="8dp">
        <include
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:minHeight="52dp"
            layout="@layout/catalog_search_query_view"/>
    </FrameLayout>
    <ViewStub
        android:gravity="center_vertical"
        android:id="@+id/title_slot_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_icon_search_expand"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/navigation_wrapper"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="8dp"
        app:layout_goneMarginStart="8dp"/>
    <ImageView
        android:id="@+id/search_query_iv_icon_right"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_text_button"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent_themed"
        style="@style/ActionButton.White"/>
    <ImageView
        android:id="@+id/search_query_iv_icon_left"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/search_query_iv_icon_right"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent_themed"
        style="@style/ActionButton.White"/>
    <ImageView
        android:id="@+id/iv_icon_search_expand"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_search_outline_28"
        android:contentDescription="@string/search"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/search_query_iv_icon_left"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent_themed"
        style="@style/ActionButton.White"/>
    <TextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/tv_icon_right_badge"
        android:background="@drawable/vk_superapp_counter_bg_9"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="18dp"
        android:minHeight="18dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:layout_marginEnd="2dp"
        android:backgroundTint="?attr/vk_ui_accent_red"
        app:layout_constraintEnd_toEndOf="@+id/search_query_iv_icon_right"
        app:layout_constraintTop_toTopOf="@+id/search_query_iv_icon_right"
        style="@style/VkUiTypography.Caption1"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/right_text_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
