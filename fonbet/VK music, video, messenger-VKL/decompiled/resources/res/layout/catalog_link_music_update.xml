<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="start"
    android:background="@drawable/music_selectable_bg"
    android:paddingTop="16dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/catalog_link_music_update_icon_size"
        android:layout_height="@dimen/catalog_link_music_update_icon_size"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/vk_black_alpha8"
        app:roundingBorderWidth="@dimen/catalog_border_width"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:gravity="start|center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintEnd_toStartOf="@+id/chevron"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:singleLine="true"
            android:lineSpacingExtra="4sp"
            android:fontFamily="@font/vk_roboto_medium"
            android:layout_marginStart="8dp"
            app:vk_layout_isFluid="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalog_link_music_owner_separator"
            android:maxLines="1"
            android:lineSpacingExtra="4sp"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingExtra="4sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <ImageView
        android:id="@+id/chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/icon"
        app:srcCompat="@drawable/vk_icon_chevron_24"
        app:tint="?attr/vk_legacy_icon_tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
