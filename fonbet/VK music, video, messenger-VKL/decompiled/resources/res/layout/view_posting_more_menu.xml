<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteCaps"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/title_photo_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="@string/posting_photo_and_video"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/separator"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/photo_vk"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_main_height"
        android:layout_marginTop="9dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/album_vk"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_photo_video"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/album_vk"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_main_height"
        android:layout_marginTop="9dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toStartOf="@+id/video_vk"
        app:layout_constraintStart_toEndOf="@+id/photo_vk"
        app:layout_constraintTop_toBottomOf="@+id/title_photo_video"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/video_vk"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_main_height"
        android:layout_marginTop="9dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/album_vk"
        app:layout_constraintTop_toBottomOf="@+id/title_photo_video"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/br_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="video_vk, album_vk,photo_vk"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteCaps"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/title_other"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/posting_menu_other"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/br_primary"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/place"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_other_height"
        android:layout_marginTop="9dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/poll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_other"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/poll"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_other_height"
        android:layout_marginTop="9dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/place"
        app:layout_constraintTop_toBottomOf="@+id/title_other"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/br_place_poll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="place, poll"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/article"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_other_height"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/document"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/br_place_poll"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/document"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_other_height"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/article"
        app:layout_constraintTop_toBottomOf="@+id/br_place_poll"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/br_article_document"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="article, document"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/service"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_other_height"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/product"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/br_article_document"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/product"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_other_height"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/service"
        app:layout_constraintTop_toBottomOf="@+id/br_article_document"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/br_service_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="service, product"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/booking"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_other_height"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/br_service_product"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.bottom.attachment.menu.PostingMoreMenuMainButtonView
        android:id="@+id/market_involvement_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/posting_more_menu_btn_other_height"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/booking"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/br_market"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="market_involvement_button"/>
    <View
        android:id="@+id/space_bottom"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/br_market"/>
</merge>
