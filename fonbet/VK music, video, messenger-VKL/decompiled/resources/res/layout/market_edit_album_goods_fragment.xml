<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appkit_loader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/market_edit_album_top_bar_compose_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/market_album_edit_main_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="market_album_edit_main_cover_image,market_album_edit_main_title_text,market_album_edit_main_prod_count_text,market_album_edit_main_edit_button,market_edit_album_products_divider"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/market_album_edit_main_cover_image"
        android:layout_width="136dp"
        android:layout_height="76dp"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/vk_ui_base_padding_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/market_edit_album_top_bar_compose_view"
        app:placeholderImage="@drawable/ic_goods_collection_56_placeholder_bordered_rounded_8"
        app:placeholderImageScaleType="fitXY"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_ui_text_title_color"
        android:ellipsize="end"
        android:id="@+id/market_album_edit_main_title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/vk_ui_spacing_size_xl"
        app:layout_constraintBottom_toTopOf="@+id/market_album_edit_main_prod_count_text"
        app:layout_constraintEnd_toStartOf="@+id/market_album_edit_main_edit_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/market_album_edit_main_cover_image"
        app:layout_constraintTop_toTopOf="@+id/market_album_edit_main_cover_image"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/market_album_edit_main_prod_count_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/vk_ui_spacing_size_xl"
        app:layout_constraintBottom_toBottomOf="@+id/market_album_edit_main_cover_image"
        app:layout_constraintEnd_toStartOf="@+id/market_album_edit_main_edit_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/market_album_edit_main_cover_image"
        app:layout_constraintTop_toBottomOf="@+id/market_album_edit_main_title_text"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Footnote"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/market_album_edit_main_edit_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/edit"
        android:layout_marginEnd="@dimen/vk_ui_base_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/market_album_edit_main_cover_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/market_album_edit_main_cover_image"
        app:srcCompat="@drawable/vk_icon_edit_outline_28"
        app:tint="?attr/vk_ui_text_accent"/>
    <com.vk.core.view.components.tabs.VkTabs
        android:id="@+id/market_edit_album_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/market_edit_album_products_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/market_album_edit_main_cover_image"
        app:tabsLayoutMode="tabsLayoutFixed"
        app:tabsMode="tabsModeDefault"/>
    <com.vk.core.view.components.divider.VkDivider
        android:id="@+id/market_edit_album_products_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="7.5dp"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_m"
        android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/market_edit_album_tabs"/>
    <com.vk.core.view.components.search.VkSearchView
        android:id="@+id/search_view"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/market_edit_album_products_divider"/>
    <FrameLayout
        android:id="@+id/appkit_loader_content"
        android:background="?attr/vk_ui_header_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/market_edit_album_save_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_view">
        <include
            android:id="@+id/loading"
            layout="@layout/market_edit_album_products_loading"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/content_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/market_edit_album_empty_compose_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/appkit_loader_content"
        app:layout_constraintEnd_toEndOf="@+id/appkit_loader_content"
        app:layout_constraintStart_toStartOf="@+id/appkit_loader_content"
        app:layout_constraintTop_toTopOf="@+id/appkit_loader_content"/>
    <FrameLayout
        android:id="@+id/market_edit_album_save_container"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/market_edit_album_save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/market_edit_album_save_button"
            android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
            android:layout_marginVertical="@dimen/vk_ui_spacing_size_xl"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
