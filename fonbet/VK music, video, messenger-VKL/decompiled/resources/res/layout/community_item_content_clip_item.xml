<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clip_preview_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.clips.design.view.component.video.preview.ClipRectanglePreview
        android:id="@+id/community_profile_clip_rectangle_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="0.56"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/community_profile_item_clip_overlay_restriction"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/community_profile_clip_rectangle_preview"
        app:layout_constraintEnd_toEndOf="@+id/community_profile_clip_rectangle_preview"
        app:layout_constraintStart_toStartOf="@+id/community_profile_clip_rectangle_preview"
        app:layout_constraintTop_toTopOf="@+id/community_profile_clip_rectangle_preview"
        app:vov_mode="dark"
        app:vov_size="small"/>
</androidx.constraintlayout.widget.ConstraintLayout>
