<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/padder"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline.Unscaled"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/flist_item_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:text="Pavel Durov"
        android:singleLine="true"
        android:layout_below="@+id/flist_item_photo"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
        android:textColor="?attr/vk_ui_vkontakte_color_tabbar_tablet_text_secondary"
        android:ellipsize="end"
        android:id="@+id/status"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wow status"
        android:singleLine="true"
        android:layout_below="@+id/flist_item_text"
        android:layout_alignLeft="@+id/flist_item_text"
        android:layout_alignRight="@+id/flist_item_text"/>
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/flist_item_photo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/padder"
        android:transformPivotX="0dp"
        android:transformPivotY="0dp"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@drawable/user_placeholder"/>
</RelativeLayout>
