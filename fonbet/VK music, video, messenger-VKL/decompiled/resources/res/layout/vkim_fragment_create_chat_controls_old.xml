<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            app:layout_scrollFlags="noScroll"
            app:title="@string/vkim_chat_settings_admin_controls"
            style="@style/VkIm.Toolbar.Style.LargeWithBack"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.common.view.settings.RadioSettingsViewGroup
                android:orientation="vertical"
                android:id="@+id/chat_params_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vkim_create_chat_controls_presets_margin_top">
                <com.vk.im.ui.views.settings.CheckableLabelSettingsView
                    android:id="@+id/default_chat"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:vkim_checkIconTint="?attr/vk_ui_text_accent"
                    app:vkim_titleText="@string/vkim_new_chat_default_type"
                    style="@style/VkIm.Settings.Label.Normal"/>
                <com.vk.im.ui.views.settings.CheckableLabelSettingsView
                    android:id="@+id/closed_chat"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:vkim_checkIconTint="?attr/vk_ui_text_accent"
                    app:vkim_titleText="@string/vkim_new_chat_closed_type"
                    style="@style/VkIm.Settings.Label.Normal"/>
                <com.vk.im.ui.views.settings.CheckableLabelSettingsView
                    android:id="@+id/customs_chat"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:vkim_checkIconTint="?attr/vk_ui_text_accent"
                    app:vkim_titleText="@string/vkim_new_chat_custom_type_title"
                    style="@style/VkIm.Settings.Label.Normal"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Footnote"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/params_hint"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vkim_create_chat_controls_hint_margin_top"
                    android:text="@string/vkim_new_chat_settings_description"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
                <com.vk.im.ui.views.settings.DividerSettingsView style="@style/VkIm.Settings.Divider"/>
                <TextView
                    android:id="@+id/params_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    style="@style/VkIm.Settings.SubtitleMedium"/>
            </com.vk.common.view.settings.RadioSettingsViewGroup>
            <FrameLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.vk.core.view.AppBarShadowView style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
