<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/call_by_link_media_setting_toolbar"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:titleTextColor="?attr/vk_ui_text_primary"/>
    <View
        android:id="@+id/call_by_link_media_setting_toolbar_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/call_by_link_media_setting_toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/call_by_link_media_setting_enabled_view"
        android:background="@drawable/vk_highlight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/call_by_link_media_setting_toolbar_divider">
        <RadioButton
            android:id="@+id/call_by_link_media_setting_enabled_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/vk_ui_text_title_color"
            android:id="@+id/call_by_link_media_setting_enabled_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/voip_call_by_link_setting_media_state_enabled"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/call_by_link_media_setting_enabled_radio_button"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Headline1Normal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/call_by_link_media_setting_disabled_on_join_view"
        android:background="@drawable/vk_highlight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/call_by_link_media_setting_enabled_view">
        <RadioButton
            android:id="@+id/call_by_link_media_setting_disabled_on_join_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/vk_ui_text_title_color"
            android:id="@+id/call_by_link_media_setting_disabled_on_join_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/voip_call_by_link_setting_media_state_disabled_on_join_microphone"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/call_by_link_media_setting_disabled_on_join_radio_button"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Headline1Normal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/call_by_link_media_setting_disabled_permanent_view"
        android:background="@drawable/vk_highlight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/call_by_link_media_setting_disabled_on_join_view">
        <RadioButton
            android:id="@+id/call_by_link_media_setting_disabled_permanent_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/vk_ui_text_title_color"
            android:id="@+id/call_by_link_media_setting_disabled_permanent_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/voip_call_by_link_setting_media_state_disabled_permanent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/call_by_link_media_setting_disabled_permanent_radio_button"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Headline1Normal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.core.view.components.button.VkSimpleButton
        android:layout_gravity="center"
        android:id="@+id/call_by_link_media_setting_save_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:text="@string/voip_call_by_link_setting_media_save"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/call_by_link_media_setting_disabled_permanent_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
