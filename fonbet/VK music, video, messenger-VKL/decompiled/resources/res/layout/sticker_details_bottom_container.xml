<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buy_container"
        android:background="?attr/vk_ui_background_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textStyle="normal"
            android:textColor="@color/vk_gray_500"
            android:gravity="center_horizontal"
            android:id="@+id/buy_container_notes"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vkim_stickers_pack_description"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/vkme_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vkim_install"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"
            app:icon="@drawable/vk_icon_logo_vkme_icon_28"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/usual_buy_container"
            android:background="?attr/vk_ui_background_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.vas.design.view.VkButtonCommerce
                android:id="@+id/big_button"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:buttonCommerceAppearance="positive"
                app:buttonCommerceMode="primary"
                app:buttonCommerceSizeType="large"
                app:icon="@drawable/vk_icon_add_24"
                app:iconColorful="true"/>
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/small_button"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:buttonAppearance="positive"
                app:buttonMode="primary"
                app:buttonSizeType="large"
                app:icon="@drawable/ic_gift_24_selector"
                app:iconColorful="true"/>
        </LinearLayout>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/bottom_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"
            app:buttonSizeType="medium"
            app:icon="@drawable/vk_icon_gift_outline_24"
            app:iconColorful="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/context_user_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.vk.imageloader.view.VKCircleImageView
                    android:id="@+id/context_user_avatar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/pack_buy"
                    app:layout_constraintStart_toEndOf="@+id/pack_gift"
                    app:layout_constraintTop_toTopOf="@+id/pack_buy"
                    app:placeholderImage="@drawable/user_placeholder"
                    app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
                    app:roundingBorderWidth="0.5dp"/>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/stickers_context_user_check"
                    android:layout_marginStart="12dp"
                    app:tintMode="?attr/vk_ui_icon_secondary"/>
            </FrameLayout>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:layout_gravity="top"
                android:id="@+id/context_user_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
