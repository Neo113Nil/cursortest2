<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/snippet_background"
            android:background="@color/vk_gray_850"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.75"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.music.snippet.ui.presentation.base.view.SnippetBlurBackgroundView
            android:id="@+id/snippet_background_blur_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/snippet_blur_overlay"
            android:background="@color/vk_black_alpha35"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.music.snippet.ui.presentation.base.view.SnippetLinesProgressView
            android:id="@+id/snippet_progress_view"
            android:background="@drawable/music_snippet_progress_gradient"
            android:layout_width="0dp"
            android:layout_height="46dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/snippets_horizontal_recycler"
            android:layout_width="0dp"
            android:layout_height="@dimen/music_snippet_pack_recycler_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/snippet_progress_view"/>
        <View
            android:id="@+id/snippet_bottom_shadow"
            android:background="@drawable/music_snippet_progress_gradient"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:alpha="0.5"
            android:rotation="180"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/snippets_horizontal_recycler"/>
        <View
            android:id="@+id/snippet_playlist_background"
            android:background="@color/vk_white_alpha8"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/music_playlist_open_all_playlist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/snippets_horizontal_recycler"/>
        <com.vk.music.view.ThumbsImageView
            android:id="@+id/snippet_playlist_thumb"
            android:layout_width="@dimen/music_snippet_playlist_thumb_size"
            android:layout_height="@dimen/music_snippet_playlist_thumb_size"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/snippet_playlist_background"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintStart_toStartOf="@+id/snippet_playlist_background"
            app:layout_constraintTop_toTopOf="@+id/snippet_playlist_background"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="8dp"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_song_outline_24"
            app:tiv_empty_tint="?attr/vk_ui_icon_secondary"
            app:viewAspectRatio="1"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline1Normal"
            android:textColor="@color/vk_white"
            android:ellipsize="marquee"
            android:id="@+id/snippet_playlist_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toStartOf="@+id/snippet_playlist_arrow"
            app:layout_constraintStart_toEndOf="@+id/snippet_playlist_thumb"
            app:layout_constraintTop_toTopOf="@+id/snippet_playlist_thumb"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/snippet_playlist_star"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:src="@drawable/vk_icon_star_circle_12"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/snippet_playlist_description"
            app:layout_constraintStart_toEndOf="@+id/snippet_playlist_thumb"
            app:layout_constraintTop_toTopOf="@+id/snippet_playlist_description"
            app:tint="@color/vk_white_alpha60"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/snippet_playlist_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:alpha="0.8"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/snippet_playlist_thumb"
            app:layout_constraintEnd_toStartOf="@+id/snippet_playlist_arrow"
            app:layout_constraintStart_toEndOf="@+id/snippet_playlist_star"
            app:layout_constraintTop_toBottomOf="@+id/snippet_playlist_name"
            app:layout_goneMarginStart="12dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/snippet_playlist_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vk_icon_chevron_24"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/snippet_playlist_background"
            app:layout_constraintEnd_toEndOf="@+id/snippet_playlist_background"
            app:layout_constraintTop_toTopOf="@+id/snippet_playlist_background"
            app:tint="@color/vk_white_alpha60"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
