<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/preview_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/msg_content_max_height"
        android:minHeight="150dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.fresco.VKEnhancedImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/vkim_accessibility_photo"
            app:imageScaleType="center_crop"/>
    </FrameLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/vk_white"
        android:id="@+id/timecode"
        android:background="@drawable/bg_timecode_video_attach"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="@+id/preview_wrapper"
        app:layout_constraintTop_toTopOf="@+id/preview_wrapper"
        style="@style/VkLegacyTypography.Caption2.Regular"/>
    <ImageView
        android:id="@+id/play_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/vk_icon_play_button_56"
        app:layout_constraintBottom_toBottomOf="@+id/preview_wrapper"
        app:layout_constraintEnd_toEndOf="@+id/preview_wrapper"
        app:layout_constraintStart_toStartOf="@+id/preview_wrapper"
        app:layout_constraintTop_toTopOf="@+id/preview_wrapper"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/restriction_icon"
        android:visibility="gone"
        android:layout_width="@dimen/vkim_external_video_restriction_icon_size"
        android:layout_height="@dimen/vkim_external_video_restriction_icon_size"
        android:tint="?attr/vk_legacy_icon_secondary"
        app:layout_constraintBottom_toTopOf="@+id/restriction_title"
        app:layout_constraintEnd_toEndOf="@+id/preview_wrapper"
        app:layout_constraintStart_toStartOf="@+id/preview_wrapper"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textColor="?attr/vk_legacy_icon_secondary"
        android:gravity="center"
        android:id="@+id/restriction_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxWidth="200dp"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="@+id/preview_wrapper"
        app:layout_constraintStart_toStartOf="@+id/preview_wrapper"
        app:layout_constraintTop_toBottomOf="@+id/restriction_icon"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preview_wrapper"
        style="@style/VkLegacyTypography.Paragraph.Regular"/>
    <com.vk.im.ui.views.msg.video.AdaptiveTimeAndStatusLayout
        android:id="@+id/platform_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <TextView
            android:id="@+id/platform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/VkLegacyTypography.Footnote.Regular"/>
    </com.vk.im.ui.views.msg.video.AdaptiveTimeAndStatusLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
