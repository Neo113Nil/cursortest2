<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/stream_description_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/video_about_description_redesign"/>
    <com.vk.libvideo.ui.VideoAuthorView
        android:id="@+id/stream_author_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stream_description_container"/>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stream_author_view">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center_vertical"
                android:id="@+id/stream_likes_count"
                android:background="@drawable/video_live_like_bg"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingVertical="4dp"
                app:drawableStartCompat="@drawable/video_live_like"
                app:drawableTint="?attr/vk_ui_text_primary"
                style="@style/VkUiTypography.FootnoteMedium"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center_vertical"
                android:id="@+id/stream_viewers_count"
                android:background="@drawable/stream_small_button_bg"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="8dp"
                android:paddingVertical="4dp"
                app:drawableStartCompat="@drawable/vk_icon_user_outline_24"
                app:drawableTint="?attr/vk_ui_text_primary"
                style="@style/VkUiTypography.FootnoteMedium"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center_vertical"
                android:id="@+id/stream_category"
                android:background="@drawable/stream_small_button_bg"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:maxLines="1"
                android:drawablePadding="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="8dp"
                android:paddingVertical="4dp"
                app:drawableStartCompat="@drawable/vk_icon_cards_2_outline_24"
                app:drawableTint="?attr/vk_ui_text_primary"
                style="@style/VkUiTypography.FootnoteMedium"/>
        </LinearLayout>
    </HorizontalScrollView>
    <View
        android:id="@+id/info_block_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
