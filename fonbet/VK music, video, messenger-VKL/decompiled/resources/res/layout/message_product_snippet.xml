<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/image_container"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
        android:layout_marginVertical="@dimen/vk_ui_spacing_size_xs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.picture.VkPicture
            android:id="@+id/product_picture"
            android:visibility="visible"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:placeholderImage="@drawable/vk_icon_market_outline_20"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="@dimen/vk_ui_border_radius"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="@dimen/vk_ui_border2x"
            app:tint="?attr/vk_ui_icon_tertiary"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/hide_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/vk_icon_hide_outline_20"
            android:importantForAccessibility="no"
            app:tint="?attr/vk_ui_icon_contrast"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkFadeText
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_xs"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/subtitle_text"
        app:layout_constraintEnd_toStartOf="@+id/chevron_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/image_container"
        app:layout_constraintTop_toTopOf="@+id/image_container"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/vk_ui_typography_caption1_medium"/>
    <com.vk.core.view.components.text.VkFadeText
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/subtitle_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vk_ui_spacing_size2_xs"
        android:maxLines="1"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_xs"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/image_container"
        app:layout_constraintEnd_toStartOf="@+id/chevron_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/image_container"
        app:layout_constraintTop_toBottomOf="@+id/title_text"
        style="?attr/vk_ui_typography_caption1_medium"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/chevron_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_chevron_16"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_m"
        app:layout_constraintBottom_toBottomOf="@+id/image_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_container"
        app:tint="?attr/vk_ui_icon_contrast"/>
</merge>
