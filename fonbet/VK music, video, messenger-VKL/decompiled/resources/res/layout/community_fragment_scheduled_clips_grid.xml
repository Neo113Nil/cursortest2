<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/toolbar"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/community_scheduled_clips_grid_paginated_view_container"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <com.vk.profile.core.scheduled_clips.CommunityScheduledClipsGridPaginatedView
            android:id="@+id/community_scheduled_clips_grid_paginated_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:vk_enableItemAnimations="true"
            app:vk_errorBackgroundColor="?attr/vk_ui_background_content"
            app:vk_errorFitCenter="true"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/community_scheduled_clips_grid_paginated_view_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/community_scheduled_clips_grid_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/community_scheduled_clips_grid_paginated_view_placeholder"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
