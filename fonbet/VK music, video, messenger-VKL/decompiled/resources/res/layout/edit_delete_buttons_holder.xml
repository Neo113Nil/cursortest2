<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/edit_delete_buttons_button_edit_post"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="6dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/edit_delete_buttons_button_delete_post"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:text="@string/post_footer_edit"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/edit_delete_buttons_button_delete_post"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="negative"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/edit_delete_buttons_button_edit_post"
        app:layout_constraintTop_toTopOf="parent"
        app:text="@string/post_footer_button_delete"/>
</androidx.constraintlayout.widget.ConstraintLayout>
