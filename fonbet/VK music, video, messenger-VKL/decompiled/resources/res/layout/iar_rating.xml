<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/no_rating_layout"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/textPrimary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/app_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/iar_app_name"
        android:singleLine="true"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/app_icon_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/app_icon_medium"
        app:layout_constraintTop_toTopOf="@+id/app_icon_medium"/>
    <ImageView
        android:id="@+id/app_icon_medium"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@mipmap/mp_launcher"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/rating_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_icon_medium"
        app:layout_constraintWidth_max="280dp"
        layout="@layout/rating_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
