<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fullscreen_ads_main_overlay_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/fullscreen_ads_top_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ClipTopGradient"/>
    <View
        android:id="@+id/fullscreen_ads_bottom_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/clip_bottom_fade_margin_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_ads_owner"/>
    <View
        android:id="@+id/fullscreen_ads_description_expanded_blackout"
        android:background="@color/clip_description_expanded_blackout_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/fullscreen_ads_side_controls_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/clips_controls_margin_bottom"
        android:contentDescription="@string/clips_accessibility_more"
        android:layout_marginHorizontal="@dimen/clips_controls_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/vk_icon_more_horizontal_shadow_medium_48"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fullscreen_subscribe_banner_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_ads_description"
        app:layout_constraintEnd_toEndOf="@+id/fullscreen_ads_side_controls_more"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/fullscreen_banner_background_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.core.view.components.cell.rich.VkRichCell
            android:id="@+id/fullscreen_subscribe_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.clips.design.view.component.user.ClipUserView
        android:id="@+id/fullscreen_ads_owner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_ads_description"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_ads_subscribe"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_ads_start_space"
        app:layout_goneMarginBottom="2dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/fullscreen_ads_subscribe"
        android:background="@drawable/bg_outline_rounded_6"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:foreground="@drawable/highlight_radius_6"
        android:text="@string/clips_subscribe"
        android:maxLines="1"
        android:paddingStart="@dimen/clip_feed_item_subscribe_button_padding_horizontal"
        android:paddingEnd="@dimen/clip_feed_item_subscribe_button_padding_horizontal"
        android:layout_marginStart="@dimen/clip_feed_item_subscribe_button_margin_start"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen_ads_owner"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_ads_end_space"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_ads_owner"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_ads_owner"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center_vertical"
        android:id="@+id/fullscreen_ads_subscribed_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:text="@string/clips_subscribed"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen_ads_owner"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_ads_end_space"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_ads_right_title_dot_separator"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_ads_owner"
        style="@style/VkUiTypography.Caption1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="end"
        android:id="@+id/fullscreen_ads_right_title_dot_separator"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="wrap_content"
        android:text="·"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen_ads_owner"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_ads_owner"
        app:layout_constraintTop_toTopOf="@+id/fullscreen_ads_owner"
        style="@style/VkUiTypography.Caption1SemiBold"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/fullscreen_ads_long_description_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.vk.clips.design.view.component.description.ClipDescription
        android:id="@+id/fullscreen_ads_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_ads_disclaimer_banner"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_ads_end_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullscreen_ads_long_description_guideline"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginBottom="10dp"
        style="@style/ClipDescriptionContainer"/>
    <com.vk.clips.tool.view.component.ads.ParentDependentHeightAppCompatImageView
        android:id="@+id/fullscreen_ads_disclaimer_banner"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_ads_disclaimer_container"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_ads_end_space"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_ads_start_space"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/fullscreen_ads_disclaimer_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_ads_action_btn_arrow_up"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_ads_end_space"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_ads_start_space"
        app:layout_goneMarginBottom="10dp">
        <com.vk.clips.design.view.component.audio.ClipsAudioToggle
            android:layout_gravity="center_vertical"
            android:id="@+id/fullscreen_ads_mute_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="-2dp"
            android:paddingVertical="4dp"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_contrast"
            android:ellipsize="marquee"
            android:layout_gravity="center_vertical"
            android:id="@+id/fullscreen_ads_disclaimer"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:layout_marginVertical="9dp"
            style="@style/VkUiTypography.Caption1Medium"/>
    </LinearLayout>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/fullscreen_ads_action_btn_arrow_up"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/fullscreen_ads_action_btn"
        app:layout_constraintEnd_toEndOf="@+id/fullscreen_ads_action_btn"
        app:layout_constraintStart_toStartOf="@+id/fullscreen_ads_action_btn"
        app:srcCompat="@drawable/vk_icon_chevron_up_20"/>
    <com.vk.core.view.tools.VkViewStub
        android:id="@+id/fullscreen_ads_action_btn"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen_ads_side_controls_more"
        app:layout_constraintStart_toEndOf="@+id/fullscreen_ads_start_space"/>
    <Space
        android:id="@+id/fullscreen_ads_start_space"
        android:layout_width="16dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/fullscreen_ads_end_space"
        android:layout_width="@dimen/clip_description_end_margin"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
