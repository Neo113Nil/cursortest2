<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:srcCompat="@drawable/vk_icon_tag_24"
        app:tint="?attr/vk_ui_vkontakte_color_icon_name"/>
    <com.vk.core.ui.fave.FaveTagViewGroup
        android:layout_gravity="center_vertical"
        android:id="@+id/pds_ft_tag_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="8dp"
        app:separatorTextColor="?attr/vk_ui_text_tertiary"
        app:separatorWidth="6dp"
        app:tagBackground="@drawable/highlight_radius_4"
        app:tagFontFamily="@string/font_family_regular"
        app:tagHorizontalPadding="2dp"
        app:tagTextColor="?attr/vk_ui_text_link_themed"
        app:tagTextSize="15sp"
        app:tagVerticalPadding="3.5dp"/>
</merge>
