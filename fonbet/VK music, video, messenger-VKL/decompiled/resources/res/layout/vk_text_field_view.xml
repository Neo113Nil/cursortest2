<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical">
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/text_field_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:lines="1"
        style="@style/VkUiTypography.Subhead"/>
    <FrameLayout
        android:id="@+id/text_field_container"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <EditText
            android:id="@+id/text_field_edittext"
            android:padding="12dp"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:lines="1"
            style="@style/VKUIEditText"/>
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/text_field_left_icon"
            android:padding="8dp"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/text_field_right_icon"
            android:padding="8dp"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
    </FrameLayout>
</merge>
