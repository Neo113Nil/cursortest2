<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_secondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="12dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/post_side_padding"
        android:paddingEnd="@dimen/post_side_padding">
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption2CapsMedium"
            android:textColor="?attr/vk_ui_text_accent"
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.5dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/date"
            app:layout_goneMarginEnd="32dp"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/button"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="160dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"
            app:layout_constraintBottom_toBottomOf="@+id/description"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:id="@+id/done_button"
            android:background="@drawable/vk_icon_done_24"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/event_change_decision"
            android:backgroundTint="?attr/vk_ui_icon_secondary"
            app:layout_constraintBottom_toBottomOf="@+id/description"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:id="@+id/separator"
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/description"/>
        <com.vk.core.view.PhotoStripView
            android:layout_gravity="center_vertical"
            android:id="@+id/photos"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="21dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/description"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:minHeight="40dp"
            android:singleLine="true"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/photos"
            app:layout_constraintTop_toBottomOf="@+id/description"
            app:layout_goneMarginStart="0dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_gravity="bottom"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</FrameLayout>
