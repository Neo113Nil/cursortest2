<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_highlight"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/title"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        style="@style/VkUiTypography.Headline1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent"
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/button"
        android:background="@drawable/vk_highlight"
        android:paddingLeft="16dp"
        android:paddingTop="1dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/vk_show_all"
        style="@style/VkUiTypography.Paragraph"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/clear_button"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/vk_accessibility_clear"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:srcCompat="@drawable/vk_ic_clear_circle"/>
</FrameLayout>
