<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/appkit_loader_root"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:background="?attr/vk_ui_header_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.imageloader.view.VKImageView
                android:id="@+id/user_icon"
                android:visibility="gone"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="11dp"
                android:contentDescription="@string/accessibility_navigation_drawer"
                android:layout_marginStart="11dp"
                app:actualImageScaleType="centerInside"
                app:placeholderImage="@drawable/user_placeholder"
                app:roundAsCircle="true"
                app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
                app:roundingBorderWidth="0.5dp"/>
            <include layout="@layout/vkim_appkit_toolbar"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/audio_msg_player_container"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ViewStub
                android:id="@+id/audio_msg_player_stub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.AppBarShadowView
                android:id="@+id/audio_msg_player_separator"
                app:vk_appbar_forceMode="separator"
                style="@style/AppBarShadow"/>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <ViewStub
        android:id="@+id/im_dialogs_list_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/vk_toolbar_behavior_scrolling"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/im_appbar_shadow"
        app:vk_appbar_forceMode="separator"
        style="@style/VkIm.VisibleShadowView"/>
    <ViewStub
        android:id="@+id/dialogs_search_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
