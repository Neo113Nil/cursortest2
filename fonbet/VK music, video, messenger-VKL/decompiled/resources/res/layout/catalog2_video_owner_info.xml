<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="10dp">
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/video_owner_avatar"
        android:padding="0.33dp"
        android:visibility="gone"
        android:layout_width="@dimen/catalog_video_owner_info_avatar_size_nft"
        android:layout_height="@dimen/catalog_video_owner_info_avatar_size_nft"
        android:layout_marginEnd="@dimen/catalog_video_owner_info_avatar_margin_end_nft"
        app:borderWidth="3dp"
        app:layout_constraintBottom_toTopOf="@+id/playlist_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:roundingBorderWidth="0.33dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/video_owner_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lines="1"
        android:drawablePadding="8dp"
        android:layout_marginStart="@dimen/catalog_video_owner_info_margin_start"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/video_lock_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_playlist_cover"
        app:layout_constraintWidth_default="wrap"
        style="@style/VkUiTypography.Title2Medium"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/video_lock_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/catalog_video_owner_info_video_lock_icon_margin_end_nft"
        app:layout_constraintBottom_toBottomOf="@+id/video_owner_title"
        app:layout_constraintEnd_toStartOf="@+id/video_owner_avatar"
        app:layout_constraintStart_toEndOf="@+id/video_owner_title"
        app:layout_constraintTop_toTopOf="@+id/video_owner_title"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/video_owner_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        android:layout_marginEnd="@dimen/catalog_video_owner_info_video_owner_subtitle_margin_end_nft"
        app:layout_constraintBottom_toTopOf="@+id/playlist_description"
        app:layout_constraintEnd_toStartOf="@+id/video_owner_avatar"
        app:layout_constraintStart_toStartOf="@+id/video_owner_title"
        app:layout_constraintTop_toBottomOf="@+id/video_owner_title"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/playlist_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="3"
        android:lines="@null"
        android:layout_marginStart="@dimen/catalog_video_owner_info_margin_start"
        android:layout_marginEnd="@dimen/catalog_video_owner_info_margin_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_owner_subtitle"
        style="@style/VkUiTypography.Subhead"/>
</androidx.constraintlayout.widget.ConstraintLayout>
