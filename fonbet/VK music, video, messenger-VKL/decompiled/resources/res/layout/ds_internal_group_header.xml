<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.core.view.components.divider.VkDivider
        android:id="@+id/ds_internal_group_header_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ds_internal_group_header_root"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ds_group_header_min_height"
        android:paddingHorizontal="@dimen/vk_ui_base_padding_horizontal">
        <FrameLayout
            android:id="@+id/ds_internal_group_header_left_layout"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ds_internal_group_header_left_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"/>
        </FrameLayout>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/ds_internal_group_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/ds_internal_group_header_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/ds_internal_group_header_title_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/ds_internal_group_header_left_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginStart="0dp"/>
        <com.vk.core.view.components.text.VkFadeText
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="none"
            android:id="@+id/ds_internal_group_header_title_fade"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ds_internal_group_header_title"
            app:layout_constraintEnd_toEndOf="@+id/ds_internal_group_header_title"
            app:layout_constraintStart_toStartOf="@+id/ds_internal_group_header_title"
            app:layout_constraintTop_toTopOf="@+id/ds_internal_group_header_title"/>
        <ImageView
            android:id="@+id/ds_internal_group_header_title_icon"
            android:visibility="gone"
            android:layout_width="@dimen/vk_ui_badge_s"
            android:layout_height="@dimen/vk_ui_badge_s"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
            app:layout_constraintBottom_toBottomOf="@+id/ds_internal_group_header_title"
            app:layout_constraintEnd_toStartOf="@+id/ds_internal_group_header_counter"
            app:layout_constraintStart_toEndOf="@+id/ds_internal_group_header_title"
            app:layout_constraintTop_toTopOf="@+id/ds_internal_group_header_title"/>
        <com.vk.core.view.components.counter.VkCounter
            android:id="@+id/ds_internal_group_header_counter"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
            app:layout_constraintBottom_toBottomOf="@+id/ds_internal_group_header_title"
            app:layout_constraintEnd_toStartOf="@+id/ds_internal_group_header_right_layout"
            app:layout_constraintStart_toEndOf="@+id/ds_internal_group_header_title_icon"
            app:layout_constraintTop_toTopOf="@+id/ds_internal_group_header_title"/>
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:id="@+id/ds_internal_group_header_number"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
            app:layout_constraintBaseline_toBaselineOf="@+id/ds_internal_group_header_title"
            app:layout_constraintEnd_toStartOf="@+id/ds_internal_group_header_right_layout"
            app:layout_constraintStart_toEndOf="@+id/ds_internal_group_header_title_icon"/>
        <TextView
            android:id="@+id/ds_internal_group_header_title_secondary_separator"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
            app:layout_constraintBottom_toBottomOf="@+id/ds_internal_group_header_title"
            app:layout_constraintEnd_toStartOf="@+id/ds_internal_group_header_title_secondary_text"
            app:layout_constraintStart_toEndOf="@+id/ds_internal_group_header_number"
            app:layout_constraintTop_toTopOf="@+id/ds_internal_group_header_title"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/ds_internal_group_header_title_secondary_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/ds_internal_group_header_title"
            app:layout_constraintEnd_toStartOf="@+id/ds_internal_group_header_right_layout"
            app:layout_constraintStart_toEndOf="@+id/ds_internal_group_header_title_secondary_separator"
            app:layout_constraintTop_toTopOf="@+id/ds_internal_group_header_title"/>
        <com.vk.core.view.components.badge.VkContentBadge
            android:id="@+id/ds_internal_group_header_title_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
            app:layout_constraintBottom_toBottomOf="@+id/ds_internal_group_header_title"
            app:layout_constraintEnd_toStartOf="@+id/ds_internal_group_header_right_layout"
            app:layout_constraintStart_toEndOf="@+id/ds_internal_group_header_title_secondary_text"
            app:layout_constraintTop_toTopOf="@+id/ds_internal_group_header_title"/>
        <ImageView
            android:id="@+id/ds_internal_group_header_subtitle_left_icon"
            android:visibility="gone"
            android:layout_width="@dimen/vk_ui_badge_x_s"
            android:layout_height="@dimen/vk_ui_badge_x_s"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="@+id/ds_internal_group_header_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/ds_internal_group_header_subtitle"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/ds_internal_group_header_title"
            app:layout_constraintTop_toTopOf="@+id/ds_internal_group_header_subtitle"/>
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="end"
            android:id="@+id/ds_internal_group_header_subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ds_internal_group_header_subtitle_right_icon"
            app:layout_constraintStart_toEndOf="@+id/ds_internal_group_header_subtitle_left_icon"
            app:layout_constraintTop_toBottomOf="@+id/ds_internal_group_header_title"
            app:layout_goneMarginStart="0dp"/>
        <ImageView
            android:id="@+id/ds_internal_group_header_subtitle_right_icon"
            android:visibility="gone"
            android:layout_width="@dimen/vk_ui_badge_x_s"
            android:layout_height="@dimen/vk_ui_badge_x_s"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
            app:layout_constraintBottom_toBottomOf="@+id/ds_internal_group_header_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/ds_internal_group_header_right_layout"
            app:layout_constraintStart_toEndOf="@+id/ds_internal_group_header_subtitle"
            app:layout_constraintTop_toTopOf="@+id/ds_internal_group_header_subtitle"/>
        <com.vk.core.tool.view.GapLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ds_internal_group_header_right_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ds_internal_group_header_right_icon_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                android:contentDescription="@null"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/ds_internal_group_header_right_extra_content"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/ds_internal_group_header_right_circle_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                android:contentDescription="@null"/>
        </com.vk.core.tool.view.GapLinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
