<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="9dp">
    <com.vk.attachpicker.stickers.post.attach.StoryAttachImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/photo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginVertical="12dp"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/vk_black_alpha8"
        app:roundingBorderWidth="0.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/vk_black"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:drawablePadding="4dp"
            android:layout_weight="1"
            android:translationY="-0.8sp"
            style="@style/VkUiTypography.SubheadMedium"/>
        <TextView
            android:textColor="@color/vk_black"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/coauthorsName"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:translationY="-0.8sp"
            android:layout_marginStart="2dp"
            style="@style/VkUiTypography.SubheadMedium"/>
    </LinearLayout>
</LinearLayout>
