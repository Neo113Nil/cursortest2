<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/appkit_loader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="3dp"
        android:outlineProvider="bounds">
        <androidx.appcompat.widget.Toolbar
            android:theme="?attr/actionBarTheme"
            android:id="@+id/toolbar"
            android:background="?attr/vk_ui_header_background"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="?attr/actionBarPopupTheme"
            style="?attr/actionBarTheme"/>
        <me.zhanghai.android.materialprogressbar.MaterialProgressBar
            android:theme="?attr/actionBarTheme"
            android:layout_gravity="bottom"
            android:id="@+id/horizontal_progress_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10000"
            android:progress="0"
            app:mpb_progressStyle="horizontal"
            app:mpb_showProgressBackground="false"
            app:mpb_useIntrinsicPadding="false"
            style="@style/Widget.MaterialProgressBar.ProgressBar.Horizontal.NoPadding"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/appkit_loader_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/loading"
            layout="@layout/appkit_loading"/>
        <include
            android:id="@+id/error"
            android:visibility="gone"
            layout="@layout/vk_error_screen"/>
        <View
            android:id="@+id/content_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/marker_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
