<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="8dp"
        android:contentDescription="@string/story_accessibility_stream_stat">
        <com.vk.core.view.MaskableFrameLayout
            android:id="@+id/liveSpectatorsMaskable"
            android:layout_width="40dp"
            android:layout_height="40dp">
            <com.vk.core.view.components.avatar.VkAvatar
                android:layout_gravity="center"
                android:id="@+id/liveSpectatorsImage"
                android:background="@drawable/highlight_circle_white"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <FrameLayout
                android:layout_gravity="center"
                android:background="@drawable/bg_live_avatar_pink"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
        </com.vk.core.view.MaskableFrameLayout>
        <View
            android:layout_gravity="bottom|right"
            android:id="@+id/liveSpectatorsVerified"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="4dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/liveSpectatorsContainer2"
        android:background="@drawable/bg_live_spectators_white_rounded"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginLeft="56dp">
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/liveSpectatorsTimeIcon"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginLeft="6dp"
            android:src="@drawable/vk_icon_clock_12"
            app:tint="@color/vk_white"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/liveSpectatorsTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:minWidth="28dp"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:breakStrategy="simple"
            style="@style/VkUiTypography.Caption2"/>
        <View
            android:background="@color/vk_white_alpha60"
            android:layout_width="0.5dp"
            android:layout_height="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/liveSpectatorsViewersIcon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/vk_icon_user_12"
            app:tint="@color/vk_white"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:id="@+id/liveSpectatorsViewers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:minWidth="12dp"
            android:maxLines="1"
            android:breakStrategy="simple"
            style="@style/VkUiTypography.Caption2"/>
    </LinearLayout>
</merge>
