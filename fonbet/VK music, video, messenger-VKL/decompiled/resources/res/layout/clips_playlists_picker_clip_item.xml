<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkPicture
        android:id="@+id/playlists_picker_clip_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="119:211"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/playlists_picker_gradient_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:background="@drawable/clips_preview_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlists_picker_gradient_guideline"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/playlists_picker_clip_count_views"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:drawablePadding="3dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:drawableLeftCompat="@drawable/vk_icon_view_12"
        app:drawableTint="?attr/vk_ui_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/playlists_picker_private"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_lock_shadow_24"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/playlists_picker_checkbox"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/accessibility_select"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/playlists_picker_shadow"
        android:background="@color/vk_black_alpha45"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/playlists_picker_clip_preview"
        app:layout_constraintEnd_toEndOf="@+id/playlists_picker_clip_preview"
        app:layout_constraintStart_toStartOf="@+id/playlists_picker_clip_preview"
        app:layout_constraintTop_toTopOf="@+id/playlists_picker_clip_preview"/>
</androidx.constraintlayout.widget.ConstraintLayout>
