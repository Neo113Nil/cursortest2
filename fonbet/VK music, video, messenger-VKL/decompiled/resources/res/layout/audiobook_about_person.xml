<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/vk_ui_background_modal">
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/header_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            style="@style/VkUiTypography.DisplayTitle2SemiBold"/>
        <View
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="?attr/vk_ui_separator_primary_alpha"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/person_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:maxLines="1"
            style="@style/VkUiTypography.DisplayTitle4SemiBold"/>
        <androidx.core.widget.NestedScrollView
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:textColorLink="?attr/vk_ui_text_link"
                android:autoLink="web"
                android:id="@+id/person_full_description_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VkUiTypography.TextNormal"/>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.cardview.widget.CardView>
