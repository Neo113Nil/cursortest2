<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/shops_badge_container"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/shops_badge_height"
    android:foreground="@drawable/highlight_radius_8"
    android:paddingStart="@dimen/shops_badge_padding_horizontal"
    android:paddingEnd="@dimen/shops_badge_padding_horizontal">
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/shops_badge_icon"
        android:layout_width="@dimen/shops_badge_icon_size"
        android:layout_height="@dimen/shops_badge_icon_size"
        android:src="@drawable/vk_icon_market_12"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/shops_badge_icon_margin_end"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.feed.tool.view.newsfeed.music.RunningLineTextView
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_contrast"
        android:id="@+id/shops_badge_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/shops_badge_title_margin_start"
        android:layout_marginEnd="@dimen/shops_badge_title_margin_end"
        style="@style/VkUiTypography.Caption1Medium"/>
</LinearLayout>
