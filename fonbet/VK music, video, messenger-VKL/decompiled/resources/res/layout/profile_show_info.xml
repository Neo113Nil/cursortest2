<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.FluidHorizontalLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_show_info"
    android:background="@drawable/item_ripple"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/vk_icon_info_20"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_show_info"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:vk_layout_isFluid="true"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/counter"
        android:background="@drawable/fragment_menu_counter_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:minWidth="18dp"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        android:backgroundTint="?attr/vk_ui_background_accent_themed"/>
</com.vk.core.tool.view.FluidHorizontalLayout>
