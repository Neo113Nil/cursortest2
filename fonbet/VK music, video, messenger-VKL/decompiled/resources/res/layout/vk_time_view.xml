<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/vk_time_first_hour_number_view"
        android:background="@drawable/vk_bg_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:minHeight="56dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="14dp"
        app:layout_constraintEnd_toStartOf="@+id/vk_time_second_hour_number_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/vk_time_second_hour_number_view"
        android:background="@drawable/vk_bg_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:minHeight="56dp"
        android:layout_marginStart="4dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="14dp"
        app:layout_constraintEnd_toStartOf="@+id/vk_time_divider_view"
        app:layout_constraintStart_toEndOf="@+id/vk_time_first_hour_number_view"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/vk_time_divider_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vk_apps_time_divider"
        android:layout_marginHorizontal="10dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/vk_time_second_hour_number_view"
        app:layout_constraintEnd_toStartOf="@+id/vk_time_first_minute_number_view"
        app:layout_constraintStart_toEndOf="@+id/vk_time_second_hour_number_view"
        app:layout_constraintTop_toTopOf="@+id/vk_time_second_hour_number_view"
        style="@style/VkUiTypography.DisplayTitle1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/vk_time_first_minute_number_view"
        android:background="@drawable/vk_bg_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:minHeight="56dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="14dp"
        app:layout_constraintEnd_toStartOf="@+id/vk_time_second_minute_number_view"
        app:layout_constraintStart_toEndOf="@+id/vk_time_divider_view"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/vk_time_second_minute_number_view"
        android:background="@drawable/vk_bg_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:minHeight="56dp"
        android:layout_marginStart="4dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vk_time_first_minute_number_view"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.DisplayTitle1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/vk_time_hours_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/vk_time_second_hour_number_view"
        app:layout_constraintStart_toStartOf="@+id/vk_time_first_hour_number_view"
        app:layout_constraintTop_toBottomOf="@+id/vk_time_second_hour_number_view"
        style="@style/VkUiTypography.Caption1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/vk_time_minutes_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/vk_time_second_minute_number_view"
        app:layout_constraintStart_toStartOf="@+id/vk_time_first_minute_number_view"
        app:layout_constraintTop_toBottomOf="@+id/vk_time_first_minute_number_view"
        style="@style/VkUiTypography.Caption1"/>
</merge>
