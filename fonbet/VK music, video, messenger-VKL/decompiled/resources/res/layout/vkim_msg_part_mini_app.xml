<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mini_app_container"
    android:paddingLeft="4dp"
    android:paddingTop="4dp"
    android:paddingRight="4dp"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.fresco.FrescoImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/mini_app_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="10dp"
        app:vkim_placeholderDrawable="?attr/vk_legacy_placeholder_icon_background"/>
    <TextView
        android:textSize="14dp"
        android:textColor="?attr/vk_legacy_text_muted"
        android:ellipsize="end"
        android:id="@+id/mini_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@string/font_family_medium"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/mini_app_image"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:ellipsize="end"
        android:id="@+id/mini_app_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@string/font_family_regular"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/mini_app_image"
        app:layout_constraintTop_toBottomOf="@+id/mini_app_title"/>
    <com.vk.core.view.TintTextView
        android:id="@+id/mini_app_btn"
        android:paddingTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:drawablePadding="5.5dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:drawableStartCompat="@drawable/vk_icon_services_16"
        app:drawableTint="?attr/vk_legacy_button_outline_foreground"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/mini_app_image"
        app:layout_constraintEnd_toStartOf="@+id/time"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/mini_app_image"
        app:layout_constraintTop_toBottomOf="@+id/mini_app_description"
        app:layout_constraintVertical_bias="1"
        style="@style/outline_button"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextSimple"
        android:id="@+id/timeAndStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
