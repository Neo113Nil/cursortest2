<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_app_bg_modal_with_rounded_corners"
    android:padding="@dimen/paddingS"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="@dimen/bottom_sheet_dialog_max_width">
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Title2"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/paddingM"
        android:paddingHorizontal="@dimen/paddingXS"
        app:layout_constraintEnd_toEndOf="@+id/connect"
        app:layout_constraintStart_toStartOf="@+id/connect"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/close"
        android:layout_width="@dimen/bottom_sheet_dialog_close_icon_size"
        android:layout_height="@dimen/bottom_sheet_dialog_close_icon_size"
        android:layout_marginTop="@dimen/bottom_sheet_dialog_close_icon_padding"
        android:scaleType="fitCenter"
        android:contentDescription="@string/close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_dismiss_24"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/paddingXXS"
        android:text="@string/dialog_tv_retranslation_suggestion_message"
        android:layout_marginHorizontal="@dimen/paddingM"
        app:layout_constraintEnd_toEndOf="@+id/connect"
        app:layout_constraintStart_toStartOf="@+id/connect"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/settings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/paddingXXS"
        android:text="@string/dialog_tv_retranslation_suggestion_button_settings"
        app:buttonAppearance="accent"
        app:buttonMode="link"
        app:buttonSizeType="small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/connect"
        android:layout_width="0dp"
        android:layout_height="@dimen/vk_ui_button_large_height"
        android:layout_marginTop="@dimen/paddingM"
        android:text="@string/dialog_tv_retranslation_suggestion_button_connect"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settings"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/pick_device"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/paddingXS"
        android:layout_marginBottom="@dimen/paddingXXS"
        android:text="@string/dialog_tv_retranslation_suggestion_button_pick_device"
        app:buttonAppearance="accent"
        app:buttonMode="link"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/connect"/>
</androidx.constraintlayout.widget.ConstraintLayout>
