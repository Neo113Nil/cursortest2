<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.group.header.VkGroupHeader
        android:id="@+id/product_card_comments_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/comments_content"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/product_card_comments_header">
        <com.vk.core.view.components.button.VkButton
            android:gravity="center"
            android:id="@+id/write_comment_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
            android:text="@string/good_comments_send_btn"
            android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/comments_rv"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size_xl"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/write_comment_btn"/>
        <com.vk.core.view.components.button.VkButton
            android:gravity="center"
            android:id="@+id/product_card_comments_show_all_reviews_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/good_comments_show_all_btn_text"
            android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
            android:layout_marginVertical="@dimen/vk_ui_spacing_size_xl"
            app:buttonAppearance="accent"
            app:buttonMode="outline"
            app:buttonSizeType="large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/comments_rv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/product_card_comments_empty_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/product_card_comments_header">
        <com.vk.core.view.components.placeholder.main.VkPlaceholder
            android:id="@+id/product_card_comments_empty_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/product_card_comments_empty_write_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/good_comments_send_btn"
            android:layout_marginHorizontal="@dimen/vk_ui_base_padding_horizontal"
            android:layout_marginVertical="@dimen/vk_ui_spacing_size_xl"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
