<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:id="@+id/fragment_external_auth_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/fragment_external_auth_progress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/fragment_external_auth_error_container"
        android:padding="32dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/fragment_external_auth_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_apps_loading_error_simple"
            android:includeFontPadding="false"
            android:freezesText="true"
            android:lineSpacingExtra="1sp"
            android:fontFamily="@font/vk_roboto_regular"/>
        <TextView
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/fragment_external_auth_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/vk_common_retry"
            android:fontFamily="@font/vk_roboto_medium"
            style="@style/VkLegacyButton.Tertiary"/>
    </LinearLayout>
</FrameLayout>
