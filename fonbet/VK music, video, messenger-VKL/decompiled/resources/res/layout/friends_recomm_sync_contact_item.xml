<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/friends_recomm_sync_item_bg"
    android:layout_width="225dp"
    android:layout_height="300dp"
    android:foreground="@drawable/highlight"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/white_oval"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:scaleType="center"
        android:importantForAccessibility="no"
        android:backgroundTint="?attr/newsfeed_import_contacts_card_icon_bg"
        app:srcCompat="@drawable/vk_icon_users_28"
        app:tint="?attr/newsfeed_import_contacts_card_icon_fg"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
        android:textColor="@color/vk_white"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="104dp"
        android:text="@string/friends_recommendations_sync_contacts_title"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
        android:textColor="@color/vk_white"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="126dp"
        android:text="@string/friends_recommendations_sync_contacts_subtitle"
        android:alpha="0.8"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteCapsMedium.Unscaled"
        android:textColor="?attr/newsfeed_import_contacts_card_button_fg"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/button"
        android:background="@drawable/friends_recomm_sync_item_button"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginBottom="12dp"
        android:text="@string/enable"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/done"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:scaleType="center"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/vk_icon_done_16"
            app:tint="@color/vk_white"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
            android:textColor="@color/vk_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/done"/>
    </LinearLayout>
</FrameLayout>
