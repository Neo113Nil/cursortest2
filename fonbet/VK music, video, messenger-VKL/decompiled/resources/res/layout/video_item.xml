<?xml version="1.0" encoding="utf-8"?>
<com.vkontakte.android.ui.widget.ForegroundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:foreground="@drawable/highlight">
    <FrameLayout
        android:id="@+id/video_image_container"
        android:layout_width="136dp"
        android:layout_height="77dp"
        android:layout_marginEnd="12dp">
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:actualImageScaleType="centerCrop"
            app:emptyImagePlaceholder="@drawable/ic_videos_placeholder"
            app:placeholderImage="@drawable/default_placeholder_2"
            app:roundedCornerRadius="2dp"/>
        <com.vk.libvideo.design.view.overlay.VideoOverlayView
            android:id="@+id/video_item_overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:vov_corner_radius="2dp"
            app:vov_size="small"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption1Medium.Unscaled"
        android:textColor="@color/vk_white"
        android:id="@+id/duration"
        android:background="@drawable/bg_video_duration_label_old"
        android:paddingLeft="4dp"
        android:paddingTop="2.5dp"
        android:paddingRight="4dp"
        android:paddingBottom="2.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_alignBottom="@+id/video_image_container"
        android:layout_marginEnd="4dp"
        android:layout_alignEnd="@+id/video_image_container"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/options"
        android:background="@drawable/highlight"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="-8dp"
        android:src="@drawable/ic_actions_small_24"
        android:scaleType="centerInside"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="-18dp"
        android:layout_alignParentEnd="true"
        app:tint="?attr/vk_ui_icon_medium"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/options"
        android:layout_toEndOf="@+id/video_image_container">
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Headline2Normal.Unscaled"
            android:textColor="?attr/vk_ui_text_muted"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:singleLine="false"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2.33dp"
            android:singleLine="true"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1.33dp"/>
    </LinearLayout>
</com.vkontakte.android.ui.widget.ForegroundRelativeLayout>
