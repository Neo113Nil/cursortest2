<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tips.TipAnchorView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/anchor"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/fl_custom_tip_container"
            android:paddingTop="@dimen/fl_custom_tip_container_padding_top"
            android:paddingBottom="@dimen/fl_custom_tip_container_padding_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/outside_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.vk.core.tips.TipAnchorView>
