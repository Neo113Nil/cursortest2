<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.search.ModernSearchView
        android:id="@+id/voip_search_movie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="38dp"
        android:layout_marginHorizontal="8dp"/>
    <ViewFlipper
        android:id="@+id/voip_select_movie_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/voip_select_movie_tabs_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.voip.ui.watchmovie.selectsource.dialog.ui.VoipActiveVideoView
                android:id="@+id/voip_watch_movie_active_video"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.VKTabLayout
                android:id="@+id/voip_select_movie_tabs"
                android:background="@color/vk_clear"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:tabGravity="fill"
                app:tabMode="scrollable"
                style="?attr/tabBarTheme"/>
            <View
                android:id="@+id/voip_tabs_separator"
                android:background="?attr/vk_ui_separator_primary"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="16dp"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/voip_movie_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/voip_search_video_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/voip_select_movie_search_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.vk.search.ui.SearchParametersBottomView
                android:layout_gravity="bottom"
                android:id="@+id/voip_search_video_filter_params"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </ViewFlipper>
</LinearLayout>
