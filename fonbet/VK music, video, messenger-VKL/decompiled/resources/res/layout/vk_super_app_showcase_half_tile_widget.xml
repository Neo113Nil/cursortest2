<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.components.card.VkCard xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/half_tile_root_view"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="106dp">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="106dp"/>
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="top|right"
        android:id="@+id/icon_image"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"/>
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="top|right"
        android:id="@+id/universal_icon_image"
        android:padding="2dp"
        android:clipToPadding="false"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_block_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/title_text_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:maxLines="2"
            android:lines="@null"
            style="@style/VkUiTypography.Title3Normal.Unscaled"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/subtitle_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:lineSpacingExtra="0dp"
            style="@style/VkUiTypography.Footnote.Unscaled"/>
    </LinearLayout>
</com.vk.core.view.components.card.VkCard>
