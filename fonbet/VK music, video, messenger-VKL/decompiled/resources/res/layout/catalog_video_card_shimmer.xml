<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.tool.view.AspectRatioFrameLayout
            android:id="@+id/video"
            android:background="@drawable/vk_bg_skeleton_0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:as_aspect_ratio="1.8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/avatar"
            android:background="@drawable/vk_bg_skeleton_round"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/desc2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/desc1"/>
        <View
            android:id="@+id/desc1"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="230dp"
            android:layout_height="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toBottomOf="@+id/video"/>
        <View
            android:id="@+id/desc2"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="153dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@+id/desc1"
            app:layout_constraintTop_toBottomOf="@+id/desc1"/>
        <View
            android:id="@+id/desc3"
            android:background="@drawable/vk_bg_skeleton_3dp"
            android:layout_width="126dp"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@+id/desc2"
            app:layout_constraintTop_toBottomOf="@+id/desc2"/>
        <View
            android:id="@+id/desc4"
            android:background="@drawable/vk_bg_skeleton_3dp"
            android:layout_width="100dp"
            android:layout_height="10dp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/desc3"
            app:layout_constraintTop_toTopOf="@+id/desc3"/>
        <View
            android:id="@+id/desc5"
            android:background="@drawable/vk_bg_skeleton_3dp"
            android:layout_width="60dp"
            android:layout_height="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="17dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/desc3"
            app:layout_constraintTop_toBottomOf="@+id/desc3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.core.view.shimmer.ShimmerFrameLayout>
