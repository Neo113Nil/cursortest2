<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_contrast_themed"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:foreground="?attr/selectableItemBackground"
    android:backgroundTint="?attr/vk_ui_background_contrast_themed"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="bottom"
        android:id="@+id/music_navigation_image_big"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:scaleType="fitEnd"
        app:actualImageScaleType="fitEnd"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/music_navigation_title_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        style="@style/VkUiTypography.FootnoteNormal"/>
</androidx.cardview.widget.CardView>
