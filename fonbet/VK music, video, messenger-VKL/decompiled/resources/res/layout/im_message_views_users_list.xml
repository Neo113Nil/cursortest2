<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/im_message_views_users_list_container"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/im_message_views_users_list_shimmer"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/im_main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/im_views_toolbar"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/im_close_btn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/close"
                app:srcCompat="@drawable/vk_icon_cancel_outline_28"
                app:tint="?attr/vk_ui_icon_accent_themed"/>
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:layout_gravity="center_vertical"
                android:id="@+id/im_views_total_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                style="@style/VkUiTypography.DisplayTitle2Medium"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/im_users_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/im_views_toolbar"
            app:layout_constraintVertical_bias="0"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/im_users_list_error_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/im_views_toolbar">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:srcCompat="@drawable/vk_icon_globe_cross_outline_56"
                app:tint="?attr/vk_ui_icon_secondary"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/im_message_loading_error"
                android:layout_marginHorizontal="32dp"
                style="@style/VkUiTypography.Headline1Normal"/>
            <com.vk.core.view.components.button.VkSimpleButton
                android:layout_gravity="center_horizontal"
                android:id="@+id/im_retry_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/im_message_loading_retry"
                app:buttonAppearance="accent"
                app:buttonMode="primary"
                app:buttonSizeType="medium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
