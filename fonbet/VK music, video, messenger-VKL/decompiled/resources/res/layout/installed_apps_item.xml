<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlight"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="@dimen/standard_list_item_padding">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/app_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="4dp"
        app:emptyImagePlaceholder="@drawable/placeholder_game_rounded"
        app:layout_constraintStart_toStartOf="parent"
        app:placeholderImage="@drawable/default_placeholder_10"
        app:roundedCornerRadius="16dp"/>
    <com.vk.superapp.ui.VkNotificationBadgeView
        android:id="@+id/notification_badge_view"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="@+id/app_icon"
        app:layout_constraintTop_toTopOf="@+id/app_icon"
        style="@style/VkNotificationBadgeView.44"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@string/font_family_regular"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/app_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/GameText.Title"/>
    <TextView
        android:textSize="13sp"
        android:id="@+id/app_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:lines="2"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/app_title"
        app:layout_constraintTop_toBottomOf="@+id/app_title"
        style="@style/GameText.Subtitle"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/app_bubble"
        android:background="@drawable/vk_games_app_item_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/vk_games_new_badge"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_roboto_medium"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/app_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
