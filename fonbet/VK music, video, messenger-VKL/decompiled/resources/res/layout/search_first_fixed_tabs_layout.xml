<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.VKTabLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/fixed_tabs"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        app:tabIndicatorFullWidth="true"
        app:tabMinWidth="?attr/tabMinWidth"
        app:tabMode="fixed"
        style="?attr/tabBarTheme"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="48dp">
        <com.vk.core.view.VKTabLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/scroll_tabs"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            app:tabIndicatorFullWidth="true"
            app:tabMinWidth="?attr/tabMinWidth"
            app:tabMode="scrollable"
            style="?attr/tabBarTheme"/>
        <FrameLayout
            android:id="@+id/tabsSeparator"
            android:layout_width="wrap_content"
            android:layout_height="48dp">
            <View
                android:layout_gravity="start"
                android:background="@drawable/search_tab_divider_gradient"
                android:layout_width="30dp"
                android:layout_height="match_parent"/>
            <View
                android:layout_gravity="start|center_vertical"
                android:background="?attr/vk_ui_separator_primary"
                android:layout_width="0.5dp"
                android:layout_height="24dp"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
