<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.vk.imageloader.view.VKOverlayImageView
        android:id="@+id/signal_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:emptyImagePlaceholder="@drawable/playlist_cover_placeholder"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="360dp"
        app:roundedCornerRadius="@dimen/music_recommended_playlist_corner_radius"/>
    <ImageView
        android:id="@+id/signal_play"
        android:background="@drawable/bg_white_circle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:scaleType="center"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/signal_banner"
        app:layout_constraintEnd_toEndOf="@+id/signal_banner"
        app:srcCompat="@drawable/vk_icon_play_32"
        app:tint="@color/vk_black"/>
    <TextView
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/signal_month"
        android:background="@drawable/bg_signal_month"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:drawablePadding="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="@+id/signal_banner"
        app:layout_constraintTop_toTopOf="@+id/signal_banner"
        style="@style/VkUiTypography.DisplayTitle2"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle1SemiBold"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/signal_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signal_banner"/>
</androidx.constraintlayout.widget.ConstraintLayout>
