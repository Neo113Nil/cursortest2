<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/root_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Title2"
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:textAlignment="center"
            android:layout_marginHorizontal="16dp"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_question_subhead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:textAlignment="center"
            android:layout_marginHorizontal="16dp"/>
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/question_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="@drawable/bg_rounded_8_stroke_05"
            android:scaleType="centerCrop"
            android:layout_marginHorizontal="16dp"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/answers_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.vk.feed.design.view.newsfeed.ads_mytarget.bls.MyTargetAdSurveyButtonsView
            android:layout_gravity="bottom"
            android:id="@+id/buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp"/>
    </LinearLayout>
</merge>
