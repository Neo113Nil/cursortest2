<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.ImAvatarView
        android:layout_gravity="center"
        android:id="@+id/avatar"
        android:layout_width="@dimen/vkim_chat_message_avatar_container_size"
        android:layout_height="@dimen/vkim_chat_message_avatar_container_size"
        android:layout_marginVertical="2dp"
        style="@style/VkIm.AvatarView"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginVertical="10dp">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_text_muted"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="@string/font_family_regular"/>
        <TextView
            android:textAppearance="@style/VkLegacyTypography.Footnote.Regular"
            android:textSize="13sp"
            android:textColor="?attr/vk_ui_text_negative"
            android:id="@+id/mentionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:lines="1"
        android:fontFamily="@string/font_family_regular"/>
</LinearLayout>
