<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_profile_new_v2_cover_stub_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/vk_icon_picture_outline_24"
        android:tint="?attr/vk_ui_icon_medium"
        app:layout_constraintBottom_toTopOf="@+id/video_profile_new_v2_cover_stub_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:layout_gravity="center"
        android:id="@+id/video_profile_new_v2_cover_stub_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/video_profile_cover_stub"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_profile_new_v2_cover_stub_icon"
        style="@style/VkUiTypography.Subhead"/>
</androidx.constraintlayout.widget.ConstraintLayout>
