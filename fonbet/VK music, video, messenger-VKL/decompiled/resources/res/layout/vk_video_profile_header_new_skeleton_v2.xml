<?xml version="1.0" encoding="utf-8"?>
<com.vk.superapp.ui.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_profile_header_new_v2_skeleton_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/vk_video_profile_header_v2_guideline"
    android:layout_marginStart="@dimen/vk_video_profile_header_v2_guideline"
    android:layout_marginEnd="@dimen/vk_video_profile_header_v2_guideline">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/video_profile_header_v2_skeleton_avatar"
            android:background="@drawable/white_oval"
            android:layout_width="@dimen/vk_video_profile_header_v2_avatar_size"
            android:layout_height="@dimen/vk_video_profile_header_v2_avatar_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Space
            android:id="@+id/video_profile_header_v2_skeleton_avatar_anchor"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/video_profile_header_v2_skeleton_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/video_profile_header_v2_skeleton_avatar"
            app:layout_constraintTop_toTopOf="@+id/video_profile_header_v2_skeleton_avatar"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_title"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="184dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toTopOf="@+id/video_profile_header_v2_skeleton_avatar_anchor"
            app:layout_constraintStart_toStartOf="@+id/video_profile_header_v2_skeleton_avatar_anchor"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_intertitle_1"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="95dp"
            android:layout_height="12dp"
            app:layout_constraintStart_toStartOf="@+id/video_profile_header_v2_skeleton_avatar_anchor"
            app:layout_constraintTop_toBottomOf="@+id/video_profile_header_v2_skeleton_avatar_anchor"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_intertitle_2"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="95dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@+id/video_profile_header_v2_skeleton_intertitle_1"
            app:layout_constraintTop_toTopOf="@+id/video_profile_header_v2_skeleton_intertitle_1"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_subtitle_1"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="199dp"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/video_profile_header_v2_skeleton_avatar"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_subtitle_2"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="123dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@+id/video_profile_header_v2_skeleton_subtitle_1"
            app:layout_constraintTop_toTopOf="@+id/video_profile_header_v2_skeleton_subtitle_1"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_subtitle_3"
            android:background="@drawable/vk_video_skeleton_background_rectangle_4dp"
            android:layout_width="95dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toStartOf="@+id/video_profile_header_v2_skeleton_subtitle_1"
            app:layout_constraintTop_toBottomOf="@+id/video_profile_header_v2_skeleton_subtitle_1"/>
        <View
            android:id="@+id/video_profile_header_v2_skeleton_subscribe_button"
            android:background="@drawable/vk_video_skeleton_background_rectangle_10dp"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/video_profile_header_v2_skeleton_subtitle_3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
