<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.vk.lists.CustomSwipeRefreshLayout
        android:id="@+id/content_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/vk_toolbar_behavior_scrolling">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/birthdays_list_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/vk_toolbar_behavior_scrolling"/>
    </com.vk.lists.CustomSwipeRefreshLayout>
    <FrameLayout
        android:id="@+id/loading_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.view.components.spinner.VkSpinner
            android:layout_gravity="center"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
    </FrameLayout>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/error_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/empty_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
