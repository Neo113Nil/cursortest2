<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/attach_location_settings_layout"
    android:padding="@dimen/newsfeed_newpost_permission_settings_view_top_space"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="@color/vk_gray_500"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/location_disabled"
        android:lineSpacingMultiplier="1.1"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/attach_location_settings_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/open_settings"
        android:singleLine="true"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
</LinearLayout>
