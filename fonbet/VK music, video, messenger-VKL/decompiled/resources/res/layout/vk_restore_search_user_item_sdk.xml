<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/vk_rounded_list_selector"
    android:paddingLeft="@dimen/vk_standard_list_item_padding"
    android:paddingTop="8dp"
    android:paddingRight="4dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="@dimen/vk_small_photo_size"
        android:layout_height="@dimen/vk_small_photo_size"
        android:layout_marginRight="12dp">
        <com.vk.core.ui.themes.VKReplacerView
            android:id="@+id/photo"
            android:layout_width="@dimen/vk_small_photo_size"
            android:layout_height="@dimen/vk_small_photo_size"
            android:layout_marginEnd="16dp"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/online"
            style="@style/VkOnline.Small"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/VkUiTypography.Headline1Normal"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/title"
                android:duplicateParentState="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:singleLine="true"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/verified"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"/>
        </FrameLayout>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="marquee"
            android:id="@+id/subtitle"
            android:duplicateParentState="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:drawablePadding="10dp"/>
    </LinearLayout>
</LinearLayout>
