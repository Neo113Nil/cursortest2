<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/toolbar"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/vk_ui_cell_height">
        <com.vk.attachpicker.collages.CollageOnboardingBannerView
            android:id="@+id/onboarding_banner"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/vk_ui_spacing_size_xl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.attachpicker.widget.CustomSpinner
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
            android:layout_marginBottom="@dimen/vk_ui_spacing_size2_xl"
            android:spinnerMode="dropdown"
            android:layout_marginStart="@dimen/vk_ui_spacing_size2_xl"
            android:layout_marginEnd="@dimen/vk_ui_spacing_size_s"
            android:backgroundTint="?attr/vk_ui_text_contrast"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/onboarding_banner"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size_xs"
            android:layout_marginBottom="@dimen/vk_ui_spacing_size_xl"
            android:text="@string/multiselect_mode"
            android:layout_marginEnd="@dimen/vk_ui_spacing_size2_xl"
            app:buttonAppearance="neutral"
            app:buttonMode="secondary"
            app:buttonSizeType="small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
