<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainContainer"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="@dimen/vk_landscape_vertical_banner_ad_image_side"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/ads_image_container"
        android:layout_width="@dimen/vk_landscape_vertical_banner_ad_image_side"
        android:layout_height="@dimen/vk_landscape_vertical_banner_ad_image_side"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.my.target.nativeads.views.MediaAdView
            android:id="@+id/nativeads_media_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.my.target.nativeads.views.IconAdView
            android:id="@+id/nativeads_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <View
        android:id="@+id/nativeads_icon_separator"
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/ads_image_container"
        app:layout_constraintEnd_toEndOf="@+id/ads_image_container"
        app:layout_constraintStart_toStartOf="@+id/ads_image_container"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/nativeads_advertising_info_chip"
        android:background="@drawable/vk_sticky_banner_advertising_info_chip_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:importantForAccessibility="noHideDescendants"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/banner_vk_ads_logo"
            android:padding="2dp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="2dp"
            app:srcCompat="@drawable/vk_icon_logo_vk_ads_16"
            app:tint="?attr/vk_ui_icon_contrast"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:id="@+id/nativeads_advertising_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="2dp"
            style="@style/VkUiTypography.Caption1.Unscaled"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:id="@+id/nativeads_age_restrictions"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            style="@style/VkUiTypography.Caption1.Unscaled"/>
    </LinearLayout>
    <com.my.target.nativeads.views.NativeAdChoicesView
        android:id="@+id/nativeads_ad_choices"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/nativeads_ad_choices_icon"
        app:layout_constraintEnd_toEndOf="@+id/nativeads_ad_choices_icon"
        app:layout_constraintStart_toStartOf="@+id/nativeads_ad_choices_icon"
        app:layout_constraintTop_toTopOf="@+id/nativeads_ad_choices_icon"/>
    <FrameLayout
        android:id="@+id/nativeads_ad_choices_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/vk_accessibility_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/nativeads_ad_choices_inner_icon"
            android:background="@drawable/vk_sticky_banner_ad_choice_background"
            android:padding="2dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_more_horizontal_16"
            app:tint="?attr/vk_ui_icon_contrast"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/nativeads_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ads_image_container"
        style="@style/VkUiTypography.SubheadMedium.Unscaled"/>
    <com.vk.superapp.advertisement.utils.FitFromBottomVerticalLayout
        android:id="@+id/foo_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nativeads_title">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:gravity="start"
            android:id="@+id/nativeads_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:layout_marginHorizontal="8dp"
            style="@style/VkUiTypography.Caption1.Unscaled"/>
        <LinearLayout
            android:gravity="start"
            android:orientation="horizontal"
            android:id="@+id/nativeads_rating_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="noHideDescendants"
            android:layout_marginHorizontal="8dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/vk_ui_text_subhead"
                android:id="@+id/nativeads_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                style="@style/VkUiTypography.Caption1.Unscaled"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/nativeads_rating_icon"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                app:srcCompat="@drawable/vk_icon_favorite_12"
                app:tint="?attr/vk_ui_accent_orange"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/vk_ui_text_subhead"
                android:id="@+id/nativeads_advertising_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="·"
                android:importantForAccessibility="no"
                android:layout_marginHorizontal="4dp"
                style="@style/VkUiTypography.Caption1.Unscaled"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/vk_ui_text_subhead"
                android:ellipsize="end"
                android:id="@+id/nativeads_votes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/VkUiTypography.Caption1.Unscaled"/>
        </LinearLayout>
        <com.vk.core.view.components.button.VkSimpleButton
            android:ellipsize="end"
            android:id="@+id/nativeads_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:maxLines="1"
            android:layout_marginHorizontal="8dp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="small"/>
    </com.vk.superapp.advertisement.utils.FitFromBottomVerticalLayout>
    <View
        android:background="@drawable/vk_sticky_banner_vertical_border"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/nativeads_ad_options"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
