<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/dialogs_toolbar_container_stub"
        android:inflatedId="@+id/dialogs_toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.layout.NestedCoordinatorLayout
        android:id="@+id/nested_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <ViewStub
            android:id="@+id/folders_pager_container_stub"
            android:inflatedId="@+id/folders_pager_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"/>
    </com.vk.layout.NestedCoordinatorLayout>
    <ViewStub
        android:id="@+id/audio_msg_player_container_stub"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:inflatedId="@+id/audio_msg_player_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="10dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"/>
    <ViewStub
        android:id="@+id/vkim_fab_stub"
        android:padding="14dp"
        android:inflatedId="@+id/vkim_fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="@dimen/vkim_fab_bottom_margin"
        android:tint="?attr/vk_ui_icon_accent"
        android:layout_marginEnd="16dp"
        app:backgroundTint="?attr/vk_ui_background_modal"
        app:elevation="8dp"
        app:fabCustomSize="56dp"
        app:layout_anchor="@+id/nested_coordinator"
        app:layout_anchorGravity="end|bottom"
        app:maxImageSize="28dp"
        app:srcCompat="@drawable/vk_icon_write_square_outline_28"/>
    <ViewStub
        android:id="@+id/vkim_transtion_max_banner_stub"
        android:layout="@layout/vkim_edu_max_transition_banner"
        android:inflatedId="@+id/vkim_transtion_max_banner_stub"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:elevation="8dp"
        app:layout_anchor="@+id/nested_coordinator"
        app:layout_anchorGravity="bottom|center_horizontal"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
