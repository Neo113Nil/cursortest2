<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.GapLinearLayout
        android:orientation="horizontal"
        android:id="@+id/middle_text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <com.vk.core.tool.view.GapLinearLayout
            android:orientation="vertical"
            android:id="@+id/lines_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.vk.core.view.components.cell.rich.middle.VkRichCellMiddleText
                android:id="@+id/overtitle_wrapper"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.components.cell.rich.middle.VkRichCellMiddleText
                android:gravity="center_vertical"
                android:id="@+id/title_wrapper"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.components.cell.rich.middle.VkRichCellMiddleText
                android:gravity="center_vertical"
                android:id="@+id/subtitle_wrapper"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.components.cell.rich.middle.VkRichCellMiddleText
                android:gravity="center_vertical"
                android:id="@+id/extra_subtitle_wrapper"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </com.vk.core.tool.view.GapLinearLayout>
        <com.vk.core.tool.view.GapLinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:id="@+id/meta_wrapper"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/meta_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/meta_subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </com.vk.core.tool.view.GapLinearLayout>
    </com.vk.core.tool.view.GapLinearLayout>
    <com.vk.core.view.tools.VkViewStub
        android:id="@+id/user_stack"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.tool.view.GapLinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttons_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.tools.VkViewStub
            android:id="@+id/buttons_group_first_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.tools.VkViewStub
            android:id="@+id/buttons_group_second_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.view.tools.VkViewStub
            android:id="@+id/buttons_group_third_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.vk.core.tool.view.GapLinearLayout>
</LinearLayout>
