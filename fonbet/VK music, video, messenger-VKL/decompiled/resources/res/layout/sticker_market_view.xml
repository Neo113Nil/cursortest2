<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_market_sticker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size2_xs"
        android:minWidth="144dp">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_xs"
            android:layout_marginVertical="@dimen/vk_ui_spacing_size_xs">
            <com.vk.core.view.components.picture.VkImage
                android:id="@+id/marketPhoto"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"/>
            <com.vk.core.view.components.picture.VkImageSimple
                android:layout_gravity="center"
                android:id="@+id/marketPhotoRestrictionIcon"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
            android:layout_marginEnd="@dimen/vk_ui_spacing_size_m"
            android:layout_marginVertical="9dp">
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_contrast"
                android:ellipsize="none"
                android:id="@+id/marketTitle"
                android:fadingEdgeLength="48dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:drawablePadding="12dp"
                android:requiresFadingEdge="horizontal"
                style="@style/VkUiTypography.SubheadMedium"/>
            <com.vk.core.view.components.text.VkText
                android:textColor="?attr/vk_ui_text_contrast"
                android:ellipsize="none"
                android:id="@+id/marketSubtitle"
                android:fadingEdgeLength="48dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vk_ui_spacing_size_xs"
                android:maxLines="1"
                android:singleLine="true"
                android:drawablePadding="2dp"
                android:requiresFadingEdge="horizontal"
                style="@style/VkUiTypography.Caption1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
