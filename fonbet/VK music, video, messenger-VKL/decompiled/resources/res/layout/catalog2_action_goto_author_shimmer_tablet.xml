<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:paddingHorizontal="32dp">
        <View
            android:id="@+id/title"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="135dp"
            android:layout_height="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/button"
            android:background="@drawable/vk_bg_skeleton_32"
            android:layout_width="77dp"
            android:layout_height="30dp"
            android:minWidth="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.core.view.shimmer.ShimmerFrameLayout>
