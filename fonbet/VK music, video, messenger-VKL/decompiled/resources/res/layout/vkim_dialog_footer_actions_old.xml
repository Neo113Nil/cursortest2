<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="?attr/vk_ui_background_content"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:paddingHorizontal="16dp">
    <FrameLayout
        android:id="@+id/action_delete"
        android:background="@drawable/vkui_bg_button_secondary"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp">
        <TextView
            android:textAppearance="@style/VkLegacyButton.Secondary"
            android:textColor="?attr/vk_legacy_button_secondary_destructive_foreground"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vkim_msg_action_delete"
            android:drawablePadding="4dp"
            app:drawableLeftCompat="?attr/im_ic_delete"
            app:drawableTint="?attr/vk_legacy_button_secondary_destructive_foreground"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/action_forward"
        android:background="@drawable/vkui_bg_button_secondary"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1">
        <TextView
            android:textAppearance="@style/VkLegacyButton.Secondary"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vkim_msg_action_forward"
            android:drawablePadding="4dp"
            app:drawableStartCompat="?attr/im_ic_share"
            app:drawableTint="@color/vk_secondary_button_text"/>
    </FrameLayout>
</LinearLayout>
