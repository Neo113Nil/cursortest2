<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.OverlayLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    app:overlayDrawable="@drawable/highlight_post"
    app:padOverlay="false">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <com.vk.core.view.fresco.FrescoImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/snippet_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/iv_link_state"
            android:background="@drawable/vk_icon_linked_24"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:backgroundTint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
        <TextView
            android:layout_gravity="start|top"
            android:id="@+id/tv_new_label"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_marginStart="-2dp"
            style="@style/NewLabel"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/snippet_toggle_fave"
            android:background="@drawable/highlight_circle_white"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/fave_start_button"
            android:scaleType="center"
            android:layout_marginEnd="4dp"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/snippet_actions"
            android:background="@drawable/highlight_unlimited"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:src="@drawable/vk_icon_more_vertical_shadow_24"
            android:scaleType="center"
            android:contentDescription="@string/menu"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2"
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:gravity="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vk_layout_isFluid="true">
            <com.vk.core.tool.view.FluidHorizontalLayout
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.core.view.TintTextView
                    android:textAppearance="@style/VkUiTypography.Footnote"
                    android:textStyle="normal"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="16dp"
                    android:singleLine="true"
                    android:drawablePadding="2.5dp"
                    app:drawableEndCompat="@drawable/ic_star_10"
                    app:drawableTint="?attr/vk_ui_icon_secondary"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Footnote"
                    android:textStyle="normal"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:gravity="center_vertical"
                    android:id="@+id/orders_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="16dp"
                    app:vk_layout_isFluid="true"/>
                <com.vk.newsfeed.common.views.ProductBrandLogoView
                    android:id="@+id/brand_logo"
                    android:layout_width="58dp"
                    android:layout_height="16dp"/>
            </com.vk.core.tool.view.FluidHorizontalLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <TextView
                    android:textAppearance="@style/VkUiTypography.FootnoteMedium"
                    android:textColor="?attr/vk_ui_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Footnote"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:ellipsize="end"
                    android:id="@+id/old_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginStart="7dp"/>
            </LinearLayout>
        </LinearLayout>
        <com.vk.core.view.components.button.VkSimpleButton
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            app:buttonMode="outline"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
</com.vk.core.tool.view.OverlayLinearLayout>
