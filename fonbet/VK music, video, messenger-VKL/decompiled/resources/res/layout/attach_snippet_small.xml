<?xml version="1.0" encoding="utf-8"?>
<com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attach_snippet_small_container"
    android:paddingLeft="@dimen/post_side_padding"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/post_side_padding"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:overlayDrawable="@drawable/highlight_post"
    app:padOverlay="true">
    <FrameLayout
        android:layout_width="114dp"
        android:layout_height="match_parent">
        <com.vk.core.view.fresco.FrescoImageView
            android:id="@+id/snippet_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxHeight="114dp"
            android:minHeight="80dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_link_state"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="12dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/vk_icon_linked_24"
            app:tint="@color/fave_snippet_dark_gray"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/info"
        android:background="@drawable/attach_fb_right"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="80dp"
        android:layout_marginStart="114dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/attach_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginEnd="35dp"/>
        <LinearLayout
            android:id="@+id/attach_subtitle_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="35dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/attach_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <com.vk.core.view.RatingView
                android:id="@+id/attach_rating"
                android:layout_width="88dp"
                android:layout_height="19dp"
                android:paddingStart="7dp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_primary"
                android:ellipsize="end"
                android:id="@+id/attach_review_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:paddingStart="7dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_amp"
                style="@style/AmpSmallIconStyle"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:id="@+id/attach_subsubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <com.vk.core.view.components.button.VkSimpleButton
            android:gravity="center"
            android:id="@+id/attach_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            app:buttonMode="outline"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/snippet_toggle_fave"
            android:background="@drawable/highlight_circle_white"
            android:visibility="visible"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/fave_start_button"
            android:scaleType="center"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/snippet_actions"
            android:background="@drawable/highlight_unlimited"
            android:visibility="visible"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:scaleType="center"
            app:srcCompat="@drawable/vk_icon_more_vertical_24"
            app:tint="?attr/vk_ui_separator_primary_alpha"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/attach_snippet_remove_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:src="@drawable/vk_icon_deprecated_ic_close_attach_36"
        android:contentDescription="@string/delete"
        android:layout_marginEnd="@dimen/post_side_padding_negative"/>
</com.vk.feed.tool.view.newsfeed.layout.VkFeedOverlayFrameLayout>
