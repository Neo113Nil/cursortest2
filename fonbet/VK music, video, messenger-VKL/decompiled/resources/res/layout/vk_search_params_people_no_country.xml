<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:background="?attr/vk_ui_background_content"
        android:paddingBottom="48dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <com.vk.core.view.ConstrainedLinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vk_standard_list_item_padding"
            android:paddingRight="@dimen/vk_standard_list_item_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vk_max_width="400dp">
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:text="@string/vk_discover_search_city"
                style="@style/VKUIFormHeader"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.TextNormal"
                android:id="@+id/tv_cities"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:text="@string/vk_discover_search_city"
                style="@style/VKUIFormButton"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:text="@string/vk_discover_search_gender"
                style="@style/VKUIFormHeader"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textAppearance="@style/VkUiTypography.Headline2Normal"
                    android:id="@+id/tv_any"
                    android:layout_width="0px"
                    android:layout_height="match_parent"
                    android:text="@string/vk_discover_search_gender_any"
                    android:layout_weight="1"
                    style="@style/VkLegacyButton.Selectable"/>
                <Space
                    android:layout_width="8dp"
                    android:layout_height="8dp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Headline2Normal"
                    android:id="@+id/tv_female"
                    android:layout_width="0px"
                    android:layout_height="match_parent"
                    android:text="@string/vk_discover_search_gender_female"
                    android:layout_weight="1"
                    style="@style/VkLegacyButton.Selectable"/>
                <Space
                    android:layout_width="8dp"
                    android:layout_height="8dp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Headline2Normal"
                    android:id="@+id/tv_male"
                    android:layout_width="0px"
                    android:layout_height="match_parent"
                    android:text="@string/vk_discover_search_gender_male"
                    android:layout_weight="1"
                    style="@style/VkLegacyButton.Selectable"/>
            </LinearLayout>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:text="@string/vk_discover_search_age"
                style="@style/VKUIFormHeader"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp">
                <include
                    android:id="@+id/spinner_age_from"
                    android:layout_width="0px"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    layout="@layout/vk_discover_search_spinner"/>
                <Space
                    android:layout_width="8dp"
                    android:layout_height="8dp"/>
                <include
                    android:id="@+id/spinner_age_to"
                    android:layout_width="0px"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    layout="@layout/vk_discover_search_spinner"/>
            </LinearLayout>
            <TextView
                android:textAppearance="@style/VkUiTypography.Subhead"
                android:text="@string/vk_discover_search_relationships"
                style="@style/VKUIFormHeader"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="24dp">
                <include
                    android:id="@+id/spinner_relationships"
                    android:layout_width="0px"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    layout="@layout/vk_discover_search_spinner"/>
            </LinearLayout>
            <Space
                android:layout_width="1px"
                android:layout_height="48dp"/>
        </com.vk.core.view.ConstrainedLinearLayout>
    </ScrollView>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/tv_apply_params"
        android:background="?attr/vk_ui_background_accent_themed"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_discover_search_show_result"
        style="@style/VKID.Text.Button.Primary"/>
</merge>
