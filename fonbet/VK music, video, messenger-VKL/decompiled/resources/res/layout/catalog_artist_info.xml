<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_collapseMode="parallax">
    <com.vk.imageloader.view.VKOverlayImageView
        android:id="@+id/artist_header_image"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:emptyImagePlaceholder="@drawable/artist_cover_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:overlayDrawable="@drawable/artist_cover_overlay"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="false"
        app:roundTopRight="false"
        app:roundedCornerRadius="@dimen/music_recommended_playlist_corner_radius"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Paragraph"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/subscription_state"
        android:background="@drawable/bg_artist_subscribe"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:drawablePadding="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/artist_header_image"
        app:layout_constraintStart_toStartOf="@+id/artist_header_image"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/artist_genre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/subscription_state"
        app:layout_constraintEnd_toStartOf="@+id/artist_listen_all"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/artist_header_image"/>
    <ImageView
        android:id="@+id/artist_listen_all"
        android:background="@drawable/bg_white_circle"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:scaleType="center"
        android:contentDescription="@string/music_talkback_artist_play_all"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/artist_header_image"
        app:layout_constraintEnd_toEndOf="@+id/artist_header_image"
        app:srcCompat="@drawable/vk_icon_play_36"
        app:tint="@color/vk_black"/>
</androidx.constraintlayout.widget.ConstraintLayout>
