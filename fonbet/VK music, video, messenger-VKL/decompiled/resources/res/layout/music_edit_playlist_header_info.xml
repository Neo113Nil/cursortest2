<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/playlist_image"
        android:layout_width="@dimen/music_playlist_image"
        android:layout_height="@dimen/music_playlist_image"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/music_image_corners_6"
        app:tiv_background_image="?attr/vk_ui_image_placeholder"
        app:tiv_border_width="0.5dp"
        app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="center"
        android:id="@+id/temporary_playlist_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/playlist_image"
        app:layout_constraintEnd_toEndOf="@+id/playlist_image"
        app:layout_constraintStart_toStartOf="@+id/playlist_image"
        app:layout_constraintTop_toTopOf="@+id/playlist_image"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/overlay_playlist_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/playlist_image"
        app:layout_constraintEnd_toEndOf="@+id/playlist_image"
        app:layout_constraintStart_toStartOf="@+id/playlist_image"
        app:layout_constraintTop_toTopOf="@+id/playlist_image"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/playlist_attach_photo_btn"
        android:background="@drawable/highlight_radius_6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="center"
        android:contentDescription="@string/music_talkback_playlist_cover"
        app:layout_constraintBottom_toBottomOf="@+id/playlist_image"
        app:layout_constraintEnd_toEndOf="@+id/playlist_image"
        app:layout_constraintStart_toStartOf="@+id/playlist_image"
        app:layout_constraintTop_toTopOf="@+id/playlist_image"
        app:srcCompat="@drawable/vk_icon_picture_outline_32"/>
    <TextView
        android:textAppearance="?attr/vk_ui_typography_subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/header_playlist_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/music_header_playlist_title"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playlist_image"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textAppearance="?attr/vk_ui_typography_text"
        android:id="@+id/playlist_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/music_hint_input_playlist_title"
        android:singleLine="true"
        android:maxLength="@integer/music_playlist_title_max_length"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/header_playlist_title"
        app:layout_constraintTop_toBottomOf="@+id/header_playlist_title"
        style="@style/VKUIEditText"/>
    <TextView
        android:textAppearance="?attr/vk_ui_typography_subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/header_playlist_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/music_header_playlist_description"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_image"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textAppearance="?attr/vk_ui_typography_text"
        android:id="@+id/playlist_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="86dp"
        android:hint="@string/music_hint_input_playlist_description"
        android:maxLines="4"
        android:maxLength="1024"
        app:layout_constraintEnd_toEndOf="@+id/header_playlist_description"
        app:layout_constraintStart_toStartOf="@+id/header_playlist_description"
        app:layout_constraintTop_toBottomOf="@+id/header_playlist_description"
        style="@style/VKUIEditText"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/discoverable_toggle"
        android:background="@drawable/music_selectable_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_description"/>
    <TextView
        android:textAppearance="?attr/vk_ui_typography_headline1_normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/header_playlist_chat_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_image"/>
    <TextView
        android:textAppearance="?attr/vk_ui_typography_footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/playlist_chat_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/music_playlist_chat_info"
        app:layout_constraintEnd_toEndOf="@+id/header_playlist_chat_description"
        app:layout_constraintStart_toStartOf="@+id/header_playlist_chat_description"
        app:layout_constraintTop_toBottomOf="@+id/header_playlist_chat_description"/>
    <View
        android:id="@+id/playlist_chat_separator"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:layout_marginTop="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_chat_description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
