<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/post_sticker_attachment_compact_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">
    <com.vk.attachpicker.stickers.post.attach.StoryAttachImageView
        android:id="@+id/post_sticker_attachment_compact_icon_bg"
        android:background="@drawable/bg_post_sticker_attachment_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/bg_post_sticker_attachment_icon"/>
    <ImageView
        android:id="@+id/post_sticker_attachment_compact_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/post_sticker_attachment_compact_icon_bg"
        app:layout_constraintEnd_toEndOf="@+id/post_sticker_attachment_compact_icon_bg"
        app:layout_constraintStart_toStartOf="@+id/post_sticker_attachment_compact_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/post_sticker_attachment_compact_icon_bg"
        app:srcCompat="@drawable/vk_icon_attach_24"
        app:tint="?attr/vk_ui_icon_medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/post_sticker_attachment_compact_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/post_sticker_attachment_compact_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/post_sticker_attachment_compact_icon_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="1dp"
        style="@style/VkUiTypography.ParagraphMedium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/post_sticker_attachment_compact_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/post_sticker_attachment_compact_title"
        app:layout_constraintStart_toStartOf="@+id/post_sticker_attachment_compact_title"
        app:layout_constraintTop_toBottomOf="@+id/post_sticker_attachment_compact_title"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Footnote"/>
</androidx.constraintlayout.widget.ConstraintLayout>
