<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="@dimen/toolbar_height">
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/clips_entry_point_toolbar_close_button"
        android:background="@drawable/vk_ripple_circle_highlight"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/vk_icon_cancel_outline_28"
        android:scaleType="centerInside"
        android:contentDescription="@string/close"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:layout_gravity="center_vertical"
        android:id="@+id/clips_entry_point_toolbar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/VkUiTypography.DisplayTitle1SemiBold"/>
</LinearLayout>
