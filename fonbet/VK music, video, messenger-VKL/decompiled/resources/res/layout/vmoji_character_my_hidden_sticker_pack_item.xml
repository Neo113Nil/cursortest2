<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_my_sticker_pack"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="9dp"
    android:layout_marginBottom="7dp"
    android:paddingStart="12dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="12dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_toLeftOf="@+id/more"
        android:layout_toRightOf="@+id/icon"
        android:layout_alignParentTop="true"
        android:lineSpacingExtra="1sp"
        android:fontFamily="@font/vk_roboto_medium"
        android:letterSpacing="0.01"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_toLeftOf="@+id/more"
        android:layout_toRightOf="@+id/icon"
        android:layout_below="@+id/title"
        android:lineSpacingExtra="1sp"
        android:fontFamily="@font/vk_sans_text_regular"/>
    <ImageView
        android:id="@+id/more"
        android:background="@drawable/vk_highlight_circle"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_more_horizontal_24"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/vmoji_character_accessibility_more"
        android:layout_alignParentEnd="true"
        app:tint="?attr/vk_legacy_icon_outline_secondary"/>
</RelativeLayout>
