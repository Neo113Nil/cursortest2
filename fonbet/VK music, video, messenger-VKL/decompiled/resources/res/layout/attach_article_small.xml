<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.ConstrainedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight_post">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/iv_article_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:roundedCornerRadius="4dp"/>
    <com.vk.common.view.SolidColorView
        android:id="@+id/color_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_article_toggle_fave"
        android:background="@drawable/highlight_circle_white"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/fave_start_button"
        android:scaleType="center"
        android:layout_marginEnd="4dp"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_available_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/fl_article_deleted"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/vk_icon_delete_24"
                app:tint="?attr/vk_legacy_icon_secondary"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/vk_legacy_text_secondary"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/article_deleted"
                android:layout_marginStart="28dp"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:maxLines="3"
            android:lineSpacingExtra="2sp"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/fl_read"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                style="@style/VkLegacyButton.White">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/read_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:srcCompat="@drawable/vk_icon_flash_16"
                    app:tint="@color/vk_black"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/vk_black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/read_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/article_read"
                    android:textAllCaps="true"
                    android:fontFamily="@string/font_family_medium"
                    android:layout_marginStart="20dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_listen"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="8dp"
                style="@style/VkLegacyButton.WhiteTransparent20">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/vk_white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/listen_button"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/article_listen"
                    android:textAllCaps="true"
                    android:fontFamily="@string/font_family_medium"
                    android:layout_marginStart="20dp"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_blocked_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_block_reason"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:tint="?attr/vk_legacy_icon_secondary"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_block_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="32dp"
            android:maxLines="2"
            android:lineSpacingExtra="2sp"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/attach_article_remove_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_deprecated_ic_close_attach_36"
        android:contentDescription="@string/delete"/>
</com.vk.core.view.ConstrainedFrameLayout>
