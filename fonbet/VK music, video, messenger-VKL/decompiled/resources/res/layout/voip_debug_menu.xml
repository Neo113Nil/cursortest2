<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="16dp">
    <View
        android:id="@+id/voip_call_id_separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="56dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/voip_call_id_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_debug_call_id_title"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_call_id_value"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread"
        style="@style/VkUiTypography.Headline1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/voip_call_id_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voip_call_id_separator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_call_id_title"
        style="@style/VkUiTypography.Paragraph"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/voip_call_id_copy_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="@string/voip_debug_call_id_copy"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="@+id/voip_call_id_separator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/voip_one_log_send_separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="56dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_call_id_separator"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/voip_one_log_send_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_debug_flush_one_logger_title"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voip_one_log_send_separator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_call_id_separator"
        style="@style/VkUiTypography.Headline1"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/voip_flush_one_logger"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="@string/voip_debug_flush_one_logger_button"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="@+id/voip_one_log_send_separator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_call_id_separator"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/voip_one_log_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="voip_flush_one_logger,voip_one_log_send_title,voip_one_log_send_separator"/>
    <View
        android:id="@+id/voip_request_call_dump_separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="56dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_one_log_send_separator"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/voip_request_call_dump_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_request_call_dump_title"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voip_request_call_dump_separator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_one_log_send_separator"
        style="@style/VkUiTypography.Headline1"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/voip_request_call_dump"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="@string/voip_request_call_dump_button"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="@+id/voip_request_call_dump_separator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_one_log_send_separator"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/voip_request_call_dump_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="voip_request_call_dump,voip_request_call_dump_title,voip_request_call_dump_separator"/>
    <View
        android:id="@+id/voip_header_bounds_separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="56dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_request_call_dump_separator"/>
    <androidx.appcompat.widget.SwitchCompat
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/voip_headers_bounds_switch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/voip_debug_headers_bounds"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voip_header_bounds_separator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_request_call_dump_separator"
        style="@style/VkUiTypography.Paragraph"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/voip_headers_bounds_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="voip_headers_bounds_switch,voip_header_bounds_separator"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/voip_join_options_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/voip_debug_join_options"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_join_as_group_switch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voip_header_bounds_separator"
        style="@style/VkUiTypography.Headline1"/>
    <androidx.appcompat.widget.SwitchCompat
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/voip_join_as_group_switch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voip_debug_join_option_group"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_join_as_anonymous_switch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_join_options_title"
        style="@style/VkUiTypography.Paragraph"/>
    <androidx.appcompat.widget.SwitchCompat
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/voip_join_as_anonymous_switch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/voip_debug_join_option_anonymous"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_join_with_changed_name_switch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_join_as_group_switch"
        style="@style/VkUiTypography.Paragraph"/>
    <androidx.appcompat.widget.SwitchCompat
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/voip_join_with_changed_name_switch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/voip_debug_join_option_changed_name"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_join_as_anonymous_switch"
        style="@style/VkUiTypography.Paragraph"/>
    <View
        android:id="@+id/voip_join_options_separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_use_stereo_ui"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_join_with_changed_name_switch"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/voip_join_options_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="voip_join_with_changed_name_switch,voip_join_as_anonymous_switch,voip_join_as_group_switch,voip_join_options_title,voip_join_options_separator"/>
    <androidx.appcompat.widget.SwitchCompat
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/voip_use_stereo_ui"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/voip_debug_enable_stereo_ui"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_ui_options_separator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_join_options_separator"
        style="@style/VkUiTypography.Paragraph"/>
    <View
        android:id="@+id/voip_ui_options_separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_request_close_camera_crash_switch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_use_stereo_ui"/>
    <androidx.appcompat.widget.SwitchCompat
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/voip_request_close_camera_crash_switch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/voip_request_close_camera_crash"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_crash_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_ui_options_separator"
        style="@style/VkUiTypography.Paragraph"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/voip_crash_app"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:text="@string/voip_debug_crash_application"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toTopOf="@+id/voip_sdk_nonfatal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_request_close_camera_crash_switch"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/voip_sdk_nonfatal"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:text="@string/voip_debug_nonfatal_sdk"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toTopOf="@+id/voip_force_p2p_relay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_crash_app"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/voip_force_p2p_relay"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:text="@string/voip_force_p2p_relay"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_sdk_nonfatal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
