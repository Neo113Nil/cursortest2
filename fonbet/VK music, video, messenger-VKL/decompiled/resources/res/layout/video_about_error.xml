<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginHorizontal="32dp"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:layout_gravity="center"
        android:id="@+id/tv_retry_backend"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vkvideo_try_again"
        app:buttonAppearance="overlay"
        app:buttonMode="secondary"
        app:buttonSizeType="small"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:layout_gravity="center"
        android:id="@+id/tv_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="48dp"
        app:buttonAppearance="overlay"
        app:buttonMode="tertiary"
        app:buttonSizeType="small"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/tv_offline_feed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="48dp"
        layout="@layout/offline_mode_message"/>
</LinearLayout>
