<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <com.vk.core.view.components.checkbox.VkCheckbox
        android:layout_gravity="center"
        android:id="@+id/voip_add"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:checkboxType="circle"/>
    <com.vk.voip.ui.avatars.VoipAvatarViewContainer
        android:layout_gravity="center_vertical"
        android:id="@+id/voip_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:roundAvatarSize="40dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/voip_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        style="@style/VkUiTypography.HeadlineNormal"/>
</LinearLayout>
