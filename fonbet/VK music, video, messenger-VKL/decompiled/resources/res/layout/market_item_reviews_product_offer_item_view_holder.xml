<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_view_holder_view"
        android:background="@drawable/market_item_reviews_offer_background_shape"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/item_iv"
            android:layout_width="128dp"
            android:layout_height="152dp"
            app:backgroundImage="?attr/vk_ui_image_placeholder"
            app:layout_constraintBottom_toTopOf="@+id/item_title_tv"
            app:layout_constraintEnd_toEndOf="@+id/end_image_line"
            app:layout_constraintStart_toStartOf="@+id/start_image_line"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"
            app:placeholderImage="@drawable/vk_icon_gallery_32"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="10dp"
            app:viewAspectRatio="0.83"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/start_image_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.25"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/end_image_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.75"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/item_title_tv"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/item_description_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_iv"
            style="@style/VkUiTypography.Subhead"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/item_description_tv"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lines="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/rating_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_title_tv"
            style="@style/VkUiTypography.Footnote"/>
        <com.vk.core.view.components.rating.VkDynamicRatingBar
            android:layout_gravity="center"
            android:id="@+id/rating_view"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintBottom_toTopOf="@+id/item_reviewed_message_tv"
            app:layout_constraintEnd_toEndOf="@+id/end_rating_line"
            app:layout_constraintStart_toStartOf="@+id/start_rating_line"
            app:layout_constraintTop_toBottomOf="@+id/item_description_tv"
            app:rating_size="large"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/start_rating_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.15"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/end_rating_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.85"/>
        <TextView
            android:textColor="?attr/vk_ui_accent_green"
            android:id="@+id/item_reviewed_message_tv"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/market_item_reviews_product_offer_review_sent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rating_view"
            style="@style/VkUiTypography.FootnoteMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
