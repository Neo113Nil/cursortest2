<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="start|top"
    android:orientation="vertical"
    android:id="@+id/date_container"
    android:background="@drawable/ds_gallery_date_background"
    android:layout_width="34dp"
    android:layout_height="34dp"
    android:elevation="2dp"
    android:paddingHorizontal="@dimen/vk_ui_spacing_size_xs"
    android:paddingVertical="@dimen/vk_ui_spacing_size_xs">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/day_of_month_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="center"
        style="@style/VkUiTypography.ParagraphBold.Unscaled"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/month_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:singleLine="true"
        android:textAlignment="center"
        style="@style/VkUiTypography.Caption3.Unscaled"/>
</LinearLayout>
