<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_width="@dimen/money_transfer_btn_width"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:id="@+id/fl_send_money"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/money_transfer_send"
        android:layout_weight="0.5"
        style="@style/primary_button"/>
    <View
        android:id="@+id/fl_divider"
        android:layout_width="12dp"
        android:layout_height="0dp"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/fl_request_money"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/money_transfer_request"
        android:layout_weight="0.5"
        style="@style/secondary_button"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/fl_request_money_chat"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/money_transfer_send_request"
        android:layout_weight="0.5"
        style="@style/primary_button"/>
</LinearLayout>
