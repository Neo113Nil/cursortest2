<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/voip_call_session_room_indicator"
    android:layout_width="wrap_content"
    android:layout_height="32dp">
    <TextView
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/room_name"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text=""
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        style="@style/VkLegacyTypography.Subhead1.Medium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_white"
        android:id="@+id/room_count_down_dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="·"
        android:layout_marginHorizontal="6dp"
        style="@style/VkLegacyTypography.Subhead1.Medium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vk_white"
        android:id="@+id/room_count_down"
        android:background="@drawable/bg_rectangle_corner16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="3dp"
        style="@style/VkLegacyTypography.Subhead1.Medium"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/room_leave"
        android:background="@drawable/voip_leave_room_button_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/vk_icon_door_enter_arrow_right_outline_16"
        android:scaleType="center"
        android:contentDescription="@string/voip_session_room_leave_content_description"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="2dp"
        app:tint="@color/vk_gray_800"/>
</LinearLayout>
