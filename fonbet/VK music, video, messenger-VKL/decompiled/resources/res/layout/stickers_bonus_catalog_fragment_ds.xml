<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/background"
    android:background="?attr/vk_ui_background_content"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:fitsSystemWindows="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/vk_app_bar"
            android:background="@drawable/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            app:layout_behavior="com.vk.core.view.FixAppBarLayoutBehavior"
            style="@style/VKAppBar">
            <com.vk.core.view.components.topbar.VkTopBar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.appbar.AppBarLayout>
        <com.vk.core.view.AppBarShadowView
            android:id="@+id/shadow_view"
            android:elevation="10dp"
            app:vk_appbar_allowSeparator="false"
            style="@style/AppBarShadow"/>
        <com.vk.lists.RecyclerPaginatedView
            android:id="@+id/paginated_view"
            android:background="?attr/vk_ui_background_content"
            android:paddingBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbar"
            android:layout_alignParentBottom="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/buy_container"
            android:background="@drawable/bg_bonus_shop_buy_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="4dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
            <com.vk.core.view.components.cell.VkCell
                android:id="@+id/buy_cell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.vk.core.view.components.button.VkButton
                android:layout_gravity="center_horizontal"
                android:id="@+id/buy_item_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                app:buttonAppearance="positive"
                app:buttonMode="primary"
                app:buttonSizeType="large"
                app:trailingIcon="@drawable/vk_icon_sticker_energy_product_16"/>
            <com.vk.core.view.components.text.links.VkLinkedText
                android:textAppearance="@style/VkUiTypography.Caption1"
                android:textColor="?attr/vk_ui_text_tertiary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/buy_item_offer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:text="@string/stickers_bonus_catalog_buy_offer"
                android:textAlignment="center"
                android:layout_marginHorizontal="16dp"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
