<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_cover"
        android:layout_width="0dp"
        android:layout_height="400dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_block"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_marginTop="400dp"
        android:translationZ="-1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_avatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/v_name"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_name"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginBottom="14dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/v_button_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_button_1"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_cover"
        app:layout_constraintEnd_toStartOf="@+id/v_button_2"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_button_2"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_button_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_button_1"
        app:layout_constraintTop_toTopOf="@+id/v_button_1"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_info_1"
        android:layout_width="156dp"
        android:layout_height="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_block"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/v_info_2"
        android:layout_width="156dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_info_1"/>
</merge>
