<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_black_alpha60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/progress_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.view.ColorProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:color="@color/vk_white"/>
        <Button
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/progress_cancel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/voip_broadcast_cancel"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VoipOverlay.Button.Secondary"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/error_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/error_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/vk_icon_info_circle_outline_28"
            app:tint="@color/vk_white"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="200dp"
            android:text="@string/voip_error_common"
            android:fontFamily="@font/vk_roboto_regular"
            android:letterSpacing="0.01"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/vk_white"
            android:layout_gravity="center"
            android:id="@+id/error_retry"
            android:background="@drawable/btn_white20_8dp"
            android:paddingTop="7.5dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="44dp"
            android:text="@string/voip_broadcast_retry"
            android:includeFontPadding="false"
            android:textAllCaps="false"
            android:fontFamily="@font/vk_roboto_medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <Button
            android:layout_gravity="center"
            android:id="@+id/error_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/voip_broadcast_close"
            style="@style/VoipOverlay.Button.Tertiary"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20sp"
            android:gravity="center"
            android:id="@+id/content_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/content_viewers_avatars"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/VkLegacyTypography.Title2"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/vk_white_alpha60"
            android:gravity="center"
            android:id="@+id/tv_record_subtitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/voip_broadcast_record_has_finished_description"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:letterSpacing="0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_title"/>
        <com.vk.voip.ui.view.VoipWatchersView
            android:id="@+id/content_viewers_avatars"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@+id/content_viewers_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_title"
            app:layout_constraintVertical_chainStyle="packed"
            app:voip_vwv_dividerSize="3dp"
            app:voip_vwv_extraBgColor="@color/vk_white_alpha20"
            app:voip_vwv_extraTextColor="@color/vk_white"
            app:voip_vwv_extraTextSize="14sp"
            app:voip_vwv_itemCount="3"
            app:voip_vwv_itemSize="44dp"
            app:voip_vwv_overlapSize="12dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/vk_white_alpha60"
            android:gravity="center"
            android:id="@+id/content_viewers_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:letterSpacing="0.02"
            app:layout_constraintBottom_toTopOf="@+id/content_open_stats"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_viewers_avatars"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="15sp"
            android:id="@+id/content_open_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/voip_broadcast_stats"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_viewers_info"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/VoipOverlay.Button.Tertiary"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/content_share_params_container"
            android:background="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/content_share_button"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="false"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/vk_icon_settings_28"
                app:tint="@color/vk_white"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voip_broadcast_share_settings_title"
                    style="@style/VoipOverlay.Label.Secondary"/>
                <TextView
                    android:id="@+id/content_share_params_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    style="@style/VoipOverlay.Label.Tertiary"/>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:id="@+id/btn_go_to_records"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/voip_broadcast_go_to_records"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/content_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/VoipOverlay.Button.Primary"/>
        <Button
            android:id="@+id/content_share_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/voip_broadcast_share_long"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/content_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/VoipOverlay.Button.Primary"/>
        <Button
            android:id="@+id/content_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/voip_broadcast_delete"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/VoipOverlay.Button.Secondary"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/content_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="false"
            android:contentDescription="@string/voip_broadcast_close"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_cancel_outline_28"
            app:tint="@color/vk_white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
