<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_drawing_tool_top_bar"
    android:layout_width="match_parent"
    android:layout_height="100dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="top"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageButton
            android:id="@+id/button_cancel"
            android:background="@drawable/ripple_50dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/vk_icon_cancel_28"
            android:contentDescription="@string/editor_cancel"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/vk_white"
            style="?attr/editorButtonPrimaryStyle"/>
        <ImageButton
            android:id="@+id/button_draw_undo"
            android:background="@drawable/ripple_50dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/vk_icon_arrow_uturn_left_outline_28"
            android:contentDescription="@string/drawing_undo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_draw_redo"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/button_cancel"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/vk_white"
            style="?attr/editorButtonPrimaryStyle"/>
        <ImageButton
            android:id="@+id/button_draw_redo"
            android:background="@drawable/ripple_50dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/vk_icon_arrow_uturn_right_outline_28"
            android:contentDescription="@string/drawing_redo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_apply"
            app:layout_constraintStart_toEndOf="@+id/button_draw_undo"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/vk_white"
            style="?attr/editorButtonPrimaryStyle"/>
        <ImageButton
            android:id="@+id/button_apply"
            android:background="@drawable/ripple_50dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/vk_icon_done_28"
            android:contentDescription="@string/editor_done"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/vk_white"
            style="?attr/editorButtonPrimaryStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
