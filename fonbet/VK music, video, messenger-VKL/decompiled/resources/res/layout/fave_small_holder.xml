<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/picker_white_ripple_bounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fave_small_holder_image_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/iv_fave_image"
            android:background="@drawable/bg_fave_article"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundedCornerRadius="@dimen/fave_small_holder_radius"
            app:roundingBorderColor="?attr/vk_ui_separator_primary_alpha"
            app:roundingBorderWidth="0.5dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_status_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/iv_fave_image"
            app:layout_constraintEnd_toEndOf="@+id/iv_fave_image"
            app:layout_constraintStart_toStartOf="@+id/iv_fave_image"
            app:layout_constraintTop_toTopOf="@+id/iv_fave_image"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <com.vk.libvideo.design.view.overlay.VideoOverlayView
            android:id="@+id/fave_small_holder_overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:vov_corner_radius="@dimen/fave_small_holder_radius"
            app:vov_size="small"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1Medium"
            android:textColor="@color/vk_white"
            android:layout_gravity="end|bottom"
            android:id="@+id/tv_duration"
            android:background="@drawable/fave_duration_rounded_bg"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp"/>
        <com.vk.libvideo.design.view.movika.InteractiveDurationView
            android:layout_gravity="end|bottom"
            android:id="@+id/interactive_duration"
            android:background="@drawable/bg_interactiv_video_duration_label_rounded_4"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_actions"
        android:background="@drawable/highlight_unlimited"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_actions"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1Normal"
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_description"
        app:layout_constraintEnd_toStartOf="@+id/iv_actions"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fave_small_holder_image_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/tv_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toTopOf="@+id/tv_subtitle_container"
        app:layout_constraintEnd_toStartOf="@+id/iv_actions"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tv_subtitle_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ft_tag_group"
        app:layout_constraintEnd_toStartOf="@+id/iv_actions"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_description">
        <ImageView
            android:id="@+id/iv_subtitle_state_icon"
            style="@style/AmpSmallIconStyle"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <com.vk.core.ui.fave.FaveTagViewGroup
        android:id="@+id/ft_tag_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        app:horizontalSpacing="0dp"
        app:layout_constraintBottom_toTopOf="@+id/overlay_view"
        app:layout_constraintEnd_toStartOf="@+id/iv_actions"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fave_small_holder_image_container"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle_container"
        app:separatorTextColor="@color/vk_gray_400"
        app:singleLineMode="true"
        app:tagFontFamily="@string/font_family_regular"
        app:tagHorizontalPadding="2dp"
        app:tagLineSpacingExtra="5sp"
        app:tagTextColor="?attr/vk_ui_text_secondary"
        app:tagTextSize="13sp"
        app:tagVerticalPadding="1dp"
        app:verticalSpacing="0dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/overlay_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:singleLine="true"
        android:drawablePadding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_actions"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/ft_tag_group"/>
    <ImageView
        android:id="@+id/iv_tag_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/ft_tag_group"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/ft_tag_group"
        app:srcCompat="@drawable/vk_icon_tag_12"
        app:tint="?attr/vk_ui_icon_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
