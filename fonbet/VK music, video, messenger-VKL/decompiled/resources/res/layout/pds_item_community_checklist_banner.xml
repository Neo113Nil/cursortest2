<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/vk_ui_background_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardMaxElevation="0dp"
    app:contentPaddingLeft="16dp"
    app:contentPaddingTop="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/close_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/accessibility_close"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_cancel_outline_24"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="@color/vk_ui_text_title_color"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/community_start_tips_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Headline1"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_subhead"
            android:id="@+id/caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/community_start_tips_caption"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/VkUiTypography.Footnote"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/progress_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/community_start_tips_progress"
            app:layout_constraintEnd_toStartOf="@+id/image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/caption"
            style="@style/VkUiTypography.Footnote"/>
        <com.vk.ecomm.design.view.DiscreteProgressBar
            android:id="@+id/progressBar"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="5"
            android:progress="3"
            app:activeDotColor="?attr/vk_ui_text_accent"
            app:cumulativeDots="true"
            app:dotCornerRadius="6dp"
            app:dotHeight="3dp"
            app:dotSpacing="4dp"
            app:dotWidth="14dp"
            app:inactiveDotColor="?attr/vk_ui_track_background"
            app:layout_constraintEnd_toStartOf="@+id/image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progress_title"
            app:max="12"
            app:progress="3"
            style="?android:attr/progressBarStyleHorizontal"/>
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/image"
            android:layout_width="@dimen/community_checklist_banner_image_width"
            android:layout_height="@dimen/community_checklist_banner_image_height"
            android:scaleType="centerCrop"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/close_button"
            app:layout_constraintVertical_bias="1"
            app:viewAspectRatio="1"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/open_checklist_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/community_start_tips_button_text"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
