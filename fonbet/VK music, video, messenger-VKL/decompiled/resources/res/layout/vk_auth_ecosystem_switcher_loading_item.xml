<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/ecosystem_profile_switcher_avatar_shimmer"
        android:background="@drawable/vk_bg_skeleton_round_v3"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/ecosystem_profile_switcher_title_shimmer"
        android:background="@drawable/vk_bg_skeleton_v3_4dp"
        android:layout_width="140dp"
        android:layout_height="12dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/ecosystem_profile_switcher_avatar_shimmer"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/ecosystem_profile_switcher_info_shimmer"
        android:background="@drawable/vk_bg_skeleton_v3_4dp"
        android:layout_width="100dp"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/ecosystem_profile_switcher_avatar_shimmer"
        app:layout_constraintTop_toBottomOf="@+id/ecosystem_profile_switcher_title_shimmer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
