<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:id="@+id/stickers_popup_animation_autoplay_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="2dp"
        android:text="@string/vkim_chat_theme_popup_stickers_autoplay_title"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:letterSpacing="0.01"
        app:layout_constraintBottom_toTopOf="@+id/stickers_popup_animation_autoplay_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/stickers_popup_animation_autoplay_checkbox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_legacy_icon_secondary"
        android:id="@+id/stickers_popup_animation_autoplay_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/vkim_chat_theme_popup_stickers_autoplay_subtitle"
        android:lineSpacingExtra="1sp"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/stickers_popup_animation_autoplay_title"
        app:layout_constraintStart_toStartOf="@+id/stickers_popup_animation_autoplay_title"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/stickers_popup_animation_autoplay_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/stickers_popup_animation_autoplay_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stickers_popup_animation_autoplay_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
