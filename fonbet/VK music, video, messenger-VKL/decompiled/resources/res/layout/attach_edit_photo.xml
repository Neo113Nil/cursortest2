<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="96dp"
    android:layout_height="72dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/attach_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:roundedCornerRadius="2dp"/>
    <com.vk.im.design.view.spoiler.SpoilerView
        android:id="@+id/spoiler"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:id="@+id/attach_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:layout_centerVertical="true"/>
    <TextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:id="@+id/attach_error"
        android:background="?attr/vk_ui_image_placeholder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/error"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        style="@style/VkUiTypography.Headline2Normal"/>
    <ImageView
        android:id="@+id/attach_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:importantForAccessibility="no"/>
    <ImageView
        android:id="@+id/attach_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8.5dp"
        android:layout_marginRight="-8.5dp"
        android:src="@drawable/vk_icon_deprecated_ic_deattach_28"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/vkim_accessibility_remove_attachment"/>
    <ImageView
        android:id="@+id/edit_icon"
        android:background="@drawable/bg_im_photo_editor_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/vk_icon_sliders_outline_16"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/accessibility_msg_photo_editor_badge"
        android:layout_marginEnd="4dp"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="5dp"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <ImageView
        android:id="@+id/donut"
        android:background="@drawable/bg_im_donut_color"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-4dp"
        android:src="@drawable/vk_icon_donut_color_16"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-4dp"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
