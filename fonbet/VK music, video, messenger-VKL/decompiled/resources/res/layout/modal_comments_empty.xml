<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/modal_empty_comments_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textAppearance="@style/VkUiTypography.TextMedium"
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/modal_empty_comments_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/comments_empty_title"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/modal_disabled_comments_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textAppearance="@style/VkUiTypography.TextMedium"
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/modal_disabled_comments_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="16dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"/>
        </FrameLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
