<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <com.vk.im.ui.views.avatars.ImAvatarView
        android:id="@+id/voip_caller_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/UserSmallPhoto"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_icon_chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_chevron_right_24"
        app:tint="?attr/vk_legacy_icon_tertiary"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/voip_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vkim_call_from_your_name"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/voip_description"
        app:layout_constraintEnd_toStartOf="@+id/voip_icon_chevron"
        app:layout_constraintStart_toEndOf="@+id/voip_caller_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkLegacyTypography.Headline.Regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/voip_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voip_icon_chevron"
        app:layout_constraintStart_toEndOf="@+id/voip_caller_image"
        app:layout_constraintTop_toBottomOf="@+id/voip_title"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
