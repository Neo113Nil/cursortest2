<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/voip_session_rooms_admin_configure_rooms_dialog_create"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp"
        app:title="@string/voip_session_room_admin_create_rooms_header"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:titleTextColor="@color/vk_gray_100"/>
    <View
        android:id="@+id/tool_bar_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/voip_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/voip_count_of_rooms_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/voip_session_room_admin_count_of_rooms"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/VkLegacyTypography.Subhead.Regular"/>
            <com.vk.common.view.EditText
                android:id="@+id/voip_count_of_rooms_input"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:inputType="numberDecimal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:autofillHints=""
                style="@style/VKUIEditText"/>
            <TextView
                android:textColor="@color/vk_red_light"
                android:id="@+id/session_room_count_error"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/VkLegacyTypography.Caption.Regular"/>
            <com.vk.voip.ui.view.VoipActionMultiLineView
                android:id="@+id/voip_spread_users_to_rooms_randomly_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:voip_amlv_subtitle="@string/voip_session_room_admin_spread_participants_randomly_description"
                app:voip_amlv_subtitle_max_lines="3"
                app:voip_amlv_switchVisible="true"
                app:voip_amlv_title="@string/voip_session_room_admin_spread_participants_randomly_title"
                app:voip_amlv_title_max_lines="2"
                style="@style/VoipActionMultiLineView"/>
            <com.vk.voip.ui.view.VoipActionMultiLineView
                android:id="@+id/voip_limit_working_time_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:voip_amlv_subtitle="@string/voip_session_room_admin_set_time_limit_description"
                app:voip_amlv_subtitle_max_lines="3"
                app:voip_amlv_switchVisible="true"
                app:voip_amlv_title="@string/voip_session_room_admin_set_time_limit_title"
                app:voip_amlv_title_max_lines="2"
                style="@style/VoipActionMultiLineView"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/voip_rooms_time_limit_input_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/voip_session_room_admin_set_time_limit_title"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:expandedHintEnabled="false"
                app:hintEnabled="false"
                app:suffixText="@string/voip_session_room_admin_set_time_limit_min_suffix"
                app:suffixTextColor="?attr/vk_ui_text_secondary">
                <com.vk.common.view.EditText
                    android:id="@+id/voip_rooms_time_limit_input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="@string/voip_session_room_admin_set_time_limit_min_hint"
                    android:inputType="numberDecimal"
                    style="@style/VKUIEditText"/>
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/voip_default_session_rooms_timings"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"/>
            <TextView
                android:id="@+id/create_rooms_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:text="@string/voip_session_room_admin_create_rooms_confirm"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/VkLegacyButton.Primary.Big"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
