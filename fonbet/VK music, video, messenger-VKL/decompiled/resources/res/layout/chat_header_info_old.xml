<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:padding="0dp"
    app:contentInsetEnd="8dp"
    app:contentInsetEndWithActions="4dp"
    app:contentInsetStart="0dp"
    app:contentInsetStartWithNavigation="8dp"
    app:logo="@null"
    app:navigationIcon="@null"
    app:subtitle="@null"
    app:title="@null"
    app:titleMarginStart="0dp"
    style="@style/VkIm.Toolbar.Style">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="center"
            android:id="@+id/vkim_back_button"
            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"
            android:src="@drawable/vk_icon_back_24"
            android:tint="?attr/colorAccent"
            android:contentDescription="@string/vkim_accessibility_toolbar_back_exit"
            android:tooltipText="@string/vkim_accessibility_toolbar_back_exit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/toolbarNavigationButtonStyle"/>
        <com.vk.core.view.components.counter.VkCounter
            android:layout_gravity="end|top"
            android:id="@+id/vkim_unread_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:counterAppearance="accent"
            app:counterMode="primary"
            app:counterSize="small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.78"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:background="@drawable/bg_im_chat_header_ripple"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/avatar_wrapper"
            android:background="@drawable/bg_im_chat_header_ripple"
            android:paddingTop="8dp"
            android:clipChildren="false"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:paddingStart="4dp"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/vkim_title_text"
            app:layout_constraintTop_toTopOf="parent">
            <com.vk.im.ui.views.avatars.AvatarView
                android:id="@+id/avatar_content"
                android:paddingBottom="4dp"
                android:focusable="false"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:paddingEnd="4dp"
                style="@style/VkIm.AvatarView"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/avatar_verified"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                android:translationX="1dp"
                android:translationY="3dp"/>
        </FrameLayout>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/vkim_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/subtitle_container"
            app:layout_constraintLeft_toRightOf="@+id/avatar_wrapper"
            app:layout_constraintRight_toLeftOf="@+id/title_container"
            app:layout_constraintTop_toTopOf="@+id/avatar_wrapper"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="wrap"
            style="@style/VkUiTypography.Headline1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:minHeight="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/vkim_title_text"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/vkim_title_text"
            app:layout_constraintRight_toRightOf="parent">
            <com.vk.core.view.components.badge.VkContentBadge
                android:layout_gravity="center_vertical"
                android:id="@+id/title_age_badge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                app:capsule="true"
                app:contentBadgeAppearance="neutral"
                app:contentBadgeMode="primary"
                app:contentBadgeSize="small"/>
            <com.vk.imageloader.view.VKImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_emoji"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="0dp"
                android:layout_marginStart="2dp"
                app:actualImageScaleType="centerInside"/>
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_donut"
                android:visibility="visible"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginBottom="0dp"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                android:layout_marginStart="4dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_casper"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginStart="4dp"
                app:srcCompat="@drawable/vk_icon_ghost_16"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_writing_disabled"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginStart="4dp"
                app:srcCompat="@drawable/vk_icon_message_cross_16"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_muted"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginBottom="0dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginStart="4dp"
                app:srcCompat="@drawable/vk_icon_muted_16"
                app:tint="?attr/im_dropdown_arrow_tint"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/title_dropdown"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginBottom="0dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginStart="3dp"
                app:srcCompat="@drawable/vk_icon_dropdown_16"
                app:tint="?attr/im_dropdown_arrow_tint"/>
        </LinearLayout>
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:id="@+id/subtitle_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_wrapper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/vkim_title_text"
            app:layout_constraintTop_toBottomOf="@+id/vkim_title_text"
            app:layout_constraintWidth_default="spread">
            <com.vk.superapp.ui.FixTextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:ellipsize="end"
                android:id="@+id/subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                app:vk_layout_isFluid="true"
                style="@style/VkUiTypography.Footnote"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/typing_progress"
                android:layout_width="30dp"
                android:layout_height="10dp"
                android:layout_marginBottom="2dp"
                android:scaleType="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginStart="4dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="bottom"
                android:id="@+id/subtitle_online_mobile"
                android:layout_width="8dp"
                android:layout_height="12dp"
                android:layout_marginBottom="2dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:alpha="0.4"
                android:importantForAccessibility="no"
                android:layout_marginStart="6dp"
                app:srcCompat="@drawable/vk_icon_online_mobile_12"
                app:tint="?attr/vk_ui_text_secondary"/>
        </com.vk.core.tool.view.FluidHorizontalLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.Toolbar>
