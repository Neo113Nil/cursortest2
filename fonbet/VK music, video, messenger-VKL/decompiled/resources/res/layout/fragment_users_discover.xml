<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/users_discover_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="48dp"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/ic_cancel_oval_24"
        android:scaleType="fitCenter"
        android:contentDescription="@string/accessibility_close"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginEnd="4dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle1"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:layout_gravity="start|top"
        android:id="@+id/users_discover_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/users_discover_requests_title"
        android:singleLine="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="52dp"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/users_discover_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/users_discover_complete"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:text="@string/users_discover_complete"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="large"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/users_discover_recommendations"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="68dp"
        android:text="@string/users_discover_recommendations"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/users_discover_controls_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <com.vk.core.view.components.button.VkSimpleButton
            android:gravity="center"
            android:id="@+id/users_discover_negative"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/users_discover_decline"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="large"/>
        <com.vk.core.view.components.button.VkButton
            android:gravity="center"
            android:id="@+id/users_discover_positive"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/users_discover_accept"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"/>
    </LinearLayout>
    <com.vk.friends.discover.UsersDiscoverListView
        android:layout_gravity="top"
        android:id="@+id/users_discover_list"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="122dp"/>
</FrameLayout>
