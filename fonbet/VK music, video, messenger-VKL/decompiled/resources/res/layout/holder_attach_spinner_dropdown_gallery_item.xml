<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/holder_attach_gallery_album_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:roundedCornerRadius="4dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.HeadlineNormal"
        android:ellipsize="end"
        android:layout_gravity="start|bottom"
        android:id="@+id/holder_attach_gallery_album_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/newsfeed_newpost_holder_attach_gallery_album_title_bottom_space"
        android:singleLine="true"
        android:layout_marginStart="60dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:ellipsize="end"
        android:layout_gravity="start|top"
        android:id="@+id/holder_attach_gallery_album_amount_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:singleLine="true"
        android:layout_marginStart="60dp"/>
</FrameLayout>
