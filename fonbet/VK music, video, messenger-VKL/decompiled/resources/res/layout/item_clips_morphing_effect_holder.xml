<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/morphing_effect_item"
    android:layout_width="wrap_content"
    android:layout_height="72dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center"
            android:id="@+id/photo"
            android:background="@drawable/clips_morphing_effect_background"
            android:padding="10dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:foreground="@drawable/clips_morphing_effect_foreground"
            android:contentDescription="@string/accessibility_photo"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="48dp"
        android:layout_height="24dp"/>
</LinearLayout>
