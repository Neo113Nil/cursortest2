<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.newsfeed.common.recycler.holders.zhukov.CropableImageContainer
        android:layout_gravity="center"
        android:id="@+id/cropContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/accessibility_photo"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/attached_goods_indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:src="@drawable/ic_market_12_white_with_bg"
        android:importantForAccessibility="no"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/play_button"
        android:background="@drawable/bg_gif_label"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerInside"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/vk_icon_play_24"
        app:tint="@color/vk_white"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption2"
        android:textColor="@color/vk_white"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:layout_gravity="end|bottom"
        android:id="@+id/att_doc_title"
        android:background="@drawable/bg_thumb_size"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:singleLine="true"
        android:drawablePadding="2dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"/>
</FrameLayout>
