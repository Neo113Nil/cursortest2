<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="0dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">
    <com.vk.common.view.overlay.OverlayConstraintLayout
        android:background="?attr/vk_ui_background_content"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.tool.view.AspectRatioFrameLayout
            android:id="@+id/photo_tag_preview_layout"
            android:background="?attr/vk_ui_background_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:as_aspect_ratio="1.285"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/photo_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.vk.core.tool.view.AspectRatioFrameLayout>
        <View
            android:id="@+id/album"
            android:background="@drawable/bg_photo_tag_album_skeleton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="9dp"
            android:layout_marginStart="16dp"
            app:layout_constraintDimensionRatio="360:280"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/photo_tag_preview_layout"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/album"
            app:layout_constraintTop_toBottomOf="@+id/photo_tag_preview_layout">
            <View
                android:id="@+id/title"
                android:background="@drawable/photo_flow_skeleton_rounded_background_secondary_4dp"
                android:layout_width="212dp"
                android:layout_height="20dp"/>
            <View
                android:id="@+id/source"
                android:background="@drawable/photo_flow_skeleton_rounded_background_secondary_4dp"
                android:layout_width="128dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <View
            android:id="@+id/decline"
            android:background="@drawable/photo_flow_skeleton_rounded_background_10dp"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="9dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/accept"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/album"/>
        <View
            android:id="@+id/accept"
            android:background="@drawable/photo_flow_skeleton_rounded_background_10dp"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/decline"
            app:layout_constraintTop_toTopOf="@+id/decline"/>
    </com.vk.common.view.overlay.OverlayConstraintLayout>
</androidx.cardview.widget.CardView>
