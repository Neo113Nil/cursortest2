<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_content_tint_rounded_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="left"
        android:layout_gravity="left"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/vk_icon_lock_outline_56"
            android:importantForAccessibility="no"
            app:tint="@color/vk_gray_400"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/close_profile_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="32dp"
            android:text="@string/clips_privacy_modal_bottomsheet_close_profile_label_description"
            android:drawablePadding="16dp"
            android:textAlignment="textStart"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="18dp"
            style="@style/VkUiTypography.Footnote"/>
    </LinearLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:gravity="left"
        android:layout_gravity="left"
        android:id="@+id/close_profile_go_to_settings"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="14.5dp"
        android:text="@string/clips_privacy_open_setting_btn"
        android:layout_marginStart="64dp"
        style="@style/VkUiTypography.SubheadMedium"/>
</LinearLayout>
