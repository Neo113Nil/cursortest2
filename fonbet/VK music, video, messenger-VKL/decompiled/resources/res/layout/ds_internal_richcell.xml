<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.GapLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/ds_richcell_min_height">
    <com.vk.core.view.components.cell.left.VkCellLeft
        android:layout_gravity="top"
        android:id="@+id/left_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.cell.rich.middle.VkRichCellMiddle
        android:id="@+id/middle_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <com.vk.core.view.components.cell.right.VkCellRight
        android:id="@+id/right_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.vk.core.tool.view.GapLinearLayout>
