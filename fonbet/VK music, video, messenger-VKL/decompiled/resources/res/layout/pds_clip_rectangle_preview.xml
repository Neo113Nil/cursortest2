<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/clip_content_background_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/clip_background_content_gradient"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1Medium"
        android:id="@+id/clip_badge_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:drawablePadding="4dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/clip_end_top_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/clip_start_top_icon"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:scaleType="center"
        android:importantForAccessibility="no"
        android:layout_marginStart="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/clip_end_top_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vk_white"/>
    <ImageView
        android:id="@+id/clip_end_top_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/clip_main_icon_container"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toTopOf="@+id/clip_label_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/clip_main_action_icon"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"/>
        <com.vk.clips.tool.view.component.video.ClipProgressIndicator
            android:id="@+id/clip_main_action_upload"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:upload_cancelIconSize="16dp"
            app:upload_cancelIconVisible="true"
            app:upload_lineDownScaleThreshold="22dp"
            app:upload_lineRounded="true"
            app:upload_lineWidth="2dp"
            app:upload_progressInverse="false"
            app:upload_progressMax="100"
            app:upload_progressMin="1"
            app:upload_progressMovement="false"
            app:upload_progressRadius="28dp"
            app:upload_progressValue="1"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption2"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/clip_label_primary"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:drawablePadding="4dp"
        android:breakStrategy="balanced"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clip_main_icon_container"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/clip_label_secondary"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:drawablePadding="6dp"
        android:breakStrategy="balanced"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkUiTypography.SubheadNormal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
