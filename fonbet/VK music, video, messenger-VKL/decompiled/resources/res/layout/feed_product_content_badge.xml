<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.vkblur.VkBlurView
        android:layout_gravity="center"
        android:id="@+id/badge_blur_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toEndOf="@+id/content"
        app:layout_constraintStart_toStartOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/badge_blur_stroke"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toEndOf="@+id/content"
        app:layout_constraintStart_toStartOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/vk_ui_spacing_size_xs"
        android:paddingEnd="@dimen/vk_ui_spacing_size_s"
        android:paddingVertical="@dimen/vk_ui_spacing_size_xs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/before_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/vk_ui_spacing_size2_xs"
            app:tint="?attr/vk_ui_icon_contrast"/>
        <View
            android:id="@+id/gap_before_middle"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <com.vk.core.view.components.text.VkFadeText
            android:textAppearance="?attr/vk_ui_typography_footnote"
            android:textColor="?attr/vk_ui_text_contrast"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xs"/>
        <View
            android:id="@+id/gap_middle_after"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <View
            android:gravity="center_vertical"
            android:id="@+id/after_divider"
            android:background="?attr/vk_ui_background_contrast_secondary_alpha"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/vk_ui_spacing_size2_xs"
            android:layout_marginEnd="@dimen/vk_ui_spacing_size2_xs"/>
        <View
            android:gravity="center_vertical"
            android:id="@+id/gap_divider_subtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <TextView
            android:textAppearance="?attr/vk_ui_typography_footnote"
            android:textColor="?attr/vk_ui_text_contrast"
            android:gravity="center_vertical"
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/vk_ui_spacing_size2_xs"
            android:layout_marginEnd="@dimen/vk_ui_spacing_size2_xs"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
