<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight"
    android:paddingStart="16dp">
    <FrameLayout
        android:id="@+id/past_asr_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            app:backgroundImage="?attr/vk_ui_image_placeholder_alpha"
            app:placeholderImageScaleType="center"
            app:roundedCornerRadius="6dp"
            app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
            app:roundingBorderWidth="0.5dp"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="center"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/vk_icon_articles_outline_28"
            app:tint="?attr/vk_ui_icon_accent"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Headline.Regular"
        android:textSize="16sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/past_asr_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/past_asr_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/past_asr_menu"
        app:layout_constraintStart_toEndOf="@+id/past_asr_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Caption1.Regular"
        android:textSize="13sp"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/past_asr_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="3sp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/past_asr_menu"
        app:layout_constraintStart_toEndOf="@+id/past_asr_icon"
        app:layout_constraintTop_toBottomOf="@+id/past_asr_title"/>
    <ImageView
        android:id="@+id/past_asr_menu"
        android:background="@drawable/highlight_unlimited"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:layout_margin="4dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
