<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/episode_container"
    android:background="@drawable/highlight_with_corner_6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp">
    <FrameLayout
        android:id="@+id/preview_container"
        android:background="@drawable/episode_background"
        android:layout_width="@dimen/episode_width"
        android:layout_height="@dimen/episode_height"
        app:layout_constraintBottom_toTopOf="@+id/duration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.libvideo.ui.preview.VideoSeekPreviewImage
            android:layout_gravity="center"
            android:id="@+id/preview"
            android:layout_width="@dimen/episode_width"
            android:layout_height="@dimen/episode_height"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/offline_placeholder"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_globe_cross_outline_20"
        app:layout_constraintBottom_toBottomOf="@+id/preview_container"
        app:layout_constraintEnd_toEndOf="@+id/preview_container"
        app:layout_constraintStart_toStartOf="@+id/preview_container"
        app:layout_constraintTop_toTopOf="@+id/preview_container"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <ImageView
        android:id="@+id/progress_playing"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview_container"
        app:layout_constraintEnd_toEndOf="@+id/preview_container"
        app:layout_constraintStart_toStartOf="@+id/preview_container"
        app:layout_constraintTop_toTopOf="@+id/preview_container"/>
    <TextView
        android:textColor="@color/vk_white"
        android:id="@+id/duration"
        android:background="@drawable/episode_duration_background"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preview_container"
        style="@style/VkUiTypography.Caption1Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration"
        style="@style/VkUiTypography.Caption1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
