<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/VkUiTypography.Title2Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center_horizontal"
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="@style/VkUiTypography.Subhead"/>
    <EditText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/input_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="16dp"
        android:maxLines="3"
        android:minLines="2"
        style="@style/VKUIEditText"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/ok_button"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2"
            android:textStyle="normal"
            android:textColor="?attr/vk_ui_text_accent"
            android:id="@+id/tv_negative_btn"
            android:background="@drawable/vk_highlight_radius_4"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2"
            android:textStyle="normal"
            android:textColor="@drawable/vk_selector_text_color_blue_disable"
            android:id="@+id/tv_positive_btn"
            android:background="@drawable/vk_highlight_radius_4"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
</LinearLayout>
