<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/clips_music_template_song_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:drawablePadding="7dp"
        style="@style/VkUiTypography.Headline1Medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/clips_music_template_owner_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="16dp"
        style="@style/VkUiTypography.SubheadMedium"/>
    <com.vk.clips.design.view.floatingbutton.FloatingButtonView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/clips_select_music_template"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"/>
</merge>
