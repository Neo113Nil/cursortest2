<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.crop.CropImageView
        android:id="@+id/crop_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:civ_circleCrop="true"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/done_button"
        android:background="@drawable/img_picker_btn_primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/img_picker_crop_done"
        android:singleLine="true"
        android:textAllCaps="true"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="?attr/vk_ui_header_background"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/photo_gallery_accessebility_close"
        app:navigationIcon="@drawable/ic_cancel_black"
        app:title="@string/avp_crop_photo_title"
        app:titleTextColor="?attr/vk_ui_text_primary"/>
</FrameLayout>
