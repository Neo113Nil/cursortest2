<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="154dp"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/community_profile_video_album_item_iv_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@drawable/default_placeholder_8"
        app:roundedCornerRadius="8dp"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/community_profile_video_album_item_vo_overlay"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/community_profile_video_album_item_iv_preview"
        app:layout_constraintEnd_toEndOf="@+id/community_profile_video_album_item_iv_preview"
        app:layout_constraintStart_toStartOf="@+id/community_profile_video_album_item_iv_preview"
        app:layout_constraintTop_toTopOf="@+id/community_profile_video_album_item_iv_preview"
        app:vov_corner_radius="8dp"
        app:vov_size="medium"/>
    <View
        android:id="@+id/community_profile_video_album_item_view_preview_bg"
        android:background="@drawable/community_video_album_preview_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/community_profile_video_album_item_iv_preview"
        app:layout_constraintEnd_toEndOf="@+id/community_profile_video_album_item_iv_preview"
        app:layout_constraintTop_toTopOf="@+id/community_profile_video_album_item_iv_preview"
        app:layout_constraintWidth_percent="0.3"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/community_profile_video_album_item_iv_preview_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/community_profile_video_album_item_view_preview_bg"
        app:layout_constraintEnd_toEndOf="@+id/community_profile_video_album_item_view_preview_bg"
        app:layout_constraintStart_toStartOf="@+id/community_profile_video_album_item_view_preview_bg"
        app:layout_constraintTop_toTopOf="@+id/community_profile_video_album_item_view_preview_bg"
        app:srcCompat="@drawable/vk_icon_play_next_outline_24_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
