<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlight"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">
    <com.vk.avatar.api.VKAvatarView
        android:id="@+id/reaction_holder_image_avatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline1Normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/reaction_holder_text_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/reaction_holder_image_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/reaction_holder_status_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/ic_online_web_composite_16"
        android:importantForAccessibility="no"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/reaction_holder_image_avatar"
        app:layout_constraintEnd_toEndOf="@+id/reaction_holder_image_avatar"/>
    <com.vk.reactions.view.ElevationImageView
        android:id="@+id/reaction_holder_image_reaction"
        android:visibility="gone"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:importantForAccessibility="no"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/reaction_holder_image_avatar"
        app:layout_constraintEnd_toEndOf="@+id/reaction_holder_image_avatar"
        app:placeholderImage="@drawable/user_placeholder"/>
</androidx.constraintlayout.widget.ConstraintLayout>
