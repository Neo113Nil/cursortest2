<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_contacts_outline_64"
        android:tint="?attr/vk_legacy_icon_outline_secondary"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:layout_gravity="center"
        android:id="@+id/vkim_contacts_no_contacts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/vkim_contacts_no_contacts"
        android:fontFamily="@string/font_family_medium"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_placeholder"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/vkim_contacts_no_permission_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/vkim_contacts_no_permission_label"
        android:lineSpacingExtra="1sp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp">
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/vk_legacy_accent"
            android:gravity="center"
            android:id="@+id/vkim_content"
            android:background="@drawable/bg_contacts_label"
            android:layout_width="wrap_content"
            android:layout_height="36sp"
            android:text="@string/vkim_contacts_allow_contacts_permission"
            android:fontFamily="@string/font_family_medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <com.pnikosis.materialishprogress.ProgressWheel
            android:layout_gravity="center"
            android:id="@+id/vkim_progress"
            android:layout_width="36sp"
            android:layout_height="36sp"
            app:matProg_barColor="?attr/vk_legacy_icon_outline_secondary"
            app:matProg_barWidth="3dp"
            app:matProg_progressIndeterminate="true"/>
    </FrameLayout>
</LinearLayout>
