<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/vk_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:buttonAppearance="positive"
        app:buttonMode="primary"
        app:buttonSizeType="large">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/vk_button_commerce_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/icon_start"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/gifts_btn_title"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/vk_ui_icon_contrast"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Headline1Medium"
                android:textColor="?attr/vk_ui_text_contrast"
                android:gravity="center"
                android:id="@+id/gifts_btn_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintBottom_toTopOf="@+id/gifts_btn_subtitle"
                app:layout_constraintEnd_toStartOf="@+id/discount_text"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/icon_start"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption3"
                android:textColor="?attr/vk_ui_text_contrast"
                android:gravity="center"
                android:id="@+id/gifts_btn_subtitle"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/gifts_btn_title"
                app:layout_constraintStart_toStartOf="@+id/gifts_btn_title"
                app:layout_constraintTop_toBottomOf="@+id/gifts_btn_title"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.SubheadMedium"
                android:textColor="@color/vkui_text_commerce_new"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/discount_text"
                android:background="@drawable/button_discount_background"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.vk.core.view.components.button.VkButton>
</FrameLayout>
