<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/im_contact_header"
                layout="@layout/vkim_contact_header"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/im_phone_number_container"
                android:background="@drawable/vkim_ripple_dark"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.im.ui.views.settings.LabelSettingsView
                    android:id="@+id/im_write_msg"
                    app:vkim_icon="@drawable/vk_icon_message_outline_24"
                    app:vkim_titleText="@string/vkim_write_msg"
                    style="@style/VkIm.Settings.Label.Normal"/>
                <com.vk.im.ui.views.settings.LabelSettingsView
                    android:id="@+id/im_invite_to_chat"
                    app:vkim_icon="@drawable/vk_icon_message_add_badge_outline_28"
                    app:vkim_titleText="@string/vkim_action_invite_to_chat"
                    style="@style/VkIm.Settings.Label.Normal"/>
                <com.vk.im.ui.views.settings.DividerSettingsView style="@style/VkIm.Settings.Divider"/>
                <com.vk.im.ui.views.settings.LabelSettingsView
                    android:id="@+id/im_phone_number"
                    app:vkim_icon="@drawable/vk_icon_phone_outline_28"
                    app:vkim_titleTextAppearance="@style/VkIm.Settings.TitleNormal.Accent"
                    style="@style/VkIm.Settings.Label.Normal"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/im_back"
            android:background="@drawable/vkim_ripple_circle_highlight"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="?attr/im_ic_back"
            android:scaleType="centerInside"
            android:contentDescription="@string/vkim_accessibility_back"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/vk_legacy_header_tint"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/im_edit"
            android:background="@drawable/vkim_ripple_circle_highlight"
            android:padding="12dp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_edit_outline_28"
            app:tint="?attr/vk_legacy_accent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/im_progress_container"
        android:background="?attr/vk_legacy_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.pnikosis.materialishprogress.ProgressWheel
            android:layout_gravity="center"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:matProg_barColor="?attr/vk_legacy_accent"
            app:matProg_progressIndeterminate="true"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
