<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/community_reply_status_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/community_reply_status_separator"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_width"
        android:layout_marginHorizontal="12dp"/>
    <TextView
        android:gravity="center"
        android:id="@+id/community_reply_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="6dp"
        style="@style/VkUiTypography.Subhead"/>
</LinearLayout>
