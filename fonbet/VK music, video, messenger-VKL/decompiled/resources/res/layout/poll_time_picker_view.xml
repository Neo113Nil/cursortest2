<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.TextNormal.Unscaled"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/btn_start_date"
        android:padding="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:singleLine="true"
        android:drawableRight="@drawable/vk_icon_dropdown_24"
        android:layout_weight="6"
        android:drawableTint="?attr/vk_ui_icon_secondary"/>
    <android.widget.Space
        android:layout_width="8dp"
        android:layout_height="0dp"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.TextNormal.Unscaled"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/btn_start_time"
        android:padding="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:singleLine="true"
        android:drawableRight="@drawable/vk_icon_dropdown_24"
        android:layout_weight="4"
        android:drawableTint="?attr/vk_ui_icon_secondary"/>
</merge>
