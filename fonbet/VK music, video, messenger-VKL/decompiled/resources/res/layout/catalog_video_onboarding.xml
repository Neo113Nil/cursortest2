<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_highlighted_round_rect_20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="12dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/onboarding"
        android:paddingTop="14dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/VkUiTypography.ParagraphMedium"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="16dp"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/interests"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="center"
            android:id="@+id/submit"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="12dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/like_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:src="@drawable/vk_icon_like_outline_56"
            app:tint="@color/gray"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline1Normal"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/response_message"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="60dp"
            android:textAlignment="center"
            android:layout_marginHorizontal="16dp"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/onboarding_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"/>
</FrameLayout>
