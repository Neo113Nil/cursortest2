<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="21dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.AvatarView
        android:id="@+id/avatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/vkim_accessibility_avatar_chat"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"
        style="@style/VkIm.AvatarView"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vkim_chat_settings_title_header"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/avatar"/>
    <EditText
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:textColorHint="?attr/vk_legacy_text_placeholder"
        android:id="@+id/title"
        android:background="@drawable/bg_settings_edittext_normal"
        android:paddingTop="13dp"
        android:paddingBottom="11dp"
        android:fadingEdgeLength="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/vkim_chat_settings_title_hint"
        android:includeFontPadding="false"
        android:maxLength="120"
        android:layout_alignBottom="@+id/avatar"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:requiresFadingEdge="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/avatar"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/avatar">
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/casper_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:vkim_icon="@drawable/vk_icon_ghost_outline_28"
            app:vkim_titleMaxLines="2"
            app:vkim_titleText="@string/vkim_dialog_settings_casper_description"
            style="@style/VkIm.Settings.Label.SmallGrey"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/donut_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:vkim_icon="@drawable/vk_icon_donate_outline_28"
            app:vkim_titleMaxLines="2"
            app:vkim_titleText="@string/vkim_dialog_settings_donut_description"
            style="@style/VkIm.Settings.Label.SmallGrey"/>
        <com.vk.im.ui.views.settings.DividerSettingsView
            android:id="@+id/divider1"
            style="@style/VkIm.Settings.Divider"/>
        <com.vk.im.ui.views.settings.SwitchSettingsView
            android:id="@+id/notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vkim_icon="@drawable/vk_icon_notifications_28"
            app:vkim_titleText="@string/vkim_chat_settings_notifications"
            style="@style/VkIm.Settings.Label.Normal"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/attaches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vkim_icon="@drawable/vk_icon_picture_outline_28"
            app:vkim_titleText="@string/vkim_dialog_attaches_open_chat"
            style="@style/VkIm.Settings.Label.Normal"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vkim_icon="@drawable/vk_icon_search_outline_28"
            app:vkim_titleText="@string/vkim_search_in_dialog"
            style="@style/VkIm.Settings.Label.Normal"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vkim_icon="@drawable/vk_icon_palette_outline_28"
            app:vkim_titleText="@string/vkim_chat_theme"
            style="@style/VkIm.Settings.Label.Normal"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vkim_icon="@drawable/vk_icon_link_circle_24"
            app:vkim_titleText="@string/vkim_chat_invite_link"
            style="@style/VkIm.Settings.Label.Normal"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/chat_control_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vkim_icon="@drawable/vk_icon_settings_outline_28"
            app:vkim_titleText="@string/vkim_chat_settings_admin_controls"
            style="@style/VkIm.Settings.Label.Normal"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/create_casper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:vkim_icon="@drawable/vk_icon_ghost_outline_28"
            app:vkim_titleText="@string/vkim_chat_settings_create_casper_chat"
            style="@style/VkIm.Settings.Label.Normal"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/vk_legacy_accent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/owner"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/vkim_chat_settings_go_to_group"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="@string/font_family_medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/pinned"
            android:background="?attr/selectableItemBackground"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.im.ui.views.settings.LabelSettingsView
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:vkim_icon="@drawable/vk_icon_pin_outline_28"
                app:vkim_titleText="@string/vkim_msg_view_mode_pinned"
                style="@style/VkIm.Settings.Label.Normal"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_settings_edittext_normal"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="?attr/vk_legacy_text_name"
                    android:ellipsize="end"
                    android:id="@+id/pinned_msg_sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="@string/font_family_medium"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/vk_legacy_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/pinned_msg_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="@string/font_family_regular"/>
            </LinearLayout>
        </LinearLayout>
        <com.vk.im.ui.views.settings.DividerSettingsView style="@style/VkIm.Settings.Divider"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/return_btn"
            app:vkim_titleText="@string/vkim_chat_settings_members_return"
            style="@style/VkIm.Settings.Label.Normal"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/clear_history"
            app:vkim_icon="@drawable/vk_icon_delete_outline_28"
            app:vkim_titleText="@string/vkim_clear_history"
            style="@style/VkIm.Settings.Label.Destructive"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/leave_btn"
            app:vkim_icon="@drawable/vk_icon_door_arrow_right_outline_28"
            app:vkim_titleText="@string/vkim_chat_settings_members_leave"
            style="@style/VkIm.Settings.Label.Destructive"/>
        <com.vk.im.ui.views.settings.LabelSettingsView
            android:id="@+id/spam_btn"
            app:vkim_icon="@drawable/vk_icon_report_outline_28"
            app:vkim_titleText="@string/vkim_chat_actions_delete_spam"
            style="@style/VkIm.Settings.Label.Destructive"/>
    </LinearLayout>
</RelativeLayout>
