<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:padding="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_view"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:lottie_autoPlay="false"
        app:lottie_fileName="stories_ideas_20_lottie.json"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/lottie_placeholder"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/vk_icon_stories_ideas_20"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Title3Normal"
        android:textColor="?attr/vk_ui_text_contrast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/story_template_button_text"
        android:shadowColor="@color/vk_black_alpha35"
        android:shadowDy="2"
        android:shadowRadius="12"
        android:layout_marginStart="6dp"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_chevron_16"
        android:paddingHorizontal="2dp"
        app:tint="?attr/vk_ui_icon_contrast"/>
</LinearLayout>
