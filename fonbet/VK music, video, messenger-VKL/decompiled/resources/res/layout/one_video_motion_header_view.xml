<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_motion_header_image_view"
        android:background="@drawable/one_video_background_oval"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="@color/one_video_white"
        android:ellipsize="end"
        android:id="@+id/video_motion_header_title_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/vk_roboto_regular"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/video_motion_header_subtitle_view"
        app:layout_constraintEnd_toStartOf="@+id/video_motion_header_info_view"
        app:layout_constraintStart_toEndOf="@+id/video_motion_header_image_view"
        app:layout_constraintTop_toTopOf="@+id/video_motion_header_image_view"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13dp"
        android:textColor="@color/one_video_gray_300"
        android:ellipsize="end"
        android:id="@+id/video_motion_header_subtitle_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/vk_roboto_regular"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_motion_header_image_view"
        app:layout_constraintEnd_toStartOf="@+id/video_motion_header_info_view"
        app:layout_constraintStart_toEndOf="@+id/video_motion_header_image_view"
        app:layout_constraintTop_toBottomOf="@+id/video_motion_header_title_view"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_motion_header_info_view"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/one_video_advertiser_info"
        app:layout_constraintBottom_toBottomOf="@+id/video_motion_header_image_view"
        app:layout_constraintEnd_toStartOf="@+id/video_motion_header_skip_view"
        app:layout_constraintTop_toTopOf="@+id/video_motion_header_image_view"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_motion_header_skip_view"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/one_video_ui_accessibility_close"
        app:layout_constraintBottom_toBottomOf="@+id/video_motion_header_image_view"
        app:layout_constraintEnd_toStartOf="@+id/video_motion_space_end"
        app:layout_constraintTop_toTopOf="@+id/video_motion_header_image_view"/>
    <Space
        android:id="@+id/video_motion_space_end"
        android:layout_width="8dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
