<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/vkim_background_view"
        android:background="@color/vk_black_alpha35"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/im_appbar_stub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/vkim_list_container"
        android:background="?attr/vk_ui_background_content"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/vkim_empty_container"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.vk.im.ui.views.EmptyViewForList
            android:layout_gravity="center"
            android:id="@+id/vkim_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:icon_size="@dimen/vkim_search_empty_icon_size"
            app:text="@string/vkim_msg_search_empty"
            app:text_color="?attr/vk_ui_text_subhead"
            app:text_size="16sp"/>
    </androidx.core.widget.NestedScrollView>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        app:vk_appbar_forceMode="separator"
        style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
