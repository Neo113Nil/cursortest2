<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/media_picker_bottom_sheet"
    android:background="@drawable/media_picker_rounded_sheet_background"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/media_picker_drag_handle"
        android:background="@drawable/media_picker_drag_handle_background"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:elevation="1dp"
        android:outlineProvider="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/posting_media_picker_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/media_picker_drafts_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/media_picker_pager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="end"
            android:id="@+id/media_picker_drafts_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/accessibility_drafts_list_button"
            android:layout_marginEnd="12dp"
            android:layout_marginVertical="12dp"
            app:buttonAppearance="neutral"
            app:buttonMode="secondary"
            app:buttonSizeType="small"
            app:icon="@drawable/vk_icon_list_pen_outline_20"
            app:iconSize="20dp"
            app:text="@string/bottom_toolbar_drafts"/>
    </LinearLayout>
    <com.vk.core.view.components.tabs.VkSecondaryTabLayout
        android:id="@+id/media_picker_tab_layout"
        android:paddingTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/posting_media_picker_top_bar"
        app:tabIndicatorFullWidth="true"
        app:tabPaddingEnd="0dp"
        app:tabPaddingStart="0dp"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/media_picker_pager"
        android:background="@drawable/media_picker_rounded_sheet_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/selected_media_preview_container"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.vk.feed.design.view.posting.divider.PostingDivider
            android:id="@+id/media_preview_separator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/selected_media_preview"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:paddingHorizontal="12dp"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/confirm_selection_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="12dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="large"
            app:text="@string/media_picker_confirm_selection_button"/>
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/media_picker_navigation_host"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
