<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vk_success_auth_snackbar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="16dp"
    android:paddingVertical="12dp">
    <com.vk.core.ui.themes.VKReplacerView
        android:id="@+id/vk_success_login_snackbar_image"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vk_success_login_snackbar_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/vk_success_login_snackbar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/vk_success_login_snackbar_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vk_success_login_snackbar_image"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.ParagraphMedium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/vk_success_login_snackbar_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/vk_login_by"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/vk_success_login_agreement_link"
        app:layout_constraintEnd_toStartOf="@+id/vk_vkid_logo"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/vk_success_login_snackbar_title"
        app:layout_constraintTop_toBottomOf="@+id/vk_success_login_snackbar_title"
        style="@style/VkUiTypography.Subhead"/>
    <ImageView
        android:id="@+id/vk_vkid_logo"
        android:layout_width="33dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/vk_success_login_snackbar_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/vk_success_login_snackbar_message"
        app:layout_constraintTop_toTopOf="@+id/vk_success_login_snackbar_message"
        app:srcCompat="@drawable/vk_ic_logo_vkid_composite"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/vk_success_login_agreement_link"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/vk_login_notification_agreement"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/vk_success_login_snackbar_title"
        app:layout_constraintTop_toBottomOf="@+id/vk_success_login_snackbar_message"
        style="@style/VkUiTypography.SubheadMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
