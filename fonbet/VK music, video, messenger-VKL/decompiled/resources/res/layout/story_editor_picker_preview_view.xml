<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_images_preview"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="48dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"
        android:layout_marginEnd="34dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/action"
        android:background="@drawable/story_gallery_picker_action_background"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp"
        android:foreground="@drawable/vk_ripple_circle_highlight"
        android:src="@drawable/vk_icon_arrow_right_outline_24"
        android:scaleType="centerInside"
        android:contentDescription="@string/story_accessibility_add_attachments"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</merge>
