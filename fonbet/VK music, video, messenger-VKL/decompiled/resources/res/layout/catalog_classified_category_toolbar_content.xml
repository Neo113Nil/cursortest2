<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/avatar_wrapper"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/title_horizontal_offset"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="center"
            android:id="@+id/owner_photo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:actualImageScaleType="centerCrop"
            app:backgroundImage="@color/music_placeholder_bg"
            app:placeholderImage="@drawable/user_placeholder"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/vk_black_alpha8"
            app:roundingBorderWidth="0.5dp"/>
    </FrameLayout>
    <View
        android:id="@+id/title_horizontal_offset"
        android:layout_width="16dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/avatar_wrapper"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/title_dropdown"
        app:layout_constraintStart_toEndOf="@+id/title_horizontal_offset"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginEnd="16dp"
        style="@style/VkUiTypography.DisplayTitle2"/>
    <ImageView
        android:id="@+id/title_dropdown"
        android:layout_width="20dp"
        android:layout_height="16dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:translationY="1.5dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/button_search"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_dropdown_20"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/button_search"
        android:background="@drawable/highlight_unlimited"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="8dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/button_bookmark"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_search_outline_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <include
        android:id="@+id/button_bookmark"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/button_share"
        app:layout_constraintTop_toTopOf="@+id/title"
        layout="@layout/market_badge_item"/>
    <include
        android:id="@+id/button_share"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/button_cart"
        app:layout_constraintTop_toTopOf="@+id/title"
        layout="@layout/market_badge_item"/>
    <include
        android:id="@+id/button_cart"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/button_album_edit"
        app:layout_constraintTop_toTopOf="@+id/title"
        layout="@layout/market_badge_item"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/button_album_edit"
        android:background="@drawable/highlight_unlimited"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="8dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_edit"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/vk_icon_more_horizontal_28"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
</androidx.constraintlayout.widget.ConstraintLayout>
