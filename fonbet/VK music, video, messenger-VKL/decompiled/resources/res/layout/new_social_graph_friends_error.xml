<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/empty_item"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/error_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/vk_icon_error_outline_56"
        app:layout_constraintBottom_toTopOf="@+id/error_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Title2Medium"
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_gravity="center_vertical"
        android:id="@+id/error_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/social_graph_error_header"
        android:textAlignment="center"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/error_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_icon"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Paragraph"
        android:textColor="?attr/vk_ui_text_subhead"
        android:layout_gravity="center_vertical"
        android:id="@+id/error_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/social_graph_error_text"
        android:textAlignment="center"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_header"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/try_again"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/social_graph_try_again"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toTopOf="@+id/skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/skip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/social_graph_skip"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
