<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <com.vk.core.view.AppBarShadowView
            android:id="@+id/shadow"
            android:tint="?attr/vk_legacy_separator_common"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"
            style="@style/AppBarShadow"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:paddingTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/money_transfer_public_link"
            android:maxLines="1"
            android:letterSpacing="0.01"
            style="@style/VkLegacyTypography.Title2"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:text="@string/money_transfer_public_link_description"
            style="@style/VkLegacyTypography.Text"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:gravity="center_vertical"
            android:id="@+id/public_link_view"
            android:background="@drawable/bg_money_chat_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:minHeight="44dp"
            android:lineSpacingExtra="4sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:letterSpacing="0.01"
            style="@style/VkLegacyTypography.Headline"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/public_link_copy_view"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="16dp"
            android:text="@string/copy_link"
            android:lineSpacingExtra="4sp"
            android:letterSpacing="0.01"
            style="@style/VkLegacyButton.Tertiary.Rounded"/>
        <View
            android:background="?attr/vk_legacy_separator_alpha"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:paddingTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/money_transfer_anon_link"
            android:maxLines="1"
            android:letterSpacing="0.01"
            style="@style/VkLegacyTypography.Title2"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:text="@string/money_transfer_anon_link_description"
            style="@style/VkLegacyTypography.Text"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:gravity="center_vertical"
            android:id="@+id/anon_link_view"
            android:background="@drawable/bg_money_chat_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            style="@style/VkLegacyTypography.Headline"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/anon_link_copy_view"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="16dp"
            android:text="@string/copy_link"
            android:lineSpacingExtra="4sp"
            android:letterSpacing="0.01"
            style="@style/VkLegacyButton.Tertiary.Rounded"/>
        <View
            android:background="?attr/vk_legacy_separator_alpha"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:paddingTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/money_transfer_qr"
            android:maxLines="1"
            style="@style/VkLegacyTypography.Title2"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/money_transfer_qr_description"
            style="@style/VkLegacyTypography.Text"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/money_transfer_qr_container"
            android:background="@drawable/bg_money_transfer_qr"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">
            <ImageView
                android:id="@+id/money_transfer_qr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxWidth="350dp"
                android:contentDescription="@string/money_transfer_qr"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:id="@+id/money_transfer_qr_save"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:text="@string/money_transfer_qr_save"
            android:lineSpacingExtra="4sp"
            android:letterSpacing="0.01"
            style="@style/VkLegacyButton.Tertiary.Rounded"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/money_transfer_qr_share"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="16dp"
            android:text="@string/money_transfer_qr_share"
            android:lineSpacingExtra="4sp"
            android:letterSpacing="0.01"
            style="@style/VkLegacyButton.Tertiary.Rounded"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
