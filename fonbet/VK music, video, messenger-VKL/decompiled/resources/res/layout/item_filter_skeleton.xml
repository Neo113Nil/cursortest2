<?xml version="1.0" encoding="utf-8"?>
<com.vk.photo.editor.views.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shimmer_frame_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/bg_filter_skeleton"
            android:layout_width="64dp"
            android:layout_height="64dp"/>
        <View
            android:background="@drawable/bg_filter_skeleton_name"
            android:layout_width="48dp"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</com.vk.photo.editor.views.shimmer.ShimmerFrameLayout>
