<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/snippet_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle3"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/snippet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/snippet_sign"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/snippet_sign"/>
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/snippet_sign"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/android_4_fix"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/snippet_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/snippet_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/snippet_title"
        app:layout_constraintTop_toBottomOf="@+id/snippet_sign"/>
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer"
        android:layout_width="0dp"
        android:layout_height="172dp"
        android:layout_marginTop="16dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/snippet_subtitle">
        <androidx.cardview.widget.CardView
            android:background="@drawable/vk_bg_skeleton_10dp"
            android:layout_width="match_parent"
            android:layout_height="172dp"
            app:cardCornerRadius="16dp"/>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
