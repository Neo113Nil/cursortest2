<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="312dp"
    android:layout_height="340dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/album_cover"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toTopOf="@+id/title_artist_group"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread"
        app:roundedCornerRadius="16dp"
        app:tiv_background_image="?attr/vk_ui_background_content"
        app:tiv_empty_resource="@drawable/vk_icon_song_outline_56"
        app:tiv_empty_tint="?attr/vk_ui_icon_medium"/>
    <ImageView
        android:id="@+id/play_button"
        android:background="@drawable/bg_white_circle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:scaleType="center"
        android:contentDescription="@string/music_talkback_play"
        android:layout_marginEnd="12dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/album_cover"
        app:layout_constraintEnd_toEndOf="@+id/album_cover"
        app:srcCompat="@drawable/vk_icon_play_24"
        app:tint="@color/vk_black"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle2"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/album_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="26sp"
        android:singleLine="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/album_artist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_artist_group"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth="wrap_content_constrained"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/album_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="20sp"
        android:singleLine="true"
        android:alpha="0.6"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_artist_group"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/album_title"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth="wrap_content_constrained"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/title_artist_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="album_title,album_artist"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/album_cover"
        app:layout_constraintVertical_chainStyle="spread"/>
</androidx.constraintlayout.widget.ConstraintLayout>
