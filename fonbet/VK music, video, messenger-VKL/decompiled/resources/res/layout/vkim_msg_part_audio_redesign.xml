<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/music_attach_top_down_gradient"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/vkim_msg_part_audio_min_width">
    <View
        android:id="@+id/dominant_color"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:alpha="0.8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/partial_gradient"
        android:background="@drawable/music_attach_down_top_gradient"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:layout_marginTop="-80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/audio_image"
        android:focusable="false"
        android:layout_width="@dimen/vkim_msg_part_audio_thumbs_size"
        android:layout_height="@dimen/vkim_msg_part_audio_thumbs_size"
        android:layout_marginTop="24dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="8dp"
        app:tiv_background_image="?attr/vk_legacy_placeholder_icon_background"
        app:tiv_border_width="0.5dp"/>
    <View
        android:id="@+id/play_icon_background"
        android:background="@drawable/bg_music_attach_play_button"
        android:layout_width="@dimen/vkim_msg_part_audio_play_icon_background"
        android:layout_height="@dimen/vkim_msg_part_audio_play_icon_background"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/audio_image"
        app:layout_constraintEnd_toEndOf="@+id/audio_image"
        app:layout_constraintStart_toStartOf="@+id/audio_image"
        app:layout_constraintTop_toTopOf="@+id/audio_image"/>
    <ImageView
        android:id="@+id/play_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/play_icon_background"
        app:layout_constraintEnd_toEndOf="@+id/play_icon_background"
        app:layout_constraintStart_toStartOf="@+id/play_icon_background"
        app:layout_constraintTop_toTopOf="@+id/play_icon_background"
        app:tint="@color/vk_white"/>
    <ImageView
        android:id="@+id/empty_thumb_icon"
        android:visibility="gone"
        android:layout_width="@dimen/vkim_msg_part_audio_empty_icon_size"
        android:layout_height="@dimen/vkim_msg_part_audio_empty_icon_size"
        android:layout_marginBottom="@dimen/vkim_msg_part_audio_empty_icon_margin"
        android:src="@drawable/vk_icon_song_outline_28"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/vkim_msg_part_audio_empty_icon_margin"
        app:layout_constraintBottom_toBottomOf="@+id/audio_image"
        app:layout_constraintStart_toStartOf="@+id/audio_image"
        app:tint="?attr/vk_legacy_placeholder_icon_foreground_secondary"/>
    <TextView
        android:textSize="@dimen/vkim_msg_part_audio_title_text_size"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/audio_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxWidth="@dimen/vkim_msg_part_audio_title_max_width"
        android:fontFamily="@font/vk_sans_display_demibold"
        android:textAlignment="center"
        app:layout_constraintEnd_toStartOf="@+id/explicit_content"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toBottomOf="@+id/audio_image"/>
    <ImageView
        android:id="@+id/explicit_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/audio_title"
        app:layout_constraintEnd_toStartOf="@+id/guideline3"
        app:layout_constraintStart_toEndOf="@+id/audio_title"
        app:layout_constraintTop_toTopOf="@+id/audio_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:ellipsize="marquee"
        android:id="@+id/audio_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="11dp"
        android:maxWidth="@dimen/vkim_msg_part_audio_artist_max_width"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/time_and_status"
        app:layout_constraintEnd_toStartOf="@+id/guideline3"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toBottomOf="@+id/audio_title"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextSimple"
        android:id="@+id/time_and_status"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:importantForAccessibility="noHideDescendants"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_artist"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
