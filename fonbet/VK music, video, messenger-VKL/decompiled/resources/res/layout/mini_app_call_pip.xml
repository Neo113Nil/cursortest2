<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_gray_500"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/avatar_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/avatar_image"
        android:background="@drawable/ic_user_260"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/title"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:fontFamily="@font/vk_roboto_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_image"
        style="@style/VkRobotoRegularStyle.Caption2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/mute"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_voice_24"
        android:tint="@color/vk_white"
        android:contentDescription="@string/voip_accessibility_full_screen_call"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/reject"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_reject_call_48"
        android:contentDescription="@string/voip_accessibility_reject_call"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/participants_count_image"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/vk_icon_users_12"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/reject"
        app:layout_constraintEnd_toStartOf="@+id/participants_count_text_view"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/mute"
        app:layout_constraintTop_toTopOf="@+id/reject"
        app:tint="@color/vk_white"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/participants_count_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/reject"
        app:layout_constraintEnd_toStartOf="@+id/reject"
        app:layout_constraintStart_toEndOf="@+id/participants_count_image"
        app:layout_constraintTop_toTopOf="@+id/reject"
        style="@style/VkRobotoRegularStyle.Caption2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:id="@+id/connection_status"
        android:background="@drawable/black_alpha_35_round_overlay"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="center"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/avatar_image"
        app:layout_constraintStart_toStartOf="@+id/avatar_image"
        app:layout_constraintTop_toTopOf="@+id/avatar_image"/>
    <View
        android:gravity="center"
        android:id="@+id/own_state_background"
        android:background="@drawable/mini_app_call_own_state_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_margin="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/own_state_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/own_state_background"
        app:layout_constraintEnd_toEndOf="@+id/own_state_background"
        app:layout_constraintStart_toStartOf="@+id/own_state_background"
        app:layout_constraintTop_toTopOf="@+id/own_state_background"
        style="@style/VkRobotoRegularStyle.Caption2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
