<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.superapp.ui.toolbar.VkAuthToolbar
        android:id="@+id/phone_validation_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/vk_auth_accessibility_close"
        app:navigationIcon="@drawable/vk_icon_cancel_24"
        app:vk_navIconTint="?attr/vk_ui_icon_accent_themed"
        app:vk_titlePriority="picture"/>
    <FrameLayout
        android:id="@+id/phone_validation_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/phone_validation_primary_button"
        app:layout_constraintTop_toBottomOf="@+id/phone_validation_toolbar">
        <androidx.core.widget.NestedScrollView
            android:layout_gravity="center"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <ImageView
                    android:id="@+id/phone_validation_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/vk_icon_phone_outline_56"
                    app:tint="?attr/vk_ui_icon_accent_themed"/>
                <TextView
                    android:textColor="@color/vk_ui_text_title_color"
                    android:gravity="center"
                    android:id="@+id/phone_validation_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/phone_validation_icon"
                    style="@style/VkUiTypography.Title2Medium"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:gravity="center"
                    android:id="@+id/phone_validation_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/vk_service_validation_confirmation_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/phone_validation_title"
                    style="@style/VkUiTypography.Headline1Normal"/>
                <com.vk.core.view.components.button.VkSimpleButton
                    android:id="@+id/phone_validation_action_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/vk_service_validation_confirmation_change_number"
                    app:buttonAppearance="accent"
                    app:buttonMode="tertiary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/phone_validation_subtitle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    <Button
        android:id="@+id/phone_validation_primary_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_service_validation_confirmation_confirm"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/phone_validation_secondary_button"
        app:layout_goneMarginBottom="16dp"
        style="@style/VkAuth.Button.Primary"/>
    <Button
        android:id="@+id/phone_validation_secondary_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/VkAuth.Button.Secondary"/>
    <FrameLayout
        android:id="@+id/phone_validation_progress_bar"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <ProgressBar
            android:layout_gravity="center"
            android:visibility="visible"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/vk_ui_icon_secondary"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
