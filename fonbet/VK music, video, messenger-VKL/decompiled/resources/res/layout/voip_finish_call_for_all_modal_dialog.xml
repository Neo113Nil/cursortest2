<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voip_finish_call_for_all_description"
        android:layout_marginHorizontal="8dp"
        style="@style/VkLegacyTypography.Footnote.Regular"/>
    <TextView
        android:textColor="?attr/vk_ui_text_negative"
        android:id="@+id/finish_call_for_all_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="8dp"
        android:text="@string/voip_finish_call_for_all_button"
        android:layout_marginHorizontal="8dp"
        style="@style/VkLegacyTypography.Text.Regular"/>
</LinearLayout>
