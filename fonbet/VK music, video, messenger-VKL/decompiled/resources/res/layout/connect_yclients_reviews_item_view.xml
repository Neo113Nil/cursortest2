<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/connect_yclients_background"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">
    <ImageView
        android:id="@+id/yclients_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_logo_yclients_color_32"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/connect_yclients_reviews_title"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toStartOf="@+id/hide_button"
        app:layout_constraintStart_toEndOf="@+id/yclients_logo"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.Headline1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/connect_yclients_reviews_description"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toStartOf="@+id/hide_button"
        app:layout_constraintStart_toEndOf="@+id/yclients_logo"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkUiTypography.SubheadNormal.Unscaled"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/more_details_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/more_details"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toStartOf="@+id/hide_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/yclients_logo"
        app:layout_constraintTop_toBottomOf="@+id/description"
        style="@style/VkUiTypography.SubheadMedium.Unscaled"/>
    <ImageView
        android:id="@+id/hide_button"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/vk_icon_dismiss_24"
        android:contentDescription="@string/hide_connect_ycliens_reviews_accessibility"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
