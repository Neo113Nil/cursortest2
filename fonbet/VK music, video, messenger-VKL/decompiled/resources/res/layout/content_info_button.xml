<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/content_info_button"
    android:background="?attr/selectableItemBackground"
    android:padding="16dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/vk_icon_info_outline_16"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_s"
        app:tint="?attr/vk_ui_text_secondary"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/content_info_bottom_sheet_title"
        style="@style/VkUiTypography.Subhead"/>
</LinearLayout>
