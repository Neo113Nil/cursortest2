<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/group_picker_clickable_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/group_picker_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/group_picker_touch_outside"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:soundEffectsEnabled="false"
                android:importantForAccessibility="no"/>
            <LinearLayout
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/group_picker_content_layout"
                android:background="@drawable/background_top_rounded_12"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="?attr/vk_ui_background_content">
                <FrameLayout
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp">
                    <TextView
                        android:textAppearance="@style/VkUiTypography.Headline.Unscaled"
                        android:textColor="?attr/vk_ui_text_muted"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/group_picker_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="56dp"
                        android:text="@string/sharing_title1"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="56dp"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/group_picker_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="horizontal"
                        android:id="@+id/group_picker_targets_recycler"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <ViewAnimator
                        android:id="@+id/group_picker_content_animator"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:measureAllChildren="false">
                        <android.widget.Space
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <ProgressBar
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:indeterminateTint="?attr/vk_ui_icon_tertiary"
                            android:indeterminateTintMode="src_in"/>
                        <TextView
                            android:textAppearance="@style/VkUiTypography.Text.Unscaled"
                            android:textColor="?attr/vk_ui_text_secondary"
                            android:gravity="center"
                            android:id="@+id/group_picker_empty_text"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/no_messages"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:textAppearance="@style/VkUiTypography.Text.Unscaled"
                                android:textColor="?attr/vk_ui_text_secondary"
                                android:gravity="center"
                                android:id="@+id/group_picker_error_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="@string/default_network_error"/>
                            <TextView
                                android:textSize="16dp"
                                android:id="@+id/group_picker_retry_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/err_try_again"
                                android:includeFontPadding="false"
                                style="@style/MaterialGrayButton"/>
                        </LinearLayout>
                    </ViewAnimator>
                </FrameLayout>
                <ViewAnimator
                    android:id="@+id/group_picker_footer_animator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:measureAllChildren="false">
                    <include layout="@layout/layout_group_picker_footer_cancel"/>
                    <include layout="@layout/layout_group_picker_footer_pick"/>
                </ViewAnimator>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</merge>
