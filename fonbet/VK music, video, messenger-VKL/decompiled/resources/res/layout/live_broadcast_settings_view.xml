<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/live_broadcast_settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"/>
    <com.vk.lists.CustomSwipeRefreshLayout
        android:id="@+id/live_broadcast_settings_recycler_swipe_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/live_broadcast_settings_recycler"
            android:paddingBottom="68dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.vk.lists.CustomSwipeRefreshLayout>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/live_broadcast_settings_button_save"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/live_broadcast_settings_save"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
    <com.vk.core.view.components.spinner.VkSpinner
        android:layout_gravity="center"
        android:id="@+id/live_broadcast_settings_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:spinnerSize="medium"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/live_broadcast_settings_error_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/live_broadcast_settings_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="3"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            style="@style/VkUiTypography.HeadlineNormal"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/live_broadcast_settings_error_button_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"
            app:buttonSizeType="medium"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
