<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/user_vh"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">
    <CheckBox
        android:id="@+id/vkim_checkbox"
        android:focusable="false"
        android:visibility="visible"
        android:clickable="false"
        android:checked="true"
        android:text=""
        android:layout_marginStart="14dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CircleCheckBox"/>
    <ImageView
        android:id="@+id/vkim_subscribers_icon"
        android:visibility="visible"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_users_circle_fill_blue_48"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vkim_checkbox"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="marquee"
        android:id="@+id/vkim_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vkim_counters"
        app:layout_constraintStart_toEndOf="@+id/vkim_subscribers_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="marquee"
        android:id="@+id/vkim_counters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
