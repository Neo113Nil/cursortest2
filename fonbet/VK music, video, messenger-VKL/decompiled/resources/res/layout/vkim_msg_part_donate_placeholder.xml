<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.fresco.VKEnhancedImageView
        android:layout_gravity="center"
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/donate_content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:gravity="center"
            android:id="@+id/donate_placeholder_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>
        <Button
            android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
            android:gravity="center"
            android:id="@+id/donate_placeholder_button"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:drawablePadding="6dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"/>
    </LinearLayout>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextContrast"
        android:layout_gravity="bottom|right"
        android:id="@+id/timeAndStatus"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:importantForAccessibility="no"/>
</FrameLayout>
