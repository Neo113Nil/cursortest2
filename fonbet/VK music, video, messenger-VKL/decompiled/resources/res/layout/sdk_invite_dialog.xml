<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="12.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textAppearance="@style/VkUiTypography.Title3Normal.Unscaled"
            android:textColor="@android:color/black"
            android:id="@+id/message"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:text="Test"
            android:capitalize="sentences"
            android:inputType="textMultiLine"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12.5dp">
            <ImageView
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="?attr/vk_ui_icon_tertiary"
                android:indeterminateTintMode="src_in"/>
        </FrameLayout>
        <TextView
            android:textAppearance="@style/VkUiTypography.Paragraph.Unscaled"
            android:textColor="@color/vk_gray_400"
            android:id="@+id/link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
