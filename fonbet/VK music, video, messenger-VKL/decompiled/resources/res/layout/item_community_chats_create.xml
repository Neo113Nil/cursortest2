<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:background="@drawable/bg_image_placeholder_circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:scaleType="center"
        android:layout_marginStart="16dp"
        android:backgroundTint="?attr/vk_ui_background_secondary"
        app:srcCompat="@drawable/vk_icon_add_outline_28"
        app:tint="?attr/vk_ui_icon_accent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.HeadlineNormal"
        android:textColor="?attr/vk_ui_text_accent"
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/community_create_chat"
        android:layout_marginStart="76dp"
        android:layout_marginEnd="16dp"/>
</FrameLayout>
