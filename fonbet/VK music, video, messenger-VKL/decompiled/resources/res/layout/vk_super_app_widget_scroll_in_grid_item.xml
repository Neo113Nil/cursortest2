<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.components.button.VkButton xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:layout_width="@dimen/vk_scroll_in_grid_item_width"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp"
    android:paddingVertical="8dp"
    app:buttonAppearance="accent"
    app:buttonMode="tertiary">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/grid_item_constraint_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/icon"
            android:padding="2dp"
            android:clipToPadding="false"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:elevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.core.view.components.avatar.VkAvatar
            android:id="@+id/avatar"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="52dp"
            android:layout_height="54dp"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            style="@style/VkUiTypography.Footnote"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.core.view.components.button.VkButton>
