<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_icon"
        android:background="@drawable/bg_empty_placeholder"
        android:padding="10dp"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="center"
        android:contentDescription="@null"
        android:layout_marginStart="16dp"
        app:srcCompat="@drawable/vk_icon_users_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_accent"
        android:layout_gravity="center_vertical"
        android:id="@+id/vkim_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vkim_create_chat"
        android:lines="1"
        android:layout_marginStart="84dp"/>
</FrameLayout>
