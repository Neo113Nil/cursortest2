<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="12dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:drawablePadding="8dp"
        app:drawableStartCompat="@drawable/vk_icon_lock_12"
        app:drawableTint="?attr/vk_ui_text_secondary"
        app:layout_constraintBottom_toTopOf="@+id/body"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Paragraph"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/first_button"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:gravity="center"
        android:id="@+id/first_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="4dp"
        app:buttonMode="secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/second_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/body"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:gravity="center"
        android:id="@+id/second_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        app:buttonMode="primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/first_button"
        app:layout_constraintTop_toTopOf="@+id/first_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
