<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/unavailable_gallery_banner_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/unavailable_gallery_banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/VkUiTypography.Title2Medium"/>
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/unavailable_gallery_banner_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/VkUiTypography.Headline1Normal"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/media_picker_unavailable_gallery_action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="small"
            app:iconSize="24dp"/>
    </LinearLayout>
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="end|top"
        android:id="@+id/unavailable_gallery_banner_close_button"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/vk_icon_dismiss_24"
        android:contentDescription="@string/accessibility_close"
        app:tint="?attr/vk_ui_icon_medium"/>
</FrameLayout>
