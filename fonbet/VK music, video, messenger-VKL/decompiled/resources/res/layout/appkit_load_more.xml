<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/load_more_progress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="22dp"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/load_more_error"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="76dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="?attr/vk_ui_text_secondary"
            android:layout_gravity="center_vertical"
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="?attr/appkitDefaultErrorText"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_gravity="center_vertical"
            android:id="@+id/error_retry"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="?attr/appkitRetryButtonText"/>
    </LinearLayout>
</FrameLayout>
