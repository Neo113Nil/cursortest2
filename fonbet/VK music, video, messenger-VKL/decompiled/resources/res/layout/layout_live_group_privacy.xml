<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.group.header.VkGroupHeader
        android:id="@+id/privacy_live_group_settings_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.spinner.VkSpinner
        android:id="@+id/privacy_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:spinnerSize="medium"/>
    <com.vk.clips.design.view.camera.settings.ModalSettingsPrivacyOption
        android:id="@+id/privacy_settings_group_who_can_all_option"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:privacy_option_title="@string/privcay_live_group_who_will_see_all_option"/>
    <com.vk.clips.design.view.camera.settings.ModalSettingsPrivacyOption
        android:id="@+id/privacy_settings_group_who_can_members_option"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:privacy_option_title="@string/privcay_live_group_who_will_see_members_option"/>
    <com.vk.clips.design.view.camera.settings.ModalSettingsPrivacyOption
        android:id="@+id/privacy_settings_group_who_can_admins_option"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:privacy_option_title="@string/privcay_live_group_who_will_see_admins_option"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/privacy_settings_group_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/privacy_save"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
    <com.vk.clips.design.view.camera.settings.ModalPrivacySettingsErrorView
        android:layout_gravity="center"
        android:id="@+id/privacy_bottomsheet_loading_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="64dp"/>
</LinearLayout>
