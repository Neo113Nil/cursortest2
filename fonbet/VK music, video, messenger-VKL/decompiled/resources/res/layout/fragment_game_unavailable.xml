<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        layout="@layout/toolbar"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:srcCompat="@drawable/vk_icon_info_outline_56"
            app:tint="?attr/vk_legacy_placeholder_icon_foreground_primary"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:gravity="center_horizontal"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            style="@style/VkLegacyTypography.Title2.Medium"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_legacy_text_secondary"
            android:gravity="center_horizontal"
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            android:fontFamily="@font/vk_roboto_regular"
            android:letterSpacing="0.01"
            style="@style/VkLegacyTypography.Headline"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <View
                android:layout_gravity="top|center_horizontal"
                android:background="?attr/vk_legacy_separator_common"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/vk_legacy_text_secondary"
                android:gravity="center_vertical"
                android:layout_gravity="start"
                android:paddingTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/games_available_games"
                android:layout_marginStart="16dp"
                style="@style/VkLegacyTypography.Caption.Caps.Medium"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="15sp"
                android:textColor="?attr/vk_legacy_accent"
                android:layout_gravity="end"
                android:id="@+id/btnShowMore"
                android:paddingTop="10.5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/games_show_all"
                android:fontFamily="@font/vk_roboto_regular"
                android:layout_marginEnd="4dp"
                style="@style/VkLegacyButton.Tertiary.Rounded"/>
        </FrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="157dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
    </LinearLayout>
</LinearLayout>
