<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/comments_separator"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="8dp"/>
    <FrameLayout
        android:background="@drawable/ripple_bottom_16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/comments_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-1dp"
            app:srcCompat="@drawable/vk_icon_comment_outline_16"
            app:tint="?attr/vk_legacy_accent"/>
        <TextView
            android:textAppearance="@style/VkLegacyTypography.Subhead.Compact.Medium"
            android:textSize="13sp"
            android:textColor="?attr/vk_ui_text_accent_themed"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/comments_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="16dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/comments_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/vk_icon_chevron_16"
            app:tint="?attr/vk_legacy_accent"/>
    </FrameLayout>
</FrameLayout>
