<?xml version="1.0" encoding="utf-8"?>
<com.vk.superapp.ui.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/footer_content_shimmer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <View
            android:id="@+id/stat_skeleton"
            android:background="@drawable/vk_bg_skeleton_6dp"
            android:layout_width="102dp"
            android:layout_height="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/user_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stat_skeleton">
            <View
                android:id="@+id/first_user"
                android:background="@drawable/vk_bg_skeleton_round_with_border"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="34dp"
                app:layout_constraintEnd_toStartOf="@+id/second_user"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/first_user_name"
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="70dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="@+id/first_user"
                app:layout_constraintStart_toStartOf="@+id/first_user"
                app:layout_constraintTop_toBottomOf="@+id/first_user"/>
            <View
                android:id="@+id/first_user_data"
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="44dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                app:layout_constraintEnd_toEndOf="@+id/first_user_name"
                app:layout_constraintStart_toStartOf="@+id/first_user_name"
                app:layout_constraintTop_toBottomOf="@+id/first_user_name"/>
            <View
                android:id="@+id/second_user"
                android:background="@drawable/vk_bg_skeleton_round_with_border"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginEnd="34dp"
                app:layout_constraintEnd_toStartOf="@+id/third_user"
                app:layout_constraintStart_toEndOf="@+id/first_user"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/second_user_name"
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="70dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="@+id/second_user"
                app:layout_constraintStart_toStartOf="@+id/second_user"
                app:layout_constraintTop_toBottomOf="@+id/second_user"/>
            <View
                android:id="@+id/second_user_data"
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="44dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                app:layout_constraintEnd_toEndOf="@+id/second_user_name"
                app:layout_constraintStart_toStartOf="@+id/second_user_name"
                app:layout_constraintTop_toBottomOf="@+id/second_user_name"/>
            <View
                android:id="@+id/third_user"
                android:background="@drawable/vk_bg_skeleton_round_with_border"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/second_user"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/third_user_name"
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="70dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="@+id/third_user"
                app:layout_constraintStart_toStartOf="@+id/third_user"
                app:layout_constraintTop_toBottomOf="@+id/third_user"/>
            <View
                android:id="@+id/third_user_data"
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="44dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                app:layout_constraintEnd_toEndOf="@+id/third_user_name"
                app:layout_constraintStart_toStartOf="@+id/third_user_name"
                app:layout_constraintTop_toBottomOf="@+id/third_user_name"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/first_user_avatar"
            android:background="@drawable/vk_bg_skeleton_round"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="34dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_container"/>
        <View
            android:id="@+id/first_user_avatar_name"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="176dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/first_user_avatar"
            app:layout_constraintTop_toTopOf="@+id/first_user_avatar"/>
        <View
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="65dp"
            android:layout_height="14dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/first_user_avatar"
            app:layout_constraintTop_toBottomOf="@+id/first_user_avatar_name"/>
        <View
            android:id="@+id/second_user_avatar"
            android:background="@drawable/vk_bg_skeleton_round"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/first_user_avatar"/>
        <View
            android:id="@+id/second_user_avatar_name"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="176dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/second_user_avatar"
            app:layout_constraintTop_toTopOf="@+id/second_user_avatar"/>
        <View
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="65dp"
            android:layout_height="14dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/second_user_avatar"
            app:layout_constraintTop_toBottomOf="@+id/second_user_avatar_name"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
