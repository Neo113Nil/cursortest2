<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:background="?attr/vk_legacy_background_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:layout_scrollFlags="snap|enterAlways|scroll"
            style="@style/VkIm.Toolbar.Style.LargeWithBack"/>
        <com.vk.core.view.AppBarShadowView
            android:id="@+id/vkim_history_attaches_toolbar_separator"
            android:layout_marginTop="4dp"
            app:vk_appbar_forceMode="separator"
            style="@style/VkIm.GoneShadowView"/>
        <com.vk.core.view.VKTabLayout
            android:id="@+id/vkim_tab_layout"
            android:background="?attr/vk_legacy_header_background"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/vkim_history_attaches_tab_layout_margin_top"
            app:tabGravity="fill"
            app:tabIndicator="?attr/tabBarIndicator"
            app:tabIndicatorColor="?attr/vk_legacy_header_tint"
            app:tabMode="fixed"
            app:tabPaddingEnd="16dp"
            app:tabPaddingStart="16dp"
            app:tabSelectedTextColor="?attr/vk_legacy_header_tab_active_text"
            app:tabTextAppearance="@style/TabBarTheme.TabTextAppearance"
            app:tabTextColor="?attr/vk_legacy_header_tab_inactive_text"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vkim_viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/vkim_history_attaches_content_separator"
        app:vk_appbar_forceMode="shadow"
        style="@style/VkIm.VisibleShadowView"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
