<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/subscription_expired_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_cancel_20"
        android:contentDescription="@null"
        android:paddingHorizontal="16dp"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:src="@drawable/vk_icon_illustration_end_of_subscription_music_144h"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:layout_marginStart="-20dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subscription_expired_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxWidth="312dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        style="@style/VkUiTypography.Title2Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subscription_expired_description"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:maxWidth="312dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/subscription_expired_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</LinearLayout>
