<?xml version="1.0" encoding="utf-8"?>
<com.vk.superapp.ui.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/bg_rounded_4"
            android:layout_width="200dp"
            android:layout_height="12dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="?attr/vk_ui_background_secondary"
            android:layout_marginHorizontal="16dp"/>
    </LinearLayout>
</com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
