<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/action_button_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:buttonAppearance="accent"
        app:buttonSizeType="medium"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/action_button_easy_promote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/profile_button_promote_horizontal_margin"
        app:buttonAppearance="accent"
        app:buttonSizeType="medium"/>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="center_vertical"
        android:id="@+id/action_button_compact_friend"
        android:layout_width="@dimen/user_profile_secondary_action_button_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/profile_button_secondary_horizontal_margin"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_phone_outline_24"
        app:iconSize="20dp"/>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="center_vertical"
        android:id="@+id/action_button_message"
        android:layout_width="@dimen/user_profile_secondary_action_button_width"
        android:layout_height="wrap_content"
        android:contentDescription="@string/user_profile_accessibility_message"
        android:layout_marginStart="@dimen/profile_button_secondary_horizontal_margin"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_message_outline_24"
        app:iconSize="20dp"/>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="center_vertical"
        android:id="@+id/action_button_call"
        android:layout_width="@dimen/user_profile_secondary_action_button_width"
        android:layout_height="wrap_content"
        android:contentDescription="@string/user_profile_accessibility_call"
        android:layout_marginStart="@dimen/profile_button_secondary_horizontal_margin"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_phone_outline_24"
        app:iconSize="20dp"/>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="center_vertical"
        android:id="@+id/action_button_friend"
        android:layout_width="@dimen/user_profile_secondary_action_button_width"
        android:layout_height="wrap_content"
        android:contentDescription="@string/user_profile_accessibility_friend_action"
        android:layout_marginStart="@dimen/profile_button_secondary_horizontal_margin"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_user_added_outline_24"
        app:iconSize="20dp"/>
    <com.vk.core.view.components.button.VkButton
        android:layout_gravity="center_vertical"
        android:id="@+id/action_button_menu"
        android:layout_width="@dimen/user_profile_secondary_action_button_width"
        android:layout_height="wrap_content"
        android:contentDescription="@string/user_profile_accessibility_dot_menu"
        android:layout_marginStart="@dimen/profile_button_secondary_horizontal_margin"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_more_horizontal_24"
        app:iconSize="20dp"/>
</LinearLayout>
