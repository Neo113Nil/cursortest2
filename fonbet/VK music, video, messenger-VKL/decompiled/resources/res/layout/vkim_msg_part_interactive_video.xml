<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.BlurredFrameLayout
        android:id="@+id/video_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/selection_mask"
        android:background="@color/vkim_msg_part_selection_mask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/video_wrapper"
        app:layout_constraintEnd_toEndOf="@+id/video_wrapper"
        app:layout_constraintStart_toStartOf="@+id/video_wrapper"
        app:layout_constraintTop_toTopOf="@+id/video_wrapper"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_wrapper"
        style="@style/VkLegacyTypography.Paragraph.Regular"/>
    <com.vk.im.ui.views.msg.video.AdaptiveTimeAndStatusLayout
        android:id="@+id/subtitle_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <TextView
            android:ellipsize="end"
            android:id="@+id/owner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/verification_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/VkLegacyTypography.Footnote.Regular"/>
        <ImageView
            android:id="@+id/verification_icon"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/vk_icon_check_12"
            android:importantForAccessibility="no"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/subtitle"
            app:layout_constraintStart_toEndOf="@+id/owner"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/verification_icon"
            style="@style/VkLegacyTypography.Footnote.Regular"/>
    </com.vk.im.ui.views.msg.video.AdaptiveTimeAndStatusLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
