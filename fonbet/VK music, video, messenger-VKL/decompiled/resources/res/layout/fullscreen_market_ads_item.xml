<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fullscreen_market_ads_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fullscreen_market_ads_bg_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.core.view.components.picture.VkPicture
            android:id="@+id/fullscreen_market_ads_bg_blurred_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <View
            android:id="@+id/fullscreen_market_ads_bg_overlay_1"
            android:background="?attr/vk_ui_overlay_primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/fullscreen_market_ads_bg_overlay_2"
            android:background="?attr/vk_ui_avatar_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/carousel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/market_recycler_first_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/market_recycler_second_row"
            android:layout="@layout/market_extra_carousel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vk_ui_spacing_size_m"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/fullscreen_market_ads_item_controls_stub"
        android:inflatedId="@+id/fullscreen_market_ads_item_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
