<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.FluidHorizontalLayout
        android:id="@+id/content"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/share"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/avatar_border"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_live_border_active_32"
                android:importantForAccessibility="no"/>
            <com.vk.core.view.ColorProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress_icon"
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminate="true"
                android:color="@color/vk_white"
                android:importantForAccessibility="no"/>
            <com.vk.im.ui.views.avatars.AvatarView
                android:layout_gravity="center"
                android:id="@+id/avatar_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/counter_icon"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="12dp"
            app:srcCompat="@drawable/vk_icon_clock_12"
            app:tint="@color/vk_gray_100"/>
        <TextView
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/counter_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="6dp"
            app:vk_layout_isFluid="true"
            style="@style/VoipRunningTaskLabel.Title"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:layout_marginStart="5dp"
            style="@style/VoipRunningTaskLabel.Title"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/divider"
            android:background="@color/vk_white_alpha60"
            android:layout_width="0.5dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="8dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/spectators_count_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="8dp"
            app:srcCompat="@drawable/vk_icon_user_20"
            app:tint="@color/vk_gray_100"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/spectators_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            style="@style/VoipRunningTaskLabel.Title"/>
    </com.vk.core.tool.view.FluidHorizontalLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/share"
        android:background="?attr/selectableItemBackground"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:adjustViewBounds="false"
        android:contentDescription="@string/voip_broadcast_share_short"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/finish"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_share_outline_28"
        app:tint="@color/vk_white"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/finish"
        android:background="?attr/selectableItemBackground"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:adjustViewBounds="false"
        android:contentDescription="@string/voip_broadcast_finish_short"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_outline_28"
        app:tint="@color/vk_white"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_record_finish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_broadcast_finish_short"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkRobotoRegularStyle.Title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
