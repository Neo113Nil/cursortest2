<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voip_session_rooms_admin_configure_rooms_dialog_configure"
    android:background="@drawable/bg_dark_top_rounded_corners_16"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/voip_failed_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="voip_room_participant_loading_failed_description,voip_room_participant_load_retry_button"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="14dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/accessibility_back"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"
        app:srcCompat="@drawable/vk_icon_arrow_left_outline_28"
        app:tint="?attr/vk_ui_text_primary"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:contentInsetStart="0dp"
        app:layout_constraintEnd_toStartOf="@+id/voip_room_options"
        app:layout_constraintStart_toEndOf="@+id/back"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/voip_session_room_admin_rooms_and_participants"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:titleTextColor="?attr/vk_ui_text_primary"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_room_options"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="fitEnd"
        android:contentDescription="@string/voip_session_room_admin_create_room_content_description"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toStartOf="@+id/voip_join_room_button"
        app:layout_constraintStart_toEndOf="@+id/toolbar"
        app:layout_constraintTop_toTopOf="@+id/toolbar"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_text_primary"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline2Normal"
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/voip_join_room_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_session_room_join_title"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/voip_room_options"
        app:layout_constraintTop_toTopOf="@+id/toolbar"/>
    <View
        android:id="@+id/voip_tool_bar_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.vk.core.view.components.search.VkSearchView
        android:id="@+id/voip_room_participant_search"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/voip_room_participants_list"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:cacheColorHint="@android:color/transparent"
        android:requiresFadingEdge="none"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/voip_save_room_participants_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_room_participant_search"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/voip_save_room_participants_button"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:text="@string/voip_session_room_admin_save_room_participants"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_room_participants_list"/>
    <ProgressBar
        android:id="@+id/voip_room_participant_loading_progress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="84dp"
        android:layout_marginBottom="92dp"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/voip_room_participant_loading_failed_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/voip_session_room_admin_room_participants_reload_description"
        android:maxLines="3"
        android:lines="2"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/voip_room_participant_load_retry_button"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="44dp"
        android:text="@string/voip_session_room_admin_room_participants_reload_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_room_participant_loading_failed_description"
        style="@style/VkUiTypography.Headline1Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
