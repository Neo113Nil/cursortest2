<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/live_end_broadcast_settings_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/end_settings_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/live_end_broadcast_settings_to_my_story_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.cell.VkCell
        android:id="@+id/live_end_broadcast_settings_to_my_wall_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/live_end_broadcast_settings_positive_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/live_broadcast_end_screen_save_record_do"
        android:layout_marginHorizontal="@dimen/modal_settings_horizontal_padding"
        android:layout_marginVertical="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"/>
</LinearLayout>
