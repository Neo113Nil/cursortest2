<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/state_requests_present"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"/>
        <TextView
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="32dp"
            style="@style/VkLegacyTypography.Title2.Medium"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_secondary"
            android:gravity="center"
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="32dp"
            style="@style/VkLegacyTypography.Headline.Regular.NoEllipsize"/>
        <TextView
            android:id="@+id/move_to_followers_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/requests_list_move_to_followers"
            android:layout_marginHorizontal="32dp"
            style="@style/VkLegacyButton.Primary"/>
    </LinearLayout>
    <TextView
        android:textColor="?attr/vk_legacy_text_secondary"
        android:gravity="center"
        android:id="@+id/state_no_requests"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/requests_list_move_to_followers_no_requests"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="48dp"
        style="@style/VkLegacyTypography.Headline.Regular.NoEllipsize"/>
</FrameLayout>
