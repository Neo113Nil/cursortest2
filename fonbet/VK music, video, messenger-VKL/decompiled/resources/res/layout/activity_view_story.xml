<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.story.viewer.impl.presentation.stories.view.StoriesViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.stories.tool.view.NoOverlappingRenderingFrameLayout
        android:id="@+id/fl_loading_view"
        android:background="#3f3f3f"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/iv_loading_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="focusCrop"/>
        <com.vk.stories.design.view.viewer.StoryViewHeader
            android:id="@+id/story_view_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            style="@style/Base.Widget.AppCompat.ProgressBar"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_expired_message"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_error_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_story_expired_72"/>
            <TextView
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:id="@+id/tv_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/story_expired"
                style="@style/VkUiTypography.Subhead"/>
        </LinearLayout>
    </com.vk.stories.tool.view.NoOverlappingRenderingFrameLayout>
    <com.vk.stories.design.view.viewer.VolumeControlView
        android:id="@+id/vcv_volume_control_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
</merge>
