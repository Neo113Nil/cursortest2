<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="28dp">
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/video_author_donut_button"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="8dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="small"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:gravity="center"
        android:id="@+id/video_author_subscribe_button"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/video_subscribe_author"
        android:layout_marginEnd="4dp"
        android:paddingHorizontal="12dp"
        app:buttonSizeType="small"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:gravity="center"
        android:id="@+id/video_author_analytics_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/video_analytics_author"
        android:layout_marginEnd="4dp"
        android:paddingHorizontal="12dp"
        app:buttonSizeType="small"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/video_author_notification_button"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:paddingHorizontal="8dp"
        style="@style/VideoAuthorSmallButton">
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/video_author_notification_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/profile_btn_subscribed"
            android:layout_marginEnd="1dp"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <com.vk.core.view.components.picture.VkImageSimple
            android:id="@+id/video_author_notification_chevron_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginStart="1dp"
            app:srcCompat="@drawable/ic_dropdown_12"
            app:tint="?attr/vk_ui_icon_secondary"/>
    </LinearLayout>
</LinearLayout>
