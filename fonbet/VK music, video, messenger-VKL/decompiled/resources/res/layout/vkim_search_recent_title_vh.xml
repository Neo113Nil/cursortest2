<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <TextView
        android:textSize="17sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/vkim_search_recent"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="16dp"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/vkim_recent_clear"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_cancel_24_in_circle_bg_transparent"
        android:contentDescription="@string/accessibility_clear"
        android:layout_marginEnd="8dp"/>
</FrameLayout>
