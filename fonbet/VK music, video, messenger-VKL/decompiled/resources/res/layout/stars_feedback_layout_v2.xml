<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.ecomm.market.ui.view.ratingview.DynamicRatingView
        android:id="@+id/rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:drawable="@drawable/vk_icon_favorite_outline_36"
        app:emptyColor="?attr/vk_ui_icon_secondary"
        app:filledColor="?attr/vk_ui_icon_secondary"
        app:filledDrawable="@drawable/vk_icon_favorite_36"
        app:paddingBetween="19dp"
        app:rating="0"
        app:ratingCount="5"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/not_interesting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="16dp"
        android:textAlignment="gravity"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/interesting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="16dp"
        android:textAlignment="gravity"
        style="@style/VkUiTypography.Footnote"/>
</merge>
