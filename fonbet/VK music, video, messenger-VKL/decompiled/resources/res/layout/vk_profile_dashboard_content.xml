<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/vk_profile_dashboard_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/vk_profile_dashboard_passport_content"/>
    <View
        android:id="@+id/vk_passport_container_separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:id="@+id/vk_passport_vkpay_combo_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/vk_passport_vkpay_container"
            android:background="@drawable/vk_profile_dashboard_vkpay_ripple_left_corner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:layout_marginEnd="36dp">
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/vk_dashboard_vkpay_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/VkUiTypography.Caption1"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_accent"
                    android:id="@+id/vk_dashboard_vkpay_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/VkUiTypography.SubheadMedium"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/vk_dashboard_vkpay_icon_box"
                android:paddingTop="2dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:paddingStart="2dp"
                app:srcCompat="@drawable/vk_passport_dashboard_vkpay"
                app:tint="?attr/vk_ui_icon_tertiary"/>
        </FrameLayout>
        <View
            android:id="@+id/vk_passport_vkpay_combo_separator"
            android:background="?attr/vk_ui_separator_primary"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/vk_passport_vkcombo_container"
            android:background="@drawable/vk_profile_dashboard_vkcombo_ripple"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:layout_marginEnd="36dp">
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/vk_dashboard_vkcombo_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/VkUiTypography.Caption1"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_accent"
                    android:id="@+id/vk_dashboard_vkcombo_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/VkUiTypography.SubheadMedium"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/vk_dashboard_vkcombo_icon_box"
                android:paddingTop="2dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:paddingStart="2dp"
                app:srcCompat="@drawable/vk_passport_dashboard_combo"
                app:tint="?attr/vk_ui_icon_tertiary"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
