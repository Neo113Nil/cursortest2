<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:paddingTop="6dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="14dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toStartOf="@+id/buttons_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/pack_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/VkUiTypography.Headline1Normal"/>
        <ImageView
            android:id="@+id/pack_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/pack_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/buttons_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_container"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttons_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/pack_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/title_container"
        app:layout_constraintTop_toTopOf="@+id/title_container"
        app:layout_constraintVertical_bias="0.5">
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/pack_check"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:layout_marginEnd="8dp"
            app:buttonMode="secondary"
            app:icon="@drawable/vk_icon_done_16"
            app:iconColorful="false"
            app:iconSize="16dp"
            app:layout_constraintEnd_toStartOf="@+id/pack_buy"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vk.vas.design.view.VkDiscountTextView
            android:id="@+id/pack_buy"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="62dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/pack_gift"
            app:layout_constraintTop_toTopOf="parent"
            app:vk_discountButtonStyle="commerce"/>
        <com.vk.core.view.components.button.VkButton
            android:id="@+id/pack_gift"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            app:buttonAppearance="positive"
            app:buttonMode="primary"
            app:icon="@drawable/vk_icon_gift_16"
            app:iconSize="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/context_user_avatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/buttons_container"
        app:layout_constraintStart_toEndOf="@+id/buttons_container"
        app:layout_constraintTop_toTopOf="@+id/buttons_container"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundingBorderColor="?attr/vk_ui_separator_primary"
        app:roundingBorderWidth="0.5dp"/>
    <ImageView
        android:id="@+id/context_user_check"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/shape_sticker_pack_context_user_check"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="@+id/context_user_avatar"
        app:layout_constraintTop_toTopOf="@+id/context_user_avatar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/stickers_recycler_preview"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pack_subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
