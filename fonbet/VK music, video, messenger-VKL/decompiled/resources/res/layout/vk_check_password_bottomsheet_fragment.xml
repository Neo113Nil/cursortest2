<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/check_password_navigation_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cancel_outline_28"
        app:tint="?attr/vk_ui_accent_blue"/>
    <com.vk.auth.ui.VkAuthTextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle1SemiBold"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/toolbar_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vk_enter_password_vkid"
        android:singleLine="true"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.4"
        app:layout_constraintStart_toEndOf="@+id/check_password_navigation_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_title"/>
    <com.vk.auth.ui.VkAuthTextView
        android:textAppearance="@style/VkUiTypography.ParagraphNormal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="left"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vk_connect_ask_password_cua"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <com.vk.auth.ui.VkAuthPasswordView
        android:id="@+id/password_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/error_view"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:vk_edit_text_background="@drawable/vk_auth_bg_edittext_stated"
        app:vk_edit_text_hint="@string/vk_auth_sign_up_enter_password_hint"
        app:vk_edit_text_layout="@layout/vk_auth_landing_password_edittext"
        app:vk_toggle_button_content_description="@string/vk_auth_show_pass"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteNormal"
        android:textColor="?attr/vk_ui_text_negative"
        android:gravity="start"
        android:id="@+id/error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/password_container"/>
    <com.vk.auth.ui.VkAuthTextView
        android:textColor="?attr/vk_ui_text_accent"
        android:gravity="center_horizontal"
        android:id="@+id/forget_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vk_auth_forgot_pass"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_view"
        app:layout_goneMarginTop="16dp"
        style="@style/VkUiTypography.HeadlineMedium"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/content_group"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="password_container, next,         description, forget_password, toolbar_title, divider"/>
    <include
        android:id="@+id/retry_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintVertical_bias="0"
        layout="@layout/vk_auth_error_retry_layout"/>
    <ProgressBar
        android:id="@+id/progress"
        android:visibility="visible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/vk_ui_icon_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <com.vk.auth.ui.VkLoadingButton
        android:id="@+id/next"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/vk_auth_confirm"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/forget_password"
        style="@style/VkAuth.Button.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
