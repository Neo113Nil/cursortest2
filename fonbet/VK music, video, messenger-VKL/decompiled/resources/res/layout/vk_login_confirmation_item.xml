<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="9dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/login_confirmation_info_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/VkUiTypography.Subhead"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/login_confirmation_info_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        style="@style/VkUiTypography.Headline1Normal"/>
</LinearLayout>
