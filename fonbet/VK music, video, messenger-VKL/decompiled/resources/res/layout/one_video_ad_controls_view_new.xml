<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <one.video.ad.ux.postview.AdPostView
        android:id="@+id/post_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/one_video_white"
        android:gravity="center_vertical"
        android:id="@+id/video_ad_title"
        android:background="@drawable/one_video_ad_title_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/one_video_ad_title"
        android:drawablePadding="5dp"
        android:fontFamily="@font/vk_roboto_medium"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <one.video.ad.ux.ShoppableAdView
        android:id="@+id/video_ad_shoppable_products"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/one_video_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/video_ad_skip"
        android:background="@drawable/one_video_ad_skip_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:layout_marginEnd="24dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toStartOf="@+id/sound_control"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OneVideoUiTypography.Caption1Normal"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sound_control"
        android:background="@drawable/one_video_ad_title_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:src="@drawable/one_video_volume_on_24"
        android:contentDescription="@string/one_video_video_accessibility_sound_off"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <one.video.ad.ux.AdRedirectView
        android:id="@+id/video_ad_redirect"
        android:background="@drawable/one_video_background_rounded_12_redirect"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/video_ad_progress_bar"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/one_video_white"
        android:gravity="center_vertical"
        android:id="@+id/video_ad_pip_title"
        android:background="@drawable/one_video_ad_title_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/one_video_ad_title"
        android:drawablePadding="5dp"
        android:fontFamily="@font/vk_roboto_regular"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/video_ad_progress_bar"
        app:layout_constraintStart_toStartOf="parent"/>
    <ProgressBar
        android:id="@+id/video_ad_progress_bar"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:max="1"
        android:progress="0"
        android:progressDrawable="@drawable/one_video_ad_horizontal_progress_new"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <one.video.ad.ux.motion.view.OneVideoMotionView
        android:id="@+id/video_motion_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
