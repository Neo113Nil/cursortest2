<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/gift_card_view"
            android:layout_width="@dimen/vkim_gift_size"
            android:layout_height="@dimen/vkim_gift_size"
            app:cardBackgroundColor="?attr/vk_ui_transparent"
            app:cardCornerRadius="?attr/im_msg_part_corner_radius_big"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toStartOf="@+id/votes_plus_icon"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.vk.imageloader.view.VKImageView
                    android:id="@+id/background_image_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:roundedCornerRadius="?attr/im_msg_part_corner_radius_big"/>
                <com.vk.stickers.views.particles.ParticleView
                    android:id="@+id/background_animation_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/vkim_animated_bg_margin"/>
                <ImageView
                    android:id="@+id/glass_image_view"
                    android:background="@drawable/limited_gift_glass"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/vkim_animated_bg_margin"
                    android:importantForAccessibility="no"/>
                <com.vk.core.view.fresco.VKEnhancedImageView
                    android:id="@+id/gift_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/vkim_gift_margin"
                    android:contentDescription="@string/vkim_accessibility_gift_simple"
                    app:imageScaleType="fit_center"
                    app:vk_layout_isAdjust="true"/>
                <com.vk.stickers.views.gift.AnimatedGiftView
                    android:id="@+id/animated_gift"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/vkim_gift_margin"
                    android:contentDescription="@string/vkim_accessibility_gift_simple"/>
                <com.vk.imageloader.view.VKImageView
                    android:id="@+id/gift_badge"
                    android:background="@drawable/bg_limited_gift_badge"
                    android:padding="9dp"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/vk_icon_sparkle_16"
                    android:layout_marginStart="20dp"
                    android:elevation="2dp"
                    app:tint="@color/vk_white"/>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
        <ImageView
            android:id="@+id/votes_plus_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/vk_icon_add_alt_20"
            android:contentDescription="@null"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/gift_card_view"
            app:layout_constraintEnd_toStartOf="@+id/votes_image"
            app:layout_constraintStart_toEndOf="@+id/gift_card_view"
            app:layout_constraintTop_toTopOf="@+id/gift_card_view"
            app:tint="?attr/vk_ui_icon_secondary_alpha"/>
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/votes_image"
            android:visibility="gone"
            android:layout_width="@dimen/vkim_gift_size_with_votes"
            android:layout_height="@dimen/vkim_gift_size_with_votes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/votes_plus_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.SubheadMedium"
            android:textColor="?attr/vk_ui_text_secondary_alpha"
            android:gravity="center"
            android:id="@+id/gift_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vkim_msg_list_gift_simple_title"
            android:maxLines="2"
            android:drawablePadding="6dp"
            android:layout_marginHorizontal="4dp"
            app:drawableTint="?attr/vk_ui_icon_secondary_alpha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_card_view"/>
        <com.vk.im.ui.views.span.SpanPressableTextView
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/gift_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_title"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/gift_first_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vkim_msg_list_gift_simple_button_my"
            android:layout_marginHorizontal="4dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_description"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/gift_second_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vkim_msg_list_gift_stickers_button_reply"
            android:layout_marginHorizontal="4dp"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"
            app:buttonSizeType="small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_first_button"/>
        <com.vk.im.ui.views.msg.TimeAndStatusView
            android:textAppearance="@style/VkUiTypography.Caption2"
            android:id="@+id/time_and_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_second_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
