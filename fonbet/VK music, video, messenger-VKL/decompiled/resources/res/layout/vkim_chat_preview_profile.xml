<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vkim_preview_profile_card"
        android:paddingLeft="16dp"
        android:paddingTop="24dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.im.ui.views.avatars.AvatarView
            android:id="@+id/vkim_preview_profile_avatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/vkim_accessibility_avatar"
            app:layout_constraintBottom_toTopOf="@+id/vkim_preview_profile_name"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/VkIm.AvatarView"/>
        <TextView
            android:textSize="20sp"
            android:textColor="?attr/vk_legacy_text_muted"
            android:id="@+id/vkim_preview_profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4sp"
            android:fontFamily="@string/font_family_medium"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/vkim_preview_profile_friend_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vkim_preview_profile_avatar"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/vk_legacy_text_subhead"
            android:id="@+id/vkim_preview_profile_friend_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vkim_chat_profile_friends_status_friends"
            android:lineSpacingExtra="3sp"
            android:fontFamily="@string/font_family_regular"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/vkim_preview_profile_mutual_friends_avatars"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vkim_preview_profile_name"/>
        <com.vk.im.ui.views.avatars.StackAvatarView
            android:orientation="horizontal"
            android:id="@+id/vkim_preview_profile_mutual_friends_avatars"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            app:layout_constraintBottom_toTopOf="@+id/vkim_preview_profile_mutual_friends_subtitle"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vkim_preview_profile_friend_title"
            app:vkim_drawingOrder="usual"
            app:vkim_extraColor="?attr/vk_legacy_icon_secondary"
            app:vkim_iconOffset="-8dp"
            app:vkim_iconSize="44dp"
            app:vkim_strokeColor="?attr/vk_legacy_modal_card_background"
            app:vkim_strokeWidth="2dp"
            app:vkim_useExtraView="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/vk_legacy_text_subhead"
            android:id="@+id/vkim_preview_profile_mutual_friends_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3sp"
            android:fontFamily="@string/font_family_regular"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/vkim_preview_profile_city_icon"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vkim_preview_profile_mutual_friends_avatars"/>
        <ImageView
            android:id="@+id/vkim_preview_profile_city_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/vk_icon_home_outline_20"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/vkim_preview_profile_occupation_text"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/vkim_preview_profile_city_text"
            app:layout_constraintTop_toBottomOf="@+id/vkim_preview_profile_mutual_friends_subtitle"
            app:tint="?attr/vk_legacy_icon_outline_secondary"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/vkim_preview_profile_city_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/vk_sans_text_regular"
            android:layout_marginStart="12dp"
            android:letterSpacing="-0.007"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/vkim_preview_profile_city_icon"
            app:layout_constraintLeft_toRightOf="@+id/vkim_preview_profile_city_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/vkim_preview_profile_city_icon"/>
        <ImageView
            android:id="@+id/vkim_preview_profile_occupation_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="14dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/vkim_preview_profile_birthday_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/vkim_preview_profile_occupation_text"
            app:layout_constraintTop_toBottomOf="@+id/vkim_preview_profile_city_icon"
            app:tint="?attr/vk_legacy_icon_outline_secondary"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/vkim_preview_profile_occupation_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/vk_sans_text_regular"
            android:layout_marginStart="12dp"
            android:letterSpacing="-0.007"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/vkim_preview_profile_occupation_icon"
            app:layout_constraintLeft_toRightOf="@+id/vkim_preview_profile_occupation_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/vkim_preview_profile_occupation_icon"/>
        <ImageView
            android:id="@+id/vkim_preview_profile_birthday_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/vk_icon_cake_outline_20"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/vkim_preview_profile_button"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/vkim_preview_profile_birthday_text"
            app:layout_constraintTop_toBottomOf="@+id/vkim_preview_profile_occupation_icon"
            app:tint="?attr/vk_legacy_icon_outline_secondary"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/vkim_preview_profile_birthday_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/vk_sans_text_regular"
            android:layout_marginStart="12dp"
            android:letterSpacing="-0.007"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/vkim_preview_profile_birthday_icon"
            app:layout_constraintLeft_toRightOf="@+id/vkim_preview_profile_birthday_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/vkim_preview_profile_birthday_icon"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/vkim_preview_profile_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:text="@string/vkim_msg_list_empty_friends_status_add"
            android:fontFamily="@string/font_family_medium"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vkim_preview_profile_birthday_icon"
            style="@style/VkLegacyButton.Primary"/>
        <com.pnikosis.materialishprogress.ProgressWheel
            android:id="@+id/vkim_preview_profile_button_progress"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/vkim_preview_profile_button"
            app:layout_constraintLeft_toLeftOf="@+id/vkim_preview_profile_button"
            app:layout_constraintRight_toRightOf="@+id/vkim_preview_profile_button"
            app:layout_constraintTop_toTopOf="@+id/vkim_preview_profile_button"
            app:matProg_barColor="?attr/vk_legacy_accent"
            app:matProg_progressIndeterminate="true"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_subhead"
            android:gravity="top|center_horizontal"
            android:id="@+id/vkim_preview_profile_blocked_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/vkim_preview_profile_button"
            app:layout_constraintLeft_toLeftOf="@+id/vkim_preview_profile_button"
            app:layout_constraintRight_toRightOf="@+id/vkim_preview_profile_button"
            app:layout_constraintTop_toTopOf="@+id/vkim_preview_profile_button"
            style="@style/VkRobotoRegularStyle.SubHead"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/vkim_preview_profile_mutual_friends"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="vkim_preview_profile_mutual_friends_avatars,vkim_preview_profile_mutual_friends_subtitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/vkim_preview_profile_occupation"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="vkim_preview_profile_occupation_icon,vkim_preview_profile_occupation_text"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/vkim_preview_profile_city"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="vkim_preview_profile_city_icon,vkim_preview_profile_city_text"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/vkim_preview_profile_birthday"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="vkim_preview_profile_birthday_icon,vkim_preview_profile_birthday_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.pnikosis.materialishprogress.ProgressWheel
        android:id="@+id/vkim_preview_profile_loading_progress"
        android:paddingLeft="16dp"
        android:paddingTop="24dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="24dp"
        app:matProg_barColor="?attr/vk_legacy_accent"
        app:matProg_progressIndeterminate="true"/>
</FrameLayout>
