<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/bcb_send"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/bcb_send_text"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:drawablePadding="8dp"
            android:layout_centerHorizontal="true"
            android:translationX="-12sp"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline2"
            android:textColor="?attr/vk_ui_text_primary_invariably"
            android:gravity="center"
            android:id="@+id/bcb_send_counter"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minWidth="24dp"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:translationX="-12dp"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/bcb_send_text"/>
    </RelativeLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/bcb_cancel"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_centerHorizontal="true"/>
</merge>
