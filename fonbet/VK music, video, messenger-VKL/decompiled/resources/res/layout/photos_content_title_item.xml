<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/text_frame"
        android:background="@drawable/highlight"
        android:paddingLeft="@dimen/post_side_padding"
        android:paddingRight="@dimen/post_side_padding"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:id="@+id/text"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="@string/font_family_medium"
            style="@style/VkLegacyTypography.Title2"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_secondary"
            android:id="@+id/count"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFamily="@string/font_family_medium"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="8dp"
            style="@style/VkLegacyTypography.Caption1"/>
    </LinearLayout>
    <TextView
        android:textColor="?attr/vk_legacy_accent"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/highlight"
        android:paddingLeft="@dimen/post_side_padding"
        android:paddingRight="@dimen/post_side_padding"
        android:duplicateParentState="false"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="@string/all_albums"
        style="@style/VkLegacyTypography.Text.Regular"/>
</LinearLayout>
