<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/voip_whiteboard_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/voip_whiteboard_actions_background"
        android:layout_width="0dp"
        android:layout_height="@dimen/voip_whiteboard_actions_background_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.voip.ui.menu.ui.actions.PrimaryActionsView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/voip_whiteboard_primary_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:translationY="@dimen/voip_whiteboard_actions_translation"
        app:actionsBottomMargin="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.voip.ui.hint.VoipHintView
        android:id="@+id/voip_hint_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/voip_whiteboard_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/accessibility_back"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_cross_large_outline_28"
        app:tint="?attr/vk_ui_button_icon"/>
    <ImageView
        android:id="@+id/voip_whiteboard_expand"
        android:background="@drawable/voip_whiteboard_button_background"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="72dp"
        android:scaleType="center"
        android:contentDescription="@string/voip_whiteboard_hide_buttons_accessibility"
        android:rotation="180"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/vk_icon_chevron_down_24"
        app:tint="@color/vk_white"/>
    <ProgressBar
        android:id="@+id/voip_whiteboard_progress_bar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
