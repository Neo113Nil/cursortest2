<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/image"
        android:layout_width="@dimen/vk_expandable_menu_item_width"
        android:layout_height="@dimen/vk_expandable_menu_item_height"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="10dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/counter_badge_view"
        android:background="@drawable/vk_menu_counter_badge_bg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vk_expandable_menu_counter_height"
        android:minWidth="@dimen/vk_expandable_menu_counter_min_width"
        android:textAlignment="center"
        android:layout_marginEnd="2dp"
        android:paddingHorizontal="8dp"
        style="@style/VkUiTypography.Headline2"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/dot_badge_view"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="10dp"
        app:srcCompat="@drawable/vk_menu_dot_badge_bg"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/new_badge_view"
        android:background="@drawable/vk_new_badge_bg_32"
        android:layout_width="@dimen/vk_expandable_menu_badge_width"
        android:layout_height="@dimen/vk_expandable_menu_badge_height"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="10dp"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:srcCompat="@drawable/vk_icon_badge_new_32"/>
</merge>
