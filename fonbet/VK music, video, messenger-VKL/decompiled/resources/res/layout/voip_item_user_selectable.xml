<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.vk.voip.ui.avatars.VoipAvatarViewContainer
        android:id="@+id/voip_caller_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAvatarSize="48dp"
        style="@style/UserSmallPhoto"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voip_icon_selected"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_done_circle_16"
        app:tint="?attr/vk_ui_icon_accent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/voip_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/voip_call_from_your_name"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voip_icon_selected"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/voip_caller_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="36dp"
        style="@style/VkLegacyTypography.Headline.Regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
