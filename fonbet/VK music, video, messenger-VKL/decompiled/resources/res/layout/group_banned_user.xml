<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:paddingLeft="@dimen/post_side_padding"
                android:paddingTop="16dp"
                android:paddingRight="@dimen/post_side_padding"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.imageloader.view.VKCircleImageView
                    android:id="@+id/photo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="12dp"
                    app:placeholderImage="@drawable/user_placeholder"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Text"
                    android:textColor="?attr/vk_ui_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_alignTop="@+id/photo"
                    android:layout_toEndOf="@+id/photo"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Footnote"
                    android:textColor="?attr/vk_ui_text_subhead"
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_below="@+id/name"
                    android:layout_toEndOf="@+id/photo"/>
            </RelativeLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_ban_duration"
                android:textAllCaps="true"
                style="@style/CardsSectionHeader"/>
            <com.vkontakte.android.ui.OverlaySpinner
                android:id="@+id/group_ban_duration"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:overlayDrawable="@drawable/highlight"
                app:padAsBackground="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_ban_reason"
                android:textAllCaps="true"
                style="@style/CardsSectionHeader"/>
            <com.vkontakte.android.ui.OverlaySpinner
                android:id="@+id/group_ban_reason"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:overlayDrawable="@drawable/highlight"
                app:padAsBackground="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/comment"
                android:textAllCaps="true"
                style="@style/CardsSectionHeader"/>
            <EditText
                android:textColor="?attr/vk_ui_text_muted"
                android:textColorHint="?attr/vk_ui_text_secondary"
                android:gravity="start|top"
                android:id="@+id/group_ban_comment"
                android:background="@null"
                android:paddingLeft="@dimen/post_side_padding"
                android:paddingTop="12dp"
                android:paddingRight="@dimen/post_side_padding"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/group_ban_comment_hint"
                android:lines="3"
                android:inputType="text"
                style="@style/CardTextEdit"/>
            <View
                android:background="?attr/vk_ui_separator_primary_alpha"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <FrameLayout
                android:paddingLeft="@dimen/post_side_padding"
                android:paddingRight="@dimen/post_side_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <CheckBox
                    android:textAppearance="@style/VkUiTypography.Text"
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/group_ban_show_comment"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/group_ban_show_comment"
                    android:drawablePadding="16dp"
                    app:drawableStartCompat="@android:color/transparent"/>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.OverlayTextView
                android:textAppearance="@style/VkUiTypography.SubheadMedium"
                android:textColor="?attr/vk_ui_text_accent"
                android:gravity="center_vertical"
                android:id="@+id/button_remove"
                android:paddingLeft="@dimen/post_side_padding"
                android:paddingRight="@dimen/post_side_padding"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/unblock_user"
                app:overlayDrawable="@drawable/highlight_post"/>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
