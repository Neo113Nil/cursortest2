<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/pds_bg_donut_gradient_small"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/vk_ui_spacing_size_m"
    android:paddingVertical="@dimen/vk_ui_spacing_size_s">
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@+id/donut_one_time_badge_small_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:srcCompat="@drawable/vk_icon_donut_color_20"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:layout_gravity="center"
        android:id="@+id/donut_one_time_badge_small_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_s"
        style="@style/VkUiTypography.Headline1"/>
</merge>
