<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/voip_screen_share_modal_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"/>
    <com.vk.core.view.components.checkbox.VkCheckboxItem
        android:id="@+id/voip_screen_share_modal_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/voip_screen_share_checkbox_subtitle"
        app:title="@string/voip_screen_share_checkbox_title"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/voip_screen_share_modal_start_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:text="@string/voip_screen_share_start_button"/>
</LinearLayout>
