<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.FitSystemWindowsFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:fitsSystemWindows="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.libvideo.design.view.swipe.layout.SwipeLayout
            android:id="@+id/swipe_layout"
            android:fitsSystemWindows="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.libvideo.design.view.swipe.SwipeFrameLayout
                android:id="@+id/drag_view"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.vk.libvideo.design.view.video.VideoView
                    android:layout_gravity="center"
                    android:id="@+id/video_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.vk.libvideo.design.view.swipe.SwipeFrameLayout>
            <com.vk.libvideo.design.view.toolbar.VideoToolbarView
                android:id="@+id/toolbar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="end"
                android:layout_gravity="end"
                android:orientation="vertical"
                android:id="@+id/video_nameplates"
                android:paddingTop="24dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:paddingEnd="16dp"/>
            <com.vk.libvideo.design.view.panel.VideoBottomPanelView
                android:layout_gravity="bottom"
                android:id="@+id/bottom_panel"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0"/>
            <com.vk.libvideo.ui.VideoPlayerAdsPanel
                android:layout_gravity="bottom"
                android:id="@+id/ads_panel"
                android:visibility="gone"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.vk.libvideo.design.view.swipe.layout.SwipeLayout>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/bottom_promo_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/video_bottom_promo_container_width"
            android:translationY="@dimen/video_bottom_promo_container_width"/>
        <androidx.fragment.app.FragmentContainerView
            android:layout_gravity="end"
            android:id="@+id/right_promo_container"
            android:visibility="gone"
            android:layout_width="@dimen/video_right_promo_container_width"
            android:layout_height="match_parent"
            android:translationX="@dimen/video_right_promo_container_width"/>
    </FrameLayout>
</com.vk.core.view.FitSystemWindowsFrameLayout>
