<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/empty_icon"
        android:layout_width="@dimen/vkim_list_empty_icon_size"
        android:layout_height="@dimen/vkim_list_empty_icon_size"
        android:scaleType="centerInside"
        android:contentDescription="@null"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.ParagraphSemiBold"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/empty_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"/>
</merge>
