<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="180dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"/>
    </com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp">
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/icon_skeleton_header_error_hide"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/hide_not_interesting"
            app:srcCompat="@drawable/vk_icon_cancel_outline_24"
            app:tint="?attr/vk_ui_icon_secondary"/>
    </FrameLayout>
</LinearLayout>
