<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">
    <com.vk.imageloader.VkSimpleDraweeView
        android:id="@+id/image"
        android:background="@drawable/voip_bg_layer_stroke05_border6"
        android:layout_width="136dp"
        android:layout_height="76dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="12dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/vk_icon_video_28"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="6dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/icon_label"
        android:background="@drawable/bg_rounded_black_alpha35_corner4"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:maxWidth="120dp"
        android:text="@string/voip_broadcast_label_upcoming"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_roboto_medium"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:letterSpacing="0.01"
        app:layout_constraintBottom_toTopOf="@+id/owner"
        app:layout_constraintEnd_toStartOf="@+id/selection"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/owner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toTopOf="@+id/date"
        app:layout_constraintEnd_toStartOf="@+id/selection"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/selection"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toBottomOf="@+id/owner"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/selection"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/vk_ic_check_circle_24"
        android:tint="?attr/vk_ui_icon_accent"
        android:importantForAccessibility="no"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
