<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/vk_conscious_registration_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/vk_conscious_registration_icon_illustration_welcome"
            app:srcCompat="@drawable/vk_icon_illustration_create_account_120h"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:id="@+id/conscious_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/vk_conscious_registration_title"
            style="@style/VkUiTypography.Title2Medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/conscious_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vk_conscious_registration_subtitle"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/VkUiTypography.Text"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <com.vk.auth.ui.VkLoadingButton
            android:textColor="?attr/vk_ui_text_contrast_themed"
            android:id="@+id/continue_btn"
            android:background="@drawable/vk_ui_auth_bg_landing_primary_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/vk_auth_account_continue"
            app:vk_lb_text_appearance="@style/VkUiTypography.Headline1"
            style="@style/VKID.View.Button.Primary"/>
        <com.vk.auth.ui.VkAuthClickableTextView
            android:textAppearance="@style/VkUiTypography.Headline1"
            android:textColor="?attr/vk_ui_text_accent_themed"
            android:id="@+id/use_alternative_auth_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="@string/vk_conscious_registration_enter_account"
            style="@style/VKID.View.Button.Secondary"/>
        <com.vk.auth.ui.VkAuthTextView
            android:id="@+id/help_button"
            android:padding="@dimen/vk_ui_button_padding_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vk_auth_help_button"
            style="@style/VkAuth.Button.Landing.Tertiary"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            layout="@layout/vk_terms_layout"/>
    </LinearLayout>
</LinearLayout>
