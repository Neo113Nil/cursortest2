<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/catalog_slider_item"
    android:background="@drawable/music_selectable_bg_corner_4"
    android:paddingTop="2dp"
    android:paddingBottom="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.catalog2.common.ui.holders.group.avatar.GroupAvatarViewContainer
        android:id="@+id/avatar"
        android:layout_width="@dimen/catalog_link_small_content_item_size_live_badge"
        android:layout_height="@dimen/catalog_link_small_content_item_size_live_badge"
        android:layout_marginStart="0dp"
        app:contourOverlayEnabled="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:originalAvatarPadding="6dp"
        app:originalAvatarSize="@dimen/catalog_link_small_content_item_width_live_badge"/>
    <ImageView
        android:id="@+id/icon_meta"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:scaleType="center"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:translationX="1dp"
        android:translationY="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="@+id/avatar"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:maxLines="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
