<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/vkim_snackbar_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="480dp"
    android:minHeight="54dp"
    android:elevation="4dp">
    <com.vk.im.ui.views.avatars.AvatarView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        style="@style/VkIm.AvatarView"/>
    <TextView
        android:textAppearance="@style/VkLegacyTypography.Text"
        android:textColor="?attr/vk_legacy_text_primary"
        android:layout_gravity="center_vertical"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
