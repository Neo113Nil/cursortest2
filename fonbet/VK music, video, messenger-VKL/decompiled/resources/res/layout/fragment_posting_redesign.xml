<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/posting_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/WhiteTheme">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/posting_scroll_content"
        android:background="?attr/vk_legacy_background_content"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="104dp"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/posting_linear_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.dto.stories.model.mention.SelectionChangeEditText
                    android:textSize="20dp"
                    android:textColor="?attr/vk_legacy_text_primary"
                    android:textColorHint="?attr/vk_legacy_text_placeholder"
                    android:id="@+id/posting_edit_text"
                    android:background="@null"
                    android:paddingLeft="12dp"
                    android:paddingTop="9dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="14dp"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/what_new"
                    android:maxLength="16384"
                    android:inputType="textMultiLine"
                    android:fontFamily="sans-serif-light">
                    <requestFocus/>
                </com.vk.dto.stories.model.mention.SelectionChangeEditText>
                <com.vk.core.tool.view.RatioFrameLayout
                    android:id="@+id/posting_poster_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:orientation="horizontal"
                    app:ratio="0.75">
                    <com.vk.core.view.VKViewPager
                        android:id="@+id/posting_poster_background_pager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"/>
                    <com.vk.newsfeed.common.views.poster.PosterEditText
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/posting_poster_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/what_new"
                        android:inputType="textMultiLine"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/vk_black"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/posting_poster_mode_button"
                        android:background="@drawable/bg_color_posts_mode"
                        android:paddingLeft="@dimen/poster_action_button_left_right_space"
                        android:paddingTop="@dimen/poster_action_button_top_bottom_space"
                        android:paddingRight="@dimen/poster_action_button_left_right_space"
                        android:paddingBottom="@dimen/poster_action_button_top_bottom_space"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"/>
                    <ImageView
                        android:layout_gravity="end|top"
                        android:id="@+id/ic_close_poster"
                        android:background="@drawable/bg_button_close_black"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/vk_icon_cancel_16"
                        android:scaleType="centerInside"
                        app:tint="@color/vk_white"/>
                </com.vk.core.tool.view.RatioFrameLayout>
            </FrameLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/posting_attachments_recycler_view"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:layout_gravity="top"
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/posting_header"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/posting_hashtags"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        app:layoutManager="LinearLayoutManager"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/posting_attach_control"
        android:paddingTop="12dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="44dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        app:layoutManager="LinearLayoutManager"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="bottom"
        android:id="@+id/posting_poster_preview_recycler_view"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="44dp"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.settings.community.PostingSettingsCommunityView
        android:layout_gravity="bottom"
        android:id="@+id/posting_settings_community"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"/>
    <com.vk.newsfeed.impl.posting.viewpresenter.settings.user.PostingSettingsUserView
        android:layout_gravity="bottom"
        android:id="@+id/posting_settings_user"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"/>
    <View
        android:id="@+id/posting_mention_select_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/posting_mention_hint_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/newsfeed_newpost_bottom_panel_height"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <View
            android:id="@+id/top_divider"
            android:background="?attr/vk_legacy_separator_alpha"
            android:layout_width="match_parent"
            android:layout_height="@dimen/newsfeed_newpost_header_divider_height"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="?attr/vk_legacy_text_secondary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/posting_bottom_name_hint_text"
            android:background="?attr/vk_legacy_background_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/newsfeed_newpost_header_divider_height"
            android:text="@string/posting_name_or_address"/>
        <com.vk.core.view.ColorProgressBar
            android:layout_gravity="center_vertical"
            android:id="@+id/posting_bottom_progress_bar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:color="?attr/vk_legacy_icon_secondary"
            android:layout_marginStart="18dp"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
