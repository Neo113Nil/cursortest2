<?xml version="1.0" encoding="utf-8"?>
<com.vkontakte.android.ui.views.LoadMoreCommentsView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/load_more_comments"
    android:background="@drawable/highlight"
    android:paddingBottom="0.5dp"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="48.5dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/loadmore_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/loadmore_progress"
        android:visibility="invisible"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="1dp"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"/>
</com.vkontakte.android.ui.views.LoadMoreCommentsView>
