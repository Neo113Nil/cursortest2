<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/catalog_placeholder_layout_inner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="48dp"
    android:layout_marginBottom="@dimen/vk_bottom_navigation_height"
    android:minWidth="480dp"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/catalog_placeholder_view_image"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_placeholder_view_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:drawablePadding="12dp"
        style="@style/VkUiTypography.Title2Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_placeholder_view_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        style="@style/VkUiTypography.Text"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/catalog_placeholder_view_hint_description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        style="@style/VkUiTypography.Subhead"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/primary_button"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/secondary_button"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/tertiary_button"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="medium"/>
</LinearLayout>
