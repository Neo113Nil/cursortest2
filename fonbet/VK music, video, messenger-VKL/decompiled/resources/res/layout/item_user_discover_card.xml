<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:ratio="0.75">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/user_discover_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:placeholderImage="@drawable/user_discover_placeholder"
        app:placeholderImageScaleType="fitCenter"
        app:roundedCornerRadius="12dp"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/user_discover_placeholder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/user_discover_placeholder_icon"
            android:background="@drawable/vk_icon_do_not_disturb_outline_56"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:backgroundTint="@color/vk_gray_600"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Title2Normal"
            android:textColor="@color/vk_gray_600"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/user_discover_placeholder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
    </LinearLayout>
    <View
        android:id="@+id/user_discover_clickable"
        android:background="@drawable/highlight_radius_12"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/user_discover_info_container"
        android:paddingTop="51dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <com.vk.core.tool.view.FluidHorizontalLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:vk_layout_isFluid="true">
                <TextView
                    android:textAppearance="@style/VkUiTypography.Paragraph"
                    android:textColor="@color/vk_white"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/user_discover_mark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/users_discover_friends_recommendations"
                    android:singleLine="true"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Title2Medium"
                    android:textColor="@color/vk_white"
                    android:ellipsize="end"
                    android:id="@+id/user_discover_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="3"
                    android:shadowColor="@color/vk_black_alpha12"
                    android:shadowDy="1"
                    android:shadowRadius="8"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Paragraph"
                    android:textColor="@color/vk_white"
                    android:ellipsize="end"
                    android:id="@+id/user_discover_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:shadowColor="@color/vk_black_alpha12"
                    android:shadowDy="1"
                    android:shadowRadius="8"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="-16dp">
                    <com.vk.core.view.components.cell.VkMiniInfoCell
                        android:textAppearance="@style/VkUiTypography.Paragraph"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:id="@+id/user_discover_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:singleLine="true"/>
                </FrameLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/user_discover_message"
                android:background="@drawable/highlight_unlimited"
                android:layout_width="48dp"
                android:layout_height="48dp">
                <View
                    android:layout_gravity="center"
                    android:background="@drawable/vk_icon_message_outline_28"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:backgroundTint="@color/vk_white"/>
                <com.vk.core.view.components.counter.VkCounter
                    android:textAppearance="@style/VkUiTypography.Caption1"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="4dp"
                    app:counterAppearance="accent"
                    app:counterMode="primary"/>
            </FrameLayout>
        </com.vk.core.tool.view.FluidHorizontalLayout>
        <View
            android:id="@+id/user_discover_divider"
            android:background="@color/vk_white"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="4dp"
            android:alpha="0.4"/>
        <com.vk.core.view.components.userstack.VkUserStack
            android:id="@+id/user_discover_photos_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.5dp"
            app:avatarsPosition="left"/>
    </LinearLayout>
    <View
        android:id="@+id/user_discover_foreground_positive"
        android:background="@drawable/user_discover_foreground_positive"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/user_discover_foreground_negative"
        android:background="@drawable/user_discover_foreground_negative"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="start|top"
        android:id="@+id/user_discover_foreground_positive_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:backgroundTint="@color/vk_white"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline"
        android:textColor="@color/vk_white"
        android:gravity="start"
        android:layout_gravity="start|top"
        android:id="@+id/user_discover_foreground_positive_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:layout_marginStart="20dp"/>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/user_discover_foreground_negative_icon"
        android:background="@drawable/vk_icon_cancel_circle_outline_56"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="?attr/user_discover_foreground_positive_color"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Headline"
        android:textColor="?attr/user_discover_foreground_positive_color"
        android:gravity="end"
        android:layout_gravity="end|top"
        android:id="@+id/user_discover_foreground_negative_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="20dp"/>
    <View
        android:id="@+id/user_discover_foreground"
        android:background="@drawable/user_discover_card_foreground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</merge>
