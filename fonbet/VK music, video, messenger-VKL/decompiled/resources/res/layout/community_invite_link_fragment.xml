<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/linkLayout"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_margin="24dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:srcCompat="@drawable/vk_icon_link_circle_outline_56"
                    app:tint="?attr/vk_ui_icon_accent"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_primary"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/group_link_invitation"
                    style="@style/VkUiTypography.Title2Medium"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/group_link_invitation_descr"
                    android:lineSpacingMultiplier="1.1"
                    style="@style/VkUiTypography.Subhead"/>
                <TextView
                    android:textColor="@color/vk_ui_text_title_color"
                    android:gravity="center"
                    android:id="@+id/linkTextView"
                    android:background="@drawable/vkui_bg_edittext"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="22dp"
                    android:singleLine="true"
                    android:inputType="none"
                    android:textIsSelectable="true"
                    style="@style/VkUiTypography.Headline1Normal"/>
                <com.vk.core.view.links.LinkedTextView
                    android:textColor="?attr/vk_ui_text_subhead"
                    android:gravity="center"
                    android:id="@+id/usageTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/VkUiTypography.Subhead"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:id="@+id/bottomButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <com.vk.core.view.components.button.VkSimpleButton
                    android:gravity="center"
                    android:id="@+id/shareLinkButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/share_link"
                    app:buttonAppearance="accent"
                    app:buttonMode="primary"
                    app:buttonSizeType="large"/>
                <com.vk.core.view.components.button.VkSimpleButton
                    android:gravity="center"
                    android:id="@+id/showAllLinksButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/show_all_links"
                    app:buttonAppearance="accent"
                    app:buttonMode="secondary"
                    app:buttonSizeType="large"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.vk.lists.DefaultErrorView
        android:id="@+id/error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.VKAppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <include
            android:id="@+id/toolbar"
            android:elevation="0dp"
            layout="@layout/toolbar"/>
    </com.vk.core.view.VKAppBarLayout>
    <com.vk.core.view.AppBarShadowView style="@style/AppBarShadow"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="?attr/vk_ui_icon_tertiary"
        android:indeterminateTintMode="src_in"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
