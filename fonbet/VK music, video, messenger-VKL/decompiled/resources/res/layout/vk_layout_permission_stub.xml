<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/root_container_permission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_icon"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/vk_icon_error_triangle_outline_56"
            app:tint="?attr/vk_ui_accent_orange"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Text"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.1"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_grant_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/vk_permissions_grant_access"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_other_permission"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"/>
    </LinearLayout>
</merge>
