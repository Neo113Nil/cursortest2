<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/voip_call_invite_scan_device_qr_code_button"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/vk_icon_qr_24"
        android:scaleType="center"
        android:contentDescription="@string/voip_invite_by_qr_code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <com.vk.im.ui.views.avatars.AvatarView
        android:layout_gravity="center_horizontal"
        android:id="@+id/voip_call_invite_chat_avatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/vkim_accessibility_avatar_chat"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_call_invite_72"
        style="@style/VkIm.AvatarView"/>
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/vk_ui_text_muted"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/voip_call_invite_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4sp"
        android:fontFamily="@string/font_family_medium"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_call_invite_chat_avatar"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/vk_ui_text_subhead"
        android:layout_gravity="center_horizontal"
        android:id="@+id/voip_call_invite_participants_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3sp"
        android:fontFamily="@string/font_family_regular"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_call_invite_title"/>
    <FrameLayout
        android:id="@+id/voip_call_change_caller_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_call_invite_participants_subtitle">
        <ViewStub
            android:id="@+id/voip_call_change_caller"
            android:layout="@layout/voip_item_caller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voip_call_invite_participants_subtitle"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/voip_call_invite_join_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_call_change_caller_container">
        <FrameLayout
            android:id="@+id/voip_call_invite_join_with_video_btn"
            android:background="@drawable/vkui_bg_button_primary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <com.vk.core.view.TintTextView
                android:textSize="16sp"
                android:textColor="?attr/vk_ui_text_contrast_themed"
                android:layout_gravity="center"
                android:id="@+id/voip_video_call_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voip_history_ongoing_call_join_dialog_button_video"
                android:drawablePadding="8dp"
                android:fontFamily="@string/font_family_medium"
                app:drawableStartCompat="@drawable/vkui_ic_voip_call_video_24"
                app:drawableTint="?attr/vk_ui_text_contrast_themed"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/voip_call_invite_join_btn"
            android:background="@drawable/vkui_bg_button_primary"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:scaleType="centerInside"
            android:layout_marginStart="12dp"
            app:srcCompat="@drawable/vk_icon_phone_24"
            app:tint="?attr/vk_ui_text_contrast_themed"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/voip_call_link_share_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voip_call_invite_join_buttons_container">
        <com.vk.core.view.TintTextView
            android:textSize="16sp"
            android:layout_gravity="center"
            android:id="@+id/voip_call_link_share_btn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vkim_share_link"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/vk_icon_share_outline_24"
            app:drawableTint="?attr/vk_ui_text_accent_themed"
            style="@style/VkLegacyButton.Tertiary"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
