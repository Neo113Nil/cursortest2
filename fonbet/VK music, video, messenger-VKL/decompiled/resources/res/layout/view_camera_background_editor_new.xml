<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/pipette_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/pipette_image_layer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="52dp"/>
        <com.vk.stories.design.view.editor.PipetteColorPicker
            android:id="@+id/pipette_color_picker"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="52dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="top"
            android:id="@+id/top_gradient"
            android:background="@drawable/vk_gradient_top_112"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:alpha="0.24"/>
        <ImageView
            android:layout_gravity="start|top"
            android:id="@+id/cancel"
            android:background="@drawable/white_ripple_circle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/vk_icon_cancel_outline_shadow_large_48_close"
            android:contentDescription="@string/story_accessibility_background_cancel"
            android:layout_marginStart="8dp"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/done"
            android:background="@drawable/white_ripple_circle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/vk_icon_done_outline_shadow_large_48"
            android:contentDescription="@string/story_accessibility_background_done"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.camera.editor.stories.impl.background.views.StoryBackgroundRecyclerPaginatedView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp"/>
        <com.vk.core.view.components.tabs.VkTabs
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/type_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tabsLayoutMode="tabsLayoutAuto"
            app:tabsMode="tabsModeSecondary"/>
    </FrameLayout>
</merge>
