<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/in_call_header_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_header_minimize"
        android:background="@drawable/highlight_circle_white"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="41dp"
        android:layout_height="32dp"
        android:contentDescription="@string/voip_accessibility_picture_in_picture"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bg_swipe_indicator"
        app:tint="?attr/vk_ui_icon_medium_alpha"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/header_buttons_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="24dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_header_open_chat_screen_icon"
        android:src="@drawable/vk_icon_message_outline_shadow_large_48"
        android:contentDescription="@string/voip_accessibility_open_chat_screen"
        app:layout_constraintEnd_toStartOf="@+id/btn_header_open_users_screen_icon"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_buttons_top"
        style="@style/VoipHeaderButton"/>
    <TextView
        android:id="@+id/btn_header_open_chat_screen_counter"
        app:layout_constraintEnd_toEndOf="@+id/btn_header_open_chat_screen_icon"
        app:layout_constraintTop_toTopOf="@+id/btn_header_open_chat_screen_icon"
        style="@style/VoipHeaderButtonLabel.Major"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_header_open_users_screen_icon"
        android:src="@drawable/vk_icon_users_outline_shadow_large_48"
        android:contentDescription="@string/voip_accessibility_add_users_to_call"
        app:layout_constraintEnd_toStartOf="@+id/btn_header_switch_layout"
        app:layout_constraintStart_toEndOf="@+id/btn_header_open_chat_screen_icon"
        app:layout_constraintTop_toBottomOf="@+id/header_buttons_top"
        style="@style/VoipHeaderButton"/>
    <TextView
        android:id="@+id/btn_header_open_users_screen_counter"
        app:layout_constraintEnd_toEndOf="@+id/btn_header_open_users_screen_icon"
        app:layout_constraintTop_toTopOf="@+id/btn_header_open_users_screen_icon"
        style="@style/VoipHeaderButtonLabel.Normal"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_header_switch_layout"
        android:src="@drawable/vk_icon_grid_3_outline_shadow_large_48"
        android:contentDescription="@string/voip_accessibility_switch_layout_to_speaker_mode"
        app:layout_constraintEnd_toStartOf="@+id/btn_header_request_attention"
        app:layout_constraintStart_toEndOf="@+id/btn_header_open_users_screen_icon"
        app:layout_constraintTop_toBottomOf="@+id/header_buttons_top"
        style="@style/VoipHeaderButton"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_header_request_attention"
        android:contentDescription="@string/voip_session_room_request_admin_assistance"
        app:layout_constraintEnd_toStartOf="@+id/btn_header_join_room"
        app:layout_constraintStart_toEndOf="@+id/btn_header_switch_layout"
        app:layout_constraintTop_toBottomOf="@+id/header_buttons_top"
        app:srcCompat="@drawable/vk_icon_help_outline_shadow_large_48"
        app:tint="@color/vk_white"
        style="@style/VoipHeaderButton"/>
    <View
        android:id="@+id/btn_header_join_room"
        android:background="@drawable/bg_gray_750_corner24"
        android:layout_width="61dp"
        android:layout_height="68dp"
        android:alpha="0.56"
        app:layout_constraintEnd_toStartOf="@+id/btn_header_menu"
        app:layout_constraintStart_toEndOf="@+id/btn_header_request_attention"
        app:layout_constraintTop_toBottomOf="@+id/header_buttons_top"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_header_join_room_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/voip_session_room_join_content_description"
        app:layout_constraintBottom_toTopOf="@+id/btn_header_join_room_title"
        app:layout_constraintEnd_toEndOf="@+id/btn_header_join_room"
        app:layout_constraintStart_toStartOf="@+id/btn_header_join_room"
        app:layout_constraintTop_toTopOf="@+id/btn_header_join_room"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/vk_icon_user_square_on_square_outline_32"
        app:tint="@color/vk_white"/>
    <TextView
        android:id="@+id/btn_header_join_room_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/voip_session_room_join_title"
        app:layout_constraintBottom_toBottomOf="@+id/btn_header_join_room"
        app:layout_constraintEnd_toEndOf="@+id/btn_header_join_room"
        app:layout_constraintStart_toStartOf="@+id/btn_header_join_room"
        app:layout_constraintTop_toBottomOf="@+id/btn_header_join_room_icon"
        style="@style/VkLegacyTypography.Caption2.Regular"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_header_menu"
        android:src="@drawable/vk_icon_menu_outline_shadow_large_48"
        android:contentDescription="@string/voip_accessibility_more_options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_header_join_room"
        app:layout_constraintTop_toBottomOf="@+id/header_buttons_top"
        style="@style/VoipHeaderButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
