<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/video_wrap"
        android:background="@drawable/vk_bg_skeleton_0dp"
        android:layout_width="0dp"
        android:layout_height="174dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@+id/video_wrap"
        app:layout_constraintTop_toBottomOf="@+id/video_wrap"
        app:placeholderImage="?attr/vk_ui_image_placeholder"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toBottomOf="@+id/video_wrap"
        style="@style/VkUiTypography.SubheadMedium"/>
    <com.vk.libvideo.design.view.info.VideoInfoTextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="24dp"
        android:lines="2"
        android:lineSpacingExtra="3sp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        app:isCustomEllipsizeEnabled="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_bias="0"
        style="@style/VkUiTypography.Caption1"/>
    <ImageView
        android:id="@+id/menu"
        android:background="@drawable/highlight_circle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="10dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/common_actions"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toEndOf="@+id/video_wrap"
        app:layout_constraintTop_toBottomOf="@+id/video_wrap"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/bottom_info_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="avatar,title,subtitle,menu"/>
</androidx.constraintlayout.widget.ConstraintLayout>
