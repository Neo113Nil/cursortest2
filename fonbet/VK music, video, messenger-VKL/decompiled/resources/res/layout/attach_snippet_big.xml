<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/snippet_big_container"
    android:paddingTop="8dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.tool.view.SimpleRatioFrameLayout
        android:id="@+id/attachment_snippet_image_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foregroundGravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:orientation="horizontal"
        app:ratio="2.2375">
        <com.vk.core.view.fresco.FrescoImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/snippet_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.vk.core.tool.view.SimpleRatioFrameLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/attach_snippet_remove_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_deprecated_ic_close_attach_36"
        android:contentDescription="@string/delete"
        app:layout_constraintEnd_toEndOf="@+id/attachment_snippet_image_container"
        app:layout_constraintTop_toTopOf="@+id/attachment_snippet_image_container"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/snippet_toggle_fave"
        android:background="@drawable/highlight_circle_white"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/fave_start_button"
        android:scaleType="center"
        android:contentDescription="@string/fave_accessibility_add_to_favorite"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/attach_snippet_remove_button"
        app:layout_constraintTop_toTopOf="@+id/attachment_snippet_image_container"/>
    <View
        android:id="@+id/background_info"
        android:background="@drawable/attach_fb_bottom_8dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="-12dp"
        app:layout_constraintBottom_toBottomOf="@+id/attach_url_wrapper"
        app:layout_constraintEnd_toEndOf="@+id/attachment_snippet_image_container"
        app:layout_constraintStart_toStartOf="@+id/attachment_snippet_image_container"
        app:layout_constraintTop_toBottomOf="@+id/attachment_snippet_image_container"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/attach_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        android:fontFamily="@string/font_family_medium"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="@+id/barrier"
        app:layout_constraintStart_toStartOf="@+id/attachment_snippet_image_container"
        app:layout_constraintTop_toBottomOf="@+id/attachment_snippet_image_container"/>
    <LinearLayout
        android:id="@+id/attach_subtitle_wrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="@+id/attachment_snippet_image_container"
        app:layout_constraintTop_toBottomOf="@+id/attach_title">
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:id="@+id/attach_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="@font/vk_roboto_regular"/>
        <com.vk.core.view.RatingView
            android:id="@+id/attach_rating"
            android:layout_width="88dp"
            android:layout_height="19dp"
            android:paddingStart="7dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/vk_legacy_text_primary"
            android:ellipsize="end"
            android:id="@+id/attach_review_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:paddingStart="7dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/attach_url_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/attachment_snippet_image_container"
        app:layout_constraintTop_toBottomOf="@+id/attach_subtitle_wrap">
        <ImageView
            android:id="@+id/iv_amp"
            style="@style/AmpSmallIconStyle"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/vk_legacy_text_subhead"
            android:ellipsize="end"
            android:id="@+id/attach_subsubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="ads_button"/>
    <com.vk.core.view.AdsButton
        android:gravity="center"
        android:id="@+id/ads_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/attachment_snippet_image_container"
        app:layout_constraintTop_toBottomOf="@+id/attachment_snippet_image_container"
        style="@style/outline_button"/>
    <FrameLayout
        android:id="@+id/containerShine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:backgroundTint="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="@+id/ads_button"
        app:layout_constraintEnd_toEndOf="@+id/ads_button"
        app:layout_constraintStart_toStartOf="@+id/ads_button"
        app:layout_constraintTop_toTopOf="@+id/ads_button">
        <View
            android:id="@+id/shine_anim"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/dynamic_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/attachment_snippet_image_container"
        app:layout_constraintStart_toStartOf="@+id/attachment_snippet_image_container"
        app:layout_constraintTop_toBottomOf="@+id/attachment_snippet_image_container"/>
    <View
        android:id="@+id/attachment_snippet_foreground_clickable"
        android:background="@drawable/highlight_radius_8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/info"
        app:layout_constraintEnd_toEndOf="@+id/attachment_snippet_image_container"
        app:layout_constraintStart_toStartOf="@+id/attachment_snippet_image_container"
        app:layout_constraintTop_toTopOf="@+id/attachment_snippet_image_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
