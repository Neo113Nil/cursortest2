<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            app:layout_scrollFlags="noScroll"
            app:title="@string/vkim_settings_appearance"
            style="@style/VkIm.Toolbar.Style.LargeWithBack"/>
    </com.google.android.material.appbar.AppBarLayout>
    <ScrollView
        android:background="?attr/im_background_secondary_additional"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/settings_content"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settings_accent_color_selection_block"
                android:background="@drawable/bg_rounded_corners_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:text="@string/vkim_settings_appearance_accent_color"
                    style="@style/SettingsHeaderSection"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/settings_accent_color_selector"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_corners_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/vkim_chats_theme_header"
                    android:text="@string/vkim_settings_appearance_chat_title"
                    style="@style/SettingsHeaderSection"/>
                <com.vk.im.ui.views.settings.LabelSettingsView
                    android:id="@+id/vkim_chats_theme_item"
                    app:vkim_titleText="@string/vkim_settings_appearance_chat_theme"
                    style="@style/VkIm.Settings.Label.Normal"/>
                <com.vk.im.ui.views.settings.SwitchSettingsView
                    android:id="@+id/vkim_chats_theme_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:vkim_titleText="@string/vkim_settings_appearance_chat_theme_switch"
                    style="@style/VkIm.Settings.Label.Normal"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/vkim_chats_theme_switch_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/vkim_settings_appearance_chat_theme_switch_hint"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    style="@style/VkUiTypography.Footnote"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settings_chats_list_block"
                android:background="@drawable/bg_rounded_corners_20"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:text="@string/vkim_settings_appearance_chats_list"
                    style="@style/SettingsHeaderSection"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp">
                    <include layout="@layout/im_settings_appearance_2_lines"/>
                    <include layout="@layout/im_settings_appearance_3_lines"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settings_icon_chooser_block"
                android:background="@drawable/bg_rounded_corners_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/settings_icon_chooser_header"
                    android:text="@string/vkim_settings_appearance_icon_title"
                    style="@style/SettingsHeaderSection"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/settings_icon_chooser"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/settings_icon_shortcut_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="@string/launcher_icon_change_warning"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    style="@style/VkUiTypography.Footnote"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_corners_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:text="@string/vkim_settings_appearance_theme_title"
                    style="@style/SettingsHeaderSection"/>
                <com.vk.common.view.settings.RadioSettingsViewGroup
                    android:orientation="vertical"
                    android:id="@+id/change_theme_btn_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.vk.im.ui.views.settings.CheckableLabelSettingsView
                        android:id="@+id/auto_theme_btn"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:vkim_checkIconTint="?attr/vk_ui_text_accent"
                        app:vkim_titleText="@string/sett_appearance_list_item_auto"
                        style="@style/VkIm.Settings.Label.Normal"/>
                    <com.vk.im.ui.views.settings.CheckableLabelSettingsView
                        android:id="@+id/system_theme_btn"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:vkim_checkIconTint="?attr/vk_ui_text_accent"
                        app:vkim_titleText="@string/sett_appearance_list_item_system"
                        style="@style/VkIm.Settings.Label.Normal"/>
                    <com.vk.im.ui.views.settings.CheckableLabelSettingsView
                        android:id="@+id/light_theme_btn"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:vkim_checkIconTint="?attr/vk_ui_text_accent"
                        app:vkim_titleText="@string/sett_appearance_list_item_light"
                        style="@style/VkIm.Settings.Label.Normal"/>
                    <com.vk.im.ui.views.settings.CheckableLabelSettingsView
                        android:id="@+id/dark_theme_btn"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:vkim_checkIconTint="?attr/vk_ui_text_accent"
                        app:vkim_titleText="@string/sett_appearance_list_item_dark"
                        style="@style/VkIm.Settings.Label.Normal"/>
                </com.vk.common.view.settings.RadioSettingsViewGroup>
                <com.vk.im.ui.views.settings.SwitchSettingsView
                    android:id="@+id/time_table_switch"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:vkim_titleText="@string/sett_appearance_list_item_timetable"
                    style="@style/VkIm.Settings.Label.Normal"/>
                <com.vk.im.ui.views.settings.LabelSettingsView
                    android:id="@+id/time_table_item"
                    android:visibility="gone"
                    app:vkim_titleText="@string/sett_appearance_list_item_timetable_settings"
                    style="@style/VkIm.Settings.Label.Normal"/>
                <com.vk.im.ui.views.span.SpanPressableTextView
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:id="@+id/hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/SettingsHint"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
