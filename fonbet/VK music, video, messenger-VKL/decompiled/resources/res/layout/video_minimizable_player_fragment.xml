<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/minimizableMotionLayoutContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/statusBarShadow"
        android:background="@color/vk_gray_1000"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:translationZ="-1dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/navigationBarShadow"
        android:background="@color/vk_gray_1000"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:translationZ="-1dp"/>
    <com.vk.video.ui.discovery.minimizable.growth.VideoGrowthButtons
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/videoGrowthButtons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:translationZ="1dp"/>
    <com.vk.video.ui.discovery.minimizable.adfree.VideoAdFreeButton
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/videoAdFreeButton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:translationZ="1dp"/>
    <include
        android:visibility="gone"
        layout="@layout/video_fullscreen_lock_overlay"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/advert_banner_container"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="1dp"/>
    <FrameLayout
        android:layout_gravity="start|bottom"
        android:id="@+id/overlay_banner_container"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginBottom="32dp"
        android:elevation="1dp"/>
</FrameLayout>
