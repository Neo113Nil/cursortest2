<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/base_check_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/check_password_navigation_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:srcCompat="@drawable/vk_icon_cancel_outline_28"
            app:tint="?attr/vk_ui_accent_blue"/>
        <com.vk.auth.ui.VkAuthTextView
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_auth_sms_code"
            android:singleLine="true"
            android:layout_marginHorizontal="16dp"
            style="@style/VkUiTypography.DisplayTitle1"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/first_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="left"
        android:layout_gravity="center_horizontal"
        android:id="@+id/first_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vk_auth_enter_sms_code"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toTopOf="@+id/code_container"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        style="@style/VkUiTypography.Headline2Normal"/>
    <FrameLayout
        android:id="@+id/code_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/error_subtitle"
        app:layout_constraintTop_toBottomOf="@+id/first_subtitle">
        <com.vk.auth.verification.base.ui.VkCheckEditText
            android:id="@+id/new_code_edit_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.auth.ui.VkAuthExtendedEditText
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minWidth="168dp"
            android:hint="@string/vk_auth_input_code"
            android:maxLength="10"
            android:inputType="number"
            android:importantForAutofill="no"
            app:vk_error_stated_edit_text_id="@+id/code_edit_text"
            style="@style/VkAuth.EditText.Stated.WithError"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteNormal"
        android:textColor="?attr/vk_ui_text_negative"
        android:gravity="center"
        android:id="@+id/error_subtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/vk_auth_code_incorrect"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/info_buttons_top_barrier"
        app:layout_constraintEnd_toEndOf="@+id/code_container"
        app:layout_constraintStart_toStartOf="@+id/code_container"
        app:layout_constraintTop_toBottomOf="@+id/code_container"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/info_buttons_top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:barrierDirection="top"
        app:constraint_referenced_ids="info_text,retry_button"
        app:layout_constraintTop_toBottomOf="@+id/error_subtitle"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="left"
        android:id="@+id/info_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="24dp"
        app:layout_constraintBottom_toTopOf="@+id/info_buttons_bottom_barrier"
        app:layout_constraintTop_toBottomOf="@+id/info_buttons_top_barrier"
        style="@style/VkUiTypography.SubheadNormal"/>
    <com.vk.auth.ui.VkAuthTextView
        android:textColor="?attr/vk_ui_text_accent"
        android:gravity="center_horizontal"
        android:id="@+id/retry_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vk_auth_not_receive_code"
        android:layout_marginVertical="24dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/info_buttons_bottom_barrier"
        app:layout_constraintTop_toBottomOf="@+id/info_buttons_top_barrier"
        style="@style/VkUiTypography.HeadlineMedium"/>
    <com.vk.auth.ui.VkAuthTextView
        android:gravity="center_horizontal"
        android:id="@+id/login_by_password"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="9dp"
        app:layout_constraintBottom_toTopOf="@+id/info_buttons_bottom_barrier"
        app:layout_constraintTop_toBottomOf="@+id/info_buttons_top_barrier"
        style="@style/VkAuth.Button.Landing.Tertiary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/info_buttons_bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="info_text,retry_button"
        app:layout_constraintBottom_toTopOf="@+id/continue_btn"
        app:layout_constraintTop_toBottomOf="@+id/info_buttons_top_barrier"/>
    <com.vk.auth.ui.VkLoadingButton
        android:id="@+id/continue_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="68dp"
        android:layout_marginBottom="12dp"
        android:text="@string/vk_auth_continue"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_buttons_top_barrier"
        style="@style/VkAuth.Button.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
