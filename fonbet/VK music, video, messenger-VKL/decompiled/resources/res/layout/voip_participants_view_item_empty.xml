<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/vkim_msg_search_empty"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/vk_icon_deprecated_placeholder_not_found_56"
        android:scaleType="centerInside"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vkim_msg_search_empty"
        android:lineSpacingExtra="4dp"
        android:importantForAccessibility="no"
        android:fontFamily="@string/font_family_regular"/>
</LinearLayout>
