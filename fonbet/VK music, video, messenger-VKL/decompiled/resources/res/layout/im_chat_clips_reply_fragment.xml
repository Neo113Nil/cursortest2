<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/im_chat_clips_reply"
    android:background="?attr/vk_ui_overlay_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/im_chat_clips_closeable_area"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/im_chat_clips_bottom_panel_container"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/im_chat_clips_msg_sent_container"
        android:visibility="gone"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:layout_centerInParent="true">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/vk_icon_done_outline_32"
            android:tint="?attr/vk_ui_icon_contrast"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_contrast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/im_chat_clips_reply_msg_sent"/>
    </LinearLayout>
    <com.vk.im.chat.clips.decoration.impl.presentation.bottom.view.linkedtext.LinkedMessageView
        android:id="@+id/im_chat_clips_linked_msg_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="16dp"
        android:layout_above="@+id/im_chat_clips_bottom_panel_container"
        android:layout_marginHorizontal="12dp"/>
    <FrameLayout
        android:id="@+id/im_chat_clips_bottom_sheet_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/im_chat_clips_bottom_panel_container"
        android:layout_alignParentTop="true"/>
    <FrameLayout
        android:id="@+id/im_chat_clips_bottom_panel_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:importantForAccessibility="no">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/im_chat_clips_write_area"
            android:background="?attr/vk_ui_background"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <View
        android:id="@+id/im_chat_clips_keyboard_background"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
