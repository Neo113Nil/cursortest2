<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/sound_captcha_layout"
    android:background="@drawable/vk_bg_card_elevation_8_cropped_full"
    android:padding="@dimen/vk_sak_captcha_fragment_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:background="@drawable/vk_sak_sound_captcha_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:minHeight="120dp"
        android:layout_marginHorizontal="@dimen/vk_sak_captcha_image_horizontal_padding">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/sound_captcha_player"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include layout="@layout/vk_sak_sound_captcha_wave_left"/>
            <include layout="@layout/vk_sak_sound_captcha_wave_left"/>
            <ImageView
                android:id="@+id/sound_captcha_play_button"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/vk_sound_captcha_play_content_description"
                android:layout_marginHorizontal="5dp"
                app:srcCompat="@drawable/vk_icon_play_circle_40"
                app:tint="?attr/vk_ui_background_accent_themed"/>
            <include layout="@layout/vk_sak_sound_captcha_wave_right"/>
            <include layout="@layout/vk_sak_sound_captcha_wave_right"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/sound_captcha_retry"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vk_sound_captcha_loading_error"
                style="@style/VkUiTypography.Footnote"/>
            <TextView
                android:textColor="?attr/vk_ui_text_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vk_captcha_try_again"
                style="@style/VkUiTypography.Footnote"/>
        </LinearLayout>
        <include
            android:id="@+id/sound_captcha_progress_bar"
            android:visibility="visible"
            layout="@layout/vk_sak_captcha_progress_bar"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp">
        <Button
            android:textAppearance="@style/VkUiTypography.Headline2"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/sound_captcha_refresh"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/vk_captcha_refresh"
            android:drawablePadding="6dp"
            android:contentDescription="@string/vk_sound_captcha_refresh_content_description"
            android:paddingHorizontal="8dp"
            app:drawableStartCompat="@drawable/vk_icon_refresh_outline_24"
            app:drawableTint="?attr/vk_ui_icon_secondary"
            style="@style/VKID.View.Button.Tertiary"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/switch_to_text_captcha"
            android:background="@drawable/vkui_bg_button_tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/vk_sound_captcha_deactivate_content_description"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            app:srcCompat="@drawable/vk_icon_text_outline_24"
            app:tint="?attr/vk_ui_icon_secondary"/>
    </LinearLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/sound_captcha_hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/vk_sound_captcha_additional_hint"
        android:layout_marginHorizontal="16dp"
        style="@style/VkUiTypography.Subhead"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16sp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/sound_captcha_code"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:hint="@string/vk_sound_captcha_input_hint"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="flagNoExtractUi|actionSend"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:importantForAutofill="no"
        style="@style/VkAuth.EditText.Stated"/>
    <com.vk.auth.ui.VkLoadingButton
        android:textSize="16sp"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:id="@+id/sound_captcha_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:text="@string/vk_auth_continue"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:vk_lb_text_appearance="@style/VkUiTypography.Headline1"
        style="@style/VkAuth.Button.Primary"/>
</LinearLayout>
