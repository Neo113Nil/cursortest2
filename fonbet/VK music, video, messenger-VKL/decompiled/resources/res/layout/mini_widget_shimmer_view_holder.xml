<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="96dp"
    android:layout_height="80dp"
    android:layout_margin="6dp"
    android:contentDescription="@string/vk_mini_widget_shimmer_content_description">
    <View
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/background_view"
        android:background="@drawable/vk_mini_widget_bg_16dp"
        android:layout_width="92dp"
        android:layout_height="60dp"
        android:layout_marginTop="1dp"
        android:elevation="1dp"
        android:backgroundTint="?attr/vk_ui_background_tertiary"/>
    <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/shimmer_layout"
        android:layout_width="92dp"
        android:layout_height="78dp"
        android:layout_marginTop="1dp"
        android:elevation="1dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/shimmer_container"
            android:layout_width="92dp"
            android:layout_height="60dp">
            <View
                android:id="@+id/icon_stub"
                android:background="@drawable/vk_superapp_content_tint_circle_46"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginBottom="22dp"
                android:layout_marginStart="54dp"
                android:backgroundTint="?attr/vk_ui_track_background"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/text1_stub"
                android:background="@drawable/vk_superapp_content_tint_radius_6"
                android:layout_width="36dp"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="12dp"
                android:backgroundTint="?attr/vk_ui_skeleton_to"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/text2_stub"
                android:background="@drawable/vk_superapp_content_tint_radius_6"
                android:layout_width="26dp"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="12dp"
                android:backgroundTint="?attr/vk_ui_skeleton_to"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text1_stub"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/text4_stub"
            android:background="@drawable/vk_superapp_content_tint_radius_4"
            android:layout_width="36dp"
            android:layout_height="10dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="?attr/vk_ui_track_background"/>
    </com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
</FrameLayout>
