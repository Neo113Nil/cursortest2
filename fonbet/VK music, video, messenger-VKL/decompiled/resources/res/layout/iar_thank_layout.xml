<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/backgroundPrimary"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:filterTouchesWhenObscured="true"
    android:paddingHorizontal="16dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/textPrimary"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/thank_you_title"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/iar_thank_you"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/thumbnail_frame"
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/iar_thank_you"
        android:importantForAccessibility="no"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/accent"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/iar_action_close"
        android:maxLines="1"
        android:textAllCaps="false"
        android:layout_marginEnd="8dp"
        app:cornerRadius="50dp"
        app:rippleColor="@color/accent"
        app:strokeColor="#d6d4d5"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
</LinearLayout>
