<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.RatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_wrap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:orientation="horizontal"
    app:ratio="0.5625">
    <com.vk.libvideo.design.view.videotexture.VideoTextureView
        android:layout_gravity="center"
        android:id="@+id/video_display"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/video_inline_live_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.fresco.FrescoImageView
        android:layout_gravity="center"
        android:id="@+id/video_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"/>
    <View
        android:layout_gravity="end|bottom"
        android:id="@+id/video_sound_control"
        android:background="@drawable/ic_sound_off_shadow_48"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/video_accessibility_sound_on"/>
    <ProgressBar
        android:layout_gravity="bottom"
        android:id="@+id/video_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/progress_video_feed"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/video_snippet_overlay"
        android:background="@color/vk_black_alpha60"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/video_play"
        android:visibility="invisible"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_attachment_video_play"
        android:contentDescription="@null"/>
    <com.vk.core.ui.CircularProgressView
        android:layout_gravity="center"
        android:id="@+id/video_snippet_progress_view"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cpv_animAutostart="true"
        app:cpv_animSwoopDuration="0"
        app:cpv_color="@color/vk_white"
        app:cpv_indeterminate="true"
        app:cpv_thickness="2.5dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/post_side_padding"
        android:layout_marginEnd="@dimen/post_side_padding">
        <com.vk.libvideo.design.view.play.PlayButton
            android:id="@+id/video_replay"
            android:background="@drawable/video_snippet_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="center"
            app:srcCompat="@drawable/vk_icon_replay_24"
            app:tint="@color/vk_white"/>
        <FrameLayout
            android:id="@+id/video_snippet_action_button"
            android:background="@drawable/video_snippet_button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="64dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                app:srcCompat="@drawable/vk_icon_link_24"
                app:tint="@color/vk_white"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp">
                <TextView
                    android:textAppearance="@style/VkUiTypography.Headline2"
                    android:textColor="@color/vk_white"
                    android:ellipsize="end"
                    android:id="@+id/video_snippet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Footnote"
                    android:textColor="@color/vk_white"
                    android:ellipsize="end"
                    android:id="@+id/video_snippet_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    <com.vk.libvideo.design.view.error.VideoErrorView
        android:layout_gravity="center"
        android:id="@+id/video_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.libvideo.design.view.ad.VideoAdLayout
        android:id="@+id/video_instream_ad"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/video_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:vov_size="medium"/>
</com.vk.core.tool.view.RatioFrameLayout>
