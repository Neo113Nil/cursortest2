<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.view.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skeleton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="12dp"
        android:layout_marginVertical="2dp">
        <com.vk.im.ui.views.avatars.ImAvatarView
            android:id="@+id/header_icon1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/header_title1"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="112dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_icon1"
            app:layout_constraintStart_toEndOf="@+id/header_icon1"
            app:layout_constraintTop_toTopOf="@+id/header_icon1"/>
        <View
            android:id="@+id/header_subtitle1"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="54dp"
            android:layout_height="20dp"
            android:alpha="0.64"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/header_title1"
            app:layout_constraintTop_toTopOf="@+id/header_title1"/>
        <com.vk.im.ui.views.avatars.ImAvatarView
            android:id="@+id/header_icon2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_icon1"/>
        <View
            android:id="@+id/header_title2"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="87dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_icon2"
            app:layout_constraintStart_toEndOf="@+id/header_icon2"
            app:layout_constraintTop_toTopOf="@+id/header_icon2"/>
        <View
            android:id="@+id/header_subtitle2"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="73dp"
            android:layout_height="20dp"
            android:alpha="0.64"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/header_title2"
            app:layout_constraintTop_toTopOf="@+id/header_title2"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/skeleton_row_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="header_icon2,header_title2,header_subtitle2"/>
        <com.vk.im.ui.views.avatars.ImAvatarView
            android:id="@+id/header_icon3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_icon2"/>
        <View
            android:id="@+id/header_title3"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="125dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_icon3"
            app:layout_constraintStart_toEndOf="@+id/header_icon3"
            app:layout_constraintTop_toTopOf="@+id/header_icon3"/>
        <View
            android:id="@+id/header_subtitle3"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="83dp"
            android:layout_height="20dp"
            android:alpha="0.64"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/header_title3"
            app:layout_constraintTop_toTopOf="@+id/header_title3"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/skeleton_row_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="header_icon3,header_title3,header_subtitle3"/>
        <com.vk.im.ui.views.avatars.ImAvatarView
            android:id="@+id/header_icon4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_icon3"/>
        <View
            android:id="@+id/header_title4"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="80dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_icon4"
            app:layout_constraintStart_toEndOf="@+id/header_icon4"
            app:layout_constraintTop_toTopOf="@+id/header_icon4"/>
        <View
            android:id="@+id/header_subtitle4"
            android:background="@drawable/vk_bg_skeleton_4dp"
            android:layout_width="43dp"
            android:layout_height="20dp"
            android:alpha="0.64"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/header_title4"
            app:layout_constraintTop_toTopOf="@+id/header_title4"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/skeleton_row_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="header_icon4,header_title4,header_subtitle4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.vk.core.view.shimmer.ShimmerFrameLayout>
