<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.auth.ui.VkAuthTextView
        android:textAppearance="@style/VKID.Text.Button.Primary"
        android:layout_gravity="center"
        android:id="@+id/vk_loading_btn_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"/>
    <com.pnikosis.materialishprogress.ProgressWheel
        android:layout_gravity="center"
        android:id="@+id/vk_loading_btn_progress"
        android:visibility="invisible"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:matProg_barColor="?attr/vk_ui_text_contrast_themed"
        app:matProg_barWidth="2dp"
        app:matProg_progressIndeterminate="true"/>
</merge>
