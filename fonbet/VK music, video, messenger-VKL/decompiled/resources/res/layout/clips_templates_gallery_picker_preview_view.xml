<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="68dp">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_images_preview"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:paddingStart="16dp"
        android:paddingEnd="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/clips_template_picker_recycler_right_shadow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/clips_template_picker_recycler_left_shadow"
        android:background="@drawable/clips_templates_gallery_picker_recycler_left_shadow_background"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="48dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/clips_template_picker_recycler_right_shadow"
        android:background="@drawable/clips_templates_gallery_picker_action_shadow_background"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="48dp"
        android:layout_height="68dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/action"
        android:background="@drawable/story_gallery_action_background"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:foreground="@drawable/vk_ripple_circle_highlight"
        android:src="@drawable/vk_icon_chevron_compact_right_24"
        android:scaleType="centerInside"
        android:contentDescription="@string/story_accessibility_add_attachments"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
