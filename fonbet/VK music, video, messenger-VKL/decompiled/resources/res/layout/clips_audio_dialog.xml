<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.button.tool.VkToolButton
        android:id="@+id/clips_audio_dialog_button_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/clips_audio_dialog_button_margin"
        android:contentDescription="@string/clips_audio_dialog_accessibility_close"
        android:layout_marginStart="@dimen/clips_audio_dialog_button_margin"
        app:icon="@drawable/vk_icon_cancel_outline_28"
        app:iconSize="@dimen/clips_audio_dialog_button_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:toolButtonAppearance="accent"
        app:toolButtonMode="tertiary"/>
    <com.vk.core.view.components.button.tool.VkToolButton
        android:id="@+id/clips_audio_dialog_button_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/clips_audio_dialog_button_margin"
        android:contentDescription="@string/clips_audio_dialog_accessibility_done"
        android:layout_marginEnd="@dimen/clips_audio_dialog_button_margin"
        app:icon="@drawable/vk_icon_done_outline_28"
        app:iconSize="@dimen/clips_audio_dialog_button_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:toolButtonAppearance="accent"
        app:toolButtonMode="tertiary"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/clips_audio_dialog_timeline_range"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="@+id/clips_audio_dialog_button_done"
        app:layout_constraintEnd_toEndOf="@+id/clips_audio_dialog_button_done"
        app:layout_constraintStart_toStartOf="@+id/clips_audio_dialog_button_close"
        app:layout_constraintTop_toTopOf="@+id/clips_audio_dialog_button_done"
        style="@style/VkUiTypography.Subhead"/>
    <View
        android:id="@+id/separator"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/clips_audio_dialog_button_done"/>
    <com.vk.stories.design.view.editor.SelectRangeWaveFormView
        android:layout_gravity="bottom"
        android:id="@+id/clips_audio_dialog_range_waveform"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clips_audio_dialog_music_range_selector_height"
        android:layout_marginBottom="@dimen/clips_audio_dialog_waveform_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/separator"/>
    <one.video.view.OneVideoPlayerView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/clips_audio_dialog_video_view"
        android:background="@drawable/track_title_gradient"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/clips_audio_dialog_preview_top_margin"
        android:layout_marginBottom="@dimen/clips_audio_dialog_preview_bottom_margin"
        android:layout_marginHorizontal="@dimen/clips_audio_dialog_preview_width_margin"
        app:layout_constraintBottom_toTopOf="@+id/clips_audio_dialog_range_waveform"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/clips_audio_dialog_track_play"
        android:background="@drawable/bg_clip_play"
        android:padding="@dimen/clips_audio_dialog_play_btn_padding"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/clips_audio_dialog_accessibility_play"
        app:layout_constraintBottom_toBottomOf="@+id/clips_audio_dialog_video_view"
        app:layout_constraintEnd_toEndOf="@+id/clips_audio_dialog_video_view"
        app:layout_constraintStart_toStartOf="@+id/clips_audio_dialog_video_view"
        app:layout_constraintTop_toTopOf="@+id/clips_audio_dialog_video_view"
        app:srcCompat="@drawable/vk_icon_play_24"
        app:tint="?attr/vk_ui_icon_primary"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/clips_audio_dialog_track_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clips_audio_dialog_title_margin_top"
        android:singleLine="true"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="@+id/clips_audio_dialog_video_view"
        app:layout_constraintStart_toStartOf="@+id/clips_audio_dialog_video_view"
        app:layout_constraintTop_toTopOf="@+id/clips_audio_dialog_video_view"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/clips_audio_dialog_track_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clips_audio_dialog_subtitle_margin_top"
        android:singleLine="true"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="@+id/clips_audio_dialog_video_view"
        app:layout_constraintStart_toStartOf="@+id/clips_audio_dialog_video_view"
        app:layout_constraintTop_toBottomOf="@+id/clips_audio_dialog_track_title"
        style="@style/VkUiTypography.Caption1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
