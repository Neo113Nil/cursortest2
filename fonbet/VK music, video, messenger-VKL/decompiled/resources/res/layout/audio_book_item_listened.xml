<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/music_selectable_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/audio_image"
        android:layout_width="@dimen/music_podcast_image"
        android:layout_height="@dimen/music_podcast_image"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/music_image_corners_6"
        app:tiv_background_image="?attr/vk_ui_image_placeholder"
        app:tiv_border_width="0.5dp"
        app:tiv_empty_resource="@drawable/vk_icon_podcast_outline_28"
        app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
    <ImageView
        android:id="@+id/audio_playing_indicator"
        android:background="@drawable/music_dark_round_rect_6dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_image"
        app:layout_constraintEnd_toEndOf="@+id/audio_image"
        app:layout_constraintStart_toStartOf="@+id/audio_image"
        app:layout_constraintTop_toTopOf="@+id/audio_image"/>
    <TextView
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/audio_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:drawablePadding="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/audio_duration"
        app:layout_constraintEnd_toStartOf="@+id/image_explicit"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/audio_image"
        app:layout_constraintTop_toTopOf="@+id/audio_image"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.Headline1Normal"/>
    <ImageView
        android:id="@+id/image_explicit"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/music_talkback_explicit"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_title"
        app:layout_constraintEnd_toStartOf="@+id/image_button_play"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/audio_title"
        app:layout_goneMarginStart="0dp"
        app:srcCompat="@drawable/vk_icon_explicit_12"
        app:tint="?attr/vk_ui_icon_tertiary"/>
    <TextView
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/audio_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_image"
        app:layout_constraintEnd_toStartOf="@+id/image_button_play"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/audio_title"
        app:layout_constraintTop_toBottomOf="@+id/audio_title"
        style="@style/VkUiTypography.Footnote"/>
    <ImageView
        android:id="@+id/image_button_play"
        android:padding="6dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="center"
        android:contentDescription="@string/music_button_play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/audio_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bg_circle_pause"/>
    <ImageView
        android:id="@+id/audio_menu"
        android:padding="6dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/vk_icon_more_vertical_16"
        android:scaleType="center"
        android:contentDescription="@string/music_talkback_more"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
