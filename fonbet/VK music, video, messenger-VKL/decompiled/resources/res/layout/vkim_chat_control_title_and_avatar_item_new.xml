<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/vk_ui_spacing_size4_xl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.VkImAvatar
        android:id="@+id/avatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/vkim_accessibility_avatar_chat"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/vkim_chat_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_xl"
        android:text="@string/vkim_chat_profile__hat_settings_title_header_res_0x7f1342c8"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/vk_ui_spacing_size2_xl"
        app:layout_constraintBottom_toTopOf="@+id/vkim_chat_title_edittext"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.SubheadNormal"/>
    <com.vk.core.view.components.formitem.VkInputSelectEditText
        android:textColor="?attr/vk_ui_text_primary"
        android:textColorHint="?attr/vk_ui_text_secondary"
        android:id="@+id/vkim_chat_title_edittext"
        android:background="@drawable/bg_settings_edittext_normal"
        android:padding="12dp"
        android:fadingEdgeLength="6dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vk_ui_spacing_size2_xl"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
        android:layout_marginRight="@dimen/vk_ui_spacing_size2_xl"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size_m"
        android:hint="@string/vkim_chat_profile__hat_settings_title_hint_res_0x7f1342c9"
        android:maxLength="120"
        android:inputType="textCapSentences"
        android:imeOptions="actionDone"
        android:requiresFadingEdge="horizontal"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vkim_chat_name"
        style="@style/VkUiTypography.TextNormal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
