<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/docs_padding"
    android:paddingRight="@dimen/docs_padding"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:foreground="?attr/selectableItemBackground">
    <TextView
        android:textAppearance="@style/VkUiTypography.TextMedium"
        android:textColor="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/holder_document_type_text"
        android:background="@drawable/docs_thumb_bg"
        android:padding="5dp"
        android:layout_width="@dimen/document_preview_width"
        android:layout_height="@dimen/document_preview_height"
        android:layout_marginTop="@dimen/newsfeed_newpost_space"
        android:layout_marginBottom="@dimen/newsfeed_newpost_space"
        android:singleLine="true"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/holder_document_preview_image"
        android:layout_width="@dimen/document_preview_width"
        android:layout_height="@dimen/document_preview_height"
        android:layout_marginTop="@dimen/newsfeed_newpost_space"
        android:layout_marginBottom="@dimen/newsfeed_newpost_space"
        app:actualImageScaleType="centerCrop"
        app:roundedCornerRadius="2dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.HeadlineNormal.Unscaled"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="marquee"
        android:layout_gravity="bottom"
        android:id="@+id/holder_document_title_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:singleLine="true"
        android:layout_marginStart="76dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="marquee"
        android:id="@+id/holder_document_info_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:singleLine="true"
        android:layout_marginStart="76dp"/>
</FrameLayout>
