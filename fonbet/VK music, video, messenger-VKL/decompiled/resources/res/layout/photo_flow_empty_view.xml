<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/photo_flow_empty_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="2dp"
        android:src="@drawable/vk_icon_illustration_photos_64h"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/photo_flow_empty_text_self"
        style="@style/PhotosRoot.EmptyText"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/tv_add_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/photo_flow_header_button_add"
        app:drawableLeftCompat="@drawable/vk_icon_picture_outline_24"
        app:drawableTint="?attr/vk_ui_icon_accent_themed"
        style="@style/PhotosRoot.EmptyButton"/>
</LinearLayout>
