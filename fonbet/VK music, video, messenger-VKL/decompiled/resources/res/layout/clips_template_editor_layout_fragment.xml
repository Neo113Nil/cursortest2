<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clips_template_editor_root_view"
    android:background="@color/vk_black"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/clips_template_editor_fragments_bottom_container"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginBottom="22dp"
        app:layout_constraintBottom_toTopOf="@+id/clips_template_editor_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.vk.clips.design.view.templates.ClipsTemplateEditorFragmentsBottomView
            android:layout_gravity="center"
            android:id="@+id/clips_template_editor_fragments_bottom_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.clips.design.view.templates.ClipsTemplateEditorCropperView
            android:layout_gravity="center"
            android:id="@+id/clips_template_editor_fragments_cropper_bottom_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/templates_editor_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <com.vk.clips.design.view.stikers.ClipsStickersView
            android:id="@+id/clips_template_stickers_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/templates_video_overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="48dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/clips_template_editor_info_text_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <View
        android:id="@+id/clips_template_editor_video_view_cropper_shadow"
        android:background="@drawable/clips_template_editor_cropper_video_view_shadow"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/templates_video_overlay_view"
        app:layout_constraintEnd_toEndOf="@+id/templates_video_overlay_view"
        app:layout_constraintStart_toStartOf="@+id/templates_video_overlay_view"
        app:layout_constraintTop_toTopOf="@+id/templates_video_overlay_view"/>
    <com.vk.clips.design.view.editor.TransformOverlayView
        android:id="@+id/templates_video_transform_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/clips_template_editor_video_view_debug"
        android:background="@color/picker_blue"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/templates_video_overlay_view"
        app:layout_constraintEnd_toEndOf="@+id/templates_video_overlay_view"
        app:layout_constraintStart_toStartOf="@+id/templates_video_overlay_view"
        app:layout_constraintTop_toTopOf="@+id/templates_video_overlay_view"/>
    <View
        android:id="@+id/clips_template_editor_video_view_stroke"
        android:background="@drawable/clips_template_editor_cropper_video_view_stroke"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/templates_video_overlay_view"
        app:layout_constraintEnd_toEndOf="@+id/templates_video_overlay_view"
        app:layout_constraintStart_toStartOf="@+id/templates_video_overlay_view"
        app:layout_constraintTop_toTopOf="@+id/templates_video_overlay_view"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/clips_template_editor_play_view"
        android:background="@drawable/bg_clip_play"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/video_accessibility_play"
        app:layout_constraintBottom_toBottomOf="@+id/templates_video_overlay_view"
        app:layout_constraintEnd_toEndOf="@+id/templates_video_overlay_view"
        app:layout_constraintStart_toStartOf="@+id/templates_video_overlay_view"
        app:layout_constraintTop_toTopOf="@+id/templates_video_overlay_view"
        app:srcCompat="@drawable/vk_icon_play_24"
        app:tint="?attr/vk_ui_icon_primary"/>
    <FrameLayout
        android:id="@+id/clips_template_editor_ripple_view"
        android:background="@drawable/white_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/templates_video_overlay_view"
        app:layout_constraintEnd_toEndOf="@+id/templates_video_overlay_view"
        app:layout_constraintStart_toStartOf="@+id/templates_video_overlay_view"
        app:layout_constraintTop_toTopOf="@+id/templates_video_overlay_view"/>
    <FrameLayout
        android:id="@+id/clips_template_editor_info_text_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/clips_template_editor_fragments_bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.5">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/clips_template_editor_info_text"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clips_template_editor_under_video_text"
            android:lines="3"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            app:layout_constraintBottom_toTopOf="@+id/clips_template_editor_fragments_bottom_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/templates_video_overlay_view"
            style="@style/VkUiTypography.Footnote"/>
    </FrameLayout>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/clips_template_editor_cropper_change_item"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="10dp"
        android:text="@string/clips_template_editor_cropper_change_item_text"
        android:layout_marginStart="10dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_arrow_2_squarepath_outline_24"
        app:layout_constraintBottom_toBottomOf="@+id/templates_video_overlay_view"
        app:layout_constraintStart_toStartOf="@+id/templates_video_overlay_view"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/clips_template_editor_cropper_delete_item"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/clips_template_editor_cropper_delete_item_accessibility"
        android:layout_marginEnd="10dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:icon="@drawable/vk_icon_delete_outline_24"
        app:layout_constraintBottom_toBottomOf="@+id/templates_video_overlay_view"
        app:layout_constraintEnd_toEndOf="@+id/templates_video_overlay_view"/>
    <FrameLayout
        android:id="@+id/clips_template_editor_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="start|bottom"
            android:id="@+id/clips_template_editor_cancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/clips_template_editor_v2_cancel_button"
            android:layout_marginStart="@dimen/clips_template_editor_default_offset"
            app:buttonAppearance="overlay"
            app:buttonMode="tertiary"
            app:buttonSizeType="medium"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="end|bottom"
            android:id="@+id/clips_template_editor_next"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/clips_template_editor_v2_done_button"
            android:layout_marginEnd="@dimen/clips_template_editor_default_offset"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="end|bottom"
            android:id="@+id/clips_template_editor_cropper_done"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/clips_template_editor_apply_cropper_button"
            android:layout_marginEnd="@dimen/clips_template_editor_default_offset"
            app:buttonAppearance="accent"
            app:buttonMode="secondary"
            app:buttonSizeType="medium"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
