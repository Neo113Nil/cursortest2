<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/music_selectable_bg"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.imageloader.view.VKOverlayImageView
            android:id="@+id/playlist_image"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:emptyImagePlaceholder="@drawable/playlist_update_cover_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:overlayDrawable="@drawable/playlist_update_overlay"
            app:roundedCornerRadius="@dimen/music_playlist_update_corner_radius"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/playlist_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/playlist_image"
            app:layout_constraintEnd_toEndOf="@+id/playlist_image"
            app:layout_constraintStart_toStartOf="@+id/playlist_image"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/playlist_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/playlist_description"
            app:layout_constraintEnd_toEndOf="@+id/playlist_image"
            app:layout_constraintStart_toStartOf="@+id/playlist_image"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.DisplayTitle2"
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/playlist_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/playlist_subtitle"
            app:layout_constraintEnd_toEndOf="@+id/playlist_image"
            app:layout_constraintStart_toStartOf="@+id/playlist_image"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
