<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/editorBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/tabs"
        android:paddingTop="@dimen/paddingXS"
        android:paddingBottom="@dimen/paddingXXS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:id="@+id/tabGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_collage_tab_grid"
            style="?attr/editorTabButtonStyle"/>
        <Button
            android:id="@+id/tabFormat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_collage_tab_format"
            style="?attr/editorTabButtonStyle"/>
        <Button
            android:id="@+id/tabBorder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_collage_tab_border"
            style="?attr/editorTabButtonStyle"/>
    </LinearLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabs"/>
    <com.vk.photo.editor.views.ToolBottomView
        android:gravity="center"
        android:id="@+id/tool_bottom_view"
        android:paddingBottom="@dimen/paddingXS"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/paddingXXS"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/controls"
        app:toolName="@string/editor_collage_bottom_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
