<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:tint="?attr/vk_ui_icon_accent"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/photo"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:maxLines="3"
        android:lineSpacingExtra="0sp"
        style="@style/VkUiTypography.Title1"/>
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2sp"
        style="@style/VkUiTypography.SubheadNormal"/>
</LinearLayout>
