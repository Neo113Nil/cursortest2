<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vk_highlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/clip_repost_clip_owner_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/clip_repost_clip_owner_verified"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.SubheadMedium"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/clip_repost_clip_owner_verified"
        android:visibility="visible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/vk_icon_verified_16"
        app:layout_constraintBottom_toBottomOf="@+id/clip_repost_clip_owner_name"
        app:layout_constraintEnd_toEndOf="@+id/clip_repost_clip_label"
        app:layout_constraintStart_toEndOf="@+id/clip_repost_clip_owner_name"
        app:layout_constraintTop_toTopOf="@+id/clip_repost_clip_owner_name"
        app:tint="@color/vk_white"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white_alpha60"
        android:id="@+id/clip_repost_clip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clip"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/clip_repost_clip_owner_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/clip_repost_clip_owner_verified"
        app:layout_constraintTop_toTopOf="@+id/clip_repost_clip_owner_name"
        style="@style/VkUiTypography.Subhead"/>
</merge>
