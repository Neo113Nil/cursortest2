<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Vk.Theme.VkApp.space_gray_generated"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/gradient"
        android:background="@drawable/gradient_content_tint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/video_owner_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.Subhead1.Primary"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/video_owner_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:fontFamily="@font/vk_sans_text_demibold"
        android:textAlignment="textStart"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/video_description"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.Subhead.Regular"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/video_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="textStart"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/video_views"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.Subhead.Regular"
        android:textColor="?attr/vk_legacy_header_text_secondary"
        android:id="@+id/video_views"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:textAlignment="textStart"
        android:layout_marginStart="8dp"
        app:drawableTint="?attr/vk_legacy_header_text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.Subhead.Regular"
        android:textColor="?attr/vk_legacy_header_text_secondary"
        android:id="@+id/video_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subtitle_separator"
        android:maxLines="1"
        android:textAlignment="textStart"
        app:layout_constraintBottom_toBottomOf="@+id/video_views"
        app:layout_constraintStart_toEndOf="@+id/video_views"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VkLegacyTypography.Subhead.Regular"
        android:textColor="?attr/vk_legacy_header_text_secondary"
        android:ellipsize="end"
        android:id="@+id/video_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="textStart"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/video_views"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/video_separator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
