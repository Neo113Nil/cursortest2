<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fade_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/gradient_overlay"
            android:background="@drawable/bg_my_target_survey_fade"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:background="@drawable/bg_my_target_survey_fade_button_bg"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <com.vk.core.view.components.button.VkButton
                android:layout_gravity="bottom"
                android:id="@+id/open_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:buttonAppearance="neutral"
                app:buttonMode="secondary"
                app:buttonSizeType="medium"/>
        </FrameLayout>
    </LinearLayout>
</merge>
