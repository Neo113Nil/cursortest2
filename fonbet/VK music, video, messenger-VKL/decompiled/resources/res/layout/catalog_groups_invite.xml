<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="76dp"
        android:layout_marginEnd="76dp">
        <TextView
            android:textColor="?attr/vk_legacy_text_primary"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            style="@style/VkLegacyTypography.Title2"/>
        <TextView
            android:textColor="?attr/vk_legacy_text_secondary"
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif"
            style="@style/VkLegacyTypography.Caption1"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/button_layout"
                android:layout_width="match_parent"
                android:layout_height="30dp">
                <TextView
                    android:textColor="@color/vk_primary_button_text"
                    android:gravity="center"
                    android:id="@+id/positive_button"
                    android:background="@drawable/vkui_bg_button_primary"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="@string/community_join"
                    android:layout_weight="1"
                    android:fontFamily="@font/vk_roboto_medium"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/vkui_secondary_button_text"
                    android:gravity="center"
                    android:id="@+id/negative_button"
                    android:background="@drawable/vkui_bg_button_secondary"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="@string/community_decline_invite"
                    android:layout_weight="1"
                    android:fontFamily="@font/vk_roboto_medium"
                    android:layout_marginStart="4dp"
                    style="@style/VkLegacyButton.Secondary"/>
            </LinearLayout>
            <com.vk.core.view.links.LinkedTextView
                android:textColor="?attr/vk_legacy_text_secondary"
                android:layout_gravity="center_vertical"
                android:id="@+id/post_status"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                style="@style/VkLegacyTypography.Caption1"/>
        </FrameLayout>
    </LinearLayout>
    <com.vk.imageloader.view.VKCircleImageView
        android:layout_gravity="end"
        android:id="@+id/invited_photo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        app:placeholderImage="@drawable/user_placeholder"/>
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/group_photo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="16dp"
        app:placeholderImage="@drawable/user_placeholder"/>
</FrameLayout>
