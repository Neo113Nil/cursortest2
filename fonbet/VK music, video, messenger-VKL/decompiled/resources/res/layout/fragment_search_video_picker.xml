<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="?attr/vk_ui_header_background"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/accessibility_toolbar_back"
        app:navigationIcon="@drawable/vk_icon_arrow_left_outline_28"
        app:popupTheme="?attr/actionBarPopupTheme"
        app:theme="?attr/actionBarTheme"
        app:title="@string/article_picker_title"
        style="?attr/actionBarTheme">
        <com.vkontakte.android.ui.FullWidthLinearLayout
            android:theme="?attr/actionBarTheme"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingRight="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.core.view.components.formitem.VkInputSelect
                android:textAppearance="@style/VkUiTypography.Headline1"
                android:textColorHint="?attr/vk_ui_icon_medium"
                android:id="@+id/search_input"
                android:background="@null"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/search"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="?attr/searchViewCursorDrawable"/>
            <ImageView
                android:id="@+id/search_clear"
                android:background="?attr/actionBarItemBackground"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="center"
                android:contentDescription="@string/accessibility_clear_input"
                app:srcCompat="@drawable/vk_icon_cancel_24"
                app:tint="?attr/vk_ui_icon_secondary"/>
        </com.vkontakte.android.ui.FullWidthLinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <me.grishka.appkit.views.UsableRecyclerPaginatedView
        android:id="@+id/rpb_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
