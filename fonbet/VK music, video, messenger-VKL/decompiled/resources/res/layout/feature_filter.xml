<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/layout_filter_bottom_panel"
        android:background="?attr/editorBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/layout_filter_enhance"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:id="@+id/text_filter_enhance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minEms="2"
                android:importantForAccessibility="no"
                android:textAlignment="center"
                style="?attr/editorTextCaption1Style"/>
            <com.vk.photo.editor.views.DashedSeekBar
                android:id="@+id/seekbar_filter_enhance"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:contentDescription="@string/editor_filter_seekbar_intensity"
                android:importantForAccessibility="yes"
                style="?attr/editorDashedSeekbarStyle"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_filters"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <com.vk.photo.editor.views.ToolBottomView
            android:id="@+id/tool_bottom_view"
            android:paddingBottom="@dimen/paddingXS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:toolName="@string/editor_filter_bottom_name"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
