<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainContainer"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vk_sticky_banner_size_medium">
    <FrameLayout
        android:id="@+id/ads_image_container"
        android:layout_width="@dimen/vk_sticky_banner_size_medium"
        android:layout_height="@dimen/vk_sticky_banner_size_medium"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.my.target.nativeads.views.MediaAdView
            android:id="@+id/nativeads_media_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.my.target.nativeads.views.IconAdView
            android:id="@+id/nativeads_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <View
        android:id="@+id/nativeads_icon_separator"
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="0.5dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ads_image_container"
        app:layout_constraintEnd_toEndOf="@+id/ads_image_container"
        app:layout_constraintTop_toTopOf="@+id/ads_image_container"/>
    <View
        android:id="@+id/separatorTop"
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/nativeads_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toStartOf="@+id/nativeads_call_to_action"
        app:layout_constraintStart_toEndOf="@+id/ads_image_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        style="@style/VkUiTypography.SubheadMedium.Unscaled"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/nativeads_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toStartOf="@+id/nativeads_call_to_action"
        app:layout_constraintStart_toEndOf="@+id/ads_image_container"
        app:layout_constraintTop_toBottomOf="@+id/nativeads_title"
        app:layout_constraintVertical_bias="0"
        style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/nativeads_banner_attributes_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="noHideDescendants"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/nativeads_call_to_action"
        app:layout_constraintStart_toEndOf="@+id/ads_image_container"
        app:layout_constraintTop_toBottomOf="@+id/nativeads_description"
        app:layout_constraintVertical_bias="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/banner_vk_ads_logo"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="5dp"
            app:srcCompat="@drawable/vk_icon_logo_vk_ads_16"
            app:tint="?attr/vk_ui_icon_tertiary"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/nativeads_advertising_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/nativeads_age_restrictions"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/nativeads_advertising_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="5dp"
            style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:ellipsize="end"
            android:id="@+id/nativeads_domain"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/nativeads_rating_icon"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            app:srcCompat="@drawable/vk_icon_favorite_12"
            app:tint="?attr/vk_ui_accent_orange"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/vk_ui_text_tertiary"
            android:id="@+id/nativeads_rating"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/VkUiTypography.Caption1Normal.Unscaled"/>
    </LinearLayout>
    <View
        android:id="@+id/nativeads_banner_attributes_fade_out_gradient"
        android:background="@drawable/vk_sticky_banner_fade_out_gradient_solid_end"
        android:layout_width="18dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/nativeads_banner_attributes_container"
        app:layout_constraintEnd_toEndOf="@+id/nativeads_banner_attributes_container"
        app:layout_constraintTop_toTopOf="@+id/nativeads_banner_attributes_container"/>
    <com.my.target.nativeads.views.NativeAdChoicesView
        android:id="@+id/nativeads_ad_choices"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/nativeads_ad_choices_icon"
        app:layout_constraintEnd_toEndOf="@+id/nativeads_ad_choices_icon"
        app:layout_constraintStart_toStartOf="@+id/nativeads_ad_choices_icon"
        app:layout_constraintTop_toTopOf="@+id/nativeads_ad_choices_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/nativeads_ad_choices_icon"
        android:background="@drawable/vkui_ripple_circle_highlight"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/vk_accessibility_actions"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/nativeads_call_to_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:srcCompat="@drawable/vk_icon_more_horizontal_16"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/nativeads_call_to_action"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:minWidth="40dp"
        android:layout_marginEnd="8dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:icon="@drawable/vk_icon_arrow_right_outline_16"
        app:iconSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nativeads_ad_choices_icon"/>
    <FrameLayout
        android:id="@+id/nativeads_ad_options"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/separatorBottom"
        android:background="?attr/vk_ui_image_border_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
