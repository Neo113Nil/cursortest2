<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_modern_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:id="@+id/app_picker_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_app"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="18dp"
        style="@style/VkUiTypography.Title2Medium"/>
    <androidx.recyclerview.widget.RecyclerView
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/app_picker_dialog_recycler_view"
        android:paddingBottom="16dp"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"/>
</merge>
