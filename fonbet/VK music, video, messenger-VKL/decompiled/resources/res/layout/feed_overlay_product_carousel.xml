<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/feed_carousel_products_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/feed_carousel_product_sound_control"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.feed.design.view.newsfeed.overlay.VkOverlayCircleButton
        android:id="@+id/feed_carousel_product_market_control"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/feed_carousel_product_sound_control"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.feed.design.view.newsfeed.overlay.VkOverlayCircleButton
        android:id="@+id/feed_carousel_product_sound_control"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</merge>
