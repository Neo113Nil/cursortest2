<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="4dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight"
    android:paddingEnd="16dp">
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/avatar"
        android:layout_width="@dimen/catalog_search_entity_flat_item_size"
        android:layout_height="@dimen/catalog_search_entity_flat_item_size"
        android:layout_marginStart="10dp"
        app:avatarImageSize="@dimen/catalog_search_entity_flat_icon_size"
        app:borderStrokeWidth="3dp"
        app:contourOverlayEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/entity_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:gradientColor="?attr/vk_ui_background_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/verify"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.DisplayTitle3SemiBold"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/verify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/entity_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/entity_title"
        app:layout_constraintTop_toTopOf="@+id/entity_title"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/follow_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/entity_title"
        app:layout_constraintTop_toBottomOf="@+id/entity_title"
        style="@style/VkUiTypography.Caption1"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/play_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_entity_answer_play_music"
        android:drawableLeft="@drawable/vk_icon_play_16"
        android:drawablePadding="6dp"
        android:layout_marginEnd="8dp"
        android:stateListAnimator="@null"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/follow_button"
        app:layout_constraintEnd_toStartOf="@+id/follow_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/entity_title"
        app:layout_constraintTop_toTopOf="@+id/follow_button"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/follow_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="40dp"
        android:drawablePadding="@dimen/catalog_search_entity_subscribe_button_icon_padding"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:icon="@drawable/vk_icon_add_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/play_button"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
