<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/vk_ui_base_padding_horizontal"
    android:paddingVertical="@dimen/vk_ui_spacing_size_xs">
    <com.vk.core.view.components.picture.VkPicture
        android:id="@+id/feed_link_primary_cell_picture"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/feed_link_primary_cell_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_m"
        app:layout_constraintBottom_toTopOf="@+id/feed_link_primary_cell_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/feed_link_primary_cell_right"
        app:layout_constraintStart_toEndOf="@+id/feed_link_primary_cell_picture"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/VkUiTypography.ParagraphMedium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/feed_link_primary_cell_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/feed_link_primary_cell_right"
        app:layout_constraintStart_toEndOf="@+id/feed_link_primary_cell_picture"
        app:layout_constraintTop_toBottomOf="@+id/feed_link_primary_cell_title"
        style="@style/VkUiTypography.Caption1"/>
    <FrameLayout
        android:id="@+id/feed_link_primary_cell_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
