<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_join_call_camera_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <ViewFlipper
        android:id="@+id/join_call_camera_card_view_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/voip_join_call_camera_off_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/vk_icon_videocam_slash_outline_28"
                app:tint="?attr/vk_ui_icon_secondary"/>
            <TextView
                android:textColor="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/voip_join_call_enable_your_camera_message"
                style="@style/VkLegacyTypography.Headline.Regular.NoEllipsize"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/voip_join_call_preview_render_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </ViewFlipper>
    <ImageView
        android:id="@+id/voip_join_call_camera_btn"
        android:background="@drawable/bg_dark_button_secondary"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/vk_icon_videocam_slash_alt_28"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="13dp"
        android:paddingVertical="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voip_join_call_microphone_btn"
        app:tint="?attr/vk_ui_text_contrast"/>
    <ImageView
        android:id="@+id/voip_join_call_microphone_btn"
        android:background="@drawable/bg_dark_button_secondary"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/vk_icon_microphone_slash_24"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="13dp"
        android:paddingVertical="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="?attr/vk_ui_text_contrast"/>
    <include
        android:id="@+id/voip_join_call_join_as_btn"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voip_join_call_camera_btn"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/voip_join_as_dark_button_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
