<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/attach_appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.vk.core.ui.refresh.BottomSwipePaginatedView
        android:id="@+id/rpb_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/separatorTop"
        style="@style/AppBarShadow"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/jump_to_end"
        android:background="@drawable/comments_scroll_to_bottom"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/comments_ripple_scroll_to_bottom"
        android:minHeight="56dp"
        android:contentDescription="@string/accessibility_scroll_to_bottom_comments"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_behavior="com.vk.newsfeed.impl.replybar.ReplyBarGravityBehavior"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_navigation_shadow"
        android:background="@drawable/picker_bg_attach_bottom_toolbar_shadow"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_behavior="com.vk.newsfeed.impl.replybar.ReplyBarGravityBehavior"/>
    <FrameLayout
        android:id="@+id/empty_view"
        android:background="?attr/vk_ui_background_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp">
        <include layout="@layout/view_empty_state"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottom_sheet_container"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.vk.newsfeed.impl.replybar.ReplyBarGravityBehavior"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
