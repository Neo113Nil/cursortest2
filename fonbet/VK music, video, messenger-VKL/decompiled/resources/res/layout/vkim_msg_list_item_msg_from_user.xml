<?xml version="1.0" encoding="utf-8"?>
<com.vk.im.ui.views.msg.bubble.BubbleFluidLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fhl"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:vk_order="normal">
    <com.vk.im.ui.views.avatars.ImAvatarView
        android:layout_gravity="bottom"
        android:id="@+id/avatar"
        android:layout_width="@dimen/vkim_chat_message_avatar_container_size"
        android:layout_height="@dimen/vkim_chat_message_avatar_container_size"
        style="@style/VkIm.AvatarView"/>
    <Space
        android:layout_gravity="top"
        android:id="@+id/avatar_space"
        android:layout_width="30dp"
        android:layout_height="0dp"/>
    <com.vk.im.ui.views.msg.bubble.MsgBubbleView
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:vk_layout_isFluid="true"
        app:vkim_contentFitAllWidth="false"
        app:vkim_contentPaddingBottom="0dp"
        app:vkim_contentPaddingLeft="0dp"
        app:vkim_contentPaddingRight="0dp"
        app:vkim_contentPaddingTop="0dp"
        app:vkim_fwdNestLevel="0"
        app:vkim_fwdNestLineColor="?attr/vk_ui_vkontakte_color_im_forward_line_alpha"
        app:vkim_fwdNestLineSpace="@dimen/nested_line_space"
        app:vkim_fwdNestLineWidth="@dimen/nested_line_width"
        app:vkim_fwdPaddingBottom="0dp"
        app:vkim_fwdPaddingLeft="0dp"
        app:vkim_fwdPaddingRight="0dp"
        app:vkim_fwdPaddingTop="0dp"/>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/bomb_viewstub"
        android:layout="@layout/vkim_msg_list_item_msg_from_user_bomb_stub_layout"
        android:layout_width="wrap_content"
        android:layout_height="30dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/vkim_incoming_share_container"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        app:vk_layout_isHideable="true">
        <ImageView
            android:id="@+id/vkim_incoming_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ripple_16dp"
            android:contentDescription="@string/vkim_accessibility_share_msg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"/>
    </FrameLayout>
    <Space
        android:layout_gravity="bottom"
        android:id="@+id/status_space"
        android:layout_width="42dp"
        android:layout_height="0dp"
        app:vk_layout_isHideable="true"/>
</com.vk.im.ui.views.msg.bubble.BubbleFluidLayout>
