<?xml version="1.0" encoding="utf-8"?>
<com.vk.im.ui.views.msg.bubble.BubbleFluidLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fhl"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:vk_order="normal">
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:layout_gravity="bottom"
        android:id="@+id/avatar"
        android:layout_width="@dimen/vkim_chat_message_avatar_container_size"
        android:layout_height="@dimen/vkim_chat_message_avatar_container_size"/>
    <com.vk.core.view.components.skeleton.VkSkeleton
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:vk_layout_isFluid="true"/>
    <Space
        android:layout_gravity="bottom"
        android:id="@+id/status_space"
        android:layout_width="42dp"
        android:layout_height="0dp"
        app:vk_layout_isHideable="true"/>
</com.vk.im.ui.views.msg.bubble.BubbleFluidLayout>
