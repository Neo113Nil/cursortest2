<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end|center_vertical"
    android:id="@+id/comment_author_liked"
    android:visibility="gone"
    android:layout_width="21dp"
    android:layout_height="16dp"
    android:contentDescription="@string/accessibility_comment_author_liked"
    android:layout_marginStart="12dp"
    app:layout_constraintBottom_toBottomOf="@+id/comment_reply"
    app:layout_constraintStart_toEndOf="@+id/comment_reply"
    app:layout_constraintTop_toTopOf="@+id/comment_reply">
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="start|top"
        android:id="@+id/comment_author_liked_photo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        app:placeholderImage="@drawable/user_placeholder"
        app:roundAsCircle="true"
        app:roundingBorderColor="?attr/vk_ui_separator_primary_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/comment_author_liked_cutout"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginBottom="1dp"
        android:src="@drawable/vk_icon_like_with_stroke_14"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_background_content"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/comment_author_liked_icon"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/vk_icon_like_16"
        android:importantForAccessibility="no"
        android:layout_marginEnd="1dp"
        app:tint="?attr/vk_ui_text_negative"/>
</FrameLayout>
