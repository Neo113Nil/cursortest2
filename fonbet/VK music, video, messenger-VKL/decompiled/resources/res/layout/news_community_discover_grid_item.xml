<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/news_community_grid_item_container"
    android:background="?attr/vk_ui_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/news_community_discover_grid_item_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"/>
    <View
        android:id="@+id/news_community_discover_grid_item_fade"
        android:background="?attr/vk_ui_overlay_primary"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:ellipsize="end"
        android:id="@+id/news_community_discover_grid_item_title"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toTopOf="@+id/news_community_discover_grid_item_subtitle"
        style="@style/VkUiTypography.FootnoteMedium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/news_community_discover_grid_item_subtitle"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:alpha="0.5"
        android:paddingHorizontal="6dp"
        android:lineHeight="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/VkUiTypography.Caption1"/>
    <ImageView
        android:id="@+id/news_community_discover_grid_item_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scaleType="center"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
