<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:foreground="@drawable/rounded_list_selector">
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/clips_hashtag_trending_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/vk_icon_flash_16"
        android:layout_marginEnd="24dp"
        app:tint="?attr/vk_ui_icon_primary"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_clips_hashtag"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        style="@style/VkUiTypography.Paragraph"/>
</FrameLayout>
