<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_show_all"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp">
    <TextView
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="@dimen/post_side_padding"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/endButtonsBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="12dp"
        style="@style/VkUiTypography.DisplayTitle4SemiBold"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="5dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="@dimen/post_side_padding"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/endButtonsBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="?attr/vk_ui_typography_footnote_normal"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/endButtonsBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="badge, show_all_btn_icon"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/badge"
        android:background="@drawable/catalog_header_badge_prominent"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="6dp"
        android:paddingEnd="2dp"
        android:layout_marginEnd="@dimen/post_side_padding"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_min="20dp"
        style="@style/VkUiTypography.Caption1"/>
    <ImageView
        android:id="@+id/show_all_btn_icon"
        android:layout_width="16dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/post_side_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_chevron_compact_right_24"
        app:tint="?attr/vk_ui_text_accent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
