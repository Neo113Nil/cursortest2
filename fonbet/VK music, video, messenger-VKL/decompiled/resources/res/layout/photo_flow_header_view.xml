<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/photo_flow_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/tv_add_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/photo_flow_header_button_add"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:drawableLeftCompat="@drawable/vk_icon_picture_outline_24"
        app:drawableTint="?attr/vk_ui_icon_accent_themed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PhotosRoot.PageHeaderTextButtonStyle"/>
    <ImageView
        android:id="@+id/iv_archive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/photo_flow_header_button_archive"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_settings"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_archive_outline_24"
        app:tint="?attr/vk_ui_icon_secondary"
        style="@style/PhotosRoot.PageHeaderButtonStyle"/>
    <ImageView
        android:id="@+id/iv_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/photo_flow_header_button_settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_gear_outline_24"
        app:tint="?attr/vk_ui_icon_secondary"
        style="@style/PhotosRoot.PageHeaderButtonStyle"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:id="@+id/tv_multiselect_exit"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/photo_flow_header_button_multiselect_exit"
        android:lineSpacingExtra="2sp"
        android:translationY="-1.21sp"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        app:drawableTint="?attr/vk_ui_icon_accent_themed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PhotosRoot.PageHeaderTextButtonStyle"/>
    <ImageView
        android:id="@+id/iv_multiselect_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/photo_flow_header_button_multiselect_options"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_24"
        app:tint="?attr/vk_ui_icon_accent_themed"
        style="@style/PhotosRoot.PageHeaderButtonStyle"/>
</merge>
