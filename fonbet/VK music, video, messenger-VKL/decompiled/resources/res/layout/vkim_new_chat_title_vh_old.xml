<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="4dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.vk.im.ui.views.avatars.AvatarView
        android:id="@+id/vkim_avatar"
        android:layout_width="@dimen/vkim_new_chat_title_avatar"
        android:layout_height="@dimen/vkim_new_chat_title_avatar"
        android:contentDescription="@string/vkim_accessibility_avatar_chat"
        style="@style/VkIm.AvatarView"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textColorHint="?attr/vk_ui_text_secondary"
        android:id="@+id/vkim_title"
        android:padding="12dp"
        android:fadingEdgeLength="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/vkim_chat_settings_title_hint"
        android:lines="1"
        android:maxLength="100"
        android:inputType="textCapSentences"
        android:imeOptions="actionDone"
        android:layout_marginStart="80dp"
        style="@style/VkIm.Settings.EditText.Large"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_subhead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/vkim_chat_title_hint"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="12dp"/>
</FrameLayout>
