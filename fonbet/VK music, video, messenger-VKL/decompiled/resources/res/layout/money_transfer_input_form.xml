<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="252dp">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:minHeight="44dp">
        <com.vk.core.view.PhotoStripView
            android:layout_gravity="center_vertical"
            android:id="@+id/psv_mt_to"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"/>
        <com.vk.money.ui.avatar.MoneyAvatarView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_mt_to"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:placeholderImage="@drawable/group_placeholder"
            app:placeholderImageScaleType="fitXY"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/vk_legacy_text_muted"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_mt_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:maxLines="1"/>
    </LinearLayout>
    <View
        android:background="?attr/vk_legacy_separator_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_unlimited"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:src="@drawable/ic_infinity_58"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_mt_sum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="48dp"
            android:textColor="?attr/vk_legacy_text_tertiary"
            android:id="@+id/tv_mt_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"/>
        <com.vk.common.view.EditText
            android:textSize="48dp"
            android:textColor="?attr/vk_legacy_text_muted"
            android:gravity="bottom"
            android:id="@+id/et_mt_sum"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="1dp"
            android:maxLength="6"
            android:inputType="number"
            android:nextFocusForward="@+id/et_mt_comment"
            app:editTextTypeface="Light"/>
        <TextView
            android:textSize="24sp"
            android:textColor="?attr/vk_legacy_text_muted"
            android:id="@+id/currency_sign"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginBottom="1dp"
            android:text="₽"/>
    </LinearLayout>
    <TextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_mt_restriction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="14dp"/>
    <View
        android:background="?attr/vk_legacy_separator_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <EditText
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_muted"
        android:textColorHint="?attr/vk_legacy_text_tertiary"
        android:id="@+id/et_mt_comment"
        android:background="@android:color/transparent"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:hint="@string/money_transfer_your_comment"
        android:maxLength="128"
        android:inputType="textCapSentences"
        android:imeOptions="actionSend"/>
</merge>
