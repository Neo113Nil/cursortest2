<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/post_side_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.feed.design.view.newsfeed.reaction.FeedAnimatedView
            android:layout_gravity="center_horizontal"
            android:id="@+id/lottie"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="4dp"
            style="@style/VkUiTypography.Title2Medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="4dp"
            style="@style/VkUiTypography.Subhead"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="4dp"
            android:singleLine="false"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/hide"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_cancel_24_in_circle_bg_transparent"
        android:contentDescription="@string/accessibility_hide"/>
</FrameLayout>
