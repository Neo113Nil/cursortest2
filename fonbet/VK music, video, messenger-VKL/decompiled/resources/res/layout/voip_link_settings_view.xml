<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="26dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/accessibility_back"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"
        app:srcCompat="@drawable/vk_icon_back_24"
        app:tint="@color/vk_white"/>
    <TextView
        android:textAppearance="@style/ToolbarTitle"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/voip_share_link"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar_bottom_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/toolbar_bottom_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="56dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/link_view_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/share_link_pager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_bottom_guideline">
        <View
            app:layout_constraintTop_toTopOf="parent"
            style="@style/LinkSettingsDivider"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/invite_to_call_by_link_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/voip_invite_to_call_by_link_hint"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/link_text"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/invite_to_call_by_link_hint"/>
        <View
            android:id="@+id/actions_divider"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/link_text"
            style="@style/LinkSettingsDivider"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/voip_system_share_call_link"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/share_link_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/share_link_view"
            app:srcCompat="@drawable/vk_icon_share_outline_28"
            app:tint="@color/vk_sky_300"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center_vertical"
            android:id="@+id/share_link_view"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="@string/voip_system_share_call_link"
            android:paddingStart="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/actions_divider"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/voip_copy_call_link"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/copy_link_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/copy_link_view"
            app:srcCompat="@drawable/vk_icon_copy_outline_28"
            app:tint="@color/vk_sky_300"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center_vertical"
            android:id="@+id/copy_link_view"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="@string/voip_copy_call_link"
            android:paddingStart="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/share_link_view"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/update_link_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/update_link_title"
            app:srcCompat="@drawable/vk_icon_switch_outline_28"
            app:tint="@color/vk_sky_300"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Paragraph"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/update_link_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/voip_update_call_link"
            android:importantForAccessibility="no"
            android:layout_marginStart="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/copy_link_view"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Footnote"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/update_link_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/voip_update_call_link_hint"
            android:importantForAccessibility="no"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/update_link_title"/>
        <Space
            android:id="@+id/update_link_click_area_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/update_link_title"
            app:layout_constraintStart_toStartOf="parent"/>
        <Space
            android:id="@+id/update_link_click_area_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/update_link_description"/>
        <View
            android:id="@+id/update_link_click_area_view"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/update_link_click_area_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/update_link_click_area_top"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.voip.ui.share.link.pager.view.VoipShareLinkPagerView
        android:id="@+id/share_link_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/link_view_container"/>
    <TextView
        android:textColor="?attr/vk_ui_text_tertiary"
        android:id="@+id/share_link_pager_refresh_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voip_scheduled_call_settings_link_refresh_subtitle"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintTop_toBottomOf="@+id/share_link_pager"
        style="@style/VkUiTypography.Subhead"/>
    <View
        android:id="@+id/share_link_pager_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/share_link_pager_refresh_description"/>
    <com.vk.voip.ui.view.VoipActionMultiLineView
        android:id="@+id/is_service_chat_switch_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:minHeight="44dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/share_link_pager_divider"
        app:voip_amlv_subtitle="@string/void_service_chat_setting_subtitle"
        app:voip_amlv_subtitle_max_lines="2"
        app:voip_amlv_title="@string/void_service_chat_setting_title"
        app:voip_amlv_title_max_lines="1"
        style="@style/VoipActionMultiLineView"/>
    <com.vk.voip.ui.view.VoipActionMultiLineView
        android:id="@+id/waiting_room_switch_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="44dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/is_service_chat_switch_view"
        app:voip_amlv_title="@string/voip_waiting_room_title"
        app:voip_amlv_title_max_lines="1"
        style="@style/VoipActionMultiLineView"/>
    <com.vk.voip.ui.view.VoipActionMultiLineView
        android:id="@+id/allow_join_anonymously_switch_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:minHeight="44dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/waiting_room_switch_view"
        app:voip_amlv_title="@string/voip_allow_to_join_anonymously"
        app:voip_amlv_title_max_lines="2"
        style="@style/VoipActionMultiLineView"/>
    <com.vk.voip.ui.view.VoipActionMultiLineView
        android:id="@+id/allow_feedback_switch_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:minHeight="44dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/allow_join_anonymously_switch_view"
        app:voip_amlv_title="@string/voip_call_by_link_setting_feedback_subtitle"
        app:voip_amlv_title_max_lines="1"
        style="@style/VoipActionMultiLineView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
