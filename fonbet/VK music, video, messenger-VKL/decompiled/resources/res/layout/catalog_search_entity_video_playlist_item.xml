<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:paddingBottom="6dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight"
    android:paddingEnd="16dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/avatar"
        android:layout_width="@dimen/catalog_search_entity_video_playlist_item_width"
        android:layout_height="@dimen/catalog_search_entity_video_playlist_item_height"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="6dp"
        app:roundingBorderColor="?attr/vk_legacy_image_border"
        app:roundingBorderWidth="0.5dp"/>
    <TextView
        android:textSize="19sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/vk_sans_display_demibold"
        android:layout_marginStart="12dp"
        app:gradientColor="?attr/vk_ui_background_tertiary"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="14sp"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/follow_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkLegacyTypography.Caption1.Regular"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/play_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_entity_answer_play_music"
        android:drawablePadding="6dp"
        android:layout_marginEnd="8dp"
        android:stateListAnimator="@null"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:elevation="0dp"
        app:icon="@drawable/vk_icon_play_16"
        app:layout_constraintBottom_toBottomOf="@+id/follow_button"
        app:layout_constraintEnd_toStartOf="@+id/follow_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/follow_button"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/follow_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:minWidth="40dp"
        android:drawablePadding="@dimen/catalog_search_entity_subscribe_button_icon_padding"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:icon="@drawable/vk_icon_add_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/play_button"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
