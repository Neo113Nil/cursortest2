<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/bg_fake_news"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="30dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/vk_icon_info_outline_16"
        android:importantForAccessibility="no"
        app:tint="?attr/vk_ui_text_secondary"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption2"
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/fake_news_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vkim_channel_msg_fake_news_label"
        android:layout_marginStart="6dp"/>
</LinearLayout>
