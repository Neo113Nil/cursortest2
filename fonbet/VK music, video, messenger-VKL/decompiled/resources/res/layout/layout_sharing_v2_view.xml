<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/sharing_bottom_sheet"
        android:background="@drawable/background_top_rounded_12"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="?attr/vk_ui_background_content"
        app:layout_behavior="com.google.android.material.bottomsheet.PagerViewBottomSheetBehavior">
        <LinearLayout
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:measureAllChildren="false">
            <FrameLayout
                android:id="@+id/sharing_header_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sharing_header_row_vertical_margin_top">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/sharing_back_button"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:visibility="invisible"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="4dp"
                    android:contentDescription="@string/close"
                    app:srcCompat="@drawable/vk_icon_cancel_outline_28"
                    app:tint="?attr/vk_ui_icon_accent_themed"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Title2"
                    android:textColor="?attr/vk_ui_text_primary"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/sharing_title"
                    android:paddingRight="@dimen/sharing_title_margin_right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sharing_common_margin_left"
                    android:layout_marginRight="@dimen/sharing_title_margin_right"
                    android:text="@string/sharing_title1"
                    android:maxLines="1"
                    android:importantForAccessibility="yes"/>
                <com.vk.avatar.api.VKAvatarView
                    android:layout_gravity="center"
                    android:id="@+id/user_avatar"
                    android:visibility="gone"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginRight="16dp"
                    app:borderWidth="0dp"/>
                <ImageButton
                    android:layout_gravity="center"
                    android:id="@+id/sharing_settings_button"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="4dp"
                    android:scaleType="center"
                    android:contentDescription="@string/menu_settings"
                    app:srcCompat="@drawable/vk_icon_settings_outline_28"
                    app:tint="?attr/vk_ui_icon_accent"
                    style="@style/Widget.AppCompat.ActionButton"/>
            </FrameLayout>
            <com.vk.core.view.components.search.VkSearchView
                android:layout_gravity="center_vertical"
                android:id="@+id/sharing_search_input"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sharing_header_row_vertical_margin_bottom"
                android:hint="@string/sharing_hint_search_by_dialogs"
                style="?attr/im_toolbar_search_style"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sharing_header_row_vertical_margin_top_bottom"
            android:layout_marginBottom="8dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/targets_recycler"
                android:paddingBottom="@dimen/sharing_target_list_bottom_padding"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:id="@+id/targets_recycler_overlay"
                android:paddingBottom="@dimen/sharing_target_list_bottom_padding"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:id="@+id/sharing_header_shadow"
                android:background="@drawable/vk_bg_toolbar_shadow_light"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:alpha="0"/>
            <ViewAnimator
                android:id="@+id/content_animator"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:measureAllChildren="false">
                <android.widget.Space
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="?attr/vk_ui_icon_tertiary"
                    android:indeterminateTintMode="src_in"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Text.Unscaled"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:gravity="center"
                    android:id="@+id/empty_text"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/no_messages"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textAppearance="@style/VkUiTypography.Text.Unscaled"
                        android:textColor="?attr/vk_ui_text_secondary"
                        android:gravity="center"
                        android:id="@+id/error_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/default_network_error"/>
                    <com.vk.core.view.components.button.VkButton
                        android:id="@+id/retry_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/err_try_again"
                        style="@style/VkUiTypography.TextNormal.Unscaled"/>
                </LinearLayout>
            </ViewAnimator>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/bottom_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/bottom_container_separator"
            android:background="?attr/vk_ui_separator_primary_alpha"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <View
            android:id="@+id/sharing_comment_input_common_top_shadow"
            android:background="@drawable/bg_bottom_navigation_shadow"
            android:layout_width="match_parent"
            android:layout_height="6dp"/>
        <FrameLayout
            android:id="@+id/comment_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textColor="?attr/vk_ui_text_primary"
                android:textColorHint="?attr/vk_ui_text_subhead"
                android:id="@+id/sharing_comment_input_common"
                android:background="?attr/vk_ui_background_modal"
                android:paddingLeft="@dimen/sharing_comment_margin_left"
                android:paddingTop="12dp"
                android:paddingRight="52dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="@string/sharing_hint_comment_add_message"
                android:maxLines="4"
                android:singleLine="false"
                android:inputType="textMultiLine"
                android:importantForAutofill="no"
                style="@style/VkUiTypography.TextNormal.Unscaled"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="bottom|left"
                android:id="@+id/sharing_comment_input_common_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginLeft="22dp"
                android:layout_marginBottom="12dp"
                app:srcCompat="@drawable/vk_icon_message_outline_28"
                app:tint="?attr/vk_ui_icon_secondary"/>
            <ImageButton
                android:layout_gravity="bottom|right"
                android:id="@+id/sharing_comment_input_common_clear_button"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginRight="4dp"
                android:contentDescription="@string/clear_input"
                app:srcCompat="@drawable/vk_icon_cancel_24"
                app:tint="?attr/vk_ui_icon_secondary"
                style="@style/Widget.AppCompat.ActionButton"/>
            <ImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/sharing_comment_redesign_send_button"
                android:background="@drawable/highlight_icon"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="center"
                android:contentDescription="@string/sharing_send_button_label"
                app:srcCompat="@drawable/vk_icon_send_28"
                app:tint="?attr/vk_ui_icon_accent"/>
        </FrameLayout>
        <ViewAnimator
            android:id="@+id/sharing_footer_animator"
            android:background="?attr/vk_ui_background_content"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:measureAllChildren="false">
            <include layout="@layout/layout_sharing_footer_actions"/>
            <include layout="@layout/layout_sharing_footer_send_v2"/>
            <include layout="@layout/layout_sharing_footer_disabled_hint"/>
            <include layout="@layout/layout_sharing_footer_send_redesign"/>
        </ViewAnimator>
        <ViewAnimator
            android:id="@+id/sharing_settings_layout"
            android:background="?attr/vk_ui_background_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.common.view.settings.SettingsSwitchView
                    android:id="@+id/sharing_setting_friends_only"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_view_height"
                    app:titleText="@string/newpost_friends_only"/>
                <com.vk.common.view.settings.SettingsSwitchView
                    android:id="@+id/sharing_setting_facebook_export"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_view_height"
                    app:titleText="@string/newpost_export_fb"/>
                <com.vk.common.view.settings.SettingsSwitchView
                    android:id="@+id/sharing_setting_twitter_export"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_view_height"
                    app:titleText="@string/newpost_export_twitter"/>
                <com.vk.common.view.settings.SettingsSwitchView
                    android:id="@+id/sharing_setting_comments"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_view_height"
                    app:titleText="@string/posting_settings_comments_closing"/>
                <com.vk.common.view.settings.SettingsSwitchView
                    android:id="@+id/sharing_setting_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_view_height"
                    app:titleText="@string/posting_settings_disable_notifications"/>
            </LinearLayout>
        </ViewAnimator>
    </LinearLayout>
</merge>
