<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:paddingLeft="32dp"
    android:paddingTop="64dp"
    android:paddingRight="32dp"
    android:paddingBottom="64dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/newsfeed_placeholder_image"
        android:layout_width="180dp"
        android:layout_height="180dp"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_subhead"
        android:gravity="center"
        android:id="@+id/newsfeed_placeholder_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:maxWidth="350dp"
        style="@style/VkUiTypography.Paragraph"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/newsfeed_placeholder_find_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"/>
</merge>
