<?xml version="1.0" encoding="utf-8"?>
<com.vk.common.view.overlay.OverlayConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/photo_tag_preview_width"
    android:layout_height="wrap_content"
    app:overlayDrawable="@drawable/bg_photo_tag_image">
    <com.vk.core.tool.view.AspectRatioFrameLayout
        android:id="@+id/photo_tag_preview_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:as_aspect_ratio="1.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/photo_tag_preview_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/talkback_photo_preview"
            app:actualImageScaleType="fitCenter"
            app:backgroundImage="@color/vk_gray_800"/>
        <com.vk.photos.common.ui.tags.TagsSuggestionsOverlayView
            android:layout_gravity="center"
            android:id="@+id/photo_tag_suggestions_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.vk.core.tool.view.AspectRatioFrameLayout>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/photo_tag_author_image_view"
        android:layout_width="@dimen/photo_tag_preview_author_image_size"
        android:layout_height="@dimen/photo_tag_preview_author_image_size"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/talkback_photo_preview_author"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photo_tag_preview_layout"
        app:roundAsCircle="true"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/photo_tag_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_photo_tagged_male"
        android:singleLine="true"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/photo_tag_author_image_view"
        app:layout_constraintTop_toTopOf="@+id/photo_tag_author_image_view"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/photo_tag_subtitle_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/photo_tag_author_image_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/photo_tag_author_image_view"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/photo_tag_primary_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:text="@string/profile_photo_tag_accept"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/photo_tag_secondary_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photo_tag_author_image_view"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/photo_tag_secondary_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/profile_photo_tag_delete"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="@+id/photo_tag_primary_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/photo_tag_primary_btn"
        app:layout_constraintTop_toTopOf="@+id/photo_tag_primary_btn"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/photo_tag_removed_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/profile_photo_tag_deleted"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photo_tag_preview_layout"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadSemiBold"
        android:textColor="?attr/vk_ui_text_accent"
        android:id="@+id/photo_tag_cancel_removed_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/cancel"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photo_tag_removed_text"/>
    <ImageView
        android:id="@+id/photo_tag_more_btn"
        android:background="@drawable/highlight_circle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photo_tag_preview_layout"
        app:srcCompat="@drawable/vk_icon_more_horizontal_24"
        app:tint="?attr/vk_ui_icon_tertiary"/>
</com.vk.common.view.overlay.OverlayConstraintLayout>
