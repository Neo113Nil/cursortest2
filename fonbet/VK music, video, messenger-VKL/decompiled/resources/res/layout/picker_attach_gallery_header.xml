<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/picker_attach_gallery_camera_layout"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <FrameLayout
        android:id="@+id/picker_attach_gallery_photo_view"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_weight="1"
        android:contentDescription="@string/picker_photo_content_description">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_accent"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/picker_attach_gallery_photo_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/picker_photo"
            android:singleLine="true"
            android:drawablePadding="6dp"
            app:drawableLeftCompat="@drawable/vk_icon_camera_outline_28"
            app:drawableStartCompat="@drawable/vk_icon_camera_outline_28"
            app:drawableTint="?attr/colorAccent"
            style="@style/VkUiTypography.Headline1Normal"/>
    </FrameLayout>
    <View
        android:id="@+id/picker_attach_gallery_separator_view"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>
    <FrameLayout
        android:id="@+id/picker_attach_gallery_video_view"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_weight="1"
        android:contentDescription="@string/picker_video_content_description">
        <com.vk.core.view.components.text.VkText
            android:textColor="?attr/vk_ui_text_accent"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/picker_attach_gallery_video_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/picker_video"
            android:singleLine="true"
            android:drawablePadding="6dp"
            app:drawableLeftCompat="@drawable/vk_icon_videocam_outline_28"
            app:drawableStartCompat="@drawable/vk_icon_videocam_outline_28"
            app:drawableTint="?attr/colorAccent"
            style="@style/VkUiTypography.Headline1Normal"/>
    </FrameLayout>
</LinearLayout>
