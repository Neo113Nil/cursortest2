<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clips_favorites_folders_picker_list_footer_height">
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/clips_favorites_footer_error_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/clips_favorites_folders_picker_list_error"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        style="@style/VkUiTypography.Headline1Normal"/>
    <com.vk.core.view.components.button.VkButton
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/clips_favorites_footer_error_retry"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/clips_favorites_folders_picker_list_error_retry"
        app:buttonAppearance="accent"
        app:buttonMode="tertiary"
        app:buttonSizeType="small"/>
</LinearLayout>
