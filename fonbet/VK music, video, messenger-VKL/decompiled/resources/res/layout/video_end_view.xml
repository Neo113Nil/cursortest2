<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.libvideo.design.view.play.PlayButton
        android:id="@+id/video_end_skip_back"
        android:background="@drawable/highlight_video_play"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_margin="12dp"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_skip_back_36"
        app:tint="@android:color/white"/>
    <com.vk.libvideo.design.view.play.PlayButton
        android:id="@+id/video_end_replay"
        android:background="@drawable/highlight_video_play"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_margin="12dp"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_replay_36"
        app:tint="@android:color/white"/>
    <com.vk.libvideo.design.view.play.PlayButton
        android:id="@+id/video_end_like"
        android:background="@drawable/highlight_video_play"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_margin="12dp"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_like_outline_36"/>
    <com.vk.libvideo.design.view.play.PlayButton
        android:id="@+id/video_end_share"
        android:background="@drawable/highlight_video_play"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_margin="12dp"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_share_outline_28"
        app:tint="@android:color/white"/>
    <com.vk.libvideo.design.view.play.PlayButton
        android:id="@+id/video_end_add"
        android:background="@drawable/highlight_video_play"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_margin="12dp"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_done_36"
        app:tint="@android:color/white"/>
    <com.vk.libvideo.design.view.play.PlayButton
        android:id="@+id/video_end_skip_forward"
        android:background="@drawable/highlight_video_play"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_margin="12dp"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_skip_forward_36"
        app:tint="@android:color/white"/>
</merge>
