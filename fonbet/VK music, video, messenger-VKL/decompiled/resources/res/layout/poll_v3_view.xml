<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/poll_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/poll_modal_title"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/poll_modal_title"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            style="@style/VkUiTypography.DisplayTitle2Medium"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/accessibility_actions"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/poll_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:ellipsize="end"
            android:id="@+id/poll_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="3"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VkUiTypography.Title3Medium"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/poll_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/VkUiTypography.FootnoteNormal"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/poll_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:id="@+id/poll_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/VkUiTypography.FootnoteNormal"/>
            <com.vk.core.view.PhotoStripView
                android:layout_gravity="center_vertical"
                android:id="@+id/photo_strip_view"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/votes_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/VkUiTypography.FootnoteNormal"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="4dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/error_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/poll_no_internet"
            style="@style/VkUiTypography.TextMedium"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/poll_footer_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp">
        <com.vk.core.view.components.button.VkButton
            android:textSize="15sp"
            android:layout_gravity="center"
            android:id="@+id/poll_vote_button"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/multiple_progress"
            android:visibility="invisible"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </FrameLayout>
</LinearLayout>
