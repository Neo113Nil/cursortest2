<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/root"
    android:paddingTop="@dimen/ds_placeholder_vertical_padding"
    android:paddingBottom="@dimen/ds_placeholder_vertical_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/ds_placeholder_horizontal_padding"
    android:paddingEnd="@dimen/ds_placeholder_horizontal_padding">
    <FrameLayout
        android:id="@+id/top_slot_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size3_xl"/>
    <FrameLayout
        android:id="@+id/top"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ds_placeholder_top_min_height">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/top_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.ui.themes.VKReplacerView
            android:layout_gravity="center"
            android:id="@+id/top_picture_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.ui.themes.VKReplacerView
            android:layout_gravity="center"
            android:id="@+id/top_avatar_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.vk.core.ui.themes.VKReplacerView
            android:layout_gravity="center"
            android:id="@+id/top_image_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <View
        android:id="@+id/gap_top_middle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vk_ui_spacing_size_xl"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/ds_placeholder_middle_max_width">
        <TextView
            android:textAppearance="?attr/vk_ui_typography_title2"
            android:textColor="?attr/vk_ui_text_primary"
            android:id="@+id/middle_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"/>
        <View
            android:id="@+id/gap_title_description"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vk_ui_spacing_size_s"/>
        <com.vk.core.view.components.text.links.VkLinkedText
            android:textAppearance="?attr/vk_ui_typography_text"
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/middle_description"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"/>
    </LinearLayout>
    <View
        android:id="@+id/gap_middle_bottom"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vk_ui_spacing_size2_xl"/>
    <FrameLayout
        android:id="@+id/bottom_slot_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vk_ui_spacing_size3_xl"/>
    <com.vk.core.tool.view.GapLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
