<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16dp"
            android:id="@+id/poll_picker_create_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="@string/poll_create_btn_title"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkLegacyButton.Primary"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/poll_picker_image"
            android:background="@drawable/poll_picker_bg"
            android:layout_width="84dp"
            android:layout_height="112dp"
            android:layout_marginTop="36dp"
            android:src="@drawable/bg_poll_bg_thumb"
            android:tint="?attr/vk_legacy_placeholder_icon_foreground_primary"
            app:layout_constraintEnd_toEndOf="@+id/poll_picker_create_btn"
            app:layout_constraintStart_toStartOf="@+id/poll_picker_create_btn"
            app:layout_constraintTop_toBottomOf="@+id/poll_picker_create_btn"/>
        <TextView
            android:textSize="16dp"
            android:textColor="?attr/vk_legacy_text_placeholder"
            android:gravity="center_horizontal"
            android:id="@+id/poll_picker_create_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/poll_picker_description"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="@+id/poll_picker_image"
            app:layout_constraintStart_toStartOf="@+id/poll_picker_image"
            app:layout_constraintTop_toBottomOf="@+id/poll_picker_image"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
