<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/back_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:src="@drawable/vk_icon_arrow_left_outline_28"
        android:contentDescription="@string/voip_close"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/vk_ui_icon_accent_themed"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_participant_settings_access_rights_title"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/back_btn"
        app:layout_constraintStart_toEndOf="@+id/back_btn"
        app:layout_constraintTop_toTopOf="@+id/back_btn"
        style="@style/VkUiTypography.DisplayTitle2"/>
    <View
        android:id="@+id/microphone_container_btn"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/microphone_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_participant_settings_access_microphone"
        app:drawableStartCompat="@drawable/vk_icon_voice_outline_28"
        app:layout_constraintBottom_toBottomOf="@+id/microphone_container_btn"
        app:layout_constraintStart_toStartOf="@+id/microphone_container_btn"
        app:layout_constraintTop_toTopOf="@+id/microphone_container_btn"
        style="@style/VoipParticipantSettingsAccessRight"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/microphone_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/microphone_text"
        app:layout_constraintEnd_toEndOf="@+id/microphone_container_btn"
        app:layout_constraintTop_toTopOf="@+id/microphone_text"/>
    <View
        android:id="@+id/camera_container_btn"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@+id/microphone_container_btn"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/camera_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_participant_settings_access_camera"
        app:drawableStartCompat="@drawable/vk_icon_videocam_outline_28"
        app:layout_constraintBottom_toBottomOf="@+id/camera_container_btn"
        app:layout_constraintStart_toStartOf="@+id/camera_container_btn"
        app:layout_constraintTop_toTopOf="@+id/camera_container_btn"
        style="@style/VoipParticipantSettingsAccessRight"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/camera_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/camera_text"
        app:layout_constraintEnd_toEndOf="@+id/camera_container_btn"
        app:layout_constraintTop_toTopOf="@+id/camera_text"/>
    <View
        android:id="@+id/screen_share_container_btn"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@+id/camera_container_btn"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/screen_share_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_participant_settings_access_screen_share"
        app:drawableStartCompat="@drawable/vk_icon_arrow_up_rectangle_outline_28"
        app:layout_constraintBottom_toBottomOf="@+id/screen_share_container_btn"
        app:layout_constraintStart_toStartOf="@+id/screen_share_container_btn"
        app:layout_constraintTop_toTopOf="@+id/screen_share_container_btn"
        style="@style/VoipParticipantSettingsAccessRight"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/screen_share_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/screen_share_text"
        app:layout_constraintEnd_toEndOf="@+id/screen_share_container_btn"
        app:layout_constraintTop_toTopOf="@+id/screen_share_text"/>
    <View
        android:id="@+id/watch_together_container_btn"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@+id/screen_share_container_btn"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/watch_together_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_participant_settings_access_watch_together"
        app:drawableStartCompat="@drawable/vk_icon_logo_vk_video_outline_28"
        app:layout_constraintBottom_toBottomOf="@+id/watch_together_container_btn"
        app:layout_constraintStart_toStartOf="@+id/watch_together_container_btn"
        app:layout_constraintTop_toTopOf="@+id/watch_together_container_btn"
        style="@style/VoipParticipantSettingsAccessRight"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/watch_together_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/watch_together_text"
        app:layout_constraintEnd_toEndOf="@+id/watch_together_container_btn"
        app:layout_constraintTop_toTopOf="@+id/watch_together_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
