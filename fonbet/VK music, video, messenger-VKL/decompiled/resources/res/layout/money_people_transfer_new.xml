<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_mt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/scrollable_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vk.core.view.VKTabLayout
                android:id="@+id/tabs_request"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                style="?attr/tabBarTheme"/>
            <com.vk.money.createtransfer.input.TransferInputFieldView
                android:id="@+id/transfer_input_field"
                android:layout_width="match_parent"
                android:layout_height="216dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                app:vk_max_height="216dp"/>
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/merge_transfer_block_progressbar"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:indeterminate="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/merge_transfer_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/vk_legacy_text_subhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/money_transfer_select_pay_method_caption"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/vk_roboto_regular"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <com.vk.core.view.TintTextView
                    android:textSize="16sp"
                    android:textColor="?attr/vk_legacy_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_card_title"
                    android:background="@drawable/money_transfer_selectable_field"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="4sp"
                    android:fontFamily="sans-serif"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:drawableEndCompat="@drawable/vk_icon_dropdown_24"
                    app:drawableEndTint="?attr/vk_legacy_icon_tertiary"
                    app:drawableRightTint="?attr/vk_legacy_overlay_status_icon"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/vk_legacy_text_subhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/money_transfer_destination_for_transfer"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/vk_roboto_regular"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <com.vkontakte.android.ui.CompoundRadioGroup
                    android:orientation="vertical"
                    android:id="@+id/card_type_radiogroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <com.vkontakte.android.ui.CheckableRelativeLayout
                        android:id="@+id/sbp_receiver_checkbox_parent"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="-5dp">
                        <RadioButton
                            android:textSize="16sp"
                            android:textColor="?attr/vk_legacy_text_muted"
                            android:id="@android:id/checkbox"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/money_transfer_pay_method_sbp"
                            android:maxLines="1"/>
                    </com.vkontakte.android.ui.CheckableRelativeLayout>
                    <com.vkontakte.android.ui.CheckableRelativeLayout
                        android:id="@+id/card_receiver_checkbox_parent"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="-5dp">
                        <RadioButton
                            android:textSize="16sp"
                            android:textColor="?attr/vk_legacy_text_muted"
                            android:id="@android:id/checkbox"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:checked="true"
                            android:text="@string/money_transfer_pay_method_any_bank_card"
                            android:maxLines="1"/>
                    </com.vkontakte.android.ui.CheckableRelativeLayout>
                    <com.vkontakte.android.ui.CheckableRelativeLayout
                        android:id="@+id/vkpay_receiver_checkbox_parent"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="-5dp">
                        <RadioButton
                            android:textSize="16sp"
                            android:textColor="?attr/vk_legacy_text_muted"
                            android:id="@android:id/checkbox"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/money_transfer_pay_method_vkpay"
                            android:maxLines="1"/>
                    </com.vkontakte.android.ui.CheckableRelativeLayout>
                </com.vkontakte.android.ui.CompoundRadioGroup>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="16sp"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/positive"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:minHeight="44dp"
        android:text="@string/money_transfer_proceed_next"
        style="@style/primary_button"/>
</LinearLayout>
