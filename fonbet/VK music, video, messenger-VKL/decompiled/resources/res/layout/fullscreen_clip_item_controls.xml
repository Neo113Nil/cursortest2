<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.clips.viewer.impl.feed.view.subs.ClipsCanvasSubtitleView
        android:layout_gravity="bottom"
        android:id="@+id/fullscreen_clip_subtitles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/fullscreen_clip_error_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/fullscreen_clip_play_pause_button_stub"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"/>
    <include
        android:visibility="gone"
        layout="@layout/fullscreen_clip_main_overlay"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/fullscreen_clip_restriction"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.clips.tool.view.viewer.feed.list.nps.LazyNpsOverlay
        android:id="@+id/fullscreen_clip_nps_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/fullscreen_clip_unfocused_blackout"
        android:background="@color/clip_unfocused_blackout_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.clips.viewer.impl.feed.view.ClipFeedLikeFlyView
        android:id="@+id/fullscreen_clip_fly_double_tap_like"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
