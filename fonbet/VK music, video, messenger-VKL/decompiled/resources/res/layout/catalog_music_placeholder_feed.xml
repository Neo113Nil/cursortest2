<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="4dp">
    <ImageView
        android:id="@+id/tip"
        android:layout_width="20dp"
        android:layout_height="8dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/tip"
        app:tint="?attr/vk_ui_background_secondary"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:id="@+id/catalog_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tip"/>
    <ImageView
        android:id="@+id/catalog_placeholder_hide"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/accessibility_hide"
        app:layout_constraintEnd_toEndOf="@+id/catalog_placeholder"
        app:layout_constraintTop_toTopOf="@+id/catalog_placeholder"
        app:srcCompat="@drawable/vk_icon_clear_20"
        app:tint="?attr/vk_ui_icon_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
