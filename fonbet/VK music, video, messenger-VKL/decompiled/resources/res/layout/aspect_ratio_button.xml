<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/format_action_btn"
        android:background="@drawable/bg_aspect_ratio_item"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:scaleType="center"
        app:tint="@drawable/bg_aspect_ratio_tint"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/format_action_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:lines="1"
        style="@style/VkUiTypography.Caption2Normal"/>
</FrameLayout>
