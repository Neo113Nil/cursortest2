<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/stickers_keyboard_navigation_height">
    <View
        android:background="@drawable/bg_bottom_navigation_shadow"
        android:layout_width="match_parent"
        android:layout_height="6dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/tabs_wrap"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stickers_keyboard_navigation_height">
        <FrameLayout
            android:layout_gravity="left"
            android:id="@+id/gift_store_left_button"
            android:background="?attr/selectableItemBackground"
            android:layout_width="48dp"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="center"
                android:contentDescription="@string/accessibility_open_gift_store"
                app:srcCompat="@drawable/vk_icon_gift_outline_24"
                app:tint="?attr/vk_ui_icon_secondary"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="left"
            android:id="@+id/store_button"
            android:background="?attr/selectableItemBackground"
            android:layout_width="48dp"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="center"
                android:contentDescription="@string/accessibility_open_sticker_store"
                app:srcCompat="@drawable/vk_icon_storefront_outline_24"
                app:tint="?attr/vk_ui_icon_secondary"/>
            <ImageView
                android:layout_gravity="end|top"
                android:id="@+id/store_new_packs_dot"
                android:background="@drawable/ic_sticker_new_badge_composite_full"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Caption1Medium"
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/store_counter"
                android:background="@drawable/sticker_store_icon_badge"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:layout_marginRight="5dp"
                android:lines="1"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="left"
            android:id="@+id/fast_scroll_button"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:contentDescription="@string/accessibility_emojis"
            android:layout_marginStart="-12dp"
            app:srcCompat="@drawable/vk_icon_chevron_left_outline_28"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/stickers_keyboard_navigation_height">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stickers_navigation"
                android:paddingRight="48dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="right"
                android:id="@+id/backspace_btn"
                android:background="?attr/vk_ui_image_placeholder"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:contentDescription="@string/accessibility_backspace"
                android:importantForAccessibility="yes"
                app:srcCompat="@drawable/vk_icon_backspace_28"
                app:tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_primary"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
