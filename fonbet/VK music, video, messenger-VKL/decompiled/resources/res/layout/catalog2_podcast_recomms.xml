<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/music_selectable_bg"
    android:paddingTop="@dimen/podcast_slider_padding_vertical"
    android:paddingBottom="@dimen/podcast_slider_padding_vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:paddingHorizontal="@dimen/podcast_slider_padding_horizontal">
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/image_thumb"
        android:layout_width="@dimen/podcast_recomms_size"
        android:layout_height="@dimen/podcast_recomms_size"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/music_image_corners_12"
        app:tiv_background_image="?attr/vk_ui_image_placeholder"
        app:tiv_border_width="0.5dp"
        app:tiv_empty_resource="@drawable/vk_icon_podcast_48"
        app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
    <ImageView
        android:id="@+id/image_button_play"
        android:background="@drawable/bg_white_circle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp"
        android:scaleType="center"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_thumb"
        app:layout_constraintEnd_toEndOf="@+id/image_thumb"
        app:srcCompat="@drawable/vk_icon_play_24"
        app:tint="@color/vk_black"/>
    <TextView
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/image_thumb"
        app:layout_constraintStart_toStartOf="@+id/image_thumb"
        app:layout_constraintTop_toBottomOf="@+id/image_thumb"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/text_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/image_thumb"
        app:layout_constraintStart_toStartOf="@+id/image_thumb"
        app:layout_constraintTop_toBottomOf="@+id/text_title"
        style="@style/VkUiTypography.Subhead"/>
</androidx.constraintlayout.widget.ConstraintLayout>
