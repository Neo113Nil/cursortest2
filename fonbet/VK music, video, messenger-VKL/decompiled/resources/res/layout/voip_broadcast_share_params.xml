<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="start|center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voip_broadcast_share_settings_title"
        android:fontFamily="@font/vk_roboto_medium"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/share_in_stories_container"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="44dp">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/share_in_stories_checkbox"
            android:background="@null"
            android:clickable="false"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="-5dp"
            style="@style/TextStyle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voip_broadcast_share_settings_stories"
            android:maxLines="1"
            android:fontFamily="@font/vk_roboto_regular"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            style="@style/TextStyle"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/share_on_wall_container"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/share_on_wall_checkbox"
            android:background="@null"
            android:clickable="false"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="-5dp"
            style="@style/TextStyle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voip_broadcast_share_settings_wall"
            android:maxLines="1"
            android:fontFamily="@font/vk_roboto_regular"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            style="@style/TextStyle"/>
    </LinearLayout>
    <Button
        android:id="@+id/done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/voip_broadcast_done"
        style="@style/VoipOverlay.Button.Primary"/>
</LinearLayout>
