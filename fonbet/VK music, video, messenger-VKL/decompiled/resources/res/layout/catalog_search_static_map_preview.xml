<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/map_view_stub_container"
        android:layout_width="0dp"
        android:layout_height="146dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ViewStub
            android:id="@+id/map_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:background="@drawable/search_map_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/expand_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:foreground="?attr/selectableItemBackground"
        android:contentDescription="@string/search_catalog_accessibility_open_map"
        android:layout_marginEnd="10dp"
        app:cardBackgroundColor="?attr/vk_ui_background_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/map_view_stub_container"
        app:layout_constraintHeight_min="36dp"
        app:layout_constraintTop_toTopOf="@+id/map_view_stub_container"
        app:layout_constraintVertical_bias="0">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/vk_icon_fullscreen_24"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:tint="?attr/vk_ui_icon_primary"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
