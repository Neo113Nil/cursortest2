<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/videoNavigationSwipeIcon"
        android:background="@drawable/video_minimizable_swipe_icon_background"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.DisplayTitle2SemiBold"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/videoDialogTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:lines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/videoDialogSubtitle"
        app:layout_constraintEnd_toStartOf="@+id/videoDialogNavigationIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/videoNavigationSwipeIcon"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Footnote"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/videoDialogSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/videoDialogNavigationIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/videoDialogTitle"/>
    <ImageButton
        android:id="@+id/videoDialogNavigationIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/vk_icon_cancel_28"
        android:contentDescription="@string/playlist_close_description"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/videoDialogTitle"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/videoDialogTitle"
        app:layout_constraintTop_toTopOf="@+id/videoDialogTitle"
        app:tint="?attr/vk_ui_text_primary"/>
    <View
        android:id="@+id/videoDialogHeaderSeparator"
        android:background="?attr/vk_ui_separator_primary2x"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="13dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/videoDialogSubtitle"/>
    <com.vk.core.view.components.tabs.VkTabs
        android:id="@+id/tabs"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/videoDialogHeaderSeparator"
        app:tabsMode="tabsModeAccent"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/videoSortIcon"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/playlist_sort_description"
        android:layout_marginStart="12dp"
        android:layout_marginVertical="6dp"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_sort_outline_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabs"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/videoShuffleIcon"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:layout_marginVertical="6dp"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_shuffle_outline_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@+id/videoSortIcon"
        app:layout_constraintTop_toBottomOf="@+id/tabs"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/videoCycleModeIcon"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:layout_marginVertical="6dp"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_repeat_outline_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@+id/videoShuffleIcon"
        app:layout_constraintTop_toBottomOf="@+id/tabs"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/videoMoreIcon"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/playlist_menu_description"
        android:layout_marginEnd="8dp"
        android:backgroundTint="?attr/vk_ui_transparent"
        android:layout_marginVertical="6dp"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_more_vertical_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabs"/>
</androidx.constraintlayout.widget.ConstraintLayout>
