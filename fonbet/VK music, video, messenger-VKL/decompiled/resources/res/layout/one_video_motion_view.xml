<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/video_motion_header_place_view"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toTopOf="@+id/video_motion_recycler_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <one.video.ad.ux.motion.view.OneVideoMotionHeaderView
        android:id="@+id/video_motion_header_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_motion_header_place_view"
        app:layout_constraintEnd_toEndOf="@+id/video_motion_header_place_view"
        app:layout_constraintStart_toStartOf="@+id/video_motion_header_place_view"
        app:layout_constraintTop_toTopOf="@+id/video_motion_header_place_view"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/video_motion_recycler_view"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/video_motion_footer_place_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_motion_header_place_view"/>
    <View
        android:id="@+id/video_motion_footer_place_view"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_motion_recycler_view"/>
    <ProgressBar
        android:id="@+id/video_motion_progress_view"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:progressDrawable="@drawable/one_video_ad_horizontal_progress"
        android:contentDescription="@string/one_video_accessibility_rewinding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
</merge>
