<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/vk_highlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/photo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        app:placeholderImage="@drawable/sticker_placeholder"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/action_icon"
        android:layout_toRightOf="@+id/photo"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:letterSpacing="0.01"/>
    <ImageView
        android:id="@+id/action_icon"
        android:background="@drawable/vk_highlight_circle"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_cancel_24"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:tint="?attr/vk_ui_icon_secondary"/>
</RelativeLayout>
