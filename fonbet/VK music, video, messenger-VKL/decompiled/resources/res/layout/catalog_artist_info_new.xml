<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.imageloader.view.VKOverlayImageView
        android:id="@+id/artist_header_image"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:emptyImagePlaceholder="@drawable/artist_cover_placeholder_new"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:overlayDrawable="@drawable/artist_cover_overlay_new"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundTopLeft="false"
        app:roundTopRight="false"
        app:roundedCornerRadius="@dimen/music_recommended_playlist_corner_radius"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/artist_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/artist_action_chips"
        app:layout_constraintEnd_toEndOf="@+id/artist_header_image"
        app:layout_constraintStart_toStartOf="@+id/artist_header_image">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/artist_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/artist_actions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textAppearance="@style/VkUiTypography.DisplayTitle2"
                android:textStyle="normal"
                android:textColor="?attr/vk_ui_text_contrast"
                android:ellipsize="end"
                android:id="@+id/artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.Footnote"
                android:textColor="@color/vk_white_alpha60"
                android:ellipsize="end"
                android:id="@+id/artist_listeners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:id="@+id/artist_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            app:layout_constraintBottom_toTopOf="@+id/artist_action_chips"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:id="@+id/subscription_state"
                android:background="@drawable/bg_white_circle_alpha_20"
                android:padding="@dimen/catalog_artist_action_button_padding"
                android:visibility="gone"
                android:layout_width="@dimen/catalog_artist_action_button_size"
                android:layout_height="@dimen/catalog_artist_action_button_size"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                android:layout_marginEnd="12dp"/>
            <ImageView
                android:id="@+id/artist_listen_all"
                android:background="@drawable/bg_white_circle"
                android:padding="@dimen/catalog_artist_action_button_padding"
                android:visibility="gone"
                android:layout_width="@dimen/catalog_artist_action_button_size"
                android:layout_height="@dimen/catalog_artist_action_button_size"
                android:scaleType="centerInside"
                android:contentDescription="@null"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/artist_action_chips"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginBottom="40dp"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/artist_header_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/view_rounded"
        android:background="@drawable/bg_rounded_top_corners_20"
        android:layout_width="0dp"
        android:layout_height="@dimen/overlap_separator_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
