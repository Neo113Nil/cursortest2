<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.profile.user.impl.ui.view.skeleton.UserProfileSkeletonView
        android:id="@+id/profile_skeleton_tabs"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/iv_cover_tabs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.profile.design.view.cover.SnowballsCoverView
        android:id="@+id/snowballs_cover_tabs"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/iv_cover_reflect_tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/profile_card_corner_radius"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/user_profile_swipe_refresh_tabs"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.profile.core.tabs.ui.view.NestedVerticalRecyclerViewContainer
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/profile_content_tabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="1dp"
                android:translationY="-1dp"
                app:layoutManager="LinearLayoutManager"/>
        </com.vk.profile.core.tabs.ui.view.NestedVerticalRecyclerViewContainer>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress_bar_tabs"
        android:background="@drawable/profile_loader_background"
        android:padding="22dp"
        android:visibility="gone"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:indeterminate="true"
        android:elevation="10dp"/>
    <com.vk.profile.user.impl.ui.view.header.UserProfileHeaderView
        android:id="@+id/header_tabs"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.vk.core.view.components.placeholder.main.VkPlaceholder
        android:layout_gravity="center"
        android:id="@+id/profile_error_tabs"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
