<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_recommended_playlists"
    android:layout_width="@dimen/music_recommended_playlist_layout_width"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.imageloader.view.VKOverlayImageView
            android:id="@+id/playlist_image"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:foreground="?attr/selectableItemBackground"
            app:emptyImagePlaceholder="@drawable/playlist_cover_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:overlayDrawable="@drawable/recommended_playlist_overlay"
            app:roundedCornerRadius="@dimen/music_recommended_playlist_corner_radius"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.DisplayTitle4"
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/match_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1"
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/match_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/match_percent"
            app:layout_constraintStart_toEndOf="@+id/match_percent"
            app:layout_constraintTop_toTopOf="@+id/match_percent"/>
        <com.vk.imageloader.view.VKCircleImageView
            android:id="@+id/playlist_owner_picture"
            android:layout_width="@dimen/music_recommended_playlist_owner_size"
            android:layout_height="@dimen/music_recommended_playlist_owner_size"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/playlist_image"
            app:layout_constraintStart_toStartOf="@+id/playlist_image"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Caption1"
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/playlist_owner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:singleLine="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/playlist_image"
            app:layout_constraintEnd_toStartOf="@+id/play_view"
            app:layout_constraintStart_toEndOf="@+id/playlist_owner_picture"
            app:layout_constraintTop_toTopOf="@+id/playlist_owner_picture"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.DisplayTitle4"
            android:textStyle="normal"
            android:textColor="@color/vk_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/playlist_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/recommended_playlist_title_with_subtitle_offset"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/playlist_image"
            app:layout_constraintEnd_toStartOf="@+id/play_view"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.vk.music.view.MusicRoundPlayView
            android:id="@+id/play_view"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/playlist_image"
            app:layout_constraintEnd_toEndOf="@+id/playlist_image"
            app:mrp_background_tint="@color/vk_white"
            app:mrp_compact_progess_bar="true"
            app:mrp_pause_icon="@drawable/vk_icon_pause_28"
            app:mrp_play_icon="@drawable/vk_icon_play_28"
            app:mrp_play_icon_tint="@color/vk_black"/>
        <include
            android:id="@+id/playlist_track_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/playlist_image"
            layout="@layout/catalog_music_cell_audio_item"/>
        <include
            android:id="@+id/playlist_track_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/playlist_track_1"
            layout="@layout/catalog_music_cell_audio_item"/>
        <include
            android:id="@+id/playlist_track_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/playlist_track_2"
            layout="@layout/catalog_music_cell_audio_item"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
