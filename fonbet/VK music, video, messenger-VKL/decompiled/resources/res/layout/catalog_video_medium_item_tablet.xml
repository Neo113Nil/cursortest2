<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/small_video_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintDimensionRatio="1.786:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="12dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/overlay_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:foregroundGravity="center"
        app:layout_constraintDimensionRatio="1.786:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vov_corner_radius="12dp"
        app:vov_force_redesign="true"
        app:vov_size="medium"/>
    <com.vk.donut.design.view.badge.DonutBadge
        android:id="@+id/donut_price_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/image_barrier"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/image_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="overlay_view,preview"/>
    <com.vk.libvideo.ui.UpcomingIndicatorView
        android:textAppearance="@style/VkUiTypography.Caption1Medium"
        android:id="@+id/video_upcoming_indicator"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:lineHeight="12sp"
        app:layout_constraintBottom_toTopOf="@+id/image_barrier"
        app:layout_constraintStart_toEndOf="@+id/privacy_icon"/>
    <com.vk.libvideo.design.view.duration.DurationView
        android:textAppearance="@style/VkUiTypography.HeadlineMedium"
        android:id="@+id/duration"
        android:background="@drawable/bg_video_duration_label"
        android:visibility="invisible"
        android:layout_width="42dp"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_barrier"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.libvideo.design.view.movika.InteractiveDurationView
        android:textAppearance="@style/VkUiTypography.HeadlineMedium"
        android:id="@+id/interactive_duration"
        android:background="@drawable/bg_interactiv_video_duration_label_rounded_4"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_barrier"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/privacy_icon"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        app:layout_constraintBottom_toTopOf="@+id/image_barrier"
        app:layout_constraintStart_toStartOf="@+id/image_barrier"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.core.view.components.picture.VkImage
        android:layout_gravity="bottom"
        android:id="@+id/live_badge"
        android:visibility="invisible"
        android:layout_width="42dp"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/vk_icon_live_badge_20"
        android:importantForAccessibility="no"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/image_barrier"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:padding="0dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_barrier"/>
    <com.vk.libvideo.design.view.info.VideoInfoTextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:id="@+id/subtitle_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/menu"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/menu"
        android:background="@drawable/highlight_unlimited"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/menu"
        android:paddingStart="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle_date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_barrier"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
