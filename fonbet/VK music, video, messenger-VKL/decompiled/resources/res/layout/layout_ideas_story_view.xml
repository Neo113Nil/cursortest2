<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ideas_root"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.imageloader.view.VKImageView
            android:id="@+id/ideas_background_image"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/ideas_back_gradient"
            android:background="@drawable/scrim_left_40percent"
            android:visibility="invisible"
            android:layout_width="88dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/ideas_controls_top"
            android:background="@drawable/vk_gradient_top_112"
            android:layout_width="0dp"
            android:layout_height="112dp"
            android:alpha="0.24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/ideas_controls_bottom"
            android:background="@drawable/vk_gradient_bottom_112"
            android:layout_width="0dp"
            android:layout_height="112dp"
            android:alpha="0.24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ideas_viewport"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="@dimen/ideas_story_viewport_horizontal_margin"
            app:layout_constraintBottom_toTopOf="@+id/ideas_bottom_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ideas_header">
            <com.vk.core.view.components.text.VkText
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:id="@+id/ideas_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ideas_story_publish_title"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginHorizontal="@dimen/ideas_story_box_horizontal_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/VkUiTypography.DisplayTitle3"/>
            <FrameLayout
                android:id="@+id/ideas_story_box"
                android:background="@drawable/ideas_story_box_stroke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ideas_story_box_margin_top"
                android:outlineProvider="background"
                android:clipToOutline="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ideas_title"
                app:layout_constraintVertical_bias="0">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <FrameLayout
                        android:id="@+id/ideas_onboarding_bar"
                        android:background="@color/vk_white_alpha8"
                        android:clipChildren="true"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ideas_story_onboarding_bar_height"
                        android:outlineProvider="background"
                        android:clipToOutline="true">
                        <com.vk.story.viewer.impl.presentation.ideas.ui.IdeasOnboardingShimmerView
                            android:id="@+id/ideas_onboarding_bar_skeleton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            app:blockRadius="@dimen/ideas_story_onboarding_shimmer_corner_radius"/>
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/ideas_onboarding_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:elevation="1dp"
                            android:paddingHorizontal="14dp">
                            <ImageView
                                android:id="@+id/ideas_onboarding_icon"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/vk_icon_hide_outline_24"
                                android:importantForAccessibility="no"
                                app:tint="@color/vk_white"/>
                            <com.vk.core.view.components.text.VkText
                                android:textColor="@color/vk_white"
                                android:id="@+id/ideas_onboarding_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ideas_story_visible_only_you"
                                android:layout_marginStart="8dp"
                                style="@style/VkUiTypography.Caption1"/>
                        </LinearLayout>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/ideas_content_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:outlineProvider="background"
                        android:clipToOutline="true">
                        <com.vk.story.viewer.impl.presentation.ideas.ui.IdeasStoryAvatarView
                            android:layout_gravity="center"
                            android:id="@+id/ideas_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <ImageButton
                            android:layout_gravity="end|bottom"
                            android:id="@+id/ideas_open_editor"
                            android:background="@drawable/ideas_story_edit_button_background"
                            android:padding="@dimen/vk_ui_spacing_size_s"
                            android:layout_width="@dimen/ideas_story_edit_button_size"
                            android:layout_height="@dimen/ideas_story_edit_button_size"
                            android:layout_marginBottom="@dimen/ideas_story_edit_button_margin"
                            android:src="@drawable/vk_icon_pen_outline_24"
                            android:scaleType="centerInside"
                            android:importantForAccessibility="yes"
                            android:layout_marginEnd="@dimen/ideas_story_edit_button_margin"
                            app:tint="@color/vk_white"/>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ideas_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.vk.stories.design.view.StoryProgressView
                android:id="@+id/ideas_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ideas_more"
                android:background="@drawable/white_ripple_unbounded"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/vk_icon_more_horizontal_shadow_medium_48"
                app:layout_constraintEnd_toStartOf="@+id/ideas_close"
                app:layout_constraintTop_toTopOf="@+id/ideas_close"/>
            <ImageView
                android:id="@+id/ideas_close"
                android:background="@drawable/white_ripple_unbounded"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:src="@drawable/vk_icon_cancel_shadow_medium_48"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/ideas_bottom_bar"
            android:paddingBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.vk.core.view.components.button.VkButton
                android:id="@+id/ideas_publish_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:buttonAppearance="overlay"
                app:buttonBackgroundCornerRadius="@dimen/vk_ui_border_radius_promo"
                app:buttonMode="primary"
                app:buttonSizeType="large"
                app:text="@string/ideas_story_publish_now"/>
        </FrameLayout>
        <ProgressBar
            android:id="@+id/ideas_loader"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Base.Widget.AppCompat.ProgressBar"/>
        <include
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/layout_error_story_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
