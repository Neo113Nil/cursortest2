<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/review_view_placeholder"
    android:background="@drawable/market_all_reviews_tabs_view_holder_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/market_all_reviews_shimmer_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <View
                android:id="@+id/good_photo_iv"
                android:background="@drawable/rectangle_skeleton_12"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/good_name_tv"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/good_photo_iv"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.7"/>
            <com.vk.core.view.components.rating.VkRatingBarSkeleton
                android:id="@+id/rating_bar"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="yes"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/good_photo_iv"
                app:layout_constraintStart_toEndOf="@+id/good_photo_iv"
                app:layout_constraintTop_toBottomOf="@+id/good_name_tv"
                app:rating_size="small"/>
            <View
                android:id="@+id/rating_description_tv"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:paddingStart="1dp"
                android:layout_marginStart="1dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/rating_bar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/rating_bar"
                app:layout_constraintTop_toTopOf="@+id/rating_bar"
                app:layout_constraintWidth_percent="0.4"/>
            <LinearLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:id="@+id/images_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rating_description_tv">
                <View
                    android:background="@drawable/rectangle_skeleton_12"
                    android:layout_width="56dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="6dp"/>
                <View
                    android:background="@drawable/rectangle_skeleton_12"
                    android:layout_width="56dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <View
                    android:background="@drawable/rectangle_skeleton_12"
                    android:layout_width="56dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <View
                    android:background="@drawable/rectangle_skeleton_12"
                    android:layout_width="56dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <View
                    android:background="@drawable/rectangle_skeleton_12"
                    android:layout_width="56dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <View
                android:id="@+id/review_tv"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="10dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/images_rv"
                app:layout_constraintWidth_percent="0.7"/>
            <View
                android:id="@+id/review_tv_1"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/review_tv"
                app:layout_constraintWidth_percent="0.9"/>
            <View
                android:id="@+id/review_tv_2"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/review_tv_1"
                app:layout_constraintWidth_percent="0.84"/>
            <View
                android:id="@+id/review_tv_3"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/review_tv_2"
                app:layout_constraintWidth_percent="0.4"/>
            <View
                android:id="@+id/published_review_status_tv"
                android:background="@drawable/rectangle_skeleton"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/review_tv_3"
                app:layout_constraintWidth_percent="0.8"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
</FrameLayout>
