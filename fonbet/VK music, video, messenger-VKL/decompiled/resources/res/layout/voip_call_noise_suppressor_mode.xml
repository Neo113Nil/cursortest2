<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/accessibility_back"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"
        app:srcCompat="@drawable/vk_icon_back_24"
        app:tint="?attr/vk_ui_text_primary"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toEndOf="@+id/back"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/voip_call_actions_noise_suppressor_title"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:titleTextColor="?attr/vk_ui_text_primary"/>
    <View
        android:id="@+id/actions_section_divider"
        android:background="?attr/vk_ui_separator_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <FrameLayout
        android:id="@+id/noise_suppressor_none"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/noise_suppressor_platform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actions_section_divider">
        <TextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/noise_suppressor_none_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voip_ns_state_none"
            style="@style/VkLegacyTypography.Headline.Regular"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/noise_suppressor_none_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/vk_icon_animated_check_circle_on_24"
            app:tint="?attr/vk_ui_icon_accent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/noise_suppressor_platform"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/noise_suppressor_auto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noise_suppressor_none">
        <TextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/noise_suppressor_platform_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voip_ns_state_platform"
            style="@style/VkLegacyTypography.Headline.Regular"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/noise_suppressor_platform_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/vk_icon_animated_check_circle_on_24"
            app:tint="?attr/vk_ui_icon_accent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/noise_suppressor_auto"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noise_suppressor_platform">
        <TextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/noise_suppressor_auto_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voip_ns_state_auto"
            style="@style/VkLegacyTypography.Headline.Regular"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/noise_suppressor_auto_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/vk_icon_animated_check_circle_on_24"
            app:tint="?attr/vk_ui_icon_accent"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
