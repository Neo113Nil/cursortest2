<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/booking_attach_container"
    android:paddingTop="2dp"
    android:paddingBottom="1dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingHorizontal="16dp">
    <ImageView
        android:layout_gravity="start|top"
        android:id="@+id/booking_attach_icon"
        android:background="?attr/vk_ui_background_secondary"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_calendar_outline_24"
        app:tint="?attr/vk_ui_icon_medium"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/center_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/booking_attach_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/market_involvement_booking"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/center_guideline"
        app:layout_constraintEnd_toStartOf="@+id/booking_attach_mini_app_button"
        app:layout_constraintStart_toEndOf="@+id/booking_attach_icon"
        style="@style/VkUiTypography.Headline2Medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/booking_attach_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/booking_attach_mini_app_button"
        app:layout_constraintStart_toEndOf="@+id/booking_attach_icon"
        app:layout_constraintTop_toBottomOf="@+id/center_guideline"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/booking_attach_mini_app_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:text="@string/booking_attach_button_text"/>
    <ImageView
        android:id="@+id/booking_attach_remove_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_cancel_24"
        android:contentDescription="@string/delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vk_steel_gray_300"/>
</androidx.constraintlayout.widget.ConstraintLayout>
