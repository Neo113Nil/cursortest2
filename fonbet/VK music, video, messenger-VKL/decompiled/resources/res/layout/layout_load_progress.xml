<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_load_progress"
        android:padding="2dp"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginTop="14dp"
        android:foreground="@drawable/highlight_circle_white"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp">
        <com.vk.core.ui.CircularProgressView
            android:layout_gravity="center"
            android:id="@+id/load_progress_circular"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cpv_animAutostart="true"
            app:cpv_animSwoopDuration="0"
            app:cpv_color="?attr/vk_ui_icon_contrast"
            app:cpv_indeterminate="false"
            app:cpv_maxProgress="1"
            app:cpv_thickness="2.5dp"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/vk_icon_cancel_outline_shadow_large_48_close"
            app:tint="?attr/vk_ui_icon_contrast"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_contrast"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/load_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        style="@style/VkUiTypography.Caption1Medium"/>
</merge>
