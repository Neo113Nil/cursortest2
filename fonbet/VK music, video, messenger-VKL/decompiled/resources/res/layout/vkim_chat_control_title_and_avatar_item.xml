<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="21dp"
    android:paddingBottom="21dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.avatars.AvatarView
        android:id="@+id/vkim_chat_profile_title_and_avatar_item__avatar_view"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/vkim_accessibility_avatar_chat"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"
        style="@style/VkIm.AvatarView"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_subhead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/vkim_chat_profile__hat_settings_title_header_res_0x7f1342c8"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/vkim_chat_profile_title_and_avatar_item__avatar_view"/>
    <EditText
        android:textSize="16sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:textColorHint="?attr/vk_legacy_text_placeholder"
        android:id="@+id/vkim_chat_profile_title_and_avatar_item__title_edittext"
        android:background="@drawable/bg_settings_edittext_normal"
        android:padding="12dp"
        android:fadingEdgeLength="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/vkim_chat_profile__hat_settings_title_hint_res_0x7f1342c9"
        android:includeFontPadding="false"
        android:maxLength="120"
        android:layout_alignBottom="@+id/vkim_chat_profile_title_and_avatar_item__avatar_view"
        android:inputType="textCapSentences"
        android:imeOptions="actionDone"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/vkim_chat_profile_title_and_avatar_item__avatar_view"/>
</RelativeLayout>
