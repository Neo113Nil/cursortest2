<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.AspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/checkbox"
        android:background="@drawable/vk_ripple_circle_highlight"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
</com.vk.core.tool.view.AspectRatioFrameLayout>
