<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/attach_podcast_restricted_container"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <View
        android:id="@+id/image"
        android:background="@drawable/podcast_restricted_placeholder_24"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:minHeight="64dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadSemiBold"
        android:textColor="@color/vk_gray_400"
        android:ellipsize="end"
        android:id="@+id/description"
        android:background="@drawable/attach_podcast_right"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="44dp"
        android:layout_marginStart="64dp"/>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/attach_podcast_remove_button"
        android:background="@drawable/vk_icon_deprecated_ic_close_attach_36"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/delete"/>
</FrameLayout>
