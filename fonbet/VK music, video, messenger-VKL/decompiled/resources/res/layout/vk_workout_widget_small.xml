<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/vgRoot"
    android:layout_width="146dp"
    android:layout_height="146dp">
    <ImageView
        android:id="@+id/ivAppWidgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/vgError"
        android:paddingTop="24dp"
        android:paddingBottom="34dp"
        android:visibility="gone"
        android:layout_width="146dp"
        android:layout_height="146dp"
        android:paddingHorizontal="10dp">
        <FrameLayout
            android:id="@+id/vgErrorIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/ivErrorBg"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/vk_workout_widget_info_bg"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/vk_icon_info_circle_outline_24"
                app:tint="@color/vkworkout_widget_error_icon_color"/>
        </FrameLayout>
        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vk_workout_widget_small_error_message"
            android:maxLines="3"
            android:layout_below="@+id/vgErrorIcon"
            android:layout_centerHorizontal="true"
            android:textAlignment="center"
            style="@style/VkWorkoutWidget.Error"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/vgCounter"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_workout_widget_small_current_week"
            style="@style/VkWorkoutWidget.Title"/>
        <TextView
            android:id="@+id/tvTrainingsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vk_workout_widget_small_no_workouts"
            style="@style/VkWorkoutWidget.WorkoutsCount"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vgTrainingDistance"
            android:background="@drawable/vk_workout_widget_distance_bg"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp">
            <TextView
                android:id="@+id/tvTrainingDistanceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vk_workout_widget_small_distance"
                style="@style/VkWorkoutWidget.DistanceTitle"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tvTrainingDistanceAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/VkWorkoutWidget.Distance"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vk_workout_widget_small_kilometers"
                    android:layout_marginStart="2dp"
                    style="@style/VkWorkoutWidget.Distance.Units"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
