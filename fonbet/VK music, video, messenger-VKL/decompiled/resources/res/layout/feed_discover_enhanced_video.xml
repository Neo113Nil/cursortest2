<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/news_discover_grid_item_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.libvideo.design.view.videotexture.VideoTextureView
        android:layout_gravity="center"
        android:id="@+id/discover_video_display"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.core.view.image.VkEnhancedImageView
        android:id="@+id/discover_enhanced_video_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:actualImageScaleType="centerCrop"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:layout_gravity="center"
        android:id="@+id/discover_video_error"
        android:background="@drawable/circle_gray_placeholder"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/video_error_retry"
        app:srcCompat="@drawable/vk_icon_replay_24"
        app:tint="@color/vk_white"/>
</merge>
