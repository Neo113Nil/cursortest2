<?xml version="1.0" encoding="utf-8"?>
<com.vk.core.tool.view.FluidHorizontalLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end|center_vertical"
    android:id="@+id/create_post_root_layout"
    android:background="?attr/vk_legacy_background_content"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:paddingEnd="?attr/posting_whats_new_icon_padding_end">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/whats_new_button"
        android:background="@drawable/vkui_bg_button_secondary"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:paddingStart="23.5dp"
        android:paddingEnd="27.5dp"
        android:layout_marginStart="@dimen/post_side_padding"
        android:layout_marginEnd="10dp"
        app:vk_layout_isFluid="true">
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="start|center_vertical"
                android:id="@+id/create_post_title_icon"
                android:background="@drawable/vk_icon_pen_outline_24"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:backgroundTint="?attr/vk_legacy_button_secondary_foreground"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="normal"
                android:textColor="@color/vk_secondary_button_text"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/create_post_title_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/feed_posting_create_post"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:fontFamily="@font/vk_roboto_medium"
                android:textDirection="locale"
                android:layout_marginStart="30dp"
                style="@style/VkLegacyTypography.Text"/>
        </FrameLayout>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/create_simple_post"
        android:background="@drawable/highlight_whats_new_input"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_make_post_with_attachment"
        app:srcCompat="@drawable/vk_icon_add_24"
        app:tint="?attr/vk_legacy_accent"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/create_post_gallery_image"
        android:background="@drawable/highlight_circle"
        android:layout_width="?attr/posting_whats_new_icon_gallery_width"
        android:layout_height="?attr/posting_whats_new_icon_gallery_width"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_make_post_with_attachment"
        app:srcCompat="@drawable/vk_icon_picture_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/create_post_clip"
        android:background="@drawable/highlight_circle"
        android:visibility="gone"
        android:layout_width="?attr/posting_whats_new_icon_story_width"
        android:layout_height="?attr/posting_whats_new_icon_story_width"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_video_create_own_clip"
        app:srcCompat="@drawable/vk_icon_logo_clips_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/create_post_live_image"
        android:background="@drawable/highlight_circle"
        android:layout_width="?attr/posting_whats_new_icon_live_width"
        android:layout_height="?attr/posting_whats_new_icon_live_width"
        android:scaleType="center"
        android:contentDescription="@string/live"
        app:srcCompat="@drawable/vk_icon_live_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/create_post_story_image"
        android:background="@drawable/highlight_circle"
        android:visibility="gone"
        android:layout_width="?attr/posting_whats_new_icon_story_width"
        android:layout_height="?attr/posting_whats_new_icon_story_width"
        android:scaleType="center"
        android:contentDescription="@string/story"
        app:srcCompat="@drawable/vk_icon_story_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/create_post_sitposting"
        android:background="@drawable/highlight_circle"
        android:visibility="gone"
        android:layout_width="?attr/posting_whats_new_icon_story_width"
        android:layout_height="?attr/posting_whats_new_icon_story_width"
        android:scaleType="center"
        app:srcCompat="@drawable/vk_icon_lightbulb_star_outline_28"
        app:tint="?attr/vk_legacy_accent"/>
</com.vk.core.tool.view.FluidHorizontalLayout>
