<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:ratio="0.75">
    <View
        android:background="@drawable/user_discover_skeleton_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.superapp.ui.shimmer.ShimmerFrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/skeleton_root"
            android:layout_width="match_parent"
            android:layout_height="88dp">
            <View
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="81dp"/>
            <View
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="120dp"
                android:layout_height="12dp"
                android:layout_marginTop="28dp"
                android:layout_marginStart="12dp"/>
            <View
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="28dp"
                android:layout_marginStart="144dp"
                android:layout_marginEnd="32dp"/>
            <View
                android:background="@drawable/vk_bg_skeleton"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="52dp"
                android:layout_marginStart="12dp"/>
            <View
                android:background="@drawable/vk_bg_skeleton_4dp"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="56dp"
                android:layout_marginStart="44dp"
                android:layout_marginEnd="156dp"/>
        </FrameLayout>
    </com.vk.superapp.ui.shimmer.ShimmerFrameLayout>
</merge>
