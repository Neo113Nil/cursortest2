<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_root_container"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="top"
        android:id="@+id/v_fave_empty_top_divider"
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_fave_empty_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/VkUiTypography.Title2Medium"
            android:textStyle="normal"
            android:textColor="?attr/vk_ui_text_primary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_fave_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:text="@string/fave_empty_title"/>
        <TextView
            android:textAppearance="@style/VkUiTypography.Headline1Normal"
            android:textStyle="normal"
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_gravity="top"
            android:id="@+id/tv_fave_empty_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/tv_clear_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fave_clear_filter"
            app:buttonAppearance="accent"
            app:buttonMode="tertiary"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:id="@+id/tv_action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"/>
    </LinearLayout>
</FrameLayout>
