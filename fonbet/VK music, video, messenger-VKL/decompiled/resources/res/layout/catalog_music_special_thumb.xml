<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/music_recommended_album_shadow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.music.view.ThumbsImageView
        android:layout_gravity="center"
        android:layout_width="@dimen/music_special_size"
        android:layout_height="@dimen/music_special_size"
        app:roundedCornerRadius="@dimen/music_corner_radius"
        app:tiv_background_image="?attr/vk_ui_background_modal"
        app:tiv_empty_resource="@drawable/vk_icon_playlist_outline_28"
        app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"
        app:tiv_placeholder_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
</FrameLayout>
