<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shops_clips_grid_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/top_left_clip_item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vk_ui_spacing_size4_xl"
        android:layout_marginStart="@dimen/vk_ui_spacing_size2_xl"
        app:layout_constraintBottom_toTopOf="@+id/bottom_left_clip_item"
        app:layout_constraintEnd_toStartOf="@+id/top_right_clip_item"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1"
        layout="@layout/fullscreen_clips_grid_block_item"/>
    <include
        android:id="@+id/top_right_clip_item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vk_ui_spacing_size4_xl"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size2_xl"
        app:layout_constraintBottom_toTopOf="@+id/bottom_right_clip_item"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/top_left_clip_item"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1"
        layout="@layout/fullscreen_clips_grid_block_item"/>
    <include
        android:id="@+id/bottom_left_clip_item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
        android:layout_marginStart="@dimen/vk_ui_spacing_size2_xl"
        app:layout_constraintBottom_toTopOf="@+id/other_clips_button"
        app:layout_constraintEnd_toStartOf="@+id/bottom_right_clip_item"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_left_clip_item"
        app:layout_constraintVertical_weight="1"
        app:layout_goneMarginBottom="@dimen/vk_ui_spacing_size3_xl"
        layout="@layout/fullscreen_clips_grid_block_item"/>
    <include
        android:id="@+id/bottom_right_clip_item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vk_ui_spacing_size_m"
        android:layout_marginStart="@dimen/vk_ui_spacing_size_m"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size2_xl"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_left_clip_item"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/bottom_left_clip_item"
        app:layout_constraintTop_toBottomOf="@+id/top_right_clip_item"
        app:layout_constraintVertical_weight="1"
        layout="@layout/fullscreen_clips_grid_block_item"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/other_clips_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vk_ui_spacing_size2_xl"
        android:layout_marginEnd="@dimen/vk_ui_spacing_size2_xl"
        android:layout_marginVertical="@dimen/vk_ui_spacing_size3_xl"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_refresh_outline_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_left_clip_item"/>
</androidx.constraintlayout.widget.ConstraintLayout>
