<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/catalog_video_playlist_item"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/highlight"
    android:paddingStart="16dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/playlist_preview_bg"
        android:visibility="gone"
        android:layout_width="@dimen/video_catalog_playlist_item_width"
        android:layout_height="@dimen/video_catalog_playlist_item_height"
        android:foreground="@drawable/catalog_bg_video_playlist_cover_item"
        android:layout_marginEnd="12dp"
        app:actualImageScaleType="centerCrop"
        app:emptyImagePlaceholder="@drawable/catalog_album_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="8dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/playlist_preview"
        android:layout_width="@dimen/video_catalog_playlist_item_width"
        android:layout_height="@dimen/video_catalog_playlist_item_height"
        android:foreground="@drawable/catalog_playlist_label_without_image"
        android:foregroundGravity="center"
        android:layout_marginEnd="12dp"
        app:emptyImagePlaceholder="@drawable/catalog_album_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="8dp"
        app:roundingBorderColor="?attr/vk_ui_image_border_alpha"
        app:roundingBorderWidth="0.5dp"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/playlist_vo_overlay"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="@drawable/catalog_album_label_without_image"
        android:foregroundGravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/playlist_preview"
        app:layout_constraintEnd_toEndOf="@+id/playlist_preview"
        app:layout_constraintStart_toStartOf="@+id/playlist_preview"
        app:layout_constraintTop_toTopOf="@+id/playlist_preview"
        app:vov_corner_radius="8dp"
        app:vov_size="small"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/playlist_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/playlist_update_information"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/playlist_preview"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="16dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/playlist_update_information"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playlist_preview"
        app:layout_constraintTop_toBottomOf="@+id/playlist_title"
        app:layout_goneMarginEnd="16dp"/>
    <ImageView
        android:id="@+id/playlist_icon_play"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/vk_icon_list_play_outline_20"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="@+id/playlist_preview"
        app:layout_constraintTop_toTopOf="@+id/playlist_preview"
        app:tint="@color/vk_white"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteMedium"
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/video_count"
        android:layout_width="35dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/playlist_icon_play"
        app:layout_constraintStart_toStartOf="@+id/playlist_icon_play"
        app:layout_constraintTop_toBottomOf="@+id/playlist_icon_play"/>
</androidx.constraintlayout.widget.ConstraintLayout>
