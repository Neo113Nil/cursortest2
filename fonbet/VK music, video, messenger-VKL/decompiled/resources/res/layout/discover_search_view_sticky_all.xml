<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:background="?attr/vk_ui_header_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/VKAppBar">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:layout_marginEnd="8dp">
            <com.vk.core.view.components.search.VkSearchView
                android:id="@+id/search_view"
                android:layout_width="0dp"
                android:layout_height="?attr/actionBarSize"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/search_qr"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/vk_icon_scan_viewfinder_outline_28"
                app:tint="?attr/vk_ui_icon_accent_themed"/>
        </LinearLayout>
        <com.vk.search.ui.impl.widget.FirstFixedTabsLayout
            android:theme="@style/SearchTabBarThemeOverlay"
            android:layout_gravity="center_horizontal"
            android:id="@+id/first_fixed_tabs"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            style="?attr/tabBarTheme"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/shadow"
        app:vk_appbar_allowSeparator="false"
        style="@style/AppBarShadow"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
