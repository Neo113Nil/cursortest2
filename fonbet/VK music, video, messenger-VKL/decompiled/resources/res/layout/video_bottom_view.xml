<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/bottom_panel"
    android:background="@color/vk_black"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <one.video.ad.ux.AdRedirectView
        android:id="@+id/redirect_button"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.links.LinkedTextView
        android:textColor="@color/vk_white"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/redirect_button"
        style="@style/VkUiTypography.Paragraph"/>
    <TextView
        android:textColor="@color/vk_white_alpha40"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:textColor="@color/vk_white_alpha40"
        android:id="@+id/archival_content"
        android:paddingTop="2dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/archival_content_title"
        app:layout_constraintEnd_toEndOf="@+id/subtitle"
        app:layout_constraintStart_toStartOf="@+id/subtitle"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        style="@style/VkUiTypography.Footnote"/>
    <ImageView
        android:id="@+id/info"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="@drawable/white_ripple_circle"
        android:contentDescription="@string/video_about_accessibility"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/redirect_button"
        app:srcCompat="@drawable/vk_icon_chevron_down_24"
        app:tint="@color/vk_white_alpha40"/>
    <com.vk.libvideo.design.view.buttons.EpisodeButton
        android:id="@+id/episode"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:force_on_dark_styling="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/archival_content"/>
    <View
        android:id="@+id/divider"
        android:background="@color/vk_white_alpha20"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/episode"/>
    <com.vk.libvideo.ui.VideoBottomBarView
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_below="@+id/divider"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <ViewStub
        android:id="@+id/user_profile_stub"
        android:layout="@layout/video_user_profile"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
</merge>
