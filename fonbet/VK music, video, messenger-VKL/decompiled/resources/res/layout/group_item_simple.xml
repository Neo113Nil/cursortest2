<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="@drawable/rounded_list_selector"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/photo"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        app:emptyImagePlaceholder="@drawable/group_placeholder"
        app:placeholderImage="@drawable/user_placeholder"
        app:placeholderImageScaleType="fitXY"
        style="@style/UserSmallPhoto"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.HeadlineNormal.Unscaled"
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="marquee"
        android:id="@+id/title"
        android:duplicateParentState="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:singleLine="true"
        android:drawablePadding="10dp"
        android:layout_toRightOf="@+id/photo"
        android:layout_alignParentTop="false"
        android:layout_alignWithParentIfMissing="false"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_toRightOf="@+id/photo"
        android:layout_below="@+id/title"
        android:layout_alignWithParentIfMissing="true"/>
</RelativeLayout>
