<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:maxWidth="500dp">
        <com.vk.core.view.components.picture.VkImageSimple
            android:layout_gravity="center_horizontal"
            android:id="@+id/liveErrorIcon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:tint="@color/vk_white"/>
        <com.vk.core.view.components.text.VkText
            android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
            android:textColor="@color/vk_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/liveErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:elevation="@dimen/vk_ui_elevation_two"/>
        <com.vk.core.view.components.button.VkSimpleButton
            android:textColor="@color/vk_black"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/liveErrorButton"
            android:background="@drawable/bg_round_corner_button"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="3dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="?attr/appkitRetryButtonText"/>
    </LinearLayout>
</merge>
