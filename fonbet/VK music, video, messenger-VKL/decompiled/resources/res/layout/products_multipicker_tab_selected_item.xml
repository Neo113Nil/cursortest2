<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.avatar.VkAvatar
        android:id="@+id/group_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:drawablePadding="9dp"
        android:textAlignment="textStart"
        android:layout_marginStart="6dp"
        app:drawableEndCompat="@drawable/vk_icon_dropdown_outline_16"
        app:drawableTint="?attr/vk_ui_icon_medium"
        style="@style/VkUiTypography.Headline2Medium"/>
</LinearLayout>
