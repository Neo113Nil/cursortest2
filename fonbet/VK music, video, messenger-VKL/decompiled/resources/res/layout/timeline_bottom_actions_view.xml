<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/vk_black">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timeline_actions_list"
        android:fadingEdgeLength="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="horizontal"
        android:paddingStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/timeline_accept"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/timeline_accept"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clips_editor_next"
        android:contentDescription="@string/clips_editor_next"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="14dp"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
