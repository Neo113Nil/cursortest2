<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_show_all"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.Text"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/badge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        style="@style/TextStyle"/>
    <com.vk.core.view.components.text.VkText
        android:textSize="14sp"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/badge"
        android:background="@drawable/catalog_header_badge_prominent"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/show_all_btn"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_min="20dp"/>
    <TextView
        android:textColor="?attr/vk_ui_text_accent"
        android:id="@+id/show_all_btn"
        android:background="@drawable/music_playlist_selectable_bg_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="20dp"
        android:text="@string/catalog_button_show_all"
        android:maxLines="1"
        android:fontFamily="@font/vk_roboto_regular"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkUiTypography.ParagraphNormal"/>
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/options"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/common_actions"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vk_icon_more_vertical_16"
        app:tint="?attr/vk_ui_icon_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
