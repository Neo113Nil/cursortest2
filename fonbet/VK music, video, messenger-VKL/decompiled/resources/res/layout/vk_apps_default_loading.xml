<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:indeterminate="true"
        android:progressTint="?attr/vk_ui_icon_tertiary"
        app:layout_constraintBottom_toTopOf="@+id/apps_app_info_vk_connect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/vk_ui_text_title_color"
        android:gravity="center_vertical"
        android:id="@+id/show_console"
        android:background="@drawable/vk_bg_show_console_ripple"
        android:padding="15dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/vk_show_debug_console"
        android:drawablePadding="15dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:drawableStartCompat="@drawable/vk_icon_brackets_square_outline_28"
        app:drawableTint="?attr/vk_ui_text_accent"
        app:layout_constraintBottom_toTopOf="@+id/apps_app_info_vk_connect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VkUiTypography.DisplayTitle4Normal"/>
    <include
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/apps_app_info_vk_connect"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/vk_apps_vk_connect"/>
</androidx.constraintlayout.widget.ConstraintLayout>
