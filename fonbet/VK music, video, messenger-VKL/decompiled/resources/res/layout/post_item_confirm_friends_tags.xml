<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/post_side_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/post_side_padding"
    android:paddingEnd="@dimen/post_side_padding">
    <View
        android:id="@+id/confirm_tags_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/confirm_tags_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/profile_many_tags_title"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/confirm_tags_image"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:id="@+id/confirm_tags_show_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/photo_tags_show_all_tags"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:buttonAppearance="accent"
        app:buttonMode="primary"
        app:buttonSizeType="medium"
        app:layout_constraintStart_toEndOf="@+id/confirm_tags_image"
        app:layout_constraintTop_toBottomOf="@+id/confirm_tags_title"/>
    <View
        android:background="?attr/vk_ui_separator_primary_alpha"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/post_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirm_tags_show_btn"
        style="@style/AppBarShadow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
