<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="64dp"
    android:layout_height="106dp"
    android:foreground="@drawable/mask_tab_bg">
    <ImageView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/mask_delete"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:contentDescription="@string/delete"
        android:layout_marginEnd="4dp"
        app:srcCompat="@drawable/vk_icon_delete_outline_24"
        app:tint="@color/vk_white"/>
    <View
        android:layout_gravity="start|bottom"
        android:id="@+id/view_background"
        android:background="@drawable/bg_stories_replied_card"
        android:layout_width="56dp"
        android:layout_height="56dp"/>
    <com.vk.imageloader.view.VKImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/iv_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:placeholderImage="@drawable/ic_stories_masks_placeholder_mask"
        app:placeholderImageScaleType="fitCenter"
        app:roundedCornerRadius="8dp"/>
    <View
        android:layout_gravity="start|bottom"
        android:id="@+id/view_selected_foreground"
        android:background="@drawable/bg_effect_border_3dp"
        android:layout_width="56dp"
        android:layout_height="56dp"/>
    <View
        android:layout_gravity="end|bottom"
        android:id="@+id/view_unsupported"
        android:background="@drawable/ic_stories_masks_unsupported"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginBottom="3dp"
        android:layout_marginEnd="11dp"/>
    <View
        android:layout_gravity="start|bottom"
        android:id="@+id/view_intrigue"
        android:background="@drawable/vk_icon_deprecated_ic_stories_masks_intrigue"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"/>
    <View
        android:layout_gravity="bottom|right"
        android:id="@+id/view_new"
        android:background="@drawable/bg_masks_new_badge"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginBottom="46dp"
        android:layout_marginEnd="12dp"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption2Medium"
        android:textColor="@color/vk_white"
        android:gravity="top|center_horizontal"
        android:layout_gravity="end|bottom"
        android:id="@+id/view_3d"
        android:background="@drawable/effect_3d"
        android:layout_width="24dp"
        android:layout_height="16dp"
        android:layout_marginBottom="36dp"
        android:text="3D"
        android:layout_marginEnd="4dp"/>
    <View
        android:layout_gravity="end|bottom"
        android:id="@+id/mask_favorite"
        android:background="@drawable/vk_icon_star_badge_36"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="8dp"/>
</FrameLayout>
