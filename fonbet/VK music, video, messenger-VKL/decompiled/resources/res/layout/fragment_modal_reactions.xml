<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appkit_loader_root"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/touch_outside"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:soundEffectsEnabled="false"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/design_bottom_sheet"
        android:focusable="true"
        android:fitsSystemWindows="true"
        android:clickable="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/bottom_sheet_content_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/app_bar_layout"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="0dp"
                app:elevation="0dp"
                style="@style/VKAppBar">
                <FrameLayout
                    android:layout_gravity="top"
                    android:id="@+id/reactions_modal_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp">
                    <ImageView
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/reactions_modal_close"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="center"
                        android:contentDescription="@string/close"
                        android:layout_marginStart="4dp"
                        app:srcCompat="@drawable/vk_icon_cancel_outline_28"
                        app:tint="?attr/vk_ui_icon_accent_themed"/>
                    <TextView
                        android:textAppearance="@style/VkUiTypography.SubheadSemiBold"
                        android:textColor="?attr/vk_ui_text_primary"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/reactions_modal_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:maxLines="1"
                        android:textAlignment="gravity"
                        android:layout_marginStart="64dp"
                        android:layout_marginEnd="14dp"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/reactions_items"
                    android:layout_width="match_parent"
                    android:layout_height="106dp"
                    android:importantForAccessibility="no"
                    app:layout_scrollFlags="snap|enterAlways|scroll">
                    <View
                        android:id="@+id/reactions_divider"
                        android:background="?attr/vk_ui_separator_primary"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                    <HorizontalScrollView
                        android:layout_gravity="center_horizontal"
                        android:scrollbars="none"
                        android:layout_width="wrap_content"
                        android:layout_height="106dp"
                        android:importantForAccessibility="no">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/reactions_selector"
                            android:layout_width="wrap_content"
                            android:layout_height="106dp"
                            android:importantForAccessibility="no"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"/>
                    </HorizontalScrollView>
                </FrameLayout>
                <com.vk.core.view.VKTabLayout
                    android:id="@+id/tabs"
                    android:background="?attr/vk_ui_background_content"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:textAllCaps="false"
                    app:layout_scrollFlags="noScroll"
                    app:tabGravity="start"
                    app:tabIndicator="?attr/tabBarIndicator"
                    app:tabMaxWidth="0dp"
                    app:tabPaddingEnd="0dp"
                    app:tabPaddingStart="0dp"
                    app:tabSelectedTextColor="?attr/vk_ui_text_primary"
                    app:tabTextAppearance="@style/TabBarTheme.TabTextAppearance"
                    app:tabTextColor="?attr/vk_ui_text_secondary"/>
            </com.google.android.material.appbar.AppBarLayout>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/reactions_modal_container"
                android:background="?attr/vk_ui_background_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/vk_toolbar_behavior_scrolling">
                <com.vk.core.view.disableable.DisableableViewPager
                    android:id="@+id/viewpager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/error_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textColor="@color/vk_ui_text_title_color"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/error_text"
                        android:paddingLeft="32dp"
                        android:paddingRight="32dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/liblists_err_text"
                        android:freezesText="true"
                        style="@style/VkUiTypography.Text"/>
                    <com.vk.core.view.components.button.VkSimpleButton
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/error_button"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/liblists_retry"
                        app:buttonAppearance="accent"
                        app:buttonMode="tertiary"
                        app:buttonSizeType="small"/>
                </LinearLayout>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/progress"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="?attr/vk_ui_icon_tertiary"
                    android:indeterminateTintMode="src_in"/>
            </FrameLayout>
            <com.vk.core.view.AppBarShadowView
                android:id="@+id/shadow_view"
                style="@style/AppBarShadow"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
