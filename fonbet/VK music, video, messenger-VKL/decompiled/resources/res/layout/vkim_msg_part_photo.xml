<?xml version="1.0" encoding="utf-8"?>
<com.vk.im.ui.views.BlurredFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.RestrictionVKEnhancedImageView
        android:layout_gravity="center"
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/vkim_accessibility_photo"/>
    <com.vk.core.view.ProgressView
        android:layout_gravity="center"
        android:id="@+id/upload"
        style="@style/VkIm.MsgPart.UploadIndicator.Default"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextContrast"
        android:layout_gravity="bottom|right"
        android:id="@+id/timeAndStatus"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:importantForAccessibility="no"/>
</com.vk.im.ui.views.BlurredFrameLayout>
