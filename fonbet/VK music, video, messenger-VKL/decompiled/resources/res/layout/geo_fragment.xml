<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/geo_fragment_root_layout"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:id="@+id/geo_map_zoom_controls_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_sheet_content_default_margin">
        <ImageButton
            android:id="@+id/geo_map_zoom_in_button"
            android:background="@drawable/geo_zoom_in_background"
            android:layout_width="@dimen/geo_map_controls_size"
            android:layout_height="@dimen/geo_map_controls_size"
            android:contentDescription="@string/geo_zoom_in"
            android:elevation="3dp"
            app:srcCompat="@drawable/vk_icon_add_16"
            app:tint="?attr/vk_ui_icon_primary"/>
        <ImageButton
            android:id="@+id/geo_map_zoom_out_button"
            android:background="@drawable/geo_zoom_out_background"
            android:layout_width="@dimen/geo_map_controls_size"
            android:layout_height="@dimen/geo_map_controls_size"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/geo_zoom_out"
            android:elevation="3dp"
            app:srcCompat="@drawable/vk_icon_minus_16"
            app:tint="?attr/vk_ui_icon_primary"/>
    </LinearLayout>
    <ImageButton
        android:layout_gravity="end|bottom"
        android:id="@+id/geo_map_my_location_button"
        android:background="@drawable/geo_circle_ripple_background"
        android:layout_width="@dimen/geo_map_controls_size"
        android:layout_height="@dimen/geo_map_controls_size"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/geo_my_location_granted"
        android:layout_marginEnd="@dimen/item_sheet_content_default_margin"
        android:elevation="3dp"
        app:srcCompat="@drawable/vk_icon_location_outline_28"
        app:tint="?attr/vk_ui_icon_primary"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
