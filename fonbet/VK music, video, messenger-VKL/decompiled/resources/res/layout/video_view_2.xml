<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vk.libvideo.tool.view.ViewDrawCacherLayout
        android:id="@+id/display_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.libvideo.design.view.videotexture.VideoTextureView
            android:id="@+id/display_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.vk.libvideo.design.view.preview.PreviewImageView
            android:id="@+id/cover_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:transformPivotX="0dp"
            android:transformPivotY="0dp"/>
    </com.vk.libvideo.tool.view.ViewDrawCacherLayout>
    <com.vk.media.player.subtitles.NoStyleSubtitleView
        android:id="@+id/subtitles_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"/>
    <one.video.controls20.SimpleControlsView
        android:id="@+id/controls_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.donut.design.view.badge.DonutBadge
        android:layout_gravity="start|bottom"
        android:id="@+id/donut_chip_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"/>
    <com.vk.libvideo.design.view.ad.VideoAdLayout
        android:id="@+id/ad_controls_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.libvideo.design.view.overlay.VideoOverlayView
        android:id="@+id/overlay_view"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:vov_force_redesign="true"
        app:vov_mode="dark"
        app:vov_size="undefined"/>
</merge>
