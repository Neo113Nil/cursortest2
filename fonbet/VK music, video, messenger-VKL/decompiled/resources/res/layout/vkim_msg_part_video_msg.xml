<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.vk.im.ui.views.StencilLayout
        android:id="@+id/video_display_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.vk.libvideo.design.view.videotexture.VideoTextureView
            android:id="@+id/video_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/vkim_accessibility_video"/>
        <com.vk.core.view.fresco.FrescoImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/vkim_accessibility_video"
            app:vkim_scaleType="center_crop_upscale"/>
        <View
            android:id="@+id/selection_mask"
            android:background="@color/vkim_msg_part_selection_mask"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"/>
    </com.vk.im.ui.views.StencilLayout>
    <ImageView
        android:id="@+id/sound_control"
        android:background="@drawable/bg_black_alpha35_circle"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/vk_icon_muted_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/vk_white"/>
    <ImageView
        android:id="@+id/play"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_attachment_video_play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.ProgressView
        android:layout_gravity="center"
        android:id="@+id/upload"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkIm.MsgPart.UploadIndicator.Default"/>
    <com.vk.core.view.ProgressView
        android:layout_gravity="center"
        android:id="@+id/buffering"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VkIm.MsgPart.UploadIndicator.Default"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/duration_holder"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.vk.libvideo.design.view.duration.DurationView
            android:layout_gravity="center_vertical"
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/was_not_played"
            android:visibility="gone"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:src="@drawable/white_oval"
            android:layout_marginStart="6dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/audio_visualizer"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="8dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextContrast"
        android:id="@+id/timeAndStatus"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.vk.im.ui.views.msg.MsgTranscriptButton
        android:id="@+id/btn_transcription"
        android:layout_width="38dp"
        android:layout_height="26dp"
        android:tint="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:mtb_background_tint="@color/vkim_msg_part_time_contrast_bg"
        app:mtb_hide_transcript_icon="@drawable/vkim_icon_transcript_hide"
        app:mtb_show_transcript_icon="@drawable/vkim_icon_transcript_show"/>
    <com.vk.libvideo.design.view.error.VideoErrorView
        android:gravity="center"
        android:id="@+id/error_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
