<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/posting_counter_stack_item_size"
    android:paddingHorizontal="16dp"
    app:layout_constraintTop_toBottomOf="@+id/posting_visibility_second_settings_group">
    <com.vk.core.view.PhotoStackView
        android:id="@+id/posting_visibility_counter_stack_images"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/posting_visibility_second_settings_group"/>
    <com.vk.core.view.TintTextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/posting_visibility_counter_stack_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@+id/posting_visibility_second_settings_group"
        style="@style/VkUiTypography.Footnote"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/posting_visibility_counter_stack_dropdown_image"
        android:paddingTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:srcCompat="@drawable/vk_icon_dropdown_16"
        app:tint="?attr/vk_ui_icon_secondary"/>
</androidx.appcompat.widget.LinearLayoutCompat>
