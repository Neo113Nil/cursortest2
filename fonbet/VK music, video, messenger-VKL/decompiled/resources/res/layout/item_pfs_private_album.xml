<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/photo"
        android:background="@drawable/bg_album_placeholder"
        android:layout_width="64dp"
        android:layout_height="48dp"
        android:contentDescription="@string/accessibility_album"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="?attr/vk_ui_text_primary"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="1sp"
            android:translationY="-0.62sp"
            android:fontFamily="@font/vk_roboto_regular"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:letterSpacing="-0.0001"
            app:lineHeight="20sp"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/VkLegacyTypography.FootnoteAppearance"
            android:textColor="?attr/vk_ui_text_secondary"
            android:id="@+id/privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/vk_icon_lock_12"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:drawableTint="?attr/vk_legacy_icon_tertiary"
            app:lineHeight="16sp"
            style="@style/FootnoteStyle"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_chevron_compact_right_24"
        android:contentDescription="@null"
        app:tint="?attr/vk_legacy_icon_tertiary"/>
    <FrameLayout
        android:layout_gravity="end|top"
        android:id="@+id/checkbox_area"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:elevation="4dp">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:layout_gravity="end|center_vertical"
            android:id="@+id/checkbox_photo"
            android:clickable="false"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:drawableTint="?attr/vk_ui_icon_accent"
            style="@style/CircleCheckBox"/>
    </FrameLayout>
</LinearLayout>
