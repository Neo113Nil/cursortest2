<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/music_attach_top_down_gradient"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/vkim_msg_part_playlist_min_width">
    <View
        android:id="@+id/dominant_color"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:alpha="0.3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/lowest_thumb"
        android:layout_width="@dimen/vkim_msg_part_playlist_lowest_thumb_size"
        android:layout_height="@dimen/vkim_msg_part_playlist_lowest_thumb_size"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="3dp"
        app:tiv_background_image="?attr/vk_legacy_placeholder_icon_background"
        app:tiv_border_width="0.5dp"
        app:tiv_empty_resource="@drawable/vk_icon_playlist_outline_56"
        app:tiv_empty_tint="?attr/vk_legacy_placeholder_icon_foreground_secondary"/>
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/middle_thumb"
        android:layout_width="@dimen/vkim_msg_part_playlist_middle_thumb_size"
        android:layout_height="@dimen/vkim_msg_part_playlist_middle_thumb_size"
        android:layout_marginTop="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lowest_thumb"
        app:roundedCornerRadius="3dp"
        app:tiv_background_image="?attr/vk_legacy_placeholder_icon_background"
        app:tiv_border_width="0.5dp"/>
    <com.vk.music.view.ThumbsImageView
        android:id="@+id/highest_thumb"
        android:layout_width="@dimen/vkim_msg_part_playlist_highest_thumb_size"
        android:layout_height="@dimen/vkim_msg_part_playlist_highest_thumb_size"
        android:layout_marginTop="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/middle_thumb"
        app:roundedCornerRadius="4.5dp"
        app:tiv_background_image="?attr/vk_legacy_placeholder_icon_background"
        app:tiv_border_width="0.5dp"/>
    <TextView
        android:textSize="@dimen/vkim_msg_part_playlist_name_text_size"
        android:textColor="?attr/vk_legacy_text_primary"
        android:ellipsize="end"
        android:id="@+id/playlist_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxWidth="@dimen/vkim_msg_part_playlist_name_max_width"
        android:maxLines="2"
        android:fontFamily="@font/vk_sans_display_demibold"
        android:textAlignment="center"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/highest_thumb"/>
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/owner_avatar"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/owner_name"
        app:layout_constraintEnd_toStartOf="@+id/owner_name"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/owner_name"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:ellipsize="marquee"
        android:id="@+id/owner_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxWidth="@dimen/vkim_msg_part_playlist_artist_name_max_width"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/owner_avatar"
        app:layout_constraintTop_toBottomOf="@+id/playlist_name"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_secondary"
        android:ellipsize="end"
        android:id="@+id/playlist_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/owner_name"/>
    <View
        android:id="@+id/play_button_wrapper"
        android:background="@drawable/bg_msg_part_playlist_shuffle_btn"
        android:layout_width="122dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toStartOf="@+id/shuffle_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_info"/>
    <ImageView
        android:id="@+id/play_button_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vk_icon_play_24"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/play_button_wrapper"
        app:layout_constraintEnd_toStartOf="@+id/play_button_text"
        app:layout_constraintHorizontal_bias="0.4"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/play_button_wrapper"
        app:layout_constraintTop_toTopOf="@+id/play_button_wrapper"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/vk_black"
        android:gravity="center"
        android:id="@+id/play_button_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/vkim_msg_music_attach_listen"
        app:layout_constraintBottom_toBottomOf="@+id/play_button_wrapper"
        app:layout_constraintEnd_toEndOf="@+id/play_button_wrapper"
        app:layout_constraintStart_toEndOf="@+id/play_button_icon"
        app:layout_constraintTop_toTopOf="@+id/play_button_wrapper"
        style="@style/VkLegacyTypography.Headline2"/>
    <ImageView
        android:id="@+id/shuffle_button"
        android:background="@drawable/bg_msg_part_playlist_shuffle_btn"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:src="@drawable/vk_icon_shuffle_outline_24"
        android:contentDescription="@string/vkim_accessibility_icon_shuffle"
        android:layout_marginStart="@dimen/vkim_msg_part_playlist_btn_space"
        android:paddingHorizontal="@dimen/vkim_msg_part_playlist_shuffle_btn_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/play_button_wrapper"
        app:layout_constraintTop_toTopOf="@+id/play_button_wrapper"/>
    <include
        android:id="@+id/first_track"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/play_button_wrapper"
        layout="@layout/vkim_msg_part_playlist_track"/>
    <include
        android:id="@+id/second_track"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/first_track"
        layout="@layout/vkim_msg_part_playlist_track"/>
    <include
        android:id="@+id/third_track"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/second_track"
        layout="@layout/vkim_msg_part_playlist_track"/>
    <com.vk.im.ui.views.msg.TimeAndStatusView
        android:textAppearance="@style/VkIm.MsgPart.Time.TextSimple"
        android:id="@+id/time_and_status"
        android:background="?attr/im_msg_part_time_contrast_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vkim_msg_part_playlist_time_margin_top"
        android:layout_marginBottom="3dp"
        android:importantForAccessibility="noHideDescendants"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/third_track"/>
</androidx.constraintlayout.widget.ConstraintLayout>
