<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearLayout"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/vkim_chat_settings_toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/vkim_chat_profile_chat_settings__toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/im_ic_cancel"
            app:title="@string/vkim_chat_profile_chat_settings"
            style="@style/VkIm.Toolbar.Style.LargeWithBack"/>
        <com.vk.core.view.components.topbar.VkTopBar
            android:id="@+id/vkim_chat_profile_chat_settings_topbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="snap|enterAlways|scroll"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vkim_chat_profile_chat_settings__rv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vkim_chat_settings_toolbar_container"/>
    <com.vk.core.view.AppBarShadowView
        android:id="@+id/vkim_chat_profile_chat_settings__shadow"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vkim_chat_settings_toolbar_container"
        app:vk_appbar_forceMode="shadow"
        style="@style/AppBarShadow"/>
    <com.vk.core.ui.CircularProgressView
        android:id="@+id/vkim_chat_profile_chat_settings__progress"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="50dp"
        app:cpv_animAutostart="true"
        app:cpv_color="?attr/vk_ui_text_accent"
        app:cpv_indeterminate="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vkim_chat_settings_toolbar_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
