<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_gradient"
        android:background="@drawable/vk_scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:backgroundTint="?attr/vk_ui_background_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.vk.vas.design.view.VKStickerPackView
        android:id="@+id/pack_view"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/pack_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pack_view"
        app:layout_constraintTop_toTopOf="@+id/pack_view"
        style="?attr/vk_ui_typography_title2_medium"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/pack_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/pack_view"
        app:layout_constraintTop_toBottomOf="@+id/pack_title"
        style="?attr/vk_ui_typography_headline2_normal"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/subscription_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_notification_check_outline_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/pack_view"
        app:layout_constraintTop_toBottomOf="@+id/pack_author"
        app:text="@string/stickers_subscribe_author"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="subscription_button,pack_view"/>
    <com.vk.core.view.components.text.VkText
        android:textColor="?attr/vk_ui_text_primary"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/description_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier"
        style="?attr/vk_ui_typography_text_normal"/>
    <Space
        android:id="@+id/button_spacer"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        app:layout_constraintTop_toBottomOf="@+id/description"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/description_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="button_spacer"/>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/wish_list_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp"
        app:buttonAppearance="accent"
        app:buttonMode="outline"
        app:buttonSizeType="medium"
        app:icon="@drawable/vk_icon_list_like_outline_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_barrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
