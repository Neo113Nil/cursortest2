<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/error_layout"
    android:background="?attr/vk_ui_background_content"
    android:padding="32dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/vk_catalog_network_error_description"
        app:srcCompat="@drawable/vk_icon_wifi_outline_56"
        app:tint="?attr/vk_ui_icon_secondary"/>
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vk_catalog_network_error_title"
        app:fontFamily="@font/vk_roboto_medium"
        style="@style/VkLegacyTypography.Title2"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/error_text"
        android:paddingBottom="1sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vk_catalog_network_error_description"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1sp"
        android:letterSpacing="0.01"
        app:fontFamily="@font/vk_roboto_regular"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:layout_gravity="center_horizontal"
        android:id="@+id/error_retry"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="24dp"
        android:text="@string/vk_common_retry"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:fontFamily="@font/vk_roboto_medium"
        style="@style/VkLegacyButton.Tertiary"/>
</LinearLayout>
