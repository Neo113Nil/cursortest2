<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="yes">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/popup"
        android:background="@drawable/bg_dark_gray_rounded_top_12"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="480dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_ml_enhance_28"/>
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/editor_ml_enhance_help_title"
                style="@style/EditorTextTitle2"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btnWrapper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/paddingS"
                android:paddingEnd="@dimen/paddingS">
                <TextView
                    android:textColor="@color/editor_dark_text_subhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_ml_enhance_help_p1"
                    android:importantForAccessibility="yes"
                    style="@style/EditorTextSubtitle"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1">
                        <FrameLayout
                            android:background="@drawable/bg_editor_rounded_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToOutline="true">
                            <ImageView
                                android:id="@+id/pic2original"
                                android:background="@color/editor_gray"
                                android:layout_width="match_parent"
                                android:layout_height="196dp"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/editor_ml_enhance_accessibility_photo_before"
                                android:importantForAccessibility="yes"/>
                        </FrameLayout>
                        <TextView
                            android:textColor="@color/editor_text_tertiary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/editor_ml_enhance_help_before"
                            style="@style/EditorTextCaption2"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:background="@drawable/bg_editor_rounded_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToOutline="true">
                            <ImageView
                                android:id="@+id/pic2enhanced"
                                android:background="@color/editor_gray"
                                android:layout_width="match_parent"
                                android:layout_height="196dp"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/editor_ml_enhance_accessibility_photo_after"
                                android:importantForAccessibility="yes"/>
                        </LinearLayout>
                        <TextView
                            android:textColor="@color/editor_text_tertiary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/editor_ml_enhance_help_after"
                            style="@style/EditorTextCaption2"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textColor="@color/editor_dark_text_subhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/editor_ml_enhance_help_p2"
                    android:importantForAccessibility="yes"
                    style="@style/EditorTextSubtitle"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="2dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:background="@drawable/bg_editor_rounded_4_left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToOutline="true">
                            <ImageView
                                android:id="@+id/pic1original"
                                android:background="@color/editor_gray"
                                android:layout_width="match_parent"
                                android:layout_height="196dp"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/editor_ml_enhance_accessibility_photo_before"
                                android:importantForAccessibility="yes"/>
                        </LinearLayout>
                        <TextView
                            android:textColor="@color/editor_text_tertiary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/editor_ml_enhance_help_before"
                            style="@style/EditorTextCaption2"/>
                    </LinearLayout>
                    <View
                        android:background="#fff"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="14dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="2dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:background="@drawable/bg_editor_rounded_4_right"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToOutline="true">
                            <ImageView
                                android:id="@+id/pic1enhanced"
                                android:background="@color/editor_gray"
                                android:layout_width="match_parent"
                                android:layout_height="196dp"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/editor_ml_enhance_accessibility_photo_after"
                                android:importantForAccessibility="yes"/>
                        </LinearLayout>
                        <TextView
                            android:textColor="@color/editor_text_tertiary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            android:layout_marginTop="4dp"
                            android:text="@string/editor_ml_enhance_help_after"
                            style="@style/EditorTextCaption2"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textColor="@color/editor_dark_text_subhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/editor_ml_enhance_help_p3"
                    android:importantForAccessibility="yes"
                    style="@style/EditorTextSubtitle"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:id="@+id/btnWrapper"
            android:paddingTop="@dimen/paddingXS"
            android:paddingBottom="@dimen/paddingXS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/paddingS"
            android:paddingEnd="@dimen/paddingS"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scroll">
            <Button
                android:id="@+id/btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/editor_ml_enhance_help_button"
                style="@style/EditorButton.SecondaryAccent"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
