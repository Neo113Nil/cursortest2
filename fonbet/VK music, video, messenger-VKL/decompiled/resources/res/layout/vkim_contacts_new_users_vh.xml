<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="176sp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <View
        android:background="@drawable/bg_contacts_permissions_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.im.ui.views.avatars.StackAvatarView
        android:layout_gravity="center_horizontal"
        android:id="@+id/vkim_avatars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:vkim_drawingOrder="usual"
        app:vkim_extraColor="?attr/vk_legacy_placeholder_icon_background"
        app:vkim_iconOffset="-8dp"
        app:vkim_iconSize="32dp"
        app:vkim_strokeColor="?attr/vk_legacy_background_content"
        app:vkim_strokeWidth="2dp"
        app:vkim_useExtraView="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/vk_legacy_text_primary"
        android:gravity="center"
        android:id="@+id/vkim_new_users_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:background="@drawable/bg_contacts_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/vk_legacy_button_muted_foreground"
            android:gravity="center"
            android:id="@+id/vkim_content"
            android:layout_width="wrap_content"
            android:layout_height="36sp"
            android:fontFamily="@string/font_family_medium"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/vkim_close_btn"
        android:padding="12dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="0dp"
        android:contentDescription="@string/vkim_accessibility_close"
        android:layout_marginEnd="0dp"
        app:srcCompat="@drawable/vk_icon_cancel_20"
        app:tint="?attr/vk_legacy_icon_secondary"/>
</FrameLayout>
