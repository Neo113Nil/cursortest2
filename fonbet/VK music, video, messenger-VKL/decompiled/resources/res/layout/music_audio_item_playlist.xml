<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/music_selectable_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/music_audio_item_playlist_image_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="@dimen/music_thumbs_offset">
        <com.vk.music.view.ThumbsImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/audio_image"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/music_track_image"
            android:layout_height="@dimen/music_track_image"
            app:roundedCornerRadius="@dimen/music_image_corners_6"
            app:tiv_background_image="?attr/vk_ui_image_placeholder"
            app:tiv_border_width="0.5dp"
            app:tiv_empty_resource="@drawable/vk_icon_song_outline_28"
            app:tiv_empty_tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
        <ImageView
            android:id="@+id/audio_playing_indicator"
            android:background="@drawable/music_dark_round_rect"
            android:visibility="gone"
            android:layout_width="@dimen/music_track_image"
            android:layout_height="@dimen/music_track_image"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textColor="?attr/vk_ui_text_muted"
            android:ellipsize="end"
            android:id="@+id/audio_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:maxLines="1"
            style="@style/VkUiTypography.TextNormal"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="end"
            android:id="@+id/audio_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:maxLines="1"
            style="@style/VkUiTypography.FootnoteNormal"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:ellipsize="none"
            android:id="@+id/audio_lyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:maxLines="1"
            style="@style/VkUiTypography.FootnoteNormal"/>
    </LinearLayout>
    <com.vk.music.design.view.download.DownloadingView
        android:layout_gravity="center_vertical"
        android:id="@+id/downloaded_state"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:downloaded_icon="@drawable/vk_icon_arrow_down_circle_16"
        app:downloading_tint="?attr/vk_ui_track_buffer"
        app:loading_width="2dp"
        app:show_not_loaded="false"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/audio_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:drawablePadding="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        style="@style/VkUiTypography.FootnoteNormal"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/audio_menu"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_actions_small_24"
        android:scaleType="center"
        android:contentDescription="@string/music_talkback_more"
        android:layout_marginEnd="4dp"
        style="@style/ActionButton.More"/>
</LinearLayout>
