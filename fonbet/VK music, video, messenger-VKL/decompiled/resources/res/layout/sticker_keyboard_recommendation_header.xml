<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="4dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.FootnoteCapsMedium"
        android:textStyle="normal"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/pack_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/action_button"
        android:background="@drawable/bg_recommendations_keybard_header_button"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/vk_ui_text_accent_themed"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/action_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/VkUiTypography.SubheadMedium"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/action_button_progress"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/vk_white"
            android:indeterminateTintMode="src_in"
            style="?android:attr/progressBarStyle"/>
    </FrameLayout>
</FrameLayout>
