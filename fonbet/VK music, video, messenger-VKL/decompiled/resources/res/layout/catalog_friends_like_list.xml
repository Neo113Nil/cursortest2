<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/background_catalog_friends_like_list"
    android:paddingTop="20dp"
    android:paddingBottom="16dp"
    android:clickable="true"
    android:layout_width="339dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="12dp"
    android:nestedScrollingEnabled="false">
    <com.vk.core.view.PhotoStackView
        android:layout_gravity="center_horizontal"
        android:id="@+id/catalog_friends_like_avatars"
        android:layout_width="wrap_content"
        android:layout_height="32dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Title3Medium"
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center"
        android:id="@+id/catalog_friends_like_title"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:gravity="center"
        android:id="@+id/catalog_friends_like_text"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/catalog_friends_like_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
</LinearLayout>
