<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerInside"
            android:contentDescription="@null"
            app:srcCompat="@drawable/vk_icon_pin_16"
            app:tint="?attr/vk_ui_icon_secondary"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">
            <com.vk.core.tool.view.FluidHorizontalLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vk.superapp.ui.FixTextView
                    android:textAppearance="@style/VkUiTypography.Caption1Medium"
                    android:textColor="?attr/vk_ui_vkontakte_color_im_text_name"
                    android:ellipsize="end"
                    android:layout_gravity="bottom"
                    android:id="@+id/content_sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textAppearance="@style/VkUiTypography.Caption1"
                    android:textColor="?attr/vk_ui_text_secondary"
                    android:layout_gravity="bottom"
                    android:id="@+id/content_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0.5sp"
                    android:singleLine="true"/>
            </com.vk.core.tool.view.FluidHorizontalLayout>
            <com.vk.superapp.ui.FixTextView
                android:textAppearance="@style/VkUiTypography.Paragraph"
                android:textColor="?attr/vk_ui_text_subhead"
                android:ellipsize="end"
                android:id="@+id/content_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:singleLine="true"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/content_hide"
            android:background="@drawable/vkim_ripple_dark_borderless"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/vkim_accessibility_hide_pinned_msg"
            app:srcCompat="@drawable/vk_icon_cancel_24"
            app:tint="?attr/vk_ui_icon_secondary"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/hidden_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vkim_pinned_msg_label_hidden_info"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"/>
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/hidden_detach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vkim_pinned_msg_label_hidden_unpin"
            style="@style/VkIm.Button.LabelBlue"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_subhead"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/loading_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vkim_loading"
        android:singleLine="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <LinearLayout
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/error_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textAppearance="@style/VkUiTypography.Subhead"
            android:textColor="?attr/vk_ui_text_subhead"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/error_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vkim_pinned_msg_label_error_retry"
            style="@style/VkIm.Button.LabelBlue"/>
    </LinearLayout>
</FrameLayout>
