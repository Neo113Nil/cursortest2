<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/reaction_buttons_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/reactions_grey_container"
        android:background="@drawable/bg_voip_reactions_container"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/reactions_hand_up"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/reactions_close"
            android:background="@drawable/bg_voip_reactions_cancel_button"
            android:contentDescription="@string/close"
            app:srcCompat="@drawable/ic_cancel_alt_24"
            app:tint="@color/vk_white"
            style="@style/VoipPrimaryButton.Reactions"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_vertical"
            android:id="@+id/reactions_recycler_view"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="2dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/reactions_hand_up"
        android:background="@drawable/bg_voip_reactions_hand_button"
        android:contentDescription="@string/voip_call_actions_hand_raise"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_hand_raised_28"
        app:tint="@color/vk_white"
        style="@style/VoipPrimaryButton.Reactions"/>
</androidx.constraintlayout.widget.ConstraintLayout>
