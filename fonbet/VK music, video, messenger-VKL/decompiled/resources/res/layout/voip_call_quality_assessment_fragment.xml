<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="32dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voip_call_quality_assessment_title"
        style="@style/VkLegacyTypography.Title1"/>
    <RatingBar
        android:id="@+id/rating_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="28dp"
        android:stepSize="1"
        android:progressTint="?attr/vk_ui_text_accent"
        android:progressBackgroundTint="?attr/vk_ui_icon_secondary"
        android:secondaryProgressTint="?attr/vk_ui_text_accent"
        style="@style/VoipRatingBar"/>
    <include layout="@layout/voip_call_quality_assessment_buttons"/>
</LinearLayout>
