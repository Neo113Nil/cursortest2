<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/vk_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/vk_apps_app_install_header"/>
    <ScrollView
        android:background="@drawable/vk_app_install_content_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="32dp"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="158dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/vk_apps_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vk_install_header_margin"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="@dimen/vk_install_horizontal_margin">
                <com.vk.core.ui.themes.VKReplacerView
                    android:id="@+id/vk_apps_install_game_image"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginRight="12dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.vk.core.view.components.text.VkText
                        android:textAppearance="@style/VkUiTypography.DisplayTitle2SemiBold"
                        android:textColor="?attr/vk_ui_text_primary"
                        android:id="@+id/vk_apps_install_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <com.vk.core.view.components.text.VkText
                        android:textAppearance="@style/VkUiTypography.Paragraph"
                        android:textColor="?attr/vk_ui_text_primary"
                        android:id="@+id/vk_apps_install_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"/>
                    <com.vk.core.view.components.userstack.VkUserStack
                        android:id="@+id/vk_apps_install_userstack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>
            <com.vk.core.view.components.divider.VkSeparator
                android:id="@+id/vk_apps_install_separator"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="@dimen/vk_install_horizontal_margin"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vk_apps_install_game_screenshots"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/accessibility_photo"/>
            <com.vk.core.view.components.text.expandable.VkExpandableText
                android:textAppearance="@style/VkUiTypography.Paragraph"
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/vk_apps_install_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="@dimen/vk_install_horizontal_margin"/>
            <com.vk.core.view.components.cell.VkCell
                android:id="@+id/vk_apps_install_dev_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/vk_install_dev_info_margin"/>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/vk_apps_app_install_footer"/>
</FrameLayout>
