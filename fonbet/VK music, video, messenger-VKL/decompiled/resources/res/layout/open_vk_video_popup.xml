<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:background="@drawable/bg_rounded_32"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_marginBottom="10dp"
    android:backgroundTint="?attr/vk_ui_background_accent_themed">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp">
        <TextView
            android:textColor="?attr/vk_ui_background_contrast_themed"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="240dp"
            android:text="@string/watch_in_vk_video"
            style="@style/VkUiTypography.Headline2"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            app:srcCompat="@drawable/vk_icon_cancel_16"
            app:tint="?attr/vk_ui_background_contrast_themed"/>
    </LinearLayout>
    <View
        android:layout_gravity="end"
        android:id="@+id/close_btn"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/close"/>
</FrameLayout>
