<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.core.view.components.formitem.VkFormField
        android:id="@+id/price_from_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <com.vk.core.view.components.formitem.VkInputSelect
            android:id="@+id/price_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/catalog_market_hint_price_from"
            android:maxLength="7"
            android:imeOptions="actionDone"
            app:inputSize="singleLine"
            style="@style/VkInput"/>
    </com.vk.core.view.components.formitem.VkFormField>
    <com.vk.core.view.components.formitem.VkFormField
        android:id="@+id/price_to_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:layout_marginEnd="16dp">
        <com.vk.core.view.components.formitem.VkInputSelect
            android:id="@+id/price_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/catalog_market_hint_price_to"
            android:maxLength="7"
            android:imeOptions="actionDone"
            app:inputSize="singleLine"
            style="@style/VkInput"/>
    </com.vk.core.view.components.formitem.VkFormField>
</LinearLayout>
