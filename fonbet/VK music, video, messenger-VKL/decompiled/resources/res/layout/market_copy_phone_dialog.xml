<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKCircleImageView
        android:layout_gravity="center"
        android:id="@+id/photo_image_view"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:id="@+id/phone_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        style="@style/VkLegacyTypography.Title2.Medium"/>
    <TextView
        android:id="@+id/owner_name_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="center"
        style="@style/VkLegacyTypography.Subhead.Regular"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/copy_phone_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minHeight="44dp"
        android:text="@string/market_copy_phone_button"
        style="@style/VkLegacyButton.Secondary"/>
</LinearLayout>
