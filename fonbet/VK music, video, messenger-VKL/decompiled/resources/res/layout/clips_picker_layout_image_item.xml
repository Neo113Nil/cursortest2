<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/picker_background_container"
        android:background="?attr/vk_ui_transparent_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.vk.attachpicker.widget.MediaStoreItemSmallView
        android:id="@+id/picker_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/picker_counter_container"
        android:layout_width="48dp"
        android:layout_height="48dp">
        <FrameLayout
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/vk_icon_circle_outline_shadow_40"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="@style/VkUiTypography.SubheadMedium"
                android:textColor="@color/vk_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/picker_counter_text"
                android:background="@drawable/picker_bg_accent_circle"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:autoSizeMaxTextSize="15dp"
                app:autoSizeMinTextSize="6dp"
                app:autoSizeStepGranularity="1dp"
                app:autoSizeTextType="uniform"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
