<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/vk_bottom_divider_bg"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:paddingStart="16dp">
    <TextView
        android:textAppearance="@style/VkUiTypography.HeadlineNormal"
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_gravity="top"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:layout_marginEnd="58dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Subhead"
        android:textColor="?attr/vk_ui_text_secondary"
        android:layout_gravity="bottom"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:layout_marginEnd="58dp"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/check"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="4dp"/>
</FrameLayout>
