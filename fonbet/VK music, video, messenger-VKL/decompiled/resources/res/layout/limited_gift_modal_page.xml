<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/modal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.imageloader.view.VKImageView
        android:id="@+id/limited_gift_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.stickers.views.particles.ParticleView
        android:id="@+id/background_stars_animation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="-10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/limited_gift_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="80dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="80dp"
        android:layout_marginBottom="20dp"
        android:scaleType="centerInside"
        android:maxWidth="220dp"
        android:minWidth="160dp"
        app:layout_constraintBottom_toTopOf="@+id/info_row"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/limited_gift_bg"
        app:layout_constraintStart_toStartOf="@+id/limited_gift_bg"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.vk.stickers.views.gift.AnimatedGiftView
        android:id="@+id/animated_gift"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="80dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="80dp"
        android:layout_marginBottom="20dp"
        android:scaleType="centerInside"
        android:maxWidth="220dp"
        android:minWidth="160dp"
        app:layout_constraintBottom_toTopOf="@+id/info_row"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/limited_gift_bg"
        app:layout_constraintStart_toStartOf="@+id/limited_gift_bg"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.vk.core.view.components.topbar.VkTopBar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="snap|enterAlways|scroll"/>
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/gift_rarity_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="@+id/toolbar"
        app:layout_constraintTop_toTopOf="@+id/toolbar"
        app:tint="?attr/vk_ui_icon_contrast"/>
    <com.vk.stickers.views.RLottieImageView
        android:id="@+id/secondary_animation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/info_row"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_gift_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:gravity="center"
            android:id="@+id/limited_gift_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/guideline_mid1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.Title2Medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:gravity="center"
            android:id="@+id/limited_gift_amount_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/limited_gift_amount"
            app:layout_constraintEnd_toStartOf="@+id/guideline_mid1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/limited_gift_amount"
            style="@style/VkUiTypography.Subhead"/>
        <TextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:gravity="center"
            android:id="@+id/limited_gift_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/guideline_mid2"
            app:layout_constraintStart_toStartOf="@+id/guideline_mid1"
            app:layout_constraintTop_toTopOf="@+id/limited_gift_amount"
            style="@style/VkUiTypography.Title2Medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:gravity="center"
            android:id="@+id/limited_gift_number_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/limited_gift_number"
            app:layout_constraintEnd_toEndOf="@+id/limited_gift_number"
            app:layout_constraintStart_toStartOf="@+id/limited_gift_number"
            app:layout_constraintTop_toBottomOf="@+id/limited_gift_number"
            style="@style/VkUiTypography.Subhead"/>
        <TextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:gravity="center"
            android:id="@+id/limited_gift_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guideline_mid2"
            app:layout_constraintTop_toTopOf="@+id/limited_gift_amount"
            style="@style/VkUiTypography.Title2Medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_contrast"
            android:gravity="center"
            android:id="@+id/limited_gift_year_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/limited_gift_year_of_issue"
            app:layout_constraintEnd_toEndOf="@+id/limited_gift_year"
            app:layout_constraintStart_toStartOf="@+id/limited_gift_year"
            app:layout_constraintTop_toBottomOf="@+id/limited_gift_year"
            style="@style/VkUiTypography.Subhead"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_mid1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.333"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_mid2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.666"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.core.view.components.button.VkButton
        android:id="@+id/btn_gift_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/limited_gift_send"
        app:buttonAppearance="overlay"
        app:buttonMode="primary"
        app:buttonSizeType="large"
        app:icon="@drawable/vk_icon_gift_24"
        app:iconPadding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
