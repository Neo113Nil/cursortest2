<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="?attr/vk_ui_text_subhead"
        android:id="@+id/unsubscribe_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        style="@style/VkUiTypography.Footnote"/>
    <TextView
        android:textColor="@color/vk_red"
        android:layout_gravity="center_vertical"
        android:id="@+id/unsubscribe_text"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/profile_unsubscribe"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        style="@style/VkUiTypography.Headline1Normal"/>
    <TextView
        android:textColor="?attr/vk_ui_text_primary"
        android:layout_gravity="center_vertical"
        android:id="@+id/cancel"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        style="@style/VkUiTypography.Headline1Normal"/>
</LinearLayout>
