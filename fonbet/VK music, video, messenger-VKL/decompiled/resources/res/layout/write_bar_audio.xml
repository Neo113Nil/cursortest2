<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/writebar_audio_area"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="@dimen/writebar_audio_area_height"
    android:layout_marginRight="50dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/vk_blue_400"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/writebar_cancel"
        android:background="@drawable/highlight_icon"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/audio_message_slide_to_cancel"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/vk_gray_300"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/writebar_slide_to_cancel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:text="@string/audio_message_slide_to_cancel"
        app:drawableLeftCompat="@drawable/vk_icon_deprecated_ic_audio_messages_chevron_left_24"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:id="@+id/writebar_duration_area"
        android:paddingRight="@dimen/voice_rec_duration_padding"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/writebar_record_dot"
            android:background="@drawable/red_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="1dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/vk_gray_300"
            android:layout_gravity="center_vertical"
            android:id="@+id/writebar_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:text="0:00"/>
    </LinearLayout>
</FrameLayout>
