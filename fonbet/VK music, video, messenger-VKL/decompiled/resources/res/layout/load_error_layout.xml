<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/vk_black"
    android:focusable="true"
    android:visibility="visible"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.HeadlineNormal"
        android:textColor="@color/vk_white"
        android:gravity="center"
        android:id="@+id/error_message"
        android:layout_width="296dp"
        android:layout_height="wrap_content"
        android:text="@string/common_network_error"/>
    <com.vk.core.view.components.button.VkSimpleButton
        android:textColor="@color/vk_white"
        android:id="@+id/loading_error_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/try_again"
        app:buttonAppearance="neutral"
        app:buttonMode="secondary"
        app:buttonSizeType="medium"/>
</LinearLayout>
