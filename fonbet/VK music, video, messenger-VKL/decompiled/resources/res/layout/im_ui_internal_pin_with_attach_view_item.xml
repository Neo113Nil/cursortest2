<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/stack_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="top|right"
            android:id="@+id/stack_item"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/im_ui_internal_stack_background"
            android:alpha="0.8"
            android:rotation="15"
            android:importantForAccessibility="no"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/left_container"
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:id="@+id/overlay"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.4"
                android:importantForAccessibility="no"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/player_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/vk_icon_play_16"
                android:importantForAccessibility="no"
                app:tint="?attr/vk_ui_icon_contrast"/>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:textColor="?attr/vk_ui_text_accent_themed"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:lines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stack_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/vk_ui_typography_footnote_medium"/>
    <TextView
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="?attr/vk_ui_typography_footnote_medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
