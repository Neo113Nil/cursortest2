<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/vk_white_alpha60">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <corners android:radius="30dp"/>
                    <solid android:color="?attr/vk_ui_text_link"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="30dp"/>
                    <solid android:color="@color/vk_black_alpha35"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
