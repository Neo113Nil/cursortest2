<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <ripple android:color="?attr/vk_ui_transparent_active">
            <item>
                <shape>
                    <solid android:color="?attr/vk_ui_background_secondary"/>
                    <corners android:radius="@dimen/vk_button_corner_big_radius"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="?attr/vk_ui_transparent"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:tint="?attr/vk_ui_background_secondary">
                    <solid android:color="@color/vk_ui_disabled_alpha_mask"/>
                    <corners android:radius="0.5dp"/>
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/vk_button_corner_big_radius"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="?attr/vk_ui_separator_primary_alpha"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
