<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#9999">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#000"/>
            <corners android:radius="@dimen/vk_button_corner_radius"/>
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="#9999"/>
                    <corners android:radius="@dimen/vk_button_corner_radius"/>
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/vk_clear"/>
                    <corners android:radius="@dimen/vk_button_corner_radius"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
