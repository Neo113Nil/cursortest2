<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/layer_background">
        <shape android:shape="oval">
            <solid android:color="?attr/vk_ui_image_placeholder"/>
            <stroke
                android:width="0.5dp"
                android:color="?attr/vk_ui_image_border_alpha"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:id="@+id/layer_icon"
        android:drawable="@drawable/vk_icon_user_outline_24"
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp"/>
</layer-list>
