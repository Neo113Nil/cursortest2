<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <ripple android:color="?attr/vk_ui_transparent_active">
            <item>
                <shape>
                    <stroke
                        android:width="0.5dp"
                        android:color="?attr/vk_ui_field_border_alpha"/>
                    <solid android:color="?attr/vk_ui_field_background"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <shape>
            <stroke
                android:width="0.5dp"
                android:color="?attr/vk_ui_field_border_alpha"/>
            <solid android:color="?attr/vk_ui_field_background"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
