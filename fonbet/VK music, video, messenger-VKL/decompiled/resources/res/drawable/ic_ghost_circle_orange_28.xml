<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:height="28dp"
                android:width="28dp"/>
            <solid android:color="@color/vk_orange"/>
            <stroke
                android:width="2dp"
                android:color="@color/vk_white"/>
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/vk_icon_deprecated_ic_ghost_16"
            android:tint="@color/vk_white"/>
    </item>
</layer-list>
