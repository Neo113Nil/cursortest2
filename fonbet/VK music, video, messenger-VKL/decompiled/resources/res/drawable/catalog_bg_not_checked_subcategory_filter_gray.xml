<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/vk_ui_transparent_active">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <stroke
                android:width="1dp"
                android:color="?attr/vk_ui_field_border_alpha"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_white"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</ripple>
