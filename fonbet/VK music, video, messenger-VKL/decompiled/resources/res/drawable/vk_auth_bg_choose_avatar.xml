<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="?attr/vk_ui_field_background"/>
                    <stroke
                        android:width="1.5dp"
                        android:color="?attr/vk_ui_stroke_accent_themed"/>
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?attr/vk_ui_field_background"/>
                    <stroke
                        android:width="1.5dp"
                        android:color="?attr/vk_ui_image_border_alpha"/>
                </shape>
            </item>
        </selector>
    </item>
    <item
        android:gravity="center"
        android:id="@+id/layer_icon"
        android:drawable="@drawable/vk_icon_camera_outline_28"
        android:left="22dp"
        android:top="22dp"
        android:right="22dp"
        android:bottom="22dp"/>
</layer-list>
