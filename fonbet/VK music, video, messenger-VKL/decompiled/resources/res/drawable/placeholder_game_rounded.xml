<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/vk_ui_image_placeholder"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <bitmap
            android:src="@drawable/vk_icon_deprecated_ic_games_28"
            android:tint="?attr/vk_ui_vkontakte_color_placeholder_icon_foreground_secondary"/>
    </item>
</layer-list>
