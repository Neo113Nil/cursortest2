<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill">
        <selector>
            <item android:state_checked="false">
                <shape android:shape="oval">
                    <solid android:color="@color/one_video_gray_old"/>
                </shape>
            </item>
            <item android:state_checked="true">
                <shape android:shape="oval">
                    <solid android:color="@color/one_video_white"/>
                </shape>
            </item>
        </selector>
    </item>
    <item
        android:gravity="center"
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <selector>
            <item
                android:state_checked="false"
                android:drawable="@drawable/one_video_icon_pause_12"/>
            <item
                android:state_checked="true"
                android:drawable="@drawable/one_video_icon_play_12"/>
        </selector>
    </item>
</layer-list>
