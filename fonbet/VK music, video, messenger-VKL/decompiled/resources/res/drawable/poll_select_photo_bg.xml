<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33999999">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/vk_ui_background_content"/>
            <corners android:radius="4dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/vk_blue_300"
                android:dashWidth="4dp"
                android:dashGap="4dp"/>
        </shape>
    </item>
</ripple>
