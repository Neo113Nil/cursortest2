<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <ripple android:color="?attr/vk_ui_transparent_active">
            <item>
                <shape>
                    <stroke
                        android:width="1dp"
                        android:color="?attr/vk_ui_field_border_alpha"/>
                    <solid android:color="?attr/vk_ui_background_content"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <layer-list>
            <item android:alpha="0.4">
                <shape>
                    <stroke
                        android:width="1dp"
                        android:color="?attr/vk_ui_field_border_alpha"/>
                    <solid android:color="@color/vk_gray_700"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
