<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#a393f5"
                android:endColor="#735ce6"
                android:angle="315"/>
            <size
                android:height="32dp"
                android:width="32dp"/>
        </shape>
    </item>
    <item
        android:gravity="clip_vertical|center|clip_horizontal"
        android:id="@+id/entry_point_base_icon"
        android:drawable="@drawable/vk_icon_qr_code_outline_20"/>
</layer-list>
