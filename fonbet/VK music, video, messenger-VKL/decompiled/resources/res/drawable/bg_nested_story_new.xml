<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"
                android:bottomLeftRadius="16dp"
                android:bottomRightRadius="16dp"/>
            <gradient
                android:startColor="@color/vk_violet_dark"
                android:endColor="@color/vk_violet_muted"
                android:angle="270"/>
        </shape>
    </item>
    <item
        android:left="18dp"
        android:top="18dp"
        android:right="18dp"
        android:bottom="18dp">
        <shape
            android:gravity="center"
            android:shape="oval">
            <solid android:color="@color/vk_black_alpha35"/>
        </shape>
    </item>
</layer-list>
