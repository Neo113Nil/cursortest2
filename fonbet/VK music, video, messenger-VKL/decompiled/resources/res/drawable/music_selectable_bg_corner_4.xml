<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/vk_ui_separator_primary_alpha">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="?attr/vk_ui_text_primary"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="?attr/vk_ui_separator_primary_alpha"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/vk_clear"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
