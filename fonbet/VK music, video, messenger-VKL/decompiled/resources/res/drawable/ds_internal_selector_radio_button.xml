<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:id="@+id/checked"
        android:drawable="@drawable/ds_internal_radio_button_on"/>
    <item
        android:id="@+id/unchecked"
        android:drawable="@drawable/ds_internal_radio_button_off"/>
    <transition
        android:drawable="@drawable/ds_internal_radio_button_off_on_transition"
        android:toId="@+id/checked"
        android:fromId="@+id/unchecked"/>
    <transition
        android:drawable="@drawable/ds_internal_radio_button_on_off_transition"
        android:toId="@+id/unchecked"
        android:fromId="@+id/checked"/>
</animated-selector>
