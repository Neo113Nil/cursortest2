<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <inset android:insetRight="4dp">
            <shape>
                <solid android:color="?attr/vk_ui_icon_medium_alpha"/>
                <corners android:radius="2dp"/>
                <size
                    android:height="36dp"
                    android:width="4dp"/>
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetRight="4dp">
            <shape>
                <solid android:color="?attr/vk_ui_icon_medium"/>
                <corners android:radius="2dp"/>
                <size
                    android:height="36dp"
                    android:width="4dp"/>
            </shape>
        </inset>
    </item>
</selector>
