<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/vk_legacy_placeholder_icon_background"/>
            <corners android:radius="10dp"/>
            <size
                android:height="80dp"
                android:width="80dp"/>
        </shape>
    </item>
    <item android:gravity="center">
        <bitmap
            android:src="@drawable/vk_icon_picture_outline_shadow_large_48_gallery"
            android:tint="?attr/vk_legacy_placeholder_icon_tint"/>
    </item>
</layer-list>
