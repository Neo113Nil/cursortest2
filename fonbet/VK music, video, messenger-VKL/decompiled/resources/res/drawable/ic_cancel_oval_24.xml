<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/vk_ui_transparent_active"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <bitmap
            android:src="@drawable/vk_icon_deprecated_ic_cancel_16"
            android:tint="?attr/vk_ui_icon_secondary"/>
    </item>
</layer-list>
