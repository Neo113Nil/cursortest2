<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp"/>
            <stroke
                android:width="2dp"
                android:color="?attr/vk_ui_background"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size
                android:height="40dp"
                android:width="40dp"/>
            <solid android:color="?attr/vk_ui_background"/>
        </shape>
    </item>
</layer-list>
