<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:height="@dimen/story_text_font_picker_height"
                android:width="@dimen/story_text_font_picker_width"/>
            <solid android:color="@color/vk_white"/>
