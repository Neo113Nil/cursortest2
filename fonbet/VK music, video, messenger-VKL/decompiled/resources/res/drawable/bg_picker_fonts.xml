<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:height="@dimen/story_text_font_picker_height"
                android:width="@dimen/story_text_font_picker_width"/>
            <corners android:radius="16dp"/>
            <solid android:color="@color/vk_white_alpha60"/>
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/vk_white"/>
            <size
                android:height="36dp"
                android:width="46dp"/>
            <corners android:radius="12dp"/>
            <solid android:color="#cc5d5c61"/>
        </shape>
    </item>
</layer-list>
