<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <ripple android:color="?attr/vk_legacy_background_highlighted">
            <item>
                <shape>
                    <solid android:color="?attr/vk_legacy_button_muted_background"/>
                    <corners android:radius="8dp"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="?attr/vk_legacy_landing_field_border"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/vk_legacy_button_muted_background_disabled"/>
            <corners android:radius="8dp"/>
            <stroke
                android:width="0.5dp"
                android:color="?attr/vk_legacy_float_button_border"/>
        </shape>
    </item>
</selector>
