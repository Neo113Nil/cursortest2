<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/voip_anonym_background_layer">
        <shape android:shape="oval">
            <solid android:color="@color/vk_gray_A40"/>
            <stroke
                android:width="0.5dp"
                android:color="@color/black_opacity_08"/>
