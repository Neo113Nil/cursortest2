<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/vk_ui_transparent_active">
    <item
        android:id="@android:id/background"
        android:left="@dimen/vk_ui_spacing_size_xs"
        android:right="@dimen/vk_ui_spacing_size_xs">
        <shape android:shape="rectangle">
            <solid android:color="?attr/vk_ui_background_secondary"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item
        android:id="@android:id/mask"
        android:left="@dimen/vk_ui_spacing_size_xs"
        android:right="@dimen/vk_ui_spacing_size_xs">
        <shape android:shape="rectangle">
            <solid android:color="?attr/vk_ui_background_secondary"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</ripple>
