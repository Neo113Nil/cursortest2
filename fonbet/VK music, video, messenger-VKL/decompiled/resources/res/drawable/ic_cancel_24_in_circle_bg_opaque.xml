<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="?attr/vk_ui_write_bar_input_border"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="?attr/vk_ui_background_content"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/vk_icon_deprecated_ic_cancel_16"
            android:tint="?attr/vk_ui_icon_medium"/>
    </item>
    <item>
        <ripple android:color="?attr/vk_ui_transparent_active">
            <item android:id="@android:id/mask">
                <shape android:shape="oval">
                    <solid android:color="?attr/vk_ui_background_content"/>
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
