        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#ffe64646"/>
            <corners
                android:radius="9dp"
                android:topLeftRadius="9dp"
                android:topRightRadius="9dp"
                android:bottomLeftRadius="9dp"
                android:bottomRightRadius="9dp"/>
        </shape>
    </item>
</layer-list>
