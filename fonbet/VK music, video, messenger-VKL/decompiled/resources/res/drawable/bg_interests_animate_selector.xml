<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true"
        android:id="@+id/selected"
        android:drawable="@drawable/bg_interest_item_active"/>
    <item
        android:state_selected="false"
        android:id="@+id/unselected"
        android:drawable="@drawable/bg_interest_item_inactive"/>
    <transition
        android:drawable="@drawable/bg_interest_animate_inactive_to_active"
        android:toId="@+id/selected"
        android:fromId="@+id/unselected"/>
    <transition
        android:drawable="@drawable/bg_interest_animate_active_to_inactive"
        android:toId="@+id/unselected"
        android:fromId="@+id/selected"/>
</animated-selector>
