<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background"
        android:top="17dp"
        android:bottom="17dp">
        <shape>
            <solid android:color="?attr/vk_ui_track_background"/>
            <size android:height="1dp"/>
            <corners
                android:topLeftRadius="0.6dp"
                android:topRightRadius="0.6dp"
                android:bottomLeftRadius="0.6dp"
                android:bottomRightRadius="0.6dp"/>
        </shape>
    </item>
    <item
        android:id="@android:id/secondaryProgress"
        android:top="17dp"
        android:bottom="17dp">
        <clip>
            <shape>
                <solid android:color="?attr/vk_ui_background_accent"/>
                <size android:height="1dp"/>
                <corners
                    android:topLeftRadius="0.6dp"
                    android:topRightRadius="0.6dp"
                    android:bottomLeftRadius="0.6dp"
                    android:bottomRightRadius="0.6dp"/>
            </shape>
        </clip>
    </item>
    <item
        android:id="@android:id/progress"
        android:top="16dp"
        android:bottom="16dp">
        <clip>
            <shape>
                <solid android:color="?attr/vk_ui_background_accent"/>
                <corners
                    android:topLeftRadius="1.6dp"
                    android:topRightRadius="1.6dp"
                    android:bottomLeftRadius="1.6dp"
                    android:bottomRightRadius="1.6dp"/>
                <size android:height="3dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
