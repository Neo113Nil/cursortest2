<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/vk_ui_transparent_active">
    <item
        android:left="4dp"
        android:right="4dp">
        <shape>
            <corners android:radius="100dp"/>
            <solid android:color="?attr/vk_ui_transparent"/>
        </shape>
    </item>
    <item
        android:id="@android:id/mask"
        android:left="4dp"
        android:right="4dp">
        <shape>
            <corners android:radius="100dp"/>
            <solid android:color="@color/vk_white"/>
        </shape>
    </item>
</ripple>
