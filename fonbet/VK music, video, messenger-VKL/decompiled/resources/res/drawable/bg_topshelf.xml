<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/vk_gray_900"
                android:endColor="@color/vk_clear"
                android:angle="90"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/vk_gray_900"
                android:endColor="@color/vk_clear"
                android:angle="0"
                android:type="radial"
                android:centerX="0%p"
                android:centerY="100%p"
                android:gradientRadius="100%p"/>
        </shape>
    </item>
</layer-list>
