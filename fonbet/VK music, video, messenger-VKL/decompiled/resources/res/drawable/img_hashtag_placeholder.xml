<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:id="@android:id/background">
        <shape>
            <size
                android:height="72dp"
                android:width="72dp"/>
            <corners android:radius="6dp"/>
            <solid android:color="@color/vk_blue_200"/>
        </shape>
    </item>
    <item
        android:id="@android:id/icon"
        android:left="22dp"
        android:top="22dp"
        android:right="22dp"
        android:bottom="22dp">
        <bitmap
            android:src="@drawable/vk_icon_deprecated_ic_hashtag_16"
            android:tint="@color/vk_white"/>
    </item>
</layer-list>
