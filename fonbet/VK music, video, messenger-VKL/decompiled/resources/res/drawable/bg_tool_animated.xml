<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true"
        android:drawable="@drawable/bg_tool_shape_active"/>
    <item
        android:state_selected="true"
        android:state_pressed="true">
        <inset
            android:drawable="@drawable/bg_tool_shape_active"
            android:insetLeft="1.5dp"
            android:insetRight="1.5dp"
            android:insetTop="1.5dp"
            android:insetBottom="1.5dp"/>
    </item>
    <item android:state_pressed="true">
        <inset
            android:drawable="@drawable/bg_tool_shape_inactive"
            android:insetLeft="1.5dp"
            android:insetRight="1.5dp"
            android:insetTop="1.5dp"
            android:insetBottom="1.5dp"/>
    </item>
    <item android:drawable="@drawable/bg_tool_shape_inactive"/>
</animated-selector>
