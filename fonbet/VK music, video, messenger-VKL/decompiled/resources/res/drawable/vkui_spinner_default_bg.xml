<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp"/>
                    <solid android:color="?attr/vk_ui_field_background"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="?attr/vk_ui_field_border_alpha"/>
                </shape>
            </item>
            <item
                android:gravity="end|center_vertical"
                android:id="@+id/layer_icon"
                android:drawable="@drawable/vk_icon_dropdown_24"
                android:right="10dp"/>
        </layer-list>
    </item>
</selector>
