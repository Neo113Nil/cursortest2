<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <ripple android:color="@color/vk_black_alpha8">
            <item>
                <shape>
                    <solid android:color="?attr/vk_ui_background_contrast"/>
                    <corners android:radius="@dimen/vk_button_corner_big_radius"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <shape android:tint="?attr/vk_ui_background_contrast">
            <solid android:color="@color/vk_ui_disabled_alpha_mask"/>
            <corners android:radius="@dimen/vk_button_corner_big_radius"/>
        </shape>
    </item>
</selector>
