<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <ripple android:color="?attr/vk_ui_transparent_active">
            <item>
                <shape>
                    <solid android:color="?attr/vk_ui_background_accent_themed"/>
                    <corners android:radius="@dimen/vk_button_corner_radius_16dp"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <shape
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tint="?attr/vk_ui_background_accent_themed">
            <solid android:color="@color/vk_ui_disabled_alpha_mask"/>
            <corners android:radius="@dimen/vk_button_corner_radius_16dp"/>
        </shape>
    </item>
</selector>
