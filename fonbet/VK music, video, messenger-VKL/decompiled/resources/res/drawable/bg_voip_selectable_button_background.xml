<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_activated="true">
        <ripple android:color="?attr/vk_ui_transparent_active">
            <item>
                <shape>
                    <padding
                        android:left="16dp"
                        android:top="6dp"
                        android:right="16dp"
                        android:bottom="7dp"/>
                    <solid android:color="?attr/vk_ui_background_secondary_alpha"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="?attr/vk_ui_field_border_alpha"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item android:state_enabled="true">
        <ripple android:color="?attr/vk_ui_transparent_active">
            <item>
                <shape>
                    <padding
                        android:left="16dp"
                        android:top="6dp"
                        android:right="16dp"
                        android:bottom="7dp"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="?attr/vk_ui_field_border_alpha"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <layer-list>
            <item android:alpha="0.4">
                <shape>
                    <padding
                        android:left="16dp"
                        android:top="6dp"
                        android:right="16dp"
                        android:bottom="7dp"/>
                    <solid android:color="@color/vk_gray_700"/>
                    <stroke android:color="?attr/vk_ui_field_border_alpha"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
