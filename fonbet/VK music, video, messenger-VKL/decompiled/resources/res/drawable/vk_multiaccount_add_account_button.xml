<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/vk_ui_image_placeholder"/>
            <stroke
                android:width="0.5dp"
                android:color="?attr/vk_ui_image_border_alpha"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:id="@+id/shape_plus"
        android:drawable="@drawable/vk_icon_add_24"
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"/>
</layer-list>
