<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <ripple android:color="@color/vk_red_light">
            <item android:id="@android:id/mask">
                <shape>
                    <solid android:color="@color/vk_black_alpha20"/>
                    <corners android:radius="@dimen/vk_button_corner_big_radius"/>
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/vk_red_light"/>
                    <corners android:radius="@dimen/vk_button_corner_big_radius"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <layer-list>
            <item android:alpha="0.4">
                <shape>
                    <solid android:color="?attr/vk_ui_vkontakte_button_tertiary_foreground"/>
                    <corners android:radius="@dimen/vk_button_corner_big_radius"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
