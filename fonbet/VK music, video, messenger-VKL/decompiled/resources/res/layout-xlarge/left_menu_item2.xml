<?xml version="1.0" encoding="utf-8"?>
<com.vkontakte.android.ui.FullWidthLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.vk.imageloader.view.VKCircleImageView
        android:id="@+id/flist_item_photo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="24dp"
        app:placeholderImage="@drawable/user_placeholder"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
        android:textColor="?attr/vk_ui_text_primary"
        android:ellipsize="end"
        android:id="@+id/flist_item_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        android:text="Pavel Durov"
        android:singleLine="true"
        android:layout_weight="1"
        android:layout_toLeftOf="@+id/flist_item_online"
        android:layout_toRightOf="@+id/flist_item_photo"/>
    <ImageView
        android:id="@+id/flist_item_online"
        android:layout_width="10dp"
        android:layout_height="14dp"
        android:layout_marginRight="6dp"
        android:src="@drawable/ic_online_mobile"
        android:scaleType="center"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</com.vkontakte.android.ui.FullWidthLinearLayout>
