<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_extended"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="?attr/vk_ui_background_content"
        android:paddingLeft="32dp"
        android:paddingTop="8dp"
        android:paddingRight="32dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_weight="1">
            <TextView
                android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
                android:textColor="?attr/vk_ui_text_tertiary"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/video_search_duration"/>
            <Spinner
                android:gravity="center"
                android:id="@+id/duration_spinner"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_weight="1"
                style="@style/Widget.AppCompat.Spinner"/>
            <TextView
                android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
                android:textColor="?attr/vk_ui_text_tertiary"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/video_search_sort"/>
            <Spinner
                android:gravity="center"
                android:id="@+id/sort_spinner"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_weight="1"
                style="@style/Widget.AppCompat.Spinner"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_weight="1">
            <CheckBox
                android:textSize="14dp"
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center"
                android:id="@+id/hd_only"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/video_hd_only"
                android:singleLine="true"/>
            <CheckBox
                android:textSize="14dp"
                android:textColor="?attr/vk_ui_text_primary"
                android:gravity="center"
                android:id="@+id/safe_search"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:checked="true"
                android:text="@string/sett_safe_search"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
