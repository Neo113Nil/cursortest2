<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/leftmenu_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="8dp"
        app:srcCompat="@drawable/vk_icon_gift_32"/>
    <com.vk.core.view.PhotoStripView
        android:id="@+id/leftmenu_photo_strip"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="32dp"
        android:layout_toLeftOf="@+id/leftmenu_counter"
        android:layout_toRightOf="@+id/leftmenu_icon"
        android:transformPivotX="0dp"
        android:transformPivotY="20dp"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.Caption1Medium.Unscaled"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:gravity="center"
        android:id="@+id/leftmenu_counter2"
        android:background="@drawable/left_notify_tablet_collapsed"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginRight="192dp"
        android:minWidth="20dp"
        android:text="+1"
        android:singleLine="true"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textAppearance="@style/VkUiTypography.SubheadMedium.Unscaled"
        android:textColor="?attr/vk_ui_text_contrast_themed"
        android:gravity="center"
        android:id="@+id/leftmenu_counter"
        android:background="@drawable/left_notify"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="10dp"
        android:minWidth="24dp"
        android:text="+1"
        android:singleLine="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
