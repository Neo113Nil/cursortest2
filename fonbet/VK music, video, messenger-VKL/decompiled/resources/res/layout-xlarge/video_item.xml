<?xml version="1.0" encoding="utf-8"?>
<com.vkontakte.android.ui.widget.ForegroundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="11dp"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:foreground="@drawable/rounded_list_selector">
    <FrameLayout
        android:id="@+id/video_image_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.core.view.components.picture.VkImage
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            app:actualImageScaleType="centerCrop"
            app:emptyImagePlaceholder="@drawable/ic_videos_placeholder"
            app:placeholderImage="@drawable/default_placeholder_2"
            app:roundedCornerRadius="2dp"
            app:viewAspectRatio="1.7778"/>
        <com.vk.libvideo.design.view.overlay.VideoOverlayView
            android:id="@+id/video_item_overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:vov_corner_radius="2dp"
            app:vov_size="small"/>
    </FrameLayout>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Caption1Medium.Unscaled"
        android:textColor="@color/vk_white"
        android:id="@+id/duration"
        android:background="@drawable/bg_video_duration_label_old"
        android:paddingLeft="4dp"
        android:paddingTop="2.5dp"
        android:paddingRight="4dp"
        android:paddingBottom="2.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_alignBottom="@+id/photo"
        android:layout_marginEnd="4dp"
        android:layout_alignEnd="@+id/photo"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/options"
        android:background="@drawable/highlight"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_actions_small_24"
        android:scaleType="centerInside"
        android:layout_below="@+id/video_image_container"
        android:layout_marginEnd="-6dp"
        android:layout_alignEnd="@+id/video_image_container"
        app:tint="?attr/vk_ui_icon_medium"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
        android:textColor="?attr/vk_ui_text_muted"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:layout_below="@+id/video_image_container"
        android:layout_marginEnd="48dp"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
        android:textColor="?attr/vk_ui_text_secondary"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/title"
        android:layout_toStartOf="@+id/options"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/subtitle"
        android:layout_toStartOf="@+id/options"/>
</com.vkontakte.android.ui.widget.ForegroundRelativeLayout>
