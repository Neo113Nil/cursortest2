<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/fade"
        android:background="@color/vk_black_alpha35"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/voip_extended_options_onboarding_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="108dp"/>
    <com.vk.voip.ui.menu.ui.PortalView
        android:id="@+id/voip_extended_options_portal"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="88dp"
        app:color="?attr/vk_ui_background_content"
        app:corners_radius="16dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/voip_extended_options_container_background"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="108dp"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/voip_extended_options_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom_sheet"
            android:background="@drawable/bg_slide_up_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:behavior_peekHeight="104dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/swipe_indicator"
                android:paddingTop="3dp"
                android:paddingBottom="2dp"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/vk_icon_swipe_up_48"
                app:tint="@color/vk_gray_400"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="88dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/voip_extended_options_content_box"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/voip_extended_options_content_box_touch_interceptor"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/voip_extended_options_content_box"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/voip_extended_options_content_box"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/voip_extended_options_container_wall"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="match_parent"
            android:layout_height="84dp"/>
        <com.vk.voip.ui.menu.ui.actions.PrimaryActionsView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/primary_buttons"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</merge>
