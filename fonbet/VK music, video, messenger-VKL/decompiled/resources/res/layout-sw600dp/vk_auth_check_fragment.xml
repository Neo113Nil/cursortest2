<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/base_check_container"
        android:background="@drawable/vk_auth_bg_screen_tablet"
        android:paddingTop="16dp"
        android:layout_width="600dp"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="102dp">
        <FrameLayout
            android:id="@+id/icon_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginTop="16dp">
            <ImageView
                android:id="@+id/icon"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="56dp"/>
            <com.vk.core.view.components.spinner.VkSpinner
                android:layout_gravity="center"
                android:id="@+id/messenger_icon_loader"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="?attr/vk_ui_icon_accent"
                app:spinnerSize="medium"/>
        </FrameLayout>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/vk_auth_confirm_number"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/icon_container"
            app:layout_goneMarginTop="12dp"
            style="@style/VkUiTypography.DisplayTitle2SemiBold"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/first_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vk_auth_sms_was_sent"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/VkUiTypography.Headline1Normal"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/phone_number_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/first_subtitle">
            <TextView
                android:textColor="?attr/vk_ui_text_primary"
                android:id="@+id/second_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                style="@style/VkUiTypography.Headline1Normal"/>
            <TextView
                android:textColor="?attr/vk_ui_text_link"
                android:id="@+id/change_number"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vk_service_validation_confirmation_change_number"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                style="@style/VkUiTypography.SubheadNormal"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/code_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/phone_number_container">
            <com.vk.auth.verification.base.ui.VkCheckEditText
                android:layout_gravity="center_horizontal"
                android:id="@+id/new_code_edit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.vk.auth.ui.VkAuthExtendedEditText
                android:textColor="?attr/vk_ui_text_primary"
                android:textColorHint="?attr/vk_ui_text_secondary"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/code_edit_text_container"
                android:background="@drawable/vk_ui_auth_bg_edittext_stated_with_error"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:minWidth="268dp"
                android:hint="@string/vk_auth_input_code"
                android:maxLength="10"
                android:inputType="number"
                android:importantForAccessibility="no"
                android:layout_marginHorizontal="80dp"
                android:importantForAutofill="no"
                app:vk_error_stated_edit_text_id="@+id/code_edit_text"
                app:vk_error_stated_edit_text_text_appearance="@style/VkUiTypography.TextNormal"
                style="@style/VKID.EditText"/>
        </FrameLayout>
        <TextView
            android:textColor="?attr/vk_ui_text_subhead"
            android:id="@+id/white_label_flow_change_number"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vk_service_validation_white_flow_change_number"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="@+id/code_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/code_container"
            app:layout_constraintTop_toBottomOf="@+id/code_container"
            style="@style/VkUiTypography.SubheadMedium"/>
        <ViewStub
            android:id="@+id/libverify_callin_top_stub"
            android:layout="@layout/vk_auth_check_libverify_callin_top_layout"
            android:inflatedId="@+id/libverify_callin_top_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/first_subtitle"/>
        <TextView
            android:textColor="?attr/vk_ui_text_negative"
            android:gravity="center"
            android:id="@+id/error_subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vk_auth_code_incorrect"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/code_container"
            app:layout_constraintStart_toStartOf="@+id/code_container"
            app:layout_constraintTop_toBottomOf="@+id/code_container"
            style="@style/VkUiTypography.FootnoteNormal"/>
        <com.vk.auth.ui.VkLoadingButton
            android:textColor="?attr/vk_ui_text_contrast_themed"
            android:id="@+id/continue_btn"
            android:background="@drawable/vk_ui_auth_bg_landing_primary_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_auth_continue"
            app:layout_constraintBottom_toTopOf="@+id/info_buttons_top_barrier"
            app:layout_constraintTop_toBottomOf="@+id/error_subtitle"
            app:layout_constraintVertical_bias="1"
            app:vk_lb_text_appearance="@style/VkUiTypography.Headline1Medium"
            style="@style/VKID.View.Button"/>
        <com.vk.superapp.ui.VkGradientButton
            android:textColor="?attr/vk_ui_text_contrast"
            android:id="@+id/max_messenger_gradient_open_button"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_max_otp_code_open_max_button"
            android:layout_marginHorizontal="16dp"
            app:buttonAppearance="neutral"
            app:buttonMode="secondary"
            app:buttonSizeType="large"
            app:layout_constraintBottom_toTopOf="@+id/info_buttons_top_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/error_subtitle"
            app:layout_constraintVertical_bias="1"/>
        <View
            android:id="@+id/max_messenger_additional_background"
            android:background="?attr/vk_ui_background_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/info_buttons_top_barrier"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/info_buttons_top_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="info_text,retry_button"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/info_buttons_bottom_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="info_text,retry_button"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/info_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:layout_marginVertical="12dp"
            android:paddingVertical="9dp"
            app:layout_constraintBottom_toTopOf="@+id/login_by_password"
            app:layout_constraintVertical_bias="1"
            style="@style/VkUiTypography.SubheadNormal"/>
        <ViewStub
            android:id="@+id/libverify_callin_bottom_stub"
            android:layout="@layout/vk_auth_check_libverify_callin_bottom_layout"
            android:inflatedId="@+id/libverify_callin_bottom_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/info_buttons_top_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/error_subtitle"
            app:layout_constraintVertical_bias="1"/>
        <com.vk.auth.ui.VkAuthTextView
            android:textAppearance="@style/VkUiTypography.Headline1Medium"
            android:textColor="?attr/vk_ui_text_accent"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/retry_button"
            android:background="@drawable/vk_ui_auth_bg_landing_tertiary_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/vk_auth_not_receive_code"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp"
            app:layout_constraintBottom_toTopOf="@+id/login_by_password"
            app:layout_constraintVertical_bias="1"
            style="@style/VKID.View.Button"/>
        <com.vk.auth.ui.VkAuthTextView
            android:textAppearance="@style/VkUiTypography.Headline1Medium"
            android:textColor="?attr/vk_ui_text_accent_themed"
            android:gravity="center"
            android:id="@+id/login_by_password"
            android:background="@drawable/vk_ui_auth_bg_landing_tertiary_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_auth_login_by_password"
            android:paddingHorizontal="@dimen/vk_ui_button_padding_horizontal"
            app:layout_constraintBottom_toTopOf="@+id/vk_enter_by_mail"
            style="@style/VKID.View.Button"/>
        <Button
            android:textAppearance="@style/VkUiTypography.Headline1"
            android:textColor="?attr/vk_ui_text_accent_themed"
            android:id="@+id/vk_enter_by_mail"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_auth_by_password_mail"
            app:layout_constraintBottom_toTopOf="@+id/help_button"
            style="@style/VKID.View.Button.Tertiary"/>
        <com.vk.auth.ui.VkAuthTextView
            android:id="@+id/help_button"
            android:padding="@dimen/vk_ui_button_padding_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/vk_auth_help_button"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/VkAuth.Button.Landing.Tertiary"/>
        <ProgressBar
            android:id="@+id/vk_auth_check_progress"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/vk_ui_icon_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ViewStub
            android:id="@+id/mobile_id_stub"
            android:layout="@layout/vk_auth_check_mobile_id"
            android:inflatedId="@+id/mobile_id_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ViewStub
            android:id="@+id/max_messenger_stub"
            android:layout="@layout/vk_auth_check_max_messenger"
            android:inflatedId="@+id/max_messenger_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/info_buttons_top_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ViewStub
            android:id="@+id/messenger_registration_stub"
            android:layout="@layout/vk_auth_messenger_registration"
            android:inflatedId="@+id/messenger_registration_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
