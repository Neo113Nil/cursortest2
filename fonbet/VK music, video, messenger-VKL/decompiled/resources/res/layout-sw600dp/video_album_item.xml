<?xml version="1.0" encoding="utf-8"?>
<com.vkontakte.android.ui.widget.ForegroundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="11dp"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:foreground="@drawable/rounded_list_selector">
    <com.vk.core.view.components.picture.VkImage
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        app:actualImageScaleType="centerCrop"
        app:emptyImagePlaceholder="@drawable/ic_videos_placeholder"
        app:placeholderImage="@drawable/default_placeholder_2"
        app:roundedCornerRadius="2dp"
        app:viewAspectRatio="1.7778"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/lock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/vk_icon_deprecated_ic_videos_private_badge_24"
        android:layout_alignLeft="@+id/photo"
        android:layout_alignBottom="@+id/photo"/>
    <com.vk.core.view.components.picture.VkImageSimple
        android:id="@+id/options"
        android:background="@drawable/highlight"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginRight="-6dp"
        android:src="@drawable/ic_actions_small_24"
        android:scaleType="centerInside"
        android:layout_below="@+id/photo"
        android:layout_alignRight="@+id/photo"
        app:tint="?attr/vk_ui_icon_medium"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Subhead.Unscaled"
        android:textColor="?attr/vk_ui_text_muted"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_toLeftOf="@+id/options"
        android:layout_below="@+id/photo"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/options"
        android:layout_below="@+id/title"/>
    <com.vk.core.view.components.text.VkText
        android:textAppearance="@style/VkUiTypography.Footnote.Unscaled"
        android:textColor="?attr/vk_ui_text_secondary"
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/options"
        android:layout_below="@+id/subtitle"/>
</com.vkontakte.android.ui.widget.ForegroundRelativeLayout>
