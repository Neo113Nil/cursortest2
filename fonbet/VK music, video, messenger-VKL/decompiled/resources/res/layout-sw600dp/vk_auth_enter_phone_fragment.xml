<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/vk_ui_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/enter_phone_container"
        android:background="@drawable/vk_auth_bg_screen_tablet"
        android:paddingTop="16dp"
        android:layout_width="600dp"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="102dp">
        <ImageView
            android:id="@+id/icon"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginTop="16dp"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/vk_auth_sign_up_enter_phone"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            app:layout_goneMarginTop="12dp"
            style="@style/VkUiTypography.DisplayTitle2SemiBold"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vk_auth_sign_up_enter_phone_reason"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/VkUiTypography.Headline1Normal"/>
        <com.vk.auth.ui.VkAuthPhoneView
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
        <TextView
            android:textColor="?attr/vk_ui_text_negative"
            android:gravity="center"
            android:id="@+id/phone_error"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vk_auth_sign_up_incorrect_phone"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/phone"
            style="@style/VkUiTypography.FootnoteNormal"/>
        <com.vk.auth.ui.VkLoadingButton
            android:textColor="?attr/vk_ui_text_contrast_themed"
            android:id="@+id/continue_btn"
            android:background="@drawable/vk_ui_auth_bg_landing_primary_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_auth_continue"
            app:layout_constraintBottom_toTopOf="@+id/help_button"
            app:layout_constraintTop_toBottomOf="@+id/phone_error"
            app:layout_constraintVertical_bias="1"
            app:vk_lb_text_appearance="@style/VkUiTypography.Headline1Medium"
            style="@style/VKID.View.Button"/>
        <com.vk.auth.ui.VkAuthTextView
            android:id="@+id/help_button"
            android:padding="@dimen/vk_ui_button_padding_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_auth_help_button"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toTopOf="@+id/enter_phone_legal_notes"
            style="@style/VkAuth.Button.Landing.Tertiary"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:id="@+id/enter_phone_legal_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/vk_auth_sign_up_terms_new"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/VkUiTypography.SubheadNormal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
