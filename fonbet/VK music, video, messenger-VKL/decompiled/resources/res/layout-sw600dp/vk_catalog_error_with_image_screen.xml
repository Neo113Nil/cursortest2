<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:id="@+id/error_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/error_default_config_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vk.imageloader.view.VKImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/error_image"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/vk_catalog_network_error_description"/>
        <TextView
            android:textColor="?attr/vk_ui_text_secondary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/error_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:maxWidth="436dp"
            android:minLines="2"
            android:textAlignment="center"
            android:layout_marginHorizontal="32dp"
            style="@style/VkUiTypography.Headline1Normal"/>
        <com.vk.core.view.components.button.VkButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/error_action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="32dp"
            app:buttonAppearance="accent"
            app:buttonMode="primary"
            app:buttonSizeType="medium"/>
        <TextView
            android:textColor="?attr/vk_ui_text_accent_themed"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/error_retry"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/vk_common_retry"
            android:layout_marginHorizontal="32dp"
            style="@style/VkUiTypography.Headline2"/>
    </LinearLayout>
    <androidx.compose.ui.platform.ComposeView
        android:layout_gravity="center"
        android:id="@+id/error_compose_config_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
