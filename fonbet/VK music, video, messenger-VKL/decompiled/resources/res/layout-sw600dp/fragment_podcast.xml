<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/AppTheme.ActionBarTheme"
        android:id="@+id/toolbar"
        android:background="?attr/vk_ui_background_content"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextColor="?attr/vk_ui_text_primary">
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="center_vertical"
            android:id="@+id/playlist_collapsed_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            style="@style/VkUiTypography.DisplayTitle2"/>
    </androidx.appcompat.widget.Toolbar>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.vk.lists.CustomSwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/music_playlist_content_list"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
        </com.vk.lists.CustomSwipeRefreshLayout>
        <FrameLayout
            android:id="@+id/error_layout"
            android:background="?attr/vk_ui_background_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.vk.music.ui.common.MusicErrorScrollableView
                android:layout_gravity="center"
                android:id="@+id/podcast_music_error_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.compose.ui.platform.ComposeView
                android:layout_gravity="center"
                android:id="@+id/podcast_music_error_compose_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <include
            android:id="@+id/progress"
            layout="@layout/music_ui_progress"/>
    </FrameLayout>
</LinearLayout>
