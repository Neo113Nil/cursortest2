<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/catalog_video_header_height"
        android:paddingStart="@dimen/catalog_video_header_padding"
        android:paddingEnd="@dimen/catalog_video_header_padding">
        <com.vk.core.view.shimmer.ShimmerFrameLayout
            android:id="@+id/user_icon"
            android:background="@drawable/highlight_unbounded"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:background="@drawable/vk_bg_skeleton_round"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
        </com.vk.core.view.shimmer.ShimmerFrameLayout>
        <ImageView
            android:id="@+id/logo"
            android:background="@drawable/highlight_unbounded"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/catalog_video_header_logo_tablet_start_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vk_icon_logo_vk_video_color_28"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="logo,user_icon"/>
        <TextView
            android:textColor="?attr/vk_ui_text_primary"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/video_catalog_header"
            android:textDirection="locale"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/toolbar_buttons"
            app:layout_constraintStart_toEndOf="@+id/barrier"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/VkUiTypography.DisplayTitle2"/>
        <com.vk.core.view.shimmer.ShimmerFrameLayout
            android:id="@+id/toolbar_buttons"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/title"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:layout_gravity="start"
                android:id="@+id/video_toolbar_skeleton_btn_1"
                android:background="@drawable/vk_bg_skeleton_round"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
            <View
                android:layout_gravity="end"
                android:background="@drawable/vk_bg_skeleton_round"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
        </com.vk.core.view.shimmer.ShimmerFrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vk.core.view.shimmer.ShimmerFrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="19dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/tab1"
                android:background="@drawable/vk_bg_skeleton_3dp"
                android:layout_width="56dp"
                android:layout_height="10dp"
                android:layout_marginStart="42dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/tab2"
                android:background="@drawable/vk_bg_skeleton_3dp"
                android:layout_width="56dp"
                android:layout_height="10dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@+id/tab1"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/tab3"
                android:background="@drawable/vk_bg_skeleton_3dp"
                android:layout_width="56dp"
                android:layout_height="10dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@+id/tab2"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/tab4"
                android:background="@drawable/vk_bg_skeleton_3dp"
                android:layout_width="56dp"
                android:layout_height="10dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@+id/tab3"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/tab5"
                android:background="@drawable/vk_bg_skeleton_3dp"
                android:layout_width="56dp"
                android:layout_height="10dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@+id/tab4"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/video_card1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="32dp"
                app:layout_constraintEnd_toStartOf="@+id/video_card2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tab1"
                layout="@layout/catalog_video_card_shimmer_tablet_redesign"/>
            <include
                android:id="@+id/video_card2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/video_card1"
                app:layout_constraintTop_toTopOf="@+id/video_card1"
                layout="@layout/catalog_video_card_shimmer_tablet_redesign"/>
            <include
                android:id="@+id/video_card3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="@+id/video_card1"
                app:layout_constraintStart_toStartOf="@+id/video_card1"
                app:layout_constraintTop_toBottomOf="@+id/video_card1"
                layout="@layout/catalog_video_card_shimmer_tablet_redesign"/>
            <include
                android:id="@+id/video_card4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/video_card2"
                app:layout_constraintStart_toStartOf="@+id/video_card2"
                app:layout_constraintTop_toTopOf="@+id/video_card3"
                layout="@layout/catalog_video_card_shimmer_tablet_redesign"/>
            <include
                android:id="@+id/video_card5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="@+id/video_card3"
                app:layout_constraintStart_toStartOf="@+id/video_card3"
                app:layout_constraintTop_toBottomOf="@+id/video_card3"
                layout="@layout/catalog_video_card_shimmer_tablet_redesign"/>
            <include
                android:id="@+id/video_card6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/video_card4"
                app:layout_constraintStart_toStartOf="@+id/video_card4"
                app:layout_constraintTop_toTopOf="@+id/video_card5"
                layout="@layout/catalog_video_card_shimmer_tablet_redesign"/>
            <include
                android:id="@+id/video_card7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="@+id/video_card5"
                app:layout_constraintStart_toStartOf="@+id/video_card5"
                app:layout_constraintTop_toBottomOf="@+id/video_card5"
                layout="@layout/catalog_video_card_shimmer_tablet_redesign"/>
            <include
                android:id="@+id/video_card8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/video_card6"
                app:layout_constraintStart_toStartOf="@+id/video_card6"
                app:layout_constraintTop_toTopOf="@+id/video_card7"
                layout="@layout/catalog_video_card_shimmer_tablet_redesign"/>
            <include
                android:id="@+id/video_card9"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="@+id/video_card7"
                app:layout_constraintStart_toStartOf="@+id/video_card7"
                app:layout_constraintTop_toBottomOf="@+id/video_card7"
                layout="@layout/catalog_video_card_shimmer_tablet_redesign"/>
            <include
                android:id="@+id/video_card10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/video_card8"
                app:layout_constraintStart_toStartOf="@+id/video_card8"
                app:layout_constraintTop_toTopOf="@+id/video_card9"
                layout="@layout/catalog_video_card_shimmer_tablet_redesign"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.vk.core.view.shimmer.ShimmerFrameLayout>
</LinearLayout>
