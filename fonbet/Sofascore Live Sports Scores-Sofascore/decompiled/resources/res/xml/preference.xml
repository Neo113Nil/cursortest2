<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:key="preferences">
    <PreferenceCategory
        android:title="@string/settings_appearance"
        android:key="application_category">
        <Preference
            android:icon="@drawable/ic_translate"
            android:title="@string/language"
            android:key="PREF_LANGUAGE_CODE"/>
        <Preference
            android:icon="@drawable/ic_contrast"
            android:title="@string/app_theme_title"
            android:key="PREF_THEME"/>
        <Preference
            android:icon="@drawable/ic_primary_tab"
            android:title="@string/pref_primary_tab_title"
            android:key="PREF_HOME_SCREEN"/>
        <Preference
            android:icon="@drawable/ic_calendar_01"
            android:title="@string/first_day_of_week"
            android:key="PREF_FIRST_DAY_OF_WEEK"/>
        <Preference
            android:icon="@drawable/ic_measurement"
            android:title="@string/profile_measurement_system"
            android:key="PREF_MEASUREMENT_UNITS"/>
        <Preference
            android:icon="@drawable/ic_coins"
            android:title="@string/currency"
            android:key="PREF_CURRENCY"/>
        <SwitchPreference
            android:icon="@drawable/ic_coupon"
            android:title="@string/settings_special_promotions_title"
            android:key="PREF_PROMOTIONS_ENABLE"
            android:summary="@string/settings_special_promotions_body"
            android:defaultValue="true"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/odds"
        android:key="odds_category">
        <SwitchPreference
            android:icon="@drawable/ic_odds_provider"
            android:title="@string/settings_odds_display_toggle"
            android:key="PREF_PROVIDER_ODDS_ENABLE"
            android:defaultValue="true"/>
        <Preference
            android:icon="@drawable/ic_odds_provider"
            android:title="@string/odds_provider"
            android:key="PREF_PROVIDER_ODDS"
            app:allowDividerBelow="true"/>
        <Preference
            android:icon="@drawable/ic_odds_format"
            android:title="@string/odds_title"
            android:key="PREF_ODDS"/>
        <Preference
            android:icon="@drawable/ic_odds_provider"
            android:title="@string/odds_and_ads_settings_title"
            android:key="PREF_MANAGE_ODDS_ADDS_V2"/>
    </PreferenceCategory>
</PreferenceScreen>
