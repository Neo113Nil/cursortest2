<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_weekly_competitions"
    app:startDestination="@+id/weekly_leaderboard_fragment">
    <fragment
        android:name="com.sofascore.results.weeklyChallenge.leaderboard.WeeklyLeaderboardFragment"
        android:id="@+id/weekly_leaderboard_fragment">
        <action
            android:id="@+id/action_leaderboard_to_upcoming_matches_dialog"
            app:destination="@+id/upcoming_matches_dialog"/>
        <action
            android:id="@+id/action_leaderboard_to_info_modal"
            app:destination="@+id/info_modal"/>
        <action
            android:id="@+id/action_leaderboard_to_streak_modal"
            app:destination="@+id/weekly_streak_dialog"/>
        <action
            android:id="@+id/action_daily_bonus_modal"
            app:destination="@+id/daily_bonus_modal"/>
    </fragment>
    <dialog
        android:name="com.sofascore.results.weeklyChallenge.leaderboard.UpcomingMatchesModal"
        android:id="@+id/upcoming_matches_dialog"/>
    <dialog
        android:name="com.sofascore.results.weeklyChallenge.leaderboard.LeaderboardInfoModal"
        android:id="@+id/info_modal">
        <argument
            android:name="info_type"
            app:argType="com.sofascore.results.weeklyChallenge.WeeklyChallengeViewModel$LeaderboardInfoType"/>
    </dialog>
    <dialog
        android:name="com.sofascore.results.weeklyChallenge.WeeklyChallengeUserDailyBonusModal"
        android:id="@+id/daily_bonus_modal">
        <argument
            android:name="event"
            app:argType="com.sofascore.model.mvvm.model.Event"/>
    </dialog>
    <dialog
        android:name="com.sofascore.results.profile.view.WeeklyStreaksExplanationModal"
        android:id="@+id/weekly_streak_dialog"/>
</navigation>
