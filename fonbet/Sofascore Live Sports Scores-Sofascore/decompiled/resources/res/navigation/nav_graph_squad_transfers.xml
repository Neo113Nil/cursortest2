<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_transfers"
    app:startDestination="@+id/squad_fragment">
    <fragment
        android:name="com.sofascore.results.fantasy.teammanagement.transfers.FantasyTransfersFragment"
        android:id="@+id/squad_fragment">
        <action
            android:id="@+id/action_squad_to_player_dialog"
            app:destination="@+id/player_dialog"/>
        <action
            android:id="@+id/action_squad_to_select_replacement"
            app:destination="@+id/select_replacement"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_squad_to_review"
            app:destination="@+id/transfers_review_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_squad_to_squad_info_mode_dialog"
            app:destination="@+id/squad_info_mode_dialog"/>
    </fragment>
    <dialog
        android:name="com.sofascore.results.fantasy.teammanagement.player.FantasyFootballPlayerTransfersBottomSheet"
        android:id="@+id/player_dialog">
        <action
            android:id="@+id/action_player_to_select_replacement"
            app:destination="@+id/select_replacement"
            app:popUpTo="@+id/player_dialog"
            app:popUpToInclusive="true"/>
        <argument
            android:name="player"
            app:argType="com.sofascore.results.fantasy.ui.model.FantasyRoundPlayerUiModel"/>
        <argument
            android:name="roundId"
            app:argType="integer"/>
        <argument
            android:name="competitionId"
            app:argType="integer"/>
        <argument
            android:name="competitionType"
            app:argType="com.sofascore.model.fantasy.FantasyCompetitionType"/>
        <argument
            android:name="tripleCaptain"
            app:argType="boolean"/>
        <argument
            android:name="assetsRestricted"
            android:defaultValue="false"
            app:argType="boolean"/>
    </dialog>
    <dialog
        android:name="com.sofascore.results.fantasy.teammanagement.transfers.selectreplacement.FantasyTransfersSelectReplacementDialogFragment"
        android:id="@+id/select_replacement">
        <argument
            android:name="roundId"
            app:argType="integer"/>
        <argument
            android:name="competitionId"
            app:argType="integer"/>
        <argument
            android:name="player"
            android:defaultValue="@null"
            app:argType="com.sofascore.results.fantasy.ui.model.FantasyRoundPlayerUiModel"
            app:nullable="true"/>
    </dialog>
    <fragment
        android:name="com.sofascore.results.fantasy.teammanagement.transfers.review.FantasyTransfersReviewFragment"
        android:id="@+id/transfers_review_fragment"/>
    <dialog
        android:name="com.sofascore.results.fantasy.shared.FantasyTransfersSquadInfoDisplayModeBottomSheet"
        android:id="@+id/squad_info_mode_dialog"/>
</navigation>
