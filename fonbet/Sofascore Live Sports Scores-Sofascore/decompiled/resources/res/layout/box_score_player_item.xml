<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <View
        android:id="@+id/starting_lineups_team_color"
        android:background="@color/value"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/box_score_player_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/surface_1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/starting_lineups_starter_label_text"
        android:background="@drawable/rectangle_6dp_corners"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-4dp"
        android:text="@string/basketball_starter"
        android:maxLines="1"
        android:backgroundTint="@color/value"
        app:layout_constraintBottom_toBottomOf="@+id/box_score_player_image"
        app:layout_constraintEnd_toEndOf="@+id/box_score_player_image"
        app:layout_constraintStart_toStartOf="@+id/box_score_player_image"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textColor="@color/surface_1"
        android:id="@+id/tvPlayerStatus"
        android:background="@drawable/rectangle_8dp_corners"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/basketball_player_ejected_long"
        android:backgroundTint="@color/error"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tvPlayerName"
        app:layout_constraintEnd_toStartOf="@+id/horizontal_scroll"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tvPlayerName"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/AssistiveMicro"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/number_and_position_container"
        app:layout_constraintEnd_toStartOf="@+id/stats_barrier"
        app:layout_constraintStart_toEndOf="@+id/box_score_player_image"
        app:layout_constraintTop_toBottomOf="@+id/tvPlayerStatus"
        app:layout_constraintWidth_min="100dp"
        style="@style/DisplaySmall"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/number_and_position_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tvPlayerName"
        app:layout_constraintStart_toStartOf="@+id/tvPlayerName"
        app:layout_constraintTop_toBottomOf="@+id/tvPlayerName">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvShirtNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:paddingEnd="8dp"
            style="@style/BodyMedium"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:id="@+id/tvPosition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:textDirection="locale"
            android:textAlignment="viewStart"
            style="@style/BodyMedium"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.4"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/stats_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="horizontal_scroll,sort_lineups_player_main_1"/>
    <com.sofascore.common.widget.ScrollInterceptorHorizontalScrollView
        android:id="@+id/horizontal_scroll"
        android:scrollbars="none"
        android:clipToPadding="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:paddingEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rating_item"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/start_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="8dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/header_root"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingEnd="4dp"/>
    </com.sofascore.common.widget.ScrollInterceptorHorizontalScrollView>
    <TextView
        android:gravity="center"
        android:id="@+id/sort_lineups_player_main_1"
        android:layout_width="42dp"
        android:layout_height="match_parent"
        android:textDirection="ltr"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/sort_lineups_player_main_2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintWidth_max="@dimen/box_score_max_width"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/sort_lineups_player_main_2"
        android:layout_width="42dp"
        android:layout_height="match_parent"
        android:textDirection="ltr"
        app:layout_constraintEnd_toStartOf="@+id/sort_lineups_player_main_3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintWidth_max="@dimen/box_score_max_width"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/sort_lineups_player_main_3"
        android:layout_width="42dp"
        android:layout_height="match_parent"
        android:textDirection="ltr"
        app:layout_constraintEnd_toStartOf="@+id/sort_lineups_player_main_4"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintWidth_max="@dimen/box_score_max_width"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/sort_lineups_player_main_4"
        android:layout_width="42dp"
        android:layout_height="match_parent"
        android:textDirection="ltr"
        app:layout_constraintEnd_toStartOf="@+id/rating_item"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintWidth_max="@dimen/box_score_max_width"
        style="@style/BodyMedium"/>
    <com.sofascore.results.view.SofascoreSmallRatingView
        android:id="@+id/rating_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:small_animateRating="false"/>
    <View
        android:id="@+id/sort_lineups_border"
        android:background="@color/n_lv_4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
