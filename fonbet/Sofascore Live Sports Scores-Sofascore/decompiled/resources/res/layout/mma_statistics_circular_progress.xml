<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="88dp"
    android:layout_height="88dp"
    android:animateLayoutChanges="true">
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/indicator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:max="1000"
        app:indicatorColor="@color/blue_fighter_default"
        app:indicatorInset="0dp"
        app:indicatorSize="88dp"
        app:trackColor="@color/blue_fighter_highlight"
        app:trackThickness="6dp"/>
    <TextView
        android:textColor="@color/primary_default"
        android:ellipsize="end"
        android:id="@+id/percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/indicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/indicator"
        style="@style/BodyMedium"/>
    <View
        android:id="@+id/highlight"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:scaleX="0"
        android:backgroundTint="@color/blue_fighter_highlight"
        app:layout_constraintBottom_toBottomOf="@+id/fraction_numerator"
        app:layout_constraintEnd_toEndOf="@+id/fraction_numerator"
        app:layout_constraintStart_toStartOf="@+id/fraction_numerator"
        app:layout_constraintTop_toTopOf="@+id/fraction_numerator"
        app:layout_constraintWidth_min="24dp"/>
    <TextView
        android:textColor="@color/primary_default"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/fraction_numerator"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/fraction_denominator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/slash"
        android:layout_width="8dp"
        android:layout_height="wrap_content"
        android:text="@string/slash"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/fraction_denominator"
        app:layout_constraintEnd_toStartOf="@+id/fraction_denominator"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/indicator"
        app:layout_constraintTop_toTopOf="@+id/fraction_denominator"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:id="@+id/fraction_denominator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/indicator"
        app:layout_constraintStart_toEndOf="@+id/slash"
        style="@style/BodyMedium"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/fraction_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="fraction_numerator, fraction_denominator, highlight, slash"/>
</androidx.constraintlayout.widget.ConstraintLayout>
