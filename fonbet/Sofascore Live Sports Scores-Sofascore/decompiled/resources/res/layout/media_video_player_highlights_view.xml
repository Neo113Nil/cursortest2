<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/youtube_player_holder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/overlay_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="thumbnail,play, media_cta_layout, overlay"/>
        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="H,16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/overlay"
            android:background="@color/darken_overlay_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/thumbnail"
            app:layout_constraintTop_toTopOf="@+id/thumbnail"/>
        <View
            android:id="@+id/youtube_click_area"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/media_cta_layout"
            app:layout_constraintDimensionRatio="H,16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/play"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_play_stream_initial"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/on_color_primary"/>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/on_color_primary"
            app:indicatorInset="4dp"
            app:indicatorSize="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp"/>
        <TextView
            android:textColor="@color/on_color_primary"
            android:gravity="center_vertical"
            android:id="@+id/info_text"
            android:background="@drawable/rounded_surface_level_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/match_highlights_title"
            android:drawablePadding="8dp"
            android:backgroundTint="@color/darken_overlay_3"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            app:drawableStartCompat="@drawable/ic_highlight_official_mark"
            app:drawableTint="@color/on_color_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/on_color_primary"
            android:id="@+id/live_stream_info_text"
            android:background="@drawable/rounded_surface_level_4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/livestream"
            android:drawablePadding="8dp"
            android:backgroundTint="@color/live"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            app:drawableStartCompat="@drawable/ic_video"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AssistiveDefault"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/media_cta_layout"
            android:background="@drawable/bottom_rounded_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/darken_overlay_3"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/youtube_player_holder"
            app:layout_constraintEnd_toEndOf="@+id/youtube_player_holder"
            app:layout_constraintStart_toStartOf="@+id/youtube_player_holder">
            <com.google.android.material.button.MaterialButton
                android:textColor="@color/graphics_dark"
                android:gravity="center"
                android:id="@+id/media_cta_button"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_more"
                android:drawablePadding="4dp"
                android:drawableEnd="@drawable/ic_more_media"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                app:backgroundTint="@color/on_color_primary"
                app:drawableTint="@color/graphics_dark"
                style="@style/TertiaryButtonStyle"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
