<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_1"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sofascore.results.profile.view.ProfileClickableRowView
            android:id="@+id/weekly_challenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableTint="@color/n_lv_1"
            app:layout_constraintTop_toTopOf="parent"
            app:pcri_DrawableResource="@drawable/ic_leagues_empty"
            app:pcri_LabelText="@string/weekly_challenge"/>
        <com.sofascore.results.profile.view.ProfileClickableRowView
            android:id="@+id/editor"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableTint="@color/n_lv_1"
            app:pcri_DrawableResource="@drawable/ic_editor"
            app:pcri_LabelText="@string/user_status_editor"/>
        <com.sofascore.results.profile.view.ProfileClickableRowView
            android:id="@+id/my_predictions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableTint="@color/n_lv_1"
            app:pcri_DrawableResource="@drawable/ic_predictions_menu"
            app:pcri_LabelText="@string/profile_my_predictions"/>
        <com.sofascore.results.profile.view.ProfileClickableRowView
            android:id="@+id/contributions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableTint="@color/n_lv_1"
            app:pcri_DrawableResource="@drawable/ic_crowdsourcing"
            app:pcri_LabelText="@string/contributions_tab_name"/>
        <com.sofascore.results.profile.view.ProfileClickableRowView
            android:id="@+id/leaderboards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableTint="@color/n_lv_1"
            app:pcri_DrawableResource="@drawable/ic_leaderboards"
            app:pcri_LabelText="@string/leaderboards_title"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
