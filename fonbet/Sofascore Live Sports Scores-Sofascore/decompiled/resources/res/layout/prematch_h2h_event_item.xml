<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/rectangle_4dp_corners"
    android:layout_width="wrap_content"
    android:layout_height="24dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:backgroundTint="@color/surface_2">
    <ImageView
        android:id="@+id/logo_home_team"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"/>
    <TextView
        android:id="@+id/score_home_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:layout_width="8dp"
        android:layout_height="wrap_content"
        android:text="@string/minus"
        android:textAlignment="center"
        style="@style/DisplayMicro"/>
    <TextView
        android:id="@+id/score_away_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/logo_away_team"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"/>
</LinearLayout>
