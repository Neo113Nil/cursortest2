<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/follow_button_root"
    android:background="@drawable/button_follow_selector"
    android:padding="8dp"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    style="@style/ElevationStyle">
    <TextView
        android:textColor="@color/primary_default"
        android:id="@+id/follow_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/follow"
        android:textAllCaps="true"
        android:layout_marginEnd="4dp"
        style="@style/ActionButtonSecondary"/>
    <ImageView
        android:id="@+id/follow_image"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_notification_deselected"
        app:tint="@color/primary_default"/>
</LinearLayout>
