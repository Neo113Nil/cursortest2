<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:minHeight="14dp"
        android:text="@string/betting_odds_play_responsibly"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMicro"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.5"/>
    <View
        android:id="@+id/divider"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:textColor="@color/primary_default"
        android:id="@+id/settings_link_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/odds_and_ads_adjust"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/ic_chevron"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/divider"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/ic_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/settings_link_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/settings_link_text"
        app:layout_constraintTop_toTopOf="@+id/settings_link_text"
        app:tint="@color/primary_default"/>
    <View
        android:id="@+id/click_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/settings_link_text"
        app:layout_constraintEnd_toEndOf="@+id/ic_chevron"
        app:layout_constraintStart_toStartOf="@+id/settings_link_text"
        app:layout_constraintTop_toTopOf="@+id/settings_link_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
