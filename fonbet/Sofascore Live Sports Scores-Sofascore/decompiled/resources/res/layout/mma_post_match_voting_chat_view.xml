<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="280dp"
    android:layout_height="104dp">
    <View
        android:id="@+id/background"
        android:background="@drawable/rounded_surface_level_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/surface_2"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="8dp"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mma_who_deserved_to_win"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background"/>
    <TextView
        android:textColor="@color/primary_default"
        android:gravity="center_vertical"
        android:id="@+id/text_vote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/vote"
        android:layout_marginEnd="16dp"
        app:drawableEndCompat="@drawable/ic_chevron_right_small_16"
        app:drawableTint="@color/primary_default"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background"
        style="@style/AssistiveDefault"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/logo_fighter_first"
        android:padding="1dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/background"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:shapeAppearanceOverlay="@style/CircleShapeOverlay"
        app:strokeWidth="1dp"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/logo_fighter_second"
        android:padding="1dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/background"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:shapeAppearanceOverlay="@style/CircleShapeOverlay"
        app:strokeWidth="1dp"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/text_fighter_name_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/background"
        app:layout_constraintEnd_toStartOf="@+id/text_vs"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/logo_fighter_first"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/text_vs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/versus"
        app:layout_constraintBottom_toBottomOf="@+id/background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/AssistiveMicro"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/text_fighter_name_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/background"
        app:layout_constraintEnd_toStartOf="@+id/logo_fighter_second"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/text_vs"
        style="@style/AssistiveMicro"/>
    <include
        android:id="@+id/win_marker_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/logo_fighter_first"
        app:layout_constraintTop_toTopOf="@+id/logo_fighter_first"
        layout="@layout/mma_winner_marker"/>
    <include
        android:id="@+id/win_marker_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/logo_fighter_second"
        app:layout_constraintTop_toTopOf="@+id/logo_fighter_first"
        layout="@layout/mma_winner_marker"/>
    <include
        android:id="@+id/draw_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/logo_fighter_first"
        layout="@layout/mma_draw_layout"/>
    <View
        android:id="@+id/progress_view_first"
        android:background="@drawable/rectangle_4dp_corners_left"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="1dp"
        android:backgroundTint="@color/red_fighter_default"
        app:layout_constraintBottom_toTopOf="@+id/text_fighter_name_first"
        app:layout_constraintEnd_toStartOf="@+id/progress_view_second"
        app:layout_constraintHorizontal_weight="33"
        app:layout_constraintStart_toStartOf="@+id/text_fighter_name_first"/>
    <View
        android:id="@+id/progress_view_second"
        android:background="@drawable/rectangle_4dp_corners_right"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginBottom="2dp"
        android:backgroundTint="@color/blue_fighter_default"
        app:layout_constraintBottom_toTopOf="@+id/text_fighter_name_second"
        app:layout_constraintEnd_toEndOf="@+id/text_fighter_name_second"
        app:layout_constraintHorizontal_weight="33"
        app:layout_constraintStart_toEndOf="@+id/progress_view_first"/>
    <TextView
        android:textColor="@color/red_fighter_default"
        android:id="@+id/text_vote_result_first"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_view_first"
        app:layout_constraintStart_toStartOf="@+id/text_fighter_name_first"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/blue_fighter_default"
        android:id="@+id/text_vote_result_second"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_view_first"
        app:layout_constraintEnd_toEndOf="@+id/text_fighter_name_second"
        style="@style/BodySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
