<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/avatarImageView"
        android:background="@drawable/blaze_drawable_circle_border"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/chipImageView"
        android:background="@drawable/blaze_drawable_background_cta"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        app:layout_constraintCircle="@+id/avatarImageView"
        app:layout_constraintCircleAngle="180"
        app:layout_constraintCircleRadius="@dimen/blaze_follow_entity_chip_base_radius"/>
</androidx.constraintlayout.widget.ConstraintLayout>
