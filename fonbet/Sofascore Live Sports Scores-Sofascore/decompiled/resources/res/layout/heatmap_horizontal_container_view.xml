<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/field_container"
        android:background="@drawable/rounded_surface_level_1"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:backgroundTint="@color/terrain_football">
        <ImageView
            android:id="@+id/heat_map_arrow"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_terrain_arrow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/surface_1"/>
        <ImageView
            android:id="@+id/heat_map"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/field_lines"
            app:layout_constraintEnd_toEndOf="@+id/field_lines"
            app:layout_constraintStart_toStartOf="@+id/field_lines"
            app:layout_constraintTop_toTopOf="@+id/field_lines"
            app:layout_constraintWidth_max="360dp"/>
        <ImageView
            android:id="@+id/field_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_football_heatmap_lines"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="48dp"
            app:layout_constraintTop_toBottomOf="@+id/heat_map_arrow"
            app:layout_constraintWidth_max="360dp"
            app:tint="@color/surface_1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
