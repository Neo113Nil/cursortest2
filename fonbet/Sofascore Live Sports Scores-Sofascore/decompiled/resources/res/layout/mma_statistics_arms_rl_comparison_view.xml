<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/arm_right_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/right_arm_zone_men"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/torso_home_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/transparent"/>
    <ImageView
        android:id="@+id/arm_left_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/left_arm_zone_men"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/torso_home_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/transparent"/>
    <ImageView
        android:id="@+id/torso_home_outline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/men_body_outline"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/text_box_primary"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/torso_home_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_home_outline"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/mma_statistics_rl_marker"/>
    <ImageView
        android:id="@+id/arm_right_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/right_arm_zone_men"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/torso_away_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/transparent"/>
    <ImageView
        android:id="@+id/arm_left_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/left_arm_zone_men"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/torso_away_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/transparent"/>
    <ImageView
        android:id="@+id/torso_away_outline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/men_body_outline"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text_box_primary"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/torso_away_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_away_outline"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/mma_statistics_rl_marker"/>
    <include
        android:id="@+id/text_box_primary"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_marginStart="-8dp"
        android:layout_marginEnd="-8dp"
        app:layout_constraintBottom_toTopOf="@+id/text_box_secondary"
        app:layout_constraintEnd_toStartOf="@+id/torso_away_outline"
        app:layout_constraintStart_toEndOf="@+id/torso_home_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        layout="@layout/mma_statistics_body_graph_text_container"/>
    <include
        android:id="@+id/text_box_secondary"
        android:layout_width="160dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/text_box_primary"
        app:layout_constraintStart_toStartOf="@+id/text_box_primary"
        app:layout_constraintTop_toBottomOf="@+id/text_box_primary"
        layout="@layout/mma_statistics_body_graph_text_container"/>
    <View
        android:background="@color/surface_1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="@+id/torso_home_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_home_outline"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/surface_1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/torso_home_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_home_outline"/>
    <View
        android:background="@color/surface_1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="@+id/torso_away_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_away_outline"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/surface_1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/torso_away_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_away_outline"/>
    <View
        android:background="@color/n_lv_4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/torso_away_outline"
        app:layout_constraintStart_toEndOf="@+id/torso_home_outline"/>
    <View
        android:background="@color/n_lv_4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toStartOf="@+id/torso_away_outline"
        app:layout_constraintStart_toEndOf="@+id/torso_home_outline"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
