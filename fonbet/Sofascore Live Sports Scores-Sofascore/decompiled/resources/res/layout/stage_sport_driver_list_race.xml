<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/layout_container"
    android:background="@drawable/rectangle_8dp_corners"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="16dp"
    android:backgroundTint="@color/surface_1"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:paddingVertical="12dp">
    <ImageView
        android:id="@+id/stage_sport_main_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/stage_sport_main_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/stage_sport_date_text"
        app:layout_constraintEnd_toStartOf="@+id/stage_sport_top_trophy"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/stage_sport_main_logo"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodyLarge"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="start"
        android:gravity="end"
        android:id="@+id/stage_sport_category_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewEnd"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/stage_sport_main_text"
        app:layout_constraintTop_toTopOf="@+id/stage_sport_main_text"
        style="@style/BodySmall"/>
    <ImageView
        android:id="@+id/stage_sport_top_trophy"
        android:background="@drawable/ic_trophy_16"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/stage_sport_category_text"
        app:layout_constraintEnd_toStartOf="@+id/stage_sport_category_text"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/stage_sport_date_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stage_sport_bottom_trophy"
        app:layout_constraintStart_toStartOf="@+id/stage_sport_main_text"
        app:layout_constraintTop_toBottomOf="@+id/stage_sport_main_text"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/stage_sport_bottom_trophy"
        android:background="@drawable/ic_trophy_16"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="4dp"
        android:backgroundTint="@color/value"
        app:layout_constraintBottom_toBottomOf="@+id/stage_sport_date_text"
        app:layout_constraintEnd_toStartOf="@+id/stage_sport_winner_text"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/stage_sport_winner_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/stage_sport_date_text"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/BodySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
