<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/season"
        android:layout_weight="1"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center_horizontal"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:text="@string/motorsport_races_short"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center_horizontal"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="@string/motorsport_podiums_short"
        android:layout_marginStart="8dp"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center_horizontal"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="@string/win_short"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center_horizontal"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:text="@string/motorsport_pole_positions_short"
        android:layout_marginStart="8dp"
        style="@style/TableMedium"/>
</LinearLayout>
