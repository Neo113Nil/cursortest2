<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/additional_info_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/info_container_barrier"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/info_container_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="first_sub_team_name, second_sub_team_name"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/names_bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="first_team_name, second_team_name"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/toolbar_barrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="56dp"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/event_date"
        android:background="@drawable/rectangle_16dp_corners"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:backgroundTint="@color/on_color_highlight_2"
        app:layout_constraintBottom_toTopOf="@+id/first_team_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_barrier"
        style="@style/BodySmall"/>
    <com.sofascore.results.view.follownotification.FollowActionButton
        android:id="@+id/bell_button_first_team"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_star_empty"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"
        app:shown_in_header="true"/>
    <com.sofascore.results.view.header.TeamLogoView
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/first_team_logo"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/first_team_name"
        app:layout_constraintStart_toEndOf="@+id/bell_button_first_team"
        app:layout_constraintTop_toBottomOf="@+id/event_date"
        app:layout_goneMarginStart="48dp"/>
    <TextView
        android:textColor="@color/graphics_dark"
        android:gravity="center"
        android:id="@+id/first_bonus_indicator"
        android:background="@drawable/rectangle_8dp_corners"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="24dp"
        android:minHeight="16dp"
        android:text="@string/basketball_bonus_short"
        android:backgroundTint="@color/stayDarkValue"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_logo"
        app:layout_constraintEnd_toEndOf="@+id/first_team_logo"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/on_color_primary"
        android:ellipsize="middle"
        android:gravity="center_horizontal"
        android:id="@+id/first_team_name"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/first_sub_team_name"
        app:layout_constraintEnd_toEndOf="@+id/first_team_logo"
        app:layout_constraintStart_toStartOf="@+id/first_team_logo"
        app:layout_constraintTop_toBottomOf="@+id/first_team_logo"
        app:layout_goneMarginBottom="8dp"
        style="@style/DisplayMicro"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/on_color_primary"
        android:ellipsize="middle"
        android:gravity="center_horizontal"
        android:id="@+id/first_sub_team_name"
        android:visibility="gone"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/additional_info_container"
        app:layout_constraintEnd_toEndOf="@+id/first_team_logo"
        app:layout_constraintStart_toStartOf="@+id/first_team_logo"
        style="@style/DisplayMicro"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/result"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"/>
    <com.sofascore.results.view.header.TeamLogoView
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/second_team_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/bell_button_second_team"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"
        app:layout_goneMarginEnd="48dp"/>
    <TextView
        android:textColor="@color/graphics_dark"
        android:gravity="center"
        android:id="@+id/second_bonus_indicator"
        android:background="@drawable/rectangle_8dp_corners"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="24dp"
        android:minHeight="16dp"
        android:text="@string/basketball_bonus_short"
        android:backgroundTint="@color/stayDarkValue"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_logo"
        app:layout_constraintStart_toStartOf="@+id/second_team_logo"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/on_color_primary"
        android:ellipsize="middle"
        android:gravity="center_horizontal"
        android:id="@+id/second_team_name"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/second_sub_team_name"
        app:layout_constraintEnd_toEndOf="@+id/second_team_logo"
        app:layout_constraintStart_toStartOf="@+id/second_team_logo"
        app:layout_constraintTop_toBottomOf="@+id/second_team_logo"
        app:layout_goneMarginBottom="8dp"
        style="@style/DisplayMicro"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/on_color_primary"
        android:ellipsize="middle"
        android:gravity="center_horizontal"
        android:id="@+id/second_sub_team_name"
        android:visibility="gone"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/additional_info_container"
        app:layout_constraintEnd_toEndOf="@+id/second_team_logo"
        app:layout_constraintStart_toStartOf="@+id/second_team_logo"
        style="@style/DisplayMicro"/>
    <com.sofascore.results.view.follownotification.FollowActionButton
        android:id="@+id/bell_button_second_team"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_star_empty"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/second_team_logo"
        app:shown_in_header="true"/>
    <TextView
        android:textColor="@color/stayDarkLive"
        android:gravity="center"
        android:id="@+id/timeouts_text"
        android:background="@drawable/rectangle_12dp_corners"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minHeight="16dp"
        android:drawablePadding="2dp"
        android:backgroundTint="@color/score_highlight"
        android:paddingHorizontal="4dp"
        app:drawableTint="@color/stayDarkLive"
        app:layout_constraintBottom_toTopOf="@+id/additional_info_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/names_bottom_barrier"
        app:layout_constraintVertical_bias="0"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/on_color_secondary"
        android:gravity="center"
        android:id="@+id/first_to_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:text="@string/basketball_status_timeout_short"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/timeouts_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/timeouts_text"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/on_color_secondary"
        android:gravity="center"
        android:id="@+id/second_to_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:text="@string/basketball_status_timeout_short"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/timeouts_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/timeouts_text"
        style="@style/AssistiveDefault"/>
    <com.sofascore.results.view.header.TimeoutsView
        android:id="@+id/first_timeouts"
        android:layout_width="82dp"
        android:layout_height="4dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/timeouts_text"
        app:layout_constraintEnd_toStartOf="@+id/timeouts_text"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/first_to_label"
        app:layout_constraintTop_toTopOf="@+id/timeouts_text"/>
    <com.sofascore.results.view.header.TimeoutsView
        android:id="@+id/second_timeouts"
        android:layout_width="82dp"
        android:layout_height="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/timeouts_text"
        app:layout_constraintEnd_toStartOf="@+id/second_to_label"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/timeouts_text"
        app:layout_constraintTop_toTopOf="@+id/timeouts_text"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/timeouts_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="timeouts_text, first_to_label, second_to_label, first_timeouts, second_timeouts"/>
</androidx.constraintlayout.widget.ConstraintLayout>
