<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="104dp">
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/left_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/cricket_score_divider"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/on_color_primary"
            android:gravity="end"
            android:id="@+id/inning_first_team_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewEnd"
            style="@style/DisplayMedium"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/on_color_primary"
            android:gravity="end"
            android:id="@+id/inning_first_team_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewEnd"
            style="@style/DisplayMedium"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/on_color_secondary"
            android:ellipsize="end"
            android:id="@+id/overs_first_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:textAlignment="viewEnd"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
    <View
        android:id="@+id/cricket_score_divider"
        android:background="@color/on_color_primary"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/right_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/cricket_score_divider"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/on_color_primary"
            android:gravity="start"
            android:id="@+id/inning_second_team_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            style="@style/DisplayMedium"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/on_color_primary"
            android:gravity="start"
            android:id="@+id/inning_second_team_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            style="@style/DisplayMedium"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/on_color_secondary"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/overs_second_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:textAlignment="viewStart"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
