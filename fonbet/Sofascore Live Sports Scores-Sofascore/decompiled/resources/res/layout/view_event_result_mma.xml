<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="104dp">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/result_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="result_first,result_slash,result_second"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/on_color_primary"
        android:id="@+id/result_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/result_slash"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/result_slash"
        style="@style/DisplayExtraLarge"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/result_slash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" - "
        app:layout_constraintEnd_toStartOf="@+id/result_second"
        app:layout_constraintStart_toEndOf="@+id/result_first"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayExtraLarge"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/on_color_primary"
        android:id="@+id/result_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/result_slash"
        app:layout_constraintTop_toTopOf="@+id/result_slash"
        style="@style/DisplayExtraLarge"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/text_primary"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayLarge"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="text_primary,result_first"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/text_secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:autoSizeMaxTextSize="14dp"
        app:autoSizeMinTextSize="8dp"
        app:autoSizeStepGranularity="1dp"
        app:autoSizeTextType="uniform"
        app:barrierAllowsGoneWidgets="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier"
        style="@style/BodyMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
