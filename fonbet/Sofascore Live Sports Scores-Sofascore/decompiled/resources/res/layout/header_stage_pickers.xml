<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <com.sofascore.results.view.typeheader.SegmentedButtonsView
        android:id="@+id/header_sub_stage_types"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sofascore.results.view.typeheader.TypeHeaderView
        android:id="@+id/header_sub_stages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_sub_stage_types"/>
    <com.sofascore.results.stagesport.StageFeaturedOddsView
        android:id="@+id/odds_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_sub_stages"/>
    <TextView
        android:textColor="@color/color_selector_n_lv_1_to_live"
        android:gravity="start|center_vertical"
        android:id="@+id/time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="32dp"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/status_label"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/odds_view"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/surface_1"
        android:id="@+id/status_label"
        android:background="@drawable/rectangle_12dp_corners"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/canceled"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/error"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/no_results"
        style="@style/AssistiveDefault"/>
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_thickness"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_text"/>
    <include
        android:id="@+id/cycling_stage_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        layout="@layout/cycling_stage_info"/>
    <com.sofascore.results.view.typeheader.TypeHeaderView
        android:id="@+id/header_result_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cycling_stage_info"/>
    <com.sofascore.results.redesign.emptystateblocks.GraphicLarge
        android:gravity="center"
        android:id="@+id/no_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:graphicLargeDrawable="@drawable/race_start"
        app:graphicLargeSubtitle="@string/motorsport_results_empty_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_result_type"/>
</androidx.constraintlayout.widget.ConstraintLayout>
