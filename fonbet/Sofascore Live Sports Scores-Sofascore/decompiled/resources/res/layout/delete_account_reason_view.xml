<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/rounded_surface_level_1"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete_account_main_reason"
            style="@style/DisplayMedium"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_one"
            style="@style/AssistiveDefault"/>
        <RadioGroup
            android:id="@+id/reasons_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <RadioButton
                android:id="@+id/radio_too_many"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete_account_reason_too_many"
                android:paddingStart="12dp"
                android:buttonTint="@color/primary_default"
                style="@style/BodyMedium"/>
            <RadioButton
                android:id="@+id/radio_no_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete_account_reason_no_value"
                android:paddingStart="12dp"
                android:buttonTint="@color/primary_default"
                style="@style/BodyMedium"/>
            <RadioButton
                android:id="@+id/radio_something_else"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete_account_reason_something_else"
                android:paddingStart="12dp"
                android:buttonTint="@color/primary_default"
                style="@style/BodyMedium"/>
        </RadioGroup>
        <com.sofascore.results.view.InformationView
            android:id="@+id/info_bubble_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <Space
        android:id="@+id/spacer_bottom"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.google.android.material.button.MaterialButton
        android:enabled="false"
        android:id="@+id/continue_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_continue"
        android:layout_marginHorizontal="24dp"
        style="@style/ButtonFilledPrimary"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/primary_default"
        android:id="@+id/cancel_button"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/cancel"
        android:layout_marginHorizontal="24dp"
        style="@style/ButtonFilledDefault"/>
</LinearLayout>
