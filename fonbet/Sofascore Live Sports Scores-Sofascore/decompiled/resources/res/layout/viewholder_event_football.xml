<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:paddingVertical="4dp">
    <View
        android:id="@+id/highlight"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/time_upper"
        android:nextFocusLeft="@+id/time_lower"
        android:nextFocusRight="@+id/time_lower"
        android:nextFocusUp="@+id/time_lower"
        android:nextFocusDown="@+id/time_lower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:nextFocusForward="@+id/time_lower"
        android:textDirection="ltr"
        android:layout_marginHorizontal="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/time_lower"
        app:layout_constraintEnd_toStartOf="@+id/vertical_guideline_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/BodySmall"/>
    <com.sofascore.results.view.EventListScoreTextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/time_lower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:accessibilityTraversalAfter="@+id/time_upper"
        android:layout_marginHorizontal="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintEnd_toStartOf="@+id/vertical_guideline_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_upper"
        app:styleVariant="status"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/vertical_guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="72dp"/>
    <ImageView
        android:id="@+id/first_team_logo"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_name"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline_start"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/first_team_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="16dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/second_team_name"
        app:layout_constraintEnd_toStartOf="@+id/first_team_red_card"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="8dp"
        app:layout_goneMarginStart="0dp"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/first_team_red_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_name"
        app:layout_constraintEnd_toStartOf="@+id/indicator_crowdsourcing"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/first_team_name"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"
        style="@style/BodySmall"/>
    <ImageView
        android:id="@+id/second_team_logo"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline_start"
        app:layout_constraintTop_toTopOf="@+id/second_team_name"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/second_team_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:minHeight="16dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toStartOf="@+id/second_team_red_card"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/second_team_logo"
        app:layout_constraintTop_toBottomOf="@+id/first_team_name"
        app:layout_goneMarginBottom="6dp"
        app:layout_goneMarginEnd="8dp"
        app:layout_goneMarginStart="0dp"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/live"
        android:ellipsize="end"
        android:id="@+id/description"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_layout"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/first_team_logo"
        app:layout_constraintTop_toBottomOf="@+id/second_team_name"
        app:layout_goneMarginEnd="8dp"
        app:layout_goneMarginStart="8dp"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/second_team_red_card"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintEnd_toStartOf="@+id/indicator_crowdsourcing"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/second_team_name"
        app:layout_constraintTop_toTopOf="@+id/second_team_name"
        style="@style/BodySmall"/>
    <ImageView
        android:id="@+id/var_indicator"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_var"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintEnd_toStartOf="@+id/score_game_start_barrier"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"
        app:tint="@color/live"/>
    <ImageView
        android:id="@+id/live_stream_indicator"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_live_stream_indicator"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintEnd_toStartOf="@+id/var_indicator"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"/>
    <ImageView
        android:id="@+id/indicator_crowdsourcing"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_crowdsourcing"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/live_stream_indicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="8dp"
        app:tint="@color/color_crowdsourcing_icon"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/score_game_start_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="first_team_score_set,second_team_score_set"/>
    <com.sofascore.results.view.EventListScoreTextView
        android:gravity="end"
        android:id="@+id/first_team_score_set"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_name"
        app:layout_constraintEnd_toStartOf="@+id/score_current_start_barrier"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"/>
    <com.sofascore.results.view.EventListScoreTextView
        android:gravity="end"
        android:id="@+id/second_team_score_set"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintEnd_toEndOf="@+id/first_team_score_set"
        app:layout_constraintTop_toTopOf="@+id/second_team_name"/>
    <com.sofascore.results.view.EventListScoreTextView
        android:gravity="end"
        android:id="@+id/first_team_score_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_name"
        app:layout_constraintEnd_toStartOf="@+id/action_layout"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"/>
    <com.sofascore.results.view.EventListScoreTextView
        android:gravity="end"
        android:id="@+id/second_team_score_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintEnd_toStartOf="@+id/action_layout"
        app:layout_constraintTop_toTopOf="@+id/second_team_name"/>
    <ImageView
        android:id="@+id/first_team_aggregated_win"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_aggregate_pointer"
        android:layout_marginStart="-2dp"
        app:layout_constraintStart_toStartOf="@+id/action_layout"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"
        app:tint="@color/n_lv_1"/>
    <ImageView
        android:id="@+id/second_team_aggregated_win"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_aggregate_pointer"
        android:layout_marginStart="-2dp"
        app:layout_constraintStart_toStartOf="@+id/action_layout"
        app:layout_constraintTop_toTopOf="@+id/second_team_name"
        app:tint="@color/n_lv_1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/score_current_start_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="first_team_score_current,second_team_score_current"/>
    <include
        android:id="@+id/action_layout"
        android:layout_width="56dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"
        layout="@layout/event_row_end_action"/>
</androidx.constraintlayout.widget.ConstraintLayout>
