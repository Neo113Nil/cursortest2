<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <LinearLayout
        android:gravity="bottom"
        android:id="@+id/progress_view_header"
        android:paddingTop="8dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/header_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BodySmall"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:gravity="end"
            android:id="@+id/header_middle_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="@style/BodySmall"/>
        <TextView
            android:textColor="@color/live"
            android:id="@+id/header_end_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            style="@style/BodySmall"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progress_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingVertical="6dp">
        <TextView
            android:textColor="@color/live"
            android:id="@+id/current_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AssistiveDefault"/>
        <ProgressBar
            android:id="@+id/regular_time_progress"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:progress="0"
            android:indeterminateOnly="false"
            android:progressDrawable="@drawable/graph_timeline_progress_red"
            android:rotationY="@integer/rtl_rotation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/extra_time_progress"
            app:layout_constraintHorizontal_weight="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/start_circle"
            android:background="@drawable/progress_view_green_circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/regular_time_progress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/regular_time_progress"/>
        <View
            android:id="@+id/middle_circle"
            android:background="@drawable/progress_view_empty_circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/regular_time_progress"
            app:layout_constraintEnd_toEndOf="@+id/regular_time_progress"
            app:layout_constraintStart_toStartOf="@+id/regular_time_progress"
            app:layout_constraintTop_toTopOf="@+id/regular_time_progress"/>
        <View
            android:id="@+id/end_circle"
            android:background="@drawable/progress_view_empty_circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/regular_time_progress"
            app:layout_constraintEnd_toEndOf="@+id/regular_time_progress"
            app:layout_constraintTop_toTopOf="@+id/regular_time_progress"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/ht_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HT"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/middle_circle"
            app:layout_constraintStart_toStartOf="@+id/middle_circle"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/ft_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FT"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/end_circle"
            style="@style/AssistiveDefault"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/extra_time_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="extra_time_progress, extra_middle_circle, extra_end_circle, et1_text, et_ft_text"/>
        <ProgressBar
            android:id="@+id/extra_time_progress"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:progress="0"
            android:indeterminateOnly="false"
            android:progressDrawable="@drawable/graph_timeline_progress_red"
            android:rotationY="@integer/rtl_rotation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/regular_time_progress"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/extra_middle_circle"
            android:background="@drawable/progress_view_empty_circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/extra_time_progress"
            app:layout_constraintEnd_toEndOf="@+id/extra_time_progress"
            app:layout_constraintStart_toStartOf="@+id/extra_time_progress"
            app:layout_constraintTop_toTopOf="@+id/extra_time_progress"/>
        <View
            android:id="@+id/extra_end_circle"
            android:background="@drawable/progress_view_empty_circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/extra_time_progress"
            app:layout_constraintEnd_toEndOf="@+id/extra_time_progress"
            app:layout_constraintTop_toTopOf="@+id/extra_time_progress"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/et1_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ET1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/extra_middle_circle"
            app:layout_constraintStart_toStartOf="@+id/extra_middle_circle"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/et_ft_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ET2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/extra_end_circle"
            style="@style/AssistiveDefault"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
