<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/container"
        android:background="@drawable/rectangle_8dp_corners"
        android:layout_width="match_parent"
        android:layout_height="262dp"
        android:backgroundTint="@color/surface_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"/>
    <com.sofascore.results.event.graphs.view.CricketBowlerGraphView
        android:id="@+id/bowler_graph"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/container"
        app:layout_constraintEnd_toEndOf="@+id/container"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/description_container"
        app:layout_constraintTop_toTopOf="@+id/container"
        app:layout_constraintWidth_max="260dp"/>
    <ImageView
        android:id="@+id/wicket_image"
        android:layout_width="28dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_wickets"
        android:translationY="1.7dp"
        app:layout_constraintBottom_toTopOf="@+id/bowler_graph"
        app:layout_constraintEnd_toEndOf="@+id/bowler_graph"
        app:layout_constraintStart_toStartOf="@+id/bowler_graph"
        app:layout_constraintTop_toTopOf="@+id/bowler_graph"/>
    <TextView
        android:textColor="@color/cricket_terrain_secondary"
        android:id="@+id/wicket_text_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toStartOf="@+id/wicket_image"
        app:layout_constraintStart_toStartOf="@+id/bowler_graph"
        app:layout_constraintTop_toTopOf="@+id/bowler_graph"
        style="@style/TableSmall"/>
    <TextView
        android:textColor="@color/cricket_terrain_secondary"
        android:id="@+id/wicket_text_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/bowler_graph"
        app:layout_constraintStart_toEndOf="@+id/wicket_image"
        app:layout_constraintTop_toTopOf="@+id/bowler_graph"
        style="@style/TableSmall"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/description_container"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/container"
        app:layout_constraintStart_toStartOf="@+id/container"
        app:layout_constraintTop_toTopOf="@+id/container">
        <include
            android:id="@+id/yorker_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toTopOf="@+id/full_length_description"
            app:layout_constraintStart_toStartOf="@+id/container"
            app:layout_constraintTop_toTopOf="@+id/container"
            app:layout_constraintVertical_chainStyle="spread"
            layout="@layout/cricket_bowler_zone_description"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <include
            android:id="@+id/full_length_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/good_length_description"
            app:layout_constraintStart_toStartOf="@+id/yorker_description"
            app:layout_constraintTop_toBottomOf="@+id/yorker_description"
            layout="@layout/cricket_bowler_zone_description"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <include
            android:id="@+id/good_length_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/short_description"
            app:layout_constraintStart_toStartOf="@+id/full_length_description"
            app:layout_constraintTop_toBottomOf="@+id/full_length_description"
            layout="@layout/cricket_bowler_zone_description"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <include
            android:id="@+id/short_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/container"
            app:layout_constraintStart_toStartOf="@+id/good_length_description"
            app:layout_constraintTop_toBottomOf="@+id/good_length_description"
            layout="@layout/cricket_bowler_zone_description"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
