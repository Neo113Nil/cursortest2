<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingVertical="16dp">
    <TextView
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayLarge"/>
    <TextView
        android:id="@+id/ban_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="viewStart"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/BodyMediumParagraph"/>
    <RadioGroup
        android:id="@+id/ban_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/ban_message">
        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ban_reason_fake_score"
            android:textAlignment="viewStart"
            android:paddingStart="12dp"
            android:buttonTint="@color/primary_default"
            style="@style/BodyMedium"/>
        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ban_reason_cursing"
            android:textAlignment="viewStart"
            android:paddingStart="12dp"
            android:buttonTint="@color/primary_default"
            style="@style/BodyMedium"/>
        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ban_reason_insulting"
            android:textAlignment="viewStart"
            android:paddingStart="12dp"
            android:buttonTint="@color/primary_default"
            style="@style/BodyMedium"/>
        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ban_reason_advertising"
            android:textAlignment="viewStart"
            android:paddingStart="12dp"
            android:buttonTint="@color/primary_default"
            style="@style/BodyMedium"/>
        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/other"
            android:textAlignment="viewStart"
            android:paddingStart="12dp"
            android:buttonTint="@color/primary_default"
            style="@style/BodyMedium"/>
    </RadioGroup>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/description_text_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/text_field_tell_us_why"
        android:textAlignment="viewStart"
        android:importantForAutofill="noExcludeDescendants"
        app:helperText="@string/hint_optional"
        app:helperTextTextAppearance="@style/AssistiveDefault"
        app:hintAnimationEnabled="false"
        app:layout_constraintTop_toBottomOf="@+id/ban_radio_group"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:textColor="@color/n_lv_1"
            android:textColorHint="@color/n_lv_3"
            android:id="@+id/ban_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:textAlignment="viewStart"
            style="@style/BodyLarge"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/primary_default"
        android:id="@+id/cancel_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/cancel"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textAllCaps="true"
        android:fontFamily="@font/sofascore_sans_bold"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/surface_P"
        android:letterSpacing="0.04"
        app:layout_constraintBottom_toBottomOf="@+id/action_button"
        app:layout_constraintEnd_toStartOf="@+id/action_button"
        app:layout_constraintTop_toTopOf="@+id/action_button"
        style="@style/NegativeButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:enabled="false"
        android:textAppearance="@style/ActionButtonPrimary"
        android:id="@+id/action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="36dp"
        android:text="@string/button_ban_user"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textAllCaps="true"
        android:fontFamily="@font/sofascore_sans_bold"
        android:backgroundTint="@color/neutral_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_text_layout"
        style="@style/ButtonFilledPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
