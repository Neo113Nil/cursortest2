<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/league_info_grid"
        layout="@layout/league_details_info"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/league_info_upper"
            layout="@layout/league_details_view"/>
        <include
            android:id="@+id/league_info_newcomers_upper"
            layout="@layout/league_details_view"/>
        <include
            android:id="@+id/league_info_subtitle_lower"
            layout="@layout/league_details_view"/>
        <include
            android:id="@+id/league_info_newcomers_lower"
            layout="@layout/league_details_view"/>
        <include
            android:id="@+id/league_info_newcomers_other"
            layout="@layout/league_details_view"/>
        <include
            android:id="@+id/league_info_qualification_tournaments"
            layout="@layout/league_details_view"/>
        <include
            android:id="@+id/league_info_facts"
            layout="@layout/league_details_view"/>
        <include
            android:id="@+id/league_info_host"
            layout="@layout/league_details_view"/>
    </LinearLayout>
</LinearLayout>
