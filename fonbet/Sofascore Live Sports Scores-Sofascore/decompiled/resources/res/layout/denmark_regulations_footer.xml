<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <ImageView
        android:id="@+id/ic_18_plus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_18_plus"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/n_lv_3"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:minHeight="14dp"
        android:text="Spil ansvarligt"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/link_1"
        app:layout_constraintStart_toEndOf="@+id/ic_18_plus"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/primary_default"
        android:id="@+id/link_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:text="StopSpillet.dk"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/ic_chevron_1"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_1"
        app:layout_constraintStart_toEndOf="@+id/link_1"
        app:layout_constraintTop_toTopOf="@+id/link_1"
        app:tint="@color/primary_default"/>
    <View
        android:id="@+id/click_area_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_1"
        app:layout_constraintEnd_toEndOf="@+id/ic_chevron_1"
        app:layout_constraintStart_toStartOf="@+id/link_1"
        app:layout_constraintTop_toTopOf="@+id/link_1"/>
    <View
        android:id="@+id/divider"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_1"
        app:layout_constraintStart_toEndOf="@+id/ic_chevron_1"
        app:layout_constraintTop_toTopOf="@+id/link_1"/>
    <TextView
        android:textColor="@color/primary_default"
        android:id="@+id/link_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selvudelukkelse: ROFUS.nu"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_1"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/link_1"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/ic_chevron_2"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_1"
        app:layout_constraintStart_toEndOf="@+id/link_2"
        app:layout_constraintTop_toTopOf="@+id/link_1"
        app:tint="@color/primary_default"/>
    <View
        android:id="@+id/click_area_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_2"
        app:layout_constraintEnd_toEndOf="@+id/ic_chevron_2"
        app:layout_constraintStart_toStartOf="@+id/link_2"
        app:layout_constraintTop_toTopOf="@+id/link_2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
