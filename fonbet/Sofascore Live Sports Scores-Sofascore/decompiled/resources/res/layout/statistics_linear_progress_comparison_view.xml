<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <ProgressBar
        android:id="@+id/indicator_home"
        android:background="@drawable/rectangle_4dp_corners"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:max="1000"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/event_statistics_progress"
        android:scaleX="@integer/drawable_scaleX_flipped"
        android:layout_marginEnd="4dp"
        android:progressTint="@color/home_primary"
        android:backgroundTint="@color/n_lv_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/indicator_away"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_layout_home"
        app:layout_constraintVertical_bias="0"/>
    <ProgressBar
        android:id="@+id/indicator_away"
        android:background="@drawable/rectangle_4dp_corners"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:max="1000"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/event_statistics_progress"
        android:scaleX="@integer/drawable_scaleX_normal"
        android:layout_marginStart="4dp"
        android:progressTint="@color/away_primary"
        android:backgroundTint="@color/n_lv_5"
        app:layout_constraintBottom_toBottomOf="@+id/indicator_home"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/indicator_home"
        app:layout_constraintTop_toTopOf="@+id/indicator_home"/>
    <include
        android:textColor="@color/primary_default"
        android:id="@+id/text_layout_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline_start"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/mma_statistics_fraction_text_layout"/>
    <include
        android:textColor="@color/primary_default"
        android:id="@+id/text_layout_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/text_layout_home"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/guideline_end"
        app:layout_constraintTop_toTopOf="@+id/text_layout_home"
        layout="@layout/mma_statistics_fraction_text_layout"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/text_layout_home"
        app:layout_constraintEnd_toStartOf="@+id/guideline_end"
        app:layout_constraintStart_toEndOf="@+id/guideline_start"
        app:layout_constraintTop_toTopOf="@+id/text_layout_home"
        style="@style/AssistiveDefault"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="72dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="72dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
