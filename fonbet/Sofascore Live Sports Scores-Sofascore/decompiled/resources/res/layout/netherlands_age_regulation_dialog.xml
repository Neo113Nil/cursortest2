<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="312dp"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">
    <TextView
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/age_verification_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayLarge"/>
    <TextView
        android:gravity="start"
        android:id="@+id/question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/age_verification_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/BodyMedium"/>
    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/question">
        <RadioButton
            android:id="@+id/age_25_or_older"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/age_verification_over_25"
            android:paddingStart="12dp"
            android:buttonTint="@color/primary_default"
            style="@style/BodyMedium"/>
        <RadioButton
            android:id="@+id/age_18_to_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/age_verification_18_to_24"
            android:paddingStart="12dp"
            android:buttonTint="@color/primary_default"
            style="@style/BodyMedium"/>
        <RadioButton
            android:id="@+id/age_under_18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/age_verification_under_18"
            android:paddingStart="12dp"
            android:buttonTint="@color/primary_default"
            style="@style/BodyMedium"/>
    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>
