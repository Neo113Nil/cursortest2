<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingStart="16dp">
    <TextView
        android:textColor="@color/primary_default"
        android:gravity="start|center_vertical"
        android:id="@+id/legend_button"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/legend"
        android:drawablePadding="2dp"
        android:textAlignment="gravity"
        app:drawableEndCompat="@drawable/ic_indicator_info_16"
        app:drawableTint="@color/primary_default"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/left_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/left_button"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_advantage_arrow_left_8"
        android:rotationY="@integer/rtl_rotation"
        android:layout_marginStart="124dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:tint="@color/n_lv_3"/>
    <com.sofascore.common.widget.ScrollInterceptorHorizontalScrollView
        android:id="@+id/scroller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_button"
        app:layout_constraintStart_toEndOf="@+id/left_button"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </com.sofascore.common.widget.ScrollInterceptorHorizontalScrollView>
    <ImageView
        android:id="@+id/right_button"
        android:visibility="invisible"
        android:layout_width="12dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_advantage_arrow_right_8"
        android:rotationY="@integer/rtl_rotation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:tint="@color/n_lv_3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
