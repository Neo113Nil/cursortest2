<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chat_rules_title"
            android:textAlignment="viewStart"
            style="@style/DisplayLarge"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/chat_rules_subtitle"
            android:textAlignment="viewStart"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:id="@+id/chat_rules_bullets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="viewStart"
            android:layout_marginStart="8dp"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/chat_rules_rule_breaking"
            android:textAlignment="viewStart"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/chat_rules_agree"
            android:textAlignment="viewStart"
            style="@style/BodyMediumParagraph"/>
    </LinearLayout>
</ScrollView>
