<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/manager_h2h_root"
    android:background="@color/surface_1"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="bottom|center_horizontal"
        android:id="@+id/h2h_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/DisplayMedium"/>
    <include
        android:id="@+id/h2h_container"
        layout="@layout/head_to_head_layout"/>
    <TextView
        android:gravity="bottom|center_horizontal"
        android:id="@+id/h2h_title_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/DisplayMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/h2h_subtitle_2"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:paddingHorizontal="16dp"
        style="@style/DisplayMicro"/>
    <include
        android:id="@+id/h2h_container_2"
        layout="@layout/head_to_head_layout"/>
</LinearLayout>
