<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/first_team_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/period_name"
        app:layout_constraintEnd_toStartOf="@+id/period_name"
        app:layout_constraintTop_toTopOf="@+id/period_name"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/period_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/second_team_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/period_name"
        app:layout_constraintStart_toEndOf="@+id/period_name"
        app:layout_constraintTop_toTopOf="@+id/period_name"
        style="@style/DisplaySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
