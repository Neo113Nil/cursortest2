<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/logo_player_first"
        android:padding="1dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleShapeOverlay"
        app:strokeWidth="1dp"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/logo_player_second"
        android:padding="1dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleShapeOverlay"
        app:strokeWidth="1dp"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/text_player_name_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/text_vs"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/logo_player_first"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/text_vs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/versus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/AssistiveMicro"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/text_player_name_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/logo_player_second"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/text_vs"
        style="@style/AssistiveMicro"/>
    <ImageView
        android:id="@+id/slider_container"
        android:background="@drawable/mma_post_match_voting_motion_background"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/text_vs"
        app:layout_constraintEnd_toStartOf="@+id/logo_player_second"
        app:layout_constraintStart_toEndOf="@+id/logo_player_first"/>
    <ImageView
        android:id="@+id/arrow_left_1"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right_large_16"
        android:rotation="180"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/slider"
        app:layout_constraintEnd_toStartOf="@+id/slider"
        app:layout_constraintTop_toTopOf="@+id/slider"
        app:tint="@color/n_lv_4"/>
    <ImageView
        android:id="@+id/arrow_left_2"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right_large_16"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="@+id/slider"
        app:layout_constraintEnd_toStartOf="@+id/arrow_left_1"
        app:layout_constraintTop_toTopOf="@+id/slider"
        app:tint="@color/n_lv_4"/>
    <ImageView
        android:id="@+id/arrow_right_1"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right_large_16"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/slider"
        app:layout_constraintStart_toEndOf="@+id/slider"
        app:layout_constraintTop_toTopOf="@+id/slider"
        app:tint="@color/n_lv_4"/>
    <ImageView
        android:id="@+id/arrow_right_2"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right_large_16"
        app:layout_constraintBottom_toBottomOf="@+id/slider"
        app:layout_constraintStart_toEndOf="@+id/arrow_right_1"
        app:layout_constraintTop_toTopOf="@+id/slider"
        app:tint="@color/n_lv_4"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/arrows_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="arrow_left_1, arrow_left_2, arrow_right_1, arrow_right_2"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/text_your_vote_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/prediction_your_vote"
        android:alpha="0"
        android:textAllCaps="true"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/slider_container"
        app:layout_constraintStart_toStartOf="@+id/slider_container"
        app:layout_constraintTop_toTopOf="@+id/slider_container"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/text_your_vote_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/prediction_your_vote"
        android:alpha="0"
        android:textAllCaps="true"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/slider_container"
        app:layout_constraintEnd_toEndOf="@+id/slider_container"
        app:layout_constraintTop_toTopOf="@+id/slider_container"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/slider"
        android:background="@drawable/circle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:text="@string/mma_winner_buzzer"
        android:backgroundTint="@color/neutral_default"
        app:layout_constraintEnd_toEndOf="@+id/slider_container"
        app:layout_constraintStart_toStartOf="@+id/slider_container"
        app:layout_constraintTop_toTopOf="@+id/slider_container"
        style="@style/DisplaySmall"/>
    <View
        android:id="@+id/progress_view_first"
        android:background="@drawable/rectangle_4dp_corners_left"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginEnd="1dp"
        android:backgroundTint="@color/red_fighter_default"
        app:layout_constraintBottom_toBottomOf="@+id/slider_container"
        app:layout_constraintEnd_toStartOf="@+id/progress_view_second"
        app:layout_constraintHorizontal_weight="33"
        app:layout_constraintStart_toStartOf="@+id/slider_container"/>
    <View
        android:id="@+id/progress_view_second"
        android:background="@drawable/rectangle_4dp_corners_right"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:backgroundTint="@color/blue_fighter_default"
        app:layout_constraintBottom_toBottomOf="@+id/slider_container"
        app:layout_constraintEnd_toEndOf="@+id/slider_container"
        app:layout_constraintHorizontal_weight="33"
        app:layout_constraintStart_toEndOf="@+id/progress_view_first"/>
    <TextView
        android:textColor="@color/red_fighter_default"
        android:id="@+id/text_vote_result_first"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/progress_view_first"
        app:layout_constraintStart_toStartOf="@+id/slider_container"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/blue_fighter_default"
        android:id="@+id/text_vote_result_second"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/progress_view_first"
        app:layout_constraintEnd_toEndOf="@+id/slider_container"
        style="@style/BodySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
