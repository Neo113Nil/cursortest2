<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="310dp"
    android:minHeight="115dp">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/sofaPrimaryText"
        android:gravity="start|center_vertical"
        android:id="@+id/disclaimer_text"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/media_disclaimer_body"
        android:fontFamily="@font/sofascore_sans_regular"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/sofaActionBlue"
        android:ellipsize="end"
        android:id="@+id/disclaimer_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:maxLines="1"
        android:fontFamily="@font/sofascore_sans_regular"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
</LinearLayout>
