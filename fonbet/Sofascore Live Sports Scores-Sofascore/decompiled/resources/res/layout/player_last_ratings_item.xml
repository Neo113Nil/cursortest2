<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:layout_width="0dp"
    android:layout_height="170dp"
    android:layout_weight="1">
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/rating_item_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        style="@style/AssistiveDefault"/>
    <FrameLayout
        android:id="@+id/opponent_logo_container"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <ImageView
            android:id="@+id/opponent_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </FrameLayout>
    <com.sofascore.results.view.SofascoreSmallRatingView
        android:id="@+id/rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        app:small_animateRating="false"/>
</LinearLayout>
