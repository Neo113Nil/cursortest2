<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp">
    <ImageView
        android:id="@+id/transfers_team_from_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/transfers_arrow_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_breadcrumb_16"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/transfers_team_from_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/n_lv_1"/>
    <ImageView
        android:id="@+id/transfers_team_to_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/transfers_arrow_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/player_transfer_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingEnd="8dp"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/team_transfers_type"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/transfers_team_to_logo"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/team_transfers_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/team_transfers_colon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/team_transfers_colon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=": "
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/player_transfer_fee"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/player_transfer_fee"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
