<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:paddingEnd="16dp">
    <View
        android:background="@color/on_color_highlight_1"
        android:layout_width="1dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/secondary_label"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/primary_label"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/primary_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/secondary_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DisplayLarge"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="primary_label, secondary_label"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/secondary_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/primary_label"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/BodyMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
