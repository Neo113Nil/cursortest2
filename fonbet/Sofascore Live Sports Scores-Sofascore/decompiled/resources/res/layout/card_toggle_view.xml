<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/rectangle_16dp_corners_no_color"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/title_subsection"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            style="@style/DisplaySmall"/>
        <FrameLayout
            android:orientation="horizontal"
            android:id="@+id/top_container"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"/>
        <com.sofascore.results.redesign.dividers.SofaDivider
            android:id="@+id/divider"
            android:background="@color/n_lv_4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:dividerVisible="true"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/radio_group"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <androidx.appcompat.widget.AppCompatRadioButton
                android:textColor="@color/card_toggle_radio_text_color"
                android:gravity="center"
                android:id="@+id/radio_first"
                android:background="@drawable/card_toggle_radio"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:minHeight="24dp"
                android:textAllCaps="false"
                style="@style/AssistiveDefault"/>
            <androidx.appcompat.widget.AppCompatRadioButton
                android:textColor="@color/card_toggle_radio_text_color"
                android:gravity="center"
                android:id="@+id/radio_second"
                android:background="@drawable/card_toggle_radio"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:minHeight="24dp"
                android:textAllCaps="false"
                android:layout_marginStart="8dp"
                style="@style/AssistiveDefault"/>
        </RadioGroup>
        <FrameLayout
            android:id="@+id/bottom_container"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</merge>
