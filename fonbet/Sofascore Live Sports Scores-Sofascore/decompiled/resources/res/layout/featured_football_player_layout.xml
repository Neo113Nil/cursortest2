<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/first_player_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/second_player_layout"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/football_player_layout"/>
    <include
        android:id="@+id/second_player_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/first_player_layout"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/football_player_layout"/>
    <TextView
        android:gravity="center"
        android:id="@+id/featured_football_player_versus"
        android:background="@drawable/rectangle_4dp_corners"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minWidth="32dp"
        android:text="@string/versus"
        android:maxLines="1"
        android:textAllCaps="true"
        android:backgroundTint="@color/surface_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <com.sofascore.results.view.graph.AttributeOverviewGraph
        android:id="@+id/attribute_overview_graph"
        android:layout_width="match_parent"
        android:layout_height="224dp"
        app:layout_constraintTop_toBottomOf="@+id/first_player_layout"/>
    <include
        android:id="@+id/legend_first_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/attribute_overview_graph"
        layout="@layout/legend_item_row"/>
    <include
        android:id="@+id/legend_second_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/legend_first_player"
        layout="@layout/legend_item_row"/>
</androidx.constraintlayout.widget.ConstraintLayout>
