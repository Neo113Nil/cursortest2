<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.typeheader.TypeHeaderView
        android:id="@+id/shot_map_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.sofascore.results.view.graph.BasketballShotmapGraph
        android:id="@+id/shot_map_heat_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <ImageView
        android:background="@color/surface_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:src="@color/n_lv_4"/>
    <com.sofascore.results.view.graph.BasketballShotmapView
        android:id="@+id/shotmap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"/>
    <include
        android:id="@+id/shot_map_description"
        layout="@layout/shot_map_description_view"/>
</LinearLayout>
