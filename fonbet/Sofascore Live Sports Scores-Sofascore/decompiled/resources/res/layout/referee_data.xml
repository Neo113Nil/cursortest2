<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <ImageView
        android:id="@+id/league_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/league_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="locale"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/appearances_data"
        app:layout_constraintStart_toEndOf="@+id/league_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="100dp"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/appearances_data"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/yellow_card_data"
        app:layout_constraintStart_toEndOf="@+id/league_name"
        app:layout_constraintWidth_max="@dimen/box_score_max_width"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/yellow_card_data"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/red_card_data"
        app:layout_constraintStart_toEndOf="@+id/appearances_data"
        app:layout_constraintWidth_max="@dimen/box_score_max_width"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/red_card_data"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/penalties_data"
        app:layout_constraintStart_toEndOf="@+id/yellow_card_data"
        app:layout_constraintWidth_max="@dimen/box_score_max_width"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/penalties_data"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/red_card_data"
        app:layout_constraintWidth_max="@dimen/box_score_max_width"
        style="@style/BodyMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
