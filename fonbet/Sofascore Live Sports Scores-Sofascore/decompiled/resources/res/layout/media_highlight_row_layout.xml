<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">
    <ImageView
        android:id="@+id/highlights_image"
        android:background="@drawable/placeholder_rectangle"
        android:layout_width="144dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/picture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/image_overlay"
        android:background="@drawable/rectangle_2dp_corners"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:backgroundTint="@color/darken_overlay_1"
        app:layout_constraintBottom_toBottomOf="@+id/highlights_image"
        app:layout_constraintEnd_toEndOf="@+id/highlights_image"
        app:layout_constraintStart_toStartOf="@+id/highlights_image"
        app:layout_constraintTop_toTopOf="@+id/highlights_image"/>
    <ImageView
        android:id="@+id/play_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_highlights_white"
        android:contentDescription="@string/picture"
        app:layout_constraintBottom_toBottomOf="@+id/highlights_image"
        app:layout_constraintEnd_toEndOf="@+id/highlights_image"
        app:layout_constraintStart_toStartOf="@+id/highlights_image"
        app:layout_constraintTop_toTopOf="@+id/highlights_image"/>
    <TextView
        android:textSize="14dp"
        android:ellipsize="end"
        android:id="@+id/highlights_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="locale"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/highlights_image"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="top"
        android:id="@+id/highlights_subtitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:textDirection="locale"
        app:layout_constraintBottom_toTopOf="@+id/highlights_time"
        app:layout_constraintEnd_toEndOf="@+id/highlights_title"
        app:layout_constraintStart_toStartOf="@+id/highlights_title"
        app:layout_constraintTop_toBottomOf="@+id/highlights_title"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/n_lv_3"
        android:gravity="start"
        android:id="@+id/highlights_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/highlights_image"
        app:layout_constraintEnd_toStartOf="@+id/highlights_watched"
        app:layout_constraintStart_toStartOf="@+id/highlights_title"
        style="@style/BodySmall"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/n_lv_3"
        android:id="@+id/highlights_watched"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seen"
        app:layout_constraintBottom_toBottomOf="@+id/highlights_time"
        app:layout_constraintEnd_toEndOf="@+id/highlights_title"
        style="@style/BodySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
