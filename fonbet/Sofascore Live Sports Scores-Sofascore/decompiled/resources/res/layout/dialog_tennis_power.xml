<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="8dp"
        android:paddingBottom="48dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <TextView
            android:id="@+id/tennis_power_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tennis_power_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:textColor="@color/secondary_default"
            android:id="@+id/tennis_power_home_team_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tennis_power_text"
            style="@style/AssistiveDefault"/>
        <ImageView
            android:id="@+id/tennis_power_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_tennis_power_icon"
            android:scaleX="@integer/drawable_scaleX_normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tennis_power_home_team_text"/>
        <TextView
            android:textColor="@color/secondary_default"
            android:id="@+id/tennis_power_home_team_break"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            app:layout_constraintStart_toEndOf="@+id/tennis_power_icon"
            app:layout_constraintTop_toTopOf="@+id/tennis_power_icon"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/primary_default"
            android:id="@+id/tennis_power_away_team_break"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="43dp"
            app:layout_constraintBottom_toBottomOf="@+id/tennis_power_icon"
            app:layout_constraintStart_toEndOf="@+id/tennis_power_icon"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/primary_default"
            android:id="@+id/tennis_power_away_team_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tennis_power_icon"
            style="@style/AssistiveDefault"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
