<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:layout_marginVertical="4dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/penalty_incident_time"
        android:layout_width="48dp"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/commentary_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginVertical="2dp"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/commentary_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="48dp"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/commentary_holder"
        android:background="@drawable/rounded_surface_level_2"
        android:paddingTop="7dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/surface_1"
        android:paddingHorizontal="8dp">
        <ImageView
            android:id="@+id/commentary_player_second"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="-12dp"
            app:layout_constraintEnd_toStartOf="@+id/commentary_player"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/commentary_player"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/commentary_player_team"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="-2dp"
            android:layout_marginStart="-2dp"
            app:layout_constraintBottom_toBottomOf="@+id/commentary_player"
            app:layout_constraintStart_toStartOf="@+id/commentary_player"/>
        <TextView
            android:textColor="@color/surface_1"
            android:id="@+id/commentary_title_chip"
            android:background="@drawable/rectangle_12dp_corners"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:backgroundTint="@color/secondary_default"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"
            style="@style/AssistiveDefault"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/commentary_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/commentary_player_second"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/commentary_title_chip"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"
            app:layout_goneMarginStart="0dp"
            style="@style/DisplayMedium"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/top_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="commentary_title, commentary_title_chip"/>
        <TextView
            android:id="@+id/commentary_primary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAlignment="viewStart"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/commentary_secondary_text"
            app:layout_constraintEnd_toStartOf="@+id/commentary_player_second"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_barrier"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/BodySmall"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/commentary_secondary_text"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/baseball_footer"
            app:layout_constraintEnd_toStartOf="@+id/commentary_player_second"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/commentary_primary_text"
            style="@style/BodySmall"/>
        <include
            android:id="@+id/baseball_footer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toTopOf="@+id/notable_actions_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/commentary_secondary_text"
            layout="@layout/commentary_item_baseball_footer"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/notable_actions_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/goal_animation_stub"
            app:layout_constraintTop_toBottomOf="@+id/baseball_footer"/>
        <ViewStub
            android:id="@+id/goal_animation_stub"
            android:visibility="visible"
            android:layout="@layout/commentary_goal_animation_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toTopOf="@+id/goal_details_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/notable_actions_container"/>
        <FrameLayout
            android:id="@+id/goal_details_button"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goal_animation_stub">
            <TextView
                android:textColor="@color/primary_default"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_goal_details_cta"
                app:drawableEndCompat="@drawable/ic_chevron_right_large_16"
                app:drawableTint="@color/primary_default"
                style="@style/DisplaySmall"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
