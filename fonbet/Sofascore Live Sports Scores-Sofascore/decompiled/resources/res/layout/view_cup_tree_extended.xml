<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <com.sofascore.results.view.typeheader.TypeHeaderView
        android:id="@+id/rounds_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/view_pager"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/legend_container"
        android:layout_below="@+id/rounds_header"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:id="@+id/legend_container"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bye_label_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_section_arrow_up"
                android:rotation="@integer/rotate_90_clockwise"
                app:tint="@color/prom_to_x"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:id="@+id/bye_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bracket_bye_explainer"
                android:layout_marginStart="8dp"
                style="@style/AssistiveDefault"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/draw_label_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="16dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_draw_mix"
                app:tint="@color/primary_default"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:id="@+id/draw_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bracket_matchups_determined_by_draw"
                android:layout_marginStart="8dp"
                style="@style/AssistiveDefault"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
