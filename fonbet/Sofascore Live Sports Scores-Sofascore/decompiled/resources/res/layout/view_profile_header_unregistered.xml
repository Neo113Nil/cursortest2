<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingBottom="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <TextView
        android:textColor="@color/on_color_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/logged_out_profile_header"
        style="@style/HeaderSectionTitle"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="@color/on_color_primary"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_benefit_1"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_tv_channel_checkmark"
        android:layout_marginVertical="4dp"
        app:drawableTint="@color/primary_default"
        style="@style/BodyMediumParagraph"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="@color/on_color_primary"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_benefit_2"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_tv_channel_checkmark"
        android:layout_marginVertical="4dp"
        app:drawableTint="@color/primary_default"
        style="@style/BodyMediumParagraph"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="@color/on_color_primary"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_benefit_3"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_tv_channel_checkmark"
        android:layout_marginVertical="4dp"
        app:drawableTint="@color/primary_default"
        style="@style/BodyMediumParagraph"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="@color/on_color_primary"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_benefit_4"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_tv_channel_checkmark"
        android:layout_marginVertical="4dp"
        app:drawableTint="@color/primary_default"
        style="@style/BodyMediumParagraph"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textColor="@color/primary_default"
        android:id="@+id/button_sign_in"
        android:background="@drawable/rectangle_24dp_corners"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="0dp"
        android:text="@string/user_sign_in"
        app:backgroundTint="@color/on_color_primary"
        style="@style/ActionButtonPrimary"/>
</LinearLayout>
