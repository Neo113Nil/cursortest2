<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/blaze_widget_root_item_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/blaze_widget_item_image_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:outlineSpotShadowColor="@color/blaze_transparent"
        android:outlineAmbientShadowColor="@color/blaze_transparent"
        app:cardBackgroundColor="@color/blaze_transparent"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/blaze_widget_item_widgetImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription=""/>
        <FrameLayout
            android:id="@+id/blaze_widget_item_widgetGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/blaze_widget_item_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <com.blaze.blazesdk.custom_views.BlazeTextView
        android:ellipsize="end"
        android:id="@+id/blaze_widget_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <com.blaze.blazesdk.players.ui.StatusIndicatorView
        android:id="@+id/blaze_widget_item_status_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.blaze.blazesdk.widgets.ui.WidgetTimeElementCustomView
        android:id="@+id/blaze_widget_item_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.blaze.blazesdk.widgets.ui.WidgetTimeElementCustomView
        android:id="@+id/blaze_widget_item_event_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blaze_widget_item_badge_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/blaze_widget_item_badge_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.blaze.blazesdk.custom_views.BlazeTextView
            android:ellipsize="end"
            android:id="@+id/blaze_widget_item_badge_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/blaze_widget_item_badge_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
