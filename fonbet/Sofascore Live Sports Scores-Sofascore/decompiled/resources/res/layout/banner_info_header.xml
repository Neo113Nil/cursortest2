<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sofaBannerBlue"
    android:paddingTop="24dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="112dp"
    android:paddingHorizontal="8dp">
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnPrimary"
        android:ellipsize="end"
        android:id="@+id/banner_info_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:maxLines="2"
        android:layout_above="@+id/banner_info_button_positive"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/banner_info_button_negative"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="?attr/colorOnPrimary"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/banner_info_button_positive"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="64dp"
        android:maxLines="1"
        android:layout_alignParentBottom="true"
        android:textAllCaps="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/banner_info_button_negative"
        android:layout_alignParentStart="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/banner_info_button_negative"
        style="@style/ActionButtonPrimary"/>
    <TextView
        android:textColor="?attr/colorOnPrimary"
        android:gravity="center"
        android:id="@+id/banner_info_button_negative"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="64dp"
        android:text="@string/ok"
        android:textAllCaps="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/ActionButtonPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
