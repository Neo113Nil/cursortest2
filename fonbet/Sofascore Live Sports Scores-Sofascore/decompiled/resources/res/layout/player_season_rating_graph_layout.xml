<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/rating_layout"
        layout="@layout/statistic_avg_rating"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/graph_view"
        android:background="@drawable/rectangle_16dp_corners"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:backgroundTint="@color/surface_2">
        <com.sofascore.results.view.graph.SeasonRatingGraph
            android:id="@+id/graph"
            android:layout_width="match_parent"
            android:layout_height="144dp"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/graph_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="8dp"
            style="@style/AssistiveMicro"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tap_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tap_graph_to_swap"
        android:maxLines="2"
        android:drawablePadding="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        app:drawableStartCompat="@drawable/ic_transfer_swap"
        app:drawableTint="@color/secondary_default"
        style="@style/AssistiveDefault"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <FrameLayout
            android:id="@+id/legend_injury_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginVertical="12dp">
            <View
                android:background="@drawable/rectangle_2dp_corners"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.15"
                android:backgroundTint="@color/error"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_cross"
                app:tint="@color/error"/>
        </FrameLayout>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/legend_injury_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_injured"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="32dp"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/legend_transfer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/transfer_or_loan"
            android:maxLines="1"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/ic_transfer_in"
            app:drawableTint="@color/primary_default"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
</LinearLayout>
