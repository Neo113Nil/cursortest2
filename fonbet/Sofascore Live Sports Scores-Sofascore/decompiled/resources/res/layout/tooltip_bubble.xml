<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <View
        android:layout_gravity="center"
        android:id="@+id/arrow"
        android:background="@drawable/ic_container_pointer"
        android:layout_width="28dp"
        android:layout_height="6dp"
        android:backgroundTint="@color/primary_default"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center_horizontal"
        android:id="@+id/tooltip_text"
        android:background="@drawable/rounded_surface_level_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/primary_default"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        style="@style/BodyMedium"/>
</LinearLayout>
