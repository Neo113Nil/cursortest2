<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="56dp"
    android:layout_height="48dp">
    <View
        android:id="@+id/clickable_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="1dp"/>
    <com.sofascore.results.view.BellButton
        android:layout_gravity="center"
        android:id="@+id/bell_button"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:iconShape="circle"/>
    <com.sofascore.results.view.WDLView
        android:layout_gravity="center"
        android:id="@+id/wdl_item"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"/>
    <com.sofascore.results.view.SofascoreSmallRatingView
        android:layout_gravity="center"
        android:id="@+id/rating_item"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:small_animateRating="false"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/on_bench_icon"
        android:background="@drawable/rectangle_4dp_corners"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_bench"
        android:scaleType="center"
        app:tint="@color/n_lv_3"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/player_stats_icon"
        android:background="@drawable/circle_outline_n_lv_5"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:foreground="?attr/selectableItemBackground"
        android:src="@drawable/ic_indicator_stats"
        android:clipToOutline="true"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/player_stat_value"
        android:background="@drawable/circle_outline_n_lv_5"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:foreground="?attr/selectableItemBackground"
        android:maxLines="1"
        android:clipToOutline="true"
        style="@style/DisplaySmall"/>
</FrameLayout>
