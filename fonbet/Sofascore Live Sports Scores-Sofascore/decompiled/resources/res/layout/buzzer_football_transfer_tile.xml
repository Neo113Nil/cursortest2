<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/full_color"
        android:background="@color/primary_variant"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/overlay"
        android:background="@drawable/buzzer_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.5"/>
    <View
        android:id="@+id/transfer_background"
        android:background="@drawable/buzzer_interesting_statistics_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleX="@integer/drawable_scaleX_normal"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/player_image"
        app:layout_constraintTop_toTopOf="@+id/player_image"/>
    <ImageView
        android:id="@+id/from_team_logo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toTopOf="@+id/to_team_logo"
        app:layout_constraintEnd_toEndOf="@+id/to_team_logo"
        app:layout_constraintStart_toStartOf="@+id/to_team_logo"
        app:layout_constraintTop_toTopOf="@+id/transfer_background"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/to_team_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/transfer_background"
        app:layout_constraintEnd_toStartOf="@+id/transfer_icon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/player_image"
        app:layout_constraintTop_toBottomOf="@+id/from_team_logo"/>
    <ImageView
        android:id="@+id/transfer_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_swap"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/transfer_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/to_team_logo"
        app:layout_constraintTop_toTopOf="@+id/transfer_background"
        app:tint="@color/on_color_primary"/>
    <ImageView
        android:id="@+id/player_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/player_name_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/DisplayMicro"/>
</androidx.constraintlayout.widget.ConstraintLayout>
