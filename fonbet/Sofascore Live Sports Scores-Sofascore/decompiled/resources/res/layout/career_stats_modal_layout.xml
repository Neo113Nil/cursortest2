<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/career_stats_filter_modal_container"
        android:background="@color/surface_P"
        android:paddingTop="8dp"
        android:paddingBottom="56dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/year_range_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/subtitle_micro_left_with_icon_modal"/>
        <TextView
            android:gravity="center"
            android:id="@+id/year_range_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="16dp"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toBottomOf="@+id/year_range_subtitle"
            style="@style/BodyMedium"/>
        <com.google.android.material.slider.RangeSlider
            android:id="@+id/year_range_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:labelBehavior="gone"
            app:layout_constraintTop_toBottomOf="@+id/year_range_text"
            app:thumbColor="@color/on_color_primary"
            app:thumbElevation="1dp"
            app:trackColorActive="@color/primary_default"
            app:trackColorInactive="@color/n_lv_4"
            app:trackHeight="6dp"/>
        <com.sofascore.results.view.SofaTextInputLayout
            android:textColorHint="@color/n_lv_3"
            android:id="@+id/team_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/team"
            android:paddingHorizontal="16dp"
            android:importantForAutofill="noExcludeDescendants"
            app:endIconTint="@color/n_lv_1"
            app:hintTextColor="@color/primary_default"
            app:layout_constraintTop_toBottomOf="@+id/year_range_slider"
            app:layout_goneMarginTop="0dp"
            style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:ellipsize="end"
                android:id="@+id/team_filter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:maxLines="1"
                android:popupBackground="@drawable/popup_background_drawable"
                android:inputType="none"
                android:textDirection="locale"
                android:paddingHorizontal="16dp"
                style="@style/BodyLarge"/>
        </com.sofascore.results.view.SofaTextInputLayout>
        <com.sofascore.results.view.SofaTextInputLayout
            android:textColorHint="@color/n_lv_3"
            android:id="@+id/match_type_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/filter_option_home_away"
            android:paddingHorizontal="16dp"
            android:importantForAutofill="noExcludeDescendants"
            app:endIconTint="@color/n_lv_1"
            app:hintTextColor="@color/primary_default"
            app:layout_constraintTop_toBottomOf="@+id/team_input"
            style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:ellipsize="end"
                android:id="@+id/match_type_filter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:maxLines="1"
                android:popupBackground="@drawable/popup_background_drawable"
                android:inputType="none"
                android:textDirection="locale"
                android:paddingHorizontal="16dp"
                style="@style/BodyLarge"/>
        </com.sofascore.results.view.SofaTextInputLayout>
        <include
            android:id="@+id/per_mode_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/match_type_input"
            layout="@layout/subtitle_micro_left_with_icon_modal"/>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/statistics_type_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@+id/per_mode_subtitle">
            <RadioButton
                android:textAppearance="@style/BodyMedium"
                android:textColor="@color/n_lv_1"
                android:id="@+id/radio_per_game"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/basketball_per_game_stats_title"
                android:textAlignment="viewStart"
                android:buttonTint="@color/primary_default"/>
            <RadioButton
                android:textAppearance="@style/BodyMedium"
                android:textColor="@color/n_lv_1"
                android:id="@+id/radio_totals"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_by_totals"
                android:textAlignment="viewStart"
                android:buttonTint="@color/primary_default"/>
        </RadioGroup>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/statistics_type_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="per_mode_subtitle,statistics_type_radio_group"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
