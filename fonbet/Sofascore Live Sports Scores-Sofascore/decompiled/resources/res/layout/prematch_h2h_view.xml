<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_surface_level_1"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <ImageView
        android:id="@+id/logo_home_team"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toStartOf="@+id/nr_win_home_team"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:id="@+id/nr_win_home_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/logo_home_team"
        app:layout_constraintEnd_toStartOf="@+id/divider_1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/logo_home_team"
        app:layout_constraintTop_toTopOf="@+id/logo_home_team"
        style="@style/DisplayMedium"/>
    <View
        android:id="@+id/divider_1"
        android:background="@color/n_lv_3"
        android:layout_width="1dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/logo_home_team"
        app:layout_constraintEnd_toStartOf="@+id/nr_draws"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/nr_win_home_team"
        app:layout_constraintTop_toTopOf="@+id/logo_home_team"/>
    <TextView
        android:id="@+id/nr_draws"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/logo_home_team"
        app:layout_constraintEnd_toStartOf="@+id/divider_2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/divider_1"
        app:layout_constraintTop_toTopOf="@+id/logo_home_team"
        style="@style/DisplayMedium"/>
    <View
        android:id="@+id/divider_2"
        android:background="@color/n_lv_3"
        android:layout_width="1dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/logo_home_team"
        app:layout_constraintEnd_toStartOf="@+id/nr_win_away_team"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/nr_draws"
        app:layout_constraintTop_toTopOf="@+id/logo_home_team"/>
    <TextView
        android:id="@+id/nr_win_away_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/logo_home_team"
        app:layout_constraintEnd_toStartOf="@+id/logo_away_team"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/divider_2"
        app:layout_constraintTop_toTopOf="@+id/logo_home_team"
        style="@style/DisplayMedium"/>
    <ImageView
        android:id="@+id/logo_away_team"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/logo_home_team"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/nr_win_away_team"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/recycler"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_home_team"/>
    <TextView
        android:textColor="@color/primary_default"
        android:gravity="center"
        android:id="@+id/compare_button"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/compare_team_stats"
        android:drawablePadding="4dp"
        app:drawableEndCompat="@drawable/ic_chevron_right_large_16"
        app:drawableTint="@color/primary_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recycler"
        style="@style/DisplaySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
