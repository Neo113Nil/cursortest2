<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ProfileCardStyle">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/overview_rows"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/n_lv_1"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                style="@style/DisplayMedium"/>
            <TextView
                android:textColor="@color/primary_default"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/button_view_more"
                android:background="@drawable/ripple_16_dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/profile_view_predictions"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                app:drawableEndCompat="@drawable/ic_chevron_right_large_16"
                app:drawableTint="@color/primary_default"
                style="@style/AssistiveDefault"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
