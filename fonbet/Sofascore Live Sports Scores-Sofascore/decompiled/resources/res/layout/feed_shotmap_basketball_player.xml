<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.typeheader.SegmentedButtonsView
        android:id="@+id/periods_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/shotmap_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sofascore.results.view.graph.BasketballShotmapGraph
            android:layout_gravity="center_horizontal"
            android:id="@+id/player_shot_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
