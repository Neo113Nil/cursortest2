<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="48dp"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_player_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/edit_player_name"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/player_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_player_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_player_image_url"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/player_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_birth_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_player_birth_date"
        android:importantForAutofill="noExcludeDescendants"
        app:hintAnimationEnabled="false"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/birth_date"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_player_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/player_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_player_shirt_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_player_shirt_number"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/player_shirt_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_preferred_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_player_preferred_foot"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/preferred_foot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_player_position"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_nationality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/nationality"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/nationality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_market_value_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <com.sofascore.results.view.SofaTextInputLayout
            android:id="@+id/input_market_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/market_value"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toStartOf="@+id/input_market_value_currency"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.Sofascore.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/market_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="flagNoExtractUi"
                android:fontFamily="@font/sofascore_sans_regular"/>
        </com.sofascore.results.view.SofaTextInputLayout>
        <com.sofascore.results.view.SofaTextInputLayout
            android:id="@+id/input_market_value_currency"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/market_value_currency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:dropDownWidth="150dp"/>
        </com.sofascore.results.view.SofaTextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/suggest_changes_note"
        android:paddingVertical="8dp"
        style="@style/AssistiveDefault"/>
</LinearLayout>
