<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">
    <TextView
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/strikes_by_zones"
        style="@style/DisplayMedium"/>
    <com.sofascore.results.event.mmastatistics.view.MmaStatsHeadDualView
        android:id="@+id/body_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <com.sofascore.results.event.mmastatistics.view.MmaStatsTorsoDualView
        android:id="@+id/body_torso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.sofascore.results.event.mmastatistics.view.MmaStatsLegsDualView
        android:id="@+id/body_legs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textColor="@color/primary_default"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/all_statistics_button"
        android:background="@drawable/ripple_16_dp"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/see_all_statistics"
        android:drawablePadding="4dp"
        app:drawableEndCompat="@drawable/ic_chevron_right_large_16"
        app:drawableTint="@color/primary_default"
        style="@style/DisplaySmall"/>
</LinearLayout>
