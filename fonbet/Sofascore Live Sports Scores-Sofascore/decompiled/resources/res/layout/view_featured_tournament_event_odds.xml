<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/odds_choice_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/odds_choice_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_featured_tournament_odds_value"/>
    <include
        android:id="@+id/odds_choice_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/odds_choice_2"
        app:layout_constraintStart_toEndOf="@+id/odds_choice_0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"
        layout="@layout/item_featured_tournament_odds_value"/>
    <include
        android:id="@+id/odds_choice_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/provider_logo"
        app:layout_constraintStart_toEndOf="@+id/odds_choice_1"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_featured_tournament_odds_value"/>
    <ImageView
        android:id="@+id/provider_logo"
        android:background="@drawable/rectangle_4dp_corners"
        android:layout_width="48dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/market_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/odds_choice_2"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textColor="@color/value"
        android:id="@+id/live_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_live"
        android:layout_marginStart="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/market_name"
        app:layout_constraintStart_toEndOf="@+id/market_name"
        style="@style/AssistiveMicro"/>
</merge>
