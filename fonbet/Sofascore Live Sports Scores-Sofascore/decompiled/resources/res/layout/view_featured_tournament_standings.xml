<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/surface_1"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="@string/standings"
            android:maxLines="1"
            android:layout_marginHorizontal="16dp"
            style="@style/DisplayMedium"/>
        <include
            android:id="@+id/standings_switcher"
            layout="@layout/standings_row_switcher"/>
        <View
            android:background="@color/n_lv_4"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/table"
            android:background="@drawable/rounded_surface_level_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:backgroundTint="@color/surface_2">
            <include
                android:id="@+id/table_header"
                layout="@layout/standings_cell"/>
            <include
                android:id="@+id/table_team_1"
                layout="@layout/standings_cell"/>
            <include
                android:id="@+id/table_team_2"
                layout="@layout/standings_cell"/>
            <include
                android:id="@+id/table_team_3"
                layout="@layout/standings_cell"/>
            <include
                android:id="@+id/table_team_4"
                layout="@layout/standings_cell"/>
            <include
                android:id="@+id/table_team_5"
                layout="@layout/standings_cell"/>
            <include
                android:id="@+id/table_team_6"
                layout="@layout/standings_cell"/>
        </LinearLayout>
        <include
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/standings_description_expandable"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
