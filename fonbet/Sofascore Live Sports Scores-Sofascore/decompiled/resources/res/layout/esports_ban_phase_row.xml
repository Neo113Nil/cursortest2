<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="68dp">
    <include
        android:id="@+id/first_team_hero_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/esports_banned_hero_item"/>
    <include
        android:id="@+id/first_team_hero_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/first_team_hero_1"
        app:layout_constraintTop_toTopOf="@+id/first_team_hero_1"
        layout="@layout/esports_banned_hero_item"/>
    <include
        android:id="@+id/first_team_hero_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/first_team_hero_2"
        app:layout_constraintTop_toTopOf="@+id/first_team_hero_1"
        layout="@layout/esports_banned_hero_item"/>
    <include
        android:id="@+id/second_team_hero_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_team_hero_1"
        layout="@layout/esports_banned_hero_item"/>
    <include
        android:id="@+id/second_team_hero_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/second_team_hero_1"
        app:layout_constraintTop_toTopOf="@+id/second_team_hero_1"
        layout="@layout/esports_banned_hero_item"/>
    <include
        android:id="@+id/second_team_hero_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/second_team_hero_2"
        app:layout_constraintTop_toTopOf="@+id/second_team_hero_1"
        layout="@layout/esports_banned_hero_item"/>
</androidx.constraintlayout.widget.ConstraintLayout>
