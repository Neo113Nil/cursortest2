<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:maxLines="1"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayLarge"/>
    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/BodyMediumParagraph"/>
    <TextView
        android:id="@+id/extra_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"
        style="@style/BodyMediumParagraph"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/primary_default"
        android:id="@+id/cancel_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/cancel"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textAllCaps="true"
        android:fontFamily="@font/sofascore_sans_bold"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/surface_P"
        android:letterSpacing="0.04"
        app:layout_constraintBottom_toBottomOf="@+id/action_button"
        app:layout_constraintEnd_toStartOf="@+id/action_button"
        app:layout_constraintTop_toTopOf="@+id/action_button"
        style="@style/NegativeButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="@style/ActionButtonPrimary"
        android:id="@+id/action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="36dp"
        android:text="@string/discard_button"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textAllCaps="true"
        android:fontFamily="@font/sofascore_sans_bold"
        android:backgroundTint="@color/error"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extra_text"
        style="@style/ButtonFilledPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
