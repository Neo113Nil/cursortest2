<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mma_last_3_fights"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMedium"/>
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider_central"
        android:layout_width="@dimen/divider_thickness"
        android:layout_height="0dp"
        app:dividerThickness="@dimen/divider_thickness"
        app:layout_constraintBottom_toBottomOf="@+id/fighter_form_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fighter_rank_1"/>
    <ImageView
        android:id="@+id/fighter_image_1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fighter_rank_1"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/fighter_rank_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="16dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:textAlignment="gravity"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/divider_central"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fighter_image_1"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="start|center_vertical"
        android:id="@+id/label_wld_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:text="W-L-D"
        android:textAlignment="gravity"
        app:layout_constraintStart_toStartOf="@+id/fighter_rank_1"
        app:layout_constraintTop_toBottomOf="@+id/fighter_rank_1"
        style="@style/AssistiveDefault"/>
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider_wld_1"
        android:layout_width="@dimen/divider_thickness"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/label_wld_1"
        app:layout_constraintStart_toEndOf="@+id/label_wld_1"
        app:layout_constraintTop_toTopOf="@+id/label_wld_1"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/value_wld_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="gravity"
        android:layout_marginStart="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/label_wld_1"
        app:layout_constraintEnd_toStartOf="@+id/divider_central"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/divider_wld_1"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/fighter_image_2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fighter_rank_1"/>
    <TextView
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/fighter_rank_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="16dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:textAlignment="gravity"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/fighter_rank_1"
        app:layout_constraintEnd_toStartOf="@+id/fighter_image_2"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/divider_central"
        style="@style/AssistiveDefault"/>
    <TextView
        android:gravity="end|center_vertical"
        android:id="@+id/value_wld_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="gravity"
        app:layout_constraintBaseline_toBaselineOf="@+id/label_wld_1"
        app:layout_constraintEnd_toEndOf="@+id/fighter_rank_2"
        style="@style/AssistiveDefault"/>
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider_wld_2"
        android:layout_width="@dimen/divider_thickness"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/divider_wld_1"
        app:layout_constraintEnd_toStartOf="@+id/value_wld_2"
        app:layout_constraintTop_toTopOf="@+id/divider_wld_1"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="end|center_vertical"
        android:id="@+id/label_wld_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="W-L-D"
        android:textAlignment="gravity"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/label_wld_1"
        app:layout_constraintEnd_toStartOf="@+id/divider_wld_2"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/divider_central"
        style="@style/AssistiveDefault"/>
    <include
        android:id="@+id/fighter_form_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/division_rankings_button"
        app:layout_constraintEnd_toStartOf="@+id/divider_central"
        app:layout_constraintStart_toStartOf="@+id/fighter_image_1"
        app:layout_constraintTop_toBottomOf="@+id/value_wld_1"
        app:layout_goneMarginBottom="16dp"
        layout="@layout/item_mma_form_3"/>
    <include
        android:id="@+id/fighter_form_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="@+id/fighter_image_2"
        app:layout_constraintStart_toEndOf="@+id/divider_central"
        app:layout_constraintTop_toTopOf="@+id/fighter_form_1"
        layout="@layout/item_mma_form_3"/>
    <TextView
        android:textColor="@color/primary_default"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/division_rankings_button"
        android:background="@drawable/ripple_16_dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mma_division_rankings"
        android:drawablePadding="4dp"
        android:layout_marginVertical="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:drawableEndCompat="@drawable/ic_chevron_right_large_16"
        app:drawableTint="@color/primary_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fighter_form_1"
        style="@style/DisplaySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
