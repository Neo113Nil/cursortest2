<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_surface_level_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:paddingHorizontal="8dp"
    android:paddingVertical="16dp">
    <TextView
        android:textColor="@color/success"
        android:ellipsize="end"
        android:id="@+id/strengths_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/player_strengths"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/player_position_field_holder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/strengths_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        app:layout_constraintEnd_toEndOf="@+id/strengths_title"
        app:layout_constraintStart_toStartOf="@+id/strengths_title"
        app:layout_constraintTop_toBottomOf="@+id/strengths_title"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/error"
        android:ellipsize="end"
        android:id="@+id/weaknesses_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:text="@string/player_weaknesses"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/strengths_title"
        app:layout_constraintStart_toStartOf="@+id/strengths_title"
        app:layout_constraintTop_toTopOf="@+id/player_position_field_holder"
        style="@style/DisplaySmall"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/weaknesses_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        app:layout_constraintEnd_toEndOf="@+id/strengths_title"
        app:layout_constraintStart_toStartOf="@+id/strengths_title"
        app:layout_constraintTop_toBottomOf="@+id/weaknesses_title"
        style="@style/BodyMedium"/>
    <ImageView
        android:id="@+id/player_position_field_holder"
        android:background="@drawable/rounded_surface_level_4"
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:src="@drawable/ic_football_terrain_lines_only"
        android:scaleType="centerInside"
        android:backgroundTint="@color/terrain_football"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/surface_1"/>
    <GridView
        android:id="@+id/grid_positions"
        android:scrollbars="none"
        android:layout_width="105dp"
        android:layout_height="140dp"
        android:layout_marginBottom="20dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="3"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@+id/player_position_field_holder"
        app:layout_constraintEnd_toEndOf="@+id/player_position_field_holder"
        app:layout_constraintStart_toStartOf="@+id/player_position_field_holder"/>
    <include
        android:id="@+id/position_goalkeeper"
        android:layout_width="35dp"
        android:layout_height="28dp"
        android:layout_marginBottom="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_position_field_holder"
        app:layout_constraintEnd_toEndOf="@+id/player_position_field_holder"
        app:layout_constraintStart_toStartOf="@+id/player_position_field_holder"
        layout="@layout/player_position_grid_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
