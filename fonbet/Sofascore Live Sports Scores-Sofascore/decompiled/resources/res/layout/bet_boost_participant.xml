<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/dot_img"
        android:layout_width="12dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_timeline_dot_upcoming"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/n_lv_3"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/participant_text"
        android:paddingTop="1dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingExtra="1sp"
        android:textDirection="locale"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dot_img"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodySmall"/>
    <ImageView
        android:id="@+id/connector_line_extra"
        android:visibility="visible"
        android:layout_width="12dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_timeline_connector_line"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/barrier"
        app:layout_constraintEnd_toEndOf="@+id/dot_img"
        app:layout_constraintStart_toStartOf="@+id/dot_img"
        app:layout_constraintTop_toBottomOf="@+id/dot_img"
        app:tint="@color/n_lv_4"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="dot_img,participant_text"/>
    <ImageView
        android:id="@+id/connector_line"
        android:visibility="visible"
        android:layout_width="12dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_timeline_connector_line"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/dot_img"
        app:layout_constraintStart_toStartOf="@+id/dot_img"
        app:layout_constraintTop_toBottomOf="@+id/barrier"
        app:tint="@color/n_lv_4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
