<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxLines="1"
        android:layout_marginHorizontal="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMedium"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/subtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/AssistiveDefault"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cup_tree_bubble_container"
        android:background="@color/surface_1"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.sofascore.results.redesign.emptystateblocks.GraphicLarge
        android:id="@+id/cup_tree_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:graphicLargeDrawable="@drawable/cup_tree_placeholder"
        app:graphicLargeSubtitle="@string/cup_tree_empty_text"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cup_tree_container"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="8dp"/>
</LinearLayout>
