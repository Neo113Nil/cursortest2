<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/rounded_surface_level_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">
    <include
        android:id="@+id/highlighted_item_0"
        layout="@layout/item_highlighted_player_statistic"/>
    <Space
        android:id="@+id/space_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="8dp"
        android:layout_weight="1"/>
    <include
        android:id="@+id/highlighted_item_1"
        layout="@layout/item_highlighted_player_statistic"/>
    <Space
        android:id="@+id/space_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="8dp"
        android:layout_weight="1"/>
    <include
        android:id="@+id/highlighted_item_2"
        layout="@layout/item_highlighted_player_statistic"/>
    <Space
        android:id="@+id/space_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="8dp"
        android:layout_weight="1"/>
    <include
        android:id="@+id/highlighted_item_3"
        layout="@layout/item_highlighted_player_statistic"/>
</LinearLayout>
