<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rectangle_16dp_corners"
    android:layout_width="match_parent"
    android:layout_height="134dp"
    android:layout_margin="8dp"
    android:animateLayoutChanges="true">
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:id="@+id/overlay"
        android:background="@color/darken_overlay_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/name_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_marginHorizontal="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:id="@+id/first_fighter_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/first_fighter_image"
        app:layout_constraintStart_toStartOf="@+id/first_fighter_image"
        app:layout_constraintTop_toBottomOf="@+id/first_fighter_image"
        app:layout_constraintWidth_max="120dp"
        style="@style/DisplayMicro"/>
    <include
        android:id="@+id/win_marker_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/first_fighter_image"
        app:layout_constraintTop_toTopOf="@+id/first_fighter_image"
        layout="@layout/mma_winner_marker"/>
    <include
        android:id="@+id/win_marker_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/second_fighter_image"
        app:layout_constraintTop_toTopOf="@+id/second_fighter_image"
        layout="@layout/mma_winner_marker"/>
    <include
        android:id="@+id/text_middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/second_fighter_image"
        app:layout_constraintStart_toEndOf="@+id/first_fighter_image"
        app:layout_constraintTop_toTopOf="@+id/first_fighter_image"
        layout="@layout/mma_draw_layout"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:id="@+id/second_fighter_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/second_fighter_image"
        app:layout_constraintStart_toStartOf="@+id/second_fighter_image"
        app:layout_constraintTop_toBottomOf="@+id/second_fighter_image"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/first_fighter_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/mma_men_placeholder"
        app:layout_constraintEnd_toStartOf="@+id/round_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_time"/>
    <ImageView
        android:id="@+id/second_fighter_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/mma_men_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/round_info"
        app:layout_constraintTop_toBottomOf="@+id/name_time"/>
    <ImageView
        android:id="@+id/first_fighter_country"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_fighter_image"
        app:layout_constraintStart_toStartOf="@+id/first_fighter_image"/>
    <ImageView
        android:id="@+id/second_fighter_country"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_fighter_image"
        app:layout_constraintEnd_toEndOf="@+id/second_fighter_image"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/text_vs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/versus"
        app:layout_constraintBottom_toBottomOf="@+id/first_fighter_image"
        app:layout_constraintEnd_toStartOf="@+id/second_fighter_image"
        app:layout_constraintStart_toEndOf="@+id/first_fighter_image"
        style="@style/DisplaySmall"/>
    <com.sofascore.results.view.MmaRoundInfoView
        android:id="@+id/round_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_fighter_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
