<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/team_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/player_details_team_item"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/team_layouts_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:gravity="center"
        android:id="@+id/biography_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/biography"
        style="@style/DisplayMedium"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/player_details_grid_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <GridView
            android:id="@+id/player_details_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:numColumns="3"/>
        <include
            android:id="@+id/proposed_value_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="8dp"
            layout="@layout/player_details_header_user_value"/>
    </LinearLayout>
</LinearLayout>
