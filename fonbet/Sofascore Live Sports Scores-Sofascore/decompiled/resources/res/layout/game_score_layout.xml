<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/on_color_primary"
        android:id="@+id/game_map"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/sofascore_sans_medium"/>
    <include
        android:id="@+id/game_score_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/esports_score_container"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/on_color_secondary"
        android:gravity="center"
        android:id="@+id/game_duration"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        style="@style/BodyMedium"/>
    <include
        android:id="@+id/second_half_score_row"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        layout="@layout/esport_csgo_round_score_row"/>
    <View
        android:id="@+id/period_score_divider"
        android:background="@color/on_color_secondary"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"/>
    <include
        android:id="@+id/first_half_score_row"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        layout="@layout/esport_csgo_round_score_row"/>
</LinearLayout>
