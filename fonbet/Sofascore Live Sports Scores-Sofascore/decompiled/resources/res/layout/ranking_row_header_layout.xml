<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="start|center_vertical"
        android:id="@+id/ranking_section_left"
        android:paddingTop="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/ranking_section_right"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="end|center_vertical"
        android:id="@+id/ranking_section_right"
        android:paddingTop="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ranking_section_left"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TableMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
