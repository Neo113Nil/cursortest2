<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/search_edit"
        android:background="@drawable/rectangle_12dp_corners"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:hint="@string/search_player"
        android:drawablePadding="16dp"
        android:inputType="textCapSentences"
        android:imeOptions="actionSearch"
        android:drawableStart="@drawable/ic_search"
        android:paddingStart="16dp"
        android:paddingEnd="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/surface_2"
        android:drawableTint="@color/n_lv_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodyLarge"/>
    <ImageView
        android:id="@+id/clear_button"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_close"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/search_edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/search_edit"
        app:tint="@color/n_lv_1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
