<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/full_container"
        android:background="@drawable/rounded_surface_level_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/surface_2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/legend_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:text="@string/legend"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/expand_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DisplaySmall"/>
        <ImageView
            android:id="@+id/expand_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_up"
            android:rotation="-180"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/legend_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/legend_label"
            app:tint="@color/n_lv_1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/legend_label"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
