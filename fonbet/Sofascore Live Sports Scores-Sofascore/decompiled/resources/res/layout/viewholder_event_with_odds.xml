<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_surface_level_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="4dp"
    android:backgroundTint="@color/surface_1"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/info_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/surface_1"
        android:id="@+id/special_status_indicator"
        android:background="@drawable/rounded_surface_level_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/error"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_label"/>
    <com.sofascore.results.view.BellButton
        android:id="@+id/bell_button"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/first_team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_logo"
        app:layout_constraintEnd_toStartOf="@+id/first_team_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/first_team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/event_odds"
        app:layout_constraintEnd_toStartOf="@+id/main_text"
        app:layout_constraintStart_toEndOf="@+id/first_team_name"
        app:layout_constraintTop_toBottomOf="@+id/special_status_indicator"
        app:layout_goneMarginBottom="16dp"
        app:layout_goneMarginTop="12dp"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/main_text"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_logo"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"
        style="@style/BodyMedium"/>
    <ImageView
        android:id="@+id/second_team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_logo"
        app:layout_constraintEnd_toStartOf="@+id/second_team_name"
        app:layout_constraintStart_toEndOf="@+id/main_text"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/second_team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/second_team_logo"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/first_team_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/slash"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        app:layout_constraintTop_toTopOf="@+id/slash"
        style="@style/DisplayMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/slash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" - "
        app:layout_constraintEnd_toStartOf="@+id/second_team_score"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/first_team_score"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"
        style="@style/DisplayMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/second_team_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/slash"
        app:layout_constraintTop_toTopOf="@+id/slash"
        style="@style/DisplayMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/secondary_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_logo"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        style="@style/AssistiveMicro"/>
    <include
        android:id="@+id/event_odds"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/first_team_logo"
        layout="@layout/view_featured_tournament_event_odds"/>
</androidx.constraintlayout.widget.ConstraintLayout>
