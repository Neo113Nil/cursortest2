<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="280dp"
    android:paddingHorizontal="16dp">
    <ImageView
        android:id="@+id/image_screenshot_detected"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/screenshot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/screenshot_detected"
        android:maxLines="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_screenshot_detected"
        style="@style/AssistiveDefault"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/text_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/share_details_header"
        android:maxLines="3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_title"
        style="@style/DisplayLarge"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/text_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/share_details_body"
        android:maxLines="5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_subtitle"
        style="@style/BodyMediumParagraph"/>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:ellipsize="end"
        android:id="@+id/do_not_show_again_checkbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="@string/exit_checkbox"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:paddingHorizontal="8dp"
        app:buttonTint="@color/primary_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_body"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/text_color_link_selector"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/button_close"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/close_window_button"
        android:maxLines="1"
        android:textAllCaps="true"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/button_share"
        app:layout_constraintEnd_toStartOf="@+id/button_share"
        app:layout_constraintTop_toTopOf="@+id/button_share"
        style="@style/ActionButtonPrimary"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/surface_1"
        android:id="@+id/button_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="36dp"
        android:text="@string/button_share"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textAllCaps="true"
        android:drawableEnd="@drawable/ic_menu_list_share"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:backgroundTint="@color/primary_default"
        app:drawableTint="@color/surface_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/do_not_show_again_checkbox"
        style="@style/ActionButtonPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
