<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/youtube_player_view_stub"
        android:layout="@layout/media_video_highlight_player"
        android:inflatedId="@+id/youtube_player_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/watch_on_youtube_overlay"
        android:background="@drawable/gradient_darken_overlay_3"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:enableAutomaticInitialization="false"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/on_color_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:text="@string/video_unavailable_in_app"
            android:textAlignment="center"
            style="@style/BodyMedium"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/on_color_primary"
            android:layout_gravity="center"
            android:id="@+id/watch_on_youtube_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:text="@string/button_watch_on_youtube"
            android:textAllCaps="true"
            android:backgroundTint="@color/youtube_red"
            android:paddingVertical="8dp"
            app:cornerRadius="4dp"
            app:icon="@drawable/ic_youtube"
            app:iconTint="@color/on_color_primary"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/video_overlay_barrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="youtube_player_view,watch_on_youtube_overlay"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/title"
        android:background="@color/surface_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="2"
        android:textAlignment="viewStart"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/video_overlay_barrier"
        style="@style/DisplaySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
