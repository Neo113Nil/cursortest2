<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">
    <Space
        android:id="@+id/top_spacing"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/header_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/action_start_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_spacing"
        app:layout_goneMarginBottom="8dp"
        style="@style/DisplayMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/header_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/header_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_title"
        style="@style/AssistiveDefault"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/action_start_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="dropdown_image, action_label"/>
    <ImageView
        android:id="@+id/dropdown_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_chevron_down"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_spacing"
        app:tint="@color/n_lv_3"/>
    <TextView
        android:textColor="@color/primary_default"
        android:gravity="center"
        android:id="@+id/action_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:textAllCaps="true"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_spacing"
        style="@style/ActionButtonPrimary"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_section"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:indicatorSize="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/dropdown_image"
        app:layout_constraintStart_toStartOf="@+id/dropdown_image"
        app:layout_constraintTop_toBottomOf="@+id/top_spacing"
        style="@style/PrimaryCircularProgressStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
