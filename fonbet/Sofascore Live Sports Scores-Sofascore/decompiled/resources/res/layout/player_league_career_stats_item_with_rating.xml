<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/player_career_stats_column_width"
    android:layout_height="24dp">
    <TextView
        android:textSize="14dp"
        android:textColor="@color/color_selectable_n_lv_1"
        android:gravity="center"
        android:id="@+id/value"
        android:layout_width="@dimen/player_career_stats_column_width"
        android:layout_height="24dp"
        android:maxLines="1"
        android:paddingHorizontal="1dp"
        style="@style/BodyMedium"/>
    <com.sofascore.results.view.SofascoreSmallRatingView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/rating"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="24dp"
        app:small_animateRating="false"
        app:small_isAvgRating="true"/>
</FrameLayout>
