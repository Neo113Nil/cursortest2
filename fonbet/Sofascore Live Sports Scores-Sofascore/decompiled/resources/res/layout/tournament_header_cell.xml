<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/top_divider"
        android:background="@color/surface_0"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingVertical="4dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:ellipsize="end"
            android:id="@+id/text_upper_1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="locale"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_upper_2"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/text_upper_2"
            style="@style/DisplayMicro"/>
        <ImageView
            android:id="@+id/arrow_1"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_breadcrumb_16"
            android:scaleX="@integer/drawable_scaleX_normal"
            app:layout_constraintBottom_toBottomOf="@+id/text_upper_2"
            app:layout_constraintStart_toEndOf="@+id/text_upper_1"
            app:layout_constraintTop_toTopOf="@+id/text_upper_2"
            app:tint="@color/n_lv_3"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:ellipsize="end"
            android:id="@+id/text_upper_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="locale"
            android:layout_marginEnd="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/text_lower"
            app:layout_constraintEnd_toStartOf="@+id/pin_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/arrow_1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="8dp"
            app:layout_goneMarginStart="20dp"
            style="@style/DisplayMicro"/>
        <ImageView
            android:id="@+id/pin_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pin_on_no_padding"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_upper_2"
            app:layout_constraintEnd_toStartOf="@+id/follow_button"
            app:layout_constraintStart_toEndOf="@+id/text_upper_2"
            app:layout_constraintTop_toTopOf="@+id/text_upper_2"
            app:tint="@color/n_lv_1"/>
        <ImageView
            android:id="@+id/image_lower"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_lower"
            app:layout_constraintEnd_toStartOf="@+id/text_lower"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/text_lower"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/text_lower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="16dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/lower_separator_dot"
            app:layout_constraintStart_toEndOf="@+id/image_lower"
            app:layout_constraintTop_toBottomOf="@+id/text_upper_2"
            app:layout_goneMarginStart="20dp"
            style="@style/AssistiveDefault"/>
        <View
            android:id="@+id/lower_separator_dot"
            android:background="@drawable/circle_4dp_n_lv_3"
            android:visibility="gone"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_lower"
            app:layout_constraintEnd_toStartOf="@+id/image_lower_2"
            app:layout_constraintStart_toEndOf="@+id/text_lower"
            app:layout_constraintTop_toTopOf="@+id/text_lower"/>
        <ImageView
            android:id="@+id/image_lower_2"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_lower"
            app:layout_constraintEnd_toStartOf="@+id/text_lower_2"
            app:layout_constraintStart_toEndOf="@+id/lower_separator_dot"
            app:layout_constraintTop_toTopOf="@+id/text_lower"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/text_lower_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/text_lower"
            app:layout_constraintEnd_toStartOf="@+id/follow_button"
            app:layout_constraintStart_toEndOf="@+id/image_lower_2"
            app:layout_constraintTop_toTopOf="@+id/text_lower"
            style="@style/AssistiveDefault"/>
        <com.sofascore.results.view.follownotification.FollowButton
            android:id="@+id/follow_button"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            app:iconShape="circle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
