<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <androidx.constraintlayout.widget.Group
            android:id="@+id/status_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="status_label,status"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/status_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="24dp"
            android:text="@string/crowdsourcing_suggestion_status"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DisplaySmall"/>
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AssistiveMicro"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:gravity="center_horizontal"
            android:id="@+id/score_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crowdsourcing_enter_the_correct_ft_score"
            app:layout_constraintTop_toBottomOf="@+id/status_label"
            style="@style/BodyMedium"/>
        <ImageView
            android:id="@+id/team_first_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="36dp"
            app:layout_constraintStart_toStartOf="@+id/first_team_add_score"
            app:layout_constraintTop_toBottomOf="@+id/score_info"
            app:layout_goneMarginTop="16dp"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/team_first_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="120dp"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="@+id/team_first_logo"
            app:layout_constraintStart_toStartOf="@+id/team_first_logo"
            app:layout_constraintTop_toBottomOf="@+id/team_first_logo"
            style="@style/DisplayMicro"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/team_name_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="team_first_name,team_second_name"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:gravity="center"
            android:id="@+id/team_first_score"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/text_primary"
            app:layout_constraintEnd_toStartOf="@+id/text_primary"
            app:layout_constraintTop_toTopOf="@+id/text_primary"
            style="@style/DisplayExtraLarge"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:gravity="center"
            android:id="@+id/text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/team_first_logo"
            app:layout_constraintEnd_toStartOf="@+id/team_second_logo"
            app:layout_constraintStart_toEndOf="@+id/team_first_logo"
            app:layout_constraintTop_toTopOf="@+id/team_first_logo"
            style="@style/DisplayExtraLarge"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:gravity="center"
            android:id="@+id/text_secondary"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="@+id/text_primary"
            app:layout_constraintStart_toStartOf="@+id/text_primary"
            app:layout_constraintTop_toBottomOf="@+id/text_primary"
            style="@style/AssistiveDefault"/>
        <ImageView
            android:id="@+id/team_second_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="36dp"
            app:layout_constraintEnd_toEndOf="@+id/second_team_add_score"
            app:layout_constraintTop_toTopOf="@+id/team_first_logo"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/team_second_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="120dp"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="@+id/team_first_name"
            app:layout_constraintEnd_toEndOf="@+id/team_second_logo"
            app:layout_constraintStart_toStartOf="@+id/team_second_logo"
            app:layout_constraintTop_toBottomOf="@+id/team_second_logo"
            style="@style/DisplayMicro"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:gravity="center"
            android:id="@+id/team_second_score"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/text_primary"
            app:layout_constraintStart_toEndOf="@+id/text_primary"
            app:layout_constraintTop_toTopOf="@+id/text_primary"
            style="@style/DisplayExtraLarge"/>
        <ImageView
            android:id="@+id/first_team_add_score"
            android:background="@drawable/rectangle_8dp_corners"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_plus"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/surface_2"
            android:paddingVertical="20dp"
            app:layout_constraintEnd_toStartOf="@+id/second_team_add_score"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/team_name_barrier"
            app:tint="@color/n_lv_1"/>
        <ImageView
            android:id="@+id/second_team_add_score"
            android:background="@drawable/rectangle_8dp_corners"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_plus"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/surface_2"
            android:paddingVertical="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/first_team_add_score"
            app:layout_constraintTop_toBottomOf="@+id/team_name_barrier"
            app:tint="@color/n_lv_1"/>
        <TextView
            android:textColor="@color/crowdsourcing"
            android:id="@+id/clear_all"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/crowdsourcing_clear_all_suggestions_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/first_team_add_score"
            style="@style/BodyMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
