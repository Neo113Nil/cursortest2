<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="8dp"
        android:paddingBottom="48dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <TextView
            android:id="@+id/win_probability_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cricket_runs_per_over_info_text"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/runs_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/cricket_runs"
            android:layout_marginStart="40dp"
            app:layout_constraintBottom_toTopOf="@+id/graph_icon"
            app:layout_constraintStart_toStartOf="@+id/graph_icon"
            app:layout_constraintTop_toBottomOf="@+id/win_probability_text"
            style="@style/AssistiveDefault"/>
        <ImageView
            android:id="@+id/graph_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:src="@drawable/cricket_runs_per_over"
            android:scaleX="@integer/drawable_scaleX_normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/runs_label"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/overs_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overs"
            android:layout_marginStart="60dp"
            app:layout_constraintStart_toStartOf="@+id/graph_icon"
            app:layout_constraintTop_toBottomOf="@+id/graph_icon"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/secondary_default"
            android:ellipsize="end"
            android:id="@+id/home_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/graph_icon"
            app:layout_constraintTop_toTopOf="@+id/graph_icon"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/primary_default"
            android:ellipsize="end"
            android:id="@+id/away_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/graph_icon"
            app:layout_constraintTop_toBottomOf="@+id/home_label"
            style="@style/AssistiveDefault"/>
        <View
            android:id="@+id/home_wicket_circle"
            android:background="@drawable/circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/home_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/overs_label"/>
        <View
            android:background="@drawable/circle"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:backgroundTint="@color/surface_1"
            app:layout_constraintBottom_toBottomOf="@+id/home_wicket_circle"
            app:layout_constraintEnd_toEndOf="@+id/home_wicket_circle"
            app:layout_constraintStart_toStartOf="@+id/home_wicket_circle"
            app:layout_constraintTop_toTopOf="@+id/home_wicket_circle"/>
        <TextView
            android:textColor="@color/home_primary"
            android:ellipsize="end"
            android:id="@+id/home_wickets_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/home_wicket_circle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/home_wicket_circle"
            app:layout_constraintTop_toTopOf="@+id/home_wicket_circle"
            style="@style/AssistiveDefault"/>
        <View
            android:id="@+id/away_wicket_circle"
            android:background="@drawable/circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/away_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/home_wicket_circle"/>
        <View
            android:background="@drawable/circle"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:backgroundTint="@color/surface_1"
            app:layout_constraintBottom_toBottomOf="@+id/away_wicket_circle"
            app:layout_constraintEnd_toEndOf="@+id/away_wicket_circle"
            app:layout_constraintStart_toStartOf="@+id/away_wicket_circle"
            app:layout_constraintTop_toTopOf="@+id/away_wicket_circle"/>
        <TextView
            android:textColor="@color/primary_default"
            android:ellipsize="end"
            android:id="@+id/away_wickets_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/away_wicket_circle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/away_wicket_circle"
            app:layout_constraintTop_toTopOf="@+id/away_wicket_circle"
            style="@style/AssistiveDefault"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
