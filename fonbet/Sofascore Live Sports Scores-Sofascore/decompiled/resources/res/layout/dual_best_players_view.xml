<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_surface_level_1"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <ImageView
        android:id="@+id/image_player_first"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="-8dp"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toTopOf="@+id/rating_first"
        app:layout_constraintEnd_toEndOf="@+id/divider_first_top"
        app:layout_constraintStart_toStartOf="@+id/divider_first_top"
        app:layout_goneMarginBottom="8dp"/>
    <View
        android:id="@+id/divider_first_top"
        android:background="@color/n_lv_4"
        android:layout_width="84dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider_first_side"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:id="@+id/player_name_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/divider_first_top"
        app:layout_constraintStart_toStartOf="@+id/divider_first_top"
        style="@style/DisplayMicro"/>
    <com.sofascore.results.view.SofascoreSmallRatingView
        android:textSize="12dp"
        android:layout_gravity="start"
        android:id="@+id/rating_first"
        android:padding="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/player_name_first"
        app:layout_constraintEnd_toEndOf="@+id/image_player_first"
        app:layout_constraintStart_toStartOf="@+id/image_player_first"
        style="@style/TableSmall"/>
    <ImageView
        android:id="@+id/image_player_second"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="-8dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toTopOf="@+id/rating_second"
        app:layout_constraintEnd_toEndOf="@+id/divider_second_top"
        app:layout_constraintStart_toStartOf="@+id/divider_second_top"
        app:layout_goneMarginBottom="8dp"/>
    <View
        android:id="@+id/divider_second_top"
        android:background="@color/n_lv_4"
        android:layout_width="84dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider_second_side"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:id="@+id/player_name_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/divider_second_top"
        app:layout_constraintStart_toStartOf="@+id/divider_second_top"
        style="@style/DisplayMicro"/>
    <com.sofascore.results.view.SofascoreSmallRatingView
        android:textSize="12dp"
        android:layout_gravity="start"
        android:id="@+id/rating_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minWidth="0dp"
        android:paddingHorizontal="1dp"
        android:paddingVertical="1dp"
        app:layout_constraintBottom_toTopOf="@+id/player_name_second"
        app:layout_constraintEnd_toEndOf="@+id/image_player_second"
        app:layout_constraintStart_toStartOf="@+id/image_player_second"
        style="@style/TableSmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/statistic_label_1"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:text="@string/basketball_lineups_points"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/statistic_label_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/statistic_label_2"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:text="@string/basketball_lineups_rebounds"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/statistic_label_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statistic_label_1"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/statistic_label_3"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:text="@string/basketball_lineups_assists"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/statistic_label_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statistic_label_2"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/statistic_label_4"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:text="@string/basketball_lineups_steals"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/statistic_label_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statistic_label_3"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/statistic_label_5"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:text="@string/basketball_lineups_blocks"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statistic_label_4"
        style="@style/AssistiveDefault"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_first_1"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:textAllCaps="true"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toTopOf="@+id/statistic_first_2"
        app:layout_constraintStart_toEndOf="@+id/divider_first_top"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_first_2"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/statistic_first_3"
        app:layout_constraintStart_toStartOf="@+id/statistic_first_1"
        app:layout_constraintTop_toBottomOf="@+id/statistic_first_1"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_first_3"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/statistic_first_4"
        app:layout_constraintStart_toStartOf="@+id/statistic_first_1"
        app:layout_constraintTop_toBottomOf="@+id/statistic_first_2"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_first_4"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/statistic_first_5"
        app:layout_constraintStart_toStartOf="@+id/statistic_first_1"
        app:layout_constraintTop_toBottomOf="@+id/statistic_first_3"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_first_5"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/statistic_first_1"
        app:layout_constraintTop_toBottomOf="@+id/statistic_first_4"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_second_1"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:textAllCaps="true"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/statistic_second_2"
        app:layout_constraintEnd_toStartOf="@+id/divider_second_top"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_second_2"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/statistic_second_3"
        app:layout_constraintEnd_toEndOf="@+id/statistic_second_1"
        app:layout_constraintTop_toBottomOf="@+id/statistic_second_1"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_second_3"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/statistic_second_4"
        app:layout_constraintEnd_toEndOf="@+id/statistic_second_1"
        app:layout_constraintTop_toBottomOf="@+id/statistic_second_2"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_second_4"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/statistic_second_5"
        app:layout_constraintEnd_toEndOf="@+id/statistic_second_1"
        app:layout_constraintTop_toBottomOf="@+id/statistic_second_3"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_second_5"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/statistic_second_1"
        app:layout_constraintTop_toBottomOf="@+id/statistic_second_4"
        style="@style/DisplaySmall"/>
    <View
        android:id="@+id/click_container_first"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/divider_first_top"
        app:layout_constraintStart_toStartOf="@+id/divider_first_top"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/click_container_second"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/divider_second_top"
        app:layout_constraintStart_toStartOf="@+id/divider_second_top"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
