<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <SeekBar
        android:id="@+id/player_pentagon_seek_bar"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:max="3"
        android:progress="3"
        android:progressDrawable="@drawable/player_details_compare_slider_background"
        android:thumb="@drawable/player_details_pentagon_slider_thumb"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:splitTrack="false"
        android:layout_marginHorizontal="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/label_point_1_background"
        android:background="@drawable/circle"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:backgroundTint="@color/surface_1"
        app:layout_constraintBottom_toBottomOf="@+id/label_point_1"
        app:layout_constraintEnd_toEndOf="@+id/label_point_1"
        app:layout_constraintStart_toStartOf="@+id/label_point_1"
        app:layout_constraintTop_toTopOf="@+id/label_point_1"/>
    <View
        android:id="@+id/label_point_1"
        android:background="@drawable/circle"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginBottom="0.5dp"
        android:layout_marginStart="6dp"
        android:backgroundTint="@color/neutral_variant"
        app:layout_constraintBottom_toBottomOf="@+id/player_pentagon_seek_bar"
        app:layout_constraintEnd_toStartOf="@+id/label_point_2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/player_pentagon_seek_bar"
        app:layout_constraintTop_toTopOf="@+id/player_pentagon_seek_bar"/>
    <View
        android:id="@+id/label_point_2_background"
        android:background="@drawable/circle"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:backgroundTint="@color/surface_1"
        app:layout_constraintBottom_toBottomOf="@+id/label_point_2"
        app:layout_constraintEnd_toEndOf="@+id/label_point_2"
        app:layout_constraintStart_toStartOf="@+id/label_point_2"
        app:layout_constraintTop_toTopOf="@+id/label_point_2"/>
    <View
        android:id="@+id/label_point_2"
        android:background="@drawable/circle"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:backgroundTint="@color/neutral_variant"
        app:layout_constraintBottom_toBottomOf="@+id/label_point_1"
        app:layout_constraintEnd_toStartOf="@+id/label_point_3"
        app:layout_constraintStart_toEndOf="@+id/label_point_1"
        app:layout_constraintTop_toTopOf="@+id/label_point_1"/>
    <View
        android:id="@+id/label_point_3_background"
        android:background="@drawable/circle"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:backgroundTint="@color/surface_1"
        app:layout_constraintBottom_toBottomOf="@+id/label_point_3"
        app:layout_constraintEnd_toEndOf="@+id/label_point_3"
        app:layout_constraintStart_toStartOf="@+id/label_point_3"
        app:layout_constraintTop_toTopOf="@+id/label_point_3"/>
    <View
        android:id="@+id/label_point_3"
        android:background="@drawable/circle"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:backgroundTint="@color/neutral_variant"
        app:layout_constraintBottom_toBottomOf="@+id/label_point_1"
        app:layout_constraintEnd_toStartOf="@+id/label_point_4"
        app:layout_constraintStart_toEndOf="@+id/label_point_2"
        app:layout_constraintTop_toTopOf="@+id/label_point_1"/>
    <View
        android:id="@+id/label_point_4_background"
        android:background="@drawable/circle"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:backgroundTint="@color/surface_1"
        app:layout_constraintBottom_toBottomOf="@+id/label_point_4"
        app:layout_constraintEnd_toEndOf="@+id/label_point_4"
        app:layout_constraintStart_toStartOf="@+id/label_point_4"
        app:layout_constraintTop_toTopOf="@+id/label_point_4"/>
    <View
        android:id="@+id/label_point_4"
        android:background="@drawable/circle"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="@color/neutral_variant"
        app:layout_constraintBottom_toBottomOf="@+id/label_point_1"
        app:layout_constraintEnd_toEndOf="@+id/player_pentagon_seek_bar"
        app:layout_constraintStart_toEndOf="@+id/label_point_3"
        app:layout_constraintTop_toTopOf="@+id/label_point_1"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/label_text_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="80dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/label_point_1"
        app:layout_constraintStart_toStartOf="@+id/label_point_1"
        app:layout_constraintTop_toBottomOf="@+id/player_pentagon_seek_bar"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/label_text_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="80dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/label_point_2"
        app:layout_constraintStart_toStartOf="@+id/label_point_2"
        app:layout_constraintTop_toTopOf="@+id/label_text_1"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/label_text_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="80dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/label_point_3"
        app:layout_constraintStart_toStartOf="@+id/label_point_3"
        app:layout_constraintTop_toTopOf="@+id/label_text_1"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/label_text_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="80dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/label_point_4"
        app:layout_constraintStart_toStartOf="@+id/label_point_4"
        app:layout_constraintTop_toTopOf="@+id/label_text_1"
        style="@style/AssistiveDefault"/>
</androidx.constraintlayout.widget.ConstraintLayout>
