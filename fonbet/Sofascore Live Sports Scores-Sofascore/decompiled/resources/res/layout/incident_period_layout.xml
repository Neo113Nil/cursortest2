<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/text_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toTopOf="@+id/spacer_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/period_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            style="@style/DisplayMicro"/>
        <ImageView
            android:id="@+id/arrow"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_down_large_16"
            android:layout_marginStart="4dp"
            app:tint="@color/n_lv_1"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_left"
        android:background="@color/n_lv_4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/text_layout"
        app:layout_constraintEnd_toStartOf="@+id/text_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text_layout"/>
    <View
        android:id="@+id/divider_left_vertical"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="7dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_left"/>
    <View
        android:id="@+id/divider_right"
        android:background="@color/n_lv_4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/text_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text_layout"
        app:layout_constraintTop_toTopOf="@+id/text_layout"/>
    <View
        android:id="@+id/divider_right_vertical"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="7dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_right"/>
    <View
        android:id="@+id/spacer_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/divider_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="divider_left, divider_left_vertical, divider_right, divider_right_vertical"/>
</androidx.constraintlayout.widget.ConstraintLayout>
