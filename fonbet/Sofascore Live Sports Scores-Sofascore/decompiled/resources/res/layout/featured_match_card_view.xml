<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/rounded_surface_level_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <TextView
        android:gravity="bottom|center_horizontal"
        android:id="@+id/featured_match_title"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/featured"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/DisplayMedium"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:backgroundTint="@color/surface_2">
        <include
            android:id="@+id/league_details_row"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/league_details_label_constrained_height"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/featured_match_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/home_team_logo_2"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="60dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/home_team_logo_1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/home_team_logo_2"
                app:layout_constraintVertical_bias="0"
                app:layout_goneMarginTop="8dp"/>
            <TextView
                android:textColor="@color/surface_1"
                android:gravity="center"
                android:id="@+id/home_team_seed"
                android:background="@drawable/rounded_surface_level_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:minWidth="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/home_team_logo_1"
                app:layout_constraintEnd_toEndOf="@+id/home_team_logo_1"
                style="@style/AssistiveMicro"/>
            <ImageView
                android:id="@+id/home_team_flag_1"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/home_team_logo_1"
                app:layout_constraintStart_toStartOf="@+id/home_team_logo_1"/>
            <ImageView
                android:id="@+id/home_team_flag_2"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/home_team_logo_2"
                app:layout_constraintEnd_toEndOf="@+id/home_team_logo_2"/>
            <ImageView
                android:id="@+id/away_team_logo_1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/home_team_logo_1"/>
            <ImageView
                android:id="@+id/away_team_logo_2"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="60dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/home_team_logo_1"/>
            <TextView
                android:textColor="@color/surface_1"
                android:gravity="center"
                android:id="@+id/away_team_seed"
                android:background="@drawable/rounded_surface_level_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:minWidth="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/away_team_logo_1"
                app:layout_constraintStart_toStartOf="@+id/away_team_logo_1"
                style="@style/AssistiveMicro"/>
            <ImageView
                android:id="@+id/away_team_flag_1"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/away_team_logo_1"
                app:layout_constraintEnd_toEndOf="@+id/away_team_logo_1"/>
            <ImageView
                android:id="@+id/away_team_flag_2"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/away_team_logo_2"
                app:layout_constraintStart_toStartOf="@+id/away_team_logo_2"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/home_logo_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="end"
                app:constraint_referenced_ids="home_team_logo_1, home_team_logo_2"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/away_logo_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="away_team_logo_1, away_team_logo_2"/>
            <TextView
                android:gravity="center"
                android:id="@+id/main_text"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="24dp"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toTopOf="@+id/primary_score_slash"
                app:layout_constraintEnd_toStartOf="@+id/away_logo_barrier"
                app:layout_constraintStart_toEndOf="@+id/home_logo_barrier"
                app:layout_constraintTop_toTopOf="@+id/home_team_logo_1"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/DisplayLarge"/>
            <TextView
                android:gravity="center"
                android:id="@+id/primary_score_home"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/primary_score_slash"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toEndOf="@+id/home_logo_barrier"
                app:layout_constraintTop_toTopOf="@+id/primary_score_slash"
                style="@style/DisplayExtraLarge"/>
            <TextView
                android:gravity="center"
                android:id="@+id/primary_score_slash"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:text=" - "
                app:layout_constraintBottom_toTopOf="@+id/bottom_text"
                app:layout_constraintEnd_toStartOf="@+id/away_logo_barrier"
                app:layout_constraintStart_toEndOf="@+id/home_logo_barrier"
                app:layout_constraintTop_toBottomOf="@+id/main_text"
                style="@style/DisplayExtraLarge"/>
            <TextView
                android:gravity="center"
                android:id="@+id/primary_score_away"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/away_logo_barrier"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/primary_score_slash"
                app:layout_constraintTop_toTopOf="@+id/primary_score_slash"
                style="@style/DisplayExtraLarge"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:gravity="center"
                android:id="@+id/bottom_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:layout_marginHorizontal="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/home_team_logo_1"
                app:layout_constraintEnd_toStartOf="@+id/away_logo_barrier"
                app:layout_constraintStart_toEndOf="@+id/home_logo_barrier"
                app:layout_constraintTop_toBottomOf="@+id/primary_score_slash"
                style="@style/BodyMedium"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/home_team_name_container"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minHeight="28dp"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/home_team_logo_1">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/home_team_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/DisplayMicro"/>
                <TextView
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/home_team_name_2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/DisplayMicro"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/away_team_name_container"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minHeight="28dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/home_team_name_container">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/away_team_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/DisplayMicro"/>
                <TextView
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/away_team_name_2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/DisplayMicro"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/cta_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/primary_default"
            android:layout_gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/see_all"
            app:drawableEndCompat="@drawable/ic_chevron_right_small_16"
            app:drawableTint="@color/primary_default"
            style="@style/DisplaySmall"/>
    </FrameLayout>
</LinearLayout>
