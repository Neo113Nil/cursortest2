<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/rounded_surface_level_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <TextView
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:text="@string/popular_players"
        android:maxLines="1"
        android:layout_marginHorizontal="20dp"
        android:paddingVertical="8dp"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/primary_default"
        android:layout_gravity="center_horizontal"
        android:id="@+id/all_players_button"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/see_all_players"
        style="@style/AssistiveDefault"/>
</LinearLayout>
