<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:paddingHorizontal="16dp">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/text_first_team_score"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TableMedium"/>
    <ImageView
        android:id="@+id/image_first_team_team"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/text_first_team_score"
        app:tint="@color/live"/>
    <ImageView
        android:id="@+id/image_second_team_team"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/text_second_team_score"
        app:tint="@color/live"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/text_second_team_score"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/TableMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
