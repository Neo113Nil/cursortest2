<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blaze_fragment_videos_rootContainer"
    android:background="@color/blaze_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <FrameLayout
        android:id="@+id/blaze_player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/blaze_preview_image"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_player_container"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"
        app:layout_constraintTop_toTopOf="@+id/blaze_player_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blaze_captionsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_player_container"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"
        app:layout_constraintTop_toTopOf="@+id/blaze_player_container"/>
    <View
        android:id="@+id/blaze_videoShadowOverlay"
        android:background="#80000000"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/blaze_videosFullAreaReplayButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/blaze_drawable_ic_videos_replay"
        android:contentDescription="@string/blaze_accessibility_replay_video"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_player_container"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"
        app:layout_constraintTop_toTopOf="@+id/blaze_player_container"/>
    <LinearLayout
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/blaze_videosTopIconsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/blaze_videoCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_videos_close"
            android:contentDescription="@string/blaze_accessibility_close"
            android:importantForAccessibility="yes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/blaze_videosShareButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_videos_share"
            android:contentDescription="@string/blaze_accessibility_share_video"
            android:importantForAccessibility="yes"/>
        <ImageView
            android:id="@+id/blaze_videosLikeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_selector_video_like"
            android:contentDescription="@string/blaze_accessibility_like_video"
            android:importantForAccessibility="yes"/>
        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/blaze_videosCastButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/blaze_accessibility_cast_video"
            android:importantForAccessibility="yes"/>
        <ImageView
            android:id="@+id/blaze_videosPipButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_pip"
            android:contentDescription="@string/blaze_accessibility_pip_video"
            android:importantForAccessibility="yes"/>
    </LinearLayout>
    <com.blaze.blazesdk.players.ui.StatusIndicatorView
        android:id="@+id/blaze_videosStatusIndicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/blaze_accessibility_chip_status_indicator"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/blaze_videosTopIconsContainer"/>
    <com.blaze.blazesdk.custom_views.BlazeTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/blaze_white"
        android:ellipsize="end"
        android:id="@+id/blaze_videosHeadingText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/blaze_videosTopIconsContainer"
        app:layout_constraintStart_toEndOf="@+id/blaze_videosStatusIndicator"
        app:layout_constraintTop_toTopOf="@+id/blaze_videosTopIconsContainer"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/blaze_videosCenterIconsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/blaze_videosSkipPrevButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_videos_skip_prev_selector"
            android:contentDescription="@string/blaze_accessibility_previous_video"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="16dp"/>
        <ImageView
            android:id="@+id/blaze_videosSeekBackwardButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_videos_player_backward_10_sec"
            android:contentDescription="@string/blaze_accessibility_seek_backward"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="16dp"/>
        <FrameLayout
            android:id="@+id/blaze_videosPlayPauseReplayContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/blaze_videosPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/blaze_drawable_ic_videos_player_play_pause_selector"
                android:contentDescription="@string/blaze_accessibility_play_video"
                android:importantForAccessibility="yes"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/blaze_videosControllerReplayButton"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/blaze_drawable_ic_videos_replay"
                android:contentDescription="@string/blaze_accessibility_replay_video"
                android:importantForAccessibility="yes"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/blaze_videosSeekForwardButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_videos_player_forward_10_sec"
            android:contentDescription="@string/blaze_accessibility_seek_forward"
            android:importantForAccessibility="yes"
            android:layout_marginStart="16dp"/>
        <ImageView
            android:id="@+id/blaze_videosSkipNextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_videos_skip_next_selector"
            android:contentDescription="@string/blaze_accessibility_next_video"
            android:importantForAccessibility="yes"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <com.blaze.blazesdk.custom_views.BlazeTextView
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/blaze_videosSeekBackwardIndicator"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/teko_bold"
        android:layout_marginStart="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.blaze.blazesdk.custom_views.BlazeTextView
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/blaze_videosSeekForwardIndicator"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/teko_bold"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/blaze_videosFastForwardIndicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:src="@drawable/blaze_drawable_ic_videos_player_forward_2x"
        android:contentDescription="@string/blaze_accessibility_fast_forward"
        android:importantForAccessibility="yes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.blaze.blazesdk.custom_views.BlazeTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/blaze_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/blaze_videosCastingText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:maxLines="2"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/blaze_videosCenterIconsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.blaze.blazesdk.custom_views.BlazeTextView
        android:textSize="14sp"
        android:textColor="@color/blaze_white"
        android:id="@+id/blaze_videosProgressText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/blaze_common_large_margin"
        app:layout_constraintBottom_toTopOf="@+id/blaze_videosSeekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.blaze.blazesdk.custom_views.BlazeTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/blaze_white"
        android:gravity="center"
        android:id="@+id/blaze_videosSeekingTextView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toTopOf="@+id/blaze_videosSeekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.blaze.blazesdk.custom_views.BlazeTextWithIconButton
        android:id="@+id/blaze_videosCta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="@dimen/blaze_common_large_margin"
        app:backgroundTint="@null"
        app:blaze_textColor="@color/blaze_videos_cta_text_color"
        app:blaze_textSize="16sp"
        app:blaze_textStyle="bold"
        app:contentPaddingLeft="@dimen/blaze_common_medium_padding"
        app:contentPaddingRight="@dimen/blaze_common_medium_padding"
        app:layout_constraintBottom_toTopOf="@+id/blaze_videosProgressText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.blaze.blazesdk.custom_views.BlazeDefaultTimeBar
        android:id="@+id/blaze_videosSeekBar"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/blaze_videosBottomIconsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.blaze.blazesdk.players.ui.BackToLiveButtonView
        android:id="@+id/blaze_videosBackToLiveButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_videosBottomIconsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/blaze_videosBottomIconsContainer"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/blaze_videosBottomIconsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/blaze_videosClosedCaptionsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_selector_videos_captions"
            android:contentDescription="@string/blaze_accessibility_toggle_captions"
            android:importantForAccessibility="yes"/>
        <ImageView
            android:id="@+id/blaze_videosSoundButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_selector_sound"
            android:contentDescription="@string/blaze_accessibility_toggle_mute"
            android:importantForAccessibility="yes"/>
        <ImageView
            android:id="@+id/blaze_videosSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_settings"
            android:contentDescription="@string/blaze_accessibility_video_settings"
            android:importantForAccessibility="yes"/>
        <ImageView
            android:id="@+id/blaze_videosMaximizeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_maximize"
            android:contentDescription="@string/blaze_accessibility_toggle_video_fullscreen"
            android:importantForAccessibility="yes"/>
        <ImageView
            android:id="@+id/blaze_videosForceRotationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_screen_rotation"
            android:contentDescription="@string/blaze_accessibility_force_rotation"
            android:importantForAccessibility="yes"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/blaze_videosProgressbar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/blaze_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
