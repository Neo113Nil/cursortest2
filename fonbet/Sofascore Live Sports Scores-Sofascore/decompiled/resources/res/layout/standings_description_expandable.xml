<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_container"
    android:background="@color/surface_1"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp">
    <ImageView
        android:id="@+id/background_container"
        android:background="@drawable/rounded_surface_level_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:backgroundTint="@color/surface_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/standings_rules_and_legend"
        android:layout_marginStart="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintStart_toStartOf="@+id/background_container"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <ImageView
        android:id="@+id/chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_chevron_down"
        android:tint="@color/n_lv_1"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/background_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/background_container"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
