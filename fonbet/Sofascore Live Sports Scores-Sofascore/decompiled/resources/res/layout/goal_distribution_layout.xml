<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.typeheader.TypeHeaderView
        android:id="@+id/goal_distribution_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <include
            android:id="@+id/first_team_scored_row"
            layout="@layout/goal_distribution_row"/>
        <include
            android:id="@+id/second_team_conceded_row"
            layout="@layout/goal_distribution_row"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>
        <include
            android:id="@+id/second_team_scored_row"
            layout="@layout/goal_distribution_row"/>
        <include
            android:id="@+id/first_team_conceded_row"
            layout="@layout/goal_distribution_row"/>
        <LinearLayout
            android:layout_gravity="end"
            android:paddingTop="4dp"
            android:layout_width="170dp"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:textColor="@color/n_lv_3"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00&apos;"
                style="@style/TableMedium"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="15&apos;"
                android:layout_weight="1"
                style="@style/TableMedium"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="30&apos;"
                android:layout_weight="1"
                style="@style/TableMedium"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="45&apos;"
                android:layout_weight="1"
                style="@style/TableMedium"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="60&apos;"
                android:layout_weight="1"
                style="@style/TableMedium"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="75&apos;"
                android:layout_weight="1"
                style="@style/TableMedium"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90&apos;"
                style="@style/TableMedium"/>
        </LinearLayout>
        <include
            android:id="@+id/description"
            layout="@layout/legend_item_layout"/>
    </LinearLayout>
</LinearLayout>
