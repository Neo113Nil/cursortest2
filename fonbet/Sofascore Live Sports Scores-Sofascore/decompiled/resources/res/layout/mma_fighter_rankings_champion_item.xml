<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/rank"
        android:layout_width="24dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_champion"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/fighter_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rank"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/fighter_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:hyphenationFrequency="normalFast"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/last_fight_opponent"
        app:layout_constraintStart_toEndOf="@+id/fighter_image"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/last_fight_result"
        android:background="@drawable/circle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/surface_2"
        app:layout_constraintBottom_toTopOf="@+id/last_fight_date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/last_fight_opponent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="textEnd"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/last_fight_date"
        app:layout_constraintEnd_toStartOf="@+id/last_fight_date"
        app:layout_constraintStart_toStartOf="@+id/barrier_opponent_name_start"
        app:layout_constraintTop_toTopOf="@+id/last_fight_date"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/last_fight_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/last_fight_result"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/AssistiveDefault"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/barrier_opponent_name_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="136dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
