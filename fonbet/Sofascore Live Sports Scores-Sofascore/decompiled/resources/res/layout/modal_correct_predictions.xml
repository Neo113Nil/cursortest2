<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="48dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/n_lv_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/profile_predictions_with_odds"
            android:layout_weight="1"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:id="@+id/with_odds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BodyMediumParagraph"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <TextView
            android:textColor="@color/n_lv_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/profile_predictions_without_odds"
            android:layout_weight="1"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:id="@+id/without_odds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BodyMediumParagraph"/>
    </LinearLayout>
</LinearLayout>
