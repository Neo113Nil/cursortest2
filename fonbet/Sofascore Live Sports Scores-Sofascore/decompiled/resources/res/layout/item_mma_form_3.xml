<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/divider_transparent"
    android:showDividers="middle">
    <TextView
        android:textColor="@color/surface_1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/form_text_0"
        android:background="@drawable/rectangle_4dp_corners_left"
        android:padding="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:maxLines="1"
        android:layout_weight="1"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/surface_1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/form_text_1"
        android:background="@android:color/black"
        android:padding="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:maxLines="1"
        android:layout_weight="1"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/surface_1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/form_text_2"
        android:background="@drawable/rectangle_4dp_corners_right"
        android:padding="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:maxLines="1"
        android:layout_weight="1"
        style="@style/DisplaySmall"/>
</LinearLayout>
