<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/on_color_secondary"
        android:id="@+id/user_join_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        style="@style/AssistiveMicro"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/user_icon"
        android:layout_width="102dp"
        android:layout_height="102dp"
        android:layout_marginStart="6dp"/>
    <FrameLayout
        android:id="@+id/anonymous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/logged_in_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <TextView
            android:textColor="@color/on_color_primary"
            android:id="@+id/user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            app:layout_constraintBottom_toTopOf="@+id/role_badge"
            app:layout_constraintEnd_toStartOf="@+id/share_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/DisplayLarge"/>
        <ImageView
            android:id="@+id/role_badge"
            android:layout_width="16dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/user_name"
            app:layout_constraintTop_toBottomOf="@+id/user_name"/>
        <TextView
            android:textColor="@color/on_color_primary"
            android:id="@+id/role_name"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/role_badge"
            app:layout_constraintEnd_toEndOf="@+id/user_name"
            app:layout_constraintStart_toEndOf="@+id/role_badge"
            app:layout_constraintTop_toTopOf="@+id/role_badge"
            style="@style/AssistiveDefault"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/share_button"
            android:padding="0dp"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_menu_list_share"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/on_color_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="16dp"
            app:shapeAppearanceOverlay="@style/CircleShapeOverlay"
            app:strokeWidth="0dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
