<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/title_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/main_section_center_with_icon"/>
    <TextView
        android:textColor="@color/secondary_default"
        android:gravity="center"
        android:id="@+id/wins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/losses"
        app:layout_constraintEnd_toEndOf="@+id/win_label"
        app:layout_constraintStart_toStartOf="@+id/win_label"
        app:layout_constraintTop_toTopOf="@+id/losses"
        style="@style/DisplayMedium"/>
    <TextView
        android:textColor="@color/live"
        android:gravity="center"
        android:id="@+id/losses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/loss_label"
        app:layout_constraintStart_toStartOf="@+id/loss_label"
        app:layout_constraintTop_toBottomOf="@+id/title_header"
        style="@style/DisplayMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/draws"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/losses"
        app:layout_constraintEnd_toEndOf="@+id/draw_label"
        app:layout_constraintStart_toStartOf="@+id/draw_label"
        app:layout_constraintTop_toTopOf="@+id/losses"
        style="@style/DisplayMedium"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/win_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/wins"
        android:textAllCaps="true"
        app:layout_constraintEnd_toStartOf="@+id/loss_label"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wins"
        app:layout_constraintWidth_min="40dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/loss_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/losses"
        android:textAllCaps="true"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintEnd_toStartOf="@+id/draw_label"
        app:layout_constraintStart_toEndOf="@+id/win_label"
        app:layout_constraintTop_toBottomOf="@+id/losses"
        app:layout_constraintWidth_min="40dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/draw_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/draws"
        android:textAllCaps="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/loss_label"
        app:layout_constraintTop_toBottomOf="@+id/draws"
        app:layout_constraintWidth_min="40dp"
        style="@style/AssistiveDefault"/>
    <View
        android:background="@color/n_lv_4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loss_label"/>
</androidx.constraintlayout.widget.ConstraintLayout>
