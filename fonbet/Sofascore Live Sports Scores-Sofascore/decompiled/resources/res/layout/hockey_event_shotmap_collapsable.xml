<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.typeheader.SegmentedButtonsView
        android:id="@+id/team_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_terrain_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/team_selector"
        app:tint="@color/neutral_default"/>
    <com.sofascore.results.event.statistics.view.hockey.HockeyEventMapView
        android:id="@+id/shotmap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/arrow"
        app:layout_constraintWidth_max="416dp"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/spinner_players"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/spinner_shot_type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shotmap"
        app:layout_constraintVertical_bias="0"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/spinner_shot_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/spinner_players"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/spinner_players"
        app:layout_constraintTop_toTopOf="@+id/spinner_players"
        app:layout_constraintVertical_bias="0"/>
    <com.sofascore.results.redesign.emptystateblocks.GraphicLarge
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:graphicLargeDrawable="@drawable/hockey_shotmap"
        app:graphicLargeSubtitle="@string/hockey_game_shotmap_message"
        app:layout_constraintTop_toBottomOf="@+id/team_selector"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/shotmap_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="shotmap, arrow, spinner_players_container, spinner_shot_type_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
