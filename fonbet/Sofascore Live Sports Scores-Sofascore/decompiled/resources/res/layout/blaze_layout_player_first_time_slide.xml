<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blaze_fragment_container_first_time_slide"
    android:background="@color/blaze_first_time_slide_background_color"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/blaze_firstTimeSlideCtaButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.blaze.blazesdk.custom_views.BlazeTextView
                android:textStyle="bold"
                android:textColor="@color/blaze_first_time_slide_main_title_color"
                android:gravity="center"
                android:id="@+id/blaze_firstTimeSlideMainTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.blaze.blazesdk.custom_views.BlazeTextView
                android:textColor="@color/blaze_first_time_slide_sub_title_color"
                android:gravity="center"
                android:id="@+id/blaze_firstTimeSlideSubTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/blaze_firstTimeSlideMainTitle"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/blaze_firstTimeSlideItemsRV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/blaze_firstTimeSlideSubTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.blaze.blazesdk.custom_views.BlazeTextWithIconButton
        android:id="@+id/blaze_firstTimeSlideCtaButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:blaze_text="Tap to start"
        app:blaze_textColor="@color/blaze_white"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:contentPaddingLeft="@dimen/blaze_common_medium_padding"
        app:contentPaddingRight="@dimen/blaze_common_medium_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
