<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/rectangle_16dp_corners"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/surface_2"
    android:paddingVertical="10dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/league_icon"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:id="@+id/weekly_streak_icon"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_weekly_streak"
            android:importantForAccessibility="no"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="center"
            style="@style/DisplayMedium"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/info_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:textAlignment="center"
        app:drawableTint="@color/primary_default"
        style="@style/AssistiveDefault"/>
</LinearLayout>
