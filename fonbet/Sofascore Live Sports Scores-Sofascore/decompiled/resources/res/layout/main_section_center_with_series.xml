<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_container"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:paddingHorizontal="16dp">
    <FrameLayout
        android:id="@+id/first_1_outer"
        android:background="@drawable/circle"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:backgroundTint="@color/n_lv_5"
        app:layout_constraintBottom_toBottomOf="@+id/header_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header_title">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/first_1_inner"
            android:background="@drawable/esports_best_of_circle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="@+id/header_title"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/first_2_outer"
        android:background="@drawable/circle"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/n_lv_5"
        app:layout_constraintBottom_toBottomOf="@+id/header_title"
        app:layout_constraintStart_toEndOf="@+id/first_1_outer"
        app:layout_constraintTop_toTopOf="@+id/header_title">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/first_2_inner"
            android:background="@drawable/esports_best_of_circle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="@+id/header_title"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/first_3_outer"
        android:background="@drawable/circle"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/n_lv_5"
        app:layout_constraintBottom_toBottomOf="@+id/header_title"
        app:layout_constraintStart_toEndOf="@+id/first_2_outer"
        app:layout_constraintTop_toTopOf="@+id/header_title">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/first_3_inner"
            android:background="@drawable/esports_best_of_circle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="@+id/header_title"/>
    </FrameLayout>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/second_3_outer"
        app:layout_constraintStart_toEndOf="@+id/first_3_outer"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMedium"/>
    <FrameLayout
        android:id="@+id/second_1_outer"
        android:background="@drawable/circle"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:backgroundTint="@color/n_lv_5"
        app:layout_constraintBottom_toBottomOf="@+id/header_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header_title">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/second_1_inner"
            android:background="@drawable/esports_best_of_circle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="@+id/header_title"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/second_2_outer"
        android:background="@drawable/circle"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/n_lv_5"
        app:layout_constraintBottom_toBottomOf="@+id/header_title"
        app:layout_constraintEnd_toStartOf="@+id/second_1_outer"
        app:layout_constraintTop_toTopOf="@+id/header_title">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/second_2_inner"
            android:background="@drawable/esports_best_of_circle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="@+id/header_title"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/second_3_outer"
        android:background="@drawable/circle"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/n_lv_5"
        app:layout_constraintBottom_toBottomOf="@+id/header_title"
        app:layout_constraintEnd_toStartOf="@+id/second_2_outer"
        app:layout_constraintTop_toTopOf="@+id/header_title">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/second_3_inner"
            android:background="@drawable/esports_best_of_circle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="@+id/header_title"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
