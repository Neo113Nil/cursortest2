<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:visibility="gone"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">
    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="22dp"
        android:text="@string/mma_who_deserved_to_win"
        app:layout_constraintBottom_toTopOf="@+id/motion_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMedium"/>
    <com.sofascore.results.mma.postMatchVoting.MmaPostMatchVotingMotionViewDetails
        android:id="@+id/motion_view"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintBottom_toTopOf="@+id/text_discuss"
        app:layout_constraintTop_toBottomOf="@+id/text_title"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/text_voting_ended"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:text="@string/voting_ended_status"
        android:drawablePadding="2dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/text_discuss"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/motion_view"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/text_color_link_selector"
        android:gravity="center_vertical"
        android:id="@+id/text_discuss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:text="@string/discuss_in_the_chat"
        android:drawablePadding="2dp"
        android:layout_marginHorizontal="16dp"
        app:drawableEndCompat="@drawable/ic_chevron_right_large_16"
        app:drawableTint="@color/primary_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/text_voting_ended"
        app:layout_constraintTop_toBottomOf="@+id/motion_view"
        style="@style/DisplaySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
