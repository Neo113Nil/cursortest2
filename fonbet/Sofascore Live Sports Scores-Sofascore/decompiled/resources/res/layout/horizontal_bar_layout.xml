<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="4dp">
        <TextView
            android:textColor="@color/secondary_default"
            android:gravity="start|center_vertical"
            android:id="@+id/bar_count_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/BodyMedium"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:gravity="center"
            android:id="@+id/bar_count_middle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/BodyMedium"/>
        <TextView
            android:textColor="@color/error"
            android:gravity="end|center_vertical"
            android:id="@+id/bar_count_end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/BodyMedium"/>
    </LinearLayout>
    <LinearLayout
        android:background="@color/surface_1"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout
            android:id="@+id/bar_start"
            android:background="@drawable/rectangle_8dp_corners_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/secondary_default">
            <TextView
                android:textColor="@color/surface_1"
                android:gravity="start|center_vertical"
                android:id="@+id/bar_start_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:paddingStart="8dp"
                style="@style/DisplaySmall"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/bar_middle"
            android:background="@color/neutral_default"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/surface_1"
                android:gravity="center"
                android:id="@+id/bar_middle_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:paddingHorizontal="2dp"
                style="@style/DisplaySmall"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/bar_end"
            android:background="@drawable/rectangle_8dp_corners_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/error">
            <TextView
                android:textColor="@color/surface_1"
                android:gravity="end|center_vertical"
                android:id="@+id/bar_end_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:paddingEnd="8dp"
                style="@style/DisplaySmall"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
