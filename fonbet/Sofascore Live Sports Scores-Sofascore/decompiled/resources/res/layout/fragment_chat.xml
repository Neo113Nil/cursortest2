<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mma_voting_recycler"
        android:background="@color/surface_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sofascore.results.chat.view.ChatRecyclerView
        android:id="@+id/recycler_view_chat"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/chat_reply_frame"
        app:layout_constraintTop_toBottomOf="@+id/mma_voting_recycler"
        style="@style/RecyclerStyle"/>
    <com.sofascore.results.chat.view.ScoreUpdateView
        android:id="@+id/score_update_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/chat_reply_frame"/>
    <com.sofascore.results.redesign.emptystateblocks.GraphicLarge
        android:orientation="vertical"
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sofascore.results.chat.view.ChatConnectingView
        android:id="@+id/chat_connecting_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sofascore.results.chat.view.FloatingIndicationLabelView
        android:id="@+id/floating_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        app:layout_constraintBottom_toTopOf="@+id/chat_reply_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/chat_reply_frame"
        android:background="@color/surface_1"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/chat_text_view">
        <include
            android:id="@+id/chat_reply"
            layout="@layout/chat_reply_box"/>
    </FrameLayout>
    <com.sofascore.results.chat.view.ChatMessageInputView
        android:id="@+id/chat_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <include
        android:id="@+id/chat_flag_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/chat_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/floating_indication_label"/>
    <ImageView
        android:id="@+id/container_pointer"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_container_pointer"
        android:scaleY="-1"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/chat_flag_info"
        app:layout_constraintTop_toBottomOf="@+id/chat_flag_info"
        app:tint="@color/primary_default"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_gravity="center"
        android:id="@+id/scroll_to_last_message_fab"
        android:background="@drawable/circle"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:src="@drawable/ic_chevron_down_large_16"
        android:backgroundTint="@color/primary_default"
        app:borderWidth="0dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@+id/score_update_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/surface_1"/>
    <View
        android:id="@+id/new_message_indicator"
        android:background="@drawable/circle"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginBottom="38dp"
        android:layout_marginStart="38dp"
        android:backgroundTint="@color/primary_default"
        app:layout_constraintBottom_toBottomOf="@+id/scroll_to_last_message_fab"
        app:layout_constraintStart_toStartOf="@+id/scroll_to_last_message_fab"/>
</androidx.constraintlayout.widget.ConstraintLayout>
