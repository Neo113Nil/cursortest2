<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingStart="4dp"
    android:paddingEnd="6dp">
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:text="@string/position_short"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="start"
        android:id="@+id/subject"
        android:layout_width="116dp"
        android:layout_height="wrap_content"
        android:text="@string/formula_driver"
        android:textAlignment="viewStart"
        android:layout_marginStart="8dp"
        style="@style/TableMedium"/>
    <ImageView
        android:id="@+id/left_button"
        android:visibility="invisible"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_advantage_arrow_left_8"
        android:rotationY="@integer/rtl_rotation"
        android:layout_marginEnd="2dp"
        app:tint="@color/n_lv_1"/>
    <com.sofascore.common.widget.ScrollInterceptorHorizontalScrollView
        android:id="@+id/scroller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:id="@+id/column_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.sofascore.common.widget.ScrollInterceptorHorizontalScrollView>
    <ImageView
        android:id="@+id/right_button"
        android:visibility="invisible"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_advantage_arrow_left_8"
        android:rotationY="@integer/rtl_rotation_inverse"
        android:layout_marginStart="2dp"
        app:tint="@color/n_lv_1"/>
</LinearLayout>
