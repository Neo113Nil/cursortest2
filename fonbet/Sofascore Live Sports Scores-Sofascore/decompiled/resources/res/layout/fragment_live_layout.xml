<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/switch_holder"
            android:background="@color/surface_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="6dp">
            <androidx.appcompat.widget.SwitchCompat
                android:theme="@style/SwitchStyle"
                android:textColor="@color/n_lv_1"
                android:id="@+id/switch_amateur"
                android:background="@drawable/rectangle_16dp_corners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:thumb="@drawable/switch_thumb"
                android:text="@string/football_toggle_amateur_competitions"
                android:backgroundTint="@color/surface_2"
                android:layout_marginHorizontal="16dp"
                android:paddingHorizontal="16dp"
                app:track="@drawable/switch_track"
                style="@style/BodyMedium"/>
        </FrameLayout>
        <FrameLayout
            android:background="@color/surface_0"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:paddingTop="4dp"
                android:paddingBottom="96dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/RecyclerStyle"/>
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_gravity="center"
                android:id="@+id/progress_section"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                app:indicatorSize="64dp"
                app:trackThickness="8dp"
                style="@style/PrimaryCircularProgressStyle"/>
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/back_to_live_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/back_to_live_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAlignment="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:backgroundTint="@color/surface_P"
                app:backgroundTint="@color/live"
                app:borderWidth="2dp"
                style="@style/ButtonBackToLive"/>
        </FrameLayout>
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
