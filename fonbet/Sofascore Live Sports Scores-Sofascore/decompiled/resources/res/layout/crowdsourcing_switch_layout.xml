<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.SwitchCompat
            android:textColor="@color/n_lv_1"
            android:id="@+id/crowdsourcing_postponed_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textOn=""
            android:textOff=""
            android:text="@string/crowdsourcing_match_cancelled"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:thumbTint="@color/color_state_switch_crowdsourcing"
            app:trackTint="@color/n_lv_4"
            style="@style/DisplaySmall"/>
        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/divider"
            android:background="@color/n_lv_4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:layout_gravity="center_horizontal"
            android:id="@+id/delay_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/crowdsourcing_status_choose_reason"
            android:paddingHorizontal="16dp"
            style="@style/AssistiveDefault"/>
        <com.sofascore.results.view.SofaTextInputLayout
            android:id="@+id/input_reason"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:hint="@string/crowdsourcing_reason_title"
            android:textAlignment="viewStart"
            android:paddingHorizontal="16dp"
            android:importantForAutofill="noExcludeDescendants"
            app:boxBackgroundColor="@color/surface_1"
            style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/reasonPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textAlignment="viewStart"
                style="@style/BodyLarge"/>
        </com.sofascore.results.view.SofaTextInputLayout>
        <TextView
            android:textColor="@color/n_lv_3"
            android:layout_gravity="center_horizontal"
            android:id="@+id/user_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/crowdsourcing_status_suggest_other_reason"
            android:paddingHorizontal="16dp"
            style="@style/AssistiveDefault"/>
        <com.sofascore.results.view.SofaTextInputLayout
            android:id="@+id/input_reason_user"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/crowdsourcing_reason_example_field"
            android:textAlignment="viewStart"
            android:paddingHorizontal="16dp"
            android:importantForAutofill="noExcludeDescendants"
            app:boxBackgroundColor="@color/surface_1"
            app:errorEnabled="true"
            style="@style/Widget.Sofascore.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="flagNoExtractUi"
                android:textAlignment="viewStart"
                style="@style/BodyLarge"/>
        </com.sofascore.results.view.SofaTextInputLayout>
    </LinearLayout>
</merge>
