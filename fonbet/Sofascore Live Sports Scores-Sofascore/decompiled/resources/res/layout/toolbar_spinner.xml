<?xml version="1.0" encoding="utf-8"?>
<com.sofascore.common.mvvm.UnderlinedToolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    app:contentInsetStart="0dp">
    <com.sofascore.results.main.tutorial.PulsatingFrameLayout
        android:id="@+id/container_quick_links"
        android:background="?android:attr/actionBarItemBackground"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon_quick_links"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_quick_links"
            app:tint="@color/on_color_primary"/>
    </com.sofascore.results.main.tutorial.PulsatingFrameLayout>
    <TextView
        android:textColor="#73222226"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/search_button"
        android:background="@drawable/rectangle_16dp_corners_no_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="@string/search_sofascore"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:layout_marginEnd="4dp"
        android:transitionName="search_button"
        android:backgroundTint="@color/on_color_primary"
        android:paddingHorizontal="12dp"
        app:drawableStartCompat="@drawable/ic_search"
        app:drawableTint="#222226"
        style="@style/BodyMedium"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/toolbar_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:id="@+id/toolbar_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textDirection="locale"
            android:paddingEnd="12dp"
            style="@style/SpecificAndroidHeaderTitle"/>
        <Spinner
            android:id="@+id/spinner"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:popupBackground="@drawable/popup_background_drawable"
            android:dropDownWidth="204dp"
            android:dropDownVerticalOffset="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SpinnerBase"/>
    </LinearLayout>
</com.sofascore.common.mvvm.UnderlinedToolbar>
