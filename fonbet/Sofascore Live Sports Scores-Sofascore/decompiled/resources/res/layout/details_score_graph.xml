<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    android:paddingStart="4dp"
    android:paddingEnd="8dp">
    <TextView
        android:textColor="@color/live"
        android:id="@+id/score_graph_time_left_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/time_left"
        app:layout_constraintBottom_toTopOf="@+id/graph_background"
        app:layout_constraintStart_toStartOf="@+id/graph_background"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/live"
        android:id="@+id/score_graph_time_left_minutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/graph_background"
        app:layout_constraintStart_toStartOf="@+id/current_time_position_barrier"
        style="@style/DisplayMicro"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/graph_background"
        android:background="@color/n_lv_5"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/graph_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintBottom_toBottomOf="@+id/graph_background"
        app:layout_constraintEnd_toEndOf="@+id/graph_background"
        app:layout_constraintStart_toStartOf="@+id/graph_background"
        app:layout_constraintTop_toTopOf="@+id/graph_background"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/score_graph_start_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/graph_background"
        app:layout_constraintTop_toBottomOf="@+id/graph_background"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/score_graph_full_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/graph_background"
        app:layout_constraintTop_toBottomOf="@+id/graph_background"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/score_graph_top_difference_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/graph_background"
        app:layout_constraintTop_toTopOf="@+id/graph_background"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/score_graph_middle_difference_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/graph_background"
        app:layout_constraintStart_toEndOf="@+id/graph_background"
        app:layout_constraintTop_toTopOf="@+id/graph_background"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/score_graph_bottom_difference_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/graph_background"
        app:layout_constraintStart_toEndOf="@+id/graph_background"
        style="@style/BodySmall"/>
    <include
        android:id="@+id/what_is_this_view"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/graph_container"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/what_is_this_layout"/>
    <ImageView
        android:id="@+id/score_graph_start_dot"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/attack_momentum_start_dot"
        app:layout_constraintBottom_toBottomOf="@+id/graph_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/graph_container"/>
    <ImageView
        android:id="@+id/score_graph_current_time_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/attack_momentum_current_dot"
        android:layout_marginEnd="16dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toTopOf="@+id/graph_background"
        app:layout_constraintEnd_toEndOf="@+id/current_time_guideline"
        app:layout_constraintStart_toStartOf="@+id/current_time_guideline"
        app:layout_constraintTop_toTopOf="@+id/graph_background"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/current_time_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintGuide_begin="4dp"/>
    <TextView
        android:id="@+id/fake_min_time"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/graph_background"
        app:layout_constraintStart_toEndOf="@+id/score_graph_time_left_text"/>
    <View
        android:id="@+id/min_time_barrier"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="@+id/fake_min_time"/>
    <TextView
        android:id="@+id/fake_current_time"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/graph_background"
        app:layout_constraintEnd_toEndOf="@+id/current_time_guideline"/>
    <View
        android:id="@+id/current_time_barrier"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="@+id/fake_current_time"
        app:layout_constraintStart_toStartOf="@+id/fake_current_time"/>
    <TextView
        android:id="@+id/fake_max_time"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/graph_background"
        app:layout_constraintEnd_toEndOf="@+id/graph_background"
        app:layout_constraintStart_toEndOf="@+id/graph_background"/>
    <View
        android:id="@+id/max_time_barrier"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="@+id/fake_max_time"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/time_text_barrier_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="end"
        app:constraint_referenced_ids="min_time_barrier, current_time_barrier"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/current_time_position_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="time_text_barrier_start, max_time_barrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
