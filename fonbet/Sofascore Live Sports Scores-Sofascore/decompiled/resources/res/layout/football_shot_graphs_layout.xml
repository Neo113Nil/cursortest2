<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/rectangle_16dp_top_corners_no_color"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.event.statistics.view.football.FootballGoalmapView
        android:id="@+id/goalmap"
        android:layout_width="match_parent"
        android:layout_height="102dp"/>
    <android.widget.Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/shotmap_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/football_match_shotmap_container"/>
    <LinearLayout
        android:id="@+id/stats_upper"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <include
            android:id="@+id/result_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            layout="@layout/info_default_shrinked"/>
        <include
            android:id="@+id/situation_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            layout="@layout/info_default_shrinked"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/stats_lower"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <include
            android:id="@+id/shot_type_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            layout="@layout/info_default_shrinked"/>
        <include
            android:id="@+id/goal_zone_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            layout="@layout/info_default_shrinked"/>
    </LinearLayout>
</LinearLayout>
