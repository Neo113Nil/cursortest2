<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="36dp"
    android:paddingHorizontal="8dp">
    <View
        android:id="@+id/first_team_value_background"
        android:background="@drawable/rectangle_22dp_corners"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.3"
        android:backgroundTint="@color/secondary_default"
        app:layout_constraintBottom_toBottomOf="@+id/value_first_team"
        app:layout_constraintEnd_toEndOf="@+id/value_first_team"
        app:layout_constraintStart_toStartOf="@+id/value_first_team"
        app:layout_constraintTop_toTopOf="@+id/value_first_team"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/value_first_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:textDirection="ltr"
        android:textAlignment="viewStart"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_start"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TableMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/statistic_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TableMedium"/>
    <TextView
        android:gravity="end|center_vertical"
        android:id="@+id/value_second_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:textDirection="ltr"
        android:textAlignment="viewEnd"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/guideline_end"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TableMedium"/>
    <View
        android:id="@+id/second_team_value_background"
        android:background="@drawable/rectangle_22dp_corners"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.3"
        android:backgroundTint="@color/primary_default"
        app:layout_constraintBottom_toBottomOf="@+id/value_second_team"
        app:layout_constraintEnd_toEndOf="@+id/value_second_team"
        app:layout_constraintStart_toStartOf="@+id/value_second_team"
        app:layout_constraintTop_toTopOf="@+id/value_second_team"/>
    <View
        android:id="@+id/bottom_divider"
        android:background="@color/n_lv_4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/value_second_team"
        app:layout_constraintStart_toStartOf="@+id/value_first_team"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="24dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
