<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">
    <ImageView
        android:id="@+id/pointer_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_container_pointer"
        android:elevation="2dp"
        app:tint="@color/surface_1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tennis_switcher_root"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:backgroundTint="@color/surface_1"
        android:paddingHorizontal="16dp">
        <TextView
            android:ellipsize="end"
            android:id="@+id/switcher_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/switcher"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BodyMedium"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:id="@+id/switcher_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/switcher_title"
            app:layout_constraintStart_toStartOf="@+id/switcher_title"
            app:layout_constraintTop_toBottomOf="@+id/switcher_title"
            style="@style/BodySmall"/>
        <androidx.appcompat.widget.SwitchCompat
            android:theme="@style/SwitchStyle"
            android:id="@+id/switcher"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:thumb="@drawable/switch_thumb"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:track="@drawable/switch_track"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
