<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/prediction_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:layout_weight="1"
        android:textDirection="locale"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="16dp"
        style="@style/BodySmall"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/profile_choice_icon"
        android:background="@drawable/rounded_surface_level_1"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:minWidth="24dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/surface_2"
        android:layout_marginVertical="8dp"
        android:paddingHorizontal="8dp"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/secondary_default"
        android:gravity="center"
        android:id="@+id/profile_choice_odds"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:layout_marginVertical="12dp"
        style="@style/TableMedium"/>
    <View
        android:id="@+id/barrier"
        android:background="@color/n_lv_4"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:layout_marginVertical="4dp"
        app:tint="@color/primary_default"/>
    <ImageView
        android:id="@+id/change_vote_icon"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_edit"
        android:layout_marginEnd="12dp"
        android:layout_marginVertical="4dp"
        app:tint="@color/primary_default"/>
</LinearLayout>
