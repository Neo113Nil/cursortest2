<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/sort_lineups_header_section_divider"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:theme="@style/NavigationTabSecondary"
        android:textColor="@color/n_lv_3"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/sort_lineups_header_section_text"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/sort_lineups_header_section_triangle"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/sort_lineups_header_section_triangle"
        android:visibility="invisible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_arrow_drop_down_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/primary_default"/>
</androidx.constraintlayout.widget.ConstraintLayout>
