<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:scaleX="2"
        android:scaleY="2"
        app:shapeAppearanceOverlay="@style/RoundedStyle8dp"/>
    <FrameLayout
        android:id="@+id/gradient"
        android:background="@drawable/buzzer_transparent_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/overlay"
        android:background="@drawable/buzzer_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.5"/>
    <ImageView
        android:id="@+id/top_label_background"
        android:background="@drawable/buzzer_label_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:rotation="@integer/rtl_rotation"
        android:backgroundTint="@color/neutral_variant"
        app:layout_constraintBottom_toBottomOf="@+id/top_label_text"
        app:layout_constraintEnd_toEndOf="@+id/top_label_text"
        app:layout_constraintStart_toStartOf="@+id/top_label_text"
        app:layout_constraintTop_toTopOf="@+id/top_label_text"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/top_label_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textAllCaps="true"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/organisation_logo"
        style="@style/AssistiveMicro"/>
    <ImageView
        android:id="@+id/organisation_logo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/fighter_gradient_home"
        android:background="@drawable/buzzer_interesting_statistics_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintBottom_toBottomOf="@+id/fighter_image_home"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/half_screen_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fighter_image_home"/>
    <ImageView
        android:id="@+id/fighter_image_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/fighter_gradient_away"
        android:background="@drawable/buzzer_interesting_statistics_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:scaleX="@integer/drawable_scaleX_flipped"
        app:layout_constraintBottom_toBottomOf="@+id/fighter_image_away"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/half_screen_guideline"
        app:layout_constraintTop_toTopOf="@+id/fighter_image_away"/>
    <ImageView
        android:id="@+id/fighter_image_away"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/text_vs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/versus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/text_weight_class"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="2dp"
        android:maxLines="2"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fighter_image_home"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:id="@+id/text_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/BodySmall"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/live_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/text_status">
        <ImageView
            android:id="@+id/live_dot_animation"
            android:background="@drawable/circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/live"/>
        <TextView
            android:textColor="@color/on_color_primary"
            android:id="@+id/live_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_live"
            android:maxLines="1"
            style="@style/DisplayMicro"/>
    </LinearLayout>
    <View
        android:id="@+id/result_gradient"
        android:background="@drawable/buzzer_interesting_statistics_gradient"
        android:layout_width="84dp"
        android:layout_height="0dp"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintBottom_toBottomOf="@+id/result_bubble"
        app:layout_constraintStart_toStartOf="@+id/result_bubble_half_guideline"
        app:layout_constraintTop_toTopOf="@+id/result_bubble"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/result_bubble"
        android:background="@drawable/circle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/mma_winner_buzzer"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/success"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/result_win_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/result_bubble"
        app:layout_constraintStart_toEndOf="@+id/result_bubble"
        app:layout_constraintTop_toTopOf="@+id/result_bubble"
        style="@style/BodySmall"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/result_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="result_bubble,result_gradient,result_win_type"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/result_draw"
        android:background="@drawable/rounded_surface_level_3"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="2dp"
        android:minWidth="54dp"
        android:maxLines="1"
        android:textAllCaps="true"
        android:backgroundTint="@color/neutral_default"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fighter_image_home"
        style="@style/DisplaySmall"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/half_screen_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <View
        android:id="@+id/result_bubble_half_guideline"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="@+id/result_bubble"
        app:layout_constraintStart_toStartOf="@+id/result_bubble"/>
    <FrameLayout
        android:id="@+id/ripple_holder"
        android:background="?attr/selectableItemBackground"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
