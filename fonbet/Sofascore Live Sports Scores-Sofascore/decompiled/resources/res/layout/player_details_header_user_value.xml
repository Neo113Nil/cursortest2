<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_surface_level_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:minHeight="64dp"
    android:backgroundTint="@color/surface_2">
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/player_value_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/market_value"
        android:maxLines="1"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/market_value"
        app:layout_constraintEnd_toEndOf="@+id/player_value_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textColor="@color/value"
        android:gravity="center"
        android:id="@+id/market_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/player_value_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_value_container"
        style="@style/DisplayMedium"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/player_value_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="116dp"/>
    <View
        android:id="@+id/separator"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/player_value_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/player_value_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="@string/is_market_value_higher_or_lower"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vote_up_circle"
        app:layout_constraintStart_toEndOf="@+id/separator"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <View
        android:id="@+id/vote_up_circle"
        android:background="@drawable/market_value_vote_circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vote_down_circle"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/ic_position_arrow_up_8"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:elevation="4dp"
        android:backgroundTint="@color/success"
        app:layout_constraintEnd_toEndOf="@+id/vote_up_circle"
        app:layout_constraintStart_toStartOf="@+id/vote_up_circle"
        app:layout_constraintTop_toTopOf="@+id/vote_up_circle"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/currency_up"
        android:background="@drawable/circle"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:elevation="4dp"
        android:backgroundTint="@color/neutral_default"
        app:layout_constraintBottom_toBottomOf="@+id/vote_up_circle"
        app:layout_constraintEnd_toEndOf="@+id/vote_up_circle"
        app:layout_constraintStart_toStartOf="@+id/vote_up_circle"
        app:layout_constraintTop_toTopOf="@+id/vote_up_circle"
        style="@style/AssistiveDefault"/>
    <View
        android:id="@+id/vote_down_circle"
        android:background="@drawable/market_value_vote_circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/ic_position_arrow_down_8"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginBottom="6dp"
        android:elevation="4dp"
        android:backgroundTint="@color/error"
        app:layout_constraintBottom_toBottomOf="@+id/vote_down_circle"
        app:layout_constraintEnd_toEndOf="@+id/vote_down_circle"
        app:layout_constraintStart_toStartOf="@+id/vote_down_circle"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/currency_down"
        android:background="@drawable/circle"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:elevation="4dp"
        android:backgroundTint="@color/neutral_default"
        app:layout_constraintBottom_toBottomOf="@+id/vote_down_circle"
        app:layout_constraintEnd_toEndOf="@+id/vote_down_circle"
        app:layout_constraintStart_toStartOf="@+id/vote_down_circle"
        app:layout_constraintTop_toTopOf="@+id/vote_down_circle"
        style="@style/AssistiveDefault"/>
</androidx.constraintlayout.widget.ConstraintLayout>
