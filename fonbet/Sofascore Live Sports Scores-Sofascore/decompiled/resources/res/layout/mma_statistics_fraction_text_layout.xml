<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="52dp"
    android:animateLayoutChanges="true">
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="slash"/>
    <View
        android:id="@+id/highlight"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:scaleX="0"
        android:backgroundTint="@color/blue_fighter_highlight"
        app:layout_constraintBottom_toBottomOf="@+id/fraction_numerator"
        app:layout_constraintEnd_toEndOf="@+id/fraction_numerator"
        app:layout_constraintStart_toStartOf="@+id/fraction_numerator"
        app:layout_constraintTop_toTopOf="@+id/fraction_numerator"
        app:layout_constraintWidth_min="24dp"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/fraction_numerator"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:maxLines="1"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="24dp"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/slash"
        android:layout_width="8dp"
        android:layout_height="wrap_content"
        android:text="@string/slash"
        app:layout_constraintBottom_toBottomOf="@+id/fraction_numerator"
        app:layout_constraintStart_toEndOf="@+id/fraction_numerator"
        app:layout_constraintTop_toTopOf="@+id/fraction_numerator"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:id="@+id/fraction_denominator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/fraction_numerator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/slash"
        app:layout_constraintTop_toTopOf="@+id/fraction_numerator"
        style="@style/BodyMedium"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/fraction_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="slash, fraction_denominator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
