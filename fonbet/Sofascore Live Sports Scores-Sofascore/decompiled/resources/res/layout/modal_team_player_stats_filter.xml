<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp">
    <com.sofascore.results.view.SofaTextInputLayout
        android:textColorHint="@color/n_lv_3"
        android:id="@+id/position_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:hint="@string/position"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconTint="@color/n_lv_1"
        app:hintTextColor="@color/primary_default"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:ellipsize="end"
            android:id="@+id/position_picker"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:maxLines="1"
            android:popupBackground="@drawable/popup_background_drawable"
            android:inputType="none"
            android:textDirection="locale"
            android:paddingHorizontal="16dp"
            style="@style/BodyLarge"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:textColorHint="@color/n_lv_3"
        android:id="@+id/appearance_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:hint="@string/match_appearances"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconTint="@color/n_lv_1"
        app:hintTextColor="@color/primary_default"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:ellipsize="end"
            android:id="@+id/appearance_picker"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:maxLines="1"
            android:popupBackground="@drawable/popup_background_drawable"
            android:inputType="none"
            android:textDirection="locale"
            android:paddingHorizontal="16dp"
            style="@style/BodyLarge"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <TextView
        android:gravity="start|center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:minHeight="14dp"
        android:text="@string/filter_per_mode"
        style="@style/DisplayMicro"/>
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/per_mode_subtitle">
        <RadioButton
            android:textAppearance="@style/BodyMedium"
            android:textColor="@color/n_lv_1"
            android:id="@+id/radio_per_game"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/basketball_per_game_stats_title"
            android:textAlignment="viewStart"
            android:buttonTint="@color/primary_default"/>
        <RadioButton
            android:textAppearance="@style/BodyMedium"
            android:textColor="@color/n_lv_1"
            android:id="@+id/radio_totals"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_by_totals"
            android:textAlignment="viewStart"
            android:buttonTint="@color/primary_default"/>
    </RadioGroup>
</LinearLayout>
