<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blaze_fragment_moments_rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/blaze_momentFragmentSafeAreaTop"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="vertical"
        android:id="@+id/blaze_momentsViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/blaze_momentsCloseButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/blaze_drawable_ic_close"
        android:contentDescription="@string/blaze_accessibility_close"
        android:importantForAccessibility="yes"/>
    <ImageView
        android:id="@+id/blaze_momentsSearchButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/blaze_drawable_ic_search"
        android:contentDescription="@string/blaze_search_hint"
        android:importantForAccessibility="yes"/>
    <ImageView
        android:id="@+id/blaze_momentsSoundButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/blaze_drawable_selector_sound"
        android:contentDescription="@string/blaze_accessibility_toggle_mute"
        android:importantForAccessibility="yes"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/blaze_momentsTopButtonsFlow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="@dimen/blaze_common_large_margin"
        app:constraint_referenced_ids="blaze_momentsCloseButton, blaze_momentsSearchButton, blaze_momentsSoundButton"
        app:flow_verticalGap="10dp"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container_mockup"
        app:layout_constraintTop_toTopOf="@+id/blaze_momentFragmentSafeAreaTop"/>
    <com.blaze.blazesdk.first_time_slide.ui.FirstTimeSlideCustomView
        android:id="@+id/blaze_momentsFirstTimeSlide"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_momentFragmentSafeAreaBottom"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container_mockup"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container_mockup"
        app:layout_constraintTop_toTopOf="@+id/blaze_momentFragmentSafeAreaTop"/>
    <View
        android:id="@+id/blaze_player_container_mockup"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_momentFragmentSafeAreaBottom"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/blaze_momentFragmentSafeAreaTop"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/blaze_momentFragmentSafeAreaBottom"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="0dp"/>
    <View
        android:id="@+id/blaze_momentsBlockUserInteraction"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
