<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="80dp">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/cup_tree_upper_margin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/cup_tree_upper_connector"
        android:background="@color/surface_1"
        android:layout_width="4dp"
        android:layout_height="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="cup_tree_upper_margin, cup_tree_upper_connector"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cup_tree_card"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@color/surface_1"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_barrier"/>
    <ImageView
        android:id="@+id/home_logo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toStartOf="@+id/away_logo"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/cup_tree_card"
        app:layout_constraintTop_toTopOf="@+id/cup_tree_card"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/home_seeding"
        android:background="@drawable/rounded_surface_level_3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginTop="20dp"
        android:minWidth="24dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="@+id/home_logo"
        app:layout_constraintStart_toStartOf="@+id/home_logo"
        app:layout_constraintTop_toTopOf="@+id/home_logo"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textSize="12dp"
        android:gravity="center"
        android:id="@+id/home_name"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="@+id/home_logo"
        app:layout_constraintStart_toStartOf="@+id/home_logo"
        app:layout_constraintTop_toBottomOf="@+id/home_logo"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/away_logo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="@+id/cup_tree_card"
        app:layout_constraintStart_toEndOf="@+id/home_logo"
        app:layout_constraintTop_toTopOf="@+id/cup_tree_card"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/away_seeding"
        android:background="@drawable/rounded_surface_level_3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginTop="20dp"
        android:minWidth="24dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="@+id/away_logo"
        app:layout_constraintStart_toStartOf="@+id/away_logo"
        app:layout_constraintTop_toTopOf="@+id/away_logo"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textSize="12dp"
        android:gravity="center"
        android:id="@+id/away_name"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="@+id/away_logo"
        app:layout_constraintStart_toStartOf="@+id/away_logo"
        app:layout_constraintTop_toTopOf="@+id/home_name"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textSize="16dp"
        android:gravity="end"
        android:id="@+id/result_home"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="2dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toStartOf="@+id/result_middle"
        app:layout_constraintStart_toStartOf="@+id/cup_tree_card"
        app:layout_constraintTop_toBottomOf="@+id/home_name"
        style="@style/BodyLarge"/>
    <TextView
        android:textSize="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/result_middle"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:maxWidth="64dp"
        android:minWidth="12dp"
        android:maxLines="1"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/result_home"
        style="@style/BodyLarge"/>
    <TextView
        android:textSize="16dp"
        android:gravity="start"
        android:id="@+id/result_away"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginEnd="2dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="@+id/cup_tree_card"
        app:layout_constraintStart_toEndOf="@+id/result_middle"
        app:layout_constraintTop_toTopOf="@+id/result_home"
        style="@style/BodyLarge"/>
    <View
        android:id="@+id/cup_tree_lower_margin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintTop_toBottomOf="@+id/cup_tree_card"/>
    <View
        android:id="@+id/cup_tree_lower_connector"
        android:background="@color/surface_1"
        android:layout_width="4dp"
        android:layout_height="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cup_tree_card"/>
</androidx.constraintlayout.widget.ConstraintLayout>
