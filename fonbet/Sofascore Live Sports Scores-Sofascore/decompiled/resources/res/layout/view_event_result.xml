<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="104dp">
    <TextView
        android:textColor="@color/on_color_secondary"
        android:id="@+id/aggregated_score"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/ball_indicator_first"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_ball_tennis"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/score_first"
        app:layout_constraintEnd_toStartOf="@+id/score_first"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintTop_toTopOf="@+id/score_first"
        app:tint="@color/secondary_default"/>
    <com.sofascore.results.view.header.widget.RollingTextView
        android:textSize="28dp"
        android:textColor="@color/on_color_primary"
        android:id="@+id/score_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/score_slash"
        app:layout_constraintTop_toTopOf="@+id/score_slash"
        style="@style/DisplayExtraLarge"/>
    <ImageView
        android:id="@+id/first_team_win_indicator"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_aggregate_pointer"
        app:layout_constraintStart_toEndOf="@+id/score_first"
        app:layout_constraintTop_toTopOf="@+id/score_first"
        app:tint="@color/on_color_primary"/>
    <TextView
        android:textSize="28dp"
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/score_slash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" - "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aggregated_score"
        style="@style/DisplayExtraLarge"/>
    <com.sofascore.results.view.header.widget.RollingTextView
        android:textSize="28dp"
        android:textColor="@color/on_color_primary"
        android:id="@+id/score_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toEndOf="@+id/score_slash"
        app:layout_constraintTop_toTopOf="@+id/score_slash"
        style="@style/DisplayExtraLarge"/>
    <ImageView
        android:id="@+id/second_team_win_indicator"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_aggregate_pointer"
        app:layout_constraintStart_toEndOf="@+id/score_second"
        app:layout_constraintTop_toTopOf="@+id/score_second"
        app:tint="@color/on_color_primary"/>
    <ImageView
        android:id="@+id/ball_indicator_second"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_ball_tennis"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/score_second"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/score_second"
        app:layout_constraintTop_toTopOf="@+id/score_second"
        app:tint="@color/secondary_default"/>
    <com.sofascore.results.view.header.widget.TimerGoalAnimatedView
        android:textSize="14dp"
        android:textColor="@color/on_color_primary"
        android:gravity="top"
        android:id="@+id/secondary_score_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/penalties_short"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/secondary_score"
        app:layout_constraintEnd_toStartOf="@+id/secondary_score"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/secondary_score"
        style="@style/BodyMedium"/>
    <com.sofascore.results.view.header.widget.TimerGoalAnimatedView
        android:textSize="14dp"
        android:textColor="@color/on_color_primary"
        android:gravity="center_horizontal"
        android:id="@+id/secondary_score"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/extra_time_info"
        app:layout_constraintStart_toEndOf="@+id/secondary_score_label"
        app:layout_constraintTop_toBottomOf="@+id/score_slash"
        style="@style/BodyMedium"/>
    <TextView
        android:textSize="12dp"
        android:gravity="center_horizontal"
        android:id="@+id/extra_time_info"
        android:background="@drawable/rectangle_8dp_corners"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:layout_marginStart="4dp"
        android:backgroundTint="#1acb1818"
        android:paddingHorizontal="8dp"
        android:paddingVertical="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/secondary_score"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/secondary_score"
        app:layout_constraintTop_toTopOf="@+id/secondary_score"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/crowdsourcing_live"
        android:gravity="center_horizontal"
        android:id="@+id/crowdsourcing_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        android:textDirection="locale"
        app:drawableTint="@color/crowdsourcing_live"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/secondary_score"
        style="@style/BodySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
