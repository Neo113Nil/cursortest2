<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="116dp"
    android:layout_marginBottom="4dp">
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:background="@color/darken_overlay_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/first_team_side_indicator"
        android:layout_width="4dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/second_team_side_indicator"
        android:layout_width="4dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/first_team_logo"
        android:background="@drawable/circle"
        android:padding="2dp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:backgroundTint="@color/k_ff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"/>
    <ImageView
        android:id="@+id/second_team_logo"
        android:background="@drawable/circle"
        android:padding="2dp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/k_ff"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/first_team_cs_indicator"
        android:background="@drawable/circle"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/sofascore_sans_regular"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="@+id/first_team_logo"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/second_team_cs_indicator"
        android:background="@drawable/circle"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/sofascore_sans_regular"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toEndOf="@+id/second_team_logo"
        app:layout_constraintTop_toTopOf="@+id/second_team_logo"/>
    <include
        android:id="@+id/score_container"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/second_team_cs_indicator"
        app:layout_constraintStart_toEndOf="@+id/first_team_cs_indicator"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/game_score_layout"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/first_icons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/first_team_logo"
        app:layout_constraintTop_toBottomOf="@+id/first_team_logo"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/second_icons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/second_team_logo"
        app:layout_constraintTop_toBottomOf="@+id/second_team_logo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
