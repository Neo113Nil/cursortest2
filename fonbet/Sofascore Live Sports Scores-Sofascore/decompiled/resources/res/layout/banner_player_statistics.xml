<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/banner_player_rating_click_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp">
        <ImageView
            android:id="@+id/banner_player_rating_img_first"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/banner_player_rating_click_area"
            app:layout_constraintStart_toStartOf="@+id/banner_player_rating_click_area"
            app:layout_constraintTop_toTopOf="@+id/banner_player_rating_click_area"/>
        <ImageView
            android:id="@+id/banner_player_rating_img_second"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/banner_player_rating_click_area"
            app:layout_constraintEnd_toEndOf="@+id/banner_player_rating_click_area"
            app:layout_constraintTop_toTopOf="@+id/banner_player_rating_click_area"/>
        <com.sofascore.results.view.SofascoreSmallRatingView
            android:gravity="center"
            android:id="@+id/banner_player_rating_value_first"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/banner_player_rating_img_first"
            app:layout_constraintTop_toTopOf="@+id/banner_player_rating_img_first"/>
        <TextView
            android:textSize="18dp"
            android:id="@+id/banner_player_stat_value_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/banner_player_rating_img_first"
            app:layout_constraintTop_toTopOf="@+id/banner_player_rating_img_first"
            style="@style/TableLarge"/>
        <TextView
            android:textSize="12dp"
            android:id="@+id/banner_player_stat_name_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textAllCaps="true"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/banner_player_stat_value_first"
            app:layout_constraintStart_toEndOf="@+id/banner_player_stat_value_first"
            app:layout_constraintTop_toTopOf="@+id/banner_player_stat_value_first"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:id="@+id/banner_player_rating_name_first"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingExtra="4dp"
            android:textAlignment="viewStart"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/banner_player_rating_img_first"
            app:layout_constraintEnd_toStartOf="@+id/banner_player_statistics_middle_guideline"
            app:layout_constraintStart_toEndOf="@+id/banner_player_rating_img_first"
            style="@style/AssistiveDefault"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/banner_player_statistics_middle_guideline"
            android:layout_width="0dp"
            android:layout_height="64dp"
            app:layout_constraintGuide_percent="0.5"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/banner_player_rating_name_second"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingExtra="4dp"
            android:textAlignment="viewEnd"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/banner_player_rating_img_second"
            app:layout_constraintEnd_toStartOf="@+id/banner_player_rating_img_second"
            app:layout_constraintStart_toEndOf="@+id/banner_player_statistics_middle_guideline"
            style="@style/AssistiveDefault"/>
        <com.sofascore.results.view.SofascoreSmallRatingView
            android:id="@+id/banner_player_rating_value_second"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/banner_player_rating_img_second"
            app:layout_constraintTop_toTopOf="@+id/banner_player_rating_img_second"/>
        <TextView
            android:textSize="18dp"
            android:id="@+id/banner_player_stat_value_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/banner_player_rating_img_second"
            app:layout_constraintTop_toTopOf="@+id/banner_player_rating_img_second"
            style="@style/TableLarge"/>
        <TextView
            android:textSize="12dp"
            android:id="@+id/banner_player_stat_name_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textAllCaps="true"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/banner_player_stat_value_second"
            app:layout_constraintEnd_toStartOf="@+id/banner_player_stat_value_second"
            app:layout_constraintTop_toTopOf="@+id/banner_player_stat_value_second"
            style="@style/AssistiveDefault"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/first_barrier"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:barrierDirection="end"
            app:constraint_referenced_ids="banner_player_rating_value_first, banner_player_stat_name_first"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/second_barrier"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:barrierDirection="start"
            app:constraint_referenced_ids="banner_player_rating_value_second, banner_player_stat_name_second"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/primary_default"
            android:ellipsize="end"
            android:id="@+id/banner_player_rating_title"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:lineSpacingExtra="4dp"
            android:layout_marginStart="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/banner_player_rating_triangle"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/first_barrier"
            app:layout_constraintTop_toTopOf="@+id/banner_player_rating_img_first"
            style="@style/AssistiveDefault"/>
        <ImageView
            android:id="@+id/banner_player_rating_triangle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_down"
            android:rotation="@integer/rotate_270_clockwise"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/second_barrier"
            app:layout_constraintStart_toEndOf="@+id/banner_player_rating_title"
            app:layout_constraintTop_toTopOf="@+id/banner_player_rating_title"
            app:tint="@color/primary_default"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
