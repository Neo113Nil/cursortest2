<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/surface_1"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:paddingStart="20dp"
    android:paddingEnd="8dp"
    android:paddingVertical="8dp">
    <ImageView
        android:id="@+id/header_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp">
        <TextView
            android:textColor="@color/n_lv_1"
            android:ellipsize="end"
            android:id="@+id/header_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/BodyLarge"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:id="@+id/header_description"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/neutral_default"
        android:id="@+id/event_count_text"
        android:background="@drawable/rectangle_24dp_corners"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/surface_2"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        style="@style/DisplayMicro"/>
    <com.sofascore.results.view.CircularDropdownIndicatorView
        android:id="@+id/dropdown_indicator"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
</LinearLayout>
