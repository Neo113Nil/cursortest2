<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/transfer_filter_modal_container"
        android:background="@color/surface_P"
        android:paddingTop="8dp"
        android:paddingBottom="56dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:theme="@style/RedesignTextInputOutlinedTheme"
            android:textColorHint="@color/n_lv_3"
            android:id="@+id/nationality_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nationality"
            android:paddingHorizontal="16dp"
            android:importantForAutofill="noExcludeDescendants"
            app:endIconDrawable="@drawable/ic_close"
            app:endIconMode="custom"
            app:endIconTint="@color/n_lv_1"
            app:hintTextColor="@color/primary_default"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RedesignTextInputOutlinedStyle">
            <AutoCompleteTextView
                android:ellipsize="end"
                android:id="@+id/nationality_filter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:maxLines="1"
                android:popupBackground="@drawable/popup_background_drawable"
                android:inputType="textCapWords"
                android:imeOptions="flagNoExtractUi"
                android:textDirection="locale"
                android:paddingHorizontal="16dp"
                style="@style/BodyLarge"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:theme="@style/RedesignTextInputOutlinedTheme"
            android:textColorHint="@color/n_lv_3"
            android:id="@+id/tournament_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/league"
            android:textDirection="locale"
            android:paddingHorizontal="16dp"
            android:importantForAutofill="noExcludeDescendants"
            app:endIconDrawable="@drawable/ic_close"
            app:endIconMode="custom"
            app:endIconTint="@color/n_lv_1"
            app:hintTextColor="@color/primary_default"
            app:layout_constraintTop_toBottomOf="@+id/nationality_input"
            style="@style/RedesignTextInputOutlinedStyle">
            <AutoCompleteTextView
                android:ellipsize="end"
                android:id="@+id/tournament_filter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:maxLines="1"
                android:popupBackground="@drawable/popup_background_drawable"
                android:inputType="textCapWords"
                android:imeOptions="flagNoExtractUi|actionDone"
                android:paddingHorizontal="16dp"
                style="@style/BodyLarge"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.sofascore.results.view.typeheader.TypeHeaderView
            android:id="@+id/incoming_outgoing_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:headerBackground="@color/surface_P"
            app:layout_constraintTop_toBottomOf="@+id/tournament_input"/>
        <include
            android:id="@+id/age_range_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/incoming_outgoing_header"
            layout="@layout/subtitle_micro_left_with_icon_modal"/>
        <TextView
            android:gravity="center"
            android:id="@+id/age_range_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toBottomOf="@+id/age_range_subtitle"
            style="@style/BodyMedium"/>
        <com.google.android.material.slider.RangeSlider
            android:id="@+id/age_range_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="15"
            android:valueTo="50"
            android:layout_marginHorizontal="16dp"
            app:labelBehavior="gone"
            app:layout_constraintTop_toBottomOf="@+id/age_range_text"
            app:thumbColor="@color/on_color_primary"
            app:thumbElevation="1dp"
            app:trackColorActive="@color/primary_default"
            app:trackColorInactive="@color/n_lv_4"
            app:trackHeight="6dp"/>
        <include
            android:id="@+id/followers_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/age_range_slider"
            layout="@layout/subtitle_micro_left_with_icon_modal"/>
        <com.sofascore.results.view.typeheader.TypeHeaderView
            android:id="@+id/followers_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:headerBackground="@color/surface_P"
            app:layout_constraintTop_toBottomOf="@+id/followers_subtitle"/>
        <include
            android:id="@+id/position_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/followers_header"
            layout="@layout/subtitle_micro_left_with_icon_modal"/>
        <com.sofascore.results.view.typeheader.TypeHeaderView
            android:id="@+id/position_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:headerBackground="@color/surface_P"
            app:layout_constraintTop_toBottomOf="@+id/position_subtitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
