<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top"
    android:id="@+id/card_container"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:theme="@style/AssistiveDefault"
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/item_section_order"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_section_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:theme="@style/AssistiveDefault"
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/item_section_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_1"
        app:layout_constraintStart_toEndOf="@+id/item_section_order"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="132dp"/>
    <TextView
        android:theme="@style/AssistiveDefault"
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/item_section_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/AssistiveDefault"
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/AssistiveDefault"
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_4"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/AssistiveDefault"
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_5"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/AssistiveDefault"
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_6"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/AssistiveDefault"
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_7"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/AssistiveDefault"
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_7"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
