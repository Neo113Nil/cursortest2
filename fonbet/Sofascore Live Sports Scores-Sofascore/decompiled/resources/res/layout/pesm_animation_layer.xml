<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/overlay"
        android:background="@color/darken_overlay_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:id="@+id/swipe_tooltip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/swipe_to_change_player"
        android:maxLines="2"
        android:alpha="0"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/animation_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/AssistiveDefault"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animation_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/swipe_tooltip"
        app:lottie_rawRes="@raw/pesm_modal_swipe"/>
</androidx.constraintlayout.widget.ConstraintLayout>
