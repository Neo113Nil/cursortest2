<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collapsible_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.graph.BasketballShotmapPlayAreasGraph
        android:id="@+id/play_areas_first_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/first_team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/play_areas_first_team"
        app:layout_constraintStart_toEndOf="@+id/play_areas_first_team"
        app:layout_constraintTop_toTopOf="@+id/play_areas_first_team"/>
    <com.sofascore.results.view.graph.BasketballShotmapPlayAreasGraph
        android:id="@+id/play_areas_second_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/play_areas_first_team"/>
    <ImageView
        android:id="@+id/second_team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/play_areas_second_team"
        app:layout_constraintStart_toEndOf="@+id/play_areas_second_team"
        app:layout_constraintTop_toTopOf="@+id/play_areas_second_team"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/legend_colors"
        android:background="@drawable/rectangle_1dp_corners"
        android:layout_width="12dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:backgroundTint="@color/graphics_dark"
        app:layout_constraintBottom_toBottomOf="@+id/legend_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/legend_text">
        <View
            android:background="@color/away_primary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:background="@color/away_primary_80"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:background="@color/away_primary_60"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:background="@color/away_primary_40"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:background="@color/away_primary_20"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <View
            android:background="@color/away_primary_10"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="start|center_vertical"
        android:id="@+id/legend_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="32dp"
        android:text="@string/team_event_shot_map_description"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/legend_colors"
        app:layout_constraintTop_toBottomOf="@+id/play_areas_second_team"
        style="@style/AssistiveDefault"/>
    <View
        android:id="@+id/no_shots_icon"
        android:background="@drawable/rectangle_1dp_corners"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="6dp"
        android:backgroundTint="@color/rating_00"
        app:layout_constraintBottom_toBottomOf="@+id/no_shots_text"
        app:layout_constraintStart_toStartOf="@+id/legend_colors"
        app:layout_constraintTop_toTopOf="@+id/no_shots_text"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="start|center_vertical"
        android:id="@+id/no_shots_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="24dp"
        android:text="@string/shotmap_no_shots"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/no_shots_icon"
        app:layout_constraintTop_toBottomOf="@+id/legend_text"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/swap_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_transfer_swap"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/swap_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/swap_text"
        app:tint="@color/secondary_default"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="start|center_vertical"
        android:id="@+id/swap_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp"
        android:minHeight="32dp"
        android:text="@string/tap_graph_to_swap"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/swap_indicator"
        app:layout_constraintTop_toBottomOf="@+id/no_shots_text"
        style="@style/AssistiveDefault"/>
</androidx.constraintlayout.widget.ConstraintLayout>
