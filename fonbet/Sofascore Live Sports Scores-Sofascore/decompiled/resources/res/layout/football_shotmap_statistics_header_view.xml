<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rectangle_16dp_corners_no_color"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/surface_2"
    android:paddingHorizontal="4dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/arrow_left"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/player_image"
        app:tint="@color/primary_default"/>
    <ImageView
        android:id="@+id/player_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/arrow_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/player_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/player_image"
        app:layout_constraintEnd_toStartOf="@+id/minute"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/player_image"
        app:layout_constraintTop_toTopOf="@+id/player_image"
        style="@style/AssistiveDefault"/>
    <TextView
        android:gravity="center"
        android:id="@+id/minute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_name"
        app:layout_constraintEnd_toStartOf="@+id/arrow_right"
        app:layout_constraintTop_toTopOf="@+id/player_name"
        style="@style/DisplaySmall"/>
    <View
        android:id="@+id/player_click_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="-8dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_image"
        app:layout_constraintEnd_toStartOf="@+id/arrow_right"
        app:layout_constraintStart_toEndOf="@+id/arrow_left"
        app:layout_constraintTop_toTopOf="@+id/player_image"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/arrow_right"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/arrow_left"
        app:tint="@color/primary_default"/>
    <include
        android:id="@+id/info_1_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toStartOf="@+id/info_1_2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_image"
        layout="@layout/info_default_shrinked"/>
    <include
        android:id="@+id/info_1_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/info_1_3"
        app:layout_constraintStart_toEndOf="@+id/info_1_1"
        app:layout_constraintTop_toTopOf="@+id/info_1_1"
        layout="@layout/info_default_shrinked"/>
    <include
        android:id="@+id/info_1_3"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/info_1_2"
        app:layout_constraintTop_toTopOf="@+id/info_1_1"
        layout="@layout/info_default_shrinked"/>
    <View
        android:id="@+id/divider_1_1"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/info_1_1"
        app:layout_constraintEnd_toStartOf="@+id/info_1_2"
        app:layout_constraintStart_toEndOf="@+id/info_1_1"
        app:layout_constraintTop_toTopOf="@+id/info_1_1"/>
    <View
        android:id="@+id/divider_1_2"
        android:background="@color/n_lv_4"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/info_1_1"
        app:layout_constraintEnd_toStartOf="@+id/info_1_3"
        app:layout_constraintStart_toEndOf="@+id/info_1_2"
        app:layout_constraintTop_toTopOf="@+id/info_1_1"/>
    <include
        android:id="@+id/info_2_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/info_2_2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_1_1"
        layout="@layout/info_default_shrinked"/>
    <include
        android:id="@+id/info_2_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/info_2_3"
        app:layout_constraintStart_toEndOf="@+id/info_2_1"
        app:layout_constraintTop_toTopOf="@+id/info_2_1"
        layout="@layout/info_default_shrinked"/>
    <include
        android:id="@+id/info_2_3"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/info_2_2"
        app:layout_constraintTop_toTopOf="@+id/info_2_1"
        layout="@layout/info_default_shrinked"/>
    <View
        android:id="@+id/divider_2_1"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/info_2_1"
        app:layout_constraintEnd_toStartOf="@+id/info_2_2"
        app:layout_constraintStart_toEndOf="@+id/info_2_1"
        app:layout_constraintTop_toTopOf="@+id/info_2_1"/>
    <View
        android:id="@+id/divider_2_2"
        android:background="@color/n_lv_4"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/info_2_1"
        app:layout_constraintEnd_toStartOf="@+id/info_2_3"
        app:layout_constraintStart_toEndOf="@+id/info_2_2"
        app:layout_constraintTop_toTopOf="@+id/info_2_1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
