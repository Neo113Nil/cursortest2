<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/ad_placeholder"
        android:background="@drawable/rounded_surface_level_4"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feed_ad_placeholder"
        android:backgroundTint="@color/surface_2"
        app:layout_constraintBottom_toBottomOf="@+id/brand_logo_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/brand_logo_space"
        style="@style/AssistiveDefault"/>
    <Space
        android:id="@+id/brand_logo_space"
        android:layout_width="0dp"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/brand_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:id="@+id/text_brand_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/text_sponsored"
        app:layout_constraintEnd_toStartOf="@+id/ad_placeholder"
        app:layout_constraintStart_toEndOf="@+id/brand_image"
        app:layout_constraintTop_toTopOf="@+id/brand_logo_space"
        app:layout_constraintVertical_chainStyle="spread"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/text_sponsored"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sponsored"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="@+id/brand_logo_space"
        app:layout_constraintEnd_toEndOf="@+id/text_brand_name"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/text_brand_name"
        app:layout_constraintTop_toBottomOf="@+id/text_brand_name"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="2"
        android:textAlignment="viewStart"
        app:layout_constraintTop_toBottomOf="@+id/text_sponsored"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textAlignment="viewStart"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/cta_button"
        android:background="@drawable/rounded_surface_level_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/primary_default"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/body"
        app:layout_constraintVertical_bias="1"
        style="@style/ActionButtonPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
