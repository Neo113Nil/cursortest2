<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="16dp">
    <TextView
        android:gravity="center"
        android:id="@+id/position_label"
        android:layout_width="16dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodySmall"/>
    <ImageView
        android:id="@+id/item_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/position_label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="16dp"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/primary_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/secondary_holder"
        app:layout_constraintEnd_toStartOf="@+id/stat_barrier"
        app:layout_constraintStart_toEndOf="@+id/item_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/BodyMedium"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/secondary_holder"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tertiary_holder"
        app:layout_constraintEnd_toEndOf="@+id/primary_label"
        app:layout_constraintStart_toStartOf="@+id/primary_label"
        app:layout_constraintTop_toBottomOf="@+id/primary_label">
        <ImageView
            android:id="@+id/secondary_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:id="@+id/secondary_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/tertiary_holder"
        android:background="@drawable/rounded_surface_level_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:backgroundTint="@color/surface_2"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/primary_label"
        app:layout_constraintTop_toBottomOf="@+id/secondary_holder">
        <ImageView
            android:id="@+id/home_team_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/home_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            style="@style/DisplayMicro"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:paddingHorizontal="1dp"
            style="@style/DisplayMicro"/>
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:id="@+id/away_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/DisplayMicro"/>
        <ImageView
            android:id="@+id/away_team_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/stat_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="stat_value,rating_text,end_icon"/>
    <ImageView
        android:id="@+id/end_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rating_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodyMedium"/>
    <com.sofascore.results.view.SofascoreRatingView
        android:id="@+id/rating_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:animateRating="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sofascore.results.view.SofascoreSmallRatingView
        android:id="@+id/rating_small"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:small_animateRating="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
