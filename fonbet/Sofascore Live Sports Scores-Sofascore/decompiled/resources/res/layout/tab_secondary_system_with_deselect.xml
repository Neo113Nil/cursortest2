<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:minWidth="32dp"
    android:paddingHorizontal="4dp"
    style="@style/NavigationTabSecondary">
    <TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/type_text"
        android:background="@drawable/rounded_surface_level_1"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minWidth="32dp"
        android:singleLine="true"
        android:drawablePadding="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:backgroundTint="@color/surface_2"
        app:drawableEndCompat="@drawable/ic_remove"
        app:drawableTint="@color/neutral_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
</androidx.constraintlayout.widget.ConstraintLayout>
