<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp">
    <com.sofascore.results.view.typeheader.TypeHeaderView
        android:id="@+id/penalty_types_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sofascore.results.view.EventInfoView
        android:id="@+id/event_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/penalty_shotmap_next"
        app:layout_constraintStart_toEndOf="@+id/penalty_shotmap_previous"
        app:layout_constraintTop_toBottomOf="@+id/penalty_types_holder"/>
    <ImageView
        android:id="@+id/penalty_shotmap_previous"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_chevron_down"
        android:rotation="@integer/rotate_90_clockwise"
        app:layout_constraintBottom_toBottomOf="@+id/event_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/event_info"
        app:tint="@color/primary_default"/>
    <ImageView
        android:id="@+id/penalty_shotmap_next"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_chevron_down"
        android:rotation="@integer/rotate_270_clockwise"
        app:layout_constraintBottom_toBottomOf="@+id/event_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/event_info"
        app:tint="@color/primary_default"/>
    <TextView
        android:gravity="center"
        android:id="@+id/penalty_empty_state_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/empty_season_penalty_shotmap"
        app:layout_constraintBottom_toBottomOf="@+id/penalty_shotmap_previous"
        app:layout_constraintEnd_toStartOf="@+id/penalty_shotmap_next"
        app:layout_constraintStart_toEndOf="@+id/penalty_shotmap_previous"
        app:layout_constraintTop_toTopOf="@+id/penalty_shotmap_previous"/>
    <com.sofascore.results.player.statistics.regular.view.PlayerPenaltyShotView
        android:id="@+id/penalty_shotmap_view"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/event_info"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/shot_outcome"
        app:layout_constraintEnd_toStartOf="@+id/goal_zone"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/penalty_shotmap_view"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/goal_zone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/goal_zone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/result"
        app:layout_constraintTop_toBottomOf="@+id/penalty_shotmap_view"
        style="@style/AssistiveMicro"/>
    <TextView
        android:id="@+id/result_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/result"
        app:layout_constraintStart_toStartOf="@+id/result"
        app:layout_constraintTop_toBottomOf="@+id/result"
        style="@style/DisplaySmall"/>
    <TextView
        android:id="@+id/goal_zone_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/goal_zone"
        app:layout_constraintStart_toStartOf="@+id/goal_zone"
        app:layout_constraintTop_toBottomOf="@+id/goal_zone"
        style="@style/DisplaySmall"/>
    <FrameLayout
        android:id="@+id/info_card"
        android:background="@drawable/rounded_surface_level_2"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/surface_2"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/goal_zone_text"/>
    <TextView
        android:id="@+id/penalty_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/football_penalty_goals"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/info_card"
        app:layout_constraintTop_toTopOf="@+id/info_card"
        style="@style/BodyMedium"/>
    <TextView
        android:id="@+id/penalty_conversion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/football_penalty_conversion"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/info_card"
        app:layout_constraintTop_toBottomOf="@+id/penalty_goal"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/penalty_goal_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/info_card"
        app:layout_constraintTop_toTopOf="@+id/penalty_goal"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/penalty_conversion_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/info_card"
        app:layout_constraintTop_toBottomOf="@+id/penalty_goal"
        style="@style/BodyMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
