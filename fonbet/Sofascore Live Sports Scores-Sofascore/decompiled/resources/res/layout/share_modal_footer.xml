<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end"
    android:orientation="horizontal"
    android:background="@color/surface_1"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <ImageView
        android:id="@+id/download_button"
        android:background="@drawable/border_corners_4dp_stroke_width_2dp"
        android:padding="6dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_download"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/primary_default"
        app:strokeColor="@color/primary_default"
        app:strokeWidth="1dp"
        app:tint="@color/primary_default"/>
    <Button
        android:id="@+id/share_button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp"
        android:text="@string/share_image"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:drawableEnd="@drawable/ic_menu_list_share"
        android:backgroundTint="@color/primary_default"
        android:drawableTint="@color/surface_1"
        style="@style/ButtonFilledDefault"/>
</LinearLayout>
