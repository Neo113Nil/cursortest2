<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:background="@color/surface_0"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="2dp"
        app:liftOnScroll="true">
        <com.sofascore.common.mvvm.UnderlinedToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="48dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:src="@drawable/logo_sofascore_new"
                android:adjustViewBounds="true"
                android:contentDescription="@string/picture"
                app:tint="@color/n_lv_1"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:gravity="center"
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                style="@style/DisplaySmall"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/button_support"
                android:background="@drawable/rectangle_12dp_corners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/contact"
                android:drawablePadding="12dp"
                android:textAlignment="viewStart"
                android:backgroundTint="@color/surface_1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                app:drawableStartCompat="@drawable/ic_email"
                app:drawableTint="@color/neutral_default"
                style="@style/BodyMedium"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/button_privacy"
                android:background="@drawable/rectangle_12dp_corners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_policy"
                android:drawablePadding="12dp"
                android:textAlignment="viewStart"
                android:backgroundTint="@color/surface_1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                app:drawableStartCompat="@drawable/ic_lock_privacy"
                app:drawableTint="@color/neutral_default"
                style="@style/BodyMedium"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/button_cookie_privacy"
                android:background="@drawable/rectangle_12dp_corners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/cookie_policy"
                android:drawablePadding="12dp"
                android:textAlignment="viewStart"
                android:backgroundTint="@color/surface_1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                app:drawableStartCompat="@drawable/ic_note_white"
                app:drawableTint="@color/neutral_default"
                style="@style/BodyMedium"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/button_accessibility_policy"
                android:background="@drawable/rectangle_12dp_corners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/accessibility_policy"
                android:drawablePadding="12dp"
                android:textAlignment="viewStart"
                android:backgroundTint="@color/surface_1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                app:drawableStartCompat="@drawable/ic_note_white"
                app:drawableTint="@color/neutral_default"
                style="@style/BodyMedium"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/button_terms"
                android:background="@drawable/rectangle_12dp_corners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/terms_and_conditions"
                android:drawablePadding="12dp"
                android:textAlignment="viewStart"
                android:backgroundTint="@color/surface_1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                app:drawableStartCompat="@drawable/ic_note_white"
                app:drawableTint="@color/neutral_default"
                style="@style/BodyMedium"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/button_gdpr"
                android:background="@drawable/rectangle_12dp_corners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/gdpr_and_journalism"
                android:drawablePadding="12dp"
                android:textAlignment="viewStart"
                android:backgroundTint="@color/surface_1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                app:drawableStartCompat="@drawable/ic_note_white"
                app:drawableTint="@color/neutral_default"
                style="@style/BodyMedium"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/button_impressum"
                android:background="@drawable/rectangle_12dp_corners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/impressum"
                android:drawablePadding="12dp"
                android:textAlignment="viewStart"
                android:backgroundTint="@color/surface_1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                app:drawableStartCompat="@drawable/ic_note_white"
                app:drawableTint="@color/neutral_default"
                style="@style/BodyMedium"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:text="@string/subtitle"
                style="@style/AssistiveDefault"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/social_networks"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp">
                <ImageView
                    android:id="@+id/button_facebook"
                    android:background="@drawable/rectangle_8dp_corners"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_facebook"
                    android:layout_marginEnd="8dp"
                    android:elevation="2dp"
                    android:backgroundTint="@color/surface_1"
                    app:tint="@color/neutral_default"/>
                <ImageView
                    android:id="@+id/button_twitter"
                    android:background="@drawable/rectangle_8dp_corners"
                    android:padding="4dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_twitter"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="8dp"
                    android:elevation="2dp"
                    android:backgroundTint="@color/surface_1"
                    app:tint="@color/neutral_default"/>
                <ImageView
                    android:id="@+id/button_instagram"
                    android:background="@drawable/rectangle_8dp_corners"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_instagram"
                    android:layout_marginEnd="8dp"
                    android:elevation="2dp"
                    android:backgroundTint="@color/surface_1"
                    app:tint="@color/neutral_default"/>
                <ImageView
                    android:id="@+id/button_tiktok"
                    android:background="@drawable/rectangle_8dp_corners"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_tiktok"
                    android:elevation="2dp"
                    android:backgroundTint="@color/surface_1"
                    app:tint="@color/neutral_default"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/romania_license_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:showDividers="middle"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <TextView
                    android:textColor="@color/n_lv_3"
                    android:id="@+id/romania_license_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/romania_license_title"
                    style="@style/BodyLarge"/>
                <TextView
                    android:textColor="@color/n_lv_3"
                    android:id="@+id/romania_license_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/romania_license_text"
                    style="@style/BodyMedium"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
