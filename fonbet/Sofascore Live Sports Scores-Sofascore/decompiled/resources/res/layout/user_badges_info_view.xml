<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/info_container"
    android:background="@drawable/rectangle_16dp_corners"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="0dp"
    android:backgroundTint="@color/surface_1"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">
    <ImageView
        android:id="@+id/icon_info"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/n_lv_3"/>
    <TextView
        android:id="@+id/information_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/earn_profile_badges"
        android:lineSpacingExtra="4dp"
        android:textAlignment="viewStart"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/read_more"
        app:layout_constraintEnd_toStartOf="@+id/close"
        app:layout_constraintStart_toEndOf="@+id/icon_info"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/primary_default"
        android:id="@+id/read_more"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/learn_how_to_get_badges"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/information_text"
        app:layout_constraintStart_toStartOf="@+id/information_text"
        app:layout_constraintTop_toBottomOf="@+id/information_text"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/close"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/information_text"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary_default"/>
</androidx.constraintlayout.widget.ConstraintLayout>
