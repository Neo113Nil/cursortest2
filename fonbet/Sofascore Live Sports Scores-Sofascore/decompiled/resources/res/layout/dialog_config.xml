<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Spinner
        android:id="@+id/spinner_params"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="16dp"/>
    <View
        android:id="@+id/upper_vertical_divider"
        android:background="@color/sofaDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/spinner_params"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/upper_vertical_divider"/>
    <View
        android:id="@+id/lower_vertical_divider"
        android:background="@color/sofaDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignBottom="@+id/recycler_view"/>
</RelativeLayout>
