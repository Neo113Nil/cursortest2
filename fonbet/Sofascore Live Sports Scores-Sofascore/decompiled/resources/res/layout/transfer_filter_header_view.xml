<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <FrameLayout
        android:id="@+id/filter_container"
        android:background="@color/surface_1"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/filter_icon"
            android:background="@drawable/rounded_surface_level_2"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_filter_list"
            android:backgroundTint="@color/surface_2"
            app:tint="@color/n_lv_1"/>
    </FrameLayout>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/filter_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/filter"
        android:textDirection="locale"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/filter_container"
        style="@style/BodyMedium"/>
    <com.sofascore.results.transfers.view.TransferFilterScrollableHeaderView
        android:id="@+id/scrollable_view"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/filter_container"/>
    <View
        android:id="@+id/transfer_filter_bottom_divider"
        android:background="@color/n_lv_4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:elevation="40dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
