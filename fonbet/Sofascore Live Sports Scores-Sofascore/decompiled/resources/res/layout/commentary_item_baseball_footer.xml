<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="24dp">
    <TextView
        android:textColor="@color/n_lv_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/baseball_balls_short"
        style="@style/AssistiveDefault"/>
    <com.sofascore.results.view.DotView
        android:id="@+id/ball_1"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="2dp"
        app:dotColor="@color/secondary_default"/>
    <com.sofascore.results.view.DotView
        android:id="@+id/ball_2"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="2dp"
        app:dotColor="@color/secondary_default"/>
    <com.sofascore.results.view.DotView
        android:id="@+id/ball_3"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="2dp"
        app:dotColor="@color/secondary_default"/>
    <com.sofascore.results.view.DotView
        android:id="@+id/ball_4"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="2dp"
        app:dotColor="@color/secondary_default"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/baseball_strikes_short"
        android:layout_marginStart="8dp"
        style="@style/AssistiveDefault"/>
    <com.sofascore.results.view.DotView
        android:id="@+id/strike_1"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="2dp"
        app:dotColor="@color/error"/>
    <com.sofascore.results.view.DotView
        android:id="@+id/strike_2"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="2dp"
        app:dotColor="@color/error"/>
    <com.sofascore.results.view.DotView
        android:id="@+id/strike_3"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="2dp"
        app:dotColor="@color/error"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_weight="1"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/bases"
        android:layout_width="22dp"
        android:layout_height="16dp"
        android:layout_marginEnd="5dp"/>
</LinearLayout>
