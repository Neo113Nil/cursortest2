<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">
    <ImageView
        android:id="@+id/first_player_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/first_player_role"
        android:background="@drawable/circle"
        android:padding="4dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:backgroundTint="@color/surface_0"
        app:layout_constraintBottom_toBottomOf="@+id/first_player_image"
        app:layout_constraintEnd_toEndOf="@+id/first_player_image"
        app:layout_constraintStart_toEndOf="@+id/first_player_image"/>
    <ImageView
        android:id="@+id/second_player_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_player_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_player_image"/>
    <ImageView
        android:id="@+id/second_player_role"
        android:background="@drawable/circle"
        android:padding="4dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:backgroundTint="@color/surface_0"
        app:layout_constraintBottom_toBottomOf="@+id/second_player_image"
        app:layout_constraintEnd_toStartOf="@+id/second_player_image"
        app:layout_constraintStart_toStartOf="@+id/second_player_image"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/first_player_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/first_player_name"
        app:layout_constraintEnd_toStartOf="@+id/center_guideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/first_player_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/BodyLarge"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/first_player_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/center_guideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/first_player_nickname"
        app:layout_constraintTop_toBottomOf="@+id/first_player_nickname"
        style="@style/BodyMedium"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/second_player_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/first_player_nickname"
        app:layout_constraintEnd_toStartOf="@+id/second_player_image"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/center_guideline"
        app:layout_constraintTop_toTopOf="@+id/first_player_nickname"
        style="@style/BodyLarge"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/second_player_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/second_player_nickname"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/center_guideline"
        app:layout_constraintTop_toBottomOf="@+id/second_player_nickname"
        style="@style/BodyMedium"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/center_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
