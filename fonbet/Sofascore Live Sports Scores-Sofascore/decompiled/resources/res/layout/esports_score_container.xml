<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/score_container"
        android:background="@drawable/rectangle_8dp_corners"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:backgroundTint="@color/darken_overlay_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="6dp">
        <TextView
            android:id="@+id/first_team_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/DisplayLarge"/>
        <TextView
            android:id="@+id/score_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            style="@style/DisplayLarge"/>
        <TextView
            android:id="@+id/second_team_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/DisplayLarge"/>
    </LinearLayout>
    <View
        android:id="@+id/score_border"
        android:background="@drawable/border_corners_8dp_stroke_width_2dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/score_container"
        app:layout_constraintEnd_toEndOf="@+id/score_container"
        app:layout_constraintStart_toStartOf="@+id/score_container"
        app:layout_constraintTop_toTopOf="@+id/score_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
