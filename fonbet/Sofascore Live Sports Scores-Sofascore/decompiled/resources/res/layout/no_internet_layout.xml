<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sofascore.results.redesign.emptystateblocks.GraphicLarge
        android:layout_gravity="center"
        android:id="@+id/no_connection_empty_state"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:graphicLargeButtonText="@string/button_text_ok_got_it"
        app:graphicLargeDrawable="@drawable/no_connection"
        app:graphicLargeSubtitle="@string/error_no_internet_connection_description"
        app:graphicLargeTitle="@string/no_internet_info_title"/>
    <TextView
        android:textColor="@color/surface_1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/no_connection_banner"
        android:background="@color/error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:text="@string/no_internet_info_title"
        android:maxLines="2"
        android:elevation="1dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        style="@style/BodyMedium"/>
</FrameLayout>
