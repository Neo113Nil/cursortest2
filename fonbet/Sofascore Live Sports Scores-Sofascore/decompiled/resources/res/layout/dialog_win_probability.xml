<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="8dp"
        android:paddingBottom="48dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <TextView
            android:id="@+id/win_probability_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/am_football_win_probability_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:textColor="@color/secondary_default"
            android:id="@+id/home_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/win_probability_text"
            style="@style/AssistiveDefault"/>
        <ImageView
            android:id="@+id/win_probability_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_win_probability_dialog"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/logo_first"
            app:layout_constraintTop_toBottomOf="@+id/home_label"/>
        <View
            android:id="@+id/win_probability_empty_space"
            android:background="@color/n_lv_5"
            android:layout_width="44dp"
            android:layout_height="80dp"
            app:layout_constraintBottom_toBottomOf="@+id/win_probability_icon"
            app:layout_constraintStart_toEndOf="@+id/win_probability_icon"
            app:layout_constraintTop_toTopOf="@+id/win_probability_icon"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="%"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toTopOf="@+id/win_probability_empty_space"
            app:layout_constraintStart_toEndOf="@+id/win_probability_empty_space"
            style="@style/BodySmall"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/win_probability_empty_space"
            app:layout_constraintTop_toTopOf="@+id/win_probability_empty_space"
            style="@style/BodySmall"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/win_probability_empty_space"
            app:layout_constraintStart_toEndOf="@+id/win_probability_empty_space"
            app:layout_constraintTop_toTopOf="@+id/win_probability_empty_space"
            style="@style/BodySmall"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/win_probability_empty_space"
            app:layout_constraintStart_toEndOf="@+id/win_probability_empty_space"
            style="@style/BodySmall"/>
        <ImageView
            android:id="@+id/logo_first"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toTopOf="@+id/logo_second"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/win_probability_icon"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:id="@+id/logo_second"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:layout_below="@+id/logo_first"
            app:layout_constraintBottom_toBottomOf="@+id/win_probability_icon"
            app:layout_constraintStart_toStartOf="@+id/logo_first"
            app:layout_constraintTop_toBottomOf="@+id/logo_first"/>
        <TextView
            android:textColor="@color/primary_default"
            android:id="@+id/away_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/win_probability_icon"
            style="@style/AssistiveDefault"/>
        <TextView
            android:id="@+id/incident_legend_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/am_football_win_probability_incident_icons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/away_label"
            style="@style/DisplaySmall"/>
        <ImageView
            android:id="@+id/touchdown_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_touchdown_16"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="@+id/incident_legend_title"
            app:layout_constraintTop_toBottomOf="@+id/incident_legend_title"
            app:tint="@color/n_lv_1"/>
        <TextView
            android:id="@+id/touchdown_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amf_touchdown"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/touchdown_icon"
            app:layout_constraintStart_toEndOf="@+id/touchdown_icon"
            app:layout_constraintTop_toTopOf="@+id/touchdown_icon"
            style="@style/BodyMedium"/>
        <ImageView
            android:id="@+id/touchdown_extra_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_touchdown_extra_point"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="@+id/incident_legend_title"
            app:layout_constraintTop_toBottomOf="@+id/touchdown_icon"
            app:tint="@color/n_lv_1"/>
        <TextView
            android:id="@+id/touchdown_extra_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_football_win_probability_td_xp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/touchdown_extra_icon"
            app:layout_constraintStart_toEndOf="@+id/touchdown_extra_icon"
            app:layout_constraintTop_toTopOf="@+id/touchdown_extra_icon"
            style="@style/BodyMedium"/>
        <ImageView
            android:id="@+id/touchdown_2pt_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_touchdown_2pt_conversion"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="@+id/incident_legend_title"
            app:layout_constraintTop_toBottomOf="@+id/touchdown_extra_icon"
            app:tint="@color/n_lv_1"/>
        <TextView
            android:id="@+id/touchdown_2pt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/am_football_win_probability_td_2pt"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/touchdown_2pt_icon"
            app:layout_constraintStart_toEndOf="@+id/touchdown_2pt_icon"
            app:layout_constraintTop_toTopOf="@+id/touchdown_2pt_icon"
            style="@style/BodyMedium"/>
        <ImageView
            android:id="@+id/field_goal_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_field_goal_16"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="@+id/incident_legend_title"
            app:layout_constraintTop_toBottomOf="@+id/touchdown_2pt_icon"
            app:tint="@color/n_lv_1"/>
        <TextView
            android:id="@+id/field_goal_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amf_field_goal"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/field_goal_icon"
            app:layout_constraintStart_toEndOf="@+id/field_goal_icon"
            app:layout_constraintTop_toTopOf="@+id/field_goal_icon"
            style="@style/BodyMedium"/>
        <ImageView
            android:id="@+id/safety_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_safety_16"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="@+id/incident_legend_title"
            app:layout_constraintTop_toBottomOf="@+id/field_goal_icon"
            app:tint="@color/n_lv_1"/>
        <TextView
            android:id="@+id/safety_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amf_safety"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/safety_icon"
            app:layout_constraintStart_toEndOf="@+id/safety_icon"
            app:layout_constraintTop_toTopOf="@+id/safety_icon"
            style="@style/BodyMedium"/>
        <ImageView
            android:id="@+id/rouge_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_rogue_16"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="@+id/incident_legend_title"
            app:layout_constraintTop_toBottomOf="@+id/safety_icon"
            app:tint="@color/n_lv_1"/>
        <TextView
            android:id="@+id/rouge_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amf_rouge_canadian_football"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/rouge_icon"
            app:layout_constraintStart_toEndOf="@+id/rouge_icon"
            app:layout_constraintTop_toTopOf="@+id/rouge_icon"
            style="@style/BodyMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
