<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minHeight="56dp">
    <ImageView
        android:id="@+id/layout_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/mvp_badge"
        android:background="@color/rating_90"
        android:padding="1dp"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_star_filled_16"
        android:tint="@android:color/white"
        app:contentPadding="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/layout_image"
        app:layout_constraintStart_toStartOf="@+id/layout_image"
        app:shapeAppearanceOverlay="@style/RoundedStyleCircle"
        app:strokeColor="@android:color/white"
        app:strokeWidth="2dp"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/jersey_number_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/primary_label"
        app:layout_constraintStart_toEndOf="@+id/layout_image"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/primary_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/secondary_label"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/jersey_number_label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="10dp"
        app:layout_goneMarginStart="16dp"
        style="@style/BodyMedium"/>
    <ImageView
        android:id="@+id/secondary_label_icon"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="16dp"
        android:paddingEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/secondary_label"
        app:layout_constraintStart_toStartOf="@+id/jersey_number_label"
        app:layout_constraintTop_toTopOf="@+id/secondary_label"
        app:layout_goneMarginStart="16dp"/>
    <TextView
        android:id="@+id/secondary_label_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="ltr"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/secondary_label"
        app:layout_constraintStart_toEndOf="@+id/secondary_label_icon"
        app:layout_constraintTop_toTopOf="@+id/secondary_label"
        app:layout_goneMarginStart="16dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/secondary_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tertiary_label"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/secondary_label_time"
        app:layout_constraintTop_toBottomOf="@+id/primary_label"
        app:layout_goneMarginBottom="8dp"
        app:layout_goneMarginStart="16dp"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/tertiary_label_icon"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="16dp"
        android:paddingEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tertiary_label"
        app:layout_constraintStart_toStartOf="@+id/secondary_label_icon"
        app:layout_constraintTop_toTopOf="@+id/tertiary_label"
        app:layout_goneMarginStart="16dp"/>
    <TextView
        android:id="@+id/tertiary_label_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="ltr"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tertiary_label"
        app:layout_constraintStart_toEndOf="@+id/tertiary_label_icon"
        app:layout_constraintTop_toTopOf="@+id/tertiary_label"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tertiary_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tertiary_label_time"
        app:layout_constraintTop_toBottomOf="@+id/secondary_label"
        style="@style/AssistiveDefault"/>
    <com.sofascore.results.view.SofascoreSmallRatingView
        android:id="@+id/rating"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintTop_toTopOf="parent"
        app:small_animateRating="false"/>
    <TextView
        android:gravity="end"
        android:id="@+id/end_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="viewEnd"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/end_text_bottom_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodyMedium"/>
    <ImageView
        android:id="@+id/end_text_bottom_image"
        android:visibility="gone"
        android:layout_width="58dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/end_text"
        app:layout_constraintTop_toBottomOf="@+id/end_text"/>
    <ImageView
        android:id="@+id/logo"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="end_text, end_text_bottom_image, logo, rating, test_rating"/>
    <com.sofascore.results.view.SofascoreSmallRatingView
        android:id="@+id/test_rating"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_divider"
        android:background="@color/n_lv_4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/jersey_number_label"
        app:layout_goneMarginStart="16dp"/>
    <include
        android:id="@+id/missing_player_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/missing_player_data"/>
</androidx.constraintlayout.widget.ConstraintLayout>
