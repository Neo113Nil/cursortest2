<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/shot_map_percentage_image"
            android:background="@drawable/circle"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_graph_percent"
            android:layout_marginEnd="4dp"/>
        <ImageView
            android:id="@+id/shot_map_difference_image"
            android:background="@drawable/circle"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_graph_difference"
            android:layout_marginVertical="30dp"/>
        <ImageView
            android:id="@+id/shot_map_total_shots_image"
            android:background="@drawable/circle"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_graph_basketball"/>
    </LinearLayout>
    <com.sofascore.results.view.graph.BasketballShotmapPlayAreasGraph
        android:id="@+id/graph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <include
        android:layout_width="12dp"
        android:layout_height="144dp"
        android:layout_marginStart="10dp"
        layout="@layout/player_shotmap_color_legend"/>
</LinearLayout>
