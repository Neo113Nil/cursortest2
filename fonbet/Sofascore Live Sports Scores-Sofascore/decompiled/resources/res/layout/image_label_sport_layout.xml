<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/card_container"
    android:background="@color/surface_1"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minHeight="56dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:id="@+id/layout_image"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:layout_weight="1"
        android:paddingStart="16dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/primary_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:id="@+id/primary_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/followers_separator"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/BodyMedium"/>
            <ImageView
                android:id="@+id/followers_separator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/circle"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/followers_count"
                app:layout_constraintStart_toEndOf="@+id/primary_label"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/n_lv_4"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/followers_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_crowdsourcing"
                android:maxLines="1"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@drawable/ic_crowdsourcing"
                app:drawableTint="@color/n_lv_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/followers_separator"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AssistiveDefault"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/followers_count_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="followers_separator, followers_count"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/secondary_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <ImageView
                android:id="@+id/secondary_logo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/secondary_label"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/secondary_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/separator"
                app:layout_constraintStart_toEndOf="@+id/secondary_logo"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AssistiveDefault"/>
            <ImageView
                android:id="@+id/separator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/circle"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ternary_logo"
                app:layout_constraintStart_toEndOf="@+id/secondary_label"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/n_lv_4"/>
            <ImageView
                android:id="@+id/ternary_logo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ternary_label"
                app:layout_constraintStart_toEndOf="@+id/separator"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/ternary_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ternary_logo"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AssistiveDefault"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/icon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_close"
        android:scaleType="centerInside"
        app:tint="@color/n_lv_3"/>
    <com.sofascore.results.view.follownotification.FollowButton
        android:id="@+id/button_favorites"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"/>
</LinearLayout>
