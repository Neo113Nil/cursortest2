<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/ll_standings_header"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <View
        android:id="@+id/selected_team_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/indicator"
        android:layout_width="2dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/indicator_horizontal"
        app:layout_goneMarginTop="-24dp"/>
    <View
        android:id="@+id/indicator_horizontal"
        android:layout_width="8dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/indicator"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/indicator_horizontal_bottom"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/indicator"/>
    <View
        android:id="@+id/spacer"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/indicator"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/standings_rank"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_centerInParent="true"
        android:textAlignment="center"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/spacer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="8dp"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/team_logo"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/standings_rank"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/standings_team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="locale"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:hyphenationFrequency="normalFast"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/standings_header_form"
        app:layout_constraintStart_toEndOf="@+id/team_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="108dp"
        app:layout_goneMarginStart="0dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="end"
        android:id="@+id/standings_header_form"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="@string/standings_last_5"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_1"
        app:layout_constraintStart_toEndOf="@+id/standings_team_name"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:maxWidth="52dp"
        android:maxLines="2"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_2"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/standings_form_6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="52dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:maxLines="2"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@+id/column_1"
        app:layout_constraintEnd_toStartOf="@+id/column_3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_1"
        app:layout_constraintTop_toTopOf="@+id/column_1"
        app:layout_constraintWidth_max="52dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_3"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:maxLines="2"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@+id/column_1"
        app:layout_constraintEnd_toStartOf="@+id/column_4"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_2"
        app:layout_constraintTop_toTopOf="@+id/column_1"
        app:layout_constraintWidth_max="52dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_4"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:maxLines="2"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@+id/column_1"
        app:layout_constraintEnd_toStartOf="@+id/column_5"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_3"
        app:layout_constraintTop_toTopOf="@+id/column_1"
        app:layout_constraintWidth_max="52dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_5"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:maxLines="2"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@+id/column_1"
        app:layout_constraintEnd_toStartOf="@+id/column_6"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_4"
        app:layout_constraintTop_toTopOf="@+id/column_1"
        app:layout_constraintWidth_max="52dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_6"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:maxLines="2"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@+id/column_1"
        app:layout_constraintEnd_toStartOf="@+id/column_7"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_5"
        app:layout_constraintTop_toTopOf="@+id/column_1"
        app:layout_constraintWidth_max="52dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_7"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@+id/column_1"
        app:layout_constraintEnd_toStartOf="@+id/column_8"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_6"
        app:layout_constraintTop_toTopOf="@+id/column_1"
        app:layout_constraintWidth_max="52dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_8"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@+id/column_1"
        app:layout_constraintEnd_toStartOf="@+id/column_9"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_7"
        app:layout_constraintTop_toTopOf="@+id/column_1"
        app:layout_constraintWidth_max="52dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/column_9"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@+id/column_1"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_8"
        app:layout_constraintTop_toTopOf="@+id/column_1"
        app:layout_constraintWidth_max="52dp"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_1"
        android:background="@drawable/rectangle_4dp_corners_left"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:paddingStart="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_2"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/standings_header_form"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_1"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_1"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_2"
        android:background="@color/surface_1"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/standings_form_1"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_3"
        app:layout_constraintStart_toEndOf="@+id/standings_form_1"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_2"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_2"
        app:layout_constraintTop_toTopOf="@+id/standings_form_2"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_3"
        android:background="@color/surface_1"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/standings_form_1"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_4"
        app:layout_constraintStart_toEndOf="@+id/standings_form_2"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_3"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_3"
        app:layout_constraintTop_toTopOf="@+id/standings_form_3"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_4"
        android:background="@color/surface_1"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/standings_form_1"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_5"
        app:layout_constraintStart_toEndOf="@+id/standings_form_3"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_4"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_4"
        app:layout_constraintTop_toTopOf="@+id/standings_form_4"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_5"
        android:background="@color/surface_1"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/standings_form_1"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_6"
        app:layout_constraintStart_toEndOf="@+id/standings_form_4"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_5"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_5"
        app:layout_constraintTop_toTopOf="@+id/standings_form_5"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_6"
        android:background="@drawable/rectangle_4dp_corners_right"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/standings_form_1"
        app:layout_constraintEnd_toStartOf="@+id/column_1"
        app:layout_constraintStart_toEndOf="@+id/standings_form_5"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_6"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_6"
        app:layout_constraintTop_toTopOf="@+id/standings_form_6"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="8dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
