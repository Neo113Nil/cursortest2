<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/calendar_root"
    android:background="@color/darken_overlay_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container"
            android:background="@drawable/rectangle_16dp_corners"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:elevation="4dp"
            android:layout_marginHorizontal="8dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/calendar_holder"
                android:background="@color/surface_P"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/header_background">
                <com.sofascore.results.calendar.MaterialCalendarView
                    android:id="@+id/calendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:paddingTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp">
                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="4dp"
                        android:src="@drawable/rectangle_2dp_corners"
                        app:tint="@color/primary_default"/>
                    <TextView
                        android:textColor="@color/n_lv_3"
                        android:id="@+id/dot_explanation_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calendar_favorites_explainer"
                        android:layout_marginStart="8dp"
                        style="@style/BodySmall"/>
                </LinearLayout>
                <com.sofascore.results.redesign.dividers.SofaDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:dividerVisible="true"
                    app:dividerWithoutBackground="true"/>
            </LinearLayout>
            <View
                android:id="@+id/header_background"
                android:background="@color/primary_variant"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/button_close"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/on_color_primary"
                android:id="@+id/title"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/header_background"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/header_background"
                style="@style/DisplaySmall"/>
            <ImageView
                android:id="@+id/button_close"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_close"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/header_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/header_background"
                app:tint="@color/on_color_primary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <View
        android:id="@+id/empty_space"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
