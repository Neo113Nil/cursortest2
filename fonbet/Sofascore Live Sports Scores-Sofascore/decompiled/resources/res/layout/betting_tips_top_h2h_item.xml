<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">
    <ImageView
        android:id="@+id/sport_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/neutral_default"/>
    <ImageView
        android:id="@+id/first_team_logo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sport_icon"
        app:layout_goneMarginStart="0dp"/>
    <TextView
        android:textColor="@color/secondary_default"
        android:id="@+id/first_team_wins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/first_team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/second_team_name"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        app:layout_constraintTop_toBottomOf="@+id/first_team_wins"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/number_of_draws"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        app:layout_constraintBaseline_toBaselineOf="@+id/first_team_wins"
        app:layout_constraintEnd_toEndOf="@+id/second_team_name"
        app:layout_constraintStart_toStartOf="@+id/first_team_name"
        style="@style/DisplaySmall"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/second_team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewEnd"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintStart_toEndOf="@+id/first_team_name"
        app:layout_constraintTop_toBottomOf="@+id/number_of_draws"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/primary_default"
        android:id="@+id/second_team_wins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/second_team_name"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <ImageView
        android:id="@+id/second_team_logo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
