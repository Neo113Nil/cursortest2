<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/positions_not_available_layout"
        android:background="@drawable/rounded_surface_level_1"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:backgroundTint="@color/surface_1"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <ImageView
            android:id="@+id/field_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_football_terrain_icon"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/primary_default"
            android:ellipsize="end"
            android:id="@+id/text_upper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/players_average_positions"
            android:maxLines="1"
            android:drawablePadding="4dp"
            android:layout_marginStart="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/text_lower"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/field_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/DisplaySmall"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/text_lower"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/play_areas_empty"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/text_upper"
            app:layout_constraintTop_toBottomOf="@+id/text_upper"
            style="@style/BodySmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.cardview.widget.CardView
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/surface_1"
        android:layout_marginHorizontal="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/average_positions_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/players_average_positions"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/DisplayMedium"/>
            <com.sofascore.results.view.typeheader.SegmentedButtonsView
                android:id="@+id/team_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <View
                android:id="@+id/terrain_background_holder"
                android:background="@color/terrain_football_lineups"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/team_selector"/>
            <CheckBox
                android:textColor="@color/on_color_primary"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/average_lineups_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/show_substitutions"
                android:maxLines="1"
                android:layout_centerHorizontal="true"
                android:paddingStart="12dp"
                android:buttonTint="@color/on_color_primary"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintTop_toTopOf="@+id/terrain_background_holder"
                app:layout_goneMarginTop="8dp"
                style="@style/BodyMedium"/>
            <HorizontalScrollView
                android:id="@+id/substitutions_scrollview"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="locale"
                app:layout_constraintTop_toBottomOf="@+id/average_lineups_checkbox">
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/substitutions_container"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layoutDirection="locale"
                    android:paddingHorizontal="16dp"/>
            </HorizontalScrollView>
            <ImageView
                android:id="@+id/average_lineups_heatmap_container"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="@+id/player_container"
                app:layout_constraintEnd_toEndOf="@+id/player_container"
                app:layout_constraintStart_toStartOf="@+id/player_container"
                app:layout_constraintTop_toTopOf="@+id/player_container"/>
            <View
                android:id="@+id/average_lineups_lines_container"
                android:background="@drawable/ic_football_terrain_lines_only"
                android:layout_width="280dp"
                android:layout_height="420dp"
                android:layout_marginTop="8dp"
                android:scaleType="center"
                android:backgroundTint="@color/on_color_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/substitutions_scrollview"/>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/arrow_layout"
                android:layout_width="32dp"
                android:layout_height="144dp"
                android:rotation="180"
                app:layout_constraintBottom_toBottomOf="@+id/average_lineups_lines_container"
                app:layout_constraintEnd_toEndOf="@+id/average_lineups_lines_container"
                app:layout_constraintStart_toStartOf="@+id/average_lineups_lines_container"
                app:layout_constraintTop_toTopOf="@+id/average_lineups_lines_container">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_head"
                    android:layout_centerHorizontal="true"
                    android:rotation="270"
                    app:tint="@color/on_color_secondary"/>
                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="21dp"
                    android:src="@drawable/ic_arrow_neck"
                    android:scaleType="fitXY"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentBottom="true"
                    android:layout_centerInParent="true"
                    app:tint="@color/on_color_secondary"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/player_container"
                android:layout_width="260dp"
                android:layout_height="400dp"
                android:layoutDirection="ltr"
                app:layout_constraintBottom_toBottomOf="@+id/average_lineups_lines_container"
                app:layout_constraintEnd_toEndOf="@+id/average_lineups_lines_container"
                app:layout_constraintStart_toStartOf="@+id/average_lineups_lines_container"
                app:layout_constraintTop_toTopOf="@+id/average_lineups_lines_container"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/selected_player_layout"
                android:background="@drawable/rectangle_24dp_corners"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/surface_P"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/player_container">
                <ImageView
                    android:id="@+id/selected_player_image"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:ellipsize="end"
                        android:id="@+id/selected_player_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textDirection="locale"
                        style="@style/DisplayMedium"/>
                    <TextView
                        android:textColor="@color/n_lv_3"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/selected_player_low_or_no_player_involvement"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/low_player_involvement"
                        android:maxLines="1"
                        android:textDirection="locale"
                        style="@style/AssistiveDefault"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/remove_selected_player_image"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/n_lv_1"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="64dp"
                app:layout_constraintTop_toBottomOf="@+id/average_lineups_lines_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
