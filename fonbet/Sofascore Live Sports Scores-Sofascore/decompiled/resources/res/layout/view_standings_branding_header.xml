<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.branding.BrandingHeaderView
        android:id="@+id/brand_header"
        android:background="@drawable/rectangle_16dp_top_corners_no_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center_horizontal"
        android:id="@+id/brand_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        style="@style/AssistiveDefault"/>
</LinearLayout>
