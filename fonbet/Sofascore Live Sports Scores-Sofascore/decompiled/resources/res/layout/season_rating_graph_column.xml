<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/graph_bar_text_above"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/graph_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_above="@+id/graph_bar_text_below"
        android:layout_marginHorizontal="3dp"
        app:layout_constraintBottom_toTopOf="@+id/graph_bar_text_below"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="top|center_horizontal"
        android:id="@+id/graph_bar_text_below"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:maxLines="1"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/TableSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
