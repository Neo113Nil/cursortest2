<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/surface_1"
    android:paddingTop="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textColor="@color/n_lv_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/team"
        android:layout_toStartOf="@+id/manager_career_ppm"
        android:layout_alignParentStart="true"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/manager_career_ppm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/points_per_match"
        android:layout_marginStart="16dp"
        android:layout_alignParentEnd="true"
        style="@style/BodySmall"/>
</RelativeLayout>
