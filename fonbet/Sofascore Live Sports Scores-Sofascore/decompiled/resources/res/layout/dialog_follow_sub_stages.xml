<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="280dp"
    android:paddingHorizontal="16dp">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:id="@+id/dialog_follow_title"
        android:paddingBottom="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/added_to_favourites"
        android:maxLines="2"
        android:fontFamily="@font/sofascore_sans_medium"
        android:paddingEnd="4dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/n_lv_1"
        android:id="@+id/dialog_follow_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/sofascore_sans_regular"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/dialog_unfollow_all_area"
        android:background="@drawable/ripple_16_dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:paddingVertical="8dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/dialog_unfollow_all_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_notification_deselected_16"
            app:tint="@color/primary_default"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_default"
            android:id="@+id/dialog_unfollow_all_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:layout_marginStart="8dp"
            style="@style/ActionButtonPrimary"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/dialog_follow_checkboxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
