<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_0"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp">
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_chat"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:indeterminate="true"
        android:layout_marginStart="4dp"
        app:indicatorColor="@color/primary_default"
        app:indicatorInset="0dp"
        app:indicatorSize="14dp"
        app:layout_constraintStart_toStartOf="@+id/user_message"
        app:layout_constraintTop_toBottomOf="@+id/user_message"
        app:trackThickness="2dp"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/user_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="viewStart"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumbnail"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_marginStart="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="240dp"
        app:layout_constraintHeight_min="120dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_message"
        app:shapeAppearanceOverlay="@style/RoundedStyle16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
