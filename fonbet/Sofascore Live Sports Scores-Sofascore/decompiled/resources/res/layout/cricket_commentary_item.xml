<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_P"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/text_over_ball"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/text_commentary"
        android:background="@drawable/rectangle_12dp_corners"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/surface_2"
        android:layout_marginVertical="7dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text_over_ball"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodySmallParagraph"/>
</androidx.constraintlayout.widget.ConstraintLayout>
