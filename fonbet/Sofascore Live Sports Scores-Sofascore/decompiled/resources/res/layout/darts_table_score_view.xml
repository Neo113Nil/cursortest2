<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rectangle_16dp_corners"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="104dp"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:backgroundTint="@color/surface_1"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:paddingVertical="8dp">
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/label_pts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="16dp"
        android:text="@string/darts_points_shorts"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/label_legs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="16dp"
        android:text="@string/darts_legs"
        android:maxLines="1"
        android:layout_marginEnd="22dp"
        app:layout_constraintEnd_toStartOf="@+id/label_pts"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/label_sets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="16dp"
        android:text="@string/darts_sets"
        android:maxLines="1"
        android:layout_marginEnd="22dp"
        app:layout_constraintEnd_toStartOf="@+id/label_legs"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TableMedium"/>
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_thickness"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:backgroundTint="@color/n_lv_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label_pts"/>
    <TextView
        android:textColor="@color/live"
        android:gravity="center"
        android:id="@+id/value_points_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="16dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/label_pts"
        app:layout_constraintStart_toStartOf="@+id/label_pts"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/live"
        android:gravity="center"
        android:id="@+id/value_points_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="16dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/label_pts"
        app:layout_constraintStart_toStartOf="@+id/label_pts"
        app:layout_constraintTop_toBottomOf="@+id/value_points_1"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/live"
        android:gravity="center"
        android:id="@+id/value_legs_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/label_legs"
        app:layout_constraintStart_toStartOf="@+id/label_legs"
        app:layout_constraintTop_toTopOf="@+id/value_points_1"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/live"
        android:gravity="center"
        android:id="@+id/value_legs_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/label_legs"
        app:layout_constraintStart_toStartOf="@+id/label_legs"
        app:layout_constraintTop_toTopOf="@+id/value_points_2"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/live"
        android:gravity="center"
        android:id="@+id/value_sets_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/label_sets"
        app:layout_constraintStart_toStartOf="@+id/label_sets"
        app:layout_constraintTop_toTopOf="@+id/value_points_1"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/live"
        android:gravity="center"
        android:id="@+id/value_sets_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/label_sets"
        app:layout_constraintStart_toStartOf="@+id/label_sets"
        app:layout_constraintTop_toTopOf="@+id/value_points_2"
        style="@style/TableMedium"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/name_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:textAlignment="viewStart"
        android:layout_marginEnd="30dp"
        app:drawableTint="@color/live"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/label_sets"
        app:layout_constraintStart_toStartOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/value_points_1"
        style="@style/TableMedium"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/name_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:textAlignment="viewStart"
        app:drawableTint="@color/live"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/name_1"
        app:layout_constraintStart_toStartOf="@+id/name_1"
        app:layout_constraintTop_toTopOf="@+id/value_points_2"
        style="@style/TableMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
