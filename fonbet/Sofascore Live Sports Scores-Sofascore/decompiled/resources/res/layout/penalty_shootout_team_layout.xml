<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/background_view"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:backgroundTint="@color/surface_2"
        app:layout_constraintBottom_toBottomOf="@+id/shots_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/team_logo_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/shots_container"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.sofascore.results.event.details.view.shootout.PenaltiesGridView
            android:id="@+id/first_five_penalties_holder"
            android:layout_width="72dp"
            android:layout_height="wrap_content"/>
        <com.sofascore.results.event.details.view.shootout.PenaltiesGridView
            android:id="@+id/additional_penalties_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="24dp"/>
    </LinearLayout>
    <TextView
        android:gravity="end|center_vertical"
        android:id="@+id/team_score_text"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/players"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="16dp"
        android:layout_marginStart="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shots_container"
        style="@style/BodySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
