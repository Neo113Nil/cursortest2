<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_surface_level_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/community_corner"
        android:textAlignment="center"
        android:layout_marginHorizontal="56dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMedium"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chat_action_layout"
        android:background="@drawable/rounded_surface_level_1"
        android:focusable="true"
        android:clickable="true"
        android:clipToPadding="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="56dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:backgroundTint="@color/surface_2"
        app:layout_constraintEnd_toStartOf="@+id/reputation_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <ImageView
            android:id="@+id/chat_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chat"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_default"/>
        <TextView
            android:id="@+id/chat_action_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/join_the_chat_button"
            android:textDirection="locale"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/chat_action_click"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/chat_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="8dp"
            style="@style/AssistiveDefault"/>
        <TextView
            android:id="@+id/chat_action_dummy_text"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/earn_profile_badges_button"
            android:textDirection="locale"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/chat_action_click"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/chat_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="8dp"
            style="@style/AssistiveDefault"/>
        <ImageView
            android:id="@+id/chat_action_click"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_default"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/reputation_layout"
        android:background="@drawable/rounded_surface_level_1"
        android:focusable="true"
        android:clickable="true"
        android:clipToPadding="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="56dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/surface_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/chat_action_layout"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/reputation_dummy_text"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/join_the_chat_button"
            android:textDirection="locale"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AssistiveDefault"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/no_reputation_score_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/badges_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/icon_info"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_top_contributor_badge_transparent"/>
                <ImageView
                    android:id="@+id/icon_info2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/ic_top_editor_badge_transparent"
                    android:layout_marginStart="10dp"/>
            </FrameLayout>
            <TextView
                android:id="@+id/no_reputation_action_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/earn_profile_badges_button"
                android:textDirection="locale"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:paddingVertical="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/no_reputation_action_click"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/badges_layout"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AssistiveDefault"/>
            <ImageView
                android:id="@+id/no_reputation_action_click"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/primary_default"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/reputation_score_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:gravity="center"
                android:id="@+id/reputation_score"
                android:background="@drawable/circle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:textAlignment="center"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary_highlight"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AssistiveDefault"/>
            <TextView
                android:id="@+id/reputation_action_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/reputation_score"
                android:textDirection="locale"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="24dp"
                android:paddingVertical="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/reputation_action_click"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/reputation_score"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AssistiveDefault"/>
            <ImageView
                android:id="@+id/reputation_action_click"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/primary_default"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/top_contributors_cta"
        android:background="@drawable/rounded_surface_level_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/surface_2"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@+id/chat_action_layout">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_top_contributor_badge"
            android:layout_marginVertical="8dp"/>
        <TextView
            android:textColor="@color/primary_default"
            android:ellipsize="end"
            android:id="@+id/action_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/go_to_top_contributors_button"
            android:maxLines="1"
            android:drawablePadding="8dp"
            android:layout_marginStart="8dp"
            app:drawableEndCompat="@drawable/ic_chevron_right_large_16"
            app:drawableTint="@color/primary_default"
            style="@style/DisplayMicro"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/community_suggestions_layouts"
        android:background="@drawable/rounded_surface_level_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/surface_2"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@+id/top_contributors_cta">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/community_suggestions_disabled"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/info_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_info"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:tint="@color/n_lv_3"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/community_suggestions_pre_match_text"
                android:textDirection="locale"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/info_icon"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AssistiveDefault"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/community_suggestions"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/suggested_result_layout"
                android:background="@drawable/border_corners_4dp_stroke_width_2dp"
                android:padding="8dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/n_lv_4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/suggest_image"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_ball_football"
                    android:layout_marginStart="2dp"
                    app:tint="@color/secondary_default"/>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/suggest_assit_scorer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="2dp"
                    style="@style/DisplayMicro"/>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/suggest_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textDirection="locale"
                    android:layout_marginEnd="4dp"
                    style="@style/DisplayMicro"/>
            </LinearLayout>
            <TextView
                android:ellipsize="end"
                android:id="@+id/community_suggestions_txt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="@string/community_suggestions"
                android:maxLines="2"
                android:textDirection="locale"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/contribute_button"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/suggested_result_layout"
                app:layout_constraintTop_toBottomOf="@+id/suggested_result_layout"
                app:layout_goneMarginStart="16dp"
                app:layout_goneMarginTop="8dp"
                style="@style/AssistiveDefault"/>
            <TextView
                android:textColor="@color/surface_1"
                android:id="@+id/contribute_button"
                android:background="@drawable/rounded_surface_level_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contribute"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/primary_default"
                android:layout_marginVertical="16dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AssistiveDefault"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/rounded_surface_level_1"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/surface_2"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/community_suggestions_layouts">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/editor_cta_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/torneo_promo_text"
            android:drawablePadding="16dp"
            android:textDirection="locale"
            android:drawableTint="@color/primary_default"
            app:drawableStartCompat="@drawable/ic_editor_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DisplayMicro"/>
        <LinearLayout
            android:id="@+id/join_the_team_button"
            android:background="@drawable/rounded_surface_level_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:backgroundTint="@color/primary_default"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/editor_cta_text">
            <TextView
                android:textColor="@color/surface_1"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/torneo_promo_text_button"
                style="@style/AssistiveDefault"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_right_small_16"
                app:tint="@color/surface_1"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
