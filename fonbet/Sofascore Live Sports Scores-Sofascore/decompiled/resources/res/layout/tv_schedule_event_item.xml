<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:paddingTop="8dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="middle"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/sport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodySmall"/>
    <TextView
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/first_team"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="2"
        android:textDirection="locale"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_icon"
        app:layout_constraintEnd_toStartOf="@+id/first_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_icon"
        style="@style/BodyMedium"/>
    <ImageView
        android:id="@+id/first_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/teams_separator"
        app:layout_constraintTop_toBottomOf="@+id/sport"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/teams_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_schedule_separator"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_icon"
        style="@style/BodyMedium"/>
    <ImageView
        android:id="@+id/second_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toEndOf="@+id/teams_separator"
        app:layout_constraintTop_toBottomOf="@+id/sport"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/second_team"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="2"
        android:textDirection="locale"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/second_icon"
        app:layout_constraintTop_toTopOf="@+id/second_icon"
        style="@style/BodyMedium"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/channels_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/second_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
