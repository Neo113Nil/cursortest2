<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/full_color"
        android:background="@color/primary_variant"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/overlay"
        android:background="@drawable/buzzer_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.5"/>
    <View
        android:id="@+id/stats_background"
        android:background="@drawable/buzzer_interesting_statistics_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleX="@integer/drawable_scaleX_normal"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_image"
        app:layout_constraintEnd_toEndOf="@+id/stats_text"
        app:layout_constraintStart_toStartOf="@+id/stats_text"
        app:layout_constraintTop_toTopOf="@+id/player_image"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/on_color_primary"
        android:gravity="end"
        android:id="@+id/stats_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textDirection="locale"
        android:textAlignment="viewEnd"
        android:paddingEnd="8dp"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/player_image"
        app:layout_constraintTop_toTopOf="@+id/player_image"
        style="@style/TableSmall"/>
    <ImageView
        android:id="@+id/player_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="22dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/team_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_image"
        app:layout_constraintStart_toStartOf="@+id/player_image"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/k_ff_90"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/player_name_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:maxLines="1"
        android:fontFamily="@font/sofascore_sans_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/ripple_holder"
        android:background="?attr/selectableItemBackground"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
