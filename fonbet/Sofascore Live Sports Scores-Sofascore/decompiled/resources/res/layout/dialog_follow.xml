<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="312dp"
    android:minWidth="280dp"
    android:paddingHorizontal="16dp">
    <ImageView
        android:id="@+id/dialog_follow_logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/primary_default"
        android:id="@+id/dialog_following_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/notifications_on"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_follow_bell"
        app:layout_constraintStart_toEndOf="@+id/dialog_follow_logo"
        app:layout_constraintTop_toTopOf="@+id/dialog_follow_bell"
        style="@style/DisplayLarge"/>
    <ImageView
        android:id="@+id/dialog_follow_bell"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_notification_active"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/dialog_following_text"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary_default"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/dialog_follow_team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_follow_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/dialog_following_text"
        style="@style/DisplayMedium"/>
    <TextView
        android:id="@+id/dialog_follow_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_follow_logo"
        style="@style/BodyMediumParagraph"/>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/dialog_follow_dont_show_again"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/exit_checkbox"
        app:buttonTint="@color/primary_default"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_follow_text"
        style="@style/BodyMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
