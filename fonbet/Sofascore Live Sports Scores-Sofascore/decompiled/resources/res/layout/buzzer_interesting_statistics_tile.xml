<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/full_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:scaleX="2"
        android:scaleY="2"
        app:shapeAppearanceOverlay="@style/RoundedStyle8dp"/>
    <FrameLayout
        android:id="@+id/gradient"
        android:background="@drawable/buzzer_transparent_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/overlay"
        android:background="@drawable/buzzer_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.5"/>
    <View
        android:id="@+id/statistic_gradient"
        android:background="@drawable/buzzer_interesting_statistics_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleX="@integer/drawable_scaleX_normal"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/statistic_value"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/player_image"
        app:layout_constraintTop_toTopOf="@+id/statistic_value"/>
    <ImageView
        android:id="@+id/player_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/statistic_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewEnd"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/player_image"
        style="@style/DisplayExtraLarge"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="end|top"
        android:id="@+id/statistic_name"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:maxLines="2"
        android:textAlignment="viewEnd"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/player_name_text"
        app:layout_constraintTop_toBottomOf="@+id/statistic_gradient"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/player_name_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/DisplayMicro"/>
    <FrameLayout
        android:id="@+id/ripple_holder"
        android:background="?attr/selectableItemBackground"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
