<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/full_color"
        android:background="@color/primary_variant"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/overlay"
        android:background="@drawable/buzzer_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.5"/>
    <ImageView
        android:id="@+id/player_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/team_logos_holder"
        android:background="@drawable/rounded_surface_level_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-4dp"
        android:layout_marginStart="8dp"
        android:elevation="4dp"
        android:backgroundTint="@color/surface_0"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_image"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/first_team_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <ImageView
            android:id="@+id/second_team_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <com.sofascore.results.view.SofascoreSmallRatingView
        android:id="@+id/player_rating_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-12dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/team_logos_holder"
        app:layout_constraintEnd_toEndOf="@+id/player_image"
        app:small_animateRating="false"
        style="@style/NavigationTabSecondary"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/player_name_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/DisplayMicro"/>
</androidx.constraintlayout.widget.ConstraintLayout>
