<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="48dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_settings_general"
                        style="@style/HeaderSectionTitle"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_notifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/ic_notification_default"
                        app:pcri_LabelText="@string/profile_notifications"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_preferences"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/ic_reorder"
                        app:pcri_LabelText="@string/profile_preferences"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:theme="@style/SwitchStyle"
                        android:textColor="@color/n_lv_1"
                        android:id="@+id/switch_tts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thumb"
                        android:text="@string/text_to_speech"
                        android:drawablePadding="16dp"
                        android:drawableStart="@drawable/ic_text_to_speech"
                        android:textDirection="locale"
                        android:drawableTint="@color/n_lv_1"
                        android:paddingHorizontal="16dp"
                        app:track="@drawable/switch_track"
                        style="@style/BodyMedium"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_account"
                        style="@style/HeaderSectionTitle"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_edit_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/ic_edit"
                        app:pcri_LabelText="@string/profile_edit_profile"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_subscription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/ic_official_checkmark"
                        app:pcri_LabelText="@string/subscription"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_privacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/ic_lock_privacy"
                        app:pcri_LabelText="@string/profile_privacy"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_app"
                        style="@style/HeaderSectionTitle"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/ic_star_empty"
                        app:pcri_LabelText="@string/action_review"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_share"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/ic_menu_list_share"
                        app:pcri_LabelText="@string/share"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_about"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/ic_info"
                        app:pcri_LabelText="@string/about_activity"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/support"
                        style="@style/HeaderSectionTitle"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_faq"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/question_mark"
                        app:pcri_LabelText="@string/sofascore_faq"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/ic_headphones"
                        app:pcri_LabelText="@string/give_us_feedback"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/login_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_login"
                        style="@style/HeaderSectionTitle"/>
                    <com.sofascore.results.profile.view.ProfileClickableRowView
                        android:id="@+id/button_log_out"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:drawableTint="@color/n_lv_1"
                        app:pcri_DrawableResource="@drawable/ic_log_out"
                        app:pcri_LabelText="@string/sign_out_button"
                        app:pcri_showChevron="false"/>
                    <TextView
                        android:textColor="@color/error"
                        android:gravity="center_vertical"
                        android:id="@+id/button_delete_account"
                        android:background="?attr/selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_account"
                        android:drawablePadding="16dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        app:drawableStartCompat="@drawable/ic_delete"
                        app:drawableTint="@color/error"
                        style="@style/BodyMediumParagraph"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/snackbar_anchor"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</FrameLayout>
