<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rectangle_16dp_corners"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:backgroundTint="@color/surface_1"
    android:layout_marginHorizontal="8dp">
    <include
        android:id="@+id/title_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/main_section_left_with_icon"/>
    <com.sofascore.results.view.typeheader.SegmentedButtonsView
        android:id="@+id/team_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/title_header"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/team_selector"/>
    <include
        android:id="@+id/touch_tooltip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/spinner"
        layout="@layout/legend_item_layout"/>
    <com.sofascore.results.view.typeheader.TypeHeaderView
        android:id="@+id/runs_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/spinner"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/graph_top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="touch_tooltip, runs_filter"/>
    <com.sofascore.results.event.details.view.cricket.wagonwheel.CricketWagonWheelGraphView
        android:id="@+id/wagon_wheel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/graph_top_barrier"
        app:layout_constraintWidth_max="304dp"/>
    <com.sofascore.results.event.details.view.tennis.SwitchView
        android:id="@+id/switcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/wagon_wheel"/>
    <include
        android:id="@+id/data_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/switcher"
        layout="@layout/legend_item_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/statistics_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_info"/>
    <com.sofascore.results.redesign.emptystateblocks.GraphicLarge
        android:id="@+id/empty_state"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="24dp"
        app:graphicLargeDrawable="@drawable/wagon_wheel"
        app:graphicLargeSubtitle="@string/wagon_wheel_empty_state"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/team_selector"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/non_empty_state_views"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="wagon_wheel, spinner, statistics_container, switcher"/>
</androidx.constraintlayout.widget.ConstraintLayout>
