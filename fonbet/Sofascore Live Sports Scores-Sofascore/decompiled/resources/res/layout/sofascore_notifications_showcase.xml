<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="@color/surface_P"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12.6sp"
                android:textColor="@color/n_lv_1"
                android:gravity="center_vertical"
                android:id="@+id/label_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/football_goal"
                android:drawablePadding="4dp"
                app:drawableEndCompat="@drawable/ic_goal_incidents"
                app:drawableTint="@color/primary_default"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/BodyMedium"/>
            <TextView
                android:textSize="12.6sp"
                android:textColor="@color/n_lv_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="61&apos;"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/label_goal"
                app:layout_constraintStart_toEndOf="@+id/label_goal"
                style="@style/BodyMedium"/>
            <TextView
                android:textSize="10.8sp"
                android:textColor="@color/n_lv_2"
                android:gravity="center_vertical"
                android:id="@+id/scorer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Luka Modrić"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label_goal"
                style="@style/BodySmall"/>
            <TextView
                android:textSize="10.8sp"
                android:textColor="@color/n_lv_2"
                android:gravity="center_vertical"
                android:id="@+id/game_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Milan 1:0 Bologna"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scorer_name"
                style="@style/BodySmall"/>
            <com.sofascore.results.view.header.TeamLogoView
                android:id="@+id/team_logo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:layout_constraintBottom_toBottomOf="@+id/game_score"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/scorer_name"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="2dp"
        app:cardBackgroundColor="@color/surface_P"
        app:cardCornerRadius="20dp"
        app:cardElevation="4.1dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/primary_default"
                android:id="@+id/label_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sofascore"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@drawable/circle_onboarding_notification"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/BodySmall"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/now"
                android:paddingStart="8dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/label_app_name"
                app:layout_constraintStart_toEndOf="@+id/label_app_name"
                style="@style/BodySmall"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_down_large_16"
                app:layout_constraintBottom_toBottomOf="@+id/label_app_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/label_app_name"
                app:tint="@color/n_lv_3"/>
            <TextView
                android:textColor="@color/n_lv_1"
                android:gravity="center_vertical"
                android:id="@+id/player_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="20dp"
                android:text="Luka Modrić"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label_app_name"
                style="@style/BodyMedium"/>
            <TextView
                android:textColor="@color/n_lv_2"
                android:gravity="center_vertical"
                android:id="@+id/match_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Milan 1:0 Bologna"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/player_name"
                style="@style/BodySmall"/>
            <ImageView
                android:id="@+id/player_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintBottom_toBottomOf="@+id/match_result"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/player_name"/>
            <TextView
                android:textSize="7.33sp"
                android:textColor="@color/on_color_primary"
                android:background="@drawable/rectangle_2dp_corners"
                android:padding="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:text="8.6"
                android:layout_marginStart="-6dp"
                android:backgroundTint="@color/rating_80"
                app:layout_constraintStart_toStartOf="@+id/player_image"
                app:layout_constraintTop_toBottomOf="@+id/player_image"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
