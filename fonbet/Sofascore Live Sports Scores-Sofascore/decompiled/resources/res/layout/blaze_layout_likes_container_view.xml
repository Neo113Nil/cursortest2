<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/blaze_LikeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/blaze_drawable_selector_moment_like"
        android:contentDescription="@string/blaze_accessibility_like_video"
        android:importantForAccessibility="yes"/>
    <com.blaze.blazesdk.custom_views.BlazeTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/blaze_white"
        android:layout_gravity="center"
        android:id="@+id/blaze_likes_count_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
</LinearLayout>
