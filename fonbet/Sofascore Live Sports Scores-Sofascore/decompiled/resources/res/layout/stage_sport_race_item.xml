<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_container"
    android:background="@drawable/rectangle_8dp_corners"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="0dp"
    android:backgroundTint="@color/surface_1"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <ImageView
        android:id="@+id/stage_sport_main_logo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/stage_sport_bell_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stage_sport_bell_button"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/stage_sport_main_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/stage_sport_category_text"
        app:layout_constraintEnd_toStartOf="@+id/stage_sport_vertical_divider"
        app:layout_constraintStart_toEndOf="@+id/stage_sport_main_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="4dp"
        style="@style/BodyLarge"/>
    <ImageView
        android:id="@+id/stage_sport_country_logo"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/stage_sport_category_text"
        app:layout_constraintStart_toStartOf="@+id/stage_sport_main_text"
        app:layout_constraintTop_toTopOf="@+id/stage_sport_category_text"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/stage_sport_category_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/stage_sport_bell_button"
        app:layout_constraintEnd_toEndOf="@+id/stage_sport_main_text"
        app:layout_constraintStart_toEndOf="@+id/stage_sport_country_logo"
        app:layout_constraintTop_toBottomOf="@+id/stage_sport_main_text"
        app:layout_goneMarginStart="0dp"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/stage_sport_vertical_divider"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:contentDescription="@string/picture"
        android:layout_marginVertical="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/stage_sport_bell_button"
        app:layout_constraintEnd_toStartOf="@+id/stage_sport_bell_button"
        app:layout_constraintTop_toTopOf="@+id/stage_sport_bell_button"/>
    <com.sofascore.results.view.BellButton
        android:id="@+id/stage_sport_bell_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/stages_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/stage_sport_bell_button"
        layout="@layout/stage_sport_race_item_substages"/>
    <include
        android:id="@+id/winner_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/stage_sport_bell_button"
        layout="@layout/stage_sport_race_item_winner"/>
</androidx.constraintlayout.widget.ConstraintLayout>
