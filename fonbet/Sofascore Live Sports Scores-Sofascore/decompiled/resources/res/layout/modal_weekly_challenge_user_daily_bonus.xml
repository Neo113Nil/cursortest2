<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:paddingBottom="28dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/n_lv_1"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/weekly_challenge_daily_10x_header"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/odds_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/odds_logo"
            style="@style/DisplayLarge"/>
        <ImageView
            android:id="@+id/odds_logo"
            android:background="@drawable/rectangle_4dp_corners"
            android:visibility="invisible"
            android:layout_width="48dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/weekly_challenge_info_bottom_sheet_daily_10x_intro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_container"
        style="@style/BodyMediumParagraph"/>
    <com.sofascore.results.view.header.TeamLogoView
        android:id="@+id/first_team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toStartOf="@+id/event_date_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/first_team_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/first_team_logo"
        app:layout_constraintStart_toStartOf="@+id/first_team_logo"
        app:layout_constraintTop_toBottomOf="@+id/first_team_logo"
        style="@style/AssistiveMicro"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/event_date_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="88dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo">
        <TextView
            android:textColor="@color/n_lv_1"
            android:id="@+id/primary_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/DisplayMedium"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:id="@+id/secondary_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/AssistiveMicro"/>
    </LinearLayout>
    <com.sofascore.results.view.header.TeamLogoView
        android:id="@+id/second_team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/event_date_container"
        app:layout_constraintTop_toBottomOf="@+id/info"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/second_team_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/second_team_logo"
        app:layout_constraintStart_toStartOf="@+id/second_team_logo"
        app:layout_constraintTop_toBottomOf="@+id/second_team_logo"
        style="@style/AssistiveMicro"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/www_container"
        android:background="@drawable/rectangle_16dp_corners"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/surface_2"
        app:layout_constraintTop_toBottomOf="@+id/first_team_name">
        <TextView
            android:textColor="@color/n_lv_1"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/who_will_win"
            style="@style/DisplayMedium"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <FrameLayout
            android:id="@+id/odds_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/compose_view"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/disclaimer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/www_container"
        style="@style/AssistiveDefault"/>
</androidx.constraintlayout.widget.ConstraintLayout>
