<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/modal_root"
    android:background="@drawable/rectangle_16dp_top_corners_no_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/surface_P">
    <ImageView
        android:id="@+id/background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_alignParentTop="true"
        app:layout_constraintBottom_toBottomOf="@+id/container"
        app:layout_constraintTop_toTopOf="@+id/container"/>
    <ImageView
        android:id="@+id/background_up"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="@+id/container"/>
    <ImageView
        android:id="@+id/background_down"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/container"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/drag_indicator"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0.01dp"
            android:outlineProvider="bounds">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/drag_indicator_view"
                android:background="@drawable/rectangle_2dp_corners"
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/n_lv_4"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/dialog_header"
            android:background="@color/surface_P"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0.01dp">
            <TextView
                android:theme="@style/DisplayLarge"
                android:gravity="start"
                android:id="@+id/dialog_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textAlignment="viewStart"
                android:layout_marginHorizontal="16dp"/>
            <FrameLayout
                android:id="@+id/dialog_title_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/modal_header_bottom_divider"
                android:background="@color/n_lv_4"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/dialog_content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/bottom_container"
            android:background="@color/surface_P"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="24dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/animation_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="48dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
