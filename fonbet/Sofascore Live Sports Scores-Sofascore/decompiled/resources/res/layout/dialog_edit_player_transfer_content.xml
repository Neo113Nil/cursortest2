<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="48dp"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_transfer_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/edit_player_transfer_type"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/transfer_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_transfer_from"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_player_transfer_from"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconDrawable="@drawable/ic_search"
        app:endIconMode="custom"
        app:endIconTint="@color/n_lv_1"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/transfer_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_transfer_to"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_player_transfer_to"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconDrawable="@drawable/ic_search"
        app:endIconMode="custom"
        app:endIconTint="@color/n_lv_1"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/transfer_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_transfer_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_player_transfer_link"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/transfer_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_transfer_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_player_transfer_date"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/transfer_date"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_transfer_until"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_player_transfer_until"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/transfer_until"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_transfer_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <com.sofascore.results.view.SofaTextInputLayout
            android:id="@+id/transfer_price_input_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/edit_player_transfer_price"
            android:layout_weight="1"
            android:layout_marginEnd="14dp"
            android:importantForAutofill="noExcludeDescendants"
            app:layout_constraintEnd_toStartOf="@+id/input_transfer_currency"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.Sofascore.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/transfer_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="flagNoExtractUi"/>
        </com.sofascore.results.view.SofaTextInputLayout>
        <com.sofascore.results.view.SofaTextInputLayout
            android:id="@+id/input_transfer_currency"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/transfer_currency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:dropDownWidth="150dp"/>
        </com.sofascore.results.view.SofaTextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/suggest_changes_note"
        android:paddingVertical="8dp"
        style="@style/AssistiveDefault"/>
</LinearLayout>
