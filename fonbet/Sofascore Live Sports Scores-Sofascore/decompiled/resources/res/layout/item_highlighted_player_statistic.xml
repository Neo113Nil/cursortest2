<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="72dp"
    android:minHeight="88dp"
    android:paddingVertical="8dp">
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/statistic_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAllCaps="true"
        android:textAlignment="center"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveMicro"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/statistics_container"
        android:background="@drawable/bg_sofa_frame_surface_2"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minWidth="56dp"
        android:minHeight="56dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statistic_label">
        <TextView
            android:gravity="center"
            android:id="@+id/statistic_value"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/DisplayLarge"/>
        <TextView
            android:id="@+id/statistic_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
