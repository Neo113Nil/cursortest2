<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="8dp"
    android:paddingVertical="8dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="48dp"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="42dp"
            android:maxLines="1"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_1"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp">
            <TextView
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_marginEnd="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/player_info"
                app:layout_constraintEnd_toStartOf="@+id/icon_barrier"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/DisplayMedium"/>
            <TextView
                android:id="@+id/player_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toTopOf="@+id/additional_player_1_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"
                style="@style/BodyMedium"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:id="@+id/additional_text_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/additional_text_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/additional_player_2_icon"
                app:layout_constraintTop_toTopOf="@+id/additional_player_1_icon"
                style="@style/BodySmall"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:id="@+id/additional_text_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/additional_player_1_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/additional_player_2_icon"
                app:layout_constraintTop_toBottomOf="@+id/additional_text_1"
                style="@style/BodySmall"/>
            <ImageView
                android:id="@+id/additional_player_2_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="-8dp"
                app:layout_constraintBottom_toBottomOf="@+id/additional_player_1_icon"
                app:layout_constraintStart_toEndOf="@+id/additional_player_1_icon"
                app:layout_constraintTop_toTopOf="@+id/additional_player_1_icon"/>
            <ImageView
                android:id="@+id/additional_player_1_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toTopOf="@+id/bottom_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/player_info"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:ellipsize="end"
                android:id="@+id/bottom_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/additional_player_1_icon"
                style="@style/AssistiveDefault"/>
            <ImageView
                android:id="@+id/team_icon"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/player_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/icon_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="team_icon, player_icon"/>
            <ImageView
                android:id="@+id/player_team"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginBottom="-2dp"
                android:layout_marginStart="-2dp"
                app:layout_constraintBottom_toBottomOf="@+id/player_icon"
                app:layout_constraintStart_toStartOf="@+id/player_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
