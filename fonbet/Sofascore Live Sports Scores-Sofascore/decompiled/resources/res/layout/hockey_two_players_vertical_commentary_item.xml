<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="8dp"
    android:paddingVertical="8dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="48dp"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="42dp"
            android:maxLines="1"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_1"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp">
            <TextView
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_marginEnd="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/player_icons"
                app:layout_constraintEnd_toStartOf="@+id/team_icon"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/DisplayMedium"/>
            <FrameLayout
                android:id="@+id/player_icons"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toTopOf="@+id/player_other_icons"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title">
                <ImageView
                    android:layout_gravity="start|top"
                    android:id="@+id/player_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title"/>
                <ImageView
                    android:layout_gravity="bottom|right"
                    android:id="@+id/player_team"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/player_icon"
                    app:layout_constraintEnd_toEndOf="@+id/player_icon"/>
            </FrameLayout>
            <TextView
                android:textSize="12sp"
                android:ellipsize="end"
                android:id="@+id/player_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:maxLines="1"
                android:layout_marginStart="10dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/player_icons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/player_icons"
                app:layout_constraintTop_toTopOf="@+id/player_icons"
                style="@style/BodyMedium"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/player_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="player_icons, player_info"/>
            <FrameLayout
                android:id="@+id/player_other_icons"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/player_icons">
                <ImageView
                    android:layout_gravity="start|top"
                    android:id="@+id/player_other_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title"/>
                <ImageView
                    android:layout_gravity="bottom|right"
                    android:id="@+id/player_other_team"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/player_icon"
                    app:layout_constraintEnd_toEndOf="@+id/player_icon"/>
            </FrameLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/n_lv_3"
                android:ellipsize="end"
                android:id="@+id/player_other_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:maxLines="1"
                android:layout_marginStart="10dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/player_other_icons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/player_other_icons"
                app:layout_constraintTop_toTopOf="@+id/player_other_icons"
                style="@style/BodyMedium"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/player_other_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="player_other_icons, player_other_info"/>
            <ImageView
                android:id="@+id/team_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
