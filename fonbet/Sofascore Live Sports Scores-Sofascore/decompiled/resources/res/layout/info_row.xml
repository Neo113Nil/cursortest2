<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/sofaPrimaryText"
            android:gravity="center_vertical"
            android:id="@+id/text_info_row"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/sofascore_sans_regular"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/info_row_value_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/sofaPrimaryText"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:id="@+id/text_info_row_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/sofascore_sans_regular"/>
            <TextView
                android:textColor="@color/sofaBadgeText_1"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/value_action_button"
                android:background="@drawable/rectangle_16dp_corners"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:minWidth="72dp"
                android:maxLines="1"
                android:textAllCaps="true"
                android:fontFamily="@font/sofascore_sans_medium"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@color/sofaDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
