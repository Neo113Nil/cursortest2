<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="bottom|center_horizontal"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/objectives"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMedium"/>
    <View
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:backgroundTint="@color/surface_2"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_stats_container"
        app:layout_constraintEnd_toEndOf="@+id/second_team_stats_container"
        app:layout_constraintStart_toStartOf="@+id/first_team_stats_container"
        app:layout_constraintTop_toTopOf="@+id/first_team_stats_container"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/first_team_stats_container"
        android:layout_width="168dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <include
            android:id="@+id/objective_first_1"
            layout="@layout/esports_game_objective_item"/>
        <include
            android:id="@+id/objective_first_2"
            layout="@layout/esports_game_objective_item"/>
        <include
            android:id="@+id/objective_first_3"
            layout="@layout/esports_game_objective_item"/>
        <include
            android:id="@+id/objective_first_4"
            layout="@layout/esports_game_objective_item"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/second_team_stats_container"
        android:layout_width="168dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_team_stats_container">
        <include
            android:id="@+id/objective_second_1"
            layout="@layout/esports_game_objective_item"/>
        <include
            android:id="@+id/objective_second_2"
            layout="@layout/esports_game_objective_item"/>
        <include
            android:id="@+id/objective_second_3"
            layout="@layout/esports_game_objective_item"/>
        <include
            android:id="@+id/objective_second_4"
            layout="@layout/esports_game_objective_item"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
