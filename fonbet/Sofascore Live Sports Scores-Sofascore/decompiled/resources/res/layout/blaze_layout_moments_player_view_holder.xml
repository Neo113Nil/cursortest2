<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blaze_fragment_moments_rootContainer"
    android:background="@color/blaze_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/blaze_momentHolderSafeAreaTop"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="0dp"/>
    <FrameLayout
        android:id="@+id/blaze_player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/blaze_preview_image"
        android:background="@color/blaze_black"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_player_container"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"
        app:layout_constraintTop_toTopOf="@+id/blaze_player_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blaze_captionsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_player_container"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"
        app:layout_constraintTop_toTopOf="@+id/blaze_player_container"/>
    <View
        android:id="@+id/blaze_momentFooterGradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/blaze_momentFooterBarrier"/>
    <ProgressBar
        android:id="@+id/blaze_momentsProgressbar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_player_container"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"
        app:layout_constraintTop_toTopOf="@+id/blaze_player_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blaze_interactionContainer"
        android:layout_width="0dp"
        android:layout_height="0dp">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/blaze_interaction_horizontal_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintGuide_percent="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/blaze_interaction_vertical_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintGuide_percent="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/blaze_enrichment_vertical_guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintGuide_percent="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/blaze_enrichment_vertical_guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintGuide_percent="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/blaze_enrichment_horizontal_guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintGuide_percent="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/blaze_enrichment_horizontal_guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintGuide_percent="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:id="@+id/blaze_extraSpaceBelowMomentHeaderBarrier"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        app:layout_constraintTop_toTopOf="@+id/blaze_momentHolderSafeAreaTop"/>
    <View
        android:id="@+id/blaze_momentHeaderGradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_momentHeaderBarrier"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/blaze_momentHeaderBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="blaze_extraSpaceBelowMomentHeaderBarrier"/>
    <com.blaze.blazesdk.custom_views.BlazeTextView
        android:textSize="@dimen/blaze_common_extra_small_text_size"
        android:textStyle="bold"
        android:textColor="@color/blaze_white"
        android:id="@+id/blaze_momentsChip"
        android:background="@color/blaze_moments_live_chip_color"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/blaze_common_medium_margin"
        android:text="LIVE"
        android:layout_marginStart="@dimen/blaze_common_small_margin"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"
        app:layout_constraintTop_toTopOf="@+id/blaze_momentHolderSafeAreaTop"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/blaze_momentsCenterIconsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_player_container"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"
        app:layout_constraintTop_toTopOf="@+id/blaze_player_container">
        <ImageView
            android:id="@+id/blaze_momentsSeekBackwardButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_videos_player_backward_10_sec"
            android:contentDescription="@string/blaze_accessibility_seek_backward"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="24dp"/>
        <ImageView
            android:id="@+id/blaze_momentsPlayPause"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="@dimen/blaze_play_pause_start_side_length"
            android:layout_height="@dimen/blaze_play_pause_start_side_length"
            android:src="@drawable/blaze_drawable_moments_player_play_icon"
            android:contentDescription="@string/blaze_accessibility_play_video"
            android:importantForAccessibility="yes"/>
        <ImageView
            android:id="@+id/blaze_momentsSeekForwardButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/blaze_drawable_ic_videos_player_forward_10_sec"
            android:contentDescription="@string/blaze_accessibility_seek_forward"
            android:importantForAccessibility="yes"
            android:layout_marginStart="24dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/blaze_momentsFastForwardIndicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:src="@drawable/blaze_drawable_ic_videos_player_forward_2x"
        android:contentDescription="@string/blaze_accessibility_fast_forward"
        android:importantForAccessibility="yes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/blaze_momentHolderSafeAreaTop"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/blaze_momentFooterBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="blaze_icons_space_top_for_barrier,blaze_heading_text_space_top_for_barrier"/>
    <Space
        android:id="@+id/blaze_icons_space_top_for_barrier"
        android:layout_width="match_parent"
        android:layout_height="@dimen/blaze_moments_margin_footer_top_component_to_gradient"
        app:layout_constraintBottom_toTopOf="@+id/blaze_momentsIconsContainer"/>
    <Space
        android:id="@+id/blaze_heading_text_space_top_for_barrier"
        android:layout_width="match_parent"
        android:layout_height="@dimen/blaze_moments_margin_footer_top_component_to_gradient"
        app:layout_constraintBottom_toTopOf="@+id/blaze_momentsHeadingTextView"/>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/blaze_momentsIconsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/blaze_common_large_margin"
        app:layout_constraintBottom_toTopOf="@+id/blaze_momentsCta"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container">
        <com.blaze.blazesdk.follow.BlazeFollowEntityView
            android:id="@+id/blaze_momentsFollowEntityView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/blaze_moment_margin_between_bottom_buttons"/>
        <com.blaze.blazesdk.features.shared.ui.BlazeLikesContainerView
            android:id="@+id/blaze_momentsLikesContainerView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/blaze_moment_margin_between_bottom_buttons"/>
        <ImageView
            android:id="@+id/blaze_momentsShareButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/blaze_moment_margin_between_bottom_buttons"
            android:src="@drawable/blaze_drawable_moments_share"
            android:contentDescription="@string/blaze_accessibility_share_video"
            android:importantForAccessibility="yes"/>
        <ImageView
            android:id="@+id/blaze_momentsClosedCaptionsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/blaze_moment_margin_between_bottom_buttons"
            android:src="@drawable/blaze_drawable_selector_moment_captions"
            android:contentDescription="@string/blaze_accessibility_toggle_captions"
            android:importantForAccessibility="yes"/>
    </LinearLayout>
    <com.blaze.blazesdk.custom_views.BlazeTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/blaze_white"
        android:ellipsize="end"
        android:id="@+id/blaze_momentsHeadingTextView"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:maxLines="2"
        android:importantForAccessibility="yes"
        android:layout_marginStart="@dimen/blaze_common_large_margin"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/blaze_momentsBodyTextViewShadingContainer"
        app:layout_constraintEnd_toStartOf="@+id/blaze_momentsIconsContainer"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"/>
    <com.blaze.blazesdk.custom_views.BlazeShadingEdgeLayout
        android:id="@+id/blaze_momentsBodyTextViewShadingContainer"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/blaze_common_large_margin"
        android:layout_marginEnd="32dp"
        app:blaze_shade_bottom="true"
        app:blaze_shade_size_bottom="40dp"
        app:blaze_shade_size_top="40dp"
        app:blaze_shade_top="true"
        app:layout_constraintBottom_toTopOf="@+id/blaze_momentsCta"
        app:layout_constraintEnd_toStartOf="@+id/blaze_momentsIconsContainer"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container">
        <com.blaze.blazesdk.custom_views.BlazeExpandableAndScrollableTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/blaze_white"
            android:id="@+id/blaze_momentsBodyTextView"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"/>
    </com.blaze.blazesdk.custom_views.BlazeShadingEdgeLayout>
    <com.blaze.blazesdk.custom_views.BlazeTextWithIconButton
        android:id="@+id/blaze_momentsCta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/blaze_common_large_margin"
        app:backgroundTint="@null"
        app:blaze_textColor="@color/blaze_moments_cta_text_color"
        app:blaze_textSize="16sp"
        app:blaze_textStyle="bold"
        app:contentPaddingLeft="@dimen/blaze_common_medium_padding"
        app:contentPaddingRight="@dimen/blaze_common_medium_padding"
        app:layout_constraintBottom_toTopOf="@+id/blaze_momentsSeekBar"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"/>
    <com.blaze.blazesdk.custom_views.BlazeDefaultTimeBar
        android:id="@+id/blaze_momentsSeekBar"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:blaze_bar_height="@dimen/blaze_time_bar_height"
        app:blaze_buffered_color="@color/blaze_time_bar_buffered_color"
        app:blaze_played_color="@color/blaze_white"
        app:blaze_scrubber_color="@color/blaze_white"
        app:blaze_scrubber_dragged_size="16dp"
        app:blaze_scrubber_enabled_size="12dp"
        app:blaze_unplayed_color="@color/blaze_time_bar_unplayed_color"
        app:layout_constraintBottom_toBottomOf="@+id/blaze_momentHolderSafeAreaBottom"
        app:layout_constraintEnd_toEndOf="@+id/blaze_player_container"
        app:layout_constraintStart_toStartOf="@+id/blaze_player_container"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/blaze_momentHolderSafeAreaBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
