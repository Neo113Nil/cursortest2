<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ptr_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:paddingBottom="48dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llTeamFormRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/player_age_notice"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.view.FeaturedMatchView
                    android:id="@+id/team_details_featured_match"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.team.details.view.TeamRecentFormView
                    android:id="@+id/team_recent_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.team.details.view.TeamAchievementsView
                    android:id="@+id/team_achievements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.team.details.view.TennisPlayerRankingView
                    android:id="@+id/tennis_player_ranking_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:id="@+id/promotion_banner"
                    android:layout="@layout/view_promotion_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/promotional_offer_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.sofascore.results.featuredtournament.view.PromotionalOffersBannerView
                        android:id="@+id/promotional_offer_banners"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
                <com.sofascore.results.team.details.view.TennisGrandSlamPerformanceView
                    android:id="@+id/tennis_grand_slam_performance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.team.details.view.TennisProfileFactsView
                    android:id="@+id/tennis_profile_facts_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.team.details.view.TennisPrizeFactsView
                    android:id="@+id/tennis_prize_facts_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.team.details.view.TeamSalaryCapInfoView
                    android:id="@+id/team_salary_cap_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.team.details.view.TeamTournamentsInfoView
                    android:id="@+id/team_tournaments_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.team.details.view.TeamInfoView
                    android:id="@+id/team_info_facts_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.view.CardCtaWithTitleView
                    android:id="@+id/team_venue_facts_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.view.SuggestEditView
                    android:id="@+id/team_details_suggest_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sofascore.results.event.details.view.odds.GambleRegulationFooterView
                    android:id="@+id/gamble_regulation_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
