<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/sofaPrimaryText"
            android:gravity="center_vertical"
            android:id="@+id/text_info_with_image"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/sofascore_sans_regular"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:id="@+id/info_with_image_ll_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/image_container_info_with_image"
                android:layout_width="36dp"
                android:layout_height="36dp">
                <ImageView
                    android:id="@+id/image_info_with_image"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/sofaPrimaryText"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/text_info_with_image_value"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:fontFamily="@font/sofascore_sans_regular"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@color/sofaDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
