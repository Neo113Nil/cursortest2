<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">
    <ImageView
        android:id="@+id/info_icon"
        android:visibility="visible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/referee_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/average_cards_label"
        app:layout_constraintEnd_toStartOf="@+id/arrow_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/info_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="0dp"
        app:layout_goneMarginStart="0dp"
        style="@style/BodyMedium"/>
    <ImageView
        android:id="@+id/referee_country"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_flag_placeholder"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/referee_name"
        app:layout_constraintStart_toEndOf="@+id/referee_name"
        app:layout_constraintTop_toTopOf="@+id/referee_name"/>
    <ImageView
        android:id="@+id/arrow_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right_large_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary_default"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/average_cards_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:text="@string/average_cards"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/red_cards_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/referee_name"
        app:layout_constraintTop_toBottomOf="@+id/referee_name"
        app:layout_goneMarginEnd="0dp"
        style="@style/BodyMedium"/>
    <ImageView
        android:id="@+id/red_cards_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_card_red_16"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/average_cards_label"
        app:layout_constraintEnd_toStartOf="@+id/red_cards_label"
        app:layout_constraintStart_toEndOf="@+id/average_cards_label"
        app:layout_constraintTop_toTopOf="@+id/average_cards_label"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/red_cards_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/yellow_cards_icon"
        app:layout_constraintStart_toEndOf="@+id/red_cards_icon"
        app:layout_constraintTop_toTopOf="@+id/average_cards_label"
        app:layout_goneMarginEnd="0dp"
        style="@style/BodyMedium"/>
    <ImageView
        android:id="@+id/yellow_cards_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_card_yellow_16"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/average_cards_label"
        app:layout_constraintEnd_toStartOf="@+id/yellow_cards_label"
        app:layout_constraintStart_toEndOf="@+id/red_cards_label"
        app:layout_constraintTop_toTopOf="@+id/average_cards_label"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/yellow_cards_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/arrow_icon"
        app:layout_constraintStart_toEndOf="@+id/yellow_cards_icon"
        app:layout_constraintTop_toTopOf="@+id/average_cards_label"
        app:layout_goneMarginEnd="0dp"
        style="@style/BodyMedium"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/cards_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="average_cards_label, red_cards_icon, red_cards_label, yellow_cards_icon, yellow_cards_label"/>
</androidx.constraintlayout.widget.ConstraintLayout>
