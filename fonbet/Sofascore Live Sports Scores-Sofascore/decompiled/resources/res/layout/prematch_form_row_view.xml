<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <TextView
        android:id="@+id/rank_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="16dp"
        android:includeFontPadding="true"
        android:textAlignment="center"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/team_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <ImageView
        android:id="@+id/team_logo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/team_rating"
        app:layout_constraintStart_toEndOf="@+id/rank_column"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="16dp"/>
    <com.sofascore.results.view.SofascoreRatingView
        android:id="@+id/team_rating"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="56dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_1"
        app:layout_constraintStart_toEndOf="@+id/team_logo"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_1"
        android:background="@drawable/rectangle_32dp_corners_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:minHeight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="1dp"
        android:backgroundTint="@color/neutral_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_2"
        app:layout_constraintStart_toEndOf="@+id/team_rating"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_1"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_1"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_2"
        android:background="@color/neutral_default"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:minHeight="16dp"
        android:textAlignment="center"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/standings_form_1"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_3"
        app:layout_constraintStart_toEndOf="@+id/standings_form_1"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_2"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_2"
        app:layout_constraintTop_toTopOf="@+id/standings_form_2"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_3"
        android:background="@color/neutral_default"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:minHeight="16dp"
        android:textAlignment="center"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/standings_form_1"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_4"
        app:layout_constraintStart_toEndOf="@+id/standings_form_2"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_3"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_3"
        app:layout_constraintTop_toTopOf="@+id/standings_form_3"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_4"
        android:background="@color/neutral_default"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:minHeight="16dp"
        android:textAlignment="center"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/standings_form_1"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_5"
        app:layout_constraintStart_toEndOf="@+id/standings_form_3"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_4"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_4"
        app:layout_constraintTop_toTopOf="@+id/standings_form_4"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_5"
        android:background="@color/neutral_default"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:minHeight="16dp"
        android:textAlignment="center"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/standings_form_1"
        app:layout_constraintEnd_toStartOf="@+id/standings_form_6"
        app:layout_constraintStart_toEndOf="@+id/standings_form_4"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/indicator_5"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_hockey_ot_loss"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toEndOf="@+id/standings_form_5"
        app:layout_constraintTop_toTopOf="@+id/standings_form_5"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/standings_form_6"
        android:background="@drawable/rectangle_32dp_corners_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:minHeight="16dp"
        android:text="?"
        android:textAlignment="center"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/neutral_default"
        app:layout_constraintBottom_toBottomOf="@+id/standings_form_1"
        app:layout_constraintEnd_toStartOf="@+id/team_points"
        app:layout_constraintStart_toEndOf="@+id/standings_form_5"
        app:layout_constraintTop_toTopOf="@+id/standings_form_1"
        style="@style/DisplayMicro"/>
    <TextView
        android:id="@+id/team_points"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:includeFontPadding="true"
        android:textAlignment="center"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
</androidx.constraintlayout.widget.ConstraintLayout>
