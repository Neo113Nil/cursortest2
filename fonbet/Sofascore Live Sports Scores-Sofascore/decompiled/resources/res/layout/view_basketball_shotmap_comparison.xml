<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttons"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/shot_map_percentage_image"
            android:background="@drawable/circle"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_graph_percent"
            android:layout_marginEnd="4dp"/>
        <ImageView
            android:id="@+id/shot_map_difference_image"
            android:background="@drawable/circle"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_graph_difference"
            android:layout_marginHorizontal="28dp"/>
        <ImageView
            android:id="@+id/shot_map_total_shots_image"
            android:background="@drawable/circle"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_graph_basketball"/>
    </LinearLayout>
    <com.sofascore.results.view.graph.BasketballShotmapPlayAreasGraphSmall
        android:id="@+id/graph1"
        android:layout_width="168dp"
        android:layout_height="158dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/graph2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttons"/>
    <com.sofascore.results.view.graph.BasketballShotmapPlayAreasGraphSmall
        android:id="@+id/graph2"
        android:layout_width="168dp"
        android:layout_height="158dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/graph1"
        app:layout_constraintTop_toTopOf="@+id/graph1"/>
    <include
        android:id="@+id/shot_map_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/graph1"
        layout="@layout/shot_map_comparison_description_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
