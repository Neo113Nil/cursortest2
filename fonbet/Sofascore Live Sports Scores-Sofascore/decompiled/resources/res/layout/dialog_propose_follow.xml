<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="280dp">
    <ImageView
        android:id="@+id/logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/top_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/logo"
        app:layout_constraintTop_toTopOf="@+id/logo"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DisplayMedium"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/bottom_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/mma_follow_organisation_popup_title"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/logo"
        app:layout_constraintTop_toBottomOf="@+id/top_label"
        app:layout_goneMarginTop="0dp"
        style="@style/DisplayLarge"/>
    <TextView
        android:id="@+id/body_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="viewStart"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/logo"
        app:layout_constraintTop_toBottomOf="@+id/logo"
        style="@style/BodyMedium"/>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:ellipsize="end"
        android:id="@+id/do_not_show_again_checkbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/exit_checkbox"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="-6dp"
        android:paddingHorizontal="12dp"
        app:buttonTint="@color/primary_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/body_text"
        style="@style/BodyMedium"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:constraint_referenced_ids="no_thanks_button,follow_button"
        app:flow_horizontalBias="1"
        app:flow_horizontalGap="16dp"
        app:flow_horizontalStyle="packed"
        app:flow_verticalGap="8dp"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/do_not_show_again_checkbox"/>
    <TextView
        android:textColor="@color/primary_default"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/no_thanks_button"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/no_thanks"
        android:textAllCaps="true"
        android:paddingHorizontal="16dp"
        style="@style/ActionButtonPrimary"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/surface_1"
        android:ellipsize="end"
        android:id="@+id/follow_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/follow"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textAllCaps="true"
        android:drawableEnd="@drawable/ic_notification_deselected"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:backgroundTint="@color/primary_default"
        app:drawableTint="@color/surface_1"
        style="@style/ActionButtonPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
