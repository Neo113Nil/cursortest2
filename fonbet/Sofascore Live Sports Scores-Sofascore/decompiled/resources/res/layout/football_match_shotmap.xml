<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.typeheader.SegmentedButtonsView
        android:id="@+id/team_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/graphs_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/team_selector"
        layout="@layout/football_shot_graphs_layout"/>
    <ImageView
        android:id="@+id/sofascore_watermark"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_watermark_sofascore"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="@+id/graphs_card"
        app:layout_constraintTop_toTopOf="@+id/graphs_card"
        app:tint="@color/n_lv_4"/>
    <include
        android:id="@+id/footer_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/graphs_card"
        layout="@layout/football_shotmap_statistics_header_view"/>
    <com.sofascore.results.redesign.emptystateblocks.GraphicLarge
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:graphicLargeDrawable="@drawable/match_shotmap"
        app:graphicLargeSubtitle="@string/message_match_shotmap"
        app:layout_constraintTop_toBottomOf="@+id/team_selector"/>
</androidx.constraintlayout.widget.ConstraintLayout>
