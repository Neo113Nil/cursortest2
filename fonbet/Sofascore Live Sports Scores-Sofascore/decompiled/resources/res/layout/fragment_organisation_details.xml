<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ptr_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:paddingTop="4dp"
        android:paddingBottom="48dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_layout"
            android:background="@color/surface_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">
            <com.sofascore.results.mma.organisation.details.view.MmaOrganisationFeaturedEventView
                android:id="@+id/featured_event_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.sofascore.results.view.facts.MmaOrganisationInfoView
                android:id="@+id/info_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
