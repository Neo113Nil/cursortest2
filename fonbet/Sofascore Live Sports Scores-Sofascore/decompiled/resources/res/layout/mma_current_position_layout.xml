<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp">
    <TextView
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/mma_current_fighting_position"
        android:maxLines="1"
        style="@style/DisplayMedium"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="32dp"
        android:backgroundTint="@color/surface_2"
        android:paddingHorizontal="8dp">
        <ImageView
            android:id="@+id/start_glove_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_mma"
            android:rotationY="@integer/rtl_rotation"
            app:tint="@color/red_fighter_default"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/position_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            style="@style/BodyMedium"/>
        <ImageView
            android:id="@+id/end_glove_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_mma"
            android:rotationY="@integer/rtl_rotation_inverse"
            app:tint="@color/blue_fighter_default"/>
    </LinearLayout>
</LinearLayout>
