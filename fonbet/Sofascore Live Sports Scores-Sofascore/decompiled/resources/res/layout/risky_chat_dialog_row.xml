<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="56dp"
        android:maxLines="2"
        android:layout_marginEnd="8dp"
        style="@style/BodySmall"/>
    <View
        android:layout_gravity="center_vertical"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="8dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/home_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:id="@+id/home_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/BodyMedium"/>
            <ImageView
                android:id="@+id/home_red_card_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_card_red_16"
                android:contentDescription="@string/picture"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:id="@+id/home_red_card_count"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BodySmall"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/away_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <TextView
                android:ellipsize="end"
                android:id="@+id/away_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/BodyMedium"/>
            <ImageView
                android:id="@+id/away_red_card_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_card_red_16"
                android:contentDescription="@string/picture"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:id="@+id/away_red_card_count"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BodySmall"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
