<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/rating_layout"
            layout="@layout/statistic_avg_rating"/>
        <View
            android:id="@+id/graph_background"
            android:background="@drawable/rounded_surface_level_1"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/surface_2"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toTopOf="@+id/info_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rating_layout"/>
        <View
            android:id="@+id/average_rating_line"
            android:layout_width="1dp"
            android:layout_height="2dp"
            android:layout_marginTop="100dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintStart_toStartOf="@+id/graph_background"
            app:layout_constraintTop_toTopOf="@+id/graph_container"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/graph_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/graph_background"
            app:layout_constraintEnd_toStartOf="@+id/button_next"
            app:layout_constraintStart_toEndOf="@+id/button_previous"
            app:layout_constraintTop_toTopOf="@+id/graph_background">
            <include layout="@layout/player_last_ratings_item"/>
            <include layout="@layout/player_last_ratings_item"/>
            <include layout="@layout/player_last_ratings_item"/>
            <include layout="@layout/player_last_ratings_item"/>
            <include layout="@layout/player_last_ratings_item"/>
        </LinearLayout>
        <com.sofascore.results.view.graph.RatingColorLegendView
            android:layout_width="6dp"
            android:layout_height="72dp"
            android:layout_marginBottom="18dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/graph_background"
            app:layout_constraintEnd_toEndOf="@+id/graph_background"/>
        <ImageView
            android:id="@+id/button_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_chevron_left"
            app:layout_constraintStart_toStartOf="@+id/graph_background"
            app:layout_constraintTop_toTopOf="@+id/graph_background"
            app:tint="@color/chat_button_selector_color"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/button_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintEnd_toEndOf="@+id/graph_background"
            app:layout_constraintTop_toTopOf="@+id/graph_background"
            app:tint="@color/chat_button_selector_color"/>
        <com.sofascore.results.view.InformationView
            android:id="@+id/info_container"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/graph_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
