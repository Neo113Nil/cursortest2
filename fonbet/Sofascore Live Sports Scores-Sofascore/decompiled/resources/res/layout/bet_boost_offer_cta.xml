<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start|center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp">
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/offer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bet_boost_special_offer"
        android:layout_marginStart="8dp"
        style="@style/DisplayMicro"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/rounded_surface_level_2"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:elevation="2dp"
        android:backgroundTint="@color/surface_1"
        android:layout_marginHorizontal="8dp">
        <ImageView
            android:id="@+id/bet_boost_provider_logo"
            android:background="@drawable/rectangle_4dp_corners"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:backgroundTint="@color/bet365_green"/>
        <TextView
            android:textColor="@color/n_lv_1"
            android:id="@+id/offer_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:layout_marginHorizontal="12dp"
            style="@style/BodySmall"/>
        <TextView
            android:textColor="@color/surface_1"
            android:id="@+id/register_btn"
            android:background="@drawable/rectangle_16dp_corners"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/claim_reward_button"
            android:backgroundTint="@color/primary_default"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            style="@style/BodySmall"/>
    </LinearLayout>
</LinearLayout>
