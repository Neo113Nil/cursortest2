<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/rounded_surface_level_1"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <TextView
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/tennis_tournament_stats_title"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        style="@style/DisplayMedium"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/statistics_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/compare_button"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:minHeight="24dp"
        android:text="@string/button_compare_more_stats"
        android:backgroundTint="@color/primary_default"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/team_icon_2"
        app:layout_constraintStart_toEndOf="@+id/team_icon_1"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
</LinearLayout>
