<?xml version="1.0" encoding="utf-8"?>
<com.sofascore.results.view.DividerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:dividerPosition="top">
    <include
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/missing_players_note"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingVertical="12dp"
        layout="@layout/missing_player_note"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/missing_players_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.sofascore.results.view.DividerLinearLayout>
