<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:paddingVertical="4dp">
    <View
        android:id="@+id/highlight"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/time_upper"
        android:nextFocusLeft="@+id/time_lower"
        android:nextFocusRight="@+id/time_lower"
        android:nextFocusUp="@+id/time_lower"
        android:nextFocusDown="@+id/time_lower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:nextFocusForward="@+id/time_lower"
        android:textDirection="ltr"
        android:layout_marginHorizontal="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/time_lower"
        app:layout_constraintEnd_toStartOf="@+id/vertical_guideline_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/BodySmall"/>
    <com.sofascore.results.view.EventListScoreTextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/time_lower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:accessibilityTraversalAfter="@+id/time_upper"
        android:layout_marginHorizontal="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintEnd_toStartOf="@+id/vertical_guideline_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_upper"
        app:styleVariant="status"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/vertical_guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="72dp"/>
    <ImageView
        android:id="@+id/first_team_logo"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_name"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline_start"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/first_team_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="16dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/second_team_name"
        app:layout_constraintEnd_toStartOf="@+id/action_layout"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="8dp"
        style="@style/BodyMedium"/>
    <ImageView
        android:id="@+id/second_team_logo"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline_start"
        app:layout_constraintTop_toTopOf="@+id/second_team_name"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/second_team_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:minHeight="16dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toStartOf="@+id/action_layout"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/second_team_logo"
        app:layout_constraintTop_toBottomOf="@+id/first_team_name"
        app:layout_goneMarginBottom="6dp"
        app:layout_goneMarginEnd="8dp"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/live"
        android:ellipsize="end"
        android:id="@+id/description"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_layout"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/second_team_name"
        app:layout_goneMarginEnd="8dp"
        style="@style/BodySmall"/>
    <include
        android:id="@+id/action_layout"
        android:layout_width="56dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/second_team_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/first_team_name"
        layout="@layout/event_row_end_action"/>
</androidx.constraintlayout.widget.ConstraintLayout>
