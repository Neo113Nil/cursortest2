<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/CrowdsourcingTimePickerStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <NumberPicker
        android:id="@+id/hour_spinner"
        android:layout_width="wrap_content"
        android:layout_height="108dp"
        app:layout_constraintEnd_toStartOf="@+id/minute_spinner"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/hour_center"
        android:layout_width="1dp"
        android:layout_height="10dp"
        app:layout_constraintEnd_toEndOf="@+id/hour_spinner"
        app:layout_constraintStart_toStartOf="@+id/hour_spinner"
        app:layout_constraintTop_toTopOf="parent"/>
    <NumberPicker
        android:id="@+id/minute_spinner"
        android:layout_width="wrap_content"
        android:layout_height="108dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/hour_spinner"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/minute_center"
        android:layout_width="1dp"
        android:layout_height="10dp"
        app:layout_constraintEnd_toEndOf="@+id/minute_spinner"
        app:layout_constraintStart_toStartOf="@+id/minute_spinner"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/rounded_surface_level_1"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:backgroundTint="@color/n_lv_5"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/hour_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/hour_spinner"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crowdsourcing_dialog_hour"
        android:includeFontPadding="true"
        android:layoutDirection="ltr"
        android:layout_marginStart="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/hour_spinner"
        app:layout_constraintStart_toStartOf="@+id/hour_center"
        app:layout_constraintTop_toTopOf="@+id/hour_spinner"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crowdsourcing_dialog_minute"
        android:includeFontPadding="true"
        android:layoutDirection="ltr"
        android:layout_marginStart="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/minute_spinner"
        app:layout_constraintStart_toStartOf="@+id/minute_center"
        app:layout_constraintTop_toTopOf="@+id/minute_spinner"
        style="@style/AssistiveDefault"/>
</androidx.constraintlayout.widget.ConstraintLayout>
