<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/floating_button_root"
    android:background="@drawable/fab_background"
    android:visibility="invisible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="48dp"
    android:minHeight="48dp"
    style="@style/ElevationStyle">
    <TextView
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/action_text_upper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/DisplayMedium"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/action_text_lower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/AssistiveDefault"/>
</LinearLayout>
