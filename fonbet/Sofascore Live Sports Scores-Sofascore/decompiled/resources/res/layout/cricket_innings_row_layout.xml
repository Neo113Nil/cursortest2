<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/card_container"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/background_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/team_indicator"
        android:visibility="visible"
        android:layout_width="4dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/item_section_order"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/player_name_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_name_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_1"
        app:layout_constraintStart_toEndOf="@+id/item_section_order"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="132dp"
        app:layout_goneMarginStart="16dp">
        <TextView
            android:theme="@style/TableMedium"
            android:textColor="@color/n_lv_1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/item_player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAlignment="viewStart"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/item_additional_row_1"
            app:layout_constraintEnd_toStartOf="@+id/player_live_indicator"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:id="@+id/player_live_indicator"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/item_player_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_player_name"
            app:layout_constraintTop_toTopOf="@+id/item_player_name"/>
        <TextView
            android:theme="@style/TableMedium"
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/item_additional_row_1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/item_additional_row_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_player_name"/>
        <TextView
            android:theme="@style/TableMedium"
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/item_additional_row_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_additional_row_1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/player_name_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_4"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_5"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_6"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_7"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_7"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/end_margin_guideline"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="32dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_margin_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
