<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:gravity="center"
        android:id="@+id/ranking_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        app:layout_constraintBottom_toTopOf="@+id/ranking_position_diff"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/success"
        android:gravity="center"
        android:id="@+id/ranking_position_diff"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawablePadding="2dp"
        app:drawableEndCompat="@drawable/ic_position_arrow_up_8_rotate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ranking_position"
        app:layout_constraintStart_toStartOf="@+id/ranking_position"
        app:layout_constraintTop_toBottomOf="@+id/ranking_position"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/ranking_main_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ranking_position"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ranking_secondary_image"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ranking_item_subtitle"
        app:layout_constraintStart_toStartOf="@+id/ranking_item_title"
        app:layout_constraintTop_toTopOf="@+id/ranking_item_subtitle"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/ranking_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/ranking_item_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/ranking_value_1"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/ranking_main_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/ranking_item_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ranking_secondary_image"
        app:layout_constraintTop_toBottomOf="@+id/ranking_item_title"
        style="@style/AssistiveDefault"/>
    <TextView
        android:gravity="end|center_vertical"
        android:id="@+id/ranking_value_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="34dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ranking_item_title"
        app:layout_constraintEnd_toStartOf="@+id/ranking_value_2"
        app:layout_constraintStart_toEndOf="@+id/ranking_item_title"
        app:layout_constraintTop_toTopOf="@+id/ranking_item_title"
        style="@style/TableMedium"/>
    <TextView
        android:gravity="end|center_vertical"
        android:id="@+id/ranking_value_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="34dp"
        app:layout_constraintBottom_toBottomOf="@+id/ranking_item_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ranking_item_title"
        style="@style/TableMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
