<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="280dp"
        android:paddingHorizontal="16dp">
        <TextView
            android:ellipsize="end"
            android:id="@+id/dialog_follow_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:text="@string/added_to_favourites"
            android:maxLines="2"
            style="@style/DisplayLarge"/>
        <TextView
            android:id="@+id/dialog_follow_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            android:layout_marginVertical="8dp"
            style="@style/BodyMediumParagraph"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:ellipsize="end"
            android:id="@+id/dialog_follow_dont_show_again"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/exit_checkbox"
            android:maxLines="2"
            app:buttonTint="@color/primary_default"
            style="@style/BodyMedium"/>
    </LinearLayout>
</ScrollView>
