<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:outlineProvider="none"
    app:cardBackgroundColor="@color/color_user_badge_background"
    app:cardCornerRadius="6dp"
    app:strokeColor="@color/color_user_badge_stroke"
    app:strokeWidth="1dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/badge_icon"
            android:background="@drawable/rectangle_16dp_corners"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:backgroundTint="@color/surface_1"
            app:tint="@color/enabled_text_view_selector"/>
        <TextView
            android:textColor="@color/enabled_text_view_selector"
            android:gravity="center_horizontal"
            android:id="@+id/badge_name"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/BodyMedium"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/selected_icon"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/ic_badge_selected"
        android:layout_marginEnd="6dp"/>
</merge>
