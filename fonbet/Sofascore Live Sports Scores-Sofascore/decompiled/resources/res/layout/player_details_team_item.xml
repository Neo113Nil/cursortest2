<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/team_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/transfer_date"
        app:layout_constraintEnd_toStartOf="@+id/barrier_name_end"
        app:layout_constraintStart_toEndOf="@+id/team_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DisplayMedium"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_name_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="start"
        app:constraint_referenced_ids="national_team_appearances, transfer_amount, from_team_logo"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/transfer_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/transfer_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/team_name"
        app:layout_constraintTop_toBottomOf="@+id/team_name"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/secondary_default"
        android:id="@+id/transfer_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/transfer_type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/secondary_default"
        android:ellipsize="end"
        android:id="@+id/transfer_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/transfer_amount"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/transfer_date"
        app:layout_constraintTop_toBottomOf="@+id/transfer_amount"
        style="@style/BodySmall"/>
    <TextView
        android:id="@+id/national_team_appearances"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/team_name"
        style="@style/BodyMedium"/>
    <TextView
        android:id="@+id/national_team_goals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/team_name"
        style="@style/BodyMedium"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/national_team_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="national_team_appearances, national_team_goals"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/transfer_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="future_transfer_date, transfer_type"/>
    <ImageView
        android:id="@+id/from_team_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/arrow"
        app:layout_constraintEnd_toStartOf="@+id/arrow"
        app:layout_constraintTop_toTopOf="@+id/arrow"/>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_breadcrumb_16"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintEnd_toStartOf="@+id/to_team_logo"
        app:layout_constraintTop_toTopOf="@+id/team_logo"
        app:tint="@color/n_lv_1"/>
    <ImageView
        android:id="@+id/to_team_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/arrow"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/future_transfer_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/to_team_logo"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/transfer_date"
        app:layout_constraintTop_toBottomOf="@+id/arrow"
        app:layout_constraintWidth_min="64dp"
        style="@style/AssistiveDefault"/>
    <View
        android:id="@+id/future_transfer_clickable_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-4dp"
        android:layout_marginBottom="-4dp"
        android:layout_marginStart="-4dp"
        android:layout_marginEnd="-4dp"
        app:layout_constraintBottom_toBottomOf="@+id/future_transfer_date"
        app:layout_constraintEnd_toEndOf="@+id/to_team_logo"
        app:layout_constraintStart_toStartOf="@+id/from_team_logo"
        app:layout_constraintTop_toTopOf="@+id/from_team_logo"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/future_transfer_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="future_transfer_date, from_team_logo, arrow, to_team_logo, future_transfer_clickable_area"/>
    <com.sofascore.results.redesign.dividers.SofaDivider
        android:id="@+id/bottom_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:dividerVisible="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
