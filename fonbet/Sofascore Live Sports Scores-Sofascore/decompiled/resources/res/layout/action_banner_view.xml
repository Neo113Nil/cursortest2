<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/primary_default"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">
    <TextView
        android:textColor="@color/surface_1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/banner_description_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="2"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/banner_action_text"
        android:background="@drawable/rectangle_16dp_corners_no_color"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:backgroundTint="@color/surface_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"
        style="@style/AssistiveDefault"/>
</LinearLayout>
