<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/full_color"
        android:background="@color/primary_variant"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/overlay"
        android:background="@drawable/buzzer_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.5"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="middle"
        android:gravity="end"
        android:id="@+id/new_ranking_text"
        android:background="@drawable/buzzer_interesting_statistics_gradient"
        android:padding="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAllCaps="true"
        android:textAlignment="viewEnd"
        android:paddingEnd="8dp"
        android:layout_marginStart="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ranking_image"
        app:layout_constraintTop_toTopOf="@+id/ranking_image"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/ranking_diff_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/new_ranking_text"
        style="@style/DisplayMicro"/>
    <ImageView
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_position_arrow_up_8"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/ranking_diff_text"
        app:layout_constraintEnd_toStartOf="@+id/ranking_diff_text"
        app:layout_constraintTop_toTopOf="@+id/ranking_diff_text"
        app:tint="@color/success"/>
    <ImageView
        android:id="@+id/ranking_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ranking_name_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/DisplayMicro"/>
</androidx.constraintlayout.widget.ConstraintLayout>
