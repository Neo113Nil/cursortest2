<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/torso_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/body_zone_men"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/torso_home_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_home_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/transparent"/>
    <ImageView
        android:id="@+id/torso_home_outline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/men_body_outline"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/text_box"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/torso_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/body_zone_men"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/torso_away_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_away_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/transparent"/>
    <ImageView
        android:id="@+id/torso_away_outline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/men_body_outline"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text_box"/>
    <include
        android:id="@+id/text_box"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:layout_marginTop="26dp"
        android:layout_marginStart="-8dp"
        android:layout_marginEnd="-8dp"
        app:layout_constraintEnd_toStartOf="@+id/torso_away_outline"
        app:layout_constraintStart_toEndOf="@+id/torso_home_outline"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/mma_statistics_body_graph_text_container"/>
    <View
        android:background="@color/surface_1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="@+id/torso_home_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_home_outline"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/surface_1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/torso_home_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_home_outline"/>
    <View
        android:background="@color/surface_1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="@+id/torso_away_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_away_outline"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/surface_1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/torso_away_outline"
        app:layout_constraintStart_toStartOf="@+id/torso_away_outline"/>
    <View
        android:background="@color/n_lv_4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/torso_away"
        app:layout_constraintStart_toEndOf="@+id/torso_home"/>
    <View
        android:background="@color/n_lv_4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toStartOf="@+id/torso_away"
        app:layout_constraintStart_toEndOf="@+id/torso_home"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
