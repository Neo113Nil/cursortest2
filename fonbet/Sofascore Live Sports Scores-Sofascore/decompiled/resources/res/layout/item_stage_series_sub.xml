<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/stage_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:textAlignment="viewStart"
        android:layout_marginEnd="8dp"
        android:paddingVertical="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/live_indicator"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/surface_1"
        android:id="@+id/live_indicator"
        android:background="@drawable/rounded_surface_level_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/menu_live"
        android:backgroundTint="@color/live"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/color_live_n_lv_3"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/sub_stage_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:textAlignment="viewStart"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:paddingVertical="2dp"
        app:drawableTint="@color/color_live_n_lv_3"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stage_name"
        app:layout_goneMarginEnd="0dp"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/color_live_n_lv_3"
        android:gravity="start|center_vertical"
        android:id="@+id/winner_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        app:drawableStartCompat="@drawable/ic_trophy_16"
        app:drawableTint="@color/value"
        app:layout_constraintBaseline_toBaselineOf="@+id/sub_stage_info"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/BodySmall"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="winner_name, live_indicator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
