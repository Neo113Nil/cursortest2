<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/provided_by_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bet_boost_header_text"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/bet_boost_provider_logo"
        android:background="@drawable/rectangle_4dp_corners"
        android:layout_width="48dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/bet365_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</LinearLayout>
