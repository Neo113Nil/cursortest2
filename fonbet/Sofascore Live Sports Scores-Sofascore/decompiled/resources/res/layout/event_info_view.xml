<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_surface_level_1"
    android:padding="8dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/team_display_home"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/team_logo_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/home_score"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewEnd"
        app:layout_constraintBottom_toBottomOf="@+id/dash"
        app:layout_constraintStart_toEndOf="@+id/team_display_home"
        app:layout_constraintTop_toTopOf="@+id/dash"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/dash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textAlignment="center"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/team_display_home"
        app:layout_constraintStart_toEndOf="@+id/home_score"
        app:layout_constraintTop_toTopOf="@+id/team_display_home"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/error"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/status"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="4sp"
        android:layout_marginHorizontal="2dp"
        android:autoSizeMaxTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/team_display_home"
        app:layout_constraintEnd_toStartOf="@+id/team_display_away"
        app:layout_constraintStart_toEndOf="@+id/team_display_home"
        app:layout_constraintTop_toTopOf="@+id/team_display_home"
        style="@style/AssistiveDefault"/>
    <TextView
        android:id="@+id/away_score"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="@+id/dash"
        app:layout_constraintStart_toEndOf="@+id/dash"
        app:layout_constraintTop_toTopOf="@+id/dash"
        style="@style/DisplaySmall"/>
    <ImageView
        android:id="@+id/team_display_away"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/team_logo_placeholder"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toEndOf="@+id/away_score"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/date"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textDirection="ltr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dash"
        style="@style/AssistiveDefault"/>
</androidx.constraintlayout.widget.ConstraintLayout>
