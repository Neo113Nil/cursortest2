<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <TextView
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/stat_home"
        android:background="@drawable/rectangle_16dp_corners_no_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="36dp"
        android:minHeight="16dp"
        android:backgroundTint="@color/home_primary"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/surface_1"
        android:gravity="center"
        android:id="@+id/stat_away"
        android:background="@drawable/rectangle_16dp_corners_no_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="36dp"
        android:minHeight="16dp"
        android:backgroundTint="@color/away_primary"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        style="@style/AssistiveDefault"/>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:background="@drawable/rectangle_8dp_corners"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="50"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/event_statistics_progress"
        android:scaleX="@integer/drawable_scaleX_normal"
        android:progressTint="@color/home_primary"
        android:backgroundTint="@color/away_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="36dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="36dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
