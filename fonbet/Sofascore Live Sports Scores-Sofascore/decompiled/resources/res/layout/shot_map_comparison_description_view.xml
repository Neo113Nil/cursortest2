<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/legend"
        android:layout_width="12dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/player_shotmap_color_legend"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/shot_map_description"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/legend"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/legend"
        app:layout_constraintTop_toTopOf="@+id/legend"
        style="@style/AssistiveDefault"/>
    <include
        android:layout_gravity="center_vertical"
        android:id="@+id/shot_map_color_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/legend"
        layout="@layout/legend_item_row"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/tap_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_transfer_swap"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shot_map_color_description"
        app:layout_goneMarginTop="8dp"
        app:tint="@color/secondary_default"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tap_image_shotmap"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tap_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tap_icon"
        app:layout_constraintTop_toTopOf="@+id/tap_icon"
        style="@style/AssistiveDefault"/>
</androidx.constraintlayout.widget.ConstraintLayout>
