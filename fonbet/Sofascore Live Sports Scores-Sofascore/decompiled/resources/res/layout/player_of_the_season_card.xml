<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cup_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_leagues"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/on_color_primary"/>
        <TextView
            android:textColor="@color/on_color_primary"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/cup_logo"
            app:layout_constraintEnd_toStartOf="@+id/info_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/cup_logo"
            app:layout_constraintTop_toTopOf="@+id/cup_logo"
            style="@style/DisplayMedium"/>
        <ImageView
            android:id="@+id/info_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_info"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/on_color_primary"/>
        <ImageView
            android:id="@+id/player_logo"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cup_logo"/>
        <TextView
            android:textColor="@color/on_color_primary"
            android:ellipsize="end"
            android:id="@+id/player_name"
            android:background="@drawable/ripple_16_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/team_name"
            app:layout_constraintEnd_toStartOf="@+id/rating_text"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/player_logo"
            app:layout_constraintTop_toTopOf="@+id/player_logo"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/BodyMedium"/>
        <TextView
            android:textColor="@color/on_color_primary"
            android:ellipsize="end"
            android:id="@+id/team_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="16dp"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/player_logo"
            app:layout_constraintEnd_toStartOf="@+id/rating_text"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/team_logo"
            app:layout_constraintTop_toBottomOf="@+id/player_name"
            style="@style/AssistiveDefault"/>
        <ImageView
            android:id="@+id/team_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/team_name"
            app:layout_constraintStart_toEndOf="@+id/player_logo"
            app:layout_constraintTop_toTopOf="@+id/team_name"/>
        <com.sofascore.results.view.SofascoreRatingView
            android:textColor="@android:color/white"
            android:id="@+id/rating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/player_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/player_logo"
            app:lineColor="@android:color/white"
            style="@style/DisplayLarge"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/bottom_link"
            android:background="@drawable/ripple_16_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/player_logo">
            <TextView
                android:textColor="@color/on_color_primary"
                android:id="@+id/bottom_link_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_more"
                style="@style/DisplaySmall"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right_large_16"
                android:layout_marginStart="5dp"
                app:tint="@color/on_color_primary"/>
        </LinearLayout>
        <View
            android:id="@+id/clickable_area"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cup_logo"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
