<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:paddingStart="16dp"
    android:paddingEnd="6dp">
    <ImageView
        android:id="@+id/player_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/team_logo"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="-6dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_image"
        app:layout_constraintEnd_toEndOf="@+id/player_image"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/player_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:paddingEnd="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/out_marker"
        app:layout_constraintEnd_toStartOf="@+id/column_1"
        app:layout_constraintStart_toEndOf="@+id/player_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_min="108dp"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/error"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/out_marker"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textAlignment="viewStart"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/player_name"
        app:layout_constraintTop_toBottomOf="@+id/player_name"
        style="@style/AssistiveMicro"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/player_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="40dp"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="40dp"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/column_4"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="40dp"/>
    <TextView
        android:theme="@style/TableMedium"
        android:textColor="@color/n_lv_1"
        android:gravity="center"
        android:id="@+id/column_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/column_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="40dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
