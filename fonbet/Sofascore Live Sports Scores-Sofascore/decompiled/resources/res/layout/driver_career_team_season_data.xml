<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_bottom_divider_surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:paddingHorizontal="8dp">
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="middle"
        android:gravity="center_vertical"
        android:id="@+id/season_name_and_ranking"
        android:background="@drawable/rectangle_12dp_corners"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginVertical="12dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constrainedWidth="true"
        style="@style/BodyMedium"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <TextView
        android:gravity="center"
        android:id="@+id/races"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/podiums"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/wins"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/poles"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        style="@style/BodyMedium"/>
</LinearLayout>
