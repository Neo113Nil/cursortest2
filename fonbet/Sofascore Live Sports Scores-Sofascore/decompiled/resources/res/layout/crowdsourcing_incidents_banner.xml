<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginHorizontal="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/rounded_surface_level_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/crowdsourcing_banner_background">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_crowdsourcing"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/on_color_primary"/>
        <TextView
            android:textColor="@color/on_color_primary"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/crowdsourcing_contribute_banner_title"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toEndOf="@+id/subtitle"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"
            style="@style/DisplaySmall"/>
        <TextView
            android:textColor="@color/on_color_secondary"
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/crowdsourcing_contribute_banner_body"
            app:layout_constraintEnd_toStartOf="@+id/t_com_view"
            app:layout_constraintStart_toStartOf="@+id/icon"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/on_color_primary"
            android:id="@+id/contribute"
            android:background="@drawable/rounded_surface_level_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/contribute"
            android:backgroundTint="@color/crowdsourcing"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/icon"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            style="@style/AssistiveDefault"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/t_com_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="0x7f08026f"
            android:rotationY="@integer/rtl_rotation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/RoundedStyle8dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
