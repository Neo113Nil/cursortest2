<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="164dp"
    android:layout_marginBottom="4dp">
    <View
        android:id="@+id/background_color"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/surface_1"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/header_background"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="0dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/tournament_logo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/on_color_secondary"
        android:ellipsize="end"
        android:id="@+id/tournament_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tournament_logo"
        app:layout_constraintEnd_toStartOf="@+id/sofa_logo"
        app:layout_constraintStart_toEndOf="@+id/tournament_logo"
        app:layout_constraintTop_toTopOf="@+id/tournament_logo"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/sofa_logo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_sofascore_logomark"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/on_color_primary"/>
    <ImageView
        android:id="@+id/first_team_logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="44dp"
        android:layout_marginStart="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tournament_logo"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/first_team_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxWidth="120dp"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/first_team_logo"
        app:layout_constraintEnd_toEndOf="@+id/first_team_logo"
        app:layout_constraintStart_toStartOf="@+id/first_team_logo"
        style="@style/DisplayMicro"/>
    <ImageView
        android:id="@+id/second_team_logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tournament_logo"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/second_team_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxWidth="120dp"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/second_team_logo"
        app:layout_constraintEnd_toEndOf="@+id/second_team_logo"
        app:layout_constraintStart_toStartOf="@+id/second_team_logo"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/text_primary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="24dp"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/text_secondary"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        app:layout_constraintTop_toTopOf="@+id/first_team_logo"
        style="@style/DisplayLarge"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/text_secondary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:minHeight="16dp"
        android:maxLines="1"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_team_logo"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/live"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/text_status"
        android:background="@drawable/rectangle_16dp_corners"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:text="@string/standings_live"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:textAllCaps="true"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="6dp"
        app:drawableStartCompat="@drawable/live_circle_4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/live_position_barrier"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        style="@style/AssistiveDefault"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/live_position_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="primary_score_slash, text_primary, text_secondary"/>
    <TextView
        android:textSize="28dp"
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/primary_score_first_team"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:maxLines="1"
        android:lineSpacingExtra="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/primary_score_slash"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        app:layout_constraintTop_toTopOf="@+id/primary_score_slash"
        style="@style/DisplayExtraLarge"/>
    <ImageView
        android:id="@+id/first_team_win_indicator"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_aggregate_pointer"
        app:layout_constraintStart_toEndOf="@+id/primary_score_first_team"
        app:layout_constraintTop_toTopOf="@+id/primary_score_first_team"
        app:tint="@color/on_color_primary"/>
    <TextView
        android:textSize="28dp"
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/primary_score_slash"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:text=" - "
        android:lineSpacingExtra="4dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_text_barrier"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        style="@style/DisplayExtraLarge"/>
    <TextView
        android:textSize="28dp"
        android:textColor="@color/on_color_primary"
        android:gravity="center"
        android:id="@+id/primary_score_second_team"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:maxLines="1"
        android:lineSpacingExtra="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/primary_score_slash"
        app:layout_constraintTop_toTopOf="@+id/primary_score_slash"
        style="@style/DisplayExtraLarge"/>
    <ImageView
        android:id="@+id/second_team_win_indicator"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_aggregate_pointer"
        app:layout_constraintStart_toEndOf="@+id/primary_score_second_team"
        app:layout_constraintTop_toTopOf="@+id/primary_score_second_team"
        app:tint="@color/on_color_primary"/>
    <TextView
        android:textColor="@color/on_color_secondary"
        android:gravity="end|center_vertical"
        android:id="@+id/secondary_score_first_team"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:textDirection="locale"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/secondary_score_slash"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        app:layout_constraintTop_toTopOf="@+id/secondary_score_slash"
        style="@style/BodyLarge"/>
    <TextView
        android:textColor="@color/on_color_secondary"
        android:gravity="center"
        android:id="@+id/secondary_score_slash"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:minWidth="16dp"
        android:minHeight="20dp"
        android:text=" - "
        android:textDirection="locale"
        app:layout_constraintBottom_toTopOf="@+id/time_row"
        app:layout_constraintEnd_toStartOf="@+id/secondary_score_second_team"
        app:layout_constraintStart_toEndOf="@+id/secondary_score_first_team"
        style="@style/BodyLarge"/>
    <TextView
        android:textColor="@color/on_color_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/secondary_score_second_team"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:textDirection="locale"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintStart_toEndOf="@+id/secondary_score_slash"
        app:layout_constraintTop_toTopOf="@+id/secondary_score_slash"
        style="@style/BodyLarge"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/crowdsourcing_live"
        android:gravity="center_horizontal"
        android:id="@+id/crowdsourcing_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:drawablePadding="4dp"
        android:textDirection="locale"
        app:drawableTint="@color/crowdsourcing_live"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/time_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/on_color_secondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/time_row"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:maxLines="1"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/on_color_secondary"
        android:ellipsize="end"
        android:id="@+id/aggregate_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/aggregate_score_barrier"
        app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
        app:layout_constraintStart_toEndOf="@+id/first_team_logo"
        style="@style/BodySmall"/>
    <Space
        android:id="@+id/bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/time_row"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottom_text_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="secondary_score_slash, crowdsourcing_text, bottom_padding, text_secondary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/aggregate_score_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="primary_score_first_team, primary_score_second_team, text_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
