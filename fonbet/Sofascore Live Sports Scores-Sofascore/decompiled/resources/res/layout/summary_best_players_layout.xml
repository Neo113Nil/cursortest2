<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/rounded_surface_level_1"
    android:paddingBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <TextView
        android:gravity="bottom|center_horizontal"
        android:id="@+id/section_title"
        android:paddingBottom="6dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:text="@string/highest_rated_players"
        android:maxLines="1"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMedium"/>
    <include
        android:id="@+id/home_player_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toStartOf="@+id/away_player_1"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/section_title"
        layout="@layout/summary_best_player_row_home"/>
    <include
        android:id="@+id/away_player_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/home_player_1"
        app:layout_constraintTop_toTopOf="@+id/home_player_1"
        layout="@layout/summary_best_player_row_away"/>
    <include
        android:id="@+id/home_player_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toStartOf="@+id/away_player_2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/home_player_1"
        layout="@layout/summary_best_player_row_home"/>
    <include
        android:id="@+id/away_player_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/home_player_2"
        app:layout_constraintTop_toTopOf="@+id/home_player_2"
        layout="@layout/summary_best_player_row_away"/>
    <include
        android:id="@+id/home_player_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toStartOf="@+id/away_player_3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/home_player_2"
        layout="@layout/summary_best_player_row_home"/>
    <include
        android:id="@+id/away_player_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/home_player_3"
        app:layout_constraintTop_toTopOf="@+id/home_player_3"
        layout="@layout/summary_best_player_row_away"/>
</androidx.constraintlayout.widget.ConstraintLayout>
