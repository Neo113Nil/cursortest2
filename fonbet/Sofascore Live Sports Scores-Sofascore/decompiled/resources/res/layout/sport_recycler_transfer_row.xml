<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <ImageView
        android:id="@+id/to_team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_below="@+id/transfer_row_divider_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/transfer_row_divider_layout"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintTop_toBottomOf="@+id/to_team_logo">
        <View
            android:id="@+id/transfer_middle_divider_start"
            android:background="@color/n_lv_4"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/transfer_arrow_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_drop_down"
            android:rotation="180"
            app:tint="@color/n_lv_1"/>
        <View
            android:id="@+id/transfer_middle_divider_end"
            android:background="@color/n_lv_4"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/from_team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/transfer_row_divider_layout"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/transfer_date_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-8dp"
        app:layout_constraintBottom_toTopOf="@+id/transfer_row_divider_layout"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/secondary_default"
        android:id="@+id/transfer_amount_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-8dp"
        app:layout_constraintBottom_toTopOf="@+id/transfer_row_divider_layout"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="middle"
        android:gravity="end"
        android:id="@+id/transfer_type_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-8dp"
        android:singleLine="true"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/transfer_row_divider_layout"
        app:layout_constraintEnd_toStartOf="@+id/transfer_amount_text"
        app:layout_constraintStart_toEndOf="@+id/to_team_logo"
        style="@style/BodySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
