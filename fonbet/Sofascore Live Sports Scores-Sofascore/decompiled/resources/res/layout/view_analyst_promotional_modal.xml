<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/animation_container"
            android:background="@color/stone"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/icon"
                android:background="@drawable/circle"
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_sale_mark"
                android:layout_marginStart="20dp"
                android:backgroundTint="@color/primary_default_10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/animation"
                app:tint="@color/primary_default"/>
            <ImageView
                android:id="@+id/animation"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_analyst_preview"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="100"
            app:indicatorColor="@color/primary_default"
            app:layout_constraintTop_toBottomOf="@+id/animation_container"
            app:trackColor="@color/primary_highlight"/>
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/special_off_season_discount"
            android:textAllCaps="true"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/progress_bar"
            style="@style/AssistiveDefault"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sofascore_analyst_half_price_discount"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            style="@style/DisplayExtraLarge"/>
        <TextView
            android:id="@+id/bullet_point_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawablePadding="8dp"
            android:layout_marginHorizontal="16dp"
            app:drawableStartCompat="@drawable/ic_timeline_dot"
            app:drawableTint="@color/n_lv_1"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:id="@+id/bullet_point_two"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawablePadding="8dp"
            android:layout_marginHorizontal="16dp"
            app:drawableStartCompat="@drawable/ic_timeline_dot"
            app:drawableTint="@color/n_lv_1"
            app:layout_constraintTop_toBottomOf="@+id/bullet_point_one"
            style="@style/BodyMediumParagraph"/>
        <com.google.android.material.button.MaterialButton
            android:ellipsize="end"
            android:id="@+id/next_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/learn_more_button"
            android:maxLines="1"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/bullet_point_two"
            style="@style/ButtonFilledPrimary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
