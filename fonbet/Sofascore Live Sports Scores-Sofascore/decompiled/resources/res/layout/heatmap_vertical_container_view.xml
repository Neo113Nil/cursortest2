<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/field_container"
        android:background="@drawable/rectangle_16dp_corners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:backgroundTint="@color/terrain_football">
        <ImageView
            android:id="@+id/heat_map_arrow_left"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="56dp"
            android:src="@drawable/terrain_arrow"
            android:rotation="180"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/surface_1"/>
        <ImageView
            android:id="@+id/heat_map_arrow_right"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="56dp"
            android:src="@drawable/terrain_arrow"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/surface_1"/>
        <ImageView
            android:id="@+id/heat_map"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/field_lines"
            app:layout_constraintEnd_toEndOf="@+id/field_lines"
            app:layout_constraintStart_toStartOf="@+id/field_lines"
            app:layout_constraintTop_toTopOf="@+id/field_lines"/>
        <ImageView
            android:id="@+id/field_lines"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_football_heatmap_lines_vertical"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/heat_map_arrow_right"
            app:layout_constraintStart_toEndOf="@+id/heat_map_arrow_left"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/surface_1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
