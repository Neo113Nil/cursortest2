<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp">
    <ImageView
        android:id="@+id/team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="middle"
        android:id="@+id/team_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textDirection="locale"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/team_years"
        app:layout_constraintEnd_toStartOf="@+id/races"
        app:layout_constraintStart_toEndOf="@+id/team_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="middle"
        android:id="@+id/team_years"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:layout_alignParentBottom="true"
        android:textDirection="locale"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@+id/races"
        android:layout_alignParentStart="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/races"
        app:layout_constraintStart_toStartOf="@+id/team_name"
        app:layout_constraintTop_toBottomOf="@+id/team_name"
        style="@style/BodyMedium"/>
    <TextView
        android:gravity="center"
        android:id="@+id/races"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minWidth="32dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/poles"
        app:layout_constraintEnd_toStartOf="@+id/podiums"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/podiums"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/poles"
        app:layout_constraintEnd_toStartOf="@+id/wins"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/wins"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/poles"
        app:layout_constraintEnd_toStartOf="@+id/poles"
        style="@style/DisplaySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/poles"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
