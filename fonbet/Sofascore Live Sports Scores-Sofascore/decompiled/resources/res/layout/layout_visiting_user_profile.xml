<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:paddingTop="8dp"
        android:paddingBottom="48dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp">
        <androidx.cardview.widget.CardView
            android:id="@+id/loader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            style="@style/ProfileCardStyle">
            <com.facebook.shimmer.ShimmerFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:background="@drawable/rectangle_4dp_corners"
                        android:layout_width="150dp"
                        android:layout_height="24dp"
                        android:text="@string/weekly_challenge"
                        android:backgroundTint="@color/n_lv_3"
                        style="@style/HeaderSectionTitle"/>
                    <View
                        android:background="@drawable/rectangle_4dp_corners"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/weekly_challenge"
                        android:backgroundTint="@color/n_lv_3"
                        android:layout_marginHorizontal="40dp"
                        style="@style/HeaderSectionTitle"/>
                    <View
                        android:background="@drawable/rectangle_4dp_corners"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/weekly_challenge"
                        android:backgroundTint="@color/n_lv_3"
                        android:layout_marginHorizontal="40dp"
                        style="@style/HeaderSectionTitle"/>
                    <View
                        android:background="@drawable/rectangle_4dp_corners"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/weekly_challenge"
                        android:backgroundTint="@color/n_lv_3"
                        android:layout_marginHorizontal="40dp"
                        style="@style/HeaderSectionTitle"/>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/weekly_challenge"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ProfileCardStyle">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/weekly_challenge"
                    style="@style/HeaderSectionTitle"/>
                <include
                    android:id="@+id/current_league"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    layout="@layout/weekly_challenge_profile_info_view"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:paddingHorizontal="8dp">
                    <include
                        android:id="@+id/current_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        layout="@layout/weekly_challenge_profile_info_view"/>
                    <include
                        android:id="@+id/max_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        layout="@layout/weekly_challenge_profile_info_view"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <com.sofascore.results.profile.view.ProfilePredictionStatisticsView
            android:id="@+id/predictions"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/contributions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/ProfileCardStyle">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/buttonContributionsMore"
                android:background="@drawable/ripple_16_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_crowdsourcing"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/n_lv_1"/>
                <TextView
                    android:textColor="@color/n_lv_1"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_view_contributions"
                    android:layout_weight="1"
                    app:drawableEndCompat="@drawable/ic_chevron_right_large_16"
                    app:drawableTint="@color/primary_default"
                    style="@style/BodyMediumParagraph"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/editor"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/ProfileCardStyle">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_tab_editor"
                    style="@style/HeaderSectionTitle"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp">
                    <com.sofascore.results.profile.editor.ProfileEditorSummaryItemView
                        android:id="@+id/added_matches"
                        android:background="@drawable/rectangle_16dp_corners"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="@color/surface_2"
                        app:esi_LabelText="@string/profile_added_matches"/>
                    <com.sofascore.results.profile.editor.ProfileEditorSummaryItemView
                        android:id="@+id/match_opening"
                        android:background="@drawable/rectangle_16dp_corners"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="@color/surface_2"
                        app:esi_LabelText="@string/profile_match_openings"/>
                </LinearLayout>
                <TextView
                    android:textColor="@color/primary_default"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/button_editor_more"
                    android:background="@drawable/ripple_16_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/profile_view_editor_stats"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    app:drawableEndCompat="@drawable/ic_chevron_right_large_16"
                    app:drawableTint="@color/primary_default"
                    style="@style/AssistiveDefault"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/following"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/ProfileCardStyle">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/favourites"
                    style="@style/HeaderSectionTitle"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/following_recycler_view"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="12dp"
                    style="@style/RecyclerStyle"/>
                <TextView
                    android:textColor="@color/primary_default"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/button_following_more"
                    android:background="@drawable/ripple_16_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/profile_view_favourites"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    app:drawableEndCompat="@drawable/ic_chevron_right_large_16"
                    app:drawableTint="@color/primary_default"
                    style="@style/AssistiveDefault"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
