<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="48dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <TextView
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/weekly_about_streaks"
        app:drawableEndCompat="@drawable/ic_weekly_streak"
        style="@style/DisplayLarge"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/weekly_streaks_starting_losing"
        style="@style/DisplaySmall"/>
    <TextView
        android:id="@+id/weekly_info_bullets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/BodyMediumParagraph"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/weekly_streaks_tracking"
        style="@style/DisplaySmall"/>
    <TextView
        android:id="@+id/weekly_tracking_rivals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/BodyMediumParagraph"/>
</LinearLayout>
