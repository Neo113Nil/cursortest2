<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="16dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/featured_basketball_player_click_area"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="-8dp"
        app:layout_constraintBottom_toBottomOf="@+id/padding_view"
        app:layout_constraintEnd_toEndOf="@+id/clickable_area_end_barrier"
        app:layout_constraintStart_toStartOf="@+id/clickable_area_start_barrier"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedStyle4dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/clickable_area_start_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="featured_basketball_player_name, featured_basketball_player_points"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/clickable_area_end_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="chevron_image, featured_basketball_player_assists_label"/>
    <ImageView
        android:id="@+id/featured_basketball_player_logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/featured_basketball_player_click_area"/>
    <TextView
        android:id="@+id/featured_basketball_player_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toStartOf="@+id/featured_basketball_player_points_label"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/featured_basketball_player_logo"
        style="@style/TableLarge"/>
    <TextView
        android:id="@+id/featured_basketball_player_points_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/basketball_lineups_points"
        android:textAllCaps="true"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/featured_basketball_player_points"
        app:layout_constraintEnd_toStartOf="@+id/featured_basketball_player_rebounds"
        app:layout_constraintStart_toEndOf="@+id/featured_basketball_player_points"
        app:layout_constraintTop_toTopOf="@+id/featured_basketball_player_points"
        style="@style/AssistiveDefault"/>
    <TextView
        android:id="@+id/featured_basketball_player_rebounds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/featured_basketball_player_rebounds_label"
        app:layout_constraintStart_toEndOf="@+id/featured_basketball_player_points_label"
        app:layout_constraintTop_toTopOf="@+id/featured_basketball_player_points"
        style="@style/TableLarge"/>
    <TextView
        android:id="@+id/featured_basketball_player_rebounds_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/basketball_lineups_rebounds"
        android:textAllCaps="true"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/featured_basketball_player_rebounds"
        app:layout_constraintEnd_toStartOf="@+id/featured_basketball_player_assists"
        app:layout_constraintStart_toEndOf="@+id/featured_basketball_player_rebounds"
        app:layout_constraintTop_toTopOf="@+id/featured_basketball_player_rebounds"
        style="@style/AssistiveDefault"/>
    <TextView
        android:id="@+id/featured_basketball_player_assists"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/featured_basketball_player_assists_label"
        app:layout_constraintStart_toEndOf="@+id/featured_basketball_player_rebounds_label"
        app:layout_constraintTop_toTopOf="@+id/featured_basketball_player_points"
        style="@style/TableLarge"/>
    <TextView
        android:id="@+id/featured_basketball_player_assists_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/basketball_lineups_assists"
        android:textAllCaps="true"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/featured_basketball_player_assists"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/featured_basketball_player_assists"
        app:layout_constraintTop_toTopOf="@+id/featured_basketball_player_assists"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/primary_default"
        android:ellipsize="end"
        android:id="@+id/featured_basketball_player_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/chevron_image"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/featured_basketball_player_points"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/chevron_image"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_down"
        android:rotation="@integer/rotate_270_clockwise"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/featured_basketball_player_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/featured_basketball_player_name"
        app:layout_constraintTop_toTopOf="@+id/featured_basketball_player_name"
        app:tint="@color/primary_default"/>
    <View
        android:id="@+id/padding_view"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintTop_toBottomOf="@+id/featured_basketball_player_name"/>
    <com.sofascore.results.view.graph.BasketballShotmapGraph
        android:id="@+id/featured_basketball_player_shot_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/featured_basketball_player_click_area"/>
</androidx.constraintlayout.widget.ConstraintLayout>
