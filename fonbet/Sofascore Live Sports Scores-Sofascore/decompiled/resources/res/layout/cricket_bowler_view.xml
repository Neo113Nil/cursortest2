<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_surface_level_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <include
        android:id="@+id/title_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/main_section_left_with_icon"/>
    <com.sofascore.results.view.typeheader.SegmentedButtonsView
        android:id="@+id/team_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/title_header"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/team_selector"/>
    <include
        android:id="@+id/batter_graph_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinner"
        layout="@layout/cricket_bowler_graph_card"/>
    <include
        android:id="@+id/batter_graph_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/batter_graph_right"
        layout="@layout/cricket_bowler_graph_card"/>
    <View
        android:id="@+id/legend_ball"
        android:background="@color/cricket_neutral"
        android:layout_width="20dp"
        android:layout_height="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/batter_graph_left"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/legend_ball_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cricket_ball_delivery"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/legend_ball"
        app:layout_constraintStart_toEndOf="@+id/legend_ball"
        app:layout_constraintTop_toTopOf="@+id/legend_ball"
        style="@style/AssistiveDefault"/>
    <View
        android:id="@+id/legend_ball_hit"
        android:background="@color/cricket_wickets"
        android:layout_width="20dp"
        android:layout_height="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/legend_ball"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/legend_ball_hit_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cricket_fow_delivery"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/legend_ball_hit"
        app:layout_constraintStart_toEndOf="@+id/legend_ball_hit"
        app:layout_constraintTop_toTopOf="@+id/legend_ball_hit"
        style="@style/AssistiveDefault"/>
    <com.sofascore.results.redesign.emptystateblocks.GraphicLarge
        android:id="@+id/empty_state"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="24dp"
        app:graphicLargeDrawable="@drawable/bowler_graph"
        app:graphicLargeSubtitle="@string/bowler_graph_empty_state"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/team_selector"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/non_empty_state_views"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="batter_graph_left, batter_graph_right, spinner, legend_ball, legend_ball_text, legend_ball_hit, legend_ball_hit_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
