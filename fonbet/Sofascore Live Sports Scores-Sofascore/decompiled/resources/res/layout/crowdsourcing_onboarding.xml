<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:background="@drawable/rectangle_24dp_corners"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="0x7f080271"
            android:adjustViewBounds="true"
            app:shapeAppearance="@style/RoundedStyle16dpTop"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3"
            app:indicatorColor="@color/crowdsourcing"
            app:trackColor="@color/n_lv_5"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp">
            <com.google.android.material.button.MaterialButton
                android:ellipsize="end"
                android:id="@+id/previous_button"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/previous"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                app:strokeWidth="0dp"
                style="@style/ButtonOutlinedCrowdsourcing"/>
            <com.google.android.material.button.MaterialButton
                android:ellipsize="end"
                android:id="@+id/next_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/next"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                style="@style/ButtonFilledCrowdsourcing"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
