<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.google.android.material.appbar.AppBarLayout
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            android:id="@+id/toolbar_holder"
            android:background="@drawable/background_profile_toolbar"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            style="@style/AppBarStyle">
            <include
                android:id="@+id/toolbar"
                layout="@layout/toolbar_title"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <Space
                android:id="@+id/tooltip_anchor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.google.android.material.appbar.AppBarLayout
                android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
                android:id="@+id/app_bar"
                android:background="@drawable/background_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="6dp"
                style="@style/AppBarStyle">
                <com.sofascore.results.view.header.CollapsibleProfileHeaderView
                    android:id="@+id/profile_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"/>
                <include
                    android:id="@+id/upgrade_sofascore_sticky_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/view_profile_sticky_header_upgrade_sofascore"/>
            </com.google.android.material.appbar.AppBarLayout>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/container"
                    android:paddingTop="8dp"
                    android:paddingBottom="48dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_8dp"
                    android:showDividers="middle">
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/referral_compose_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/sofa_season_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <include
                        android:id="@+id/menu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        layout="@layout/view_user_profile_menu"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/support_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        app:cardBackgroundColor="@color/surface_1"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:paddingTop="14dp"
                                android:paddingBottom="6dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/support"
                                android:paddingHorizontal="16dp"
                                style="@style/DisplayMedium"/>
                            <com.sofascore.results.profile.view.ProfileClickableRowView
                                android:id="@+id/faq"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:drawableTint="@color/n_lv_1"
                                app:pcri_DrawableResource="@drawable/question_mark"
                                app:pcri_LabelText="@string/sofascore_faq"/>
                            <com.sofascore.results.profile.view.ProfileClickableRowView
                                android:id="@+id/feedback"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:drawableTint="@color/n_lv_1"
                                app:pcri_DrawableResource="@drawable/ic_headphones"
                                app:pcri_LabelText="@string/give_us_feedback"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <include
                        android:id="@+id/badges_info"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        layout="@layout/user_badges_info_view"/>
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/announcements_view_pager"
                        android:visibility="gone"
                        android:saveEnabled="false"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:overScrollMode="never"/>
                    <com.sofascore.results.view.CirclePageIndicator
                        android:id="@+id/announcement_progress_bar"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:indicatorColor="@color/primary_default"
                        app:layout_constraintTop_toBottomOf="@+id/dialog_header"
                        app:radius="4"
                        app:trackColor="@color/primary_highlight"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <ViewStub
            android:id="@+id/no_internet_view"
            android:layout="@layout/no_internet_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
