<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="32dp"
    android:paddingHorizontal="16dp">
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/label_start_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_weight="1"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/label_new"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/surface_1"
        android:id="@+id/label_new"
        android:background="@drawable/rounded_surface_level_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/new_feature_label"
        android:backgroundTint="@color/primary_default"
        android:layout_marginHorizontal="4dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toStartOf="@+id/label_end_text"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveDefault"/>
    <TextView
        android:gravity="center"
        android:id="@+id/label_end_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:textDirection="ltr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodyMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
