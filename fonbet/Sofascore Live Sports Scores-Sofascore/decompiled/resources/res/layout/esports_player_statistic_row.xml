<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/first_team_statistic_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/neutral_default"/>
    <ImageView
        android:id="@+id/second_team_statistic_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/neutral_default"/>
    <TextView
        android:gravity="center"
        android:id="@+id/diff_text"
        android:background="@drawable/border_corners_8dp_stroke_width_1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:drawablePadding="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AssistiveMicro"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/first_team_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="ltr"
        android:layout_marginHorizontal="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stats_name"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/first_team_statistic_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="4dp"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="start"
        android:id="@+id/stats_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="ltr"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/diff_text"
        app:layout_constraintStart_toStartOf="@+id/diff_text"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:gravity="end"
        android:id="@+id/second_team_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="ltr"
        android:layout_marginHorizontal="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/second_team_statistic_icon"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/stats_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="4dp"
        style="@style/BodyMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
