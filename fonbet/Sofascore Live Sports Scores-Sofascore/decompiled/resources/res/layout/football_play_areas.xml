<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_holder"
    android:background="@color/surface_1"
    android:paddingBottom="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.FootballPlayAreasView
        android:id="@+id/play_areas_total"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        app:layout_constraintDimensionRatio="278:188"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="278dp"/>
    <View
        android:id="@+id/legend_background"
        android:background="@color/terrain_football"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/legend_scale"
        app:layout_constraintEnd_toEndOf="@+id/legend_scale"
        app:layout_constraintStart_toStartOf="@+id/legend_scale"
        app:layout_constraintTop_toTopOf="@+id/legend_scale"/>
    <ImageView
        android:id="@+id/legend_scale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_legend_scale"
        app:layout_constraintEnd_toStartOf="@+id/legend_text"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/play_areas_total"
        app:layout_constraintTop_toBottomOf="@+id/play_areas_total"
        app:tint="@color/value"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/legend_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/legend_scale"
        app:layout_constraintEnd_toEndOf="@+id/play_areas_total"
        app:layout_constraintStart_toEndOf="@+id/legend_scale"
        app:layout_constraintTop_toTopOf="@+id/legend_scale">
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:id="@+id/highest_concentration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/highest_concentration"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/play_areas_total"
            app:layout_constraintStart_toEndOf="@+id/legend_scale"
            app:layout_constraintTop_toTopOf="@+id/legend_scale"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:id="@+id/lowest_concentration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lowest_concentration"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/play_areas_total"
            app:layout_constraintStart_toEndOf="@+id/legend_scale"
            app:layout_constraintTop_toBottomOf="@+id/highest_concentration"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
