<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:padding="8dp"
    android:addStatesFromChildren="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/expand_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            android:layout_marginEnd="16dp"
            app:tint="@color/primary_default"/>
        <ImageView
            android:id="@+id/translate_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"/>
        <ImageView
            android:id="@+id/button_add_flag"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add_flag"
            android:layout_marginEnd="16dp"
            app:tint="@color/chat_button_selector_color"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/upload_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_image"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_default"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/change_layout_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_content_collapse"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_default"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/border_corners_chat_input"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:addStatesFromChildren="true"
            android:descendantFocusability="afterDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <EditText
                android:textColor="@color/n_lv_1"
                android:textColorHint="@color/n_lv_3"
                android:id="@+id/enter_message"
                android:background="@null"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/game_chat_hint"
                android:maxLines="5"
                android:inputType="text"
                android:imeOptions="flagNoExtractUi"
                android:importantForAutofill="no"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/button_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/BodyMedium"/>
            <FrameLayout
                android:id="@+id/button_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <ImageView
                    android:id="@+id/button_send_message"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_send"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/chat_button_selector_color"/>
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/send_progress"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/primary_default"
                    app:indicatorInset="0dp"
                    app:indicatorSize="30dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:trackThickness="3dp"/>
            </FrameLayout>
            <TextView
                android:textColorHint="@color/n_lv_3"
                android:gravity="start|center_vertical"
                android:id="@+id/login_message"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/chat_message_field"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@+id/button_container"
                app:layout_constrainedHeight="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/button_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/BodyMedium"/>
            <View
                android:id="@+id/button_overlay"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignBottom="@+id/enter_message"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/image_preview_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/enter_message">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_preview"
                    android:paddingTop="1dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:scaleType="centerCrop"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp"
                    android:layout_marginEnd="8dp"
                    app:shapeAppearanceOverlay="@style/RoundedStyle4dp"/>
                <ImageView
                    android:layout_gravity="end"
                    android:background="@drawable/ic_remove_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_remove"
                    android:backgroundTint="@color/surface_1"
                    app:tint="@color/error"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
