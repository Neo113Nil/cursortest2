<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/rounded_surface_level_3"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/surface_1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/rounded_surface_level_3"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/n_lv_5">
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/reply_thumbnail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AssistiveDefault"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:id="@+id/replied_message_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/reply_thumbnail"
            app:layout_constraintStart_toStartOf="@+id/user_name"
            app:layout_constraintTop_toBottomOf="@+id/user_name"
            style="@style/BodySmall"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/reply_thumbnail"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:maxHeight="56dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/close"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:shapeAppearanceOverlay="@style/RoundedStyle8dp"/>
        <ImageView
            android:id="@+id/close"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/n_lv_3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
