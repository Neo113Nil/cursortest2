<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="280dp"
        android:paddingHorizontal="16dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/provider_logo"
            android:background="@color/bet365_green"
            android:layout_width="48dp"
            android:layout_height="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/RoundedStyle4dp"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/how_to_watch"
            android:maxLines="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/provider_logo"
            style="@style/DisplayLarge"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/dialog_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/in_partnership"
            app:layout_constraintTop_toBottomOf="@+id/dialog_title"
            style="@style/AssistiveDefault"/>
        <TextView
            android:id="@+id/live_stream_step_1"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/live_stream_continue"
            app:layout_constraintTop_toBottomOf="@+id/dialog_subtitle"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:id="@+id/live_stream_step_2"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/minimum_deposit"
            app:layout_constraintTop_toBottomOf="@+id/live_stream_step_1"
            style="@style/BodyMediumParagraph"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/dialog_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="@string/take_back_deposit"
            app:layout_constraintTop_toBottomOf="@+id/live_stream_step_2"
            style="@style/AssistiveDefault"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
