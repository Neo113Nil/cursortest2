<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginHorizontal="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/event_header_layout"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/first_team_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_flag_placeholder"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/first_team_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/profile_start_time"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/first_team_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginStart="16dp"
            style="@style/DisplayMicro"/>
        <ImageView
            android:id="@+id/second_team_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_flag_placeholder"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/second_team_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/profile_start_time"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="16dp"
            style="@style/DisplayMicro"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/profile_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="100dp"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/first_team_name"
            style="@style/AssistiveDefault"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:barrierMargin="12dp"
            app:constraint_referenced_ids="first_team_logo,second_team_logo,first_team_name,second_team_name,profile_start_time"/>
        <View
            android:id="@+id/barrier_view"
            android:background="@color/n_lv_4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bet_boost_body"
        android:paddingBottom="4dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/event_header_layout">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bet_boosts_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/barrier_view2"
            android:background="@color/n_lv_4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/bet_boosts_container"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/old_odds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/chevron"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_view2"
            style="@style/DisplayMedium"/>
        <ImageView
            android:id="@+id/chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right_large_16"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/old_odds"
            app:layout_constraintEnd_toStartOf="@+id/new_odds"
            app:layout_constraintStart_toEndOf="@+id/old_odds"
            app:layout_constraintTop_toTopOf="@+id/old_odds"
            app:tint="@color/n_lv_3"/>
        <TextView
            android:textColor="@color/primary_default"
            android:id="@+id/new_odds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chevron"
            app:layout_constraintTop_toBottomOf="@+id/barrier_view2"
            app:layout_constraintTop_toTopOf="@+id/old_odds"
            style="@style/DisplayMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
