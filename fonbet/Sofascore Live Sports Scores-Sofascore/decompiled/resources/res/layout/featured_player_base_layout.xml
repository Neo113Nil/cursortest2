<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/rounded_surface_level_1"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <include
        android:id="@+id/featured_player_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/main_section_center_with_icon"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/featured_player_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/best_last_performance"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/featured_player_header"
        style="@style/AssistiveDefault"/>
    <FrameLayout
        android:id="@+id/sport_specific_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/featured_player_subtitle"/>
</LinearLayout>
