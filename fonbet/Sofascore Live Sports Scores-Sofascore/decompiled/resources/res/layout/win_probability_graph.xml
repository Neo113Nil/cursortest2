<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.typeheader.SegmentedButtonsView
        android:id="@+id/quarter_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@+id/info_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/info_icon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="2dp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_info"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/quarter_tabs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/quarter_tabs"
        app:tint="@color/n_lv_1"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/graph_background"
        android:background="@color/n_lv_5"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="28dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/score_graph_top_difference_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quarter_tabs"/>
    <FrameLayout
        android:id="@+id/graph_container"
        android:background="@drawable/rectangle_4dp_corners"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintBottom_toBottomOf="@+id/graph_background"
        app:layout_constraintEnd_toEndOf="@+id/graph_background"
        app:layout_constraintStart_toStartOf="@+id/graph_background"
        app:layout_constraintTop_toTopOf="@+id/graph_background"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/percentage_sign"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/graph_background"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/score_graph_top_difference_text"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/score_graph_top_difference_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toTopOf="@+id/graph_background"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/score_graph_middle_difference_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/graph_background"
        app:layout_constraintStart_toStartOf="@+id/score_graph_top_difference_text"
        app:layout_constraintTop_toTopOf="@+id/graph_background"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/score_graph_bottom_difference_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/graph_background"
        app:layout_constraintStart_toStartOf="@+id/score_graph_top_difference_text"
        style="@style/BodySmall"/>
    <View
        android:id="@+id/gradient_layer"
        android:background="@drawable/gradient_surface_1"
        android:layout_width="112dp"
        android:layout_height="0dp"
        android:scaleX="@integer/drawable_scaleX_normal"
        app:layout_constraintBottom_toBottomOf="@+id/graph_container"
        app:layout_constraintStart_toStartOf="@+id/graph_container"
        app:layout_constraintTop_toTopOf="@+id/graph_container"/>
    <ImageView
        android:id="@+id/first_team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="@+id/graph_container"
        app:layout_constraintTop_toTopOf="@+id/graph_container"/>
    <ImageView
        android:id="@+id/second_team_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/graph_container"
        app:layout_constraintStart_toStartOf="@+id/graph_container"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/first_team_incidents_container"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toTopOf="@+id/graph_container"
        app:layout_constraintEnd_toEndOf="@+id/graph_container"
        app:layout_constraintStart_toStartOf="@+id/graph_container"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/second_team_incidents_container"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="28dp"
        app:layout_constraintEnd_toEndOf="@+id/graph_container"
        app:layout_constraintStart_toStartOf="@+id/graph_container"
        app:layout_constraintTop_toBottomOf="@+id/graph_container"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:id="@+id/view_incidents_tooltip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/am_football_view_incidents"
        app:layout_constraintBottom_toTopOf="@+id/graph_container"
        app:layout_constraintStart_toStartOf="@+id/graph_container"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/start_dot"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/attack_momentum_start_dot"
        android:layout_marginStart="-4dp"
        app:layout_constraintBottom_toBottomOf="@+id/graph_container"
        app:layout_constraintStart_toStartOf="@+id/graph_container"
        app:layout_constraintTop_toBottomOf="@+id/graph_container"/>
    <ImageView
        android:id="@+id/current_time_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/attack_momentum_current_dot"
        android:elevation="2dp"
        app:layout_constraintBottom_toTopOf="@+id/graph_background"
        app:layout_constraintEnd_toEndOf="@+id/current_time_guideline"
        app:layout_constraintStart_toStartOf="@+id/current_time_guideline"
        app:layout_constraintTop_toTopOf="@+id/graph_background"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/current_time_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintGuide_begin="8dp"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/logos_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="first_team_logo, second_team_logo, gradient_layer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
