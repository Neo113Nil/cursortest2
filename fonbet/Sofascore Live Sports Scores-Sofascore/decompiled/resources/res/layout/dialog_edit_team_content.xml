<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="48dp"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_team_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/full_name"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/team_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_team_short_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/short_name"
        app:endIconMode="custom"
        app:endIconTint="@color/n_lv_1"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/team_short_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_team_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_team_image_url"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/team_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_team_coach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_team_coach"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconMode="none"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/team_coach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_team_venue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_team_venue"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconMode="none"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/team_venue"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_update_venue_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_venue_name"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/update_venue_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_venue_capacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/edit_venue_capacity"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:enabled="false"
            android:id="@+id/venue_capacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/suggest_changes_note"
        android:paddingVertical="8dp"
        style="@style/AssistiveDefault"/>
</LinearLayout>
