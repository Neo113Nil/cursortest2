<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/rectangle_16dp_corners"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/primary_default">
    <ImageView
        android:id="@+id/icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        app:tint="@color/surface_1"/>
    <TextView
        android:textColor="@color/surface_1"
        android:id="@+id/snack_bar_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_weight="1"
        android:textDirection="locale"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/surface_T"
        android:id="@+id/action_btn"
        android:background="@drawable/rounded_surface_level_1"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/undo"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        style="@style/AssistiveDefault"/>
</LinearLayout>
