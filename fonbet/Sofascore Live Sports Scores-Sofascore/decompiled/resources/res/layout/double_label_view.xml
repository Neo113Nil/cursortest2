<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lineups_switcher_root"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <TextView
        android:theme="@style/BodyMedium"
        android:ellipsize="end"
        android:id="@+id/lineups_switcher_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="@string/box_score_appearance"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/lineups_switcher_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/lineups_switcher"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:theme="@style/BodySmall"
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/lineups_switcher_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/toggle_detailed_view"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/lineups_switcher_title"
        app:layout_constraintStart_toStartOf="@+id/lineups_switcher_title"
        app:layout_constraintTop_toBottomOf="@+id/lineups_switcher_title"/>
    <androidx.appcompat.widget.SwitchCompat
        android:theme="@style/SwitchStyle"
        android:id="@+id/lineups_switcher"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:thumb="@drawable/switch_thumb"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:track="@drawable/switch_track"/>
    <View
        android:background="@color/n_lv_4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
