<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rectangle_8dp_corners"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">
    <View
        android:id="@+id/header_background"
        android:background="@color/surface_1"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toBottomOf="@+id/organization_header"/>
    <ImageView
        android:id="@+id/logo_organisation"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/team_logo_placeholder"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/header_background"
        app:layout_constraintTop_toTopOf="@+id/header_background"/>
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="end"
        android:id="@+id/text_organisation_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/text_venue_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/logo_organisation"
        app:layout_constraintTop_toTopOf="@+id/header_background"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DisplayMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="end"
        android:id="@+id/text_venue_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/header_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/logo_organisation"
        app:layout_constraintTop_toBottomOf="@+id/text_organisation_name"
        style="@style/AssistiveDefault"/>
    <ImageView
        android:id="@+id/image_background"
        android:background="@drawable/rectangle_8dp_corners_bottom"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:scaleType="centerCrop"
        android:backgroundTint="@color/sm_background_black"
        app:layout_constraintTop_toBottomOf="@+id/header_background"/>
    <View
        android:id="@+id/gradient_color_overlay"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        app:layout_constraintStart_toStartOf="@+id/image_background"
        app:layout_constraintTop_toTopOf="@+id/image_background"/>
    <View
        android:background="@color/darken_overlay_2"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        app:layout_constraintStart_toStartOf="@+id/image_background"
        app:layout_constraintTop_toTopOf="@+id/image_background"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:id="@+id/text_top_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/text_fight_type"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/image_background"
        app:layout_constraintTop_toTopOf="@+id/image_background"
        style="@style/BodySmall"/>
    <TextView
        android:textColor="@color/live"
        android:gravity="center"
        android:id="@+id/live_indicator_top_left"
        android:background="@drawable/rectangle_4dp_corners"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="16dp"
        android:text="@string/menu_live"
        android:textAlignment="center"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/darken_overlay_2"
        android:paddingHorizontal="4dp"
        app:layout_constraintStart_toStartOf="@+id/image_background"
        app:layout_constraintTop_toTopOf="@+id/image_background"
        style="@style/AssistiveDefault"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/text_fight_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_background"
        style="@style/BodySmall"/>
    <ImageView
        android:id="@+id/image_fighter_home"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/player_photo_placeholder"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_background"
        app:layout_constraintStart_toStartOf="@+id/image_background"/>
    <ImageView
        android:id="@+id/image_fighter_away"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/player_photo_placeholder"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_background"
        app:layout_constraintEnd_toEndOf="@+id/image_background"/>
    <ImageView
        android:id="@+id/flag_home"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/chat_flag_gradient_background"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_background"
        app:layout_constraintStart_toStartOf="@+id/image_background"/>
    <ImageView
        android:id="@+id/flag_away"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/chat_flag_gradient_background"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_background"
        app:layout_constraintEnd_toEndOf="@+id/image_background"/>
    <com.sofascore.results.view.MmaRoundInfoView
        android:id="@+id/round_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/image_background"
        app:layout_constraintEnd_toStartOf="@+id/image_fighter_away"
        app:layout_constraintStart_toEndOf="@+id/image_fighter_home"/>
    <TextView
        android:textColor="@color/on_color_secondary"
        android:id="@+id/vs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:text="@string/versus"
        app:layout_constraintBottom_toBottomOf="@+id/image_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/DisplaySmall"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:id="@+id/name_fighter_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:hyphenationFrequency="normalFast"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/vs"
        app:layout_constraintEnd_toStartOf="@+id/vs"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/image_fighter_home"
        app:layout_constraintTop_toTopOf="@+id/vs"
        style="@style/DisplayMicro"/>
    <TextView
        android:textColor="@color/on_color_secondary"
        android:id="@+id/name_fighter_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewEnd"
        android:hyphenationFrequency="normalFast"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/vs"
        app:layout_constraintEnd_toStartOf="@+id/image_fighter_away"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/vs"
        app:layout_constraintTop_toTopOf="@+id/vs"
        style="@style/DisplayMicro"/>
    <include
        android:id="@+id/win_marker_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image_fighter_home"
        layout="@layout/mma_winner_marker"/>
    <include
        android:id="@+id/win_marker_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/image_fighter_away"
        layout="@layout/mma_winner_marker"/>
    <include
        android:id="@+id/draw_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/image_background"
        app:layout_constraintStart_toStartOf="@+id/image_background"
        layout="@layout/mma_draw_layout"/>
    <FrameLayout
        android:id="@+id/ripple_holder"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/organization_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/mma_organisation_header_cell"/>
</androidx.constraintlayout.widget.ConstraintLayout>
