<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:id="@+id/gradient"
        android:background="@color/neutral_variant"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/overlay"
        android:background="@drawable/buzzer_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.5"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/label"
        android:background="@drawable/buzzer_label_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAllCaps="true"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/neutral_variant"
        android:paddingVertical="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/formula_logo"
        style="@style/AssistiveMicro"/>
    <ImageView
        android:id="@+id/race_end_flag"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_race_end_flag"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/formula_logo"/>
    <ImageView
        android:id="@+id/formula_logo"
        android:layout_width="40dp"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/ic_formula_1_logo"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/drivers_holder"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/stage_name"
        app:layout_constraintEnd_toEndOf="@+id/stage_name"
        app:layout_constraintStart_toStartOf="@+id/stage_name"
        app:layout_goneMarginBottom="8dp"/>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:id="@+id/sub_stage_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/stage_name"
        app:layout_constraintEnd_toEndOf="@+id/stage_name"
        app:layout_constraintStart_toStartOf="@+id/stage_name"
        style="@style/DisplaySmall"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/live_holder"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/stage_name"
        app:layout_constraintEnd_toEndOf="@+id/stage_name"
        app:layout_constraintStart_toStartOf="@+id/stage_name">
        <ImageView
            android:id="@+id/live_dot_animation"
            android:background="@drawable/circle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/live"/>
        <TextView
            android:textColor="@color/on_color_primary"
            android:id="@+id/live_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_live"
            android:maxLines="1"
            style="@style/DisplayMicro"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/on_color_primary"
        android:ellipsize="end"
        android:id="@+id/stage_name"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:maxLines="1"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/DisplayMicro"/>
    <FrameLayout
        android:id="@+id/ripple_holder"
        android:background="?attr/selectableItemBackground"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
