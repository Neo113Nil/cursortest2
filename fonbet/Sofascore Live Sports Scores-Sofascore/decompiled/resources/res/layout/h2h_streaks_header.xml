<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="bottom|center_horizontal"
        android:id="@+id/h2h_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/DisplayMedium"/>
    <com.sofascore.results.event.details.view.odds.FeaturedOddsView
        android:id="@+id/featured_odds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/h2h_rows_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
