<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rectangle_16dp_corners"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">
    <TextView
        android:textColor="@color/n_lv_1"
        android:id="@+id/drivers_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:text="@string/formula_drivers"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/first_driver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplayMedium"/>
    <include
        android:id="@+id/first_driver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drivers_label"
        layout="@layout/constructor_drivers_grid_item"/>
    <View
        android:id="@+id/divider"
        android:background="@color/n_lv_4"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_driver"
        app:layout_constraintEnd_toStartOf="@+id/second_driver"
        app:layout_constraintStart_toEndOf="@+id/first_driver"
        app:layout_constraintTop_toTopOf="@+id/first_driver"/>
    <include
        android:id="@+id/second_driver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/drivers_label"
        layout="@layout/constructor_drivers_grid_item"/>
</androidx.constraintlayout.widget.ConstraintLayout>
