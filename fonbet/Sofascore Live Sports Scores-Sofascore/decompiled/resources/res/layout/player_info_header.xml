<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/left_player_only_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp">
        <ImageView
            android:id="@+id/left_player_logo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/left_player_only_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="locale"
            android:textAlignment="viewStart"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/left_injured_pill"
            app:layout_constraintEnd_toStartOf="@+id/follow_button"
            app:layout_constraintStart_toEndOf="@+id/left_player_logo"
            app:layout_constraintTop_toTopOf="@+id/left_player_logo"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/DisplayLarge"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/left_name_bottom_anchor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierAllowsGoneWidgets="true"
            app:barrierDirection="top"
            app:constraint_referenced_ids="left_injured_pill,left_rating"/>
        <TextView
            android:textColor="@color/error"
            android:gravity="center_vertical"
            android:id="@+id/left_injured_pill"
            android:background="@drawable/rectangle_24dp_corners"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/player_injured"
            android:drawablePadding="4dp"
            android:backgroundTint="@color/live_highlight"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            app:drawableStartCompat="@drawable/ic_cross_16"
            app:drawableTint="@color/error"
            app:layout_constraintBottom_toTopOf="@+id/left_rating"
            app:layout_constraintStart_toStartOf="@+id/left_player_only_name"
            app:layout_constraintTop_toBottomOf="@+id/left_player_only_name"
            style="@style/AssistiveDefault"/>
        <FrameLayout
            android:id="@+id/left_rating"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/left_player_logo"
            app:layout_constraintStart_toStartOf="@+id/left_player_only_name"
            app:layout_constraintTop_toBottomOf="@+id/left_injured_pill">
            <com.sofascore.results.view.SofascoreSmallRatingView
                android:layout_gravity="center_vertical"
                android:id="@+id/left_player_rating_small"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.sofascore.results.view.SofascoreRatingView
                android:layout_gravity="center_vertical"
                android:id="@+id/left_player_rating"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textColor="@color/n_lv_3"
                android:layout_gravity="center_vertical"
                android:id="@+id/left_position"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AssistiveDefault"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/left_player_tournament_logo"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/left_rating"
            app:layout_constraintStart_toEndOf="@+id/left_rating"
            app:layout_constraintTop_toTopOf="@+id/left_rating"/>
        <ImageView
            android:id="@+id/left_player_team_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/left_player_logo"
            app:layout_constraintEnd_toEndOf="@+id/left_player_logo"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/left_player_mvp_badge"
            android:background="@drawable/ic_mvp_badge_background"
            android:padding="3dp"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_star_filled_16"
            android:tint="@android:color/white"
            android:backgroundTint="@color/rating_90"
            app:layout_constraintBottom_toBottomOf="@+id/left_player_logo"
            app:layout_constraintStart_toStartOf="@+id/left_player_logo"/>
        <com.sofascore.results.view.follownotification.FollowButton
            android:id="@+id/follow_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="@+id/left_player_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/left_player_logo"/>
        <TextView
            android:textColor="@color/primary_default"
            android:id="@+id/view_player_details"
            android:background="@drawable/ripple_16_dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_player_profile"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/compare_button"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/compare_button"
            style="@style/DisplaySmall"/>
        <TextView
            android:textColor="@color/surface_1"
            android:id="@+id/compare_button"
            android:background="@drawable/rectangle_16dp_corners"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/compare"
            android:textAllCaps="true"
            android:backgroundTint="@color/primary_default"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/left_player_logo"
            app:textAllCaps="true"
            style="@style/ActionButtonPrimary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/left_player_compare_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/left_player_compare_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sofascore.results.view.SofascoreSmallRatingView
            android:id="@+id/left_player_compare_rating"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/left_player_compare_logo"
            app:layout_constraintEnd_toEndOf="@+id/left_player_compare_logo"
            app:layout_constraintStart_toEndOf="@+id/left_player_compare_logo"
            app:small_animateRating="false"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/left_player_compare_mvp_badge"
            android:background="@drawable/ic_mvp_badge_background"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_star_filled_16"
            android:tint="@android:color/white"
            android:backgroundTint="@color/rating_90"
            app:layout_constraintBottom_toBottomOf="@+id/left_player_compare_logo"
            app:layout_constraintStart_toStartOf="@+id/left_player_compare_logo"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/left_player_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/left_player_compare_logo"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/middle_divider"
        android:background="@color/n_lv_4"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_player_compare_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">
        <ImageView
            android:id="@+id/right_player_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_alignParentEnd="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/right_player_mvp_badge"
            android:background="@drawable/ic_mvp_badge_background"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_star_filled_16"
            android:tint="@android:color/white"
            android:backgroundTint="@color/rating_90"
            app:layout_constraintBottom_toBottomOf="@+id/right_player_logo"
            app:layout_constraintStart_toStartOf="@+id/right_player_logo"/>
        <com.sofascore.results.view.SofascoreSmallRatingView
            android:id="@+id/right_player_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/right_player_logo"
            app:layout_constraintEnd_toEndOf="@+id/right_player_logo"
            app:layout_constraintStart_toEndOf="@+id/right_player_logo"
            style="@style/NavigationTabSecondary"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/right_player_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/right_player_logo"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
