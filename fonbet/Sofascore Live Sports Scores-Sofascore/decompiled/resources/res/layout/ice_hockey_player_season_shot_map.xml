<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.typeheader.TypeHeaderView
        android:id="@+id/shot_map_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/arrow_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_terrain_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shot_map_header"
        app:tint="@color/n_lv_3"/>
    <ImageView
        android:id="@+id/shot_map_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/shot_map_surface"
        app:layout_constraintEnd_toEndOf="@+id/shot_map_surface"
        app:layout_constraintStart_toStartOf="@+id/shot_map_surface"
        app:layout_constraintTop_toTopOf="@+id/shot_map_surface"/>
    <ImageView
        android:id="@+id/shot_map_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/hockey_rink_full"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/arrow_image"/>
    <ImageView
        android:id="@+id/logo_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_sofascore_logomark"
        app:layout_constraintBottom_toBottomOf="@+id/shot_map_surface"
        app:layout_constraintEnd_toEndOf="@+id/shot_map_surface"
        app:layout_constraintStart_toStartOf="@+id/shot_map_surface"
        app:layout_constraintTop_toTopOf="@+id/shot_map_surface"
        app:tint="@color/n_lv_5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
