<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/manager_history_team_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/manager_history_team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:textDirection="locale"
        android:textAlignment="gravity"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/manager_history_ppg"
        app:layout_constraintStart_toEndOf="@+id/manager_history_team_logo"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BodyMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:ellipsize="middle"
        android:id="@+id/manager_history_dates"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/manager_history_games"
        app:layout_constraintStart_toStartOf="@+id/manager_history_team_name"
        style="@style/AssistiveDefault"/>
    <TextView
        android:id="@+id/manager_history_ppg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/manager_history_team_name"
        style="@style/AssistiveDefault"/>
    <TextView
        android:gravity="end"
        android:id="@+id/manager_history_games"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/manager_history_wins"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/secondary_default"
        android:gravity="end"
        android:id="@+id/manager_history_wins"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/manager_history_draws"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="end"
        android:id="@+id/manager_history_draws"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/manager_history_losses"
        style="@style/TableMedium"/>
    <TextView
        android:textColor="@color/error"
        android:gravity="end"
        android:id="@+id/manager_history_losses"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/TableMedium"/>
    <com.sofascore.results.redesign.dividers.SofaDivider
        android:id="@+id/bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:dividerVisible="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
