<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/n_lv_3"
        android:gravity="center"
        android:id="@+id/aggregate_result_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        style="@style/DisplayMicro"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/result_container"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">
        <ImageView
            android:id="@+id/image_arrow_start"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_down"
            android:rotation="@integer/rotate_90_clockwise"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_default"/>
        <View
            android:id="@+id/arrow_divider"
            android:background="@color/n_lv_4"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/image_arrow_start"/>
        <ImageView
            android:id="@+id/first_team_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/first_team_score"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/arrow_divider"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/first_team_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/first_team_win_indicator"
            app:layout_constraintStart_toEndOf="@+id/first_team_logo"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DisplayMicro"/>
        <ImageView
            android:id="@+id/first_team_win_indicator"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_aggregate_pointer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/minus"
            app:layout_constraintStart_toEndOf="@+id/first_team_score"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/n_lv_1"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/minus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:maxLines="1"
            android:layout_marginHorizontal="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/second_team_score"
            app:layout_constraintStart_toEndOf="@+id/first_team_win_indicator"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DisplayMicro"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/second_team_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/second_team_win_indicator"
            app:layout_constraintStart_toEndOf="@+id/minus"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DisplayMicro"/>
        <ImageView
            android:id="@+id/second_team_win_indicator"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_aggregate_pointer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/second_team_logo"
            app:layout_constraintStart_toEndOf="@+id/second_team_score"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/n_lv_1"/>
        <ImageView
            android:id="@+id/second_team_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/series_divider"
            app:layout_constraintStart_toEndOf="@+id/second_team_win_indicator"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/series_divider"
            android:background="@color/n_lv_4"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintEnd_toStartOf="@+id/image_series"/>
        <ImageView
            android:id="@+id/image_series"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_more_horiz"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_default"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
