<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/brand_tertiary_highlight"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/preview_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:src="@drawable/ic_sofascore_analyst_preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:progress="100"
        app:indicatorColor="@color/primary_default"
        app:layout_constraintTop_toBottomOf="@+id/preview_image"
        app:trackColor="@color/primary_highlight"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/progress_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/see_it_in_action"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AssistiveMicro"/>
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sofascore_analyst_explore"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@+id/subtitle"
                style="@style/DisplayExtraLarge"/>
            <ImageView
                android:id="@+id/home_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="@+id/home_name"
                app:layout_constraintStart_toStartOf="@+id/home_name"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <TextView
                android:id="@+id/home_name"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/home_logo"
                style="@style/DisplayMicro"/>
            <ImageView
                android:id="@+id/away_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:layout_constraintEnd_toEndOf="@+id/away_name"
                app:layout_constraintStart_toStartOf="@+id/away_name"
                app:layout_constraintTop_toTopOf="@+id/home_logo"/>
            <TextView
                android:id="@+id/away_name"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/home_name"
                style="@style/DisplayMicro"/>
            <TextView
                android:id="@+id/primary_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAlignment="center"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintEnd_toStartOf="@+id/away_logo"
                app:layout_constraintStart_toEndOf="@+id/home_logo"
                app:layout_constraintTop_toTopOf="@+id/home_logo"
                style="@style/DisplayLarge"/>
            <TextView
                android:id="@+id/secondary_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="@+id/primary_label"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/primary_label"
                app:layout_constraintTop_toBottomOf="@+id/primary_label"
                style="@style/BodyMedium"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_yes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/try_it_now"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintTop_toBottomOf="@+id/home_name"
                style="@style/ButtonFilledPrimary"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="@color/primary_default"
                android:id="@+id/cancel_button"
                android:background="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/maybe_later"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintTop_toBottomOf="@+id/button_yes"
                style="@style/ButtonFilledDefault"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
