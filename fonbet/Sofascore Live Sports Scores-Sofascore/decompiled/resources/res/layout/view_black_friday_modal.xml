<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/icon"
            android:background="@drawable/circle"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_sale_mark"
            android:importantForAccessibility="no"
            android:layout_marginStart="20dp"
            android:backgroundTint="@color/on_color_highlight_1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/on_color_primary"/>
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="200dp"
            android:text="@string/limited_time_discount"
            android:textAllCaps="true"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AssistiveDefault"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grab_sofascore_analyst_discount_title"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            style="@style/DisplayExtraLarge"/>
        <TextView
            android:id="@+id/bullet_point_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/grab_sofascore_analyst_discount_body"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/BodyMediumParagraph"/>
        <com.google.android.material.button.MaterialButton
            android:ellipsize="end"
            android:id="@+id/next_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/button_view_offer"
            android:maxLines="1"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/bullet_point_one"
            style="@style/ButtonFilledPrimary"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/text_color_link_selector"
            android:id="@+id/button_not_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_not_now"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:layout_marginHorizontal="16dp"
            android:paddingVertical="10dp"
            app:layout_constraintTop_toBottomOf="@+id/next_button"
            style="@style/ActionButtonPrimary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
