<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="36dp"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/edit_fighter_name"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconDrawable="@drawable/ic_info"
        app:endIconMode="none"
        app:endIconTint="@color/n_lv_1"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_image_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/edit_fighter_image_url"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconDrawable="@drawable/ic_info"
        app:endIconMode="none"
        app:endIconTint="@color/n_lv_1"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/image_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_nickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/edit_fighter_nickname"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconDrawable="@drawable/ic_info"
        app:endIconMode="none"
        app:endIconTint="@color/n_lv_1"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_nationality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nationality"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/nationality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/edit_fighting_style"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:importantForAutofill="noExcludeDescendants"
        style="@style/Widget.Sofascore.TextInputLayout.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_date_of_birth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/edit_fighter_date_of_birth"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconDrawable="@drawable/ic_info"
        app:endIconMode="none"
        app:endIconTint="@color/n_lv_1"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/date_of_birth"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/edit_fighter_height_cm"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconDrawable="@drawable/ic_info"
        app:endIconMode="none"
        app:endIconTint="@color/n_lv_1"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
    <com.sofascore.results.view.SofaTextInputLayout
        android:id="@+id/input_reach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/edit_fighter_reach_cm"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:importantForAutofill="noExcludeDescendants"
        app:endIconDrawable="@drawable/ic_info"
        app:endIconMode="none"
        app:endIconTint="@color/n_lv_1"
        style="@style/Widget.Sofascore.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/reach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:imeOptions="flagNoExtractUi"/>
    </com.sofascore.results.view.SofaTextInputLayout>
</LinearLayout>
