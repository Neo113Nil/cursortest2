<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/penalty_incident_time"
        android:layout_width="48dp"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/commentary_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:textColor="@color/n_lv_3"
            android:id="@+id/commentary_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="48dp"
            style="@style/AssistiveDefault"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/commentary_holder"
        android:background="@drawable/rounded_surface_level_2"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/surface_1"
        android:layout_marginVertical="8dp">
        <ImageView
            android:id="@+id/commentary_team_corner"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/commentary_title"
            android:paddingTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DisplayMedium"/>
        <ImageView
            android:id="@+id/commentary_substitution_in_img"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/commentary_title"/>
        <TextView
            android:id="@+id/commentary_substitution_in_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/commentary_substitution_in_img"
            app:layout_constraintStart_toEndOf="@+id/commentary_substitution_in_img"
            app:layout_constraintTop_toTopOf="@+id/commentary_substitution_in_img"
            style="@style/BodySmall"/>
        <TextView
            android:textColor="@color/secondary_default"
            android:id="@+id/commentary_substitution_in_span"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/commentary_substitution_in_img"
            app:layout_constraintStart_toEndOf="@+id/commentary_substitution_in_name"
            app:layout_constraintTop_toTopOf="@+id/commentary_substitution_in_img"
            style="@style/BodySmall"/>
        <ImageView
            android:id="@+id/commentary_substitution_out_img"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/commentary_substitution_in_img"/>
        <TextView
            android:id="@+id/commentary_substitution_out_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/commentary_substitution_out_img"
            app:layout_constraintStart_toEndOf="@+id/commentary_substitution_out_img"
            app:layout_constraintTop_toTopOf="@+id/commentary_substitution_out_img"
            style="@style/BodySmall"/>
        <TextView
            android:textColor="@color/error"
            android:id="@+id/commentary_substitution_out_span"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/commentary_substitution_out_img"
            app:layout_constraintStart_toEndOf="@+id/commentary_substitution_out_name"
            app:layout_constraintTop_toTopOf="@+id/commentary_substitution_out_img"
            style="@style/BodySmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
