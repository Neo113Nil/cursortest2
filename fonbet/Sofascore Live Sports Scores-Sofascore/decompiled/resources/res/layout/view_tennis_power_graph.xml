<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <TextView
        android:textColor="@color/n_lv_1"
        android:ellipsize="middle"
        android:id="@+id/match_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginStart="40dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tennis_power_scroll_view"
        app:layout_constraintEnd_toStartOf="@+id/info_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DisplaySmall"/>
    <ImageView
        android:id="@+id/info_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_info"
        android:contentDescription="@string/info"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/match_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/match_time"
        app:tint="@color/n_lv_1"/>
    <ImageView
        android:id="@+id/first_player_2"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="-8dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_player_1"
        app:layout_constraintStart_toEndOf="@+id/first_player_1"/>
    <ImageView
        android:id="@+id/first_player_1"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/second_player_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tennis_power_scroll_view"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/second_player_2"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="-8dp"
        app:layout_constraintStart_toEndOf="@+id/second_player_1"
        app:layout_constraintTop_toTopOf="@+id/second_player_1"/>
    <ImageView
        android:id="@+id/second_player_1"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tennis_power_scroll_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/first_player_1"/>
    <com.sofascore.common.widget.NestedHorizontalScrollView
        android:id="@+id/tennis_power_scroll_view"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/second_player_2"
        app:layout_constraintTop_toBottomOf="@+id/match_time">
        <com.sofascore.results.view.graph.TennisPowerGraph
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tennis_power_holder"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"/>
    </com.sofascore.common.widget.NestedHorizontalScrollView>
    <View
        android:id="@+id/shadow"
        android:background="@drawable/gradient_surface_1"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="0dp"
        android:scaleX="@integer/drawable_scaleX_normal"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tennis_power_scroll_view"
        app:layout_constraintStart_toEndOf="@+id/second_player_2"
        app:layout_constraintTop_toTopOf="@+id/tennis_power_scroll_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
